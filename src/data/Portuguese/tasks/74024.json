						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "Ei, o que você está fazendo aqui sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240102,
					"content": "Aaah! Não fale com alguém tão de repente assim pelas costas! Você quase me fez espalhar esse pó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240103,
					"content": "Pó? Ehm, que pó é esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240104,
					"content": "São Gemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240105,
					"content": "Gemas? Mas por que haveria alguma gema aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240106,
					"content": "O estranho seria se não tivesse, não é mesmo? Quero dizer, essa é minha oficina, onde eu lapido gemas... Embora devo admitir que ainda não tem um nome oficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240107,
					"content": "Minha ideia no passado era chamar de \"Estúdio Sluasi\", mas não tenho certeza se usar meu nome tão diretamente é uma boa ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240108,
					"content": "Como assim \"lapidar gemas\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "Significa que eu transformo gemas em vários ornamentos bonitos... e coisas assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240110,
					"content": "Infelizmente, eu não estou aceitando encomendas por um tempo. Preciso me concentrar em fazer tintas... Se bem que ainda estou usando gemas para fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240111,
					"content": "Você vai fazer tinta de gemas? Tá falando sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240112,
					"content": "Sim. O que há de errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240113,
					"content": "Bem, só parece um desperdício... Você poderia dar elas a Paimon ao invés disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240114,
					"content": "Mas enfim, por que você precisa fazer tintas? Paimon tem quase certeza que não precisaria fazer isso para fabricar ornamentos de gemas, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240115,
					"content": "Bem, uma criança que adora pintar veio me perguntar se eu podia fazer tintas tão reluzentes quanto gemas e tão brilhantes quanto o sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240116,
					"content": "Além disso, ela recentemente salvou minha irmã mais nova quando teve um terremoto muito violento aqui na vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240117,
					"content": "É por isso que decidi tentar realizar o desejo dela criando um \"tinta tão brilhante quanto o sol\" e dar a ela como um presente de agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240118,
					"content": "Espere, então você está falando da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "A garota que gosta de pintar que você mencionou se chama Maime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240120,
					"content": "Hmm? Sim... Vocês a conhecem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240121,
					"content": "Vocês contam a Sluasi sobre suas experiências passadas com Maime...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#Então... Então vocês são {M#os heróis lendários}{F#as heroínas lendárias} que salvaram Puca junto com Maime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240123,
					"content": "#Lendári{M#os}{F#as}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240124,
					"content": "Sim, fomos nós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "Obrigada. Muito obrigada, mesmo! Se não fosse por vocês, Puca poderia ter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240127,
					"content": "Por favor, peguem isso... Se não se importarem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240128,
					"content": "(Lindas joias...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#Podemos mesmo levá-las, {NICKNAME}? Parecem bem caras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240131,
					"content": "Estranho, né? Paimon não achava que Maime teria coragem de comissionar alguém por conta própria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240132,
					"content": "Bem, acho que não conta como uma comissão. Ela só perguntou se eu poderia fazer. Na verdade, ela saiu correndo antes que eu pudesse responder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240133,
					"content": "...É. Agora parece com algo que ela faria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240134,
					"content": "#Falando nisso, lendári{M#os}{F#as} {NICKNAME} e Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240135,
					"content": "Vocês sabem que algo que tenha uma quer que \"lembre a cor do sol\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240136,
					"content": "Eu tentei observar o sol eu mesma, mas não tenho certeza quais materiais deveria usar para recriar suas cores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240137,
					"content": "Hmm... que \"lembre a cor do sol\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240138,
					"content": "...Ouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "Bem, Canotila realmente nos disse antes que \"ouro é como as lágrimas do sol\" ou algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240140,
					"content": "Mas isso não seria luxuoso demais? Deve haver alguma coisa mais normal que podemos usar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240148,
					"content": "Pensa bem... com certeza nós já vimos algo que \"lembre a cor do sol\" e que pode ser encontrado em praticamente qualquer lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240141,
					"content": "...O sol?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "...Isso é verdade. A coisa mais próxima do sol, de fato, é o próprio sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240143,
					"content": "Mas será que dá para moer o sol até virar pó?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240144,
					"content": "Que raio de discussão sem noção é essa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240145,
					"content": "Quem sabe você poderia usar meu cabelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "...Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240147,
					"content": "Fala sério! Não tem como usar cabelo para fazer tintas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240130,
					"content": "#Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "Mas achei a descrição exagerada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
