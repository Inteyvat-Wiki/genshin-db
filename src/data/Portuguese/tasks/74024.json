				{
					"id": 740240302,
					"content": "#No entanto, eu não posso aceitar isso, lendári{M#o}{F#a} {NICKNAME}. Prefiro apenas aprender o nome desse material, e depois partirei para encontrá-lo eu mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "Ainda assim, você não diria que esta cor é um pouco... intensa demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "A \"cor do sol\" deveria ter um toque mais leve, eu acho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "Você quer dizer que deveria parecer um pouco mais \"branca\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "Hmm, isso é verdade. O \"sol\" é mais \"branco\" do que é \"ouro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "\"Branco\"... faz sentido... Entretanto, eu não sei bem quais materiais devemos usar para atingir essa tonalidade mais clara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "Que tal colocar água?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "Eu já tentei isso no passado... mas não acabou muito bem. As cores produzidas desse jeito acabaram escuras — elas carecem daquele brilho notável do sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "Então seria melhor se pudéssemos usar algum outro material...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "Dito isso, podemos encontrar todo tipo de coisas brancas e brilhantes ao nosso redor, não podemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "Que tal usar o cabelo da Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "Não dá para fazer tinta de cabelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "E mesmo que pudesse, você não pode simplesmente arrancar o cabelo de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
