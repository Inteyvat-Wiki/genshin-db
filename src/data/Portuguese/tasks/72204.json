						722040904,
						722040905
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040904,
					"content": "#{NICKNAME}, prazer em te conhecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				},
				{
					"id": 722040906,
					"content": "Oh... eu... eu estava indo embora, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "Indo embora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Aquele homem do barco costuma vir me ver para tentar me convencer a ir com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Ele sempre vem em silêncio, vestindo um casaco de pele dourado, calças douradas e uma coroa de ouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "É como minha mãe, Kito e Kina me disseram... Ele vem para nos levar naquele barco brilhante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "Ele nos conduz por um rio cintilante para a terra dos sonhos. Lá não há neblina, e haverá um grande salão dourado, com setenta berços, e depois mais setenta... E eles balançarão para frente e para trás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Neles dormimos pacificamente até nos tornarmos partículas de luz. E então... nos transformamos em um sonho das crianças que vivem na terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Uau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Esse homem do barco disse que vinha no lugar de Kito e Kina para me dar isso. Hehe, estas crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Ainda não está na hora... ainda não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "Quer dizer que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
