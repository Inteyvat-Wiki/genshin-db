			"dialogs": [
				{
					"id": 722040401,
					"content": "Enfim, vão brincar... Eu fico aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "As pétalas... As pétalas... Como é a sua terra natal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220403",
							"2"
