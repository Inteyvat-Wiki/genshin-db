			},
			"dialogs": [
				{
					"id": 722040201,
					"content": "Bom, já chega. Deixem... a vovó... dormir um pouco... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040202,
					"content": "Mas tenham cuidado... Não vão... para demasiado longe... *Zzz*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220403,
			"completionStepIds": [
				7220402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
