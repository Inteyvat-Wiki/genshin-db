					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Oi, oi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "*Suspiro*... Desculpe, a cabeça desta senhora já não pensa com clareza... Quem é você? Nos conhecemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Sou {M#o}{F#a} {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "Nunca ouvi falar nesse nome antes. Você veio do lado de fora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Que estranho... É muito estranho... ninguém consegue andar à vontade pela ilha sem o consentimento da grande Pássaro do Trovão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "Faz tempo que a Pássaro do Trovão se foi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "Ver você me faz lembrar do meu marido... Mas agora eu já nem lembro da aparência dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Ainda éramos jovens e cheios de ilusões ingênuas nesse tempo... Mas algumas pessoas simplesmente não crescem, não importa quanto tempo se passe com elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "E então ele me deixou. Ele fez uma jangada com a intenção de atravessar o mar e ir para aquela ilha desconhecida... Disse que queria caçar livremente lá, e colher aquelas flores lindas que nunca tinha visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Desde pequeno sempre foi assim... Mas nunca cresceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Eventualmente, o filho do sacerdote o encontrou na praia... Ele ficou lá, tão silencioso como conchas, e mais pálido do que a própria areia... Em suas mãos ele ainda segurava aquelas pétalas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "O sacerdote chorou e me disse que o barco de seus ancestrais o havia rejeitado, e que a partir de então sua alma vagaria por aquelas terras distantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "Naquele momento eu havia acabado de dar à luz nosso filho... Como eu iria lhe explicar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Depois disso... o meu filho também teve filhos, e depois disso... ainda tive que me despedir deles e os enviar num barco reluzente... Mas nessa altura a minha vida já estava feita aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Agora, os únicos que me preocupam são Kito e Kina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "É uma longa história...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Olá, pode me chamar de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
