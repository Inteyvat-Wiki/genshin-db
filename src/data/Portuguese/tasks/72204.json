			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040301,
					"content": "Oh... elas são cada vez menos claras... Minhas memórias são... menos claras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Olá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "*Suspiro*... Minha memória vai de mal a pior. Já estou velha, me lembro cada vez de menos coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Algo não está bem... Me pergunto se Kito e Kina estão com fome... Não é seguro brincar lá fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Eles estão bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Kito, Kina! Quando vocês voltaram? Não levaram nenhuma queda no caminho, não é? Não subiram nas árvores de novo, subiram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Estão sempre a fazer esta pobre senhora se preocupar... Oh, o que há de errado com esta ilha ultimamente? Há cada vez menos pessoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "Os nomes de que me lembro... são cada vez menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "*Suspiro*... O que sua pobre vovó fará quando esquecer seus nomes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "*Suspiro*... Pegue essas pétalas. Se eu me esquecer de vocês, é só me mostrarem elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Ainda tenho tantas histórias para lhes contar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Posso ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
