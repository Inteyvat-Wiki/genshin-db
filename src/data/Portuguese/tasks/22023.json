			},
			"dialogs": [
				{
					"id": 220230101,
					"content": "Hum... Se conseguisse comer a comida de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230102,
					"content": "Está tudo bem com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "#Quem é você? Com base nas suas roupas, você deve ser {M#um}{F#uma} Viajante, certo? Me desculpe, mas estou com muitas saudades da minha casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230104,
					"content": "Você acabou de dizer que quer comer a comida de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "Ei? Você... Você sabe fazer comida de Liyue? Que ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230119,
					"content": "Então, por favor, faça uma comida original de Liyue, e agradeço desde já!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230120,
					"content": "Deixe-me pensar... Agora eu tenho vontade de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230121,
					"content": "Carne! Gostaria de comer carnes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230122,
					"content": "Carnes macias com a mistura de sabor de gordura e tempero de Liyue... Que aroma ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230123,
					"content": "Só de pensar, não paro de me tremer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230124,
					"content": "Então, eu gostaria de comer carne. Por favor, faça um prato de carne de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230105,
					"content": "Você encontrou algum problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "Me desculpe, me esqueci de me apresentar. O meu nome é Tang Wen, uma historiadora de Liyue, e estava fazendo investigações de campo para aprofundar a minha pesquisa de costumes e folclores de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230107,
					"content": "Quando eu estava quase terminando a minha pesquisa e prestes a voltar para Liyue, Inazuma se fechou, e acabei ficando presa por aqui há bastante tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230108,
					"content": "Na verdade, eu não acho isso tão ruim, porque estou testemunhando um momento histórico de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230109,
					"content": "Estou convencida de que esse período tão especial certamente entrará na história de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230110,
					"content": "Caberá a uma estudiosa como eu testemunhar a história, registrá-la e arquivá-la de forma realista, completa e clara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230111,
					"content": "Mas... Apesar do fato que uma carreira como essa me deixa bastante animada, ela não enche meu estômago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230112,
					"content": "Você está com fome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "Não é a questão de fome... Haha, para ser sincera, a comida de Inazuma é saborosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230114,
					"content": "Eu gosto muito de Tempura, ela é uma comida com um revestimento de farinha frita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230115,
					"content": "Eu gostaria de comer a comida de Liyue após comer a comida de Inazuma por tanto tempo. Mas infelizmente não consegui encontrar um restaurante com comida original de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230116,
					"content": "Uns dias atrás, decidi publicar uma missão de culinária, mas ninguém me respondeu por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230117,
					"content": "Posso dar uma tentativa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
