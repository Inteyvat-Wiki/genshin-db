					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030505,
					"content": "Aqui estão eles. Veja essa coloração, eles ainda podem ser usados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030506,
					"content": "Gostaria que pudesse ser feito algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030503,
					"content": "Lembra... você me pediu para trazer pedaços de ferro...",
					"roleType": "TALK_ROLE_PLAYER",
