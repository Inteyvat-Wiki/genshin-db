				},
				{
					"id": 205030603,
					"content": "Você parece estar de mal humor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "O trabalho de um ferreiro requer foco e concentração. Eu não gosto de ficar jogando conversa fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Quando a habilidade é boa, o negócio irá bem. É tudo uma questão de troca mútua, e qualquer coisa diferente que falarem a você, é mentira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "Se você não tiver mais nada a dizer, eu vou voltar ao meu trabalho.",
