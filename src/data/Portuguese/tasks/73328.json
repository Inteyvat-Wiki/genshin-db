			"dialogs": [
				{
					"id": 733280101,
					"content": "É você, Jeeeeeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}? E a pequena Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280103,
					"content": "Bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "Haha, viu o que eu disse? Nós nos encontraremos novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280105,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Ora, esse é o segredo de uma dama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{M#Isso significa não se intrometa! Até eu posso querer manter algo em segredo, sabe...}{F#Encontre um bar e me divirta e talvez eu te conte um segredo ou outro... Não me diga que eu vou ter que fazer tudo, hein?}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280109,
					"content": "#{M#Pfft, perdão, mas de acordo com as regras dos guardas, eu não posso de contar nada.}{F#E-Eu só estou brincando! Há algumas regras que devemos seguir... Não devemos dizer uma palavra sequer sobre os produtos sendo escoltados. Minhas desculpas.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280110,
					"content": "Hmph, você está tão cheia de segredos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "Então... Como vocês têm passado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280112,
					"content": "Nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "É... Comigo também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280115,
					"content": "Certo, eu não vou te segurar mais. *Suspiro* Eu tenho meus próprios assuntos para resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280116,
					"content": "Hã, você é tão ocupada, Jeht. Você não era assim antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "Pfft... Bem, isso que é um emprego \"estável\", apesar do que eu faço ser praticamente o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280118,
					"content": "Não demorou muito para eu começar a sentir falta dos meus antigos dias despreocupados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280119,
					"content": "Eu não sei o que vocês têm feito recentemente, mas eu sempre espero ansiosamente ouvir suas histórias. Eu tenho várias para contar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280120,
					"content": "Mas sem pressa por ora. Boas histórias são como vinho. Nós devemos deixá-las fermentar adequadamente. Viajantes no deserto costumavam viver por essas histórias no passado, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280121,
					"content": "Hmm... Enfim, cuidem-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280122,
					"content": "Você também, Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "Sim, deixa eu te dar mil abraços, e eu vou continuar rezando por vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280124,
					"content": "Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "Haha, eu não vou perder Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280113,
					"content": "Estou ok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
