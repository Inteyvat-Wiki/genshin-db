				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "Hmm, isto é... Espere, eu devo estar confusa. O que é isto!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130202,
					"content": "Toda esta ilha é como uma enorme caixa de presente escondida sob o escudo de energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130203,
					"content": "Parece haver algo por lá. Vamos dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130204,
					"content": "Sim, eu quero ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130205,
					"content": "Menina má da chama, você finalmente chegou. Esperei muito tempo - que entediante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130206,
					"content": "Você ousa me enfrentar, o soberano do Clã Dodo, Rei-Dodo!? Que coragem gloriosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130207,
					"content": "Embora tal coragem seja admirável, agora não tem sentido porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130208,
					"content": "Porque Rei-Dodo sou eu, sua mãe, Alice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130209,
					"content": "Hã? Mamãe!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130210,
					"content": "Espere! Alice? A pessoa que escreveu o Guia de Viagem Teyvat!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130211,
					"content": "Klee e seus companheiros de ilha, olá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130212,
					"content": "Então, o que você achou daqui? Foi divertido? Os céus de verão e o mar, mmm~ Que férias, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130213,
					"content": "Não adianta procurar por mim, na verdade não estou perto de você. O dispositivo de fala na plataforma diante de você não é outro senão a minha criação pessoal, o Fonógrafo Alice! Estou usando-o para transmitir o amor de uma mãe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130214,
					"content": "Oh? Você não pode estar falando sério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130215,
					"content": "Ei, eu não assustei a todos, assustei? Desculpe, minha Klee adora brincar com todo tipo de brinquedos pequenos. Como mãe dela, eu naturalmente quero apoiá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130216,
					"content": "Estes brinquedos não são nada pequenos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130217,
					"content": "A mãe da... Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130218,
					"content": "É uma pena que eu não possa encontrar você, mas estarei observando cada movimento de longe, como sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130219,
					"content": "Na verdade, era a Alice! Que descuido da minha parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130220,
					"content": "Espere, o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130221,
					"content": "Você pode achar tudo isso um pouco estranho. Por que uma mãe tão longe de casa faria tanto esforço para criar um país das maravilhas aquáticas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130222,
					"content": "Ding ding! Correto, estive pessoalmente nessas ilhas. Eu absolutamente adoro as ruínas antigas e a paisagem única. Preparei tudo para que todos vocês pudessem participar e aproveitá-las também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130223,
					"content": "A mãe de Klee também parece ter uma alma bastante livre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130224,
					"content": "Hehe, algum de vocês está falando mal de mim agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130225,
					"content": "Hã? N—não! Ela ainda está nos ouvindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130226,
					"content": "Não precisa se preocupar tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130227,
					"content": "O que você quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130228,
					"content": "A mãe de Klee, Alice, é uma feiticeira extremamente enigmática e quase onipotente. Não se preocupe tanto. É apenas o jeito dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130229,
					"content": "#Você deve ter ficado curios{M#o}{F#a} sobre o que estava por trás daquelas cartas, os barcos, as boias e aquele escudo de energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130230,
					"content": "Hmm hmm... Na verdade, eu também achei que foi um esforço muito grande, mas essa era a única forma de convidar todos para cá, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130231,
					"content": "As ilhas estão cheias de histórias. Os habitantes originais, naufrágios, máquinas místicas... Inúmeras coincidências convergem aqui. Teria sido um desperdício se eu não tivesse feito esses arranjos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130232,
					"content": "Agora deixe-me adivinhar... Todos os que receberam uma carta devem estar presentes. Kaeya, Diluc, Razor, Jean, Barbara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130233,
					"content": "#E tem o confiável e inteligente Albedo, e... {M#O}{F#A} Viajante misterios{M#o}{F#a} e sua boa companheira, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130234,
					"content": "Todos vocês foram convidados por mim para acompanhar Klee. Obrigada a todos por permitir que minha filha tenha um verão memorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130235,
					"content": "Tudo nas ilhas é um presente para vocês, como agradecimento por fazerem companhia à minha pequena Klee. Mas quando ouvirem esta gravação, já estarei viajando em outras terras distantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130236,
					"content": "#A vida de Viajante é cheia de pressa e diversão. Haha, pergunte para {M#o}{F#a} Viajante perto de você e saberá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130237,
					"content": "Então Alice fez tudo isso porque estava ocupada demais para ficar com Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130238,
					"content": "Não, a mamãe é assim mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130239,
					"content": "Agora, se vocês estão tentando encontrar algum significado oculto em tudo isso, devo dizer que a situação não é tão complicada quanto podem pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130240,
					"content": "A razão pela qual gosto da cidade de Mondstadt é que sua liberdade é exatamente o que nós, mães e filhas, desejamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130241,
					"content": "Meu desejo é simples: quero que Klee cresça com um coração curioso, mas gentil. Enquanto continuar desejando, poderá fazer qualquer coisa e ir a qualquer lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130242,
					"content": "Então é isso. Bem, devo admitir que certamente se encaixa no estilo da Alice. Peço desculpas, entendi de forma errada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130243,
					"content": "Deve ser bom ter uma mãe com um jeito assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130244,
					"content": "Sim! Mamãe é a melhor mãe de todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130245,
					"content": "Mamãe, pegamos peixes, andamos de barco, nadamos e brincamos de muitas coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130246,
					"content": "Todo mundo foi super legal e muito bonzinho comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130247,
					"content": "Da próxima vez, você pode vir também e todos brincamos aqui de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130248,
					"content": "Parece que mãe e filha são idênticas, ambas são animadas e livres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130249,
					"content": "Verão... Por falar em verão, quando fui para aquelas ilhas também era verão. Sentada na praia, ouvindo as ondas batendo nos meus pés, pensei em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130250,
					"content": "Klee, você é uma filha do verão, um presente entregue para mim pelo mar e o vento. Mamãe é grata pelo seu nascimento e queria lhe dar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130251,
					"content": "Então mamãe adornou estas ilhas, transformou as ruínas antigas em um parque de verão e usou o apelido de Rei-Dodo para convidar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130252,
					"content": "Em outro mundo, existem contos de uma ilha maravilhosa cujo nome está relacionado a maçãs douradas. Conhecida por muitos outros nomes, ela reúne as vistas majestosas criadas pela fantasia humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130253,
					"content": "Mamãe adora essa história e queria que você aproveitasse as coisas maravilhosas sobre ela, então mamãe deu a você águas de cor safira, areias peroladas, um paraíso fantástico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130254,
					"content": "Para você e para aqueles que te amam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130256,
					"content": "Portanto, havia apenas três cristais... Vermelho claro como pétalas de flores, azul claro como as ondas do mar, amarelo claro como folhas de outono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130257,
					"content": "Talvez da perspectiva de Alice, este arquipélago seja o quarto cristal natural. Localizado no meio do mar e coberto por plantas, é realmente um \"Cristal de Verão\" brilhante e de cor esmeralda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130258,
					"content": "Klee, assim como a mamãe, você pertence a uma raça abençoada pela longevidade. Para nós, o tempo é como uma rajada de vento: os momentos vêm e vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130259,
					"content": "Em uma vida tão longa, os pais são apenas a primeira conexão de uma criança. Mesmo que não queiramos nos separar, chegará o dia em que você deverá trilhar seu próprio caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130260,
					"content": "Klee, mamãe sempre vai amar você, mas também há outras pessoas ao seu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130261,
					"content": "Amigos que te acompanham, professores que te educam, pessoas que estão dispostas a ficar em uma ilha por você apesar de saber o quão incomum isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130262,
					"content": "O verão é para todos. Não importa como a vida mude, não importa quantas coisas aconteçam neste ano, o verão nunca vai desaparecer, assim como o amor entre as pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130263,
					"content": "De agora em diante, independentemente de onde quer que você vá, espero que você nunca esqueça quantas pessoas neste mundo amam você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130264,
					"content": "Ah, sim, não deixe de ouvir o Senhor Albedo em casa. A mamãe voltará regularmente para ver vocês dois. Na verdade, sempre que tenho um momento de sobra, eu volto às escondidas para ver como estão vocês e todos os outros. Hee-hee, ninguém notou até agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130265,
					"content": "A mesma de sempre, tia Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130266,
					"content": "Você não acha que o Albedo sabia desde o início, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130267,
					"content": "O que é isso? O tempo está quase acabando, então vou parar aqui. Certo, certo, eu me esforcei muito neste lugar, então todos vocês devem dar o máximo de si!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130268,
					"content": "Todo mundo, minha querida Klee, nos vemos da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130269,
					"content": "Tchau, mamãe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130270,
					"content": "Klee parece particularmente feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Hehe... Rei-Dodo era na verdade a mamãe. Eu não sei por quê, mas estou muito feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130272,
					"content": "Não importa se é a mamãe que explode o portão principal de Mondstadt, a mamãe que é colocada de castigo, ou a mamãe que escreve cartas esquisitas. Klee gosta muito de todas elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130273,
					"content": "Você se sentirá sozinha sem sua mãe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "Não. A mamãe é a feiticeira mais forte, então ela pode me fazer companhia, não importa onde ela esteja. Ela nunca me deixa sentir sozinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130275,
					"content": "Eu amo a mamãe eeeeeeesse montão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130276,
					"content": "#Cavaleir{F#a}{M#o} Honorável, você gosta de Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130277,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "Eu também te amo muito! Você tem que brincar muito comigo aqui, senão mamãe ficará desapontada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130279,
					"content": "Eu ainda tenho muitas Bombas Dançantes e trouxe a Dodoco para cá também. Vou levar você para nadar e explodir peixes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130280,
					"content": "É sempre divertido quando estamos com você, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130281
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130281,
					"content": "Ei, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130282
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130282,
					"content": "Não vamos deixar a Klee esperando. Vamos lá, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001303,
			"completionStepIds": [
				4001310
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001310",
							"2"
						],
						"stepId": 4001310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara",
					"Jean",
					"Klee",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130301,
					"content": "#Cavaleir{M#o}{F#a} Honorável, aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130302,
					"content": "Como estão os peixes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130303
					]
				},
				{
					"id": 400130303,
					"content": "Como suspeitávamos, eles foram atraídos para o cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130304
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130304,
					"content": "Pegar peixinhos, peixinhos, peixinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130305,
					"content": "Ah! Não, não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130306,
					"content": "Para evitar que a Klee exploda os peixes em pedacinhos, talvez seja melhor deixar a gente pescar os peixes. Afinal de contas, somos especialistas em capturar todo o tipo de vida selvagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
