			"dialogs": [
				{
					"id": 400130101,
					"content": "Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130102,
					"content": "Terminamos de colocar as escamas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "Sim, incrível! Hehehe, agora é a minha vez, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130104,
					"content": "Sim, vamos deixar esse mecanismo ali para você, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130105,
					"content": "Certo~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130106,
					"content": "Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130108,
					"content": "Por favor, tenha cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "Sim, entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130112,
					"content": "Klee, o que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130113,
					"content": "Klee... Klee está preocupada... O que eu faço se o Rei-Dodo realmente estiver aqui dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130114,
					"content": "E se ele não me permitir ser da família da Dodoco, ou se eu perder para ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130115,
					"content": "Então a Dodoco não poderá ficar comigo e a mamãe também ficará muito triste... Dodoco é a minha melhor amiga que a mamãe já me deu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130116,
					"content": "E-Eu estou com muito medo de apertar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130117,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130118,
					"content": "#Cavaleir{F#a}{M#o} Honorável, você pode pressionar o botão para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130119,
					"content": "Klee, eu não posso ajudar você a pressionar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130121,
					"content": "Porque eu preciso segurar bem minha arma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "Por aqui, eu posso proteger você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "Sim, Klee, todos estamos aqui por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130124,
					"content": "Não se preocupe Klee, todos nós estamos te apoiando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130125,
					"content": "Não importa quem seja o inimigo, enquanto estivermos aqui, não é preciso ter medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130126,
					"content": "Perfeito, também quero ver o quão forte realmente são os inimigos nesta ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 400130127,
					"content": "Vai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130128,
					"content": "Estou aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130129,
					"content": "Rapazes, não digam coisas assim... E se o Rei-Dodo só quiser convidar a Klee para conversar em sua casa? Ou... Sim! Talvez ele já tenha reconhecido a Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130130,
					"content": "Será que ele vai realmente me reconhecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130131,
					"content": "Por que ele não faria isso? Você sempre deu o melhor de si e fez um bom trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130132,
					"content": "É sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130133,
					"content": "Klee, você é minha amiga preferida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "...Tudo bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130136,
					"content": "Deixe isso comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130137,
					"content": "Aperte, aperte... Aperte o botão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130134,
					"content": "Ele vai aceitar você, estou certo disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "Nós vamos com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
