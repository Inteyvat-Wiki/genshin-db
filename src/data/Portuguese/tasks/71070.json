					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Não se preocupe, eu não ficarei parado sem fazer nada. Tenho que garantir que meus investimentos deem retorno, por isso devo ter certeza sobre a segurança da Equipe de Exploração.",
					"roleType": "TALK_ROLE_NPC",
