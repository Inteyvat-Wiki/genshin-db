	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "Ah, você está aqui. Obrigada por nos ajudar a abrir o caminho. Zhiqiong também foi uma grande ajuda para nos guiar, então obrigada vocês duas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "Sobre o acampamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Bem, parece bom, não é? Minha especialidade, aliás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Comecei a aprender tudo isso com meu pai quando eu tinha uns dez anos... Como montar acampamentos, como fazer Lâmpadas de Cristal, como fazer a manutenção de equipamentos de mineração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Aprendia e aprendia, e meu pai envelheceu... Eventualmente, quando sua visão começou a falhar, coube a mim manter os equipamentos de segurança na mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "E ainda mais tarde... Bem, como você pode ver, eu não sou mais jovem. Quanto ao resto da minha história, não é muito... encontrei um homem, e perdi-o, tive uma filha, mas ela foi estudar em Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Às vezes, quando os homens das minas nos deixam cedo, cabe a mim cuidar dos filhos deles... Então, eu carrego doces o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "E é por isso que... em minha impressão, as crianças sempre cheiram doce, olhando para mim, esperando para eu dar um doce ou umas pedras coloridas para brincarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "Uau. Hã, então, você tem doces com você agora, Jinwu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Doce? Bem, não é do tipo chique que você encontraria na cidade, mas você não vai ser exigente agora, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Ah, então é desse tipo de doce que você está falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "As pessoas vêm e vão, deixando apenas lembranças para me acompanhar... e aventureiros que entram nas minas como você são bons companheiros também, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Sobre Zhiqiong...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong é uma mineradora da nova geração, e ela nasceu em Vila Mingyun. Para ser honesta, todos os mineradores experientes do Despenhadeiro são da Vila Mingyun. Zhiqiong nasceu na hora errada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Ah, não me interpretem mal, não estou dizendo que os tempos são difíceis. É só que os veios de minério secaram em Mingyun há muito tempo, então a mineração lá já cessou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Pouco depois de Zhiqiong chegar ao Despenhadeiro, o incidente aconteceu e o trabalho lá também parou. Acho que ela não está destinada a ser mineradora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Er...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Todos seguiram caminhos separados depois disso, no entanto, eu escolhi ficar, já que os equipamentos precisam de manutenções. E ela, por sua vez, se tornou uma aventureira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Ela ainda é como se fosse criança, não cuidando bem da sua própria vida... Talvez ela tenha passado muito pouco tempo trabalhando arduamente nas minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Tenho certeza de que se acostumar com a vida de mineração e salvar algumas pessoas de situações perigosas pode lhe dar uma nova apreciação pela vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Bem, não tenho certeza se posso fazer esse pedido a você, mas você poderia cuidar dela por mim? Eu não quero ver que ela fica em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Tchau. Se cuide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Olá! Como têm sido suas viagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "Estão indo bem! Como está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Obrigado por me dar essa oportunidade lá atrás. Depois que nossa tentativa de criar detonadores da bala de canhão foi bem-sucedida, todos deixaram de se recusar à ideia de eu ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Quanto ao plano futuro depois de voltar à superfície... Heh, ainda não pensei nisso, mas provavelmente não vou me juntar aos Ladrões de Tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "Provavelmente...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Hã, oh, quero dizer, eu definitivamente nunca vou me juntar aos Ladrões dos Tesouros! Com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Se cuide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Sério...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "Você ... *suspiro* Hã? Oh. Olá. Desculpe. Você me incomodou lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "Isso nos deixa quites?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Tudo bem, pare de enrolar. Nossa situação atual não está boa. Não está nada boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Você já viu aquele fragmento de cristal brilhante, certo? Se meu palpite não estiver errado, deve haver um ainda maior mais abaixo... mas eu suponho que você já sabia disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "Em teoria, a leitura de energia deveria ter se estabilizado assim que o fragmento acima \"retornou\" ao seu local original. E foi isso que aconteceu, de fato... mas a forma de onda estava errada... totalmente errada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Do que você está falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "Eu não era um bom aluno. Bem, então, deixe-me explicar isso de forma simples. Atualmente somos como feijões em um moinho de pedra, à beira de um confronto entre duas grandes forças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "Embora em uma escala de tempo maior, estamos sendo atualmente esmagados por essas duas forças - uma de cima e outra de baixo. E logo seremos transformados em soja de feijão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Apenas espere e veja se você ainda não acredita em mim. Aquela aventureira chamada Zhiqiong... Bem, eu já vi o que acontece com aqueles que se aproximam demais dessas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Hoje vai estar tossindo sangue, e amanhã, ela pode tossir suas entranhas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
