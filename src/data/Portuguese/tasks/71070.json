					"id": 710701814,
					"content": "Você? Bem, dá-me algum tempo para pensar... Com certeza a gente pode arranjar uma maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
