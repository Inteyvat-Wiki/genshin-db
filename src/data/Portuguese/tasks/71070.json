						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Bem, sou um membro oficial do time agora, então já que eles vão ficar, eu ficarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Clitopho"
				},
				{
