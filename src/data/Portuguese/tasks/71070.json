					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "Precisamos selar esta área para impedir os mineradores... Não, para impedir qualquer pessoa descer aqui.",
