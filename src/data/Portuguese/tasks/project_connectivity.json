			"dialogs": [
				{
					"id": 736900101,
					"content": "Olá! Sou Daya do Kshahrewar. Você também veio participar da Feira da Sabedoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "Esse é o novo jogo que nosso Darshan criou: \"Plano de Passagem\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "Você gostaria de experimentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "Se me lembro bem, a especialidade do Kshahrewar é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "Estudamos mecânica e arquitetura, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "Uh, parece que saímos do assunto. Então, para participar desta Feira, muitos de nossos alunos discutiram suas ideias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "...E o resultado foi \"Plano de Passagem\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Basicamente, os jogadores precisarão usar vários objetos que preparamos para... bem, criar um caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Colocar pontes, mover escadas... O objetivo é criar um caminho que as pessoas atravessem para poder chegar ao destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Quando você tiver construído esse caminho, conduziremos uma verificação final, da mesma forma que testamos nossas construções finalizadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Essencialmente, você só precisa criar um caminho seguro para conquistar o desafio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "Isso parece bem complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Não se preocupe, não se preocupe! Não será exigido que você construa nada real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "Se algo der errado e as construções caírem, podemos reconstruir sem problemas. Também não colocamos limite no número de tentativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "Apenas liberte a sua imaginação e construa o caminho mais lindo possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "Posso tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Muito bem. Nesse caso, se você olhar nessa direção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "#Desculpe, estou um pouco ocupad{M#o}{F#a} no momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Ah, entendo... Tudo bem. Nosso estande estará aberto durante toda a duração da Feira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Quando sentir que quer participar, é só me chamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "Não tenho muito jeito para arquitetura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
