			},
			"dialogs": [
				{
					"id": 722460401,
					"content": "\"O mundo é vasto...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460402,
					"content": "É a \"Equipe de Jing Liuli\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460403,
					"content": "Sim. Você tem uma memória ótima, Kama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460404,
					"content": "Mas é a história que você me falou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				}
			]
		}
