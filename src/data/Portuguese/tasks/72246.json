			"dialogs": [
				{
					"id": 722460301,
					"content": "Senhorita Sumida, a senhorita tem algum plano para o destino que vamos depois disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Hmm... Falando nisso, ouvi dizer que existe uma enorme biblioteca em Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224604,
