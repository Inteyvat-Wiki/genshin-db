	"talks": [
		{
			"id": 7224601,
			"completionStepIds": [
				7224602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224602",
							"2"
						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "Que bracelete lindo! Que vaso lindo! As coisas de Liyue são realmente muito lindas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "... Não, não posso aceitar isso. Que pobreza de palavras, estou envergonhada de ser uma autora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "Compre um vaso requintado para usar como referência literária...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "Hmm ... Vou escrever um enredo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "\"A chave para reverter a situação, é uma Visão escondida em um vaso...! \"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "Eu acho muito interessante! E quanto a você, Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "Eu não me importo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "... Na minha opinião, você deve ser moderada na descrição do vaso. Uma descrição exagerada soaria muito forçado, mas uma descrição curta deixaria o leitor insatisfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "Oh, o que você está falando faz sentido! Vou anotar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "Ah, me desculpe! Vamos trocar de lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "Além disso, eu já falei muitas vezes, não me chame de senhorita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "...Mas, pensando bem, não é incomum que um par, aparentemente comum, de viajantes, se refiram um ao outro de \"senhor\" ou \"senhora\", não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "Uau! Que alegria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "Afinal, não é a maior biblioteca de todo o norte?! Quando eu tiver chance, vou ler \"A Melancolia de Vera\" inteira de uma vez! Que emoção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "Senhorita Sumida, por favor, fale mais baixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "Ah, me desculpe. É só que isso me deixou muito animada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "Não é isso, apenas temo que a senhorita possa se ferir. Aquela senhorita bibliotecária parece ter uma presença muito forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "Hã? Mesmo? Eu achei que ela era um tanto preguiçosa, como o arquétipo de uma feiticeira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "... Mas pensando melhor, geralmente personagens assim são os mais fortes. Oh não, isso não é bom. Eu não posso de maneira nenhuma irritá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "Ah, sim. Faz sentido. Na próxima vez farei um personagem assim ser o centro da obra que escreverei. Acho que a nomearei \"A Feiticeira da Grande Biblioteca\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "Como foram suas últimas viagens?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Há quanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#Oh, é {F#a}{M#o} lendári{F#a}{M#o} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "Viagens?... Antes eu viajava muito para reunir materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "\"Para descrever os raios destruidores, ia para a Garganta Musoujin\", \"para descrever uma serpente maléfica, ia para a Cabeça da Serpente\", \"para descrever a vida dos Perseguidores de Tempestades, pedi para Kama entrar no exército\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "Nunca é fácil para Kama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "Não é nada demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "Mas, desta vez se trata da viagem verdade. De um vagar sem rumo para locais longínquos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "Eu descobri que as histórias que merecem ser escritas, isto é, as histórias interessantes, são muitas. Assim como nas \"Viagens de Kino\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "Kama e eu fomos procurar pelos pontos turísticos e lojas que os habitantes locais nos recomendaram. Depois, acampamos na natureza, e compartilhamos a fogueira com outros viajantes que conhecemos na viagem, e partilhamos histórias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "Quando acordei, vi que todos os meus recursos para a viagem haviam sido roubados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "... Isso não é problemático?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Não é problema algum. Quando encontrei os ladrões, vi que eram uma dezena e pensei que não havia como conseguir minhas coisas de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "Mas apesar de tudo isso, Kama os convenceu a nos dar todo o dinheiro e de volta, e ainda trouxe muitas moedas com gravações de corvos nelas como lembrança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "Sinto que posso escrever isso em uma história interessante, mas Kama não quer me contar como fez isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Era o que tinha de ser feito. A Senhorita Sumida não deveria se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "Não, é você que é muito confiável, Kama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "Quando estou viajando com você, sinto que mesmo se viajássemos para o topo do mundo, não haveria problema algum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "Além disso, sempre estou com a sensação de que desde que voltamos da Ilha Tsurumi, você mudou bastante. Você fala sobre o que quer fazer, e também menciona seus questionamentos e pontos de vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "Se a Senhorita Sumida não achar apropriado, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "Eu acho isso ótimo! Todos as suas opiniões são dignas de serem pensadas a respeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "Bem, eu não vou mais incomodar vocês então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Sim. Adeus, {NICKNAME}. Que sejamos como em \"Flores para a Princesa Fischl\" e nos encontremos no limite de todas as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460235,
					"content": "#Obrigado, {NICKNAME}. Cuide-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460233,
					"content": "Talvez nos encontremos novamente em outro lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Kama realmente é muito habilidoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
			"id": 7224603,
