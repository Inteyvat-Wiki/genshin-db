				{
					"id": 711051101,
					"content": "Se não há mais nada, vou deixar vocês olharem ao redor como quiserem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711051102,
					"content": "Então realmente não havia ninguém chamada Xiangjun...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711051103,
					"content": "Vou fazer algumas perguntas por aí. Talvez tenha sido só um equívoco, algo como alguém esquecendo onde vive, essas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711051104,
					"content": "#De qualquer forma, obrigado por ir ajudar aquele \"Adeptus\" a regar as ervas. Tenho certeza que ele fará o que puder para protegê-l{M#o}{F#a} de qualquer mal como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tio Luo"
				}
			]
		}
