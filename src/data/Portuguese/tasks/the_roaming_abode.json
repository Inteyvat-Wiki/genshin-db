				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tio Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "Ah... Viajante, é você. Você parece estar com pressa. Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050802,
					"content": "Nós... Bem, você sabe onde Xiangjun e o avô dela moram, Tio Luo? Estamos procurando por eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "Xiangjun? Nunca ouvi falar dela. Ela é daqui da região? Tenho certeza que conheço todos na vila...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050804,
					"content": "Sério? Não pode ser... Nós encontramos uma menina do lado de fora que se chamava Xiangjun, e disse que mora na Vila Qiaoying. Ela nos pediu para ajudar a encontrar o avô dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "Ela também tem uma jangada enorme de bambu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Bem, você pode encontrar isso com facilidade, mas Xiangjun... Tenho quase certeza que não há ninguém com esse nome na nossa vila. Como é o nome do avô dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050807,
					"content": "Ele coleta ervas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Um coletor de ervas? Deixe-me pensar. A gente tinha um, eu me lembro... Mas faz três anos desde que ele morreu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050809,
					"content": "Ele morreu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Sim. Ele encontrou monstros na natureza e... *Suspiro*. Mesmo assim, eu duvido que é quem você está procurando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050811,
					"content": "Ele sempre foi um pouco excêntrico, e nunca se casou, quem dirá ter descendentes de qualquer tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050812,
					"content": "Espere... O que está acontecendo aqui? Então, aquela Xiangjun que conhecemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "...Poderia ela ter sido o verdadeiro demônio aqui!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Quais remédios os coletores de ervas da vila coletam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "São flores e plantas que eu nunca vi antes. Esse velhote só sabe de chá, então eu seria de pouca ajuda aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050816,
					"content": "Mas eu me lembro que encontramos ele perto do Monte Xuanlian. Ele ainda estava segurando uma garrafa de água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050817,
					"content": "Ele disse que tinha uma planta divina no seu quintal que precisava desse tipo de água abençoada para crescer. Tenho pena dele, quer dizer... aquilo era tudo água de rio. Nada de especial! Por que ele teve que desistir da vida por causa disso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050818,
					"content": "*Suspiro* Ainda assim, depois que o enterramos, derramamos a água que ele obteve naquele quintal dele. Espero que isso traga a ele algum consolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050819,
					"content": "As águas abençoadas do Monte Xuanlian? Nós fomos lá e tiramos um pouco de água também... Então, esse coletor de ervas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Acho que estamos falando da mesma pessoa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Bem, isso são acontecimentos estranhos, sem dúvida... Por que você não vem comigo? Eu vou te levar até o quintal daquele sujeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Tio Luo"
				},
				{
					"id": 711050822,
					"content": "Se vocês realmente tiraram água, eu suponho que podem simplesmente derramá-la no jardim dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tio Luo"
				}
			]
		},
