						],
						"pointId": 311400096
					}
				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Hã? Deve ser aqui, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Por que não tem ninguém aqui? Parece que não há rastros também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Talvez ele já voltou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Paimon não acha que isso poderia acontecer. Ele está ferido, será que ele poderia ter caminhado tanto assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Mas ele não está perto também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Alguém poderia tê-lo encontrado na estrada e o resgatado? Paimon acha que isso pode ter acontecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Por que não voltamos para a Vila Qiaoying e perguntamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Vamos pegar um pouco desta \"água abençoada\" primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Hã? Ah, certo. Se o avô da Xiangjun foi resgatado, ele ainda pode precisar disto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Vamos considerar isso como uma ajuda. Hehe, {NICKNAME}, você é muito atencios{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
