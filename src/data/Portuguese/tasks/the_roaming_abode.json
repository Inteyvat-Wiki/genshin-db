			"dialogs": [
				{
					"id": 711050101,
					"content": "Vovô...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "Hã? E aí, garotinha, o que você está fazendo aqui fora à noite? Qual seu nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Eu sou Xiangjun... estou procurando pelo meu avô... ele foi sequestrado por demônios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "D... Demônios? Onde? Que tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "Eu... Eu não sei também... Vovô disse que eles estão nas montanhas, então eu não deveria ir pra lá sozinha... Mas ele não voltou de lá faz três dias já...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Aposto que ele só queria lhe assustar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Paimon acha também... Ele te disse o que ele ia fazer naquelas montanhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "O vovô coleta ervas na vila. Ele encontrou uma planta divina recentemente, uma que dizem apenas crescer quando regada com as águas abençoadas perto do Monte Xuanlian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "Então... ele pode ter se batido de frente com alguns demônios protegendo a água?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "Não se preocupe demais, Xiangjun. Seu avô pode ter encontrado apenas um pequeno problema. Também está ficando muito tarde, você se importa se te levarmos para casa primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Mas eu quero resgatar ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "A gente pode te ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Isso mesmo! Mas se você não for para casa, pode causar ainda mais problemas para seu avô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "Ah, eu... não quero fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "Então vamos procurá-lo enquanto você fica em casa, certo? Vamos te levar para casa primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "Está bem. Eu moro na Vila Qiaoying. Posso voltar sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "Mas... você poderia ir procurar o vovô imediatamente? Estou preocupada com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Ah, vai dar certo. Dito isso... você sabe para onde exatamente ele foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Eu apenas sei que ele foi por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "Nesse caso, é por lá que vamos começar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "Muito obrigada! Vou voltar agora. Não vou causar problemas para vocês... então vou esperar por vocês lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110502",
							"2"
						],
						"stepId": 7110502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"Eu dormi demais! Tenho que voltar antes de amanhã, se não ninguém vai cuidar da Xiangjun... Ah, sou um tolo...!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050202,
					"content": "\"Se eu bem me lembro, há um atalho, uma estrada pequena que leva do Vale Yaodie ao Monte Xuanlian. Só precisamos passar por mais essa caverna de montanha, e estaremos bem...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050203,
					"content": "\"Ouvi dizer que há monstros por perto, mas tenho que tentar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050204,
					"content": "Isso parece algo que o vovô pode ter deixado para trás. Parece que ele pegou uma estradinha, vamos procurar por ela também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"...Eu estava preocupado com monstros desde o início, mas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050502,
					"content": "\"...Escorreu tanto... minha coxa... não consigo parar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050503,
					"content": "\"...Tão sonolento... Mas o Monte Xuanlian está logo ali... Xiangjun, eu definitivamente vou conseguir essas águas abençoadas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050504,
					"content": "\"Xiangjun... Eu com certeza vou conseguir essas águas abençoadas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Notas de Alguém"
				},
				{
					"id": 711050505,
					"content": "Essa não... Ele foi atacado por monstros e ficou gravemente ferido no processo... Espere, e ele ainda quer pegar água do Monte Xuanlian mesmo assim!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Vamos rápido — precisamos ver se podemos ajudá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110506,
