			"dialogs": [
				{
					"id": 50301401,
					"content": "Estou feliz de ver que você voltou em segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301402
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301402,
					"content": "Só estamos mantendo nossa palavra! Dissemos que te veríamos no Estádio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Heh... Sabe, essa foi a primeira vez em minha vida derrotando um monstro do Abismo, e eu percebi naquele momento que... eles não são tão durões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301404
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301404,
					"content": "Deixei meu medo ganhar por muito tempo... Me faz pensar quantas pessoas eu poderia ter salvado se pelo menos tivesse tido coragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301405
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301405,
					"content": "Não seja tão duro consigo. No momento, ficar vivo é a coisa mais importante que você pode fazer. Precisamos viver para que suas histórias possam ser contadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301406
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301406,
					"content": "Eles viverão para sempre em nossos corações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Libiac"
				}
			]
