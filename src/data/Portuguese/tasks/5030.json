				"points": []
			},
			"dialogs": [
				{
					"id": 50300901,
					"content": "...Oh, são vocês. Achei que nunca mais veria vocês novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300902
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300902,
					"content": "Lutei bastante, e ganhamos, mesmo que tenha nos custado muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300903
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300903,
					"content": "Você vai continuar lutando? Se for, por favor, tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300904
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300904,
					"content": "Lutar contra o Abismo é uma grande honra, mas o caminho para a vitória não está na honra ou glória, mas em sobreviver até o dia seguinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
