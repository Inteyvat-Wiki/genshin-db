				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "São vocês! Fantástico! Sou muito grato a todo seu encorajamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Muitas pessoas em Natlan veem como uma honra lutar contra o Abismo, mas aí elas deixam a animação subir a cabeça e acabam se colocando em grande risco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Você tinha razão: É importante lutar, mas também é importante continuar vivo. Lutamos pelas pessoas que amamos e também pela oportunidade de vê-las novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Compartilhei sua opinião com meus irmãos de guerra, e eles também ficaram inspirados. Agora, todos estão lutando com mais determinação e estamos virando o jogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "Então, novamente... muito obrigado, do fundo do meu coração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
		{
			"id": 503009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
