			"dialogs": [
				{
					"id": 50300301,
					"content": "Qual é a situação? Temos suprimentos médicos suficientes sobrando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300302,
					"content": "Está quase no fim. Ainda há alguns suprimentos de emergência, mas eles estão reservados para os médicos e soldados. Não podemos tocar neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Eu sei, eu sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300304,
					"content": "Bem, então... pelo menos, me dê uma parte.",
