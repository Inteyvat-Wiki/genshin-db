					"nextDialogs": [
						50301502
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301502,
					"content": "Então você chegou em segurança, hein? Foi tudo tranquilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301503,
					"content": "Uh... não exatamente. Nos deparamos com um monte de monstros do Abismo e tivemos que lutar por nossas vidas. Mas tenho que dizer, eles realmente se saíram bem. Lutaram tão bem quanto guerreiros bem treinados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301504
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301504,
					"content": "Hehe, acho que a antiga memória muscular ainda está intacta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "Me sinto bem sortudo por estar vivo. Temos que continuar sobrevivendo, para podermos começar a recuperar o que perdemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "É melhor vocês garantirem que vão continuar sobrevivendo também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunak"
				}
