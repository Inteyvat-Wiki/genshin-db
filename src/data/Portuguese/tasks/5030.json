			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Oh, Arcontes, não sei o que fazer... Estamos sem pessoal e recursos, e eu não consigo nem cuidar de metade dos ferimentos que estou vendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "Eu apenas gostaria de ter alguém com mais experiência para pedir ajuda... urg, não, não posso pensar assim. Preciso enfrentar o desafio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Vi que você trouxe Chuychu de volta... É uma tragédia tão grande. Chuychu era a médica mais promissora que já tive o prazer de conhecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Éramos parceiros de negócios próximos. Ela tinha exigências bem altas para suprimentos médicos, e costumava tirar de seu próprio bolso para tratar seus pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Ela sempre me disse que valorizava a experiência mais do que o dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Ela disse precisar aperfeiçoar suas habilidades para que pudesse salvar mais pessoas, especialmente a pessoa que ela mais queria salvar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Infelizmente, no fim, a única pessoa que ela não pôde salvar foi a si mesma. E agora Natlan perdeu um de seus melhores talentos desta geração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
