					"nextDialogs": [
						50300505
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50301601,
					"content": "Ah, são vocês. Fico feliz de ver que estão bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Como está seu filho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Não faço ideia. Não estamos nos comunicando, e há muitas pessoas feridas para cuidar. No momento, meu foco está neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Mas eu confio nele. Sei que fará a escolha certa quando as coisas apertarem. Ele é meu filho e sempre terei orgulho dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
