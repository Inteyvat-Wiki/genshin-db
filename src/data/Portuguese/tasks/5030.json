			"dialogs": [
				{
					"id": 50300601,
					"content": "Estou tão grata que Mayahuel está aqui. Com a experiência dela, pudemos cuidar de muito mais pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300602
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300602,
					"content": "Mas estou preocupada de ela estar se esforçando demais. Ela não parou esse tempo inteiro. Preciso achar alguém para colocar no lugar dela para eu convencê-la a fazer uma pausa.",
					"roleType": "TALK_ROLE_NPC",
