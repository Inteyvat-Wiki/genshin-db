			"dialogs": [
				{
					"id": 50301101,
					"content": "#Oh, são vocês. Obrigado novamente por nos resgatar. Osawe, veja só quem é! Diga \"obrigado\" a {M#esses heróis}{F#essas heroínas}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301102
					],
					"speakerTitle": "Iyoba"
				},
				{
					"id": 50301102,
					"content": "Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301103
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301103,
					"content": "Ei, não foi nada. Só fico feliz que você esteja bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301104,
					"content": "Também preciso agradecer às outras pessoas que nos ajudaram. Como que se chamavam mesmo? Faz... Flui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301105
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301105,
					"content": "Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301106,
					"content": "É, isso mesmo, os Fatui! Eles também foram incríveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301107
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301107,
					"content": "É, no passado, minha impressão dos Fatui não era exatamente positiva, mas isso realmente mudou minha visão. Pessoas boas podem ser encontradas em qualquer organização.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iyoba"
				}
			]
		},
