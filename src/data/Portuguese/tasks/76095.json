			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Paimon... obrigada. Estou muito feliz por ter encontrado vocês no fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950102,
					"content": "Hehe. Se for para dizer alguma coisa, parece que você acabou sendo arrastada para tudo isso por causa da gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950103,
					"content": "Calma, \"no fim\"? O que você quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950104,
					"content": "Quero dizer... todas foram aventuras bem perigosas. Mas eu pude ver tantas coisas incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950105,
					"content": "Isso nem é tão ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950106,
					"content": "Ei! Não desconverse assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950107,
					"content": "Eu desconversei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zeitlind"
				}
			]
		},
