							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, nós basicamente libertamos todas as três áreas. A maioria das pessoas também está segura agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "E ainda encontramos tudo o que Zeitlind tinha perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Ah, muito obrigado. Tenho que dizer, Nihilita tem um olhar e tanto agora que abriu o olho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Certo, agora é a sua vez! Você mencionou antes que tem um jeito de subir lá para cima, e um preço para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Se for só um punhado de aventuras ou um pouco de Mora, Paimon não tem medo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "Ah! E a Zeitlind? Como a gente vai mandar ela de volta para baixo agora que ela já terminou aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Eu posso explicar tudo isso, mas você deve descansar primeiro. Vou passar por tudo em detalhes amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Tá bom. Mas, hm, não tem cama aqui. Nem comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Essas necessidades simplesmente somem aqui. Pense bem. Você está aqui esse tempo todo, mas não está com fome. E não está cansada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "Hã? Então o que a Paimon vai fazer o dia todo enquanto a gente descansa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Este lugar está cheio de pessoas notáveis de todas as eras, conversar com elas pode ser divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Tudo bem, tá bom. Mas a Paimon vai dormir quando ela quiser. Cansada ou não, Paimon ainda vai dormir na cabeça d{M#o}{F#a} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, depois que você descansar um pouco, podemos conversar? É sobre o que mencionei antes, a coisa que eu precisava de tempo para considerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Venha falar comigo mais tarde, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "Está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}. Paimon. Quando estiverem descansad{M#o}{F#a}s, venham me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
