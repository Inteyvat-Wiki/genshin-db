			"dialogs": [
				{
					"id": 250350801,
					"content": "Dois... Três... São todos eles! Excelente trabalho, você recuperou todos os pacotes desaparecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "...Espera um segundo, esse pacote não devia ser entregue por Tundama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "Aqui está seu pagamento. Agradeço a ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350804,
					"content": "Argh, vou ter que ter uma conversa séria com Tundama sobre isso...",
