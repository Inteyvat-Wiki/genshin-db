			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Esses tolos... Como eles perderam outra carga? Eu falei para eles não brincarem quando estivessem fora entregando coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Alguns entregadores ignoraram as instruções mais uma vez e, como resultado, eles foram e perderam um monte de pacotes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "*Suspiro* Eles não percebem que tal descuido danifica a reputação dos Descendentes das Copas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Quando você está fora a trabalho, foque em entregar coisas! Se você tá descendo uma ladeira, só continue indo como normalmente iria. Por que você iria começar a descer como se estivesse de férias?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Eu disse a eles muitas vezes, mas esses jovens se recusam a ouvir. Tudo que se importam é ir atrás de emoção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "*Suspiro* Agora vou ter que arranjar alguém para ir recuperar aqueles pacotes. Me deixa pensar, quem está livre agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Vou te dar uma mão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "V-Você vai me ajudar mesmo? Que maravilha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Ia levar um tempo até eu achar alguém que pudesse ajudar, e se eu mesmo saísse procurando, não ia ter ninguém cuidando da Maloca dos Mensageiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "E não se preocupe, eu só não deixaria você ir atrás de uma agulha num palheiro. Sei as rotas que os moleques geralmente pegam, então provavelmente posso adivinhar onde os pacotes desapareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "Vou marcar os locais possíveis dos pacotes desaparecidos para você. Conto contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Esses pacotes são grandes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Não são. Mas exatamente por isso, eles são sempre muito trabalhosos de encontrar. *Suspiro* Aqueles descuidados malditos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "#Então, se tiver tempo, estaria mesmo dispost{M#o}{F#a} a rastrear aqueles pacotes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "A Maloca dos Mensageiros está sofrendo com falta de mão-de-obra no momento, então se eu saísse para procurar, não ia ter ninguém cuidando da loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Sem problemas, deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Que incrível! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
