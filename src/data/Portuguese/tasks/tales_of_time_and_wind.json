			},
			"dialogs": [
				{
					"id": 100070701,
					"content": "#Pronto, isso deve resolver. Foi uma apresentação magnífica, {NICKNAME}. Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Esse poder que você liberou agora há pouco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ah, não se preocupe. Esse poder era meu e só meu. Nenhuma ajuda externa esteve envolvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Pense nisso como... afinar um instrumento musical para que ele toque melodias ainda mais belas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Hah! Então você tem alguns truques na manga! O que mais está escondendo, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Ah, Paimon. Quantos truques eu poderia ter? Afinal, só tenho duas mangas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Você sabe que não foi isso que a Paimon quis dizer, Bardo Desafinado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Hahaha, tenho a sensação de que o vento vai soprar bem forte hoje. Devemos voltar para Mondstadt e avisar o pessoal para segurar bem os chapéus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1504501",
