			"dialogs": [
				{
					"id": 100070501,
					"content": "Ah, parece que nossa música inspirou parte da plateia a subir ao palco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "Mas isso vai contra as regras do concerto, então vamos conduzi-los para fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
