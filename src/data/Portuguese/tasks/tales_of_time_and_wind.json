						"pointId": 14222
					}
				]
			},
			"dialogs": [
				{
					"id": 100070301,
					"content": "A Paimon achou que teríamos que voar bem longe, mas parece que estamos logo fora da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "Essa ilha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "Ela é especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Nem sempre. Um dia, foi uma ilha como qualquer outra, uma simples e modesta junção de areia e cascalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Isto é, até que sementes de histórias foram trazidas até aqui pelo vento e cultivadas pelo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "E, com o passar dos dias, o vento fez surgir novos contos, e o tempo os fez crescer até se tornarem lendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#Então, com isso... permita-me dar-lhe as boas-vindas, na \"verdade\", a esta ilha favorecida pelo Tempo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Este é o lugar onde Tempo e Vento se encontraram em um passado distante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Ei, ei, ei... Você ficou todo sério do nada, Bardo Desafinado. Paimon nem tem mais certeza se está acompanhando essa conversa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Hehe, não se preocupe, querida Paimon! As melhores histórias sempre começam com um toque de suspense e mistério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
