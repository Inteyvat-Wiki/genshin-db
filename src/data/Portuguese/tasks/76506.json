			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Ora, ora, se não é {NICKNAME} e a Paimon? Que coincidência maravilhosa — minha sorte deve estar mudando, com certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori? O que você tá fazendo aqui sozinha? Tá planejando montar uma lojinha? ... Hmm, mas Paimon não tá vendo você com nenhuma mercadoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Ah, minhas mais sinceras desculpas, mas a renomada mercadora itinerante Dori tirou o dia de folga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Pode dizer que estou seguindo o exemplo dos locais e curtindo um dia normal e despreocupado nesse paraíso chamado Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Hã? Sério mesmo? Você, sem estar ocupada fazendo Mora? Daqui a pouco vai dizer que choveu o ano inteiro no deserto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Hehe, vou te contar uma coisa — mesmo que eu tire uma folga, meus funcionários diligentes e competentes continuam expandindo nossas fontes de receita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Então não há com o que se preocupar — desde que os números das contas continuem subindo, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Falando nisso... Será que vocês estão com algum problema? Posso estar de férias, mas nunca recuso um negócio que bate à minha porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Ahh, então vocês vieram tirar fotos das paisagens únicas de Nod-Krai, hã? Nesse caso, vieram à pessoa certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Conheço esse lugar como a palma da minha mão — não tão bem quanto os locais, claro, mas se precisam de recomendações, eu tenho várias aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "E como somos amigos, vou pessoalmente servir de guia, com um belo desconto de amizade incluso. Entãooo... que tal 500.000 Mora por dia, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Uau, essa é a Dori mesmo. Nunca passa algumas frases sem mencionar as Mora nos nossos bolsos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "#Ah, não, não! Estou fazendo isso por vocês, {F#minhas estimadas e valorosas}{M#meus estimados e valorosos} clientes, para que tenham uma experiência adorável, maravilhosa e inesquecível aqui em Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Bem, já que está tão empolgada em nos ajudar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Hmm? Uma ideia interessante, sem dúvida. Mas aviso desde já: tais fotos não podem ser usadas em propagandas comerciais. Os direitos de imagem são inestimáveis, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Ah, não se preocupe, é só uma foto de uma velha amiga — sabe como é, pra recordar os velhos tempos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Mas é claro, é claro! Já que foi um pedido seu, {NICKNAME}, vou abrir uma exceção. Só uma — e tudo que peço é que eu saia deslumbrante, combinado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Deixe-me pensar... Que tal \"Dori, Lorde Sangemah Bay, e Suas Férias no Paraíso\" como legenda? Brilhante, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Podemos tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "E procurando algum material para fotos enquanto estamos nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
