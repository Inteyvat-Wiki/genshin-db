			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea... é uma anciã que eu respeito muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "Depois que meu avô morreu, os anciões votaram para que eu me tornasse chefe da nossa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "Eu sempre tenho um monte de ideias novas bem doidas, então todos acreditavam que eu poderia liderar nossa tribo em direção a um tipo de futuro diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "Mas, por um bom tempo, eu não fazia ideia do que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "Mas Atea sempre esteve ali para me encorajar. Mesmo quando cometi erros, ela nunca me fez sentir mal por errar. Ela me ajudava a analisar o que deu errado e me ajudava a melhorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "Ela é alguém que respeito muito, então... Me lembrarei do que ela me ensinou, e trabalharei duro para me tornar a chefe que nossa tribo merece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
