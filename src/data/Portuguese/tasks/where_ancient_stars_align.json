			"dialogs": [
				{
					"id": 411140901,
					"content": "Achei o livro dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140902,
					"content": "Ooh, deixe-me dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140903,
					"content": "Faltam algumas páginas, a narrativa não é coerente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140904
					]
				},
				{
					"id": 411140904,
					"content": "Hah, eu sabia disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140905,
					"content": "Se eu fosse uma astróloga comum, provavelmente já teria desistido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140906,
					"content": "Mas eu, Mona, sou a progenitora da astrologia do futuro, não há nada que possa me parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140907,
					"content": "Simplesmente preciso deduzir as partes que faltam com meu astrolábio, escrevê-las e depois decifrar o texto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140908
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140908,
					"content": "Uff! Finalmente terminei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140909
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140909,
					"content": "Fale logo o que diz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140910,
					"content": "Foi como eu pensei, Leonard é um Aventureiro de dois mil anos atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140911
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140911,
					"content": "O sonho de sua vida era escalar uma montanha chamada Pico do Chapéu Pontudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140912,
					"content": "Dois mil anos? Esses meteoritos são a Constelação de uma pessoa tão antiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140913,
					"content": "A Constelação dele, por algum motivo desconhecido, foi convocada do céu. Eu acredito que os Fatui tenham algo a ver com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140914
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140914,
					"content": "Paimon concorda, quando algo esquisito acontece, os Fatui sempre estão envolvidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140915,
					"content": "Esses meteoritos possuem poderes elementais e irradiam ela, fazendo as pessoas entrarem num sono profundo, como hipnose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140916,
					"content": "Além disso, se minha hipótese estiver correta, deve existir entre esses meteoritos um que é o seu núcleo, que dentro dele está o cristal do espírito de Leonard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140917
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140917,
					"content": "Onde ele está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140918
					]
				},
				{
					"id": 411140918,
					"content": "Se eu fosse Leonard, faria com que esse núcleo caísse no topo da montanha que nunca alcancei quando era vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140919
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140919,
					"content": "Então o núcleo está no Pico do Chapéu Pontudo? Mas onde é o Pico do Chapéu Pontudo? Nunca ouvi falar nesse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140920,
					"content": "Também é a primeira vez que ouço falar nele. Comparando o mapa no livro com a topografia de Mondstadt, eu descobri que o Pico do Chapéu Pontudo não existe mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140921
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140921,
					"content": "Mas como é que uma montanha tão grande pode desaparecer?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140922,
					"content": "Eu li no livro que Barbatos, o Arconte Anemo, usou seus poderes para soprar a neve e o gelo para longe, e mudou toda a aparência de Mondstadt no processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140923
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140923,
					"content": "As montanhas daquela época foram substituídas pela vasta extensão do oceano que vemos hoje. Se colocássemos aquela montanha com tal altura no mar, deveria deixar algum rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140924,
					"content": "O pico está pouco acima da superfície da água. O Pico de Pilos hoje é conhecido como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140925
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411140925,
					"content": "<color=#00E1FFFF>\"Recife de Musk\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4111411,
			"completionStepIds": [
				4111411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111411",
							"2"
						],
						"stepId": 4111411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scaramouche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141101,
					"content": "Ha? O Recife de Musk é Pico do Chapéu Pontudo? Se tornou bem pequeno mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141102,
					"content": "Parece que alguém chegou antes de nós... Isso aqui é um ponto turístico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141103,
					"content": "Ah! É você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141104,
					"content": "Uh? Vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141105,
						411141106
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141105,
					"content": "Como você achou este lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				},
				{
					"id": 411141107,
					"content": "Olhe para ele, será que acabou de sair do sonho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141108,
					"content": "Há pessoas que conseguem sair do sonho com seu próprio poder... Como isso é possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141109,
					"content": "Bah! Só porque vocês são incapazes de fazer algo, não significa que eu sou também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141110
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141110,
					"content": "Vocês chegaram tarde, já conclui minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141111
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141111,
					"content": "Nós sabíamos! Tudo isso era algo feito pelos Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141112,
					"content": "Me poupe. Não tenho tempo para brincar com vocês hoje. Irei atrás de vocês quando estiver bem e preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141113
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141113,
					"content": "Espere! Qual é seu objetivo?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141114
					]
				},
				{
					"id": 411141114,
					"content": "Você entrou no sono que todas aquelas pessoas estavam tendo, não é? Quanto você sabe sobre Leonard?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141115,
					"content": "Leonard? Que Leonard... Esqueçam, agora não é hora de se preocupar com peixes pequenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141116
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141116,
					"content": "Eu descobri algo... Mais importante, e mais assustador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141117
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141117,
					"content": "Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141118,
					"content": "O quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141119
					]
				},
				{
					"id": 411141119,
					"content": "As estrelas, o céu, tudo é uma grande mentira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141120
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141120,
					"content": "As estrelas... Uma mentira? O que você está dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141121
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141121,
					"content": "Você quer refutar as teorias astrológicas de Mona? Se for isso, você pode pensar em algo melhor que \"As estrelas são uma mentira\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141122,
					"content": "Durante a noite, qualquer um não pode levantar a cabeça e ver as estrelas? Isso é conhecimento comum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141123,
					"content": "Hahahahahaha! Você é tão inocente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141124
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141124,
					"content": "Entretanto, isso não é culpa sua, porque eu também não sabia disso até agora há pouco, também acreditava que era verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141125
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141125,
					"content": "Até agora há pouco? Você quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141126,
					"content": "Humpf, eu não tenho tempo para isso agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141127
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141127,
					"content": "Bobo da Corte... Ele me deu essa missão sem avisar as possíveis descobertas... Com certeza queria me assustar de propósito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141128
					],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141128,
					"content": "Agora, eu preciso ir descobrir a verdade. Enquanto isso, adeus, fracassados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scaramouche"
				},
				{
					"id": 411141106,
					"content": "Você é aquele que acabou de acordar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141107
					]
				}
			]
		},
