			},
			"dialogs": [
				{
					"id": 411140701,
					"content": "Existem vários Aventureiros com esse nome, não posso saber a qual você está se referindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140702,
					"content": "Entretanto, lembro que existe um livro na biblioteca de autoria de alguém chamado Leonard. Talvez você devesse dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 411140703,
					"content": "Eu me lembro de que na <color=#00E1FFFF>Biblioteca</color> há um livro cujo autor é o Leonard. Vamos ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 4111408,
			"completionStepIds": [
				4111414
			],
