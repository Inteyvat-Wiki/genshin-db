			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "Ah, então esse é o núcleo, não parece com nenhum dos outros meteoritos! É um pouco... Brilhante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141602,
					"content": "Essa pedra contém uma quantidade inacreditável de energia elemental, e de desejos humanos. Com certeza é o núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141603,
					"content": "Devemos... Devemos destruí-lo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "Sim. Caso contrário, as vítimas jamais acordarão... Esse núcleo é a causa de tudo que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141605,
					"content": "#{NICKNAME}, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141606,
					"content": "Uau. Bem, isso era inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141607,
					"content": "As pessoas que estão escalando tentam alcançar o pico desconhecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "Quem pensaria que a vontade humana pode sobreviver nos céus por milênios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141610,
					"content": "Astrologia é realmente algo incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141611,
					"content": "... Por que você disse isso do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141612,
					"content": "A habilidade de se comunicar com as estrelas pode lhe dar acesso a todos os segredos da história humana... Mas, claro, poucos astrólogos chegam a esse nível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141613,
					"content": "#Mona, muito obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "Uh, por que você está falando em um tom tão formal do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141615,
					"content": "E falando de tom formal, aquela Fischl, ela é muito estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141616,
					"content": "Paimon também acha isso! Ela... Como posso dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141617,
					"content": "É uma pessoa cheia de pensamentos e ideias estranhas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "É... mas se você pensar bem, ela estava certa desde o começo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141620,
					"content": "Ela é uma dessas pessoas que usa o método errado, mas ainda chega na resposta certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141621,
					"content": "Creio que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141622,
					"content": "Ainda assim, Paimon acha que o mais surpreendente é como o Pico do Chapéu Pontudo se tornou uma ilha minúscula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141623,
					"content": "Uma montanha do passado agora é uma ilha no mar. Quase qualquer um de Mondstadt poderia chegar nela só indo em um barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141624,
					"content": "Noutras palavras, qualquer um pode escalar o Pico do Chapéu Pontudo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141625,
					"content": "Todos podem alcançar o topo da montanha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "Será que Leonard está feliz? Apesar da situação do Pico do Chapéu Pontudo ser inesperada, mas agora, com a ajuda do Arconte Anemo, as pessoas de Mondstadt são capazes de planar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141627,
					"content": "Com planadores, as pessoas podem viajar mais e voar mais alto do que nunca, explorando novos e desconhecidos lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141628,
					"content": "(Leonard, você realizou o seu sonho?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "Muito bem, agora que lidamos com o núcleo do meteorito, as pessoas que estavam dormindo devem acordar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141630,
					"content": "E finalmente terminamos nossa missão da Guilda dos Aventureiros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141631,
					"content": "Hmm, espero que todos possam se recuperar logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "É uma pessoa excêntrica que pensa nas coisas mais absurdas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "Uma pessoa forte queria que sua força de vontade fosse transmitida para o futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}