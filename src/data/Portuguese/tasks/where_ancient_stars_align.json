			"dialogs": [
				{
					"id": 411140801,
					"content": "Autor, Leonard... Leonard... Achei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140802,
					"content": "De acordo com o índice, o Guia para os Aventureiros do Leonard fica no <color=#00E1FFFF>noroeste</color> do <color=#00E1FFFF>primeiro andar</color> da Biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411140803,
					"content": "Canto noroeste... Deve ser ali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111409,
