			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "Achei! \"Sobre Montanhas e Mares\", o Guia para Aventureiros escrito por Leonard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141402,
					"content": "Mas, faltam páginas neste livro, Paimon não consegue ler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141403,
					"content": "Talvez só estejamos perdendo tempo com isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141404,
					"content": "Não desista, dê para Mona dar uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "Ah, sim, talvez ela tenha alguma ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
