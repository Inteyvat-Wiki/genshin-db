				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "Uau, você lutou bravamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141502,
					"content": "Eu disse! Isso é o que acontece quando alguém me desrespeita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141503,
					"content": "Mona é muito forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "Claro! Paimon, você também me acha muito forte, não é? Não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141505,
					"content": "Sim, Sim, sem Mona, com certeza teríamos encontrado problemas maiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411141506,
					"content": "O que você acha disso, Mensageiro? Escória!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141507,
					"content": "Mas ele ficou assustado, não parecia estar mentindo. Será que o \"céu falso\" que a minha mestra me ensinou tem outro significado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141508,
					"content": "Mas, deixemos isso para lá. Vamos, temos um trabalho para terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411141509,
					"content": "<color=#00E1FFFF>O núcleo do meteorito</color>, com certeza está aqui próximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111416,
			"completionStepIds": [
				4111416
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
