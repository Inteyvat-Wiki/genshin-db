				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Será que esta receita realmente funcionará...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "#Aventureir{F#a}{M#o}! Você chegou na hora certa. Eu estava tendo um momento complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "A questão é a seguinte. Você se lembra de minha irmãzinha, Anna, certo? Ela sempre esteve muito doentinha, e nada consegue ajudar ela a melhorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Mas eu ouvi que tem um doutor incrível no Porto de Liyue que é conhecido por ser especialmente habilidoso em curar o incurável. Então eu pedi a alguém para conseguir uma receita dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Os ingredientes são bem incomuns... Mas penso que tenho que dar uma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Hm, vamos ver... Você poderia me ajudar a achar uma Baga Dendro Pré-Digerida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "Realmente existe uma coisa assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Eu não sei! Será que Slimes Dendro realmente comem Bagas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Ah, por favor! Eu sei um lugar onde há Slimes Dendro e Bagas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Por favor, vá lá verificar, espero que possamos encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Este médico é um charlatão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Então você também acha, né? Mas não tenho outras opções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Ah, eu sei um lugar onde há Slimes Dendro e Bagas. Por favor, vá lá ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "E eu vou provar o remédio primeiro. De qualquer forma, não posso deixar piorar a saúde da Anna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Eu podia coletar um Slime Dendro para você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Hm... O quê? Você está me dizendo para colocar uma Baga dentro da boca de um Slime Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Não, obrigado! Na última vez que fui buscar ervas para a Anna, um grupo de Slimes Dendro me perseguiu até ao Vale Termal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Ah, eu sei um lugar onde há Slimes Dendro e Bagas. Por favor, vá lá ver, espero que possa encontrar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Mas... S-se você realmente não conseguir encontrar nada, então, pelo bem da Anna... A-Apenas pegue um Dendro Slime e traga-o até aqui. Eu consigo fazer isso... Eu vou fazer isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
