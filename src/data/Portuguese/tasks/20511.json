				},
				{
					"id": 205110402,
					"content": "Achei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "É isso? Realmente não parece nem um pouco diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110404,
					"content": "De qualquer jeito que você olhe, parece só uma baga normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110405,
					"content": "Esqueça. Já que é o que o doutor pediu, vamos seguir a receita ao pé da letra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110406,
					"content": "Obrigado. Isto aqui é pelo seu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110407,
					"content": "Talvez eu precise te incomodar novamente no futuro. Quando isso acontecer, por favor não recuse.",
