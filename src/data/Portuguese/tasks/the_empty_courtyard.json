			"dialogs": [
				{
					"id": 761250201,
					"content": "(Como esperado, Columbina não está aqui...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "Será que Columbina realmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250203,
					"content": "(Ela atravessou o \"Portal da Lua\". Ninguém sabe o que há lá dentro, mas é um lugar que destruiu o extremamente poderoso Vingador da Lua...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(Se ao menos eu tivesse...)",
