				{
					"id": 761250230,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250231,
					"content": "Esse kuuhenki... Paimon acha que é aquele que gosta de tocar lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250232,
					"content": "Esse kuuhenki... Paimon acha que ele parece um pouco nervoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250233,
					"content": "Por que você não toca alguma coisa? Se eles ouvirem uma melodia familiar, talvez se acalmem um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250234,
					"content": "Uma melodia familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "Vamos tentar aquela que Columbina está sempre cantando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "...Eles estão dormindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250237,
					"content": "Parece que eles não tiveram um bom descanso faz um bom tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250238,
					"content": "Shh, vamos sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250240,
					"content": "Sandrone! O que você tá fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250241,
					"content": "O quê, agora não posso dar mais passeios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250242,
					"content": "Ela não retornou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Imaginei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250244,
					"content": "Não existe milagre de graça, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250245,
					"content": "Ei, para onde você está indo? Er, Paimon quer dizer... nós não nos vemos muito, talvez a gente possa te acompanhar um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250246,
					"content": "Não vamos fazer isso. Não estou de bom humor hoje, e não tenho nada de bom para dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761250247,
					"content": "Além disso, conforto é a última coisa que este lugar precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
