						761250210
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250210,
					"content": "Vocês... também estão esperando Columbina voltar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250212,
					"content": "Então, você também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250214,
					"content": "Ei... Vamos lá, não fique tão triste. Levante a sua cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250215,
					"content": "Se todos estivessem tristes, seria como... como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250216,
					"content": "Paimon não quer pensar sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250217,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "(...Não posso me permitir ficar remoendo a culpa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Columbina não se sacrificou para acabarmos assim, sem falar que...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "Eu... ainda não desisti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Columbina, todos os amigos dela... Nenhum deles desistiriam assim tão facilmente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Nos deem um pouco mais de tempo. Não posso prometer nada, mas farei tudo que puder...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
