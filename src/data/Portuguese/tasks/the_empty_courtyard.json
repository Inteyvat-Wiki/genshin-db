					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250225,
					"content": "Eles estão... torcendo por nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250226,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
