				{
					"id": 761250227,
					"content": "Obrigada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250228,
					"content": "Precisam de nossa ajuda com alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "Paimon"
