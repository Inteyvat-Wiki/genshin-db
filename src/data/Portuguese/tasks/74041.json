			},
			"dialogs": [
				{
					"id": 740410101,
					"content": "Ei, Broglie, temos os dados das duas estações de monitoramento que você mencionou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Sério? Que ótimo! Por favor, deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Você entrega as fitas de papel que coletou para Broglie",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "Aaah! Sim, é isso aqui mesmo! Vocês são anjos, anjos enviados dos céus para me salvarem da minha miséria e me levarem de volta a uma vida de tranquilidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "Você tinha que falar mesmo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "#Bem! Não há tempo a perder, gentil senhor{F#ita}! Vou encontrar meu supervisor e solicitar a chave para a estação de processamento central! Por favor, esperem por mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "*Suspiro* Só... se apresse, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Um Broglie animado retorna logo em seguida.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#Senhor{F#ita}, tenho a chave agora! Agora só precisamos ir até a estação central de processamento para organizar os dados e podemos retomar o monitoramento hidrológico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Oh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Considerando a situação das Estações Bala de Goma de Fruta e Crepes Suzette, é possível que aqueles sujeitos de Snezhnaya também estejam na estação central de processamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Então, por favor, venham comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Não se esqueça de nos recompensar depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "E temos que ir com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "E quanto à nossa recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "#Sobre isso... Por favor, não se preocupe. Se meu supervisor aprovar reiniciar nossa pesquisa hidrológica, você definitivamente será pag{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Hehe, que alívio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
