				]
			},
			"dialogs": [
				{
					"id": 740411401,
					"content": "#Aqui estamos, senhor{F#ita}! Essa é a estação central de processamento, onde nossos dados de pesquisa hidrológica são analisados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411402,
						740411403
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411402,
					"content": "Não parece ter ninguém aqui.",
