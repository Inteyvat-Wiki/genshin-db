					}
				]
			},
			"dialogs": [
				{
					"id": 740411301,
					"content": "Pare! Eu me rendo! Pare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411302,
					"content": "Vocês... Vocês tão aqui pelas fitas, né? Podem ficar com elas! Parem de me atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411303,
					"content": "O comandante dos Fatui entrega os dados de pesquisa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Isso é tudo, Broglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Hmm... Bem... Talvez? É. Isso parece ser tudo. Claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Só esqueça que Paimon perguntou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "Qual é o seu objetivo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Sim, conte tudo! Por que vocês estão ocupando essas estações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411310,
					"content": "Para... enrolar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411311,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Sou Malinovskyi, comandante do Trigésimo Quarto Esquadrão de Reconhecimento Independente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411313,
					"content": "No início, quando a gente tinha sido acabado de ser despachados para Fontaine, todos estavam muito felizes e a missão não era tão difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411315,
					"content": "Então o que isso tem a ver com ocupar as estações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "Alguns meses atrás, devido a algumas mudanças organizacionais, o quartel-general nomeou alguém chamado Shumilov como meu novo agente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411317,
					"content": "Shumilov? Certo, o líder do pelotão que vimos na Estação Crepes Suzette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "Sim, esse mesmo! Eu não consigo aturar aquele sujeito, mas não consigo me livrar dele... então eu procuro desculpas para sair em missões e ficar longe dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411319,
					"content": "Espera, Paimon tá confusa. Você disse que ele é o seu agente, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411321,
					"content": "Então, você não é o superior dele? Por que você tem que dar ouvidos a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Bem, ele é meu subordinado, o maldito — mas ele sempre age seriamente e faz os outros trabalharem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411323,
					"content": "As palavras dele são difíceis de refutar, e eu não posso dizer a ele que ninguém aqui quer trabalhar na frente de todo mundo, posso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411324,
					"content": "Coincidentemente vi umas torres estranhas por perto, então falei para ele que ia investigar e forjei as cartas da Maison Gestion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411325,
					"content": "Então você forjou os documentos! Paimon sabia! Não tinha como a Maison Gestion deixar você gerenciar as estações de monitoramento hidrológico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Mais alguma pergunta, Broglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Entendi. Então você só estava tentando enrolar no trabalho... Não, digo, você só está tentando ter um pouco de paz nesse mundo barulhento ocupando nossas estações de monitoramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Bem? Como você avalia nossas acomodações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Hmm, muito confortáveis? A paisagem próxima é linda também. Eu geralmente me sinto melhor depois que tiro um cochilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411331,
					"content": "Não é? Especialmente quando você acorda e percebe que não tem tarefas urgentes, e que você não está sendo observado por alguém que não gosta. Você pode só aproveitar o sol da tarde e a brisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "É como acordar de um sonho e entrar em outro onde você não precisa se preocupar com nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411333,
					"content": "É assim que se deve viver! É uma pena que você não tenha experimentado o chá preto de edição limitada na Passagem Vasari. Se tiver a chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Espere, onde essa conversa tá indo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "Enfim, por favor, venha com a gente! É hora de contar ao Instituto de Pesquisas de Fontaine o que você fez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411337,
					"content": "E-Espera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "Hmm, ele não causou danos à nossa pesquisa, causou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Falando objetivamente, ele até coletou alguns dados para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "Ele é só alguém que quer se livrar do trabalho e viver uma vida confortável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "I-Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411342,
					"content": "Espera, isso não é nada que se orgulhar, mesmo quando fala assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#Gentil senhor{F#ita}, por favor, deixe-o ir em nome da ciência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "Isso é mesmo relacionado a ciência?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Obrigado, senhor, e vocês também! Juro que jamais farei algo assim de novo. Vou fazer meu melhor para enrolar sozinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411347,
					"content": "Eu adoro a sua determinação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "Você pode não ficar animado com algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "O comandante dos Fatui sai sentindo gratidão...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Com isso resolvido, vou voltar a analisar os dados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "Obrigado pelo seu trabalho! Por favor, aceite isto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "Está... mesmo resolvido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
					"content": "Que seja, pelo menos as estações estão operando de novo e os pelotões Fatui se foram. Paimon acha que acabou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411345,
					"content": "Bem, se quem pediu diz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				}
			]
		},
		{
