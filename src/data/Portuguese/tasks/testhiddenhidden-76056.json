					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "Não acredito que perdi para uma pessoa de passagem... três vezes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "Não, não, eu e você perdemos duas vezes cada, o chefe só perdeu uma vez, então não é tão ruim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Heh! Uma derrota é uma derrota, não tem pra que chorar. {NICKNAME} é de outro nível mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "Vocês não conseguem me derrotar nem num dia bom, e agora vocês testemunharam alguém que sabe lutar mesmo. Viram? Tem muito treino pela frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "Quanto a mim? Hmm... Talvez seja hora de considerar uma aposentadoria mais cedo. Queria saber se o campo de treinamento de Vaino ainda tá contratando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605607,
