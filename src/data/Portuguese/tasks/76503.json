			"dialogs": [
				{
					"id": 765030701,
					"content": "#Ora, se não são {NICKNAME} e Paimon? Estão seguindo alguma pista, talvez? Ou será que se perderam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030702,
						765030703
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030702,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030704
					]
				},
				{
					"id": 765030704,
					"content": "Entendi. Que esse colosso silencioso lhe proporcione a inspiração que procuram, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030705
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030705,
					"content": "Dito isto, eu não estou vendo seu Aparelho Fotográfico com você. Será que você o perdeu em algum lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030703,
					"content": "E procurando algum material para fotos enquanto estamos nisso.",
