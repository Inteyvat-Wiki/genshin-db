			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090101,
					"content": "#Olá, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090102
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090102,
					"content": "Olá! Paimon estaria surpresa, se nós já não tivéssemos visto vários de nossos amigos por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090103,
					"content": "Hã!? Espera, você é a Shenhe! Isso é uma surpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090104,
					"content": "Este lugar não é fácil de encontrar. Presentes dos Anjos... O nome não é exatamente tão fácil de dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090105
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090105,
					"content": "O Senhor Zhongli foi gentil o suficiente de me ajudar com direções. Sou muito grata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090106
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090106,
					"content": "Você precisou de ajuda com direções? ...Espera, você veio até aqui só por uma bebida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090107,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090108
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090108,
					"content": "#Porque... somos amig{M#o}{F#a}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090109
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090109,
					"content": "O que você gostaria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090110
					]
				},
				{
					"id": 705090110,
					"content": "Aqui está o cardápio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090111,
					"content": "Vista Boreal... Hmm, boreal? Como o clima gelado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090112
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090112,
					"content": "Bem, Vista Boreal aqui provavelmente se refere ao Lobo do Norte. Então, é, pode-se dizer que é gelado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090113,
					"content": "Pinha de Caramelo... Como que isso é uma bebida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090114
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090114,
					"content": "Oh, Paimon experimentou essa. Na verdade é café com caramelo. \"Pinha\" apenas se refere a cor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090116
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090116,
					"content": "Esses nomes são confusos. Não consigo entender nenhum deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090117
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090117,
					"content": "Deixarei com você. Desde que seja algo que tenha o mesmo gosto que Qingxin e Violeta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090118
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090118,
					"content": "Essas ervas medicinais não crescem por aqui. Se você quiser algo amargo, então terá que ser café...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090119,
					"content": "Que tal, ao invés disso, algo doce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090120
					]
				},
				{
					"id": 705090120,
					"content": "...Está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090121
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090121,
					"content": "É uma boa ideia. Você já praticou bastante as artes adepti. É hora de algo novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090122,
					"content": "Vamos fazer para a Shenhe um Beijo Coberto Pela Neve! Parece algo perfeito para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7050902,
			"completionStepIds": [
				7050903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050903",
							"2"
						],
						"stepId": 7050903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090201,
					"content": "Hmm, é doce e suave. Não tem nada de amargo. O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090202
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090202,
					"content": "É chamado de Beijo Coberto Pela Neve! Bata o leite até ficar espumante, então gentilmente coloque sobre o suco. Parece estar coberto por uma camada de neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090203,
					"content": "Só não me pergunte por que se chama beijo... Paimon também não faz ideia. Provavelmente é só alguma besteira para vender mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090204,
					"content": "Uma besteira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090205
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090205,
					"content": "Hã? Algo errado? Paimon só está chutando... Provavelmente tem algo a ver com uma descrição romântica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090206,
					"content": "Romântica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090207,
					"content": "Uhh... é difícil explicar! Pare de fazer Paimon ficar inventando coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090208,
						705090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090208,
					"content": "A espuma do leite em si não tem muito gosto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				},
				{
					"id": 705090210,
					"content": "Oh, isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090211,
						705090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090211,
					"content": "O momento que você sente o gosto doce do suco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090213,
					"content": "...Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090214
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090214,
					"content": "Entendo. Acho que entendi agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090215,
					"content": "Oh? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090216,
					"content": "Mas, espera aí. Por que Paimon que está confusa agora!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705090217,
					"content": "Ocasionalmente, eu mastigo algumas ervas conforme caminho pelas montanhas. Eu presenciei o momento que um broto perfura o solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090218
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090218,
					"content": "A euforia em meu coração se assemelha bastante ao que estou experimentando agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090219
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090219,
					"content": "#Obrigada por me ajudar a entender esses nomes complicados, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090220
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090220,
					"content": "Talvez eu precise de sua ajuda novamente no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 705090212,
					"content": "É como um broto perfurando a neve para te dar um beijo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090209,
					"content": "É como as neves da montanha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				}
			]
		}
	]
}