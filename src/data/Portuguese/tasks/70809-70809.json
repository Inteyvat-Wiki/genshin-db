				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Oh? Deixe-me ver... Hmm, o conceito não é ruim. Eu daria uma nota de seis de dez à criatividade. Quanto à praticidade... talvez uma nota quatro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "I-Isso é um plano de crime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Haha. Por incrível que pareça, vim da base porque ouvi rumores de que alguém por aqui estava planejando um \"plano mestre\" estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "...Mas depois de ler isso, acho que entendo como esses rumores começaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Vou entregar isso para os Cavaleiros, por segurança. E se estiver livre mais tarde, passe pela minha base. Pode ser que você veja algo que vale a pena assistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
}