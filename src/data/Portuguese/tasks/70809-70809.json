				"objectNames": [
					"Kotaro Uchida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "E-Esse... Esse é o meu plano de crime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Kotaro Uchida"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}! Ele realmente disse isso em voz alta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "Não, não! Por favor, não entendam errado! É apenas uma ideia para o enredo do meu próximo romance. Escrevi ele enquanto estava bebado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Kotaro Uchida"
				},
				{
					"id": 708090404,
					"content": "Quando acordei e a página sumiu, eu pensei que fosse apenas um sonho de bêbado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Kotaro Uchida"
				},
				{
					"id": 708090405,
					"content": "De qualquer maneira, muito obrigado por me ajudar a encontrar ele. Agora meu romance finalmente pode seguir em frente. Vou enviar uma cópia autografada para você quando ele for lançado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kotaro Uchida"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
