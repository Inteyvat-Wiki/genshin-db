				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(Dentro do ninho encontram-se pedaços de papel espalhados, com o que parecem ser traços de escrita à mão ainda neles...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Eles rasgaram todo esse papel para usar como material para o ninho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "Tem algo escrito neles também. Talvez devêssemos juntar as peças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "Acho que vamos ter que juntar isso nós mesmos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "#Vamos lá, você não está nem um pouco curios{M#o}{F#a}? E se for um mapa do tesouro!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Depois de repetidas insistências de Paimon, os pedaços finalmente são reunidos...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Certo, agora é a hora da verdade... Isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "Espere... Não pode ser... Isso é algum tipo de... plano de crime!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "Que tipo de gênio do crime perde seu plano para um pássaro!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "E-Ei, esse tipo de coisa acontece o tempo todo nos romances! O plano perfeitamente infalível, e então ele fracassa por causa de uma coisa que ninguém esperou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "Vamos dar uma olhada na Taverna por perto e ver se alguém ouviu algum rumor sobre alguém \"planejando fazer algo ilegal\" recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "É melhor prevenir do que remediar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "S-Sim! Exatamente... E se alguém realmente estiver planejando algo? Se nós ignorarmos isso e isso acabar sendo importante, não vamos conseguir consertar depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
