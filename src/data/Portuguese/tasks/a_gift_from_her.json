			},
			"dialogs": [
				{
					"id": 761230101,
					"content": "Uu-hu-hu, isso está com um cheiro ma-ra-vi-lho-so! Chegamos bem na hora da refeição da Columbina de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Hã? Aqueles kuuhenki... estão fazendo fila? Para a sopa que a Columbina está servindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Só um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Uau, isso está realmente bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Uma sopa de frutas refrescante e saborosa, Paimon nunca provou nada parecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Outra porção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230108,
					"content": "Duas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Você está aprendendo a cozinhar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Sim. Eu pedi à Ineffa algumas receitas básicas e fiz várias tentativas. Os kuuhenki e os animais reagiram de forma bem positiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230112,
					"content": "Você está tendo algum problema na cozinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Bem... Minhas mangas são muito largas. Elas esbarram na panela se eu não tomar cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230114,
					"content": "(Então, não é o ato de cozinhar em si que está lhe causando problemas.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "Eu tenho certa dificuldade em fazer sobremesas, no entanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230116,
					"content": "Você precisa acertar a temperatura e as proporções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230117,
					"content": "(Ela provavelmente não cozinhava muito para si mesma no passado.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Além disso, doces e lanches são particularmente difíceis de acertar quando se trabalha sozinha...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Gostaria que eu ajudasse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Claro. Vamos começar com Rolinho de Ovo, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230121,
					"content": "Algum tempo depois...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Gostaria de provar um?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230123,
					"content": "(Dar uma mordida.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230126,
					"content": "(Uau, aquela primeira mordida provavelmente deixou minha expressão mais azeda que uma ameixa-seca...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Mas depois que você engole um pouco, a doçura volta... Talvez fique melhor quando você se acostumar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230129,
					"content": "Dá para passar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Paimon perdeu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Experimente isto rapidinho, pode ser?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "#Gaaaah, é muito azedo! O q—que vocês d{M#oi}{F#ua}s estão tentando fazer com a Paimon!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230136,
					"content": "Mas o retrogosto é bem gostoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "#O importante é o gosto inicial! Nenhum{F#a} de vocês podia ter avisado pra Paimon dar uma mordida menor!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Se você não tivesse dito nada, a Paimon teria achado que isso era uma pegadinha! Tipo ver as pessoas fazendo careta ou algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Certo. Deixe-me tentar de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230140,
					"content": "Mais tempo se passa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Aqui. Experimente esta fornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230142,
					"content": "(Uau...! Isto está bem melhor!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Está delicioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Sério? Paimon também quer! ...Mmm! Aí, sim! Muito gostoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Bom o bastante para ser dado de presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230147,
					"content": "Com certeza! Espera, você aprendeu a cozinhar e fazer Rolinho de Ovo porque queria preparar um presente para alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Sim... Para minhas amigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230149,
					"content": "É uma ótima ideia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "#Ainda se lembra da primeira vez que vocês vieram aqui junt{M#o}{F#a}s? Você tinha preparado um pouco de comida para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230151,
					"content": "Embora a comida não pudesse fazer muito para restaurar o poder que eu havia perdido, comê-la me fez sentir mais tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230152,
					"content": "Na época, eu não pensei muito nisso, mas agora eu entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230153,
					"content": "O tempo e o esforço colocados ao preparar comida com cuidado, à mão, são o que lhe dão alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230154,
					"content": "O que me agradou não foi apenas a comida em si, mas a ternura e a gentileza nas mãos que a fizeram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230155,
					"content": "E quanto menos essas mãos buscam reciprocidade, maior é a ternura e a gentileza necessárias para corresponder a isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230156,
					"content": "Awn, a Paimon vai até ficar corada se você continuar falando assim... Para ser honesta, naquela época, a gente estava pelo menos meio que esperando cair nas suas boas graças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Mas agora as coisas são diferentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "De fato. Mas agora que eu entendo tudo isso, gostaria de fazer um pouco mais... É uma sensação maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230160,
					"content": "Você viria comigo visitar nossos amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230161,
					"content": "Além dos Rolinhos de Ovo, também preparei alguns outros presentes. Ah, mas eles precisam ser enviados em segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230162,
					"content": "Por que \"em segredo\", se não se importar com a pergunta da Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "#Bom, vocês sempre foram {M#o}{F#a}s responsáveis por me \"surpreender\". Quero ver como meus amigos vão reagir quando os papéis se inverterem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230164,
					"content": "Ufa. Corremos para todo lado. Mas finalmente terminamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "As reações deles foram meio surpreendentes. Alguns nem perceberam que eram presentes seus, Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "A Aino já foi direto beliscar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Tudo bem. Já esperava por isso. O importante é que ficaram felizes em receber os presentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230168,
					"content": "Nesse caso, a Lauma com certeza sabia que os Rolinhos de Ovo e o Anel de Flores na mesa dela vieram de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "A Paimon até entende ela ficar hesitante em usar o Anel de Flores, mas, sério, ela ficou uns bons dez minutos encarando os Rolinhos de Ovo e ainda assim não conseguiu comer nem um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "#Eu já estava ficando preocupad{M#o}{F#a} que ela fosse até venerá-los...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Parece que a Jahoda levou um belo susto... Talvez não devêssemos ter colocado os presentes diretamente atrás dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230172,
					"content": "Ela quase pulou de susto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Talvez ela seja naturalmente mais atenta? Ainda assim, parece que ela se acalmou quando o Ashru veio arranhar o arranhador que você enviou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Quanto aos nossos outros amigos que não estão em Nod-Krai, estou contando com vocês para entregarem os presentes deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230175,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "Íbis"
				},
				{
					"id": 761230176,
					"content": "Tenho de dizer, você é muito boa em preparar presentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "Aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230178,
					"content": "Ooh! Finalmente chegou a nossa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Hã? Doces? Paimon achou que a gente fosse ganhar Rolinhos de Ovo como todo mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230180,
					"content": "Bem, vocês já comeram alguns enquanto faziam os testes de sabor. Um pouco de variedade faz bem, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230181,
					"content": "É... Eles também são muito bons.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "Fico feliz em ouvir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230184
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230184,
					"content": "E tem mais um presente. Aqui, para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230185
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230185,
					"content": "Isto é... um Planador?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230186
					]
				},
				{
					"id": 761230186,
					"content": "Ouvi dizer que os céus pertencem às aves e a terra, às feras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230187
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230187,
					"content": "Enquanto o vasto espaço entre os dois é reservado aos aventureiros que usam Planadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230188
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230188,
					"content": "Com isto ao seu lado, que o seu caminho à frente esteja sempre iluminado como à luz da lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230189
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230189,
					"content": "#É perfeito! Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230190
					]
				},
				{
					"id": 761230190,
					"content": "E obrigada a você, pela sua companhia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761230182,
					"content": "São até melhores do que os Doces da Noite da Oração Lunar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230158,
					"content": "Se tiver algo que você queira comer, é só dizer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230144,
