			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450101,
					"content": "Imagino que você tenha encontrado mais do que alguns enigmas durante suas viagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450102,
					"content": "Gostaria de observar sua inteligência por meio de um teste prático de suas capacidades - da mesma forma que fizemos com o teste físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450103,
						110450104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450103,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				},
				{
					"id": 110450105,
					"content": "Gostaria que você explorasse essas ruínas e retornasse com sua resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450106,
					"content": "Existem dois quebra-cabeças localizados nas extremidades da ruína. Após a conclusão, você conseguirá ativar o mecanismo no centro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450107,
					"content": "Assim como no teste físico, não há restrições. Tudo o que você fizer é uma ação que desejo observar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450108,
						110450110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450108,
					"content": "#Estou ficando {M#bom}{F#boa} nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450109
					]
				},
				{
					"id": 110450109,
					"content": "#{M#Um}{F#Uma} aventureir{M#o}{F#a} comprovadamente experiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450112,
					"content": "Então, vamos ver você em ação. Comece por onde quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450110,
					"content": "Quando há vontade, há um caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450111
					]
				},
				{
					"id": 110450111,
					"content": "Lembre-se de que este é um teste de intelecto. A sorte não tem nada a ver com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450104,
					"content": "Não bastaria um teste por escrito...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450105
					]
				}
			]
		},
		{
			"id": 1104504,
			"completionStepIds": [
				1104504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104504",
							"2"
						],
						"stepId": 1104504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450461,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450462,
						110450463
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450462,
					"content": "Padrões desconhecidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				},
				{
					"id": 110450401,
					"content": "Até onde sei, eles pertencem a algum tipo de escritura. Podem ser encontrados em todo Teyvat, mas nunca revelaram seus segredos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450402,
					"content": "Ainda há muito o que aprender sobre eles, e por que vieram descansar aqui... Um verdadeiro mistério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450403
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450403,
					"content": "Deixe-me fazer uma cópia primeiro. Vou arranjar tempo para examiná-los em mais detalhes após nossa pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450404
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450404,
					"content": "*Suspiro* Outra coisa para a lista de \"coisas que não entendo\". Um mistério sem solução aqui, um experimento estranho ali... Seria bom obter alguns resultados legais de uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450405,
					"content": "Parece que se você quer a recompensa, tem que pagar o preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450406,
					"content": "Eu realmente ganhei muito com tudo isso. Em comparação, a recompensa que posso oferecer é pequena demais para ser mencionada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450407
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450407,
					"content": "Deixe-me voltar ao acampamento primeiro. Quando você retornar, posso ter um milagre fugaz para você testemunhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450408,
						110450409
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450408,
					"content": "Nos vemos em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450410,
					"content": "Paimon está ansiosa para ver o resultado de toda essa dor de cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450411,
					"content": "A menos que você possa pensar em algo melhor para fazer, vamos voltar para o acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450412,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450413,
					"content": "Não tão rápido. Você não vai embora até me garantir que não representa nenhum perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450414,
					"content": "Uau! Você! Você não saiu da montanha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450415,
					"content": "Certamente não. E tenho visto tudo o que você e Albedo têm feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450416
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450416,
					"content": "#Devo dizer que você baixou a guarda. Ou talvez tenha sido atraíd{F#a}{M#o} por suas hipóteses convincentes e comportamento amigável?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450417,
						110450418
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450417,
					"content": "O que você quer dizer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450419,
					"content": "Recebendo ordens de um completo estranho, bebendo poções desconhecidas, participando de experimentos esquisitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450420
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450420,
					"content": "#Prefiro acreditar que você foi enganad{M#o}{F#a} do que pensar que foi tão ingênu{M#o}{F#a}... Ou talvez vocês estivessem trabalhando juntos desde o começo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450421,
					"content": "Escute, irmã, sua guarda está tão alta que você não consegue ver por cima dela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450422,
						110450423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450422,
					"content": "Eu só estava ajudando ele com sua pesquisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450424,
					"content": "#Não importa o que você pensa, ele poderia ser até mesmo um santo. Mas eu entendo ele melhor que você, forasteir{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450425,
					"content": "Estou preocupada apenas com uma coisa: se a alquimia dele transformou você em algo mais sinistro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450426
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450426,
					"content": "De jeito nenhum! Paimon teria percebido. E de qualquer maneira, ele nem mesmo usou alquimia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450427,
					"content": "Com um alquimista do nível dele, você não sentiria nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450428,
					"content": "De qualquer forma, não vou permitir que uma ameaça em potencial volte para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450429
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450429,
					"content": "Então, o que você vai fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450430,
					"content": "Você veio aqui para ter certeza. Faça o que for preciso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450431
					]
				},
				{
					"id": 110450431,
					"content": "Devo reconhecer, você tem seus momentos. Ter certeza de que nada com que você entrou em contato é perigoso é o suficiente para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450432,
					"content": "Eu investiguei tudo. Os únicos itens restantes na agenda são esses símbolos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450433,
					"content": "Mas nem sabemos o que significam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450451,
					"content": "Isso é verdade, sem mencionar... Hmm, parece que não há mais nada para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450452
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450452,
					"content": "Mas por motivo de segurança, é melhor eu fazer uma cópia... Hmm. Este agora é um local de interesse, patrulhas regulares devem ser estabelecidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450434
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450434,
					"content": "Agora levando em conta todas as coisas, considero que você não representa uma ameaça imediata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450435
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450435,
					"content": "Era isso que eu esperava. Eu teria sido uma irmã muito infeliz se você me fizesse trabalhar a mais por sua causa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450436,
					"content": "...Trabalhar a mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450437,
					"content": "#Antes de seguirmos nossos caminhos, Forasteir{F#a}{M#o}, um conselho. Não confie em Albedo tão rápido assim, nem repita os mesmos erros que cometeu desta vez. Você tomou muitas decisões precipitadas hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450439
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110450439,
					"content": "Ela se foi. Tão teimosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450440,
					"content": "Mondstadt não tem muitas pessoas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450441,
						110450442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450441,
					"content": "Talvez ela apenas seja insegura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450443,
					"content": "Hum, não me importo com ela. Vamos ver o Albedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450442,
					"content": "Talvez ela apenas seja sensível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450443
					]
				},
				{
					"id": 110450423,
					"content": "Não acredito que ele seja uma má pessoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450424
					]
				},
				{
					"id": 110450418,
					"content": "Ele tem outros motivos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450419
					]
				},
				{
					"id": 110450409,
					"content": "(Acho que passei no teste de inteligência.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450410
					]
				},
				{
					"id": 110450463,
					"content": "Acho que já vi isso antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450401
					]
				}
			]
		},
		{
			"id": 1104505,
			"completionStepIds": [
				1104505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104505",
							"2"
						],
						"stepId": 1104505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Você está de volta! Em boa hora, estou quase chegando a uma conclusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "#Você demorou um pouco, ficou pres{F#a}{M#o} no caminho de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Mais ou menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "É hora dos resultados. Recebemos uma infinidade de dados hoje, foi muito difícil terminar toda a pesquisa de uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "#Mas a conclusão preliminar integral que posso oferecer é... Você é muito parecid{F#a}{M#o} com um humano deste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Você não conseguiu perceber só olhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "Nós passamos o dia inteiro trabalhando para isso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Calma, calma, entendo que isso pode ter parecido evidente para você, mas na verdade nada nesse mundo deve ser tido como dado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Vocês já consideraram que o mundo de Teyvat talvez tenha uma hostilidade natural a estrangeiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Só os deuses saberiam a resposta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "Eu mencionei as leis naturais deste mundo. Aqui você pode conversar comigo sem consequências, e nada parece estar errado. Mas, parece um pequeno milagre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "A única outra forma de vida que, como você, veio de longe, é a semente que eu mencionei. Sob os efeitos das leis naturais de Teyvat, ela nem sequer é capaz de brotar, quanto mais florescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "Mas depois de observar você, eu tive outra ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "Imitar você inspirou minha alquimia, e então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Uau! Parece que - algo está surgindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "A transição do nada para algo, da germinação ao florescimento, e por fim o desabrochar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Nutrir a vida sobrenatural também não é nutrir o próprio mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "Foi tão bonito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "*Suspiro* Parece que é o mais longe que podemos ir. Uma floração transitória de beleza incomparável. A conquista mais orgulhosa da vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Paimon pensou, com todos os nossos esforços, que poderia ter florescido para sempre. E nem parece ter dado frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "A vida é uma tapeçaria múltipla de entidades livres, o seu valor não deve derivar de quanto tempo permanece conosco. Mesmo um estouro momentâneo é precioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "Uma vida curta pode ser bem vivida. Uma vida vivida eficientemente, vivida na perfeição, é necessariamente uma vida aliviada pela solidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "Então, você entende o que eu quis dizer sobre o fato de estarmos aqui conversando, é sem dúvidas, um pequeno milagre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Bem, eu ainda não murchei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "Eh? As coisas parecem um pouco pesadas agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Hehehe, não fique triste, {NICKNAME}. Você tem Paimon cuidando de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Albedo, Paimon realmente quer ser sua amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "...Obrigado a ambos. Mesmo que remover a solidão não seja essencial para a vida, isso certamente não dói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#{NICKNAME}, sua ajuda me inspirou a descobrir os meios de fazer uma flor florescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "Então eu sou um espécime útil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "Quero dizer que o tempo que passei viajando com você nas montanhas foi uma jornada valiosa para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450540
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450540,
					"content": "No futuro... Se surgir a necessidade... Posso pedir novamente a sua ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450541,
					"content": "Claro, mesmo se você somente quiser companhia, me procure a qualquer momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450542
					]
				},
				{
					"id": 110450542,
					"content": "Bem... Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450543,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450544
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450544,
					"content": "Fiz questão de lhe dizer o quão ordinários foram os resultados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450545
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450545,
					"content": "Mas o que era aquele sedimento que vi a formar-se no fundo do frasco? Não deveria estar lá... O que poderia significar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450546,
					"content": "Os nascidos da terra estão ligados pelas suas imperfeições, mas os nascidos do giz estão livres de impurezas... Você e eu somos parecidos, ambos compostos por uma substância que ainda não foi totalmente definida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450547,
					"content": "Se um dia, eu perder o controle... e destruir Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450548,
					"content": "Posso contar com você para me parar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450532,
					"content": "#(Me pergunto como {M#minha irmã}{F#meu irmão} está...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450525,
					"content": "Foi tão passageiro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450515,
					"content": "Talvez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450509,
					"content": "É isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450504,
					"content": "Literalmente, nada menos que uma freira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450505
					]
				},
				{
					"id": 110450505,
					"content": "Aha, eu não me preocuparia, ela está apenas fazendo seu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450506
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104506,
			"completionStepIds": [],
