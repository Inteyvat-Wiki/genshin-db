				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110450621,
					"content": "Desculpe, houve muitos problemas com a pesquisa. Muitas das inferências que fiz simplesmente não coincidem com os dados dos experimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450622
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450622,
					"content": "Por outro lado, algumas das conclusões que Albedo tirou de sua própria intuição foram corroboradas pelos fatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450623
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450623,
					"content": "Estou feliz por termos feito algum progresso, então uh... Não há razão para ficarmos desanimados! Albedo disse que fiz um bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450624
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110450624,
					"content": "Se quiser ouvir os resultados em detalhes, é melhor falar com ele. Tenho trabalho a fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
