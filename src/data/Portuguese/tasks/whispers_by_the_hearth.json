			"dialogs": [
				{
					"id": 742500101,
					"content": "Pensando bem, não fui a anfitriã mais atenciosa quando vocês visitaram Snezhnaya antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500102,
					"content": "Não precisa disso, Srta. Sandrone. Mesmo que nunca tenhamos sentado para conversar, você sempre nos ofereceu os melhores lanches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*Suspiro* Minhas desculpas. Eu estava ocupada demais naquela época. Vou cuidar melhor de vocês na próxima vez que vierem me visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500104,
					"content": "Você também nunca deixou eu testar suas invenções antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Os motivos para isso eram outros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500106,
					"content": "Hmph...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "Na verdade, o \"Pai\" nos disse para não incomodá-la sempre que possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500108,
					"content": "Não se preocupe com isso, não me importo com uma perturbação ocasional. Podem vir tomar chá sempre que quiserem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500109,
					"content": "Sério? Na verdade... Eu sempre quis pedir para você dar uma olhada em Pers... Tenho algumas ideias de melhorias que gostaria de discutir com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500110,
					"content": "Claro, essa é a minha área de especialidade, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500111,
					"content": "...Obrigado, Srta. Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500112,
					"content": "Ser um Mensageiro é muito difícil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Quando você coloca dessa forma... acho que é um pouco sim. Há muito a se considerar. Embora a maior parte das minhas frustrações venha dos meus colegas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500114,
					"content": "Então isso quer dizer... que saber se dar bem com os outros é uma habilidade indispensável?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500115,
					"content": "Suponho que sim... Mas duvido que Lyney tenha muito com que se preocupar nesse aspecto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500116,
					"content": "Haha, você me lisonjeia, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Você quer ser um Mensageiro? Na verdade, deixa pra lá, não é da minha conta perguntar isso. Finge que eu não disse nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500118,
					"content": "Hmm... Isso tudo é um pouco distante para mim. Com certeza não há pressa para pensar nisso ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Se você se tornar um Mensageiro, isso não significaria que não teria tempo para nos acompanhar nas missões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "Se for assim... Isso significa que... Lynette e eu também teremos que nos tornar Mensageiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500121,
					"content": "Eu já disse, esse tipo de coisa está tão distante que nem vale a pena pensar nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "Além disso, não importa para onde eu vá, nunca vou deixar vocês dois para trás. Prometo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Hah... Às vezes eu realmente invejo essa pequena família que vocês têm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
