				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "Ah, esse lugar é bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030102,
					"content": "Você está trabalhando em seus enigmas novamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "Viajante! Você veio na hora certa! Estou prestes a criar uma nova série de enigmas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030104,
					"content": "O terreno aqui é um pouco complicado. Veja, há um enorme sistema de raízes da Árvore Divina que entra na água do lado do porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030105,
					"content": "Do outro lado está uma folha de lótus gigante e um monte de navios esperando para deixar o porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030106,
					"content": "Viajante, qual lado você acha que é o melhor como tema para este enigma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030107,
					"content": "É melhor começar com o sistema de raízes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "Sério? O enorme sistema de raízes da Árvore Divina é bastante notável e é facilmente visto como o \"ponto de partida\" do enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030109,
					"content": "Certo! Então vou escrever um enigma com o sistema de raízes como tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030115,
					"content": "Hehe, vou escrever algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "Hehe, deixe isso comigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "Hã, por que você está sorrindo com essa cara tão alegre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030118,
					"content": "Eu terminei de escrever, dê uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "\"Onde o conhecimento retorna ao mar, o tesouro está nas velas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030120,
					"content": "Está muito bom de ler! Além disso, o enigma lembra o \"porto\" bem fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030121,
					"content": "E onde diz \"quando o conhecimento voltar ao mar\", é fácil ver que o local está relacionado à Academia ou à Cidade de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030122,
					"content": "Eu não imaginei que você tinha esse talento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030123,
					"content": "Espere um minuto, vou colar este enigma num lugar que seja fácil de encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030124,
					"content": "Hã? Colar por aqui? Mas a localização do enigma também não está longe. Pode ser resolvido num instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030125,
					"content": "Hahaha, estou dando uma área para o solucionador resolver o enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030126,
					"content": "Se eu não fizer isso, a área para o enigma será muito grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030127,
					"content": "Drusus começa a colocar o enigma...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "Pronto, o enigma para este local está feito, vamos para o próximo local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030129,
					"content": "Hã? Tem mais um lugar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030110,
					"content": "A folha de lótus e o navio são interessantes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "Na verdade... pode ser interessante de um jeito diferente se os dois se unirem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030112,
					"content": "Não tem problema, vou escrever um enigma com esse tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030113,
					"content": "Esses são fáceis demais!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "Fáceis demais? Você tem alguma ideia então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				}
			]
		},
