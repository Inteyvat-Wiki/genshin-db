			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Este é o último baú. Não há necessidade de enigmas para este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Mas o que eu devo colocar dentro dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Algo valioso o suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Isso faz sentido. O conteúdo deste baú deve ser pelo menos digno do pensamento astuto do solucionador de enigmas ao longo de sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Se falamos de algo de valor, o mais lógico seria Mora. Humm...vou colocar um pouco de Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "Bem, este conjunto de enigmas está terminado. Obrigado pela ajuda, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Isso aqui é para você, como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "*Suspira* eu queria falar com você sobre enigmas com mais profundidade, mas eu tenho que voltar para a Academia para resolver alguns negócios antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "Se você descobrir algum enigma estranho em suas viagens, ou não conseguir resolver algum, lembre-se de vir até mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "Podemos discuti-los em detalhes juntos... e depois podemos elaborar novos enigmas para outros aventureiros, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "Adeus, Viajante. Desejo-lhe uma viagem segura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "Vamos torcer para que esse Ladrão de Tesouros chamado Narzam não cause muitos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Algo de valor prático.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Valor prático? Hm... O que pode ter valor prático?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Já sei! Recebi uma receita de alguém há alguns dias. Vamos colocar isso no baú como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "Esta experiência de reflexão é o maior tesouro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "#Hahahahaha, você tem razão! Absolutamente cert{F#a}{M#o}! Este árduo processo de reflexão é realmente uma experiência inestimável! Em comparação, outras coisas que são quase sem valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "Isso não está certo! Coloque um pouco de Mora ou uma receita! Adicione algumas frutas ou vegetais se não houver outra maneira, não dá para deixar vazio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Brincadeirinha, brincadeira, com certeza vou colocar algo como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
