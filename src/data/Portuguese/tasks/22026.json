			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Ah, isso é suficiente, obrigada! Se não fosse pela sua ajuda, eu teria que ter lutado contra aqueles monstros sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Se tivesse sido assim, não sei quando que eu teria me lembrado de que tinha que coletar \"Pétalas da Flor de Sakura\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "Ah, obrigada pela sua ajuda! Fique com esses \"Espetos de Frango com Cogumelos\". Essa é uma receita clássica de uma comida para aventureiros que a senhorita Lynn me ensinou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Depois eu vou levar as \"Pétalas da Flor de Sakura\" de volta para Xudong. Não sei o que ele sabe cozinhar de bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
	]
