				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Kazuha! Te encontramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671202,
					"content": "Na hora certa. Eu estava refletindo sobre minha vida atual, e acho que já estou em dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671203,
					"content": "O que você acha do bonsai do Clã Kaedehara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671204,
					"content": "Parece antigo e com uma grande história.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Coisas velhas são muitas vezes acompanhadas de arrependimentos. O mesmo vale para o Clã Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "Isso não é um problema. Despedidas também são uma forma de reencontro, se não em casa, pelo menos numa terra distante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "Essa miragem é fascinante. Ela representa a vida como se fosse uma peça de teatro, e cada cena é mais impressionante que a anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "Dizem que astrólogos já viram de tudo. Se essa miragem lhe intrigou, esse encontro valeu a pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "Ahem... Como estão tuas emoções?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "A Princesa gostaria de saber seu estado atual, Senhor Kazuha, e espera que seu coração não esteja cheio de lamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "Não há como ficar feliz depois de se reviver tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Haha, você tem razão. Obrigado pela preocupação de vocês, mas tudo isso é parte do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "Na primeira vez que vi o bonsai, pensei na possibilidade que... Eu precisava esperar por vocês. Talvez esse tenha sido o porquê eu tinha que estar aqui sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "As coisas não foram perfeitas, mas você não tem do que sentir vergonha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006713,
			"completionStepIds": [
				4006713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006713",
							"2"
