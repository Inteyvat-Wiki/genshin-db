			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocomunicador"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "... Parece que coisas similares acontecem toda vez que estou com você. Tentarei fazer uma adivinhação, ler os astros, determinar o alvo, e então resolver o problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "#Você está rodead{F#a}{M#o} de vários tipos de amigos, segredos e destinos. É incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "Não, você é incrível! Você ajudou nós e Fischl a resolvermos aquele problema de Leonard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "Isso é algo bom para um astrólogo, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "#Creio que sim. Vamos torcer que possamos ficar junt{F#as}{M#os} para resolver isso, assim como da outra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "Quando você diz isso, quer dizer vocês duas, ou nós três?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Pff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "Está bem, está, nós três! Paimon, às vezes você dá opiniões que me são bem úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "Sério? Paimon está começando a gostar de você, astróloga genial Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "Sim, eu me refiro a opiniões como essa! Vocês nunca conhecerão outra astróloga esperta e charmosa como eu, hohoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Sim, você é excelente, exceto... Hã... Nunca mais ria como Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "Ahem! Me desculpem... Passar muito tempo com um amigo faz você adquirir os costumes dele, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#Eu continuarei observando as estrelas pelos próximos dias. {NICKNAME}, mantenham-se em contato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006702,
			"completionStepIds": [
				4006714
