				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Fischl",
					"Mona",
					"Oz",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "*Bocejo*... Hoje tivemos uma viagem muito longa, Paimon está ficando com sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671302,
					"content": "Todos devem estar exaustos, vamos descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671304,
					"content": "Hã? O que há de errado, você não parece muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671305,
					"content": "Não é nada. Sinto-me cansada pois a jornada de hoje foi exaustiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671307,
					"content": "Minha Princesa, como você está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671308,
					"content": "Oz, cesse tua curiosidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671309,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671310,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671311,
					"content": "Vou ver se há algo para comer. Descansem se estiverem cansados, mas caso queiram me dar uma mão, fiquem à vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671312,
					"content": "Eu ajudarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671313,
					"content": "Eu também posso ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671314,
					"content": "Todos estão se voluntariando! Vamos também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671315,
					"content": "Pode contar conosco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "Ei, eu aprecio o entusiasmo, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671317,
					"content": "Parece que Sua Alteza está cabisbaixa. Mona, vocês parecem próximas, por que você não faz um pouco de companhia para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671318,
					"content": "Então você também percebeu. Eu iria mencionar quando você estava preparando a comida. Nesse caso, sim, pode deixar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671319,
					"content": "Certo! Vamos preparar a comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671320,
					"content": "Mona piscou para você, e então correu para ficar com Fischl. Os demais procuram pelos ingredientes para cozinhar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "Isso deve ser suficiente. Podemos grelhar esses daqui. Na próxima vez que passarmos por um acampamento abandonado, vamos ver se eles têm uma panela. Assim poderemos preparar mais coisas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671322,
					"content": "Oh, ótima ideia! Xinyan, você pode não ser uma chef, mas você sabe como cuidar de seus clientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671323,
					"content": "Hehe, obrigada, Paimon. Não é nada demais, só estou fazendo o que posso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671324,
					"content": "Os tripulantes do Alcor consideram Xinyan alguém que podem confiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671325,
					"content": "Também pensamos o mesmo de você, Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671326,
					"content": "Hahaha, isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671327,
					"content": "Hmm... Bem, como um companheiro confiável, eu tenho algo que gostaria de falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671328,
					"content": "Pelo que vocês disseram, essa miragem milagrosa parece ser baseada na minha vida. Pelo menos até o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671329,
					"content": "... Mas ela para mim parecia um sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671330,
					"content": "Talvez seja isso. Talvez ela representou seus sonhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "Kazuha, noutras palavras... Você sempre quis fazer seu próprio bonsai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671332,
					"content": "Será? Será que foi tudo uma forma de fazer realizar o meu desejo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671333,
					"content": "E já que isso aconteceu comigo, isso significa que poderia acontecer com todos aqui também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671334,
					"content": "Sim, eu também acho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "Concordo, mas de quem será a próxima miragem que encontrarmos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671336,
					"content": "Hah, na verdade, estou animada para a minha miragem, pelo menos se for como um sonho se realizando como você disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671337,
					"content": "Espere, você quer que algo assim aconteça com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671338,
					"content": "Qualquer miragem relacionada comigo teria música envolvida. Hahaha, seria uma boa chance para tocar umas músicas novas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671339,
					"content": "Você quer tocar nela?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671340,
					"content": "Por que não? Eu não acho que nenhum músico que se respeite poderia ficar sem tocar nessas ilhas. Olhem só para esse lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671341,
					"content": "Quanta confiança e otimismo! Xinyan é incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671342,
					"content": "#Oh, {NICKNAME}! Paimon quer provar algumas frutas do topo daquela rocha ali! Vamos pegar algumas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671343,
					"content": "(Hã? Será que...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "Aproveitem, eu vou acompanhar Paimon.",
