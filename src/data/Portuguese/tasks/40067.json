				"points": []
			},
			"dialogs": [
				{
					"id": 400670401,
					"content": "Você deve ser Kaedehara, não é? Venha, embarque, eu lhe tirarei daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "Escutar"
				},
				{
					"id": 400670402,
					"content": "Mas... Por que você está me ajudando? Eu sou um fugitivo procurado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "É claro que a Comissão Yashi... Ahem! Um patrocinador anônimo quer lhe tirar daqui em segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Escutar"
				},
				{
					"id": 400670404,
					"content": "Mas isso é tudo que ele pode fazer. Depois disso, você só poderá contar com você mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escutar"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
