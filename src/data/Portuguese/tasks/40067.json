					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "Será que ele está distraído? Ou esqueceu de levar a bomba para a sua performance? Ou talvez tenha ficado bêbado e dormiu sob aquela árvore enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671409,
					"content": "Hmm... Vamos tentar entrar em contato com ele amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671410,
					"content": "Viajante, Paimon, aqui vocês estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671411,
					"content": "Mona! Você terminou de conversar com Fischl?",
