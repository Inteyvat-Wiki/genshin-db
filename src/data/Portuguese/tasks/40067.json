					"nextDialogs": [
						400671412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671412,
					"content": "Hahaha, mais ou menos... Ela estava um pouco para baixo. Acho que tem algo a ver com a miragem que vimos hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671413,
					"content": "Fischl estava muito animada para essa viagem... Mas creio que ela não quer ver sua miragem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671414,
					"content": "Por quê? Paimon achava que ela seria quem mais gostaria de algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671415,
					"content": "... Ainda não tenho certeza sobre o porquê, mas ficarei de olho nela.",
