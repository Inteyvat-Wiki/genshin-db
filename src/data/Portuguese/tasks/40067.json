			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Escutar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "Ei, amigo! Você está bem? Precisa de uma carona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Escutar"
				},
				{
					"id": 400671002,
					"content": "Oh, piratas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Escutar"
				},
				{
					"id": 400671003,
					"content": "Hah, pode nos chamar assim! E então? Você vem ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escutar"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
