			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodocomunicador"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "... Quando viemos para esse lugar perfeito, nunca imaginei que estaríamos lidando com algo tão místico e inexplicável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "Como você está se sentindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Nada mal. Mas gostaria um pouco de sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "O que você precisa que façamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Ooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "Hmm... Nada, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "O quê?! Você está nos subestimando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "Não, eu acabei de perceber que apesar de você não falar muito, você fala por todos, silenciosamente, nos bastidores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "#Você é o tipo de companheir{F#a}{M#o} que todos precisam. Você estar aqui nos deixa mais aliviados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "Eu sei que colocar expectativas tão altas em você pode lhe impor uma certa pressão... Mas eu acho que as observações de uma astróloga podem render interpretações além daquelas do céu noturno, e reparar nas forças das pessoas faz parte disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "Então você só queria nos lisonjear?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "Só estou expondo fatos, não lisonjeando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "Hmm, então você não quer admitir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "... Que você está elogiando alguém!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "Parem de rir! Eu já disse, foi uma avaliação objetiva, não um elogio! NÃO É UM ELOGIO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#Eu continuarei observando as estrelas pelos próximos dias. {NICKNAME}, mantenham-se em contato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006703,
			"completionStepIds": [
				4006703
			],
