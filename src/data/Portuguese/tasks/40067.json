					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "O que aconteceu aqui? Tudo está destruído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670302,
					"content": "... Oh, quão mais poderoso é o clã, mais devastadora é sua queda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400670303,
					"content": "Está totalmente destruído, e não há ninguém por perto... Tudo deve ter acabado dessa maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670304,
					"content": "Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
