			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "Deveria haver uma planta morta no vaso. Mas não havia nada nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "... Enquanto estávamos separados, eu tive muito tempo para refletir. Acho que agora finalmente compreendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "Essa miragem... Ela sou eu. O vaso vazio representa o meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "Quando o coração está em paz, o mundo também estará. E quando o coração está vazio, o mundo também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "Estar em paz e vazio... É como eu sou agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Isso não quer dizer que não eu não tenha arrependimentos. Pois estar vazio significa estar doente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "É por isso que esse bonsai apareceu em minha miragem. Ele me deu uma chance de realizar meus desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "Eu nunca imaginei que no fundo de meu coração também queria fazer um bonsai... Talvez isso seja o que manter as tradições do Clã Kaedehara vivas signifique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006706,
			"completionStepIds": [
				4006712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
