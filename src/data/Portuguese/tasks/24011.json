			},
			"dialogs": [
				{
					"id": 240111101,
					"content": "Você já tentou criar um cachorro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "Você quer dizer... que eu deveria arranjar um cachorro para expulsar elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111103,
					"content": "Esse não é um plano ruim. Eu posso conseguir que alguém me empreste um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401112,
			"completionStepIds": [
