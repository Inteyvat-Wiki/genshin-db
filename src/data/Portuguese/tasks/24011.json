			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Ah, gaivotas, gaivotas. Quando vocês terminarem com as batatinhas, por favor, vão embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Como está a situação agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Não, nada disso. Quando as gaivotas vieram pegar meu almoço, ele colocou o rabo entre as pernas e se escondeu atrás de mim, tremendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "*Suspiro* Não que eu culpe o cachorro. A raça dele só teve um trabalho a vida toda — amar outros e ser amado por eles. Nunca aprendeu a atacar nada na vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Nós também temos esse dever, sabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Talvez, mas para nós, amor também pode ser considerado um \"direito\", e no que diz respeito a essas coisas, tudo geralmente se desenrola em uma direção difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Desculpe, eu falei demais. Eu tive que resolver muitos conflitos emocionais hoje, e receio que ainda não me recompus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "*Suspiro* Mas agora mesmo, minha tarefa mais urgente é descobrir como comer essa caixa de batatas fritas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "O cachorro funcionou para você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
