					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "Claro, mas você poderia focar em... apenas afugentá-las? Elas só querem minhas batatinhas, mas não há malícia nelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Bem, é ruim para mim, mas não é uma questão muito séria, então... Por favor, só expulse elas, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
