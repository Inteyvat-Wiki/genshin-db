			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Oh, boas gaivotas. Sei que estão com fome, mas eu também não comi o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Esqueça. Acho que está tudo bem se você está feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "Viajante? Ora, que surpresa agradável. Se você está aqui para me fazer um pedido, receio que terá que esperar. Ainda não acabei com minhas batatas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Oh, não estou aqui a negócios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Oh, é mesmo? Que bom. Preciso me apressar e acabá-las o quanto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Bem, esta é a minha refeição principal. Eu vou sair com Roialte a negócios mais tarde, então preciso me apressar com essa comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "Não estou acostumado a comer dentro do Palais Mermonia, então geralmente eu saio e encontro um lugar calmo para comer logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Mas hoje... Eu não sei o que está fazendo essas gaivotas enlouquecerem, mas estão vindo todas de uma vez pegar minhas batatinhas, e não importa quanto comam, não é suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Bem, tem muitas delas, e poucas batatinhas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Isso é verdade. Mas eu não posso alimentar todas as gaivotas do oceano, posso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Bem, estas são suas batatinhas, não são? Não deixe as gaivotas pegarem elas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Você vai ficar com fome nesse ritmo, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Você parece meio para baixo, na verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Sério? Eu não... Bem, na verdade, acho que estou. Nada te escapa, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Eu só... não sei o significado do meu trabalho. Eu me ocupo todo dia no Maison Gestion, mas não vejo nenhum rendimento tangível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Eu não pude ajudar ninguém, nem a vida de qualquer um se tornou mais conveniente graças ao meu trabalho. Roialte diz que nosso trabalho é importante, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Eu só sento em frente a uma máquina de escrever e bato nas teclas, infinitamente, mas qual é o propósito disso? Eu poderia até só perder outra tecla. Pelo menos isso vai render um pouco de Mora para Estelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Desculpe. Eu sei que não deveria estar dizendo tudo isso, mas eu só me sinto bastante perdido agora, não importa o que eu faça. Talvez... talvez eu precise de mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Termine de comer primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Tem razão. Mas a quantidade de tempo que temos agora é insuficiente para ir comer outra caixa de batatas fritas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Esqueça, eu só vou dar o resto delas aos pássaros. Só vou pegar algo para comer quando Roialte e eu terminarmos nossos negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "Vai levar... o que, meio dia? Nem tanto assim, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Você vai conseguir aguentar ficar sem comer tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Deixe as gaivotas comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Hmm... Isso não seria problema demais? Tudo aquilo por uma porção de batatas fritas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Só coma sua comida. Você não deveria ficar com fome, não importa quão ocupado esteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "Eu cuido daquelas gaivotas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Vamos resolver seu problema com gaivotas primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Você parece um pouco abalado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Nem todas conseguiram o que comer ainda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "E por que você está comendo batatas fritas aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
