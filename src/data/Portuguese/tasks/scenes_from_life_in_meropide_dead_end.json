					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Bem na hora. Me deem uma mão aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "Você consegue ler mentes? Isso é assustador!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Galvaryet nos mandou te ajudar... Mas como você sabia disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "...Porque só vocês estão aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "...Bem, faz sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "Enfim, a tarefa não é nada difícil. O Terminal de Monitoramento aqui precisa que duas pessoas o controlem simultaneamente e eu já inseri os comandos. Só vá até ali e puxe a alavanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "Eu quase esqueci... O dispositivo de carregamento deve estar por perto. Por favor, instale o dispositivo de carregamento antes de começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "#E... Só pra confirmar, vocês não são assassin{M#os}{F#as} de máquinas, são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "#Depende da sua definição de assassin{M#os}{F#as} de máquinas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Por que a pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "Eu pedi ajuda à Galvana da última vez e o terminal foi destruído quando desviei o olhar por um momento. Perguntei a ela o que aconteceu, mas ela não conseguia me dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Descobri com a irmã dela depois que nenhuma máquina sobrevive a ela por mais de meio dia. Até Alain Guillotin desistiria dela, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Até a taxa de reparo foi deduzida da minha compensação. Se vocês forem como ela, todo meu trabalho duro terá sido em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "Que história. Definitivamente não somos como ela. Não se preocupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Conto com vocês, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Se o Terminal de Monitoramento me atacar, acho que sou sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Mas não vai sair de graça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Vou pedir a Galvaryet para solicitar seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Hã? Ela disse que a gente podia receber a recompensa diretamente de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Ela disse? Tudo bem, então Solicitar fundos daqui é ainda é mais difícil do que do Instituto de Pesquisas de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
