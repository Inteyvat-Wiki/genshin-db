			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "Olá, o que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300102,
					"content": "Por favor, nos ajude, boa feiticeira!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "Por que você tá falando como Lanoire? Vá direto ao assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300104,
					"content": "Precisamos de muitos Cupons Especiais. Tem algum trabalho que podemos pegar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300107,
					"content": "Vocês não se juntaram ao jogo de Estienne, se juntaram? Deviam saber quando parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300108,
					"content": "...Todavia, tem algo que preciso de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300109,
					"content": "Clynes deve estar consertando o dispositivo dele ou sei lá o que é aquilo perto da Fenda da Erosão. Vão ajudar ele, pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300110,
					"content": "Podem pedir a recompensa para ele. Ele não vai recusar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300111,
					"content": "Pode deixar com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300105,
					"content": "Podemos ajudar com alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "Seria melhor se tivesse alguma recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
