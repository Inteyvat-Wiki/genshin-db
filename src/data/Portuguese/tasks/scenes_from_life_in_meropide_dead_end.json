						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "#Parece bom. Se a gente não tivesse em um lugar como esse, contrataria vocês como {M#meus}{F#minhas} assistentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Isso é fácil demais. Por sinal, o que esse dispositivo faz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "Tinha uma fenda que conectava ao mundo exterior e precisava ser vigiada. Agora podemos apenas selar a passagem com esse dispositivo e economizar a mão de obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Isso não é nada novo para o Instituto de Pesquisas de Fontaine, de qualquer jeito. Mas como eu tenho bastante tempo, modifiquei ele um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "O que vocês veem agora não é a forma final, o qual foi implantado, na verdade, no Poço da Mina de Geodes... Ahem, acho que falei demais. Só finjam que não ouviram nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "Então tem saídas no Poço da Mina de Geodes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "#Certo, você é {M#dos}{F#das} inteligentes. Mas se fosse ainda mais inteligente, teria ficado de bico fechado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "Enfim, problema resolvido. Galvana não precisa mais vir aqui sempre e eu posso dar uma pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "...Ah, sim. Quase esqueci a recompensa de vocês. Obrigado pela ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "A versão final é mais poderosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Claro! Há outros componentes... Espera aí, por que querem saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "#Se quiserem saber tudo, podem experimentar. Mas se forem peg{M#os}{F#as}, não me dedurem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}