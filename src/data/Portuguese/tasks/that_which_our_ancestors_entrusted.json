			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "#Uma brisa do sul soprou pela Ilha Watatsumi hoje. É um sinal de que amig{F#as}{M#os} viriam fazer uma visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610102,
					"content": "#Toda vez que você diz algo assim, você quer dizer que Paimon e {NICKNAME} vão ficar ocupad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610103,
					"content": "Oh, não diga isso. Não tivemos uma boa parceria? E uma que rendeu bastante, na realidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610104,
					"content": "Dito isso, eu tenho algo que gostaria de pedir a vocês hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610105,
					"content": "Dizem em minha família que além da Cerimônia de Oferendas de Watatsumi, nós também adicionamos um conjunto diferente de julgamentos. Um deles não tem relação com a sobrevivência da Ilha Watatsumi, mas sim com a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610106,
					"content": "Outro conjunto de julgamentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610107,
					"content": "Agora que a ilha não está mais sob ameaça existencial, como sucessora de minha família, é meu dever contar isso para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610108,
					"content": "Você pode ir para o lugar conhecido como Coração da Serpente. As pistas para esse segundo conjunto de julgamentos estão escondidas lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610109,
					"content": "... Bem, isso é um alívio! Acho que posso passar essa responsabilidade esmagadora para minha futura filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 400610110,
					"content": "... É assim que você presta respeito a sua missão ancestral?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400610111,
					"content": "... Paimon até hoje não entende você, Tsuyuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
