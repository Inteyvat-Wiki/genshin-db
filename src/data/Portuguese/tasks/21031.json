					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210310101,
					"content": "Argh, devo pensar em uma maneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310103
					]
				},
				{
					"id": 210310103,
					"content": "Ah, é você. *Suspiro* Eu nem quero falar sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310104,
					"content": "Ultimamente, os negócios no albergue têm melhorado cada vez mais e cada vez temos mais visitantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310105,
					"content": "Algumas pessoas vêm passar um tempo tranquilo sozinhas, enquanto outras trazem suas famílias em viagens de lazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310106,
					"content": "Infelizmente, embora o negócio do albergue esteja indo bem, o fato é que há muitos monstros vagando pelas áreas próximas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310107,
					"content": "Se alguma criança ou idoso encontrar uma daquelas criaturas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310108,
					"content": "Para evitar que tais incidentes ocorram, eu sempre tenho que sair e perseguir monstros ao redor do albergue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310109,
					"content": "Mas eu sou apenas um, e eles são muitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310110,
					"content": "#Viajante, você poderia me ajudar? Você será bem pag{M#o}{F#a}, garanto-lhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310111,
						210310112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310111,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310115
					]
				},
				{
					"id": 210310115,
					"content": "Conto com você. Antes percebi que havia vários acampamentos de monstros com criaturas perigosas dentro deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310116,
					"content": "Além disso, outro grupo de monstros se aproximou do albergue secretamente e montou um acampamento perto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310117,
					"content": "Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310118
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310118,
					"content": "Que tal assim? Os monstros mais perigosos você pode deixar comigo. Você só precisa repelir os monstros ao redor do albergue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310119
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310119,
					"content": "Quando tudo estiver em ordem, nos encontraremos novamente aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310120
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310120,
					"content": "*Suspiro* Esses monstros são realmente um incômodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310112,
					"content": "Suas habilidades são ótimas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310113
					]
				},
				{
					"id": 210310113,
					"content": "Minhas habilidades? Bem... Obrigado pelo elogio, mas minhas habilidades são apenas aceitáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310114,
					"content": "E, mesmo assim, não posso lutar contra eles sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310115
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
