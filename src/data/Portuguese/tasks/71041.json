				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "Ufa! Obrigado por salvarem minha vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410102,
					"content": "Espere um pouco... Eu me lembro de você! Você é Toclipho, aquele cara da mina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410103,
					"content": "Hã? O quê? Não! Não sou eu! Eu não vendo remédios falsos! Eu sou Clitopho sim, mas não o que se envolve na venda de farmacêuticos, senhorita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410104,
					"content": "Hmm, então os remédios que você vende são falsos?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "Não, nem pensar! Os remédios que eu vendo são 100% verdadeiros! Você viu os mineradores, eles tomaram o remédio e se sentiram ótimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410106,
					"content": "Mas você não disse que era o Clitopho que não vendia remédios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410107,
					"content": "Ah, sim... Isso foi após minha vida como comerciante de medicamentos acabar. E tudo acabou quando... Quando aquele Toclipho vendeu remédios sob uma identidade falsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410108,
					"content": "Ele usou um nome falso para comercializar os remédios e arruinar minha reputação! É por isso que desisti de vender remédios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410109,
					"content": "Fui capturado por um bando de Ladrões de Tesouro, pouco tempo depois de ter trocado de carreira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410110,
					"content": "Mas sim, aquele charlatão é desprezível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410111,
					"content": "Sim, ele é péssimo! Ele só queria enganar os que estavam no mesmo negócio que ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410112,
					"content": "Qual era o nome falso de \"Toclipho\" mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "Clitopho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410114,
					"content": "Hã, não. Clitopho não é um nome falso, é um de verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410115,
					"content": "Isso não quer dizer que o nome de \"Toclipho\" é falso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410116,
					"content": "Não... Espere, sim. Sim, ele usou meu nome indevidamente, por isso \"Clitopho\" também é um nome falso agora. Entenderam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410117,
					"content": "Oh... Então foi assim que \"Toclipho\" se tornou um nome verdadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410118,
					"content": "Que vergonha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410120,
					"content": "Você confessou sem sequer termos que nos esforçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410121,
					"content": "Vamos levá-lo de volta. Os Millelith provavelmente têm muitas perguntas para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410122,
					"content": "Ou podemos cuidar dele aqui mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410124,
					"content": "Ei! Não é hora de fazer piadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410125,
					"content": "Hehehehe, Paimon achou engraçado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410126,
					"content": "M-Mas você nem sequer riu! E não, não é engraçado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410127,
					"content": "Na verdade não é engraçado, porque o assunto está prestes a ficar sério.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "E-Espere! Não é hora de fazer interrogatórios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410129,
					"content": "Não sei quanto a você, mas não quero sair por aí levando um Ladrão de Tesouro apavorado de medo... Mas, não importa, vamos levá-lo de volta ao acampamento primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410131,
					"content": "Ei, ei, ei! Me leve junto! Serei muito útil para vocês! Digo, como podem ver... fui expulso dos Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410132,
					"content": "Agora sou um cidadão respeitável novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410133,
					"content": "Oh, então isso é ser um \"cidadão respeitável\" para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410134,
					"content": "E quais são suas habilidades mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410135,
					"content": "Consigo... fazer... explosivos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410136,
					"content": "Não eram remédios falsos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410137,
					"content": "Não, não, ele disse que sabe fazer explosivos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "E os seus explosivos não são falsos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410139,
					"content": "Não, eles são de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410140,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410141,
					"content": "...Não tenho a liberdade de te incluir na equipe. Quanto a forma que lidaremos com você, Jinwu deve ser a melhor para julgar isso. Mas imagino que ela te entregará aos Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410142,
					"content": "Porém, ficaremos de olho em você. Todos os Ladrões de Tesouro não são confiáveis, muito menos aqueles que vendem remédios falsos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410143,
					"content": "Qual é! Eu não faço mais isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410144,
					"content": "Tá, tá, tá, já sabemos! Vamos andando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410130,
					"content": "Faz sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
