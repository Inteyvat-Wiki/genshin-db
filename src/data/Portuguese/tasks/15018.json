			"dialogs": [
				{
					"id": 150180301,
					"content": "Olá, uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "#Oh, vocês estão perdid{M#o}{F#a}s? Precisam de ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "#Não perdid{M#o}{F#a}s... exatamente. Estamos indo para o Coletivo da Fartura. Essa é a direção certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Sim! Na verdade, essa é a minha casa. Posso lhe guiar pelo resto do caminho, se você quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "#Eba! Conseguimos outra guia local! {NICKNAME}, nós somos muito sortud{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "E eu aqui pensando que esse era seu trabalho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Uma guia, hein... Sim, claro! Por que não? Hehe, de agora em diante, serei sua guia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "Na verdade, tem um monte de paisagens legais por aqui. Eu posso mostrar elas para vocês ao longo do caminho. Elas sempre deixam as pessoas maravilhadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Oh, isso seria tão legal! Mas, uh... Nós não estamos atrapalhando você, estamos? Você realmente não é obrigada a fazer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Oh, não, nada disso! Eu só estava treinando um pouco, mas já acabei por hoje. Então, estou indo nessa direção também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "Além disso, eu posso ensinar tudo sobre a tribo para vocês. Aprender coisas novas é sempre muito divertido, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "Desde que vocês estejam felizes, eu estou feliz. É assim que o Tio Acatl nos ensina a tratar nossos convidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "T-Tá bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Ela parece super amigável e acolhedora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Sim, tivemos sorte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Com certeza! A Paimon gostou bastante dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "Está tudo bem por aí? Então, vamos sair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Oh, espere! Ainda não sabemos o seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Ah, certo! Meu nome é Varesa. Prazer em conhecer vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
