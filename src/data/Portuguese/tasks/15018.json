			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "Oh, conhecemos esse nome! Então, é você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Bem, {M#esse}{F#essa} é {NICKNAME}, e Paimon é sua companheira de viagem incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#{NICKNAME} e Paimon... Isso soa muito bem! Não esquecerei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Beleza! Vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
