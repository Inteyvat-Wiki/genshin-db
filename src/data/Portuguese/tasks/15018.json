			"dialogs": [
				{
					"id": 150180501,
					"content": "#Bem, {M#esse é o}{F#essa é a} {NICKNAME}, e Paimon é sua companheira de viagem incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180502,
					"content": "#{NICKNAME} e Paimon... Isso soa muito bem! Não esquecerei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180503
					],
