						],
						"pointId": 10947
					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "#Ah, lar doce lar! Conseguimos! Bem-vind{M#o}{F#a}s ao Coletivo da Fartura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Uau, esse lugar é tão legal! Aquela plataforma com a forma de uma cabeça de touro é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Hehe, essa é a Arena dos Ecos! É onde organizamos todas as nossas competições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "#Obrigad{M#o}{F#a} por nos trazer até aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Que nada! Não foi problema algum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "Queria poder lhe mostrar os lugares, mas preciso voltar para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Oh, você se lembrou de algo importante? Você ficou a todo vapor quando nós nos batemos com aqueles Hilichurls lá atrás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Espero que não tenhamos te atrapalhado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Oh não, nada disso! Chegamos a tempo! É só que tem algo importante que preciso fazer... A coisa mais importante depois de um treinamento — a refeição pós-treino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Caso contrário, eu serei uma bagunça letárgica, tonta e faminta. Os perigos de um estômago vazio... É terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Enfim, me desculpe, mas eu tenho que comer alguma coisa... tipo para ontem! Vocês deveriam ir comer algo também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Podemos nos encontrar de volta na arena! Vejo vocês depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "E, ela se foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Uau, que mudança abrupta... Em um momento ela está calma e relaxada, e no outro ela está se jogando de cabeça no perigo... literalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "É o espírito da juventude.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "#O espírito da juventude? Tá bom, se é o que você diz, velhinh{M#o}{F#a}... A Paimon ainda acha que a gente é jovem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Enfim, por que não damos uma olhada por aí enquanto isso? Nós podemos ir até a Arena daqui a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "A vista deve ser maravilhosa lá de cima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
