			"dialogs": [
				{
					"id": 150180401,
					"content": "Olá, uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180403,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Espera, vocês são... {NICKNAME} e Paimon! Estive esperando por vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "#Uau! Você nos conhece? Nós realmente somos bem famos{M#o}{F#a}s, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Espere, mas... dissemos para alguém que estávamos vindo para o Coletivo da Fartura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Oh, você não sabia? A treinadora Iansan disse que ela te convidou para nossa tribo, então eu vim até aqui para te esperar enquanto eu treinava um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "E agora, você está aqui de verdade... Hehe, eu não consigo acreditar nisso! Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "#C—Com certeza não somos TÃO famos{M#o}{F#a}s assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "#Vocês são as {M#heróis}{F#heroínas} que derrotaram o Abismo! Vocês são muito importantes para todos em Natlan! Eu já ouvi a história de \"Tu{RUBY#[S]Esperança}maini\" tantas vezes, que eu consigo praticamente contar ela de cabeça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "Eu estive ansiosa para te conhecer desde que a Treinadora Iansan falou que você estava vindo. Oh, a propósito, meu nome é Varesa. Não sei se a Treinadora já falou de mim para vocês antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Oh, sim, o nome me parece familiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Durante a invasão do Abismo, perguntamos a Iansan se o Coletivo da Fartura precisava de ajuda, mas ela disse que a Varesa tinha tudo sob controle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "O que significa que você deve ser uma guerreira bem impressionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Eu não diria isso. Foi tudo o Tio Acatl! Tudo que fiz foi acabar com alguns monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Só de pensar naquela invasão me deixa arrepiada até hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Mas isso é tudo coisa do passado. O Coletivo da Fartura se saiu muito bem, considerando tudo que aconteceu. Nós terminamos nossos reparos, então agora é só uma questão de ajudar as outras tribos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Hehe, vamos lá! Eu vou levar vocês ao nosso acampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Ótimo! Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "E uma heroína por direito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
