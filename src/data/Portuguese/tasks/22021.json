						220210704
					]
				},
				{
					"id": 220210704,
					"content": "Então vou deixar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "Como você chegou a saber fazer isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Quando trabalhava em Shogunato, costumava fazer esses petiscos para acompanhar um bom vinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Mas agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Bom, chegamos de falar do passado, Viajante, você poderia me ajudar a arranjar mais Ovos de Pássaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Eu vou ficar cá para preparar os ingredientes, quando os Ovos de Pássaro estiverem prontos, me entregue, obrigado!",
