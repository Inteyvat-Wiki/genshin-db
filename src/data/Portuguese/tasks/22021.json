			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Com base em seu sabor e sua aparência, esse Espeto de Três Sabores pode ser considerado como o Espeto de Dedicação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "O que é o Espeto de Dedicação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "É um Espeto de Três Sabores perfeito... Agora, o Xudong deve ter terminado o seu Ensopado de Gemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Claro, olha, este é o Ensopado de Gemas que acabei de fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Apesar de eu não ter calculado bem o tempo para preparar os ingredientes e também do fato da sopa ter passado um pouco do ponto, o sabor não deve estar tão ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Deixe-me provar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Sim, está com um cheiro de queimado. Não chega a estragar a comida, mas não está tão boa assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Hahah. Sim, eu estava com um pouco de pressa. Da próxima vez, para prevenir, prepararei os ingredientes com mais antecedência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "Sim, é verdade. Desta vez, eu perdi, mas da próxima vez, não cometerei o mesmo erro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Foi por causa da sua negligência.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Pois foi! Foi por causa da minha negligência que perdi para você. Tomarei mais cuidado da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "Viajante, tome isto. Muito obrigado por ter me acompanhado até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "Em nossa próxima competição, você terá que vir também, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "O Espeto da Dedicação do Tio Munehisa foi o melhor do dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Espeto da Dedicação? O que isso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Isso significa que esse Espeto de Três Sabores é de qualidade perfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "A assim chamada dedicação é uma busca pela perfeição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Essa busca pela perfeição também se aplica na culinária. Apenas com um uma ambição de buscar a perfeição, a sua técnica de culinária pode atingir o nível cada vez mais alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Sim... sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "Sim... sim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "Além de ser uma técnica de culinária, isso é a arte de Samurai, bem com a minha filosofia da vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Xudong, me siga, deixe-me te contar a arte de perfeição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "Ah? Espere um pouco. Viajante, tome isto, é a recompensa para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Errr. Não é meu forte para lidar com pessoas sérias como ele... Só Julie que consegue fazer isso, mas infelizmente, ela não está agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Vá lá experimentar o que é a Culinária de Perfeição.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Estou indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
