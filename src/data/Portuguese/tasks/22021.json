			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "Pronto? Muito obrigado, Viajante! Está cheirando muito bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "Vou experimentar primeiro... Uau, isso é ótimo. Os ingredientes foram preparados na hora e o cheiro é perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Isto pode ser um Ensopado de Gemas perfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "#Está bem, senhor Munehisa, como está indo a sua comida? Deixe {M#o}{F#a} Viajante experimentá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Hum! Minha culpa! Quando comecei a fazer a comida, percebi que não tinha suficientes Ovos de Pássaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Apesar de ter coletado alguns Ovos de Pássaro na floresta, perdi a melhor hora para preparar outros ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Já que os ingredientes não eram tão frescos, o Espeto de Três Sabores não pode ser um prato perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Peço desculpas pela minha negligência. Eu terei que melhorar a minha técnica de culinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Certo, perdi essa competição. Mas da próxima vez, eu vencerei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "Força, senhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Hehe, mas não é tão fácil para eu perder como você imagina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "Viajante, tome isto. Muito obrigado por ter me acompanhado até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "Em nossa próxima competição, você terá que vir também, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Na verdade, não acho o sabor muito ruim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "Não. Mesmo que se trate de culinária, temos que buscar a perfeição, não podemos simplesmente ficar satisfeito com o que já alcançamos por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "Apenas dessa forma, a sua técnica de culinária pode atingir o nível cada vez mais alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "Sim... sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "Sim... sim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Além de ser uma técnica de culinária, isso é a arte de Samurai, bem com a minha filosofia da vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Certo! Força, senhor Munehisa. Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Errr. Não é meu forte para lidar com pessoas sérias como ele... Só Julie que consegue fazer isso, mas infelizmente, ela não está agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "Foi realmente impressionante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "Bom trabalho, Viajante. Tome isto como a recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Senhor Xudong, posso fazer mais perguntas sobre a técnica de culinária, se você está disposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "Estou disposto! Já vou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
