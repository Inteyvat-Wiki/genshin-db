			"dialogs": [
				{
					"id": 220210701,
					"content": "Muito obrigado. Apesar de ser fácil para fazer o Espeto de Três Sabores, temos que prestar mais atenção no frescor dos ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "Já preparei os ingredientes, só faltaram alguns Ovos de Pássaro. Para prevenir, você poderia ir buscar Ovos de Pássaro frescos por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "Deixe comigo.",
