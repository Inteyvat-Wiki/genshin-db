			"dialogs": [
				{
					"id": 40190201,
					"content": "Agora, adivinhe! Qual será o naipe da próxima carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190202,
					"content": "Uhhh... um gato banguela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190203,
					"content": "Ah, são vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190205,
					"content": "Olá, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190206,
					"content": "Parece que você está se recuperando bem, Freminet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190207,
					"content": "Uhum, graças ao apoio de todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190208,
					"content": "Oh, certo! Eu... eu criar coragem para agradecer à Srta. Clorinde pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190209,
					"content": "Uau, como ela reagiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190210,
					"content": "Ela me disse que não foi nada... como se salvar a minha vida não fosse grande coisa para ela. Ela também me disse para não me preocupar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190211,
					"content": "Ela só não queria te estressar. Ela tem razão, é melhor não ficar pensando muito nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190212,
					"content": "Hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190213,
					"content": "Pessoal, escutem só! Voltamos para a casa de ópera e nos encontramos com a Serva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190214,
					"content": "Vocês conheceram \"Pai\"? Ela te disse algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190215,
					"content": "Ela disse algumas coisas que foram... uh, meio difíceis de entender, e também disse que está ansiosa para trabalhar conosco no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190216,
					"content": "Foi meio surpreendente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "O comportamento dela com vocês é ainda melhor do que imaginávamos... isso é fantástico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190218,
					"content": "#Pode confiar nela, {NICKNAME}. Ela possui o seu próprio senso de responsabilidade, e quando o momento aperta, ela faz todo o possível pra ajudar quem ela considera próximo, e acho que isso já inclui você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190219,
					"content": "Hmm. \"Pai\" é bem capaz, e também confiável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190220,
					"content": "Oh, Paimon acabou de lembrar que ela acha que o Lyney é orgulhoso demais! Ela disse que você deveria aprender a depender mais dos outros às vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190221,
					"content": "Uh... entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190222,
					"content": "Isso realmente parece com algo que \"Pai\" diria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190223,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190224,
					"content": "Vocês vão ficar aqui pelos próximos dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190225,
					"content": "Parece que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190226,
					"content": "Excelente. Irei fazer uma festinha do chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190227,
					"content": "Sério? Então Paimon vai querer outra fatia de bolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190228,
					"content": "Acho que \"outra\" quer dizer que você já comeu bolo enquanto estava lá em cima. Hmm, que adorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190229,
					"content": "Por favor, da próxima vez, venham tomar chá e comer lanches conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
