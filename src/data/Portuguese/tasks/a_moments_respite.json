			"dialogs": [
				{
					"id": 40190101,
					"content": "Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}, Paimon, vocês voltaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "Vocês estão bem? Vocês se machucaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Não se preocupe, estamos bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "#Estamos ótim{M#o}{F#a}s! Mas e vocês? Parece que teve uma tremenda bagunça aqui! Foi muito ruim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Algumas pessoas ficaram machucadas, mas foi só isso. Monsieur Neuvillette fez uma visita. Graças a ele conseguimos suprimir a crise por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Claro que também precisamos agradecer pela ajuda de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Como Neuvillette sabia que ele seria necessário por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Monsieur Neuvillette possui uma ressonância muito forte com o elemento Hydro. Quando o nível da água sobe, ele consegue sentir as ondas sendo produzidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "Eu me deparei com os Irmãos Bomba enquanto estava cuidando dos ferimentos dos feridos. Eles estavam murmurando o tempo inteiro sobre como vocês desceram correndo sem pensar duas vezes... estou muito aliviada em ver vocês bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Se você não estiverem com pressa, que tal ficarem aqui conosco por mais alguns dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Me avisem se quiserem comer alguma comida em especial, então pedirei ao Sr. Wolsey para preparar. Oh, e por favor, sintam-se à vontade para visitar a enfermaria e descansar a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "Eu gostaria de ter a oportunidade de observar os seus músculos faciais também. Seus sorrisos felizes são bem contagiantes, sabia? Eles são tão memoráveis, e senti muita falta deles enquanto vocês estiveram fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
