			"dialogs": [
				{
					"id": 40190601,
					"content": "#E voltamos para a nossa cela! Mas não somos mais prisioneir{M#o}{F#a}s, então a sensação não é a mesma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
