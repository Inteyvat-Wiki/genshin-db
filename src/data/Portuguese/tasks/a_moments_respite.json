					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "#Estamos bem, obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "E vocês? Ainda estão pegando a passagem secreta da enfermaria para trabalhar no navio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Sim. Mas isso ainda é ultra secreto. Então não digam nada a ninguém!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "Pode ser meio irritante quando tem várias pessoas na enfermaria, mas eu ainda prefiro pegar essa rota ao invés daquela do escritório do Duque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "Sei, você só quer aproveitar a oportunidade de usar a Enfermaria para escapar do trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "Ah, é? Então por que você também vai tanto pra lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Vocês só usam esse barco como desculpa pra namorar, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "Nada disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
