			"dialogs": [
				{
					"id": 40190401,
					"content": "Hã? Vocês... vocês voltaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "Cuistot! Laverune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "#Vocês... não foram capturad{F#a}{M#o}s e jogad{F#a}{M#o}s aqui de volta, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190404,
					"content": "Hã? Nada disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "#Urg! E cá estava eu pensando que vocês conseguiram fugir da prisão durante a comoção. Eu estava até considerando vocês como fugitiv{F#a}{M#o}s lendári{F#a}{M#o}s, mas agora vocês estão me dizendo que... nunca nem saíram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "Hahaha... Uh, desculpe, mas nós apenas... tivemos alguns assuntos para resolver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "Tá bom, tá bom, não precisa se ater a detalhes. Só estamos aliviados de ver vocês bem. Cuistot estava super preocupado com vocês, sabiam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190408,
					"content": "Ei, não foi só eu! Você também não estava super preocupado!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Algo assim, é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "#Eu também fui transferido para trabalhar na cozinha alguns dias atrás. Eu ainda consigo ouvir Cuistot cochichando para as cenouras: \"Vocês acham que {M#eles}{F#elas} estão bem? Acha que saíram viv{M#o}{F#a}s?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "Sempre que ele dizia aquilo, eu falava para ele: \"Tenho certeza que estão bem! Seja lá onde estiverem, estão relaxando com bebidas nas mãos, aproveitando uma paisagem maravilhosa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "#Ei! Não há nada de errado em se preocupar com {M#seus amigos}{F#suas amigas} de prisão, não é? Digo, considerando como {M#eles}{F#elas} sempre adoraram ouvir as minhas fofocas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Esses dois... eles são bem mais gentis e amigáveis do que Paimon achava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "Com certeza a qualidade das refeições grátis aumentou muito ultimamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "#...Haha, {F#sua bobinha}{M#seu bobinho}. Vou assistir você comendo para garantir que coma até o último pedacinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Suas refeições trarão todos os prisioneiros para o refeitório.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
