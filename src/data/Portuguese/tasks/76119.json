						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "Foi fácil demais para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190203,
					"content": "Se vier jogar de novo, vou tentar embaralhar os chapéus mais rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190204,
					"content": "Paimon está curiosa... Como exatamente você brincou com eles antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Você não enxerga nada se não usar kuuvahki, mas se usar, vai enxergar demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Bem, eu posso abrir os olhos, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190207,
					"content": "Ah, é mesmo. Paimon nem pensou nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
