			"dialogs": [
				{
					"id": 761190101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190102,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190104,
					"content": "Parece que estão se divertindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Saudações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Saudações para você também, Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190108,
					"content": "Jogando um jogo novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Sim. Vi pessoas brincando com seus amigos usando copos no Navio-Chefe, então peguei emprestada a ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190110,
					"content": "Elas colocavam uma pedra preciosa sob um copo, depois embaralhavam rapidamente os copos sobre a mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190111,
					"content": "Quando paravam, pediam para o outro jogador adivinhar em qual copo a pedra estava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190112,
					"content": "Os kuuvahki adoram a sensação de girar enquanto estão embrulhados em tecido, então usei o chapéu da Srta. Bruxa como referência e fiz alguns aprimoramentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190113,
					"content": "É adorável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Espera. Então você foi ao Navio-Chefe... alguém reconheceu você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Alguns perguntaram, e eu respondi: \"Hoje estou fantasiada de Deusa da Lua. Estou igualzinha a ela, não estou?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190117,
					"content": "Nossa, você realmente levou aquele truque da Noite da Oração Lunar a outro nível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "E eles acreditaram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Bem... Não totalmente, mas também não falaram comigo depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190120,
					"content": "Minha atuação não foi natural? Vou continuar praticando em outro lugar da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190121,
					"content": "Por que parece que alguém aprendeu todas as lições erradas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "Luonnotar gostaria que você adivinhasse onde ela está escondida. Gostaria de jogar uma rodada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190124,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "Nesse caso, aposte 100.000 Mora para começar. Essas são as regras do Navio-Chefe, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761190126,
					"content": "Certo, essa lição você definitivamente deveria ter deixado passar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
