			"dialogs": [
				{
					"id": 752420401,
					"content": "#Olá, e sejam bem-vind{M#o}{F#a}s ao Resort da Brisa Tranquila! Vou acompanhar vocês até seus aposentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420402
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420402,
					"content": "Por favor, peguem esse mapa, junto com esse álbum comemorativo de fotos que preparamos para nossos convidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420403
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420403,
					"content": "O resort possui quatro áreas principais: os Penhascos Coloridos, Cume de Guiztli, Baía das Ondas e Ilha Tete. Podem explorar à vontade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420404
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420404,
					"content": "Bem, suas acomodações são naquela direção. Fiquem à vontade para irem até lá se precisarem descansar. E se desejam fazer algumas compras, o Mercado da Brisa Tranquila, nossa atração mais movimentada, é logo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ukucha"
				}
			]
