			"dialogs": [
				{
					"id": 230210801,
					"content": "Isso! Funcionou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "Não há problema estrutural com o casco... A linha d'água também está estável, e ele não está tombando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Qishan, veja, meu projeto e cálculos são perfeitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Não se deixe levar. Estamos apenas na primeira fase do experimento de carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "E você nem mesmo levou em consideração a mudança no centro de gravidade do navio devido ao clima e ao deslocamento da carga durante a navegação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Ugh... Eu vou considerar estes fatores. Só me deixe aproveitar este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "Oh, Viajante, este é o seu pagamento. Por favor, pegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan, você não pode ficar contente por mim para variar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Ficar feliz por você não vai te ajudar a construir o navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "Melhor você tentar animar essa sua carteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
