			"dialogs": [
				{
					"id": 747100101,
					"content": "Hmm... Peixinhos bem comportados nadando para lá e para cá em tanques espaçosos e cuidadosamente organizados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100102,
					"content": "É realmente uma vista linda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100103,
					"content": "Por isso nosso aquário é tão popular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100104,
					"content": "Se eles fossem comportados assim em águas abertas, as pessoas poderiam mergulhar e se imergir ainda mais profundamente na beleza do mundo natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100105,
					"content": "Enfim, graças à ajuda de vocês, descobri o motivo de os peixes estarem tão agitados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100106,
					"content": "Ao longo dos anos, houve muitos naufrágios, e até alguns canalhas que despejaram lixo ilegalmente no mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100107,
					"content": "Uma enorme quantidade de lixo humano acabou no fundo do mar, se acumulando e destruindo habitats naturais. Isso fez com que os peixes se tornassem cada vez mais agressivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100108,
					"content": "Aparentemente, um grupo de mergulhadores já aceitou uma comissão para limpar o lixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100109,
					"content": "Mas parece que vou ter que dar uma pressionada neles e pedir para acelerarem o passo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100110,
					"content": "Parece que vai demorar um pouco até vermos resultados...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "Sim. Enquanto isso, vamos continuar nosso trabalho e trazer o máximo de peixinhos agressivos possível para relaxar e se recuperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100113,
					"content": "Isolar os pacientes de seu ambiente nocivo é um passo importante no caminho para a recuperação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100114,
					"content": "Entendido! Pode deixar com a gente! Vamos ficar de olho em novos pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100111,
					"content": "Imagino que esse tipo de trabalho não vai ser concluído rapidamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
