					"content": "Mesmo que eu queira tornar Guhua poderoso de novo, não é uma tarefa fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
