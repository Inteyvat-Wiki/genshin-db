			"dialogs": [
				{
					"id": 120000601,
					"content": "Então você gosta de ler, não é? Senhor Herói por Cinco Segundos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000602,
					"content": "Incrível! Nunca imaginei que ia acontecer algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000603,
					"content": "Ei! Xingqiu! Tem alguém aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000604,
					"content": "Faz todo o sentido este livro ser tão procurado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000608,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000605,
					"content": "Aquele cara atrás do Chang, o Nono é bem mandão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "Como podem intimidar Chang, o Nono assim, forçando-o a vender o seu minério por preço muito baixo? Eles são bandidos mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000609,
					"content": "Temos que encontrar uma maneira de ajudar Chang, o Nono!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "Não me esqueça, eu também quero ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000613,
					"content": "Oh, então agora você consegue ouvir o que estamos falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "A razão pela qual eu peguei este livro emprestado é que seria uma grande pena se Chang, o Nono acabasse tendo que penhorá-lo..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000615,
					"content": "Cada palavra que eu disse ao Chang, o Nono conta! Eu vou retribuir sua ajuda. Preciso fazer o que é certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000616,
					"content": "Guardarei este livro, e ajudarei a comprar o resto da coleção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000617,
					"content": "Você já tem um plano, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Claro que sim. Um plano inicial, pelo menos. Eu ainda preciso descobrir os detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000620,
					"content": "Deixe-me pensar! Não vai levar muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000621,
					"content": "Você ainda está aqui?! O que é isso, um jogo para você? Você acha que ninguém vai se machucar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "Preciso reconhecer o Clã dos Idiotas... O que falta em números e talento, vocês compensam em coragem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000623,
					"content": "Oh, desculpe - eu disse Clã dos Idiotas? Eu quis dizer Clã de Guhua... É assim que vocês idiotas o chamam, certo? Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000624,
					"content": "Existe um ditado que diz: \"O inseto que sacode o carvalho ridiculamente superestima sua capacidade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000625,
					"content": "Já chega de me dizer ditados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Por favor, deixe este lugar. Não vou tolerar a tentativa de coagir um profissional honesto, especialmente quando aquele que você quer ameaçar é a quem devo uma dívida de gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000627,
					"content": "Engraçado saber que você põe a mão no fogo pelo Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "Mas você escolheu a hora errada, seu moleque! Trouxe os Fatui para me apoiar. Um exército inteiro de seus amiguinhos Guhua não seria capaz de ajudá-lo agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "Posso ser jovem, meu soberano, mas o caminho que escolhi não me afastou de conflitos. Por que eu deveria me acovardar diante do mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000630,
					"content": "Grande discurso! Mas agora está na hora de lhe dar uma lição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "Na verdade, você não tem nenhum plano, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "Vamos abandonar a Operação Guia de Viagem de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "Por que você desistiu tão fácil de procurar os livros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000606,
					"content": "Aquele ajudante que faz os trabalhos sujos do Burguês Maocai, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
