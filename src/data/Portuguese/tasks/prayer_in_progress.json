				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Droga... Quem está espalhando esse rumor o tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "Qual rumor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Sobre os rolinhos da sorte no templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "Você sabe o que são rolinhos da sorte, né? Eles são uma forma de prever o futuro com rolinhos de papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "As pessoas podem saber algo sobre o futuro lendo o que tem escrito nos rolinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "É bom quando as pessoas tiram rolinhos com boas previsões. Mas quando as pessoas tiram um rolinho com algo de ruim escrito, elas normalmente deixam ele no templo, para afastarem o azar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "Porém... Há um rumor que dita que se você colocar um rolinho azarado em cima de uma árvore, seu azar será desfeito pela Arconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "E dizem também que, quanto mais alto você colocar o rolinho, mais rápido você terá sorte e afastará o azar. Que baboseira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Como os rumores se tornaram cada vez mais irracionais, as pessoas começaram a colocar Moras em cima das árvores também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Dizem que se você atirar uma Mora e ela ficar presa na árvore, isso significa que sua reza foi aceita. Não só seu desejo se tornará realidade, como também irá ter uma grande sorte nesse ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "Realmente existe algo assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "Como é possível? Nem vou falar sobre se nossas rezas pessoais podem ser ouvidas... Jogar Mora é absurdo. Além disso, todas elas são iguais, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "Eles esperam que a Arconte pegue as Moras uma por uma e saiba quem jogou elas ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "Apesar de eu entender que isso é o desejo de muitas pessoas... Jogar as Moras nas árvores não irá realizar esses desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "Além disso, quando o vento sopra, tudo que jogam cai para todos os lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "Eu tentei limpar antes, mas não tenho boa forma física. Não só não consegui limpar, como fiquei presa lá em cima por muito tempo, sem conseguir descer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "Mas não posso deixar as coisas lá... Viajante, poderia me ajudar a limpar o telhado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "Queria pedir esse favor para você, Viajante. Vá até os telhados e faça uma limpeza lá. Se encontrar algum rolinho da sorte, traga ele para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "Como você vai lidar com esses rolinhos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Bem... A Sra. Hotomi diz que não importa o que aconteça, essas são as sortes que as pessoas procuravam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "Seria inapropriado simplesmente jogá-los fora. Por isso, os colocarei onde pertencem, uma vez recolhidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "*Suspiro* Se todos tivessem seguido as regras desde o início, não teríamos tantos problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "Queria pedir esse favor para você, Viajante. Vá até os telhados e faça uma limpeza lá. Se encontrar algum rolinho da sorte, traga ele para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "Por que você não diz isso para elas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Há muitas pessoas fazendo isso, eu não consigo convencer ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
		{
			"id": 2201102,
