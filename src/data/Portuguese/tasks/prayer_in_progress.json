					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "Tudo está arrumado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110202,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Muito obrigada. Me dê esses Rolinhos da Sorte, pendurarei eles no local correto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110204,
					"content": "Fique com isso, e muito obrigada pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110205,
					"content": "Eu entendo que as pessoas estão desesperadas para se livrar do azar e ter boa sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110206,
					"content": "Mas acho que se eles realmente querem resolver seus problemas, suas próprias ações serão mais eficazes do que qualquer outra maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110207,
					"content": "Como elas esperam que os deuses ofereçam ajuda se elas próprias não tomam nenhuma medida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				}
			]
		},
