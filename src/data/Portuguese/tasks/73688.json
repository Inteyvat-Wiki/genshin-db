			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Suas habilidades são esplêndidas. Eu fui completamente superado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Foi uma honra lutar contra você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Senhoras e senhores, após uma batalha eletrizante, {M#o campeão}{F#a campeã} para a Exibição de Esgrima do Espírito do Guerreiro foi decidid{M#o}{F#a}! Uma salva de palmas para... {M#o}{F#a} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "#Amanhã, nós realizaremos o duelo de exibição final... {F#a}{M#o} {NICKNAME} e a Senhorita Kamisato contra o enviado escolhido da Toda-Poderosa Shogun, um humanoide autônomo chamado \"Maguu Kengou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Nós vemos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "Essa foi uma partida muito emocionante, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "#Parabéns, Viajante. Você certamente mereceu seu título de campeã{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Paimon não tinha ideia que o oponente de amanhã seria o Maguu Kengou... Aquele nome parece similar ao problemático que encontramos na Ilha Yashiori. Oh, Paimon não acha que vai ser uma luta fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Não se preocupe, Paimon. O enviado escolhido da Shogun pode ser forte, mas a partida de amanhã não proíbe o uso de Visões. Nós faremos um time formidável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Contanto que possamos seguir seus movimentos, uma oportunidade de contra-ataque se apresentará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Oh, ouvir sua confiança faz Paimon se sentir bem melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Eu não posso garantir que venceremos, mas devemos tentar nosso melhor, para pelo menos dar à plateia um show que não esquecerão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Nós podemos vencer, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Eu posso dizer que vocês estão indo com tudo, mas é melhor economizar energia e descansar um pouco essa noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Nós também poderemos ver as novas vestes de Ayaka quando acordarmos amanhã. Ayaka em um vestido de Fontaine... Oh, Paimon mal pode esperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Ah, sim. Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Eu também mal posso esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "Hã, Viajante... Você também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Hehe, parece que não há outro jeito, Senhorita Ayaka. Se eu não estivesse ocupada amanhã, eu também adoraria te ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Ah, eu acho que está decidido então. Eu esperarei por você na Mansão Kamisato de manhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Você quer que eu te busque de manhã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Definitivamente será um duelo emocionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Ah, você está aqui finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Ugh, é Hirotatsu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#{M#O}{F#A} Viajante já acabou contigo e venceu o campeonato alguns dias atrás. O que mais você tem a dizer, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "Não se preocupe, eu não estou aqui para causar problemas. Eu só queria pedir desculpas. Viajante, eu perdi de uma forma justa e limpa alguns dias atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "Sua esgrima é excelente. Cada golpe era preciso, mas não agressivo, o que diz muito sobre seu caráter. Eu peço seu perdão pelo preconceito e por ofender você com minhas palavras e ações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Está tudo bem, não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Vocês devem estar aqui para pegar a Senhorita Kamisato. Ela está no provador agora, mas deve sair em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "Viajante, antes da jovem senhorita sair, eu tenho um pedido um tanto presunçoso que eu espero que você possa considerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "Claro, o que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Apesar de a jovem senhorita nunca ter mencionado o duelo de exibição de hoje para nós, retentores, ela reservou algumas horas cada noite para praticar sua esgrima, apesar de estar tão ocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "A jovem senhorita sempre foi diligente e conscienciosa. Apesar de ser apenas um duelo de exibição e não importar se ela perder, eu acredito que ela fará o melhor para vencer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Como um retentor, eu realmente acredito nela, claro, mas... eu ainda espero que você possa apoiar a jovem senhorita na arena para garantir a segurança dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Não se preocupe, eu o farei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "Viajante, eu deixo a jovem senhorita em suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Oh, deve ser Ayaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Uau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "#Oh? O que houve? Por que vocês estão tão silencios{M#os}{F#as}...? Há algo errado com o vestido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Nem um pouco! Ayaka, você está incrível... Você está radiando beleza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Combinou muito com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "É, é, você parece uma jovem dama determinada que acabou de sair de um barco de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Vocês acham? Eu estava preocupada de que pudesse ser um pouco exagerado demais... Eu não tenho certeza se consigo me sair bem em usar estes trajes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Mas eu estou aliviada em ouvir seus pensamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Paimon mal pode esperar para ver a cara de todos quando virem Ayaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "#Obrigada pelos elogios, Paimon. Viajante, agora que estamos pront{F#as}{M#os}, vamos seguir para a arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "Minha Senhorita, Viajante, eu desejo o melhor a vocês durante o duelo de exibição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "São trajes lindos, combinam bastante com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Olha só isso! Tem até o brasão do Clã Kamisato bordado nele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Sim, Onodera conseguiu alguém da família para fazer isso nos últimos dias. Eu soube que foi baseado nas sugestões que os espectadores escreveram nas cédulas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "O vestido é muito bem feito e oferecem mais liberdade de movimento do que antecipei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "Eu apreciei nossa luta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
