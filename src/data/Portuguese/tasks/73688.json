			"dialogs": [
				{
					"id": 736880301,
					"content": "#Ei, olhe, a Senhorita Kamisato e {M#o}{F#a} Viajante chegaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Apesar de eu ter visto ilustrações desse vestido antes, ver a Senhorita Kamisato vestindo ele realmente dá um caráter único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Valeu a pena ficar na fila super cedo para pegar lugares na primeira fileira. Eu estou ansioso pela partida de hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "Uau, Ayaka se tornou o centro das atenções no momento que ela apareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Senhoras e senhores, sua atenção, por favor. O duelo de exibição do Espírito do Guerreiro está prestes a começar. Por favor, entrem na arena de forma ordenada e tomem os seus lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "Senhorita Kamisato, Viajante, por favor venham comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "#Viajante, você já está pront{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Estou. Vamos lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Ótimo. Vamos dar o nosso melhor. Estou ansiosa para lutar ao seu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Eu ainda preciso me preparar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "#Ah, não se preocupe, ainda há tempo. Quando você tiver cuidado de tudo, podemos entrar na arena junt{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#{NICKNAME}, Ayaka, estamos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "Essa foi uma partida extraordinária. Eu não sei muito sobre esgrima, mas até eu me envolvi na tensa atmosfera da arena. Meu coração está batendo forte até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "#Os golpes do seu oponente continuaram surpreendendo Paimon, mas parece que vocês estavam preparad{M#os}{F#as} para aquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "Viajante, Senhorita Kamisato, parabéns por vencer o duelo de exibição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Ei, é Sara. Você também veio assistir à competição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "Eu recebi ordens da Toda-Poderosa Shogun para observar esta competição. Vocês demonstraram uma esgrima e cooperação notável. Não só apresentaram a beleza das artes de espada à plateia, como também eu mesmo pude aprender um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Estou lisonjeada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Todos vocês estiveram ocupados com vários preparativos para a competição. Hoje marca o encerramento perfeito a este evento do Espírito do Guerreiro. Seus esforços foram reconhecidos pela Toda-Poderosa Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Eu devo retornar ao Tenshukaku e relatar o que aconteceu no duelo de exibição à Toda-Poderosa Shogun. Pessoal, com sua licença.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "Por falar nisso, todo mundo tem planos agora? Caso não tenham, por que não vamos para o Restaurante Uyuu para uma refeição da vitória?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "#Ótima ideia! Nós estivemos tão focad{M#os}{F#as} na competição ultimamente, que já faz um tempo desde que tivemos uma boa refeição! Vamos nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Ufa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "O que houve, Ayaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Ah, não é nada. A ficha de que vencemos ainda está caindo. Kujou Sara disse que ela aprendeu muito com a luta, e eu também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Apesar de os membros da audiência talvez não terem percebido, houve muitos momentos em que eu estaria em apuros se não fosse você ao meu lado, atraindo os ataques do oponente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Sem você, teria sido impossível vencer apenas com minhas habilidades. É como eu esperava, minha esgrima ainda está longe do seu nível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "Ayaka, você também me ajudou tantas vezes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Sério? Ouvir você dizer isso me faz querer treinar com você de repente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Para falar a verdade, eu espero uma oportunidade de treinar com você desde que nos conhecemos. Esse desejo foi quase realizado hoje no duelo de exibição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "Da próxima vez, nós encontraremos uma chance de praticar por algumas rodadas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Claro. Mas... até lá, garanta que cuidará bem de sua espada. Se eu conseguir roubá-la um dia, sua vida também estará em minhas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Hehe... eu sempre quis dizer algo assim. Soou estranho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Soou muito parecido com a Senhorita Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "Ei, por que vocês estão demorando? Estão falando sobre o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "#Nós estávamos apenas falando sobre ter um partida para determinar qual de nós é {M#o}{F#a} espadachim superior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "#Uau, você é tão séria quando se trata de esgrima. Mas, você não é amiga {M#do}{F#da} Viajante? Por que precisam de uma partida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "#É precisamente pela nossa amizade que nós deveríamos treinar combate com frequência e aprendermos junt{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Oh. Acho que isso meio que faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "Viajante, mantenha tudo que eu disse em segredo, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Hã? O que Ayaka disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Nada, vamos indo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Foi bonitinho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Você está sendo muito modesta, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
