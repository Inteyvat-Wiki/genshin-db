			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "Olá, estimado cliente! Por acaso você conhece o meu filho, Guy? *Cof cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Está tudo bem com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Sim, não é nada... Apenas uma gripe que peguei e que não quer ir embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "Já fui para a <color=#00E1FFFF>Igreja</color>, e as Freiras também não conseguiram curar e só passaram alguns remédios para aliviar o sintoma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "*Suspiro* Estou ficando velho, então não posso andar muito longe. Sempre tive Moco e Hillie ajudando a buscar meus remédios no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Porém eles estão ocupados hoje... *cof cof* A <color=#00E1FFFF>Jiliana</color> sabe o que fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Tudo o que eu preciso é que alguém leve os ingredientes para que ela possa preparar. <color=#00E1FFFF>Três Flores Doces</color> é tudo o que ela precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "*Cof cof*... Ob... Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Pegue três Flores Doces e leve para a Irmã Jilliana na Igreja, que irá preparar os medicamentos. <color=#00E1FFFF>Não diga nada ao Guy</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Ouvi dizer que a Igreja tem alguma conexão com os Cavaleiros de Favonius. Meu filho é um deles, então tenha cuidado com o que você diz ou faz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Se ele acabar por fazer algo louco por causa de seu velho homem, seria terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Desculpe por ter que ficar me escutando por horas e horas. Vou te deixar ir. Tenha uma boa jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Alguém como o seu filho, Guy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "*Suspiro* Se o garoto quer sair lutando contra monstros, quem somos nós para atrapalhá-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
