			"dialogs": [
				{
					"id": 200600901,
					"content": "Quando será que esta maldita coisa vai desaparecer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600902,
						200600904
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600902,
					"content": "Aqui estão seus medicamentos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600903
					]
				},
				{
					"id": 200600903,
					"content": "Ok, obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600907
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600907,
					"content": "Eu me sinto tão envergonhado que meu filho está lá fora lutando e não há absolutamente nada que eu possa fazer para apoiá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600908
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600908,
					"content": "A única coisa que posso fazer é evitar incomodá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600909
