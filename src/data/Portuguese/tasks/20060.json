			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "O remédio está pronto. Mas este medicamento fornece apenas alívio, e não a cura. Se ele realmente quer melhorar, ele precisa continuar tomando o remédio e também descansar bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600802,
					"content": "Devo ter contado a ele mil vezes, mas isso entra em um ouvido e sai no outro. Não importa quem fale com ele, ele apenas diz que ficará bem, que ele vai sobreviver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600803,
					"content": "Está certo. É melhor você levar o remédio para o Tunner o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600804,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600805,
					"content": "Disponha, apenas estou fazendo o meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600806,
					"content": "Desculpe o incômodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600807,
					"content": "Oh, não foi nada. *Suspiro* Se pelo menos alguém estivesse lá para cuidar do Sr. Tunner, ele não precisaria continuar tomando este medicamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
		{
