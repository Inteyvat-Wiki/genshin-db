			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600701,
					"content": "Sinceramente, aquele Tunner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600702,
					"content": "Eu vim aqui preparar alguns medicamentos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "#Oh? Você é nov{F#a}{M#o} aqui. Onde estão Moco e Hillie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600704,
					"content": "Vi que você trouxe os ingredientes. Deixe-me checar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
