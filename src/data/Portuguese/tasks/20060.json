					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200600402,
					"content": "Podemos nos encontrar com a <color=#00E1FFFF>Irmã Jilliana</color>? Ou você quer pegar mais?",
					"roleType": "TALK_ROLE_NPC",
