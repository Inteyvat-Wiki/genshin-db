			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "Ah, ei! Isso que estão em suas mãos são Flores Doces? Isso pode ser um pouco presunçoso, mas posso comprar um de você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Meu pai está com essa tosse há muito tempo; Pedi a Jilliana um remédio para tosse, mas ela estava sem ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Eu também estou indo em busca dos remédios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Ah, então deixa para lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Desculpe por atrasar você. É melhor você chegar à igreja rapidamente então, Jilliana ainda deve estar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Flores Doces são fáceis de encontrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Hum? Entendi... Infelizmente tenho que ficar de guarda no portão. Não posso deixar o meu posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Eu tive que até usar o meu horário de almoço só para ir encontrar a Jilliana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Tudo bem, olhando para você, parece que você também está apto a entregar remédios. Não vou ocupar mais do seu tempo. Se você chegar à Igreja rapidamente, Jilliana ainda deve estar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
		{
