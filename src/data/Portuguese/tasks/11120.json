			"dialogs": [
				{
					"id": 111200301,
					"content": "Em nosso último conto, o Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 111200302,
					"content": "Encontramos você, Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200303,
					"content": "Sim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200304,
					"content": "Vocês vieram ouvir os contos? Não sabia que também tinham interesse nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200305,
					"content": "Não! Viemos procurar você. Tem tempo agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200306,
					"content": "Sim, tenho, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200307,
					"content": "Nós recebemos uma missão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "Procuram alguém que entende do solo e minérios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200310,
					"content": "Solo e minérios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200311,
					"content": "Olhando ao redor, há alguém que entenda mais disso que você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200312,
					"content": "O solicitante diz ter encontrado a pessoa que mais entende de minérios. Eu quero provar para ele que você é a pessoa que mais entende disso em Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200313,
					"content": "Por que você está sendo tão competitiva assim do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200314,
					"content": "Não é ser competitiva, é que o Sr. Dai não entende disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200315,
					"content": "Eu queria apenas mostrar para ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200316,
					"content": "Haha! Entendi. Então eu vou com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200317,
					"content": "Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200318,
					"content": "Mas quero dizer primeiro que, apesar de ter algum conhecimento, não sei se sou a pessoa que mais entende de minérios aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200319,
					"content": "A aprendizagem é um caminho sem fim. Ter conhecimentos é bom. Por um lado, vocês confiam em mim e, por outro, se realmente houver um especialista, eu também poderei aprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200320,
					"content": "Hum... Acho que o Zhongli não precisa ser tão modesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200321,
					"content": "Já que ele aceitou, então vamos logo! Vamos procurar o Sr. Dai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200308,
					"content": "É um trabalho peculiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
