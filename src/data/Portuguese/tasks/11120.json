			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "Ei! Você é o Sr. Dai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200202,
					"content": "Sim. Me procuram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200203,
					"content": "#Sim? Esperem. Vocês são {M#os Aventureiros}{F#as Aventureiras} da Guilda dos Aventureiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200204,
					"content": "Uau, como você sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200205,
					"content": "Olhando para suas roupas e expressão... Devem ser bem experientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200206,
					"content": "Isso mesmo! Você acertou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200207,
					"content": "Hahaha. Quem faz nosso trabalho, sabe fazer verificações. Verificar pedras e verificar pessoas, tudo é verificar. Basta eu olhar para alguém e logo sei todas as informações sobre ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200208,
					"content": "Esperem um pouco. Meu assistente está a caminho, logo vai chegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200209,
					"content": "Ei, espere! Nós já estamos aqui, tem outros assistentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200210,
					"content": "Sim! Não vou mentir para vocês, é algo trabalhoso, por isso acho que ter um ou dois aventureiros não é suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200211,
					"content": "Ah! Então afinal tem mais gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200212,
					"content": "Tio, você está nos desprezando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200213,
					"content": "Paimon, não fale isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "Vocês não sabem. Essa situação aconteceu na mina e foi algo estranho. Tem acontecido muitas coisas por lá e, para prevenir, decidi procurar um especialista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200216,
					"content": "A tarefa principal dos aventureiros não está relacionada com a verificação dos minérios e análise dos solos, né? É bom ter um especialista nos acompanhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200217,
					"content": "Além disso, esse especialista é muito profissional. Com uma olhada ele consegue saber qual o minério de imediato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200218,
					"content": "Se me perguntarem direi que quem mais entende de minérios no mundo é ele! Como poderia não pedir sua ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200219,
					"content": "Isso não está certo... Como você chegou a encontrar a pessoa que mais entende de minérios no mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200220,
					"content": "Como eu não encontraria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200221,
					"content": "Claro que não! Pois a pessoa que mais entende de minérios é nosso amigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200222,
					"content": "Você não está falando de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(Falando nisso, eu gostaria de perguntar uma coisa para ele.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "Hum. Você não esperava isso, né? Espere um pouco, vamos buscar ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200214,
					"content": "Paimon, você está sendo competitiva...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
