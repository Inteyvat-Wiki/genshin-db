			"dialogs": [
				{
					"id": 111200101,
					"content": "Katheryne, somos nós! Tem missões novas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200102,
					"content": "Sim. Há um trabalho novo. Acho que vocês podem fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200103,
					"content": "O Sr. Dai é um dos trabalhadores do Salão Huishan no Porto de Liyue e precisa de alguns assistentes da Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200104,
					"content": "É para fazer o que exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200105,
					"content": "Ouvi dizer que ele precisa de algumas pessoas para ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200106,
					"content": "Ajudar? Nós sabemos fazer isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200107,
					"content": "#Sim. Os talentos d{M#o}{F#a} Viajante são inegáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200108,
					"content": "Em relação aos detalhes da missão, vocês podem discutir cara a cara. Se aceitarem, podem procurar o Sr. Dai junto do cais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
