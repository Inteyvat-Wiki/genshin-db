						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "Sr. Dai, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200402,
					"content": "Oh! Esse é seu amigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200403,
					"content": "Sim! Eu acredito que ele é a pessoa que mais entende de minérios no mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200404,
					"content": "Que exagero! Eu apenas tenho algum conhecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200405,
					"content": "A pessoa que eu pedi para vir também não perde para o seu amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200406,
					"content": "Mas não sei bem. Ele daqui a pouco chega e vocês poderão ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200407,
					"content": "Ah... É aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200408,
					"content": "Você chegou na hora certa! Gente, esse é o meu assistente, Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200409,
					"content": "#Kun Jun, {M#esses dois são os Aventureiros}{F#essas duas são as Aventureiras} que encontrei. E esse senhor é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200410,
					"content": "Hum...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200412,
					"content": "Seu nome é Zhongli, é consultor da Funerária de Wangsheng.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "Consultor da Funerária de Wangsheng, Sr. Zhongli... Ouvi falar. Dizem que é um homem de grande conhecimento e vários talentos. Nunca imaginei conhecê-lo em pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200414,
					"content": "Hum? Nos conhecemos? Já nos vimos na Funerária de Wangsheng? Mas eu nunca fui lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200415,
					"content": "Sr. Dai, você não quer testar eles para ver quem é o verdadeiro especialista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200416,
					"content": "Então era esse seu plano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "Ah? Eu... Eu não saberia por onde começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200418,
					"content": "Pensem em uma forma de fazer esse teste. Se Zhongli ganhar, peça ajuda dele. Se ele perder... Não! Como ele poderia perder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200419,
					"content": "Teste? Tudo bem! Estou pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200420,
					"content": "Admiro seu entusiasmo, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200421,
					"content": "Hahaha! Devo dizer que assim que vi você eu percebi que você é um especialista. Mas entre nós dois, não sei quem tem mais conhecimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200422,
					"content": "Atitudes valem mais que palavras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200423,
					"content": "É apenas um fato, haha... Além disso, esse é o meu único talento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200424,
					"content": "Você é um avaliador, Kun Jun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200425,
					"content": "Não, na verdade... Na verdade eu até me esqueci o que vim fazer no Porto de Liyue... Um dia estava na rua e o Sr. Dai me chamou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200426,
					"content": "O Sr. Dai viu que eu estava com uma pedra e me fez alguns perguntas. Depois ficou muito entusiasmado e me pediu para vir até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200427,
					"content": "Ah? Como você esquece de uma coisa dessas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200428,
					"content": "No caminho para o Porto de Liyue, encontrei ele observando as pedras e falando sozinho. Parecia bem familiarizado com elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200429,
					"content": "Por curiosidade, fiz algumas perguntas. Quem iria dizer que ele ainda entende mais do que eu! Enfim... Como ele também não tem nada para fazer, pode me dar uma ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200430,
					"content": "Sua memória é bem fraca, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200431,
					"content": "Não exatamente... Mas, no que diz respeito a pedras, eu posso sempre ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200432,
					"content": "Sr. Zhongli, o que acha dessa pedra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200433,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200434,
					"content": "Essa pedra tem um exterior brilhante e liso e uma fissura que só poderia ter sido feita por uma erupção vulcânica. Se minha suposição estiver certa, é uma pedra de outra nação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200435,
					"content": "Oh! Muito bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200436,
					"content": "Não é uma pedra comum. Tem uma camada superficial frágil, linhas escuras... Acho que tenha um Minério de Cristal de ótima qualidade dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200437,
					"content": "Certíssimo. Essa pedra vem da margem de um vulcão. Estava andando e comprei ela no mercado. O vendedor colocou ela em um canto, nem sabia o seu valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200438,
					"content": "Minérios de Cristal não existem em toda a parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "Pureza e raridade geológica não são suficientes para classificar um tesouro. Alguns dos mais preciosos cristais contêm pequenos depósitos de água ou areia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200441,
					"content": "No momento da sua formação, o cristal dentro da pedra capturou um pouco de água. Ela ficou armazenada nas profundezas e brilha como a luz por trás de uma montanha. É um tesouro raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200442,
					"content": "Que detalhado, parece algo que você mesmo viu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200443,
					"content": "Então... Você não está brincando conosco, não é? Afinal de contas, ainda não abrimos essa pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200444,
					"content": "Não, ele está dizendo a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200445,
					"content": "A maioria dos cristais surge em ambientes de alta temperatura, que não são compatíveis com a água. E, por isso, os cristais com depósitos de água são muito valiosos. A água contida nesse cristal vem de um lago no alto de uma montanha, o que é ainda mais raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200446,
					"content": "Se Zhongli diz, então deve ser verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200447,
					"content": "É a primeira vez que vejo alguém tão sábio como Zhongli! Como você sabe exatamente o que tem dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200448,
					"content": "Vi muitas pedras dessas e por isso já as reconheço. Espero que você não leve a mal revelar meus conhecimentos dessa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200449,
					"content": "Não, claro que não! Sinto que encontrei alguém como eu. Espero que possamos ser amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200450,
					"content": "Sr. Dai, leve também o Sr. Zhongli! Acredite em mim, ele é sem dúvida um especialista. Não irá encontrar ninguém como ele na sua vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200451,
					"content": "Tudo bem. A união faz a força! Me acompanhem até à mina no Despenhadeiro. Tem alguém precisando da nossa ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111200439,
					"content": "Por que esse é de tão boa qualidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
		{
			"id": 1112022,
