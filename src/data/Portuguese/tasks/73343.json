					"nextDialogs": [
						733430203
					]
				},
				{
					"id": 733430203,
					"content": "Claro, muitas Pari sabem \"de cor\" como trazer Flores Sunyata à vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430204,
					"content": "Em outras palavras, mesmo que o Sinal de Apaosha tenha desaparecido, essa Flor Sunyata ainda não se recuperou da corrosão e está extremamente frágil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430205
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430205,
					"content": "É improvável que as outras lagoas de flores sejam poupadas. Isso deve ser muito perturbador para Sefana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430206
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430206,
					"content": "Essa Sefana que você mencionou deve ser uma Pari legal que trabalha muito para cuidar das flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430207,
					"content": "#Vamos ajudá-la, beleza, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430208,
					"content": "#Não é nada muito difícil para mim e vai ajudar a Sefana. {M#Meu}{F#Minha} Yasnapati, por favor, fique de olho nessas Flores Sunyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430209
					],
					"speakerTitle": "Sorush"
				},
