			"dialogs": [
				{
					"id": 221020101,
					"content": "Está sendo um pesadelo absoluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Já não tenho dormido bem recentemente, olhe para essas olheiras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020104,
					"content": "Você viu os convidados? Cada um é mais louco que o anterior. Você acredita que alguém se atreveu a pular daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020105,
					"content": "Deixa para lá. Neste exato momento, estou esperando a minha comida, deve estar chegando em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020106,
					"content": "No entanto, existem monstros na estrada e eles certamente causarão problemas. Será que você poderia me ajudar a eliminá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Conto contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020108,
					"content": "Este albergue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "\"Portas abertas para todos os viajantes do mundo, e para todas as histórias de vida.\" É o que eu penso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020111,
					"content": "Para falar a verdade, é apenas uma pousada um pouco mais distante e mais movimentada do que a maioria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020112,
					"content": "Eu agradeço a sua ajuda. Obrigado e boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
