			"trigger": {
				"objectNames": [
					"Quiauhquetzal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "Você para no topo da estante de um lado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "Aqui é seguro. O que foi, meu amigo dourado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120305,
					"content": "#Nada. Só fiquei um pouco curios{M#o}{F#a}, só isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Aqui, o andaime de madeira é alto e a vista é ampla. É um bom lugar para se esconder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120309,
					"content": "Na minha Grande{RUBY#[S]Tribo} Casa, ficar no chão era perigoso. Mesmo que o grande {RUBY#[S]governantes soberanos}governante acima das nossas cabeças não nos matasse por capricho, saqueadores de outras Grandes{RUBY#[S]Tribos} Casas viriam para nos pilhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120310,
					"content": "Só empoleirados nos penhascos e na copa das árvores, como um quetzal, conseguimos fugir e sobreviver antes que a calamidade ataque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120311,
					"content": "Além disso, a Vindia disse que quer me ver voar. Ela quer can{RUBY#[S]escrever}tar sobre montar um pássaro gigante numa história de aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120312,
					"content": "Você tem certeza de que ela não está te zoando...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "Não, não. A Vindia é uma pessoa muito boa, talvez até tão boa quanto o Senhor das Encruzilhadas. Eles são tão gentis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120314,
					"content": "Mas é impressionante como vocês conseguem voar, lá no alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120315,
					"content": "Isto é para vocês. É a prova da nossa amizade. Preciso pensar em como podemos voar ainda mais alto para ficar fora do alcance do perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120316,
					"content": "Embora nem os Grandes {RUBY#[S]governantes soberanos} Governantes nem os conquistadores que se deleitam em esfolar estejam aqui... eu já estou acostumada a ter um meio de fuga onde quer que eu esteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120306,
					"content": "Só estava me perguntando se você ficou presa aí em cima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Obrigado, mas não, eu não fiquei preso. É seguro quando eu estou bem alto. Aqui, eu não vou morrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Quiauhquetzal"
				}
			]
		}
	]
}