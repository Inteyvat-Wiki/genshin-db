					"speakerTitle": "Flora"
				},
				{
					"id": 200700402,
					"content": "Só consegui trazer essas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700403
					]
				},
				{
					"id": 200700403,
					"content": "O resultado desses testes foi muito bom. Acho que conservar elas em baixas temperaturas realmente é uma boa ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700404
					],
