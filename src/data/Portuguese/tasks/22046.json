			"dialogs": [
				{
					"id": 220460101,
					"content": "O santuário está ficando bagunçado novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "Miau, é você de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460104,
					"content": "Após um pouco de negligência, os arredores do santuário começaram a coletar sujeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460105,
					"content": "Isto não é maneira de cumprimentar aqueles humanos que vêm para prestar seus respeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460106,
					"content": "Você poderia me ajudar na limpeza do santuário, como você fez antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460107,
					"content": "Você não tem Taisuke e Eiko por perto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "Eu... não falarei com esses dois humanos verdes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460109,
					"content": "O humano alto sempre olha para mim com um olhar estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460110,
					"content": "E o outro humano verde nunca parece particularmente... motivado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460111,
					"content": "Miau miau, independentemente, eles não são humanos confiáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460115,
					"content": "Seja qual for o caso, eu só posso contar com você para esta tarefa. Basta usar o bastão longo e a água para limpar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460116,
					"content": "Tudo bem, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "Seja qual for o caso, vou deixar isso com você. Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460119,
					"content": "Eu vou esperar por você, miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460117,
					"content": "Entendi, mais ou menos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "Bem, você poderia perguntar ao Sr. Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "O humano de pedra está sempre ocupado com seu toc-toc-toc. Quem sabe o que ele está fazendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220460114,
					"content": "A pedra foi derrubada, afinal de contas. O que ele está batendo desta vez, esta se pergunta... Como é irritante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "Neko"
				}
			]
		},
