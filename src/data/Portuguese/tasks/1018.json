			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Você finalmente voltou. Como foi a sua jornada para o Relevo de Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031802,
					"content": "... Entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031806,
					"content": "Mas afinal não vi todos deles. Nas palavras deles, o destino não me levou para eles, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031807,
					"content": "Não tem problema. Se estiver disposta, você pode ir provar a sua sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031808,
					"content": "Além disso, as informações sobre o Conquistador de Demônios já são muito valiosas. Como recompensa, também tenho informações para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031809,
					"content": "Em relação à morte do Arconte, a resposta dos Qixing de Liyue é meio intrigante, razão pela qual não consigo parar de pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031810,
					"content": "Eles anunciaram que, como o verdadeiro assassino ainda não foi encontrado, eles não estão permitindo que ninguém cumprimente Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031811,
					"content": "Eles chegaram ao ponto de tentar cortar informações... Mas com o Ritual da Descensão e tudo, nem os Qixing são capazes de esconder as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031812,
					"content": "Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "É senso comum em Liyue que Rex Lapis é um Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031814,
					"content": "O Arconte Geo é conhecido como Deus de Contrato, e também considerado o Primeiro dos Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031815,
					"content": "Os Adepti Poderosos e Iluminados de hoje, todos assinaram o contrato de proteger Liyue tempos atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031816,
					"content": "Ah? Isso explica o motivo de estarem sempre preocupados com os assuntos de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Naturalmente. Ambos têm a responsabilidade e a aptidão para o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031818,
					"content": "Se o Qixing dominante se tornar incapaz de cumprir seu dever adequadamente, os Adepti têm o direito de tomar medidas corretivas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031820,
					"content": "Isso torna as coisas difíceis para mim também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Eu concordo, alguma coisa definitivamente não está certa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "O espírito do Arconte Geo aumentou, então por que os Qixing escondem? Muito suspeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031822,
					"content": "Oh. Certo! Ele é a razão pela qual estamos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Se os Qixing de Liyue esconder a Exuvia, e ninguém conseguir se aproximar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#{NICKNAME}, o seu plano de encontrar todos os Sete Arcontes será impossível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "Não é da sua conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Sem comentários.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Oh? Vocês estão à procura dos Setes? Posso saber a razão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031828,
					"content": "Hehehe... Boa resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031829,
					"content": "Um cavaleiro que é enganado pelos Fatui não seria realmente um verdadeiro cavaleiro no fim das contas, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031830,
					"content": "#Mas, eu também posso ajudá-l{M#o}{F#a} com isso, sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031831,
					"content": "Hum? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Me dê um pouco de tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031833,
					"content": "Hora de... Procurar alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031834,
					"content": "Eu vou encontrar alguém para você, alguém que possa ajudá-lo a romper esse impasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031835,
					"content": "Realmente fascinante. Quanto mais eles tentam encobrir a situação, maior a chance de o caos acontecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10031836,
					"content": "#Se você quer estar por perto para ver tudo desabar, é melhor você continuar viv{F#a}{M#o} até o próximo encontro, sim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
