			"dialogs": [
				{
					"id": 120211001,
					"content": "#Bom trabalho, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211002
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211002,
					"content": "Hihi, isso foi tudo graças às suas táticas geniais, Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211003,
					"content": "Mesmo as melhores táticas dependem da força de quem as executam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211004
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211004,
					"content": "Ganhar uma batalha exige um esforço concentrado de todos os envolvidos. A vitória nunca pertence a uma única pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211005
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211005,
					"content": "Isso mesmo! Paimon também contribuiu muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211006,
					"content": "Não percebi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120211007
					]
				},
				{
					"id": 120211007,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211008,
					"content": "Devo admitir que não esperava encontrar os Fatui escondidos em um acampamento de Hilichurls. Presumivelmente, eles estão operando aqui em segredo há algum tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211009
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211009,
					"content": "Qual é o objetivo deles? Os soldados estão certos? Eles realmente estão em conluio com a Comissão Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211010,
					"content": "Vamos vasculhar o acampamento em busca de evidências. Se a história do comerciante for verdadeira, o inventário deve estar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211011
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211011,
					"content": "Tudo bem! É hora de dar uma olhada ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
