				{
					"id": 120211101,
					"content": "Hmm. Isso não era bem o que eu chamaria de \"conforme as regras\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211102,
					"content": "Mas isso acontece. As batalhas são coisas complexas e a situação evolui constantemente. Nem sempre ajuda aderir rigidamente a um plano pré-determinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211103,
					"content": "Hee-hee... Parece que assim que os combates começaram, o plano saiu pela janela e nós meio que improvisamos...",
