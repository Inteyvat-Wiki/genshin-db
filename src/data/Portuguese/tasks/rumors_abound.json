			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "Devo admitir que não esperava encontrar os Fatui escondidos em um acampamento de Hilichurls. Presumivelmente, eles estão operando aqui em segredo há algum tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210202,
					"content": "Qual é o objetivo deles? Os soldados estão certos? Eles realmente estão em conluio com a Comissão Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210203,
					"content": "Vamos vasculhar o acampamento em busca de evidências. Se a história do comerciante for verdadeira, o inventário deve estar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210204,
					"content": "Tudo bem! É hora de dar uma olhada ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202103,
			"completionStepIds": [
				1202108,
				1202118
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202108",
							"2"
						],
						"stepId": 1202108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210301,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210302,
					"content": "Kokomi, encontramos as coisas do comerciante. Veja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210303,
					"content": "Hmm... Entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210304,
					"content": "Algo errado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Oh nada. Eu apenas perdi o foco por um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210307,
					"content": "Vamos ver aqui... Sim, essas são as mercadorias roubadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210308,
					"content": "Alimentos, remédios, ferramentas agrícolas... Tudo essencial para a recuperação pós-guerra. Ele provavelmente estava estocando-os até terem um lucro considerável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210309,
					"content": "Por outro lado, duvido que a Comissão Tenryou precise desses itens, então a ideia de que ele estava fornecendo as mercadorias não faz muito sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210310,
					"content": "Provavelmente, ele é apenas um comerciante oportunista. Nada tão escandaloso quanto Matsuda e Uchimura haviam imaginado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210311,
					"content": "Uhh... ele não é um santo, certo? Como ele poderia estocar coisas pelas quais as pessoas estão desesperadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210312,
					"content": "Não vamos devolvê-las a ele e deixá-lo ir, não é mesmo? Não parece certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210313,
					"content": "Não se preocupe, eu já previ algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210314,
					"content": "Em meu Decreto de Pós-Guerra Temporário recentemente publicado, incluí restrições sobre os preços de bens essenciais do dia a dia. Estes itens acabarão por chegar às pessoas a um preço razoável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210315,
					"content": "Se ele tivesse tirado um tempo para ler o decreto, seria improvável que ele tivesse acabado nesta situação difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210316,
					"content": "Kokomi, você pensa em tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210317,
					"content": "Quem me dera que isso fosse verdade. Tomemos este suposto conluio entre a Comissão Tenryou e os Fatui, por exemplo. Ainda estou completamente perplexa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210318,
					"content": "A energia baixa não exatamente ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210319,
					"content": "Uh... Hã? O que você quer dizer com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210320,
					"content": "Nada. Vamos lá, vamos levar os produtos de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210321,
					"content": "Já não falta muito para o Banquete da Vitória. Será uma corrida contra o tempo para resolver tudo isso antes de começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210322,
					"content": "Entendido! Primeiro consertamos a paz, depois participamos do banquete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210305,
					"content": "O que você está pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
		{
			"id": 1202104,
			"completionStepIds": [
				1202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202109",
							"2"
						],
						"stepId": 1202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naruse",
					"Matsuda",
					"Sangonomiya Kokomi",
					"Uchimura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "Minhas mercadorias! Você as conseguiu de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210402,
					"content": "#Obrigado, Vossa Excelência! E obrigado, Capit{M#ão}{F#ã}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210403,
					"content": "Viu só? Eu disse que era inocente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210404,
					"content": "Hnf... Sei não. Você poderia muito bem ter planejado tudo com antecedência com os Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210405,
					"content": "Com base nas informações que coletamos do acampamento Fatui, não há nada que sugira que ele tivesse alguma relação com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210406,
					"content": "Se fosse o caso, então sabendo como os Fatui operam, eles teriam deixado algumas provas disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210407,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210408,
					"content": "Sem \"se\", nem \"mas\". Recuperamos a mercadoria. Como acordado, isto é suficiente para estabelecer sua inocência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210409,
					"content": "Minhas desculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210410,
					"content": "Parece que nos deixamos levar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210411,
					"content": "Hah! O que eu lhes disse? Vocês, com seus crânios de exército, não fazem a menor ideia - todos com músculos e sem miolos! Vindo até mim com suas loucas teorias conspiratórias... Deixe-me em paz no futuro, entendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210412,
					"content": "Senhor, temo que você esteja se precipitando. Você pode ser inocente das acusações que lhe foram feitas originalmente, mas acumular bens essenciais é um crime nos termos do Decreto Temporário. Você deve arcar com as consequências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210413,
					"content": "Você já admitiu ser o proprietário dessas mercadorias, por isso somos obrigados a responder com medidas apropriadas. Além de impor a venda destas mercadorias às taxas aceitáveis, haverá também uma multa, no valor de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210414,
					"content": "Espere, espere! Vossa Excelência... De que lado você está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210415,
					"content": "Eu não tenho interesse em tomar partido. Como Sacerdotisa Divina da Ilha de Watatsumi, eu respeito o princípio de recompensas e punições claras e consistentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210416,
					"content": "Assim como o mérito deve ser reconhecido, os erros devem ser penalizados. Você pode ter se provado inocente das alegações mais graves que lhe foram feitas, mas isto não o isenta de arcar com as consequências de seus erros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210417,
					"content": "Eu... Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210418,
					"content": "Bem, não fique aí parado - leve-o embora! Está na hora de pagar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210419,
					"content": "Vossa Excelência, ele diz que todas as mercadorias pertencem a ele, mas isso não faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210420,
					"content": "Aqueles com um emblema da Comissão Tenryou são provavelmente seus, mas não os demais. Especialmente estes - eles são claramente para uso em santuários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210421,
					"content": "Mm... Parece que os Fatui simplesmente jogaram todos os bens roubados em um só lugar. Deixe a parafernália do santuário para mim. Quanto ao resto, vou deixá-los para filtrar e tentar localizar os proprietários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210422,
					"content": "Sei que isso é pedir muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210423,
					"content": "De modo algum, Vossa Excelência, vamos cuidar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210424,
					"content": "Mas se me permite, Vossa Excelência... Talvez não houvesse sinais de conluio neste caso, mas nosso povo sabe o que viu. Algo está acontecendo entre a Comissão Tenryou e os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210425,
					"content": "Sei que as negociações de paz estão chegando, então... Por favor, mantenha a mente aberta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210426,
					"content": "Compreendo sua preocupação. Não me esquecerei de prestar mais atenção a isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}, vou levar estes itens de volta para o Santuário Sangonomiya. Por que você não vem junto para a caminhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202108,
			"completionStepIds": [
				1202114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202114",
							"2"
						],
						"stepId": 1202114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "Sabe, o santuário mais antigo da Ilha Watatsumi não estava localizado em Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210805,
					"content": "Estava perto da Estátua dos Sete. Naquela época, o povo desta ilha reconheceu a existência da Shogun, apesar de não venerá-la como faz o Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210806,
					"content": "Mas depois que ela derrubou nossa divindade protetora, o santuário foi abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210807,
					"content": "As relações entre a Ilha de Watatsumi e o Shogunato têm se deteriorado desde então. A desconfiança se enraizou profundamente ao longo do tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210808,
					"content": "Tenho esperado levantar tudo isso nas conversações de paz e discuti-lo adequadamente. As mágoas têm de ser deixadas de lado, eventualmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210809,
					"content": "Vossa Excelência, o que a traz por aqui em sua agenda lotada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210810,
					"content": "Oh, minha nossa. Você está parecendo um pouco desgastada... Você precisa cuidar melhor de si mesma, está bem? Todos os nossos destinos dependem de você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210811,
					"content": "Mm, obrigada por sua preocupação, mas eu estou bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210812,
					"content": "Vossa Excelência, eu lhe imploro, atenda a uma palavra de conselho. Depois de todo este tempo lutando contra o Exército do Shogun, a paz não é algo que possa ser simplesmente declarada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210813,
					"content": "Se nos reconciliarmos com eles, o deus que uma vez nos protegeu terá morrido em vão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210814,
					"content": "Qual é, isso já é história antiga. Além disso, a luta ainda mal terminou. Devemos ser gratos por estarmos em paz mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210815,
					"content": "Eu sei, eu sei, é que... *Suspiro* Devemos permanecer fortes nestas negociações. Não devemos estar tão dispostos a nos comprometer assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210816,
					"content": "Agradeço suas preocupações. Considerarei as opções cuidadosamente e terei certeza de proceder de forma apropriada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210817,
					"content": "Maravilhoso... Estamos todos contando com você, Vossa Excelência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210818,
					"content": "Vossa Excelência? Minha nossa! Que bom encontrá-la em um lugar como este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210819,
					"content": "Sabe - minha filha se inscreveu no processo de seleção de Sacerdotisas este ano. Se ela conseguir entrar em Sangonomiya, eu serei uma mãe muito feliz! Você é uma líder bondosa e graciosa. Ela ficaria em muito boas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210820,
					"content": "*Suspiro* Estou sempre dizendo à minha filha que se ela tiver a oportunidade de aprender diretamente com Vossa Excelência, ela deve aproveitá-la ao máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210821,
					"content": "Digo, é só olhar para Vossa Excelência. Ainda tão jovem, mas tão madura e inteligente. Minha filha sempre olhou para você como um modelo a ser seguido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210822,
					"content": "Bem, se ela vier para Sangonomiya, irei cuidar dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210823,
					"content": "Ah, Vossa Excelência! Caramba, ainda bem que você está aqui. Como você sabe, a produção agrícola teve um grande sucesso este ano, deixe-me informá-la sobre a situação mais recente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 120210824,
					"content": "#Oh, Vossa Excelência, {M#este}{F#esta} não é {M#o capitão}{F#a capitã} do Peixe-Espada II? {M#Ele}{F#Ela} ficará na Ilha Watatsumi a partir de agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Ryouko"
				},
				{
					"id": 120210825,
					"content": "Vossa Excelência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Yukiya"
				},
				{
					"id": 120210826,
					"content": "Ufa... Por favor, mantenham a calma, todos, vou responder a todas as suas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210827,
					"content": "Embora para as mais longas, eu preferiria que pudessem escrever um relatório e apresentá-las ao santuário. Então eu poderei responder a cada uma delas como e quando eu tiver tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210828,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210829,
					"content": "#{NICKNAME}, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210830,
					"content": "Estou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "#Heh... Você parece estar acostumad{F#a}{M#o} com esse tipo de situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210834,
					"content": "Vossa Excelência, você está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210835,
					"content": "Nós temos um problema. Estamos aguardando ainda pela entrega de um lote de itens cerimoniais. Estou com medo de que eles tenham sido roubados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210836,
					"content": "Ah sim, já recuperamos o lote, não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210837,
					"content": "Sério? Isso é incrível! Você nunca deixa de nos surpreender, Vossa Excelência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210838,
					"content": "Eu classifiquei todas as petições recebidas recentemente e as coloquei em sua mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210839,
					"content": "Também gostaria de lembrar que, de acordo com a agenda de compromissos, você chegou bem a tempo para a reunião sobre o desenvolvimento da indústria têxtil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210840,
					"content": "Isso é hoje?... Agora mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210841,
					"content": "Sim, e as duas jovens vindas de longe também já chegaram, estamos apenas aguardando por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210842,
					"content": "#Ok...{NICKNAME}, queria te levar para passear um pouco pela Ilha Watatsumi mas pelo jeito vou ter que terminar as minhas coisas aqui primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210843,
					"content": "Podemos nos encontrar então amanhã na entrada do Sangonomiya para ir fazer os preparativos para a festa de comemoração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210844,
					"content": "Uau, festa de comemoração! Só para confirmar, teremos muita comida gostosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210845,
					"content": "Haha... Claro. Teremos também muita especialidade da Ilha Watatsumi e, tenho certeza de que vocês irão gostar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210846,
					"content": "Genial! Então até amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210847,
					"content": "Sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210832,
					"content": "#Estou um pouco cansad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "Eu também, minha cabeça está até doendo um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
