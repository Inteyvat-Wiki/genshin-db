				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ah, Piramumon... Você gostava tanto de ler livros, e sempre dizia que havia um mundo mais vasto além dos conhecimentos... mas é uma pena que eu não acreditava em você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "Eu sempre sorria balançando a cabeça enquanto ouvia suas palavras que me pareciam absurdas. Eu deveria ter acredito em você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "Você sempre me dizia que assim que surgissem oportunidades, eu teria que fugir do Dainichi Mikoshi para explorar em um mundo mais vasto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "Piramumon, agora ninguém vai te impedir! Vá! Seja livre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "E você, Orupeusu, Orupeusu... Eu gostaria tanto de ouvir você cantar mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "Ao ouvir a voz, tão linda e pura, ninguém se recusa a contar junto com você no seu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "Na véspera do Ritual do Retorno Solar, do nada, você queria ouvir a minha voz e pediu para eu lhe cantar uma música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "Dizendo que não importava o quão feia a música fosse, você não iria rir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "Você sabia, não é? Este seria o seu último Ritual do Retorno Solar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "Mas... até o final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "Desculpe, Viajante, eu fui fora de compostura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "A oficial que serve o Filho do Sol deve se recusar a se casar para mantê-la pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Por isso, eu nunca tive filhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "Não se sabe desde quando, essas crianças, que eu cuidava e servia, se tornaram como meus próprios filhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "Muito obrigada, Viajante, por ter recuperado a Rédea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "Esta Rédea Dourada, que passou por todos os Filhos do Sol, carrega as memórias que podem completar as almas perdidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "Mesmo que essas memórias tenham dois lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Dois lados?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "É claro! As memórias de que estamos falando têm dois tipos. Por um lado, você tem suas próprias memórias. Por outro lado, você tem memórias que outros têm de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Esses vazios são preenchidos tanto com as próprias memórias dos Filhos do Sol, gravadas na Rédea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "Como também pelas memórias deles como as crianças culpadas pelo Reino de Byakuya, que se tornaram filhos do pecado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "As memórias que eu tenho agora não são o suficiente para completar as almas deles, portanto, eu tive que recorrer às memórias do povo do Reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "E é graças a esses pecados dos quais eles foram acusados que agora são lembrados pelo Reino de Byakuya e podem deixar suas sombras para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "Muito obrigada, Viajante. Os meus desejos foram realizados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "E agora, eu finalmente poderei ficar mais descansada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "E poderei ficar junto com aquelas crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "Memórias também têm dois lados?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
