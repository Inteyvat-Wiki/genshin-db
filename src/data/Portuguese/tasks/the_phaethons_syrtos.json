					"content": "Um, dois, três. Viajantes, parece que terminamos de mostrar respeito a todas as sete tumbas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722441102,
					"content": "Vamos voltar a aquele santuário de pedra e contar ao espírito de lá sobre tudo isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224412,
