				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440601,
					"content": "Ah! Isto realmente é a Rédea Divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440602
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440602,
					"content": "Nunca imaginei que um dia poderia vê-la de novo. Viajante, onde você a encontrou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440603
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440603,
					"content": "Aberaku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "De Aberaku no Mikoto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "É muito curioso. Eu me lembro que ele era uma grande figura na época quando o Reino de Byakuya foi recém-fundado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "Mas dizem que depois ele planejou roubar o trono do Reino de Byakuya para ser o Filho do Sol, e acabou sendo acusado de ser rebelde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "Já que vocês conseguiram retirar esta Rédea Dourada da mão dele, parece que uma história por trás disso está prestes a ser revelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "Foi o destino que fez a Rédea voltar a aparecer por aqui... não consigo esquecer a imagem dos rostos das crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "Assim, finalmente, eu poderei ter chance de pagar meus erros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "Viajante, jogue esta Rédea no lago do Local do Guia da Alma. Com ela, com certeza complementaremos as almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "Ugh... Teremos que fazer suas almas completas para que eles possam ir à próxima vida com paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
