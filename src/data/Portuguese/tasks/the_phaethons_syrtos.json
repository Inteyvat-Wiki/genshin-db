			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "Ah, as sete Lanternas da Alma estão acesas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440302,
					"content": "Parece que você completou sua tarefa. Eu sempre lembrarei de como vocês me ajudaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440303,
					"content": "Agora, venha, vou abrir isso para você... O caminho para Lugar do Guia da Alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "Viajante de uma terra estrangeira, eu sei que lhe causei muitos problemas... Mas eu ainda gostaria que você estivesse presente na cerimônia do descanso das almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440305,
					"content": "Siga este caminho. Eu lhe encontrarei no outro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				}
			]
		},
		{
			"id": 7224404,
			"completionStepIds": [
				7224413
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224413",
							"2"
						],
						"stepId": 7224413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440401,
					"content": "Ah, Viajante, você chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "Esse é o local do Guia das Almas, e é aqui que os meus pensamentos finais permanecem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "Quando os Filhos do Sol atingem uma certa idade, eles seguiam uma cerimônia e entrariam no Dainichi Mikoshi no dia de seu aniversário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "Eles entravam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Sim, e esse processo foi conhecido como o Ritual do Retorno Solar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "Os Filhos do Sol nasceram do Dainichi Mikoshi, e voltariam novamente para o assento do sol antes que o mundo mortal pudesse manchá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "...A temperatura do Dainichi Mikoshi era tão forte que sua luz poderia esquentar todo o Reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Dos Filhos do Sol, nada a não ser os fragmentos de suas almas eram o que retornava ao Local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "Mas ainda acreditot que, talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Talvez...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Talvez eu possa complementar suas almas com a minha própria memória abrindo o Lugar do Guia da Alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Deixe-me tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Piramumon, Orupeusu... Eu estou aqui, vocês ainda não vão voltar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "Como foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "*Suspiro* Entre 7 Filhos do Sol, Piramumon e Orupeusu foram criados por eu mesma. Até eles mesmos não queriam responder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440413,
					"content": "Pelo visto, só contar com a minha memória não é suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440414
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440414,
					"content": "Se ao menos houvesse algo que eu pudesse usar como um mediador... Se eu tivesse a Rédea Divina, talvez o emblema do escritório dos Filhos do Sol, talvez pudesse funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440415
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440415,
					"content": "Que pena! A Rédea Divina sumiu há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440416
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440416,
					"content": "*Suspiro* Esta nação, o Reino de Byakuya, ainda odeia aquelas crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440417
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440417,
					"content": "Talvez meu desejo de libertar suas almas não seja senão um sonho irreal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440418
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440418,
					"content": "...Mas ainda assim, Viajante, se você puder considerar mais este pedido final — você poderia ajudar a encontrar a Rédea Divina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440419
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440419,
					"content": "Sei que as chances de encontrá-la são bem pequenas e, de fato, é indelicado da minha parte pedir ainda mais de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440420
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440420,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440421,
						722440422
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440421,
					"content": "Eu compreendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440423,
					"content": "Eu... Obrigada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440424
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440424,
					"content": "Ainda assim, a Rédea Divina foi perdida há muitos anos. Você não precisa se apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440425
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440425,
					"content": "Mas se você ouvir sobre ela, por favor, conte-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440422,
					"content": "Farei o meu melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440423
					]
				},
				{
					"id": 722440405,
					"content": "Então isso não significa que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440426
					]
				}
			]
		},
