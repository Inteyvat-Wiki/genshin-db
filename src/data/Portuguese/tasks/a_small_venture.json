			"dialogs": [
				{
					"id": 761390101,
					"content": "O ramo editorial mal consegue sobreviver hoje em dia. Talvez eu devesse apenas focar em investimentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Deixe-me ver os cupons de investimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Aqui está. 2.000 Mora por cupom, com cada aplicação vencendo semanalmente. E nesta pequena bolsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "...Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "N-não, não é nada. Só não esperava que você fosse aparecer, Srta. Nefer. Será que... talvez esteja interessada em comprar um cupom de investimento também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "#Ah, não, vou deixar passar. Só estou aqui com {M#meu amigo}{F#minha amiga} para dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "Ouvi dizer que seus investimentos têm prosperado, Sr. Dhabit. Vendo com meus próprios olhos, posso confirmar que o boato é verdadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "Ah, não é nada, nada, haha... só um pequeno empreendimento para conseguir me sustentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Isso realmente dá lucro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Mas é claro. O Sr. Dhabit é um excelente homem de negócios — siga o exemplo dele e você não vai perder. Não é mesmo, Sr. Dhabit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "Sim, sim... haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Bom, então vamos ver se a sorte está do meu lado hoje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "Hoje! Só hoje, o que você comprou é o nosso novíssimo... cupom de investimento de curto prazo! Lucros e perdas são liquidados imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Por que parece que você acabou de inventar tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "Uh... e-enfim, obrigado por comprar o cupom de investimento de curto prazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "Aqui está o seu retorno de investimento. Desejo a você um ótimo dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Bem... ganhar dinheiro é sempre uma coisa boa, suponho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Sério? Heehee, então a Paimon quer uma em forma de passarinho! Essa é a favorita da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Então, vou me retirar também. Como eu disse, Sr. Dhabit, você realmente fez jus à sua reputação — um comerciante honesto de ponta a ponta. Que seus negócios prosperem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390122,
					"content": "Obrigado pelas gentis palavras, Srta. Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
					"content": "E, sobre aquele assunto em que pedi sua ajuda da última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390124,
					"content": "Encontramos o que o senhor procura, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390125,
					"content": "Tenha paciência, Sr. Dhabit. Um passo de cada vez — é assim que os negócios devem ser conduzidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390126,
					"content": "A—Ah, sim, tem razão, claro... Vou deixar tudo em suas mãos capazes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
