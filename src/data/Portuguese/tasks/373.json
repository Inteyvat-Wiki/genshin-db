			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "Hum? O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730202,
					"content": "Eu estava me perguntando se você tinha me seguido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730203,
					"content": "Eu quero saber mais sobre o Arconte Anemo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "Você está falando do Arconte Anemo, Barbatos? Ele já desapareceu de Mondstadt há muito tempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730205,
					"content": "Liyue e Inazuma, os respectivos deuses Geo e Electro ainda estão presentes, mas já se passou muito tempo desde que o Arconte Anemo foi visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730206,
					"content": "Por que você quer saber sobre o Deus Anemo? Está relacionado com Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730207,
					"content": "Bem... É porque... Os Arcontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730208,
					"content": "Sim, alguém me contou sobre seu passado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "Tenho curiosidade em saber como que as pessoas veem o \"Stormterror\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730210,
					"content": "Dito isso, não há necessidade de se apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730211,
					"content": "Faz tempo que eu não volto, parece que tem algumas pessoas que não estão felizes com a minha volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "Parece que o dragão não foi o único afetado pela mudança do vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730402,
					"content": "Aliás, você mencionou que alguém falou para você sobre o dragão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730405,
					"content": "Entendo... É assim que a Lisa pensa, aquela estudiosa de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730406,
					"content": "Ela não está errada. Só chegou a este ponto porque ambos os lados resolveram usar a força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730407,
					"content": "Sua fúria, contudo, não foi por causa da falta de oferendas das pessoas para os Quatro Ventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730408,
					"content": "Não é um ódio de sua natureza, mas uma consequência de sua degradação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730409,
					"content": "Degra... Degradação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730410,
					"content": "O sangue negro que corre em seu coração tem o torturado por anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730412,
					"content": "Feiticeiros do Abismo? Nunca ouvi falar deles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "Eu acho que ouvi falar deles antes em Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "Foi isso que permitiu que ele fosse enganado pelas mentiras do Feiticeiro do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730413,
					"content": "Eles são da Ordem do Abismo, uma organização formada por seres que não são humanos. Eles odeiam a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730415,
					"content": "Correto. Eles são da Ordem do Abismo, uma organização formada por seres que não são humanos. Eles odeiam a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730416,
					"content": "Eu não sei de onde eles vieram. Tudo que eu sei é que eles têm um ódio profundo pelos humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730417,
					"content": "Muitos Hilichurls lá fora na natureza recebem ordens deles e atuam como suas armas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730418,
					"content": "Antes de chegar aqui, eu também estava corrompido e amaldiçoado como o Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730419,
					"content": "Mas agora, diante de nós, está o símbolo dos heróis de Mondstadt, o lugar de onde Mondstadt se levantou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730420,
					"content": "O vento entre os ramos das árvores é bom, eu adoro o cheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730421,
					"content": "Estando aqui com você embaixo desta grande árvore se parece quando a lágrima tinha sido purificada. Como se o veneno estivesse saindo do meu corpo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730423,
					"content": "Hum... Sinto-me muito melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730424,
					"content": "Então... Como você foi envenenado exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730425,
					"content": "Ahh... Isso foi porque eu tentei me comunicar com Dvalin antes, mas fui... Interrompido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730427,
					"content": "Oh, ah... Isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "Então fui eu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "No final, além de não conseguir ajudar Dvalin a quebrar a maldição, eu também fui infectado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730429,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730431,
					"content": "#Então, como compensação {NICKNAME}, venha comigo até a Catedral!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730432,
					"content": "A Catedral de Mondstadt? Fazer o que exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730433,
					"content": "Para pegar a \"Lira Sagrada der Himmel\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}