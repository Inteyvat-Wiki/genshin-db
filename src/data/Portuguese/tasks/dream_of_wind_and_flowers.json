			"dialogs": [
				{
					"id": 414130401,
					"content": "Obrigada, Estrela da Flor do Vento. Oferecemos a Flor do Vento repleta de sincera admiração ao Barbatos, o Arconte Anemo, e desejamos que ele proteja Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414130402,
					"content": "Boa escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130403,
					"content": "Gosta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "Hum... Adivinhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130405,
					"content": "Que chato, pare de pedir às pessoas para adivinhar tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130406,
					"content": "Hahaha! Está bem, eu digo a você, mas não aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130407,
					"content": "Não é bom ficarmos falando disso na Praça, vamos para outro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130408,
					"content": "Para onde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130409,
					"content": "Quero que venha comigo até à Toca de Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
