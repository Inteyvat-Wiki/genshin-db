			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "Ah! Que bela paisagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130702,
					"content": "Que paisagem linda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "É verdade. Eu amo esse lugar. Quando tenho tempo, sempre venho me sentar um pouco aqui e ver a paisagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130705,
					"content": "Você vem sentar e descansar aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130706,
					"content": "Hahaha, sim, é verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130707,
					"content": "Com uma paisagem assim, só falta um copo de Sidra de Maçã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130708,
					"content": "Viajante, você gosta do Festival da Brisa Florescente em Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130709,
					"content": "É cheio de amor e alegria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "Mas ainda tem algumas perguntas, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130712,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "Eu sei o que você quer saber. Afinal, o que é a Flor do Vento? Qual o significado da Flor do Vento e do Festival da Brisa Florescente para Barbatos, o Arconte Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130714,
					"content": "Como está vendo, cada pessoa em Mondstadt tem a sua escolha. Alguns escolhem Dandelion de entre milhares de flores, outros escolhem as Margaridas Voadoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130715,
					"content": "A Flor do Vento é diferente para cada pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130716,
					"content": "Sim, e é assim que deve ser. Não há uma resposta únicam, nem uma Flor do Vento que tenha realmente existido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130717,
					"content": "Ah? Ela não existe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130718,
					"content": "A palavra \"Flor do Vento\" era da Mondstadt Antiga. Era um código que as pessoas usavam para se manter em contato e para manter em segredo a resistência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130719,
					"content": "Naquela época, as pessoas diziam que quanto mais forte o vento, mais sólida seria a raiz da Flor do Vento e mais brilhantes seriam as flores que brotariam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130720,
					"content": "Se me perguntar, ela não existe e, ao mesmo tempo, está em todo o lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130721,
					"content": "Ela é um espírito que anseia por liberdade, uma coragem para seguir o vento para onde ele for... Todas as coisas belas que possam ser admiradas podem ser chamadas de Flores do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130722,
					"content": "Parece não existir mas está em todo o lado... É como o vento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130723,
					"content": "Haha, é isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130724,
					"content": "Por isso, Barbatos, o Arconte Anemo, não pode definir precisamente o que é a Flor do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130725,
					"content": "Flor da bênção, flor da admiração, flor do amor. Cada pessoa tem a sua Flor do Vento e cada pessoa tem o direito de definir o que ela é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130726,
					"content": "A flor oferecida ao Arconte Anemo pela cidade livre de Mondstadt é, surpreendentemente, muito livre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414130727,
					"content": "Eu também gosto do sentimento de liberdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "Eu sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130729,
					"content": "O que une as pessoas no mesmo caminho é sua força de vontade compartilhada, e certamente foi o vento da liberdade que nos juntou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130730,
					"content": "Ele vem do fim da jornada, da margem do mundo, da profundidade de nossos corações. É incessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130731,
					"content": "\"Quem acariciou seu rosto machucado e determinado\\nNa margem de um riacho\\nDo lado de uma pedra enorme\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130732,
					"content": "\"Quem abraçou sua alma cansada mas nobre\\nEm sonhos profundos\\nNo alto dos céus\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130733,
					"content": "#\"{F#Querida amiga}{M#Querido amigo}\\nEu pego em sua mão\\nE levo você pela noite iluminada pelas lanternas\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130734,
					"content": "\"Para lhe contar a história da liberdade\\nE dos sonhos desse Festival\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 414130710,
					"content": "É maravilhoso estarmos todos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "O ambiente é agradável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
