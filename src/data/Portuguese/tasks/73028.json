			"dialogs": [
				{
					"id": 730280101,
					"content": "Partes do grande robô também parecem estar aqui e quando o Senhor Jazari as vir, ele provavelmente vai pegar seu Aparelho Fotográfico novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280102,
					"content": "Falando nisso, Ararycan disse que levou a grande coisa para a base secreta. Isso não pode ser verdade, pode?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Claro que é, Ararycan não engana os Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280104,
					"content": "É óbvio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Ararycan é o mesmo Aranara que estava brincando com as crianças na base secreta inicialmente, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280107,
					"content": "Mas Ararycan não se lembra de nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280108,
					"content": "Talvez tenha algo a ver com as flores nas anotações...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Bem, depois que Aranara da Floresta Mawtiyima nos deu as flores antes, ele também se esqueceu de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280111,
					"content": "Talvez os três tenham passado pela mesma aventura que nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280112,
					"content": "Ararycan não sabe do que vocês estão falando e não consegue se lembrar. Mas foi divertido brincar com a pequena Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280113,
					"content": "Hum. Lembre-se de continuar feliz, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280109,
					"content": "Já nos deparamos com isso antes...",
