			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Obrigada! Vamos começar com a primeira poção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390502,
					"content": "#Não vai beber muito, {NICKNAME}! Se sentir alguma coisa estranha, você cospe fora, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Não se preocupe, Paimon, vai dar tudo certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Hnf. Paimon só está preocupada, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "#Estou pront{M#o}{F#a}. Pode me dar a poção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Essa daqui é chamada de Poção Superpoderosa, e vai te deixar muito forte... digo, pelo menos, deveria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390507,
					"content": "Você pega a poção de Verenata e bebe de uma só vez.\\nApesar do cheiro desagradável, seu sabor é doce e pegajoso, e não é difícil de beber.\\nPorém, por outro lado, o seu corpo não tem nenhuma reação.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Sob as instruções dela, você espera até que os Primofissuradores fiquem ativos.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
