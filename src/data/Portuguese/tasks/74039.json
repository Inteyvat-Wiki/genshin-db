				]
			},
			"dialogs": [
				{
					"id": 740390701,
					"content": "#Está tudo bem, {NICKNAME}? Você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390702,
					"content": "Mil desculpas... eu não sabia que a poção atrairia coisas estranhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390703,
					"content": "#Isso aconteceu porque eu estava bem aconchegad{M#o}{F#a}zinh{M#o}{F#a}, sabia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Uh, é assim que as coisas funcionam? Essa palavra existe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Ah, entendi! Animais aquáticos realmente são atraídos por coisas quentes porque confundem elas com o sol! Isso significa... que a poção funcionou! Obrigada, de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390706,
					"content": "Paimon acha que não é bem assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Animais aquáticos...? Aquilo não eram Slimes Pyro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Entendo... hmmm, efeitos alucinógenos... certo, vou anotar aqui. Bem, pelo menos não foi completamente ineficaz, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390709,
					"content": "#Mas os efeitos foram terríveis! Dessa vez el{F#a}{M#e} confundiu caranguejos gigantes com Slimes Pyro, mas e se fosse um monstro mais perigoso?! Hein?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Sim... eu já te incomodei tanto, mas tem uma última poção que precisa ser testada... você ainda está de acordo com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390721,
					"content": "Desde que não seja venenosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Mas a gente só vai descobrir se é venenosa depois de provar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Sim! Muito obrigada! Bem, a seguir... a Poção Visão-Real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390726,
					"content": "Hã? E-Espera um minuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "A primeira era uma Poção Superpoderosa, a seguinte foi a Poção Aconhegante, e essa é chamada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "Poção Visão-Real, que significa que ela \"permite que as pessoas vejam a verdade\"... O que há de errado nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390729,
					"content": "Hmm... Não é nada... Paimon só acha que o nome dessa é completamente diferente das outras! É tipo um giro de 360 graus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "Mas isso não quer dizer que é a mesma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Hã...? Uh... Paimon não tem tantos dedos pra contar! Você sabe o que Paimon quis dizer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Hehe, isso porque a Mestre das Poções nomeou as duas primeiras para mim, e eu dei o nome dessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390734,
					"content": "Mas eu não sou boa com nomes, então ele não é tão bom quanto os nomes que ela inventa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390735,
					"content": "Sério? Paimon pensava que era o contrário... De qualquer jeito, tenha um pouco de confiança! Na verdade, esse é um nome adequado para uma poção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Hmm, obrigada. Enfim... Essa poção é diferente das duas anteriores, então pode ser muito perigosa... Por favor, venham até minha oficina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390737,
					"content": "Bem... Se estivermos no mar, o ambiente deve ajudar a moderar os efeitos da poção e minha oficina tem as ferramentas para lidar com os perigos, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390738,
					"content": "Uau, acho que agora é sério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Vamos começar, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Tudo bem, sigam-me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390731,
					"content": "Você quer dizer 180 graus, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Bem, chegamos até aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Exatamente! Do que adiantaria tudo isso se desistíssemos no meio? Não é que Paimon não esteja preocupada nem nada, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Não se preocupe, Slimes Pyro são fracos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "Não, nada a ver! É só que você é forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Hmmm. Espera... você disse \"Slimes Pyro\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390713,
					"content": "Oh! É verdade... A gente só viu um monte de caranguejos gigantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Caranguejos? Sim, é normal ver caranguejos próximo à costa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Mas você não estava normal agora há pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Mas a sensação de queimação foi bem real. Eu conseguia até sentir as ondas de calor vindo deles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Entendi... hmmm, efeitos alucinógenos... Certo, vou anotar aqui. Bem, pelo menos não foi completamente ineficaz, mas... *suspira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390718,
					"content": "De qualquer forma, é ótimo que você esteja bem! É só que... desculpe, a poção não funcionou de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390719,
					"content": "#Está tudo bem! Enfim... mesmo que tenha um cheiro terrível, pelo menos foi quase um sucesso. Viu, {NICKNAME} ficou completamente bem depois de beber aquilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
