			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "Aqui! Esta é minha oficina, onde conduzo meus experimentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390802,
					"content": "Ok, agora para o próximo experimento, vamos testar a Poção Visão-Real! Tudo pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390803,
					"content": "#Estou pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "Ohh... Tenha cuidado, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390805,
					"content": "Você pega a poção de Verenata e o odor rançoso das massas de Ervas Marinhas mortas deixadas para apodrecer sob o sol tropical ataca suas narinas, fazendo você quase vomitar involuntariamente...\\nVocê hesita por um momento, e então toma tudo em um único gole. O sabor da poção em si não é tão terrível. Na verdade, ela não tem nenhum gosto distinto...\\nContudo, seu corpo não reage de forma alguma.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "Depois, você descansa por um tempo como ela instruiu. É quase como se absolutamente nada tivesse mudado.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "Mas não muito tempo depois...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "Parece que nada mudou... Ufa, Paimon pode parar de se preocupar agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390809,
					"content": "#Sim, mas... {NICKNAME}, você parecia estar atordoad{M#o}{F#a} por um momento. O que houve? Você viu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390810,
					"content": "Eu vi... metade de um barco transparente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "Sério? Fascinante! Mas... hmm... você pode dar uma descrição mais detalhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390812,
					"content": "Estava longe demais, eu não consegui ver direito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#Que interessante, interessante mesmo!... Mas não serve como prova concreta dos efeitos da poção... Por que {NICKNAME} não pode provar que não confundiu algum arrecife ou naufrágio com um \"navio fantasma\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390814,
					"content": "Então... *Suspiro* Os resultados desse experimento são inconclusivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390818,
					"content": "Obrigada, eu coletei muitas notas incríveis dessa vez! Eu definitivamente conseguirei usá-las para o próximo lote de poções!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390819,
					"content": "Hmm... \"Embora eu tenha ouvido algo muito familiar...\" Sim, \"Mas ainda há tanto a se observar, e ver se outros podem enxergar o mesmo fenômeno\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390820,
					"content": "Hã? Isso quer dizer que você ainda precisa encontrar outras pessoas para ajudar a testar as suas poções?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390821,
					"content": "Sim, está correto. Porque... hmm... devo ter duas ou mais testemunhas confiáveis que vejam a mesma coisa para provar que a poção pode mesmo permitir que as pessoas vejam a \"verdade\", certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390822,
					"content": "Porque a \"verdade\" não será limitada ou restrita pelos olhos e perspectivas de quem vê, e não será distorcida pelo que há em seus corações... mas ela existe lá objetivamente, e apenas é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390823,
					"content": "Hmm... tipo... tipo deuses que vivem por milhares de anos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390824,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390825,
					"content": "Não. Como aquela areia branca, como os ossos das estrelas-do-mar, como ondas quebrando... essas são a \"verdade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390826,
					"content": "Mas a Mestre das Poções disse que... \"verdade\" também pode ser criada através de sonhos e memórias. Eu não consigo entender, me parece uma contradição... mas estou me esforçando ao máximo para entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390827,
					"content": "Uau... O assunto ficou profundo tão rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390828,
					"content": "Haha, então não vamos falar de coisas assim! Enfim, eu quero agradecer vocês pela ajuda! Por favor, aceitem isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390829,
					"content": "Hmm... E também, não deixem de voltar da próxima vez que eu fizer uma nova poção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390815,
					"content": "Parecia que tinha sido partido ao meio por alguma coisa gigante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390817,
					"content": "Ah! Perdão! Eu... devo ter me distraído por um segundo. Mas... mas eu já escrevi tudo aqui, muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "Verenata"
				}
			]
		},
