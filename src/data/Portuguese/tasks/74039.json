			"dialogs": [
				{
					"id": 740390601,
					"content": "Então... você derrotou aquelas criaturas tão facilmente por causa da Poção Superpoderosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "Isso mesmo! Poção Superpoderosa, dá poderes e é gostosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "Que slogan publicitário de meia tigela é esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Ah, obrigada, obrigada! Então a poção funcionou mesmo... Bem, como era de se esperar de uma receita da Mestre das Poções!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390609,
					"content": "Pois bem. Agora, vamos encerrar os testes da Poção Superpoderosa, e em seguida, vamos testar essa Poção Aconchegante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390610,
					"content": "Você, hã... Foi você mesmo quem inventou esses nomes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "Não, não sou boa em inventar nomes, então eu apenas deixo os outros me ajudarem a criar nomes melhores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390612,
					"content": "Bem, não diga isso... sério, é melhor que o nome de uma poção diga logo de cara o que ela faz. Não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Hmm. Nunca ouvi isso antes... mas você tem razão! É assim que uma Mestre das Poções deveria ser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390614,
					"content": "#*Cof* E-Enfim, você está pront{M#o}{F#a} para testar essa poção, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390615,
					"content": "Claro, vamos começar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Minha nossa, o cheiro dessa daqui também é inacreditável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "#Em teoria, a Poção Aconchegante vai te poupar dos efeitos do frio e te deixar quentinh{M#o}{F#a}! Bem, em teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390618,
					"content": "Você pega a poção de Verenata. Tem cheiro de couro velho empoeirado e mofado...\\nVocê hesita por um momento antes de beber tudo de uma vez. O gosto não é ruim, sendo meio apimentado com toques de canela e gengibre... te faz lembrar de uma fogueira incandescente em um dia chuvoso.\\nPorém, por outro lado, o seu corpo não tem reação nenhuma.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Depois, sob as instruções dela, você descansa um pouco.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Não senti nada especial, mas era bem doce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Ué? Mas tinha um cheiro horrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Ehm... é mesmo? Será que fiz algo errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390608,
					"content": "Não se desanime. Pelo menos não era venenosa — podemos considerar isso como uma vitória, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403907,
