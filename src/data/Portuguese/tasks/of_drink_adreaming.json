			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020301,
					"content": "Hmm, você aprende rápido, isso tem um gosto muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020302,
					"content": "Paimon concorda, tem um gosto ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020303,
					"content": "Mas, isso foi apenas um treinamento. Durante o trabalho, os clientes terão todos os tipos de pedidos especiais para suas bebidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020304,
					"content": "Alguns podem gostar de bebidas mais fortes, enquanto outros preferem algo mais azedo, todos tem sua preferência. Ajustar a quantia dos ingredientes é sempre a chave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020305,
					"content": "Paimon quer uma Pinha de Caramelo, extra doce e no maior copo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020306,
					"content": "#Bem, isso é tudo. Mas, para se tornar {M#um}{F#uma} bartender excepcional, além de habilidade em misturar, você também precisará dominar a arte de conversar com os clientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020307,
						705020308
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020307,
					"content": "#Estou dispost{M#o}{F#a} ao desafio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				},
				{
					"id": 705020309,
					"content": "Muito bem, neste caso, vocês podem ficar com o balcão. Se vocês tiverem perguntas ou precisarem de ajuda, é só me chamarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020310,
					"content": "Ufa... Acabou a aula! Espera, onde está a Pinha de Caramelo da Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020311,
					"content": "Então você realmente queria uma Pinha de Caramelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705020308,
					"content": "Adoro conversar com as pessoas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020309
					]
				}
			]
		},
