			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020101,
					"content": "#Olá! Você deve ser {F#a}{M#o} renomad{F#a}{M#o} Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020102,
						705020103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020102,
					"content": "Sim, sou eu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				},
				{
					"id": 705020104,
					"content": "Ei, não se esqueça da renomada Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020105,
					"content": "Haha, claro. Bem, ultimamente, a Presentes dos Anjos está realizando uma Semana de Treinamento de Bartender. Pensei que o evento poderia lhe interessar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020106
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020106,
					"content": "Basicamente, você terá acesso a todos os nossos ingredientes para misturar coquetéis e outras bebidas que desejar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020107
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020107,
					"content": "E desde que você não desperdice os ingredientes, pode desfrutar de refis ilimitados para as bebidas que criar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020108
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020108,
					"content": "Refis ilimitados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020109,
					"content": "#Além disso, você também será recompensad{F#a}{M#o} pelos convidados caso eles gostem de suas bebidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020110
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020110,
					"content": "O quê?! Recompensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020111,
					"content": "Bem, Paimon já está convencida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020112
					]
				},
				{
					"id": 705020112,
					"content": "Nós queremos participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020113,
					"content": "Bem, apesar de se chamar \"Semana de Treinamento\", a participação não é obrigatória...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020114
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020114,
					"content": "E você não precisa decidir isso agora. Pode ficar à vontade para tentar primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020115
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020115,
					"content": "E então? O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705020103,
					"content": "Posso lhe ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020104
					]
				}
			]
		},
		{
			"id": 7050202,
			"completionStepIds": [
				7050203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050203",
							"2"
						],
						"stepId": 7050203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705020201,
					"content": "Ei, eu conheço vocês. O que querem beber hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020202
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020202,
					"content": "Olá, Charles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020203
					]
				},
				{
					"id": 705020203,
					"content": "Ei, Charles! Na verdade, viemos ser bartenders hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020204,
					"content": "Bartenders? Oh, então o Luka recrutou vocês? Ele é muito bom nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020205
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020205,
					"content": "#{NICKNAME}, você certamente é talentos{M#o}{F#a} em lidar com tarefas difíceis, não tenho dúvidas disso. Mas misturar coquetéis é algo totalmente diferente, é um trabalho delicado e requer um certo grau de refinamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020206
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020206,
					"content": "Tudo desde a quantidade de seus ingredientes até sua técnica de mistura pode afetar o produto final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020207
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020207,
					"content": "#Não se preocupe. {F#Ela}{M#Ele} é {F#uma}{M#um} cozinheir{F#a}{M#o} fantástic{F#a}{M#o}. Culinária e coquetelaria possuem muito em comum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705020208,
					"content": "Muito bem, vou acreditar em você. Oh, e mais uma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020209
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020209,
					"content": "Em um evento passado, tivemos um estudante que misturou de qualquer jeito três diferentes tipos de licores pesados. Apenas um copo é suficiente para deixar um cliente desmaiado no chão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020210
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020210,
					"content": "Então, por conta deste incidente, decidimos não mais permitir novatos de usarem álcool. Espero que entenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705020211
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 705020211,
					"content": "Sem problema algum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705020212
					]
				},
				{
					"id": 705020212,
					"content": "Ótimo, então isso é tudo que tenho a dizer. Você irá aprender as habilidades e técnicas que precisa na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 7050203,
			"completionStepIds": [
				7050205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
