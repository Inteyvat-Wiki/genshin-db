					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Isso deve servir... Espero que esses materiais sejam úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Você tá organizando arquivos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "#Oh! Prazer em te conhecer, Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Correto! Estou continuando a organizar os arquivos conforme as instruções do Monsieur Raimondo... Espera, eu já não disse isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Mas esse lugar é gigante! É trabalho demais para uma pessoa. Por que Raimondo não atribuiu mais alguém para te ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "O Instituto de Pesquisas tem muitas questões urgentes para lidar. É normal não ter ninguém disponível para me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "E você é uma Diretora também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Você fala do meu título como Diretora do Projeto de Recuperação de Materiais do Instituto de Pesquisas de Fontaine? *Suspiro* Por favor, não zombe de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "Em que sentido eu sou realmente uma Diretora? Desde o início, eu não fui nada além de uma funcionária comum responsável por organizar arquivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Após o Monsieur Raimondo me alocar aqui para organizar os arquivos, fui informada de meu novo título repentinamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Alguém disse que essa ideia era do Monsieur Choiseul. Aparentemente, ele acha que já que nosso trabalho é tão oneroso, isso facilita fornecer compensações adicionais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ah! Não diga isso a ninguém, como eu pude... como pude dizer algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "#Sou do tipo calad{M#ão}{F#ona}, relaxe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Isso parece uma virtude! E afinal, nada mais justo que quem faça todo o trabalho receba um pouco mais de compensação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Mas por que usar um método tão enrolado? Eles só não podem dar mais Mora a todo mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "É muito normal aqui no Instituto de Pesquisas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "*Suspiro* Eu nunca consigo entender o que os Messieurs Choiseul e Raimondo estão pensando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Mas tenho que continuar trabalhando, não importa o quê! Sempre tem muito o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "#Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}, se estiver dispost{M#o}{F#a}, poderia me dar uma mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "É meu dever.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Nesse caso, por favor, me ajude a tirar um pouco da sujeira aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Enquanto você limpar, garanta que <color=#00E1FFFF>não vai tocar nos livros e arquivos próximos</color>. Seria péssimo se fossem danificados enquanto você limpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Eu deixarei isso com você! Quanto a mim, vou continuar organizado os arquivos aqui. *Suspiro* Eu nunca percebi que havia tantos arquivos no Instituto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "#Não esqueça de fazer o \"honorári{M#o}{F#a}\" no meu título ainda mais honroso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Hahaha, sem problema! Eu testemunharei sua gentileza em minhas contribuições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "No mínimo, contanto que você receba mesmo o dinheiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
