			"dialogs": [
				{
					"id": 240160301,
					"content": "Ufa... Obrigada pela ajuda. Se não fosse por vocês, quem sabe quanto tempo teria me levado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "#Por isso que você é {M#o}{F#a} Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}. Não importa o que faça, faz bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "#Sempre fui um pouco extraordinári{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "#Devo agradecer novamente pela sua ajuda, Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}. Por favor, aceito isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Tenho um pouco de experiência no departamento de limpeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "#Hã? Então você é verdadeiramente multitalentos{M#o}{F#a}, eminentemente dign{M#o}{F#a} do título de Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
