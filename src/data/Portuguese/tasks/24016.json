			"dialogs": [
				{
					"id": 240160401,
					"content": "Ufa... Obrigada pela ajuda. Se não fosse por vocês, quem sabe quanto tempo teria me levado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Apesar de que se você tivesse sido um pouco mais gentil com a limpeza, teria sido ainda melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Desculpe por isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Não me entenda mal! Não estou te culpando, você me fez um favorzão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "#Isso é para você. Obrigada pela ajuda, Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "Vou com mais cuidado na próxima vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
