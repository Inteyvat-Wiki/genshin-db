				"objectNames": [
					"Tang Wen",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah... Estou com muita fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Não sei o porquê, mas estou sem força...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Tudo aconteceu depois que comi sua comida ontem à noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Apesar do sabor ter ficado um pouco estranho, deu para encher o estômago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Quando estava prestes a ir pra cama para dar uma boa descansada, acabei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Acabei sentindo uma forte vontade de vomitar... E, por causa disso, não consegui dormir por nem um minuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Fiquei meio acordada e meio adormecida a noite inteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Se for apenas uma questão de falta de sono, não é um grande problema, pois às vezes também não dormi o suficiente por causa do trabalho extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "Mas, olha, achava que poderia me recuperar hoje, contudo acabei tendo a mesma sensação de quando eu como... E ainda estou sentindo o cheiro do prato em toda a minha boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "O cheiro desse prato é tão forte assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "Ei... Não importa. Agora parece que apenas uma comida com sabor único pode substituir esse cheiro tão estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Comida com sabor único? Que tal perguntarmos às outras pessoas quais são comidas com sabor único?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "A gente faz um prato desses e acaba com esse problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Mesmo? Ótimo, muito obrigada! Se for conveniente para vocês, por favor, vão até Ritou e perguntem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Eu me lembro de que o mercador Li Xiao, de Ritou, é uma especialista de gastronomia, bem como a Qiuyue, da Companhia de Comércio Chuyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
