			"dialogs": [
				{
					"id": 220250401,
					"content": "Oh não, obtivemos respostas diferentes. Mas Guoba de Jueyun e Sopa de Bambu são dois pratos especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250402,
					"content": "O que deveríamos fazer? Paimon está tão dividida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250403,
					"content": "Paimon, o que você acha que devemos fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "Hã? Eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250405,
					"content": "Bem... Se você deixa Paimon escolher... Se deixa Paimon escolher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250406,
					"content": "Paimon escolhe Peixe Tigre Frito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250407,
					"content": "O nome Peixe Tigre Frito soa muito corajoso. Se Tang Wen comer um prato corajoso como esse, com certeza poderá resolver seus problemas facilmente, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250408,
					"content": "Paimon, você é uma especialista em comidas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "Ai ai, então você que decida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250411,
					"content": "Bem... Um delicioso Guoba de Jueyun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250414,
					"content": "Certo, vamos então fazer esse prato logo e levar ele para Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250412,
					"content": "Bem... Uma deliciosa Sopa de Bambu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250413,
					"content": "Bem... Um delicioso Peixe Tigre Frito então!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
				{
					"id": 220250409,
					"content": "Peixe Tigre não é exatamente isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				}
			]
