			"dialogs": [
				{
					"id": 220250301,
					"content": "Hã? *Suspiro* Tang Wen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250307
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250307,
					"content": "Um sabor estranho em sua boca, perda de apetite, não quer comer nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250302
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250302,
					"content": "#Será que realmente é porque ela comeu algo estranho? Você não está errad{F#a}{M#o}, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250303
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250303,
					"content": "Por que está parecendo que ela apenas comeu muito? Hum, deixa eu pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250304
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250304,
					"content": "Deixe para lá. Como não tem um jeito de confirmar, tem apenas um prato que eu posso recomendar, e o prato é Sopa de Bambu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250305
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250305,
					"content": "O sabor é muito bom, a carne é tenra, e o aroma é fresco e convidativo. O mais importante é que a sopa ajuda a digestão. Humm! Gostaria de comer um pouco agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250306
					],
					"speakerTitle": "Qiuyue"
				},
				{
					"id": 220250306,
					"content": "Acredite em mim, tudo o que Tang Wen precisa agora é de uma Sopa de Bambu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiuyue"
				}
			]
		},
		{
