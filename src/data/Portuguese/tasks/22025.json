			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Xiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "O quê? Ah... Você está falando de Tang Wen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "Perda de apetite... Um sabor estranho na boca... Precisa de uma iguaria especial para salvar essa situação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Encontrou uma dificuldade como essa repentinamente... Realmente é um tanto problemático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Mas, na minha opinião, não precisa ser um prato muito caro. Desde que o sabor seja único e tenha um forte impacto, é suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Por isso, minha sugestão é Guoba de Jueyun! Não só tem uma textura crocante, como também um sabor picante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Já passaram mais de dez anos desde que eu provei Guoba de Jueyun na Vila Qingce, e eu ainda penso nesse prato às vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Eu penso que se for Guoba de Jueyun, ela irá resolver qualquer que seja o problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
		},
		{
			"id": 2202503,
