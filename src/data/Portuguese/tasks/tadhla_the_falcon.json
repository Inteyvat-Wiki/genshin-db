			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "Ah, meu Falcão retornou! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790702,
					"content": "#Eu sinto muito... Eu caí numa emboscada. Foi graças ao resgate {F#delas}{M#deles} que pude retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790703,
					"content": "#{F#Delas}{M#Deles}...? Oh, são {F#minhas}{M#meus} estimad{F#as}{M#os} Mestres das Jinni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790704,
					"content": "Eu sinto muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790705,
					"content": "Não há o que se desculpar! Tadhla ficou ferida, você não vai ajudá-la a se recuperar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790707,
					"content": "... Você se feriu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790708,
					"content": "... Me perdoe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790709,
					"content": "Que animal fez isso com você? Ou foi uma pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790710,
					"content": "Foi uma pessoa do norte. Era uma emboscada deles... Eles descobriram que estavam sendo seguidos e prepararam uma armadilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790711,
					"content": "E essa armadilha era destinada a você, correto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790712,
					"content": "Ser mordida desse jeito por uma presa... Diga-me, como isso é possível para um Falcão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790714,
					"content": "... Vá descansar, você precisa. Eu cuidarei de seus ferimentos em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790715,
					"content": "Tadhla balançou sua cabeça em silêncio, indo embora a passos lentos com a dor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Ei, Masseira, você foi muito duro com Tadhla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790717,
					"content": "Vocês não têm uma boa relação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "Hã? Não! Pelos deuses, como isso seria possível? Ela é o Falcão predileto... Eu a amo, mas não posso mimá-la. Se um Falcão não traz de volta uma presa, como ficará de estômago cheio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790719,
					"content": "Ah, já sei o que está acontecendo... Hunf, aquela garota não vai acabar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790723,
					"content": "#Aqui está sua recompensa. Muito obrigado, estimad{F#a}{M#o} Mestre das Jinni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790724,
					"content": "Ahem! Você não está esquecendo de alguma coisa? Há mais duas pessoas aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790725,
					"content": "Hehe, Paimon duvida que nós duas somos qualificamos para aceitar a recompensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790726,
					"content": "Oh, eu esqueci que essa fadinha não é uma pessoa. Ainda assim, acho que merecemos seu agradecimento também, não concorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790727,
					"content": "EI!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790728,
					"content": "Haha, está bem, eu sinto muito. Aqui está a sua recompensa extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790729,
					"content": "Recompensa extra?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790730,
					"content": "#... Não é muita coisa, mas já que {F#minha}{M#meu} mestre não se manifestou contra, tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790731,
					"content": "Ótimo. Ah, espero que quando vocês tiverem tempo, possam vir novamente... Acho que meu Falcão precisará de sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790720,
					"content": "Não seja muito duro com Tadhla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "Duro? Eu sou muito leve com ela. As habilidades dela deixaram a desejar... Eu só estou a ensinando que ela é um Falcão fantástico, como eu teria a audácia de machucá-la?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790722,
					"content": "Onde será que essa conversa de Falcão vai parar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				}
			]
		}
	]
