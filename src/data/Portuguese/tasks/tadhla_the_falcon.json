			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790602,
					"content": "Uh, oi! Você é Tadhla? Nós viemos te salvar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790603,
					"content": "Hã...? Sim, sou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790604,
					"content": "Você deixou eles fugirem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790605,
					"content": "Eles não são uma ameaça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "... Eles retornarão e contarão para outras pessoas. Vão saber que estamos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790608,
					"content": "Vejam só, parece que pessoas inteligentes pensam da mesma forma. Gostei dessa garota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790609,
					"content": "Isso não é importante! Eles vão voltar, e nós vamos colocar eles para correr de novo! Ei, você está ferida! Precisa de ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790610,
					"content": "Estou bem. Vamos. Ainda tenho como encontrar um lugar para morrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790611,
					"content": "Ufa, ela está bem, ainda tem como encontrar um lugar para... EI! NÃO! Isso é horrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790612,
					"content": "Só estou brincando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790613,
					"content": "Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790614,
					"content": "Gostei do senso de humor dessa garota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790615,
					"content": "Obrigada, vamos retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790616,
					"content": "Como estão suas pernas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "Não estão bem, mas não preciso de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790618,
					"content": "Você não vai descansar um pouco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "Descansar...? Não, ainda não estou à vontade com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790620,
					"content": "Mas eu acho que poderíamos aproveitar essa chance para nos conhecermos melhor, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790621,
					"content": "Obrigada, mas não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790606,
					"content": "Eu não precisava fazer um massacre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
