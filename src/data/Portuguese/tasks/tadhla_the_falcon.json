			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME}, {F#minha}{M#meu} estimad{F#a}{M#o} Mestre das Jinni. A que devo a honra? Seu desejo é uma ordem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Argh, esse lacaio do deserto. Ei, {F#a}{M#o} {F#minha}{M#meu} Mestre... *Suspiro* Quer saber, não importa. Você tem sua própria opinião, e eu confio nela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "Desconheço se você poderia agraciar-me com a honra de seu tempo livre, pois eu aguardo por sua chegada como aguardo a de uma lua brilhante ou do orvalho da chuva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Quantas palavras doces... Você com certeza está com segundas intenções. Vamos, desembuche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "Está bem, Mestre das Jinni, eu tenho algo que gostaria de lhe pedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Haha, não é nada de mais... É o meu Falcão, Tadhla, ela deve ter encontrado algo perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "*Suspiro* Se não fosse por causa de minhas pernas, eu não estaria aqui lhe incomodando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Oh, Paimon entendeu, você quer que a gente salve-a, depois você vai nos agradecer e dar um monte de Mora, e então a gente vai comer um montão para comemorar que tudo deu certo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Sim, sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Bem, já que é isso, pode contar com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Toda vez que algo assim acontece eu já sei onde vamos parar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "*Suspiro* Está bem, vamos fazer isso então. Mas só para essa faminta da Paimon comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "Muitíssimo obrigado... Estou contando com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Esse foi o último lugar que ela esteve, venham, vou marcar no mapa para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "A pessoa que vocês devem procurar, Tadhla... Ela é muito alta, sua pele é escura, tem cabelos longos claros e carrega um arco. Acho que isso deve ser suficiente, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "Conseguiram lembrar bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Sim, ela é alta, tem pele escura, cabelos longos claros e usa um arco! Hehe, Paimon lembrou de tudinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "Que os ventos lhe ajudem a cruzar as areias douradas e evitar os perigos pela frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Certo, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
