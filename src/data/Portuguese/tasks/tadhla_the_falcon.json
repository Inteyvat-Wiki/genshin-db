			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar",
					"Soldados dos Fatui A",
					"Soldados dos Fatui B",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "Ei! Veja! Tem alguém ali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "Hã, mestre... essas pessoas são os 'Fátuos' que vocês mencionaram antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790403,
					"content": "É Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "Tem diferença?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790405,
					"content": "Fale mais baixo! Eles não podem descobrir a gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Não tem problema, eles não conseguem nos ouvir. Se vocês não acreditam em mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790407,
					"content": "Ei! Grandalhão! Eu estou aqui! Vamos, cadê a comida?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790408,
					"content": "Hã? Você escutou alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Soldados dos Fatui A"
				},
				{
					"id": 732790409,
					"content": "Hã? Não, por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Soldados dos Fatui B"
				},
				{
					"id": 732790410,
					"content": "Uh, nada, eu só acho que é hora de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Soldados dos Fatui A"
				},
				{
					"id": 732790411,
					"content": "Hehe, viram só?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790412,
					"content": "Oh, Paimon não esperava que você também soubesse fazer essas brincadeiras de criança, Liloupar! Hehe, é muito fofa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "Ei, olhem ali! Aquela pessoa presa é Tadhla?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Hã, Paimon se lembra bem... Alta, pele escura e cabelos longos claros... Deve ser ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "#Que memória boa, Paimon. Vamos, {F#minha}{M#meu} mestre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790416,
					"content": "#Sim, {NICKNAME}, é hora de descermos a mão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327906,
			"completionStepIds": [
				7327906
