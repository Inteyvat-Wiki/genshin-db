			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "Ah, você voltou. Você é uma estrela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010202,
					"content": "Eu simplesmente não posso evitar o fato de que quanto mais histórias eu contar, mais coisas eu esqueço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010203,
					"content": "Então, você perguntou a eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mestre do Chá Liu Su"
				}
			]
		},
