			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "Oh, você ainda está aqui! Haha, então, o que você achou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010402,
					"content": "E o que acontece depois?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "\"Chuva de Lâmina\" e \"O Ódio de Haishan\" são grandes obras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010404,
					"content": "Não vou passar as próximas horas contando o resto das histórias. Se você estiver interessado, venha para as sessões no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010407,
					"content": "Obrigado por sua ajuda hoje. Aqui, pegue isso, talvez próxima vez eu volte a precisar da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010405,
					"content": "Eu pensei que você tinha dito que \"tudo seria revelado no próximo capítulo...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "Haha, se você quiser ouvir a próxima parte, terá que vir com mais frequência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				}
			]
		},
