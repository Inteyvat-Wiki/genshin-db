			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mestre do Chá Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Droga, me esqueci onde tinha parado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010102,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Ah, olá! Você está aqui para a ouvir mais histórias ou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010104,
					"content": "Eu? Eu estou contando histórias, para ganhar um dinheiro extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010105,
					"content": "O problema é que, eu conto tantas histórias que acabo me confundindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010106,
					"content": "Alguns dias atrás, alguns clientes queriam ouvir \"O Ódio de Haishan\" da Frota Crux, e outros queriam ouvir \"Chuva de Lâmina\", não pode culpá-los, é da escola de Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010107,
					"content": "Eu tenho que ganhar a vida agora. Então, escolhi a parte que me lembrava melhor de cada história para manter todos felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010108,
					"content": "Foi um sucesso inesperado... Eles adoraram tanto que continuam me incomodando para contar o resto da história!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010109,
					"content": "Como eu não tinha lido nenhum desses livros há anos, eu procurei por um tempo e finalmente consegui encontrá-los. Eu dei uma olhada para refrescar minha memória e agora estou quase pronto para continuar com a história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010110,
					"content": "Mas não me lembro de onde eu parei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010111,
					"content": "Você pode ir perguntar a eles onde eu parei na última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010112,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Sei que não foi fácil, mas se eu tivesse ido perguntar por mim mesmo, acabaria com a minha reputação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010118,
					"content": "Eu já pensei sobre isso, e tem três pessoas que você pode perguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010119,
					"content": "O primeiro é o <color=#00E1FFFF>Burguês Maocai</color>, que não perdeu nenhuma sessão. O segundo é o <color=#00E1FFFF>Fan Er'ye</color>, que é o dono desta casa de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010120,
					"content": "A terceira é a senhora <color=#00E1FFFF>Jiangzhou</color>. Eu a vi na última sessão, mas ela só ficou por um pouco tempo, e foi embora cedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010114,
					"content": "Você podia começar do princípio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "Eu pensei nisso! Mas não posso cobrar duas vezes para contar o mesmo conteúdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010116,
					"content": "Mas eu creio que o Fan Er'ye não vai me deixar sair com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				},
				{
					"id": 223010117,
					"content": "Posso pedir um favor de você ir perguntar? Depois me diga, e vou me preparar para continuar as histórias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Mestre do Chá Liu Su"
				}
			]
		},
		{
