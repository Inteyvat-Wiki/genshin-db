			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "Outro dia, outro balde vazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210402,
					"content": "O que você tá fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "Pescando. Mas até agora só pesquei coisas que não são peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210404,
					"content": "Se fossem bugigangas de naufrágios, tudo bem, porque comerciantes compram essas coisas. Eu já pesquei uma bota com meia... *Suspiro* Esqueça. Falar de coisas assim vai afugentar os peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210405,
					"content": "Tem algo interessante por perto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "Caçando tesouro de novo, né? Aquele \"Grande Tesouro\" que dizem ficar ao leste da lua e oeste do sol... Não precisa de muito pra saber que aqui não é o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210407,
					"content": "Tiveram uns naufrágios nessas águas. Talvez tenha tesouro lá embaixo, mas não é fácil de pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210408,
					"content": "Ouvi falar isso na taverna também. Um dos marinheiros sobreviventes disse que não tinha lua naquela noite, mas tinha uma coisa brilhando lá nas ondas gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210409,
					"content": "Dizem que tinha que ser o Kratti caolho, um monstro que podia devorar até a lua. Estava lutando contra a serpente marinha gigante por território.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210410,
					"content": "Por muito tempos após isso, essa pedaço inteiro ficou escuro como uma garrafa de tinta. Nenhum navio ousava passar por aqui. Todos temiam que as almas perdidas sob as ondas arrastassem eles pro fundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210411,
					"content": "Se aquelas almas ainda permanecem aqui... quem sabe. Eu mesmo não consigo as ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210412,
					"content": "Sobre aquela árvore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "Aquela coisa é bem sinistra. Costumava ter um redemoinho aqui e os marinheiros chamavam ele de Olho de Kratti. Então, um dia, essa árvore só começou a crescer dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210414,
					"content": "Mesmo assim, essa não foi a única coisa estranha que aconteceu naquela época. Pensando nisso, tudo começou depois que aquelas rochas caíram do céu... Talvez essa árvore seja o mesmo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210415,
					"content": "E tem também aquelas coisas brilhantes que você vê de vez em quando. Aquilo é raro de verdade. Eu pensei que devia ter novos tipos de peixes também. Por isso vim para cá tentar a sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210416,
					"content": "Eu costumava ter um parceiro de pesca, mas ele ficou dizendo que ouviu um canto estranho. Assustou ele tanto que ele nunca voltou. Hah, só metade de um Filho da Lua Gelada, mas herdou o rebuliço completo deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210417,
					"content": "Sobre a Prova do Cognoscente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "Prova do Cognoscente, \"Grande Tesouro\" que fica ao leste da lua e oeste do sol... se me perguntar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210419,
					"content": "Pessoas que vão atrás do que não é deles por ganância raramente têm um final feliz. Atlas, por exemplo. Soube que Capitão Grettil foi enfeitiçado por toda essa conversa de tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210420,
					"content": "No fim, ele acabou no fundo do mar. E o tesouro? Não ficou enterrado com ele. Todo aquele trabalho pra nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210421,
					"content": "Desculpe pelo incômodo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "Sem problema. Não tem um único peixe à vista mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}