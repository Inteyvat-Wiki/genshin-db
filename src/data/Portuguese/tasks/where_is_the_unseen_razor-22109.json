			"dialogs": [
				{
					"id": 221090201,
					"content": "Então, já eliminou tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090202,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "Isso é porque você está se preparando meticulosamente ou porque está procrastinando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090204,
					"content": "Ou... ambos dois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
