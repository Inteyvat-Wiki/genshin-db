					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "Ainda não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "São vocês de novo! Parece que as missões da Guilda estão cada vez mais fáceis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "Se tiverem interesse, eu tenho uma outra missão, mas é uma missão pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "Muitos Hilichurls Atiradores estão reunidos num lugar das Planícies de Guili, que se tornou em uma ameaça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Eles podem apenas ser Hilichurls, mas estão em grande número. Os Aventureiros comuns não saberão como lidar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "Preciso que você os elimine de forma rápida e eficiente. Depois, haverá uma ampla compensação esperando por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Além disso - se você encontrar algo relacionado a uma espada, qualquer coisa, por favor, traga-a de volta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "Não sei dizer se sua ânsia de aceitar isso é por causa de ingenuidade ou da coragem sem limites...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "Antes de tudo, eu tenho que dizer que você tem um espírito de aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Isso é tudo o que tenho a dizer. Está na hora de você se preparar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "O que a espada significa para os Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Não tem problema, basta prestar um pouco de atenção. Se encontrar algo, traga de volta, se não encontrar nada, também não tem problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "O objetivo desta Missão é derrotar os Hilichurls. Derrote-os e você receberá sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
