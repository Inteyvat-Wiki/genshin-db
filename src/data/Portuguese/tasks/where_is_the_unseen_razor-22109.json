			"dialogs": [
				{
					"id": 221090301,
					"content": "Então, já eliminou tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Bom trabalho. Espero que não tenham lhe causado muitos problemas... Não, não achei que eles seriam... só estava tentando ser educada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "Nada da espada ainda? *Suspiro* Surpresa, surpresa... Como esperava, de novo, de mãos vazias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "Obrigada, de qualquer forma. Aqui está a sua remuneração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "Por que você está tão preocupada com essa espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "Penso que é seguro de te dizer. Essa espada chamada Lâmina Oculta, é a espada do meu irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "Mas inexplicavelmente, não foi encontrada consigo quando morreu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Ele sempre tinha essa espada com ele. Deve ter ocorrido alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Infelizmente, nunca encontrei uma única pista sólida sobre onde a espada poderia estar ou o que ele encontrou antes de morrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "É isso mesmo. Não há mais nada a dizer. Exceto tenha um bom dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
