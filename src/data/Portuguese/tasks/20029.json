			"dialogs": [
				{
					"id": 200290801,
					"content": "Lily, não fale com aquele Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Rudolph"
				},
				{
					"id": 200290802,
					"content": "Por que não? O titiu Fatoos e eu contamos muitas estórias um ao outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290803,
					"content": "Lily, Viktor lhe enviou este presente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Uau! Um prezente do titiu Fatoos? Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290805,
					"content": "Espere, por que aquele Fatui está mandando um presente para Lily? O que ele quer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolph"
				},
				{
					"id": 200290806,
					"content": "É purque eu dei muitas comidas para o tiu Fatoos! É por issu que ele me deu um prezente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, aquele Fatui não é uma boa pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolph"
				},
				{
					"id": 200290808,
					"content": "Mas aquele titiu me conta muitas estórias, ele é muito gentiu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290809,
					"content": "É um presente de despedida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Oh... Pur que o titiu Fatoos tem que ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "Uff, ótimo. É melhor que ele vá embora. Todos os dias ele fala com Lily, e isso me deixa preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolph"
				},
				{
					"id": 200290813,
					"content": "Papai, quero dizer adeus para o titiu Fatoos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "*Suspiro* Lily, você não deveria chegar muito perto daquele homem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolph"
				},
				{
					"id": 200290815,
					"content": "Mas por que? O titiu Fatoos... Ele tem sido muito legau comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "Ele sempre me conta estórias. Muitas estórias! Ele é muito legau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, ouça o papai. As coisas não são tão simples assim... *Suspiro* Quando você for mais velha papai lhe dirá a razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolph"
				},
				{
					"id": 200290810,
					"content": "Viktor está saindo de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
		},
