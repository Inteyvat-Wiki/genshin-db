			"dialogs": [
				{
					"id": 200290101,
					"content": "Bem, acho que posso finalmente voltar para casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290102,
					"content": "Você vai embora, Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "Hm? É você..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290104,
					"content": "Correto. Recebi ordens de meus superiores dizendo que posso voltar para Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290105,
					"content": "Parece que vou ser transferido para outro Mensageiro e não preciso mais ficar esperando em Mondstadt por novas ordens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290106,
					"content": "Não tenho ideia de qual o Mensageiro me convocou, mas estou apenas rezando para que não seja o Lorde Scaramouche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "Quando você vai embora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Os superiores não mencionaram quando. Disseram-me apenas para arrumar minhas coisas e estar pronto para ir a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "Quer dizer, isso são boas notícias, certo? Não terei mais que suportar aqueles olhares das freiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "Ah, certo, Viajante. Já trabalhamos juntos há muito tempo... Por que você não me faz um último favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Assim como antes, você me faz o favor e eu lhe dou o pagamento. Sabe que nunca lhe peço nada de graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "Que histórias você vai me contar desta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Haha. Para falar a verdade, estou sem histórias dos Fatui para lhe contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "O pagamento desta vez será Mora, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Bem, a menos que você queira que eu lhe conte os mesmos contos de fadas que conto a Lily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "Com o que você precisa de ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Sabe que mais? Vou lhe confessar. O pedido desta vez também tem algo a ver com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Ela é... bem, ela é a única pessoa em toda Mondstadt que está sempre disposta a ouvir este \"velho tio Fatui mau\" falar — além de você, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Duvido que retorne a Mondstadt novamente... Então, eu só queria dar um último presente para Lily como lembrança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Mas como você sabe, eu estaria em grande risco se simplesmente saísse por aí para comprar alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "Portanto, por favor, ajude-nos, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Vá até a loja de Marjorie e me ajude a ver se ela tem algum presente que Lily possa gostar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "Você ainda faz companhia a Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Hmm... Bem... Às vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Realmente tenho sempre muitas histórias sobre os Fatui para contar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
