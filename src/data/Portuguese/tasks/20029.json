			"dialogs": [
				{
					"id": 200290601,
					"content": "Viajante, conseguiu encontrar Schuster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290602,
					"content": "Sim, ele me pediu para lhe entregar esses Ganchos do Lobo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "Oh! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290604,
					"content": "Darei uma recompensa a Schuster quando ele retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290605,
					"content": "Ah, é verdade. Você estava procurando um presente para uma criança, certo? Espere um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290606,
					"content": "Marjorie começa a preparar o presente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "Já está! Este presente é para você. Obrigada por me trazer os Ganchos do Lobo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290608,
					"content": "As crianças adoram essas bonecas perfumadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
		{
			"id": 2002907,
