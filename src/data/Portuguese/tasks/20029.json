				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290701,
					"content": "E então? Você conseguiu comprar o presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290702,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "Uau! Você é incrível! Deixe eu ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290704,
					"content": "O que... é isto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290705,
					"content": "Uma boneca deformada com uma cor estranha... Mas, bem, tem um cheiro bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290706,
					"content": "Podemos mesmo presentear uma criança com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290707,
					"content": "Marjorie disse que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "Tudo bem, o que conta é a intenção. Agora, onde coloco esta carta? Oh! Vou colocá-la lá no fundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290711,
					"content": "Você escreveu uma carta para a Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Não é nada, apenas conversa fiada, não se preocupe com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290714,
					"content": "Aqui está o presente, ajude-me a entregá-lo a Lily. Ela deve estar <color=#00E1FFFF>perto da praça</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290715,
					"content": "Unf, se eu desse o presente a Lily diretamente, Rudolf definitivamente ficaria me encarando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290712,
					"content": "O que a carta diz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "Se você não gostou deste, sempre pode comprar um presente em Snezhnaya e enviá-lo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "Eu gostaria, mas se um Fatui como eu fizer uma remessa para Mondstadt, os assessores dos Cavaleiros de Favonius poderão impedir meu pacote de chegar a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "Viktor"
				}
			]
		},
