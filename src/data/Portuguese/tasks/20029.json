			"dialogs": [
				{
					"id": 200290201,
					"content": "Olá, Viajante. O que posso fazer para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290202,
					"content": "Você tem presentes adequados para crianças aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "Presentes adequados para crianças... Deixe eu ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290204,
					"content": "Hmm, na verdade, tenho tentado fabricar alguns brinquedos pequenos recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290205,
					"content": "O único problema é que eles precisam de muito corante de Gancho do Lobo, mas estou sem eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290206,
					"content": "Pedi a Schuster que me ajudasse a colher alguns, mas ele ainda não voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290207,
					"content": "Você poderia me ajudar a procurar Schuster, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290208,
					"content": "Assim que tivermos Ganchos do Lobo suficientes, poderei fazer um brinquedo desses para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290209,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "Ele disse que iria <color=#00E1FFFF>perto do Reino dos Lobos</color> para pegar Ganchos do Lobo. Você pode ir até lá para procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290212,
					"content": "Bem, conto com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290210,
					"content": "Para onde foi Schuster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
