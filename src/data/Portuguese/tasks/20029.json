			"trigger": {
				"objectNames": [
					"Schuster Assustado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "O-Obrigado, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290502,
					"content": "Por que esses monstros continuam me perseguindo, mesmo depois que eu corri todo o caminho até aqui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290503,
					"content": "Você veio para coletar Ganchos do Lobo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Eh? Sim, Marjorie me pediu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290505,
					"content": "Você não poderia ter trazido outra pessoa com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "Quem iria querer me acompanhar para coletar plantas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290508,
					"content": "Entendo o que você quer dizer, mas os Ganchos do Lobo apenas podem ser encontrados no Reino dos Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290509,
					"content": "E os Ganchos do Lobo que crescem em áreas mais seguras já foram todos colhidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290510,
					"content": "Se eu quiser pegar esses Ganchos do Lobo, tenho que me aventurar mais longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290511,
					"content": "Mas não vamos mais falar sobre isso, você poderia me ajudar levando estes Ganchos do Lobo para Marjorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290512,
					"content": "Preciso descansar, estou exausto de tanto caminhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 200290507,
					"content": "Você não deve ir até tão longe sozinho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
		{
