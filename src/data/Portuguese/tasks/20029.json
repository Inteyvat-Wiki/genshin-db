			"dialogs": [
				{
					"id": 200290401,
					"content": "Você conseguiu o presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290402,
					"content": "O que você fará quando se for?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "O que vou fazer? Bem... suponho que terei que esperar minhas ordens de transferência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290404,
					"content": "*suspiro* Se as coisas correrem mal, posso acabar sendo transferido para algum lugar abandonado pelo Arconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290405,
					"content": "Mas estou bem com qualquer coisa, desde que não me joguem para Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290406,
					"content": "Por que de repente tem de se mudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Por quê...? É por causa do... Bem... Do sacrifício de Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290408,
					"content": "Na verdade, quer saber uma coisa? Eu sou apenas um marceneiro. Eu escuto ordens. Não há necessidade de pensar muito sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290409,
					"content": "Onde está Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Eu ouvi Rudolf mencionar que ele iria levá-la para a praça ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290411,
					"content": "Unf, suponho que ele tenha que manter sua preciosa filha longe do malvado Fatui, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290412,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Tudo bem. Deixo o assunto do presente para você então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
