				},
				{
					"id": 200290904,
					"content": "Unf! Você não precisa me contar, eu sei. Ninguém confia em mim em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "Quando você vai embora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "A ordem oficial ainda não saiu. Acabei de arrumar minhas coisas e vou agora para o Grand Hotel Goth. Estou pronto para ir a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "#Por que você está me encarando tão séri{M#o}{F#a}? É sua maneira de dizer adeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "De jeito nenhum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Unf. Pois bem, não somos amigos, somos apenas parceiros, nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "Se você for a Snezhnaya, pode me encontrar. Podemos trabalhar juntos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Bem, chega de conversa, aqui está sua recompensa. Esta será nossa última troca de favores em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "*suspiro* Espero não ter tanto trabalho quando chegar lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
