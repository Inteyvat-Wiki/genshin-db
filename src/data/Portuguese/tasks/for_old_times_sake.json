			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avó Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "*Suspiro* Pequeno Chang, onde você está? Estou um pouco preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150102,
					"content": "Quem é o Pequeno Chang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "O Pequeno Chang é o apelido do Chang, o Nono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150104,
					"content": "*Suspiro* Já me acostumei a chamá-lo assim, seria estranho chamar Chang, o Nono agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Ontem à noite, ele disse que precisava sair para absorver mais inspirações para o romance dele, e não prestei muita atenção, só lhe pedi voltar cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Mas ele ainda não voltou, comecei a me preocupar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Mas é difícil para mim sair procurá-lo, já que sou muito velha. Posso pedir um favor que procuram por mim? Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150108,
					"content": "Não tem problema, fique descansada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Ótimo! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150110,
					"content": "Você sabe aonde ele foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "*Suspiro* Só podia ser na Colina de Wuwang no norte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Por favor, procure por mim! Já passou muito tempo, espero que tudo esteja bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
