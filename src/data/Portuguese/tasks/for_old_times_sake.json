			"dialogs": [
				{
					"id": 221150601,
					"content": "*Suspiro* Oh, Pequeno Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150602,
					"content": "Chang, o Nono já voltou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Oh, já o vi! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Ele sempre foi inconveniente desde pequeno... Ele diz que já cresceu, mas vai ser no dia de São Nunca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150605,
					"content": "Pronto, não se preocupem, é o negócio dele, ele faz segundo a sua vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150606,
					"content": "Obrigada por ter feito todo esse caminho para trazê-lo para casa. Por favor, aceite isto em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150607,
					"content": "Não vou me alongar muito, vocês devem ter seus próprios negócios. Espero que vocês não acabem como o Pequeno Chang, que perdeu a oportunidade de se refletir, e sempre vivia das opiniões dos outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150608,
					"content": "Infelizmente, os mortais não são Adepti... E o que é a vida mortal senão um curto sofrimento que vem antes da morte? Pobre de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				}
			]
		},
