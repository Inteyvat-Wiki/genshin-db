					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Hum! Estes monstros são muito incómodos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150202,
					"content": "Eu só fui para ter algumas inspirações, mas não imaginei que iria encontrar esses monstros, fora da minha expectativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150203,
					"content": "Muito obrigado. Não sei o que teria acontecido sem ajuda de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150204,
					"content": "A Avó Ruoxin estava preocupada com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Comigo? Era desperdício da energia. Eu sou capaz de me cuidar. Hum... Eu podia lidar com esse pequeno problema, só que cansa um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150206,
					"content": "Mas, muito obrigado por terem me aliviado, senão, tinha ficado aqui ainda por mais tempo. Agora pelo menos eu não vou escutar as divagações dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211505",
