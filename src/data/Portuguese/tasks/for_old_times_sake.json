			"dialogs": [
				{
					"id": 221150701,
					"content": "*Suspiro* Pequeno Chang, onde você está? Estou um pouco preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150702
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 221150702,
					"content": "O que ele faz aí na Colina de Wuwang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150703
					]
				},
				{
					"id": 221150703,
					"content": "Ele foi lá para absorver algumas inspirações para o romance. Ele diz que é mais fácil obter inspirações num lugar tranquilo.",
