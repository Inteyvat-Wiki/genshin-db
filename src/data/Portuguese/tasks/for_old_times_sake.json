			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "...E ele já foi embora, é só isso... Temos que ir também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150302,
					"content": "Er? O que é isso no chão? Foi o Chang, o Nono que perdeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150303,
					"content": "Vamos ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "*Suspiro* Eu quero escrever um bom romance, mas como?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150502,
					"content": "Foi você que os perdeu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Hmm! Sim, são meus. Mas não gostei do que escrevi, não era uma história que queria, então joguei no rio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150504,
					"content": "Não acredito que vocês foram pegá-los de novo... Já não dá mais para ler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150505,
					"content": "O que estava escrito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "É uma história para uma menina que eu gostava, mas estes esboços foram descartados, e já joguei fora. Vocês não fazem ideia... Quando éramos crianças, essa menina sempre me arrastava para lhe contar histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150507,
					"content": "Mas infelizmente, eu não tinha muito tempo, só acabei o início da história. E pensava que podia escrever o resto quando tivesse mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150508,
					"content": "Mas um dia, de repente, ela desapareceu, e não conseguiu encontrá-la em nenhum lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150509,
					"content": "Hum! É por causa da sua família, tenho certeza absoluta. Eles não gostaram de mim, e eram contra o nosso relacionamento. Eles estavam sempre à espera de uma oportunidade boa para mudar de casa quietamente da Vila Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150510,
					"content": "Bom, eles vão ver em breve! Quando eu deixar o meu nome marcado, eles ficarão impressionados! E daí, os meus livros venderão para todo o mundo quando eu acabar a história para ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150511,
					"content": "De tal forma, não importa onde estejam eles, eles vão ver um novo Chang, que está totalmente diferente do que o na infância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150512,
					"content": "E depois... Vou poder encontrar com ela de novo... Mas antes de tudo, eu tenho que acabar este livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221150513,
					"content": "... Desculpe, tantas divagações. Bom, é melhor eu continuar pensando como se melhora o meu livro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
