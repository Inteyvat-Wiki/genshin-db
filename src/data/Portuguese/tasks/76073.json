					"Netochka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "A comida de Katya é incrível... Novokichevgrad pode esperar um pouquinho mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034016,
					"content": "Netochka, nos encontramos novamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "Ah! Você tá aqui pelo duelo? E-Esse é um ataque surpresa! Se a gente tiver que duelar, pelo menos marque uma hora e lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034018,
					"content": "Eu ainda quero que passar um bom tempo aqui, já que não tive chance de explorar a Cidade de Nasha direito. Que tal a gente deixar o duelo pra depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034002,
					"content": "Sobre Novokichevgrad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "Era meio sufocante quando eu vivia lá, mas agora que saí, me pego sentindo saudades... Essa é a primeira vez que estive tão longe de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034004,
					"content": "Eu achava que teria muitos outros feéricos vivendo em outros lugares também, como de onde eu venho. Até Snezhnograd tem sua parcela de feéricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034005,
					"content": "Mas eu acabei em Nod-Krai e não vi nenhuma delas. Paimon também disse que ela não é um feérico. Não tem nada a ver com o clima aqui, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034013,
					"content": "#Não tem tempestade de neve e você não vai ficar pres{M#o}{F#a} aqui sem um fogão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034014,
					"content": "Ah, e eu até vi alguém tomando uma bebida de Novokichevgrad em Nod-Krai. Somos tão conhecidos pela indústria de bebidas alcoólicas quanto pela indústria de mineração, mesmo assim, ver os produtos de casa me deixa... sentimental?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034011,
					"content": "Até a próxima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "Sim! Até lá, boa sorte para nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				}
			]
		},
