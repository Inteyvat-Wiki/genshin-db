				},
				{
					"id": 760730106,
					"content": "Sobre Raskolnikov...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760730107
					]
				},
				{
					"id": 760730107,
					"content": "Ah, ele... Ele costumava ser o melhor e favorito aluno do meu pai. Acho que ele construiu a própria reputação agora que tá com os Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760730108
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730108,
					"content": "Eu também costumava admirar ele. Eu queria ser como ele... Mas acho que não importava quanto eu tentasse, eu nunca conseguia vencer ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760730109
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730109,
					"content": "Hmm, eu achava que ele não se importava nem um pouco comigo, mas dessa vez eu consegui sentir a hostilidade dele. Queria saber por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760730110
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730110,
					"content": "E aquele comentário sobre eu ser \"arrogante\"... Não faço ideia de onde veio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760730111,
					"content": "Até a próxima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760730112
					]
				},
