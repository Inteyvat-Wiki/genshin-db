			"dialogs": [
				{
					"id": 190250501,
					"content": "Não pensei que você me encontraria tão facilmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250502,
					"content": "É apenas sua primeira vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "Pensei que este seria o lugar perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250505,
					"content": "Na verdade, conheço muito bem os métodos para localizar os espíritos malignos e tenho muita experiência em rastrear seus esconderijos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250506,
					"content": "Este lugar está empoeirado, tem muitas formas retilíneas e está longe da luz. Os espíritos malignos geralmente preferem lugares assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250507,
					"content": "Você está tentando usar a taumaturgia para brincar de esconde-esconde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "Sim, acho que minha experiência como exorcista não se aplica aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250511,
					"content": "Como você me encontrou, devo admitir minha derrota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250512,
					"content": "É um jogo simples, mas muito intrigante quando você começa a jogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250513,
					"content": "Podemos jogá-lo de novo outro dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "Claro, poderíamos convidar mais amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250517,
					"content": "Vamos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250515,
					"content": "Que bom que você não era o fantasma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "Hehe, tem razão. Eu levaria horas para encontrar alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250509,
					"content": "Mas você pode ser facilmente visto aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "Hmm, acho que estava tão nervoso que esqueci a coisa mais importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 190250503,
					"content": "...Por que você se escondeu aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
