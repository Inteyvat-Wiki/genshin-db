			"dialogs": [
				{
					"id": 733350701,
					"content": "Nada mal, Sorush! Você realmente fez a área recompor sua vitalidade bem rápido, hein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350702,
					"content": "Os poderes Pari são fascinantes, sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350703
					]
				},
				{
					"id": 733350703,
					"content": "Você está se assustando à toa! Meus poderes são mais do que suficientes para facilmente resgatar a Flor Sunyata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350704
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350704,
					"content": "A corrosão obscura está se expandindo e essa Flor Sunyata não é nada além de uma de suas muitas vítimas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350705
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350705,
					"content": "As outras flores não foram poupadas. Sefana deve estar em bastante desespero no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350706
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350706,
					"content": "Essa Sefana que você mencionou, parece ser uma Pari legal que trabalha bastante para cuidar das flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350707,
					"content": "#Vamos ajudá-la, beleza, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350708,
					"content": "#Bem, agora, eu acho que isso serve como uma distração adequada do meu grande trabalho. Nesse caso, {M#meu}{F#minha} Yasnapati, te peço que cuide das Flores Sunyatas deste tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350709,
					"content": "Te direi quando vê-las.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350710
					]
				},
				{
					"id": 733350710,
					"content": "#Sim! Vamos salvar essas belas flores junt{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
