				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "Viajante Honorável. Uma palavra, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "#Vou poupá-l{M#o}{F#a} dos detalhes desnecessários. Há um assunto no qual preciso de ajuda. Há alguns dias, Sua Alteza Yu Huangyi, de Liyue, enviou-me um tesouro de raridade extraordinária. Porém, até agora, ele ainda não chegou às minhas mãos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Tenho motivos para acreditar que o guardião desta região o interceptou. Caso encontre o \"tesouro\" do qual Sua Alteza falou, peço que o recupere em meu nome. Fique tranquilo, você receberá a devida recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "Voltamos! Dê uma olhada. É esse o \"tesouro\" de que você estava falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Ah! Você tem meus mais sinceros agradecimentos, de verdade! Não sei nem como agradecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Muito bem. Não há razão para adiar. Vou abri-lo agora mesmo —",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "Is–Isto é...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Uau! Isso vai explodir!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "Sua Alteza Yu Huangyi jamais tentaria me ferir... Então será que o guardião o tomou e o transformou em uma bomba!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Lamento dizer, mas não sei desmontar esse tipo de dispositivo... Não temos alternativa! Jogue para longe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Não precisa entrar em pânico! Lembrei agora. Um certo nobre de Hipérborea certa vez mencionou o método correto de arremessar uma bomba sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"Deve-se contar até três. Nem mais, nem menos. Três será o número contado. Quatro é proibido. Não se pode ficar enrolando no dois. Cinco está completamente fora de questão. E quando o número três for alcançado...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Para de explicar e joga logo! Esse negócio vai explodiiiiir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
			"completionStepIds": [
				7011103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
