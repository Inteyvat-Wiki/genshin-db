			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							361.8,
							202.397,
							620.8
						],
						"pointId": 230
					}
				]
			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "Hã? Ué. Era só isso? A gente surtou por causa de fogos de artifício?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "T-Tanta genialidade... Mesmo em todos os meus anos servindo sob Sua Excelência, a Todo-Poderosa Narukami Ogosho, nunca vi um desabrochar de chamas tão radiante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "Entendo, então era isso que Sua Alteza queria que eu contemplasse... É mais do que eu poderia ter esperado. Sinto-me profundamente honrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "\"Na noite escura como jade de corvo, as flores desabrocham radiantes entre as nuvens. O corpo, como espuma sobre a água, deve apenas voltar ao silêncio em um instante. Quando as estrelas partem e a chuva se dispersa no vazio...\" Realmente, que elegância refinada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "Bom, Paimon não entende muito essa parte da \"elegância\", mas pelo menos não era perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}