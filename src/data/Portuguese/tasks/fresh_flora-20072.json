				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200720401,
					"content": "Aqui, venha aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720402,
					"content": "Você se lembra das flores que pedi para você colocar na Montanha Nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720403,
					"content": "Já se passou um dia, eu gostaria de ver os efeitos da refrigeração nas flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720404,
					"content": "Você gostaria de me ajudar indo na Montanha Nevada, pegar essas flores e trazer elas de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720405,
						200720407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720405,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720406
					]
				},
				{
					"id": 200720406,
					"content": "Muito obrigada, vou ficar por aqui esperando você. Volte o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720407,
					"content": "Onde você colocou elas mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720408
					]
				},
				{
					"id": 200720408,
					"content": "Você ainda se lembra? As flores estão <color=#00E1FFFF>do lado da Estátua dos Sete</color>, <color=#00E1FFFF>em uma fonte de água dentro da montanha</color>, e também <color=#00E1FFFF>próximas a caverna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720409,
					"content": "Vou marcar no seu mapa mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
	]
