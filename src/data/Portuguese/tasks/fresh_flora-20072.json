			"dialogs": [
				{
					"id": 200720101,
					"content": "Como estão as flores que foram armazenadas mais cedo na Espinha do Dragão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720102,
					"content": "Eu trouxe uma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "Não conseguiu trazer as outras flores? Está bem... No final das contas, é muito difícil prever a situação na montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720104,
					"content": "Mas se só temos uma, então não podemos fazer nenhuma comparação. Suponho que teremos que esperar por uma oportunidade de dar outra olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720105,
					"content": "Mas obrigada por se darem ao trabalho. Aqui, eu preparei isto como compensação - talvez eu precise recorrer a sua ajuda também no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007202,
			"completionStepIds": [
				2007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
