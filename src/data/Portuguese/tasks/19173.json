			"dialogs": [
				{
					"id": 191737101,
					"content": "\"...A reforma de Tamimi está seguindo sem problemas. Assim como agora, ela consegue aprender como lidar com várias situações perigosas nestas ruínas da sua própria maneira. Eu queria que você pudesse ver com seus próprios olhos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737102
					],
					"speakerTitle": "Nota amarelada"
				},
				{
					"id": 191737102,
					"content": "\"Enquanto trabalhava, eu continuei pensando que você faria um trabalho melhor com isso do que eu poderia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Nota amarelada"
				},
				{
					"id": 191737103,
					"content": "\"Afinal, você é a estudante mais excepcional que eu já conheci.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nota amarelada"
				}
			]
		},
