						191737202
					],
					"speakerTitle": "Nota bem escrita"
				},
				{
					"id": 191737202,
					"content": "\"As notas relacionadas a Tamimi foram concluídas e organizadas. Os nomes de todos os pesquisadores envolvidos também foram incluídos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737203
					],
					"speakerTitle": "Nota bem escrita"
				},
				{
					"id": 191737203,
					"content": "\"Eu espero que até após cem anos, gerações futuras de estudantes ainda lembrarão do seu nome, Madame Faruzan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nota bem escrita"
