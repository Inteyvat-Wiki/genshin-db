			"dialogs": [
				{
					"id": 200080101,
					"content": "Obrigado, obrigado por salvar a minha vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Aqueles Slimes apareceram do nada. Eu não pensei que eles apareceriam por essas áreas... Antes que eu pudesse entender o que estava acontecendo, eu já estava encurralado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Por favor, não conte ao meu pai... Ele já está me incomodando para ficar em casa, dizendo que os Slimes por aqui devem ficar mais hostis recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Com os Slimes aparecendo mais perto da cidade, estou preso em casa há dias. Eu consegui sair hoje sem ele perceber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Se você não se importa, você pode verificar se a costa está limpa agora? E se não, poderia eliminar os Slimes para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Ótimo! Parece que meu pai nunca vai descobrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Eu tenho outras coisas para resolver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "Ma, mas... não posso envolver o meu pai neste assunto... Você é a única pessoa a que posso recorrer, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
