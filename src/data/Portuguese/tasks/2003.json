			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "Essa é a casa da ilustre família de Inazuma? Mas não é tão luxuosa quanto a Paimon pensava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Pelo menos você já conheceu a Câmara de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "#Sejam bem-vind{M#os}{F#as}! A senhorita está à espera de vocês por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030405,
					"content": "Ela é a Shirasagi Himegimi que você comentou agora há pouco? Onde ela está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "Cof...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Atrás da tela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Hehe. Como filha da Comissão Yashiro, é assim que a senhorita Kamisato mostra a sua hospitalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030409,
					"content": "Isso é uma tradição de milhares de anos que a Comissão Yashiro segue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030410,
					"content": "Ah, então isso faz sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Era o esperado, afinal de contas, é a Shirasagi Himegimi que estamos falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "Por favor, perdoem a minha falta de cortesia ao lhes receber assim... Especialmente depois de uma longa e exaustiva jornada cruzando o mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "Eu sempre estive ansiosa pela sua chegada. Segundo o Thoma, acredito que vocês possuem o poder de mudar o rumo dos acontecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "Em Inazuma de hoje, os desejos do povo estão sendo esmagados por causa do Decreto de Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Embora a Comissão Yashiro sirva a Shogun, temos próximas relações com o povo, devido ao contato que temos que ter com eles para realizar nossos deveres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "O poder da Comissão cresce e cai com a confiança do povo. Por isso, não podemos ficar indiferentes a essa situação sem também ser indiferentes ao nosso próprio destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "Viajante, por favor, me dê o seu poder, eu certamente irei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030419,
					"content": "Estou aqui só para ver a Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030422,
					"content": "Viu? Eu já te disse que não era assim que funcionava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030423,
					"content": "Irei me retirar daqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "Espere um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030425,
					"content": "Hu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030426,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Eu vou te levar para a Shogun Raiden, mas a condição é que você tem que me ajudar a realizar meus três desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030428,
					"content": "Quais são eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030429,
					"content": "São sobre três pessoas que perderam suas Visões... Quando você ver elas, você entenderá tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030430,
					"content": "Um guerreiro que guarda a vila, um Samurai que efetuou o Decreto de Caça à Visão e um espadachim que procurava ser o melhor espadachim do mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030431,
					"content": "Exato! Por favor, dê uma mão a eles, eu ficarei esperando por vocês aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030432,
					"content": "Você tem a minha palavra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Hehehe, então eu vou deixar com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030435,
					"content": "#Deem o melhor de si, amig{M#os}{F#as}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030433,
					"content": "Isso soa muito complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "Peço desculpas, mas não estou aqui para contrariar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "Isso é um pouco desapropriado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "Pelo menos você já conheceu a Adega do Alvorecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
