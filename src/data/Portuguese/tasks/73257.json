						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "Hunf, somente os humanos precisam de tais coisas, pois sequer são capazes de usar os poderes dos Elementos por eles mesmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "Nós, Pari, somos diferentes, pois tanto nós como o Khvarena somos da mesma fonte. É como vocês humanos, que não precisam recitar encantamentos para caminharem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Hã... Mas você não caminha, você flutua.",
