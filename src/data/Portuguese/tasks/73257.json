			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Falando nisso, depois que saímos, Sorush não disse mais nenhuma palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Nós nunca paramos antes em nosso caminho, mas agora tudo está tão calmo. Paimon não consegue se acostumar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "Ela devia estar muito assustada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Ei, Sorush, vamos lá! Se anime um pouco! A gente ainda tem muita coisa para fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Tipo completar aquele... Hã, aquele ritual difícil de se lembrar, e depois também temos que lidar com aquela caverna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "Quando a gente terminar tudo que tem que fazer, vamos encher a nossa barriga! Todo mundo deu o seu melhor, a gente merece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "Mas, hã... Paimon não sabe do que as Pari gostam de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "...As Pari não precisam comer, Flutuante Estúpida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "Ah, eu nunca achei que um dia eu seria confortada pela Flutuante Pálida. Que humilhação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Eu agora só gostaria de ser selada dentro de um Cristal de Cinzas; ou encontrar uma caverna para me esconder, dormir e nunca mais acordar. Até que todos que eu conheço desaparecessem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "Paimon já disse para não chamar ela de Flutuante Pálida! Mas... existe mesmo uma caverna assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Fugir não é uma forma de resolver um problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Eu não me importo! Não quero pensar nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Só de pensar que fui enganada por alguém patético como Nasejuna, sinto vergonha de mim mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "Enfim, já conseguimos todas as Grandes Canções de Khvarena. Se vocês estão querendo resolver aquele fenômeno, precisam ir procurar por Mihir ou Rashnu no Oásis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "Enfim, não importa. Eu só quero que vocês me deixem e façam de conta que não ouviram nada do que eu disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "Hã, é que você disse muitas coisas estranhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "#{F#Minha}{M#Meu} Yasnapati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Argh, por favor, não fale mais nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, essa não é hora de tirar onda com a cara de Sorush. Estamos nessa aventura há muito tempo, não podemos desistir na metade do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "Além disso, Sorush também tem ótimas qualidades, tipo, hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "Você hesitou, não foi?! *Choro* Por favor, não caçoem mais de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Você é muito rápida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Sim, sim! Isso mesmo! Além disso, a gente não se esforçou esse tempo inteiro para resolver aquele fenômeno celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "Nós só chegamos até aqui por sua causa, Sorush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "#Como era a frase mesmo... Ah, Paimon lembrou: \"Se você continuar seguindo em frente, se tornar {F#uma}{M#um} aventureir{F#a}{M#o} de renome será só uma questão de tempo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "Sério? Vocês estão me elogiando honestamente, do fundo de seu coração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "É assim que amigos são.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Hehe, vocês falarem desse jeito realmente é digno de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "Minha força de vontade voltou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Isso aí! Já que Sorush está animada de novo, podemos ir procurar logo por Zurvan, resolver aquele problema naquela caverna e pegar nossa recompensa! Paimon não vê a hora de comer até não poder mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Você é muito responsável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "Forma valente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "Determinação do sacrifício?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Você ainda tem o que fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Parece que sim, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "Temos que pensar no que ela passou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Talvez ela só esteja cansada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "Zurvan, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#Ah, {NICKNAME}, Sorush, Paimon. São vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "Pela cara de vocês, acredito que conseguiram pegar todas as Grandes Canções de Khvarena, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Foi um pouco complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Oh, isso não importa. No final, deu tudo certo. Contar com vocês foi uma escolha certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Se vocês não estivessem aqui, temo que as Grandes Canções de Khvarena teriam sido levadas por aquelas pessoas traiçoeiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "*Suspiro* Zurvan, por que parece que você sabia de algo desde o começo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Ah, parece que me encurralaram. Vocês realmente encontraram com aquelas pessoas que servem à escuridão profunda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Como você sabe disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Oh, bem... Que tal falarmos sobre o que aconteceu antes de investigarmos isso profundamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Vocês contam para Zurvan sobre sua aventura nas ruínas subterrâneas, inclusive sobre a traição de Nasejuna.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Haha, eu não esperava que o Vijnanapati da Ordem dos Céticos acabasse se jogando nos braços do Abismo. Eu nunca tive expectativas a respeito dele, mas isso é assustador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "E se meu palpite não estiver errado, a razão para ele estar de olho nas Grandes Canções de Khvarena é porque foi atraído pelo Abismo. Pode-se dizer que essa pessoa é um conhecido meu de longa data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Hã? Você conhece aquela pessoa da Ordem do Abismo, Zurvan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Hunf, aquele cara era da Ordem dos Céticos. Há muitos séculos atrás, uma equipe de exploração veio da floresta em busca dos segredos dos Dahri e construíram esse local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Apesar dos avisos da Ordem dos Céticos, eles insistiram em entrarem nas ruínas deixadas pelos Dahri. Para evitar que ocorresse algum acidente, o Vijnanapati daquela época ordenou que ele os acompanhasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Eu não sei o que aconteceu depois nas ruínas, mas quando o vimos novamente, ele havia aceitado as bênçãos da impureza, e não havia sinal nenhum da equipe de exploração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Depois disso, os seguidores do Abismo passaram a se reunir. Eles queriam as Grandes Canções de Khvarena, e com isso em mente, eles convocaram muitos monstros Dev para atacarem o Oásis Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Foi graças a ajuda de muitas Pari e valentes humanos que o Oásis Vourukasha foi protegido. Mas nunca conseguimos eliminar completamente esses discípulos da escuridão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "E para que eles não aproveitassem nenhuma chance, eu usei o poder da Grande Canção de Khvarena e selei o Oásis Vourukasha e as suas ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "A Ordem dos Céticos nunca se recuperou dessa traição. Perdemos nossos antigos arquivos para um incêndio, e aos poucos ficamos desse jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Senti que eles estavam agindo nos bastidores na última vez que nos encontramos, mas eu não imaginava que o líder da Ordem dos Céticos estava sendo usado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Enfim, Paimon ainda está pensando sobre o que Nasejuna disse. Você sabe algo sobre os antepassados da Ordem dos Céticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Afinal, você lutou ao lado deles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Haha, a história se torna uma lenda, e uma lenda se torna uma fábula. É assim que tradições sobrevivem. O esquecimento também é parte disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Quanto mais você se apega à ideia de tradição, mais passa a lembrar seletivamente a história que deseja, até o ponto que eventualmente fica perdido em um labirinto de histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "Em um mundo em que muitos estão sendo perdidos pela memória todas as horas, todos os dias, o que registramos no chão é muito mais confiável do que o que cantamos para o vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "#É por isso que confio em vocês. Pois vocês são franc{F#as}{M#os} e nunca se preocupam com o que outras pessoas pensam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Apesar de você estar elogiando a gente, a forma que você fala é um pouco estranha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Estou sentindo um pouco de sarcasmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Eu presumo que as palavras da Anciã Zurvan são direcionadas a mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "Quanto ao que aconteceu 500 anos atrás, acho que vocês gostariam mais de ver com seus próprios olhos do que ouvir minha versão da história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "E agora vocês têm a oportunidade perfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Falando nisso, Sorush, parece que você está mais confiável agora. Não é à toa, com o que você passou, despertou daqueles mitos horríveis sobre os humanos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Hã, vamos deixar o passado no passado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Parece que eu fiz a decisão certa ao confiar essa tarefa para {F#a}{M#o} {NICKNAME} e a Paimon. Nesse caso, acho que deixarei o Ritual de Ab-Zohr nas suas mãos sem nenhuma reserva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "O Ritual de Ab-Zohr...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Paimon lembra de ter ouvido Zurvan mencionar isso antes! É para purificar... as impurezas ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "O Ritual de Ab-Zohr é um ritual realizado para purificar a Harvisptokhm das impurezas. Normalmente só é necessário realizá-lo sob as árvores que suprimem a Fenda Escura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Entretanto, com o enfraquecimento do selo e o ressurgimento da anomalia no céu, precisamos de mais do que o normal para resolver esse problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "A anomalia apareceu sobre a Harvisptokhm porque a árvore absorveu muitas impurezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Com o excesso do acúmulo de impurezas e a corrosão causada pela anomalia, a Harvisptokhm não é mais capaz de suportar o poder de Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "A única coisa que podemos fazer agora é entrar na Harvisptokhm para purificá-la e despertar nosso deus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "Espera, então a gente pode entrar na árvore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Claro que sim. Você acha que o Ritual Chinvat era para ser realizado dentro da Fenda Escura? Nem mesmo as Pari conseguem suportar as impurezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Dentro da Harvisptokm há um lótus gigante, Gaokerena, e a consciência de nossa deusa dorme nele. Ao purificarmos as impurezas, a Flor da Santidade desabrochará novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "O Amrita purificará a terra de todas as impurezas. Esse processo é complexo, mas não acho que ele será um obstáculo para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Bem, eu já enviei Rashnu e Mihir para a Fenda Tunigi. Vocês só precisam trazer as Grandes Canções de Khvarena para reunir seu poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "Khvarena despertará as árvores gigantes que suprimem a Fenda Escura e purificará a lama contaminada nas profundezas. Depois disso, vocês poderão realizar o Ritual Chinvat e abrir o caminho para a Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "E quando estiverem dentro, a Coroa Florida revelará para Sorush os grandes feitos de nossos heróis antigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Como todas as memórias relacionadas a Khvarena retornarão para a Harvisptokhm no final, essas memórias nunca desaparecerão, não importa como as lendas forem recontadas e mudadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "Essa é a primeira vez que ouço isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Hehe, a Coroa Florida é originalmente uma parte da Harvisptokhm. Você saberá quando chegar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Bem, por favor eliminem o Sinal de Apaosha. Nos encontraremos novamente quando o Amrita cair do céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Sim, encontramos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Bem, já que é assim, que tal falarmos sobre o que aconteceu antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "#Estou morrendo de cansad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
			"id": 7325704,
			"completionStepIds": [
				7325704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325704",
							"2"
						],
						"stepId": 7325704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rashnu",
					"Mihir",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "Por que Sorush está demorando tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570402,
					"content": "Estamos esperando aqui há um tempão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "Estou tão cansada... Quero voltar a dormir... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "Ei, isso não é justo. Sou eu quem está fazendo o trabalho duro, e vocês não fizeram nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Isso não é verdade. Esperar também é um trabalho importante. Na verdade, agir é só momentâneo, enquanto esperar é eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "Que lógica bizarra é essa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "Essa é a filosofia das Pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Mas agora não é hora de discutirmos filosofia. O que importa são as Grandes Canções de Khvarena. Vocês coletaram todas elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "Claro que sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "Nesse caso, vamos remover o selo. Assim poderemos reunir o poder de Khvarena com o das Grandes Canções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Mas tenham cuidado. Como as impurezas estão se acumulando há séculos, não tenho ideia do que vai sair delas quando o selo for removido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
