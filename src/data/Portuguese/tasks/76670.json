			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Lyylikki, como você tem estado ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Ah! Olá, Srta. Lauma. As coisas têm corrido bem aqui na loja ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "O fornecimento de ingredientes tem sido constante, ninguém tem causado problemas, e minhas habilidades culinárias melhoraram bastante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "Ah, e sobre aqueles \"amigos\" que você mencionou da última vez... você estava falando daqueles animais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Eles são tão comportados. Ficam só observando as pessoas na fila em silêncio. Eu até tentei oferecer algo para comer, mas eles não aceitaram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Esses pequeninos entendem bem seus deveres. Quando estão de plantão, permanecem focados e firmes em seus postos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Mas, quando estiverem de folga, sinta-se à vontade para oferecer um petisquinho. Hehe, tenho certeza de que eles ficariam encantados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "Ótimo! Então hoje vou preparar algo bem gostoso para agradecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Obrigada, Lyylikki. Se precisar de ajuda, é só me avisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Não precisa, de verdade! Está tudo sob controle — e, além disso, o Sr. Kantor e a Srta. Jahoda estão ajudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Tudo bem então, vou deixar você trabalhar. Até mais, Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Ah, preciso levar o próximo lote de pratos... Ah, Srta. Lauma, gostaria de experimentar este também? Acabou de sair do fogo — está fresquinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Certo, hora de servir a comida... Hã? Onde estão os pratos que acabei de lavar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}