			"dialogs": [
				{
					"id": 721130701,
					"content": "A atitude da Srta. Gendou é a mesma de sempre, hein... Enfim, vamos checar o que tem no rolinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130702,
					"content": "Hã? Isto é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130703,
					"content": "Paimon entendeu. Este deve ser um cara mau que precisa ser derrotado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130704,
					"content": "Sim, é isto. Acontece que a Srta. Gendou é uma espiã que está usando este método para se comunicar e se livrar daqueles que tentam ameaçar Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
