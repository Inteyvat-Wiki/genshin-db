				},
				{
					"id": 721130402,
					"content": "Eh, é do azar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "Eu me lembro desse cenário! Dizia... Para pendurar o rolinho do auspício no Pendurador de Rolinho da Sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "E dar uma boa comida para Paimon. Isso ajudará a mudar a má sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Claro! Você está questionando a sabedoria dos povos antigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "A sabedoria dos povos antigos é incrível! Enfim, vamos encontrar o Pendurador de Rolinho da Sorte primeiro!",
