				{
					"id": 721130506,
					"content": "Ah, sim. Você só pode sacar um Rolinho da Sorte por dia. Por favor, lembre-se disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130507,
					"content": "É muito cansativo de outra forma... Espera, não. Senão, você não poderá usar o Pendurador de Rolinho da Sorte para... Não, isso também não está certo. O que eu deveria dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130508
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130508,
					"content": "\"Os Rolinhos da Sorte são a manifestação de nossa Arconte. É nosso dever, como mortais, respeitá-la e fazer tudo o que pudermos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130509,
					"content": "Vê? Muito mais elegante. Portanto, lembre-se, você só pode pegar um Rolinho da Sorte por dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
