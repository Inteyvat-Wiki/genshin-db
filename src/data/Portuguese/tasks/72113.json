			"dialogs": [
				{
					"id": 721130801,
					"content": "Hã? Aonde a Sra. Gendou foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130802,
					"content": "#Estou um pouco preocupad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "Sim, e se ela não voltar? Como Paimon vai saber da sorte diária?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130804,
					"content": "Hã? Tem uma nota aqui. Deixa Paimon dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130805,
					"content": "Nós não deveríamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "Não importa! Pode ser uma pista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130807,
					"content": "Hã? Isto é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130808,
					"content": "Parece que devemos visitar este local e receber as próximas instruções...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130809,
					"content": "Vamos descobrir!",
