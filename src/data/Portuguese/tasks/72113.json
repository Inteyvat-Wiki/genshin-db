			"dialogs": [
				{
					"id": 721130201,
					"content": "Deixe Paimon dar uma olhada, deixe Paimon ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130202,
					"content": "Uau! Está escrito \"Muito auspicioso\". Oba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130203,
					"content": "Parece que hoje é o dia de sorte de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130204,
					"content": "Seu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "Isso mesmo! Sua sorte é a sorte de Paimon! E vice-versa, a sorte de Paimon também é a sua sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130206,
					"content": "Quando Paimon come uma boa comida, isso é boa sorte. Portanto, pelo bem de sua sorte, dê a Paimon uma boa comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
