			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "Quer um Rolinho da Sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130102,
					"content": "Nossa, ela é tão fria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130103,
					"content": "Sim, eu gostaria de um...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "Entendi. É assim que se faz. Primeiro, sacuda isso... Coisinha vai aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130105,
					"content": "Não é chamada de Caixa de Rolinhos da Sorte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "Sim. Um Rolinho de Bambu vai cair dela. Dê-me e eu lhe darei uma tira de papel correspondente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130107,
					"content": "Eu tenho certeza que chamam de Rolinho da Sorte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "Tanto faz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130109,
					"content": "Paimon tem uma pergunta! E se... O que fazemos se tivermos um que signifique má sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130110,
					"content": "É o destino. Você tem algum problema com isso? Hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130111,
					"content": "O quê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130112,
					"content": "Há algo como uma prateleira ali fora que possamos usar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "Tsc, tsc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130114,
					"content": "Ela realmente acabou de dizer \"tsc\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130115,
					"content": "Deixe-me ver... Oh, sim. \"Amarre o Rolinho do Auspício no Pendurador de Rolinho da Sorte para mudar o azar para a sorte\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130116,
					"content": "Ah, certo! Se você tirar um Rolinho da Sorte com uma má sorte, basta amarrá-lo àquela prateleira, isso serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130117,
					"content": "Hã, que bando de... Não, desculpe. Nós do Grande Santuário Narukami somos realmente muito gentis. Mesmo que você tenha um papel com má sorte, você terá a chance de dar a volta por cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130118,
					"content": "Algo nisto parece errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130119,
					"content": "#Vamos lá tirar um Rolinho, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
