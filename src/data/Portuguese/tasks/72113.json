					"content": "Que barulho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130706,
					"content": "Aahh! D-desculpa! Por favor, não chame o \"Shiyuumatsu-Ban\" na gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130707,
					"content": "Saia agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130708,
					"content": "Estamos saindo agora! Vamos para o local desenhado e ver se podemos encontrar o alvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
