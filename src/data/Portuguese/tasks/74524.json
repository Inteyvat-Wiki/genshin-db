				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "#Bem, {F#minha pequenina}{M#meu pequenino}, quem diria? Você veio depois de ouvir o meu itinerário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Você foi encontrar com a Shogun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Ora, que nariz bom você tem. Mas, não, eu só estava trazendo alguns lanches e light novels populares para uma amiga... que não tem o costume de sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Ei está acompanhando as séries mais novas também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "De acordo com as palavras dela, ela quer saber mais sobre as mudanças recentes nas preferências de Inazuma por entretenimento e lazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Ela até mesmo chegou ao ponto de discutir o tópico comigo. Começou com uma análise séria de preferências dos leitores, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "Mas, pouco depois, ela me perguntou o que aconteceu com certo personagem no final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Hehe, parece que até a magnânima Raiden Ei não é imune ao atrativo de uma trama emocionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "Essa sua cara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "Oh? É por isso que você veio aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Como você deve ter sentido minha falta nas suas viagens, ao ponto de querer tirar essas fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Vamos lá, então. Mas preste atenção aos ângulos que você vai tirar fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "... É bem memorável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Eu sinto o cheiro de algo doce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
