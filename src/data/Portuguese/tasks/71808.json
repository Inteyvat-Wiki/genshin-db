					"content": "O despertar está chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080202
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080202,
					"content": "Está tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "Você veio testemunhar a sua ressurreição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080204,
					"content": "Você chegou um pouco cedo, mas tampouco posso dizer que você chegou tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080205,
					"content": "Que diabos ela está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080206,
					"content": "Hum, o que você estava dizendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "Haha, você não percebeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080208,
					"content": "Não, não. Na verdade, isso pode ser algo bom para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080209,
					"content": "Agora volte e espere essa pessoa despertar. Então você entenderá tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiu"
				}
			]
		},
