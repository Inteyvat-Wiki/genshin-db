				},
				{
					"id": 718080302,
					"content": "Sobre a situação do Monte Nantianmen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Terremotos, monstros e uma garotinha... Por acaso ela é alguma menina perdida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Sobre o que ela disse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "Dizer o quê? \"Sua ressurreição\"? Quanta asneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Que livros estranhos ela tem lido? Bem, não importa. Mandarei alguém trazer essa garota de volta para a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "Terremotos e monstros... Espero que essa garota não esteja ferida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Muito obrigado. Aceite isto em troca por nos ajudar nesta tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
