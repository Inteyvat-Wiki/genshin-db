				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Como foi, Cometa Dourado? Como foi o seu primeiro gostinho da jogabilidade do Fungo Mechanicus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Julgando pela sua expressão, eu acho que você ainda não chegou a uma conclusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Eu só joguei uma rodada, afinal de contas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Isso é verdade. Com esse pequeno conteúdo de teste, é de fato difícil julgar as forças e defeitos do Fungo Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Não se preocupe. Srta. Haniyyah e eu estaremos aqui por um tempo e teremos uma nova fase Mechanicus para você todo dia, sete no total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Venha aqui sempre que tiver tempo, e você terá oportunidade de testar essas fases!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "#Apesar de você ser {F#a}{M#o} supervis{F#ora}{M#or} geral destas questões, este jogo foi algo que a Srta. Haniyyah e eu elaboramos sozinhos, então essa dedicação de tempo está fora de seus planos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "Assim, uma taxa será fornecida a você pelos serviços prestados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Haha, bem, eu não vou recusar isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "Haha, direto ao ponto! Eu gosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "Eu solicitei privilégios de residência dos dois Cogumelos, então eles estarão em Porto Ormos durante o teste do Fungo Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "Sua Parceira de Prata pode passar mais tempo com Cabeça de Bongô.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "Bom para Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Hehe, sim, você deveria ir ver Cabeça de Bongô também. Ele sente sua falta, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Leve isso com você. Você pode alimentar Cabeça de Bongô e Pyroalegria. É o favorito deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Eu também mal posso esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Você verá essa Mora de volta da próxima vez que realizarmos este torneio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Eu precisarei fazer mais testes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
		},
