					"nextDialogs": [
						735070510
					]
				},
				{
					"id": 735070510,
					"content": "Ooh, então Haniyyah e nossos cogumigos estarão aqui por um tempo, hein? Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070511,
					"content": "Paimon estava planejando pedir a você para ficar aqui mais um dia para a gente poder passar mais tempo com os Cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070512,
					"content": "Mas parece que nós poderemos matar dois unagis com uma espadada só... testando Fungo Mechanicus e brincando com nossos cogumigos ao mesmo tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070513,
					"content": "Você passa um tempo de qualidade e relaxa com Paimon, Cabeça de Bongô e Pyroalegria, e dá as Geleias Maravilhosas a eles.\\nPaimon e seus cogumigos se divertem bastante.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735070514
					]
				},
				{
					"id": 735070514,
					"content": "Hehe, foi ótimo! Está tão quentinho e bom — como se as preocupações de Paimon tivessem desaparecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070515,
					"content": "Bem, Cabeça de Bongô, Pyroalegria... Vejo vocês amanhã!",
