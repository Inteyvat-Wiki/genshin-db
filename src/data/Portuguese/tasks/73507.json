			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#Cometa Dourado {NICKNAME} e Parceira de Prata... Nos encontramos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "#Animad{M#os}{F#as} como sempre, como posso ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Você parece bastante animada também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "H-Haniyyah! E você também, Balfour?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Que prazer encontrar vocês aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "Bem, de volta ao ponto. O que vocês estão fazendo por aqui? Se Paimon ainda se lembra bem, era aqui que podíamos pegar aquelas Geleias Florais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "#Ah, {M#nossos dois grandes heróis}{F#nossas duas grandes heroínas}! Apenas suas vozes já me enchem de confiança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Por enquanto, eu continuarei fazendo meu relatório sobre os resultados de nosso trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "Anteriormente, vocês declararam que a Copa Nilotpala de Domadores de Feras deveria ser suspensa por um tempo enquanto a Academia melhorava o projeto do Orbe da Sabedoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Eu acredito que vocês ainda estão aguardando notícias relacionadas a isso, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Sim, isso mesmo! Layla, Cyno ou os pesquisadores responsáveis deveriam nos informar se houvesse qualquer progresso, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Não que você fosse entender o jargão técnico deles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Bem, é mais ou menos isso mesmo. Nós não seríamos de muita ajuda. Provavelmente acabaríamos atrapalhando, para falar a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Ah, que meticuloso, que tolerante de sua parte. Eu, por exemplo, praticamente explodo de animação quando penso nos grandes momentos do torneio anterior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Assim, eu tentei perguntar a alguns membros relacionados dos funcionários da Academia recentemente para conseguir alguns detalhes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "No momento, melhorias ao Orbe da Sabedoria ainda estão sendo implementadas através de seus campos teóricos. Assim, qualquer produção prática ainda levará algum tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Contudo, o debate ao redor da primeira iteração do torneio está diminuindo a cada dia, e está sendo esquecido, mesmo que lentamente. Nós não podemos permitir que a influência do evento anterior seja desperdiçada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Assim, eu me uni a Srta. Haniyyah para organizar um \"evento temático\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "O que \"evento temático\" quer dizer, exatamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Então é para isso que essas peças de jogo com formato de cogumelo na mesa servem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "O Sr. Balfour tem procurado por patrocinadores como parte da organização do próximo evento e ele até procurou aprender algumas técnicas publicitárias de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Enquanto fazia isso, ele encontrou um certo tipo de jogo conhecido como Teatro Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Em seguida, ele comprou os direitos de franquia de Sumeru para aquele jogo e preparou um jogo completamente novo comigo como consultora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Nós o chamamos de \"Fungo Mechanicus\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "Fungo Mechanicus, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Deixe Paimon adivinhar... Então nós vamos comandar vários cogumelos para batalhar com algumas máquinas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Haha! Você é de fato esperta, Parceira de Prata. Entendeu rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Eu acredito que este jogo é fácil de entender e promover, além de possuir um grande potencial que vale a pena ser explorado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Se pudermos comercializá-lo com sucesso como um derivado do Torneio de Domadores de Feras, nós podemos fazer o torneio continuar fresco na mente das pessoas a longo-prazo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Dessa forma, o próximo torneio que realizarmos atrairá um público ainda maior e ainda mais competidores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Claro, isso só pode seguir com sua permissão. Afinal, você tem a última palavra sobre como o torneio será organizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Eu acho que vale a tentativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Hmm, bem, nem {NICKNAME}, nem Paimon sabe muito sobre negócios, mas Paimon acha que você tem um bom ponto, Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Você e Haniyyah têm trabalhado nisso juntos e Paimon acredita em vocês, então podem seguir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Nós não jogamos o jogo ainda, mas Paimon pode apostar que um monte de gente vai amar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Maravilha! Já que vocês concordam, eu posso prosseguir e promover o Fungo Mechanicus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "O jogo está em fase de testes no momento, então ainda precisamos convidar pessoas para testar e coletar o relatório deles para podermos fazer mais melhorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "E eu tenho certeza que você, quem certamente encontrou todos os tipos de jogos populares por todo Teyvat, terá as melhores sugestões de todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#Hehe, vamos nessa, {NICKNAME}! Esse é um dos seus pontos fortes, afinal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Por que eu tenho a sensação que você está me comandando a...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Dito isso, Paimon tem uma pergunta para você, Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Você quer saber de Cabeça de Bongô e dos outros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Isso mesmo! Paimon sente falta de nossos cogumigos. Como eles estão indo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Não se preocupe, eles estão muito bem... vivendo uma vida muito tranquila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "Ioiozinho e Blitzor estão atualmente ficando na minha <color=#00E1FFFF>residência temporária no norte de Porto Ormos</color>. Um dos competidores anteriores está cuidando deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Cabeça de Bongô e Pyroalegria estão por perto. Se quiser, Parceira de Prata, você pode ir brincar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Por perto, né? Muito bem, {NICKNAME}, Paimon vai procurar por Cabeça de Bongô enquanto você testa o jogo mais tarde, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Pode ir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Muito bem, não vamos perder mais tempo. Venha, Cometa Dourado, a versão inicial de testes do Fungo Mechanicus está pronta para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Eu me juntarei a você em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "#Isso aí! Cometa Dourado, {M#pronto}{F#pronta} para a batalha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Você se esforçou mesmo, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Não que eu fosse ter muitas sugestões para eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Quem são vocês mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#Ah, qual é, {NICKNAME}, do que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Nós participamos da Copa Nilotpala de Domadores de Feras, não participamos? Foi ótimo curtir com nossos cogumigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "Nós conhecemos Haniyyah lá, e Balfour era o membro da equipe de produção mais responsável do evento anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Espera, você esqueceu de Cabeça de Bongô e Ioiozinho também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "Ah, eu me lembro agora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "O quê? Qual é! Paimon estava quase indo atrás de um médico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070112,
