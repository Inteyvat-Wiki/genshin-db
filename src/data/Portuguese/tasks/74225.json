			"dialogs": [
				{
					"id": 742250201,
					"content": "#Obrigado, {M#meu salvador}{F#minha salvadora}! Que o Deus Rei seja louvado, estou salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "Você faz parte da legião que defendeu essa cidade? Ou uma alma valente que me encontrou por acaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "De toda forma, permita-me apresentar. Faustus, é meu nome, comerciante de fronteira sob ordens do próprio Deus Rei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Eu vim aqui para transportar especiarias dos reinos ao sul... Não achei que aqueles Dragartos malignos me cercariam no instante que chegasse à costa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Dragartos? Não vi nenhum Dragarto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#Hã? Minha nossa, você realmente é um{F#a} guerreir{M#o}{F#a} poderos{M#o}{F#a} — aqueles inimigos simplesmente passaram despercebidos, entendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Em todo caso, fique com isso. Mesmo assim, receio que devo ser breve com as gentilezas — essas mercadorias ainda precisam de transporte para a cidade. Talvez nos encontremos novamente lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
