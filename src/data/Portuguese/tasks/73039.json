			"dialogs": [
				{
					"id": 730390101,
					"content": "Irmãos, já refletimos bem. O Festival Utsava é um dia de alegria, Arapacati não deveria ficar nervosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Isso mesmo, Arapacati, não fique nervosa. Os dias de alegria devem ser comemorados com \"Gosto da Felicidade\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "É hora de mostrar o resultado do Treinamento Culinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Já está tudo pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Hmm! É o banquete do Festival Utsava! Esperei muito tempo por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Uhu! Este é o banquete do Festival Utsava!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Com a água de Vanarana, a melhor que há, podemos fazer a melhor sopa. Com certeza Nara vai gostar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Devemos oferecer para Nara {NICKNAME} e Paimon o \"Gosto da Felicidade\". Provavelmente ele servirá de \"guia\" para Paimon e para Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "É a única maneira de fazer pratos que satisfaçam Nara. É a \"etiqueta\" para receber os \"convidados\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Nara {NICKNAME}, gostaria de \"guiar\" nossos irmãos na cozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Não vamos criar muitas expectativas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
