			"dialogs": [
				{
					"id": 760310201,
					"content": "...De fato. Vamos pedir para Kunegunda trazer algumas frutas depois. Ela precisará descansar pelos próximos dois dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Hmm, parece que Lauma tá ocupada agora. Vamos dar espaço a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "Percebi, muitos anos atrás, que a Emissária da Canção Lunar é uma figura de grande importância para os Filhos da Lua Gelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310204,
					"content": "Às vezes acho que sua tarefa pode ser ainda mais difícil do que a de um deus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310205,
					"content": "Finalmente! Ela tá com um tempo livre. Vamos—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Srta. Lauma, aqui estão algumas das tarefas de defesa que precisam da sua atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Claro, estarei com você em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "E lá se vai ela de novo! Ela nunca descansa, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Vamos seguí-las, mas, sabe, com cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
