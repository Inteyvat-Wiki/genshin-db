			"dialogs": [
				{
					"id": 760310301,
					"content": "...Isso vai servir. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310302,
					"content": "Seja noite ou dia, que a Luz do Luar nos conecte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310303,
					"content": "...Hmm? Esse ditado mudou em relação à última vez que o ouvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310304,
					"content": "Ah! A pessoa se foi! Vamos, pessoal, rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310305,
					"content": "Srta. Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 760310306,
					"content": "Você tá falando sério?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310308,
					"content": "...Obrigada por seu trabalho. Agora, com licença, eu retornarei em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310310,
					"content": "Não tem ninguém por perto. Você pode sair agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310311,
					"content": "Então você já sabia que a gente tava aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310312,
					"content": "Como eu poderia não ver a Kuu{RUBY#[S]Dama da Lua}tar e seu kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310313,
					"content": "Embora... Eu não tenha certeza do porquê estão me seguindo. É bem inquietante... ser \"observada\" no trabalho assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310314,
					"content": "Hmm, sobre isso... Desculpa, é que a gente queria ver você sobre isso, mas nunca havia um momento certo... Paimon só tá feliz que não pressionamos você além da conta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310315,
					"content": "Ah, entendi... Vou resolver isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310316,
					"content": "Para falar a verdade, depois de observar você por um dia trabalhando, Paimon fica se sentindo mal de pedir a você para fazer mais coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310317,
					"content": "Não se preocupe. Esse é o meu dever como Emissária da Canção Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310318,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310319,
					"content": "...Sim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310320
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310320,
