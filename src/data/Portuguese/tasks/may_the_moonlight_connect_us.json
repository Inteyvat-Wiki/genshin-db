			"dialogs": [
				{
					"id": 760310101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "*Ronco*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310103,
					"content": "Ela parece estar tirando uma sonequinha da tarde. Parece que vamos ter que voltar depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Texique"
				},
				{
					"id": 760310105,
					"content": "Ei, não vá ali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "... Hunf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310107,
					"content": "Ai que dor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Texique"
				},
				{
					"id": 760310109,
					"content": "Você escorregou? Ah, não se preocupa, não me machuquei. Hã? Vocês vieram também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310110,
					"content": "Pelo visto a Deusa da Lua não é imune a algumas pancadas e batidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Contanto que o kuuvahki emitido não reflita intenções malignas, não me importo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310112,
					"content": "Aconteceu alguma coisa? Por que tanto medo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Texique"
				},
				{
					"id": 760310114,
					"content": "Hmm, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310115,
					"content": "Aah, então você também pode entender o que eles dizem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "A lua brilha no alto sobre Nod-Krai. Todos os animais que crescem sob a luz do kuuvahki podem ser considerados \"familiares da Deusa da Lua.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310117,
					"content": "Então, o que disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "Que monstros apareceram na sua moradia e que foi atrás de Lauma inicialmente, mas foi perseguido pelos monstros até essa área...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310119,
					"content": "Aah... Por isso que tá tão assustado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Será que mandamos de volta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Sim. Lauma seria a melhor escolha aqui. Ela saberá como lidar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760310122,
					"content": "Tudo bem, parece que é outra viagem para nós. Mas não deixe de se esconder bem, vamos para os Filhos da Lua Gelada, afinal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
