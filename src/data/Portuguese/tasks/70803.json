			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pallad Imprudente",
					"Joel",
					"Joserf",
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "Hã? Quem é esse sujeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "Será que é o pai de Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "Oh! Viajante, você chegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030105,
					"content": "Permitam-me lhes apresentar o pai de Joel, Joserf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030106,
					"content": "#Pai! Ess{F#a}{M#e} daqui é {F#a}{M#o} Viajante que eu lhe falei. {F#A}{M#O} Viajante me ajudou muito no passado, e desta vez nós até mesmo fizemos um boneco de neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel me disse tudo sobre você. Não tenho como lhe agradecer o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "Estou feliz que vocês se reuniram...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Sim, isso é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Pallad, o que você fez dessa vez tem um grande mérito, meus parabéns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "De novo? Pallad fez o que de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Vocês ainda se lembram que eu disse que antes vi a sombra de alguém na Montanha Nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030114,
					"content": "Naquele dia, vocês me acompanharam para entrar ela, e depois de me ajudarem a derrotar aqueles monstros, eu comecei a procurar pelas redondezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030115,
					"content": "Enquanto procurava, acabei não tomando cuidado e rolei de cima da montanha para baixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030116,
					"content": "Rolou para baixo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "Ainda bem que tinha muita neve lá embaixo, eu não fiquei ferido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030118,
					"content": "Quando eu me preparei para retornar, do nada movimentos ao meu lado, e uma pessoa havia aparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030119,
					"content": "Na hora eu não percebi que ele era a pessoa que eu estava procurando, só pensava que era alguém que nem eu, que havia entrado na montanha para salvar o aventureiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030120,
					"content": "Mas após conversar um pouco, estava claro que ele tinha problemas com sua memória. Ele nem sabia o próprio nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030121,
					"content": "Naquele momento, eu não tive tempo para pensar sobre isso, por isso o convenci a retornar ao acampamento comigo e descobrir tudo quando saíssemos dali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030122,
					"content": "Retornamos ao acampamento, nos deparamos com Joel, e no momento que Joel o viu, ficou parado e chocado, até que começou a gritar: \"Pai! Pai!\". Foi nesse momento que Joserf começou a se lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030123,
					"content": "Papai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Joel, papai está aqui, papai está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Senhor Joserf, você não se lembra de mais nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "A Princesa Javali, e de você alimentando as raposas na montanha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "Sinto muito, não lembro de nada disso. Pode ser que minha cabeça tenha sido ferida? Não tenho certeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "Eu acordei e estava coberto de sangue. Minhas coisas haviam desaparecido, e não havia nada para indicar quem eu era ou como cheguei lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "Eu fui para uma caverna e descansei para me recuperar lentamente. Após minhas pernas e pés melhorarem, minhas habilidades como caçador foram o que me mantiveram vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Pai... Eu estava tão preocupado com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "Não é nada, Joel. Não chore. Papai não vai para canto algum, estou aqui ao seu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "Senhor Joserf, o que o você fará agora em seguida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "Eu... Eu agora só quero ficar mais um tempo com a minha família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "Você voltar é uma coisa boa. Pode-se dizer que isso daqui teve um final perfeito, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "Mas, Pallad, tropeçar e rolar montanha abaixo do nada enquanto você estava procurando não é bom. Suas habilidades de aventurar ainda precisam melhorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "Retorne para a Guilda, eu lhe darei umas boas lições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "Hã? Mas Mestre Cyrus, eu não tive sucesso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030138,
					"content": "Vá logo! De volta para a Guilda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "Mestre! Tenha pena de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708030109,
					"content": "Estou feliz que você está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Uma versão gigante de Joel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}