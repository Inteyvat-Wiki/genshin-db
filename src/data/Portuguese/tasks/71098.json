						710980925
					]
				},
				{
					"id": 710980925,
					"content": "Viajante, temo que só podemos contar com você para fazer essa Sopa de Rabanete. O Sr. Yanxiao... Bem, pode-se dizer que ele está nos ignorando há um certo tempo.",
					"roleType": "TALK_ROLE_NPC",
