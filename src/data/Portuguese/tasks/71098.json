				},
				{
					"id": 710980927,
					"content": "Creio que nos deixar usar sua cozinha é o máximo que ele permitiria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980928
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980928,
					"content": "Viajante, acho que só podemos contar com você para nos ajudar a fazer a Sopa de Rabanete.",
