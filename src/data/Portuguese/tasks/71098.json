					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980921
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980921,
					"content": "Lutong, você anotou todos os dados desta sessão culinária?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980922
					],
					"speakerTitle": "Garcia"
				},
				{
