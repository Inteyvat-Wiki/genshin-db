					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980902,
					"content": "Sim, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980903
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980903,
					"content": "Primeiro, a água... Cuidado! Preste atenção a velocidade que você a despeja, é de suma importância.",
