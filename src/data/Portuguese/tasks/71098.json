					"nextDialogs": [
						710980904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980904,
					"content": "Depois, os ingredientes. Primeiro, os rabanetes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980905
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980905,
					"content": "Hã... Isso parece mais com um experimento de alquimia do que com cozinhar...",
