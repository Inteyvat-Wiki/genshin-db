			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Senhor, creio que valha a pena mencionar que se levarmos hoje em consideração, comemos Sopa de Rabanete por seis dias seguidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Além do problema de nosso fundo monetário, creio que nossas circunstâncias gastrointestinais também não devem ser ignoradas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "Você está corretíssimo, Lutong! Sempre perspicaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Talvez seja por causa dessa questão gastrointestinal que fomos incapazes de julgar adequadamente o sabor desse prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Precisamos de uma testemunha, Lutong. Precisamos de um terceiro participante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Você me lisonjeia, senhor, mas o que eu queria dizer é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Com licença, o que vocês estão fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "Ahá! Encontramos nossa testemunha! E na verdade, duas! Formidável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "Hã? Testemunhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Você está falando de nós?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "#Exatamente! Vocês já comeram Sopa de Rabanete? São familiarizad{F#as}{M#os} com seu sabor e como fazê-la?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Senhor, talvez seja melhor primeiro explicar a nossa situação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Oh, claro que sim! {NICKNAME} sabe como fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, vamos primeiro saber mais detalhes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Sim, deixem-me explicar essa comissão. Espero que vocês possam aceitá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Eu sou Lutong, e esse é Garcia, meu chefe. Ele é de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "O Sr. Garcia está atualmente desenvolvendo... Uma coisa que ele chama de \"Aritmeticadora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Sendo mais específico, é uma ferramenta que permite a realização de vários cálculos. Não é isso, senhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Precisamente, meu caro Lutong. As funções da Aritmeticadora são concisamente estas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Sim, concisamente... Devemos ser concisos. Aquele transformador é demasiado complexo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Mas o que isso tudo tem a ver com Sopa de Rabanete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Ah, é melhor que o senhor responda isso, Sr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Mas, como podemos explicar isso sucintamente? Oh, sim! Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "Hmmm... Vamos começar com as questões mais elementares. Vocês sabem o que \"fórmulas\" são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "\"Fórmulas\"? Não exatamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Não entendo o que você quer dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Oh, tudo bem. Você pode considerar fórmulas como... Hmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "... Como uma equação utilizada para expressar relações entre várias quantidades, e que possuem uma certa aplicabilidade geral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Hã? O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Parece incrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Basicamente, queremos usar a Aritmeticadora para tentar criar a fórmula para uma receita de Sopa de Rabanete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "O Sr. Garcia acredita que se conseguirmos encontrar a fórmula correta, poderemos converter a receita de Sopa de Rabanete em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "... Em um processo padronizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "... Em um processo à prova de tontos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Se esse procedimento for seguido, qualquer um poderá cozinhar uma Sopa de Rabanete deliciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Isso soa muito complicado... Vocês não poderiam ter apenas procurado uma pessoa que ensinasse como cozinhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Infelizmente, tal método depende muito dos talentos naturais de uma pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Para pessoas como o Sr. Garcia e eu, que carecemos de qualquer talento culinário inato, é improvável que conseguíssemos compreender a essência das lições que qualquer Chef, não importa quão paciente, nos lecionasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "Na verdade, temo que o Sr. Yanxiao desse albergue passou por isso pessoalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Então você precisa de nossa ajuda para calcular essa \"fórmula\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Não, é claro que não. Eu nunca pediria que você fizesse algo tão complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "Para ser mais preciso, gostaríamos que você fosse a \"terceira parte imparcial\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "Sendo ainda mais preciso, queremos que você prove a Sopa de Rabanete que o Sr. Garcia faz de acordo com a fórmula e então nos dê suas opiniões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "#Então vocês querem que sejamos provador{F#as}{M#es}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Que simplificação exagerada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Oh, não se preocupe! Paimon nunca comeu Sopa de Rabanete feita de acordo com alguma \"fórmula\" antes! Vamos experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Bem, está decidido. Nesse caso, partamos para a cozinha. O Sr. Yanxiao nos permitiu utilizá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Sr. Garcia? O senhor me ouviu? Devemos prosseguir com os mesmos passos para esse experimento como antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Hã? Oh! Me desculpe, eu me distraí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "Tenho muitos parâmetros rebeldes passando por minha cabeça... Mas sim, vamos tentar com o nosso processo de três passos anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980143,
					"content": "Vocês precisam que lhes ensinemos a cozinhar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Hmm, também não é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980108,
					"content": "Sobre a \"fórmula\" para fazer uma Sopa de Rabanete...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109804",
							"3"
						],
						"stepId": 7109804,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao Sorridente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "Não entendo. Realmente existem pessoas que não conseguem fazer uma Sopa de Rabanete?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980302
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 710980302,
					"content": "Além disso, como vou saber as medidas exatas de cada ingrediente que usarei em cada prato?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980303
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 710980303,
					"content": "Cozinhar se trata de colocar o quanto você gosta, não? Argh, sério, nenhum Chef pensa sobre isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980304
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 710980304,
					"content": "Se não fosse pela Mora que pagaram, eu teria levado minhas reclamações para a chefe a muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980305
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 710980305,
