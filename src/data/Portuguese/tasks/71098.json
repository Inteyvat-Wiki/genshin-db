					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981503,
					"content": "Ei, respeite meu espaço!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Oh, me desculpe... Ainda assim, gostaria de saber como você fez esse prato. Quanto mais detalhes, melhor. Nunca se sabe quando a inspiração aparecerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981506,
					"content": "Você explica como fazer uma Sopa de Rabanetes detalhadamente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "*Suspiro* Há muitas variáveis envolvidas no sabor de um prato. Precisarei fazer muitos cálculos para refinar o algoritmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "Mas eu refinarei minha Aritmeticadora para que ela possa processar tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
