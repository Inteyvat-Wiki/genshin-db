					"nextDialogs": [
						710980906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980906,
					"content": "Será que pratos feitos dessa forma realmente serão gostosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980907,
					"content": "Está terminado. Uma Sopa de Rabanetes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980908
					],
					"speakerTitle": "Garcia"
				},
				{
