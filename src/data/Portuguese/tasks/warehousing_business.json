				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400501,
					"content": "*Suspiro* Quando será que o Sr. Habachi poderá ter um pouco de descanso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "Viajante, você chegou na hora certa! Por favor, nos ajude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "Agora há pouco, entregaram um lote de comida seca no vilarejo. O Sr. Habachi está se preparando para levá-los ao armazém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "Mas um grupo de Abutres Vermelhos foi atraído pelo cheiro e desceu em um rasante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Apesar de os guardas terem conseguido afastá-los rapidamente, eles espalharam a comida por todo o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "Os outros já foram alertar as outras equipes de entrega. O Sr. Habachi foi buscar o que ainda pode ser consumido daqueles alimentos... Viajante, você poderia nos ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Muito obrigada! Lamento pelo incômodo, mas eu tenho que ajudar a receber mais um lote de mercadorias, e não posso ir pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "O Sr. Habachi está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "*Suspiro* Eu disse para ele descansar um pouco, mas ele recusou. Ele falou que após buscar os alimentos, ainda iria conferir o armazém. Se continuar assim, como que a sua saúde irá aguentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "Já faz algum tempo que as mercadorias devem ter sido colocadas perto da Escadaria Branca. Viajante, por favor, nos ajude a coletar aquelas mercadorias, pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
