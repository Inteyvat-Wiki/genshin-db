			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "Viajante, você chegou na hora certa! Por favor, vá ajudar o Sr. Habachi, pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400802,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "*Suspiro* Um lote de mercadoria foi interceptada pelos Ladrões de Tesouro fora do vilarejo. Os guardas disponíveis já foram enviados para prestar ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400805,
					"content": "O Sr. Habachi disse que temos poucos homens, por isso, ele mesmo pegou uma arma e correu para fora do vilarejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400806,
					"content": "Mas ouvi dizer que os Ladrões de Tesouro são muitos, temo que o Sr. Habachi sozinho não seja páreo para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400807,
					"content": "Viajante, marquei no seu mapa o local para qual ele está se dirigindo. Por favor, vá até lá rapidamente e o ajude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400808,
					"content": "Vou partir imediatamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "Obrigada, Viajante! Espero que o Sr. Habachi não tenha problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400810,
					"content": "Como são suas habilidades em combate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "Acho que para o Sr. Habachi, enfrentar um par de Ladrões de Tesouro não deve ser um grande problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "Mas ouvi dizer que desta vez tem um grupo inteiro de Ladrões de Tesouro, e que eles emboscaram os entregadores. Se não fosse por um rápido entregador ter voltado ao vilarejo para nos avisar, é provável que ninguém saberia que eles haviam sido atacados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400813,
					"content": "*Suspiro* Se a irmã Candace estivesse por aqui, aqueles Ladrões de Tesouro não ousariam fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400814,
					"content": "Eles certamente viram uma brecha, então decidiram agir rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400815,
					"content": "Viajante, por favor, vá rapidamente ajudar o Sr. Habachi, pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400803,
					"content": "Por que você está tão nervosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
