			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ugh, esses Abutres Vermelhos! Eles não vão embora nunca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#Você é... {M#o}{F#a} Viajante? Não é isso? Ouvi aquela criança Ebeid falar de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "#Haha! Nunca imaginei que teríamos a visita de {M#um}{F#uma} Viajante em nosso vilarejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Oh! Você já encontrou com Habachi? Ele é muito sério... Se ele for um pouco grosseiro quando falar com você, por favor entenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Afinal... Muitos materiais do nosso vilarejo são armazenados neste armazém, não só comida, mas também roupas, armas e até alguns bens importantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Só temos esses jovens aqui no vilarejo, alguns fazem guarda, outros ajudam os habitantes... Habachi sempre protegeu o armazém por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Não sou de grande ajuda aqui, só posso ajudar com a contabilidade e com inventários...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "O que há com os Abutres Vermelhos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "*Suspiro* Nem fale nisso. Um lote de carne seca foi enviado para o armazém há algum tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "Eu acho que o cheiro ou algo assim atraiu esses pássaros. Enfim, eles começaram a espreitar no morro perto do armazém de tempos em tempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Eles não conseguem alcançar a carne no armazém, mas se alguém comer na frente deles, se torna um alvo fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Os guardas da vila estão sem tempo para lidar com eles, e Habachi não está disponível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "Viajante, se tiver tempo, poderia lidar com eles por nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Muito obrigada! Esses abutres são ferozes. Talvez você queira manter a distância. Eu sugiro usar um arco e flecha para se livrar deles. É mais seguro assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "O que eles atacaram antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Mercadorias em transporte, carne defumada e a marmita do Sr. Habachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Toda vez que Habachi está almoçando durante o serviço, os abutres vêm e roubam a carne dele enquanto ele não está vendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "O coitado não pode deixar o posto dele para ir atrás dos abutres, então ele tem que se virar com o que sobra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "Então, por favor se livrem dos Abutres Vermelhos para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
