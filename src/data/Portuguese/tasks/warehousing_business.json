					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "Como foi? Você cuidou deles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400402,
					"content": "Sim, tudo feito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Muito obrigada! Assim o Sr. Habachi finalmente poderá comer em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400405,
					"content": "A propósito, aqui está sua recompensa, pegue-a.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400406,
					"content": "Hã, qual é mesmo a mercadoria que vai entrar no armazém hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400403,
					"content": "Eles ficarão quietos por um tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304005",
							"2"
						],
						"stepId": 2304005,
						"stateName": "QUEST_STATE_UNFINISHED"
