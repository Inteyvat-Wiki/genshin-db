			"dialogs": [
				{
					"id": 230401002,
					"content": "*Ofegante* Muito obrigado, Viajante. Se não fosse pelas suas habilidades, esta mercadoria não estaria mais aqui agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401003,
					"content": "Você luta muito bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "Haha, fico lisonjeado. Mas acho que se enfrentasse todos eles sozinho, estaria em apuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401007,
					"content": "*Suspiro* As minhas habilidades de combate não são refinadas. Se a Srta. Candace tivesse vindo, esse bando de Ladrões de Tesouro estaria todo caído no chão agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401008,
					"content": "Sinto muito. Não é hora de dizer isso. Primeiro tenho que levar a mercadoria de volta ao vilarejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401009,
					"content": "Viajante, aqui não é muito seguro. É melhor você voltar logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401010,
					"content": "No entanto, como será que esse bando de Ladrões de Tesouro estavam tão bem informados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401005,
					"content": "Você veio sozinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "Saí do vilarejo com outros guardas, mas eles foram para outro lugar procurar pelas mercadorias.",
					"roleType": "TALK_ROLE_NPC",
