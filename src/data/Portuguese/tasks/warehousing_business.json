			"dialogs": [
				{
					"id": 230400701,
					"content": "Viajante, você coletou as mercadorias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400702,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "Perfeito! Pode botar as mercadorias ali. Muito obrigada pela ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400704,
					"content": "O Sr. Habachi já foi até o armazém para verificar as outras mercadorias. Pode deixar esses alimentos sob minha responsabilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400705,
					"content": "*Suspiro* Espero não ter muitas perdas com esse lote de alimentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
