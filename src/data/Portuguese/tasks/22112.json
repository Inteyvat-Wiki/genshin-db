					"content": "Você conseguiu encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120202,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Elas estão mesmo fora, mas perto do albergue, não é difícil encontrá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Vá e dê uma olhada. Preciso ficar aqui caso outra pessoa passe correndo e tenha um acidente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
