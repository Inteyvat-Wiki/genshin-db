			"dialogs": [
				{
					"id": 221120501,
					"content": "Acho que agora está bom, acho que ninguém mais vai cair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "Não fica muito bem com o estilo das escadas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "Não fica bem? Mas você sabe que não sou carpinteiro profissional...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Hum... Mas esta rachadura não é a única, temos mais uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Bem, por hoje é isso. A pousada ainda está aberta e eu preciso voltar a servir os convidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "As escadas são as escadas, o negócio é o negócio. Muito obrigado pela ajuda, tome, você merece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
