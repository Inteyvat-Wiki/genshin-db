					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Parece que não tem mais jeito além de consertá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Oh, é você! Olhe, as escadas estão estragadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120104,
					"content": "Está com uma grande rachadura. É fácil ter uma incidente se não a reparar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120105,
					"content": "Como que quebrou? Bem, um grupo de monstros tentaram entrar, então eu tive que lutar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120106,
					"content": "Eu deveria ter me contido, mas golpeei um monstro grande e pesado e o fiz em pedaços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120107,
					"content": "Prometi a mim mesmo que iria consertar, mas não tive tempo. E agora a pousada está ficando cada vez mais movimentada no momento. Mais uma razão pela qual esse reparo está ficando urgente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120108,
					"content": "Não é difícil, eu posso fazê-lo sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120109,
					"content": "Se você estiver com tempo, você poderia me ajudar a conseguir umas tábuas de madeira? Tenho que ficar aqui para cuidar que ninguém tropece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120110,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Ótimo. Na verdade, eu já comprei as Tábuas de Madeira, eles estão armazenados do lado de forma do Albergue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120112,
					"content": "Tenta ver se você consegue encontrar e trazer algumas de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120113,
					"content": "Se forem esmagadas outra vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "Não vai acontecer. Já não sou jovem... Vou poder me conter na próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120115,
					"content": "Mas de qualquer forma, tenho que reparar primeiro. Já comprei algumas tábuas de madeira, que estão armazenadas no Albergue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120116,
					"content": "Desculpe incomodar, você me ajude a pegar algumas tábuas lá embaixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
