			"dialogs": [
				{
					"id": 742080301,
					"content": "Sobre o Cristal Caleidoscópico misterioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742080302
					]
				},
				{
					"id": 742080302,
					"content": "Regras de sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080303
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080303,
					"content": "Excelente. Dito isso, acho que provavelmente não vamos nos encontrar de novo para conduzir outra dessas transações felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080304
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080304,
					"content": "Coisas misteriosas só são misteriosas porque são raras. Eu realmente comprei alguns Cristais Caleidoscópicos de outro aventureiro antes disso. Mas eu só o vi três vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080305
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080305,
					"content": "Segundo ele, ele conseguiu encontrar essas coisas três vezes — nunca de novo. Talvez tenha alguma lei da natureza esquisita nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080306
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080306,
					"content": "Se me perguntar, é melhor deixar os segredos deste mundo quietos.",
					"roleType": "TALK_ROLE_NPC",
