			"dialogs": [
				{
					"id": 761530101,
					"content": "O ramo editorial mal consegue sobreviver hoje em dia. Talvez eu devesse apenas focar em investimentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530102,
					"content": "Deixe-me ver os cupons de investimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "Aqui está. 2.000 Mora por cupom, com cada aplicação vencendo semanalmente. Agora entre nesta pequena bolsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530104,
					"content": "...Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530105,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "Oh, olá, Jahoda. O que você está fazendo aqui? Será que a Srta. Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530107,
					"content": "#Oh, não, não, só estou fazendo umas compras com {F#minhas amigas}{M#meus amigos}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530108,
					"content": "Hehe, parece que seu negócio de investimentos está indo bem, Chefe Dhabit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530109,
					"content": "Ah, não é nada, nada, haha... só um pequeno empreendimento para conseguir me sustentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530110,
					"content": "(Olha só pra ela... com essa cara de astuta! Aposto que tá aqui seguindo ordens de Nefer. Tsc.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530111,
					"content": "Isso realmente dá lucro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "Claro que sim! A chefe diz que o Chefe Dhabit é um comerciante com uma reputação impecável. Investir com ele sempre é uma boa opção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530113,
					"content": "Sim, sim... haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530114,
					"content": "(Nefer! Eu sabia!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530115,
					"content": "Então, quando é que eu terei o retorno de meu investimento...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "Hoje! Só hoje, o que você comprou é o nosso novíssimo... cupom de investimento de curto prazo! Lucros e perdas são liquidados imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530117,
					"content": "Por que parece que você acabou de inventar tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530118,
					"content": "Uh... e-enfim, obrigado por comprar o cupom de investimento de curto prazo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530119,
					"content": "Aqui está o seu retorno de investimento. Desejo a você um ótimo dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530120,
					"content": "Bem... ganhar dinheiro é sempre uma coisa boa, suponho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "Sério? Heehee, então a Paimon quer uma em forma de passarinho! Essa é a favorita da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530123,
					"content": "Oh, então eu vou com vocês. Acho que consigo comprar uma pra chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530124,
					"content": "Ah, Srta. Jahoda, espere só um momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530125,
					"content": "Ah, você está trazendo uma mensagem da Srta. Nefer para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530126,
					"content": "Oh, a chefe pediu para dizer: \"Encontramos o que você procura.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530127,
					"content": "\"Tenha paciência, Sr. Dhabit. Um passo de cada vez — é assim que os negócios devem ser conduzidos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530128,
					"content": "\"A—Ah, sim, tem razão, claro... Vou deixar tudo em suas mãos capazes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530121,
					"content": "Vamos, Paimon, vamos comprar algumas esculturas de açúcar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				}
			]
