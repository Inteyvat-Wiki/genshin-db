			"dialogs": [
				{
					"id": 190030601,
					"content": "Sim, você ainda tem algo a dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Sobre a folga da Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "Ah sim, a Irmã Barbara acabou de enviar uma solicitação de folga. Ela disse que tinha planos com um amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Mas devo dizer que não é comum ela pedir folga apenas para se encontrar com um amigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Bem, isso não vem ao caso, o que você queria me perguntar mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "Sobre o \"Chá Fantástico Coral Brilhante do Verão\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "#Oh? Você quer dizer que a Barbara pretende acompanhá-l{F#a}{M#o} para comprar essa... bebida especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "#Então, presumo que você seja {F#a amiga}{M#o amigo} que ela mencionou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "#Bem, como vocé é Cavaleir{F#a}{M#o} Honorável, acho que está tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Certo, eu entendo. Por favor, cuide bem da Irmã Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Por que a Barbara sempre tem que reportar seus planos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Bem, como você já deve saber, a Irmã Barbara é bastante popular em Mondstadt por diversas razões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Apesar dos cidadãos daqui estarem agindo com boas intenções, há muitos deles, e a Irmã Barbara não consegue lidar com tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Se eles aparecerem enquanto ela está trabalhando na Igreja, podemos vir e intervir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Mas se os fãs delas se aproximam dela durante sua folga, então ela terá que lidar com isso sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "E sem falar que ela é muito... Simpática. Ela sempre vai satisfazer os desejos das pessoas de Mondstadt, mesmo que isso a deixe extremamente cansada trabalhando por horas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Por causa disso, pensamos que fosse melhor sempre saber por onde ela está, caso precisemos salvá-la de multidões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Meu desejo é que a Barbara não precisasse trabalhar tão duro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
