				},
				{
					"id": 190030702,
					"content": "Sobre o itinerário de Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030703
					]
				},
				{
					"id": 190030703,
					"content": "Oh, a Irmã Barbara quer ir no Bosque Sussurrante colher ervas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030704
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030704,
					"content": "Entendo... Na verdade, a Irmã Barbara requisitou uma licença de meio dia para encontrar com um amigo. Agora do nada ela quer ir colher ervas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030705,
					"content": "Mas, tenho certeza que a Irmã Barbara tem suas razões. Você estará acompanhando ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030706,
					"content": "Sim, acompanharei ela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030707
					]
				},
				{
					"id": 190030707,
