			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "Ah, você voltou de novo. Se você estiver procurando a Irmã Barbara, ela ainda não voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "Encontramos a Barbara no Reino dos Lobos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Ah, entendo. Graças ao Barbatos, ela está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "Mas parece que ela não vai voltar tão cedo. Talvez tenhamos que passar as responsabilidades da Catedral para mais alguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "Podemos ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Bem, isso é muito gentil da sua parte, certamente não quero causar problemas para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "Deixe-me pensar por um momento... Ah sim, você podia ajudar a dar uma limpada na Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "As pessoas tendem a sujar a Catedral, então o chão costuma ficar sujo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "Essas coisas eram da responsabilidade da Irmã Barbara, então agora que ela não está, as coisas estão começando a ficar sujas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "Barbara é responsável por limpar um lugar tão grande desses sozinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Sim, isso mesmo. Ela sempre disse que podia fazer as coisas sozinha e não precisava de ajuda de ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "Mas ela parece sempre muito cansada depois de terminar a limpeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "Para ser honesta, eu estou muito surpresa que você queira ajudar... Aliás, que ela tenha aceitado a sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "No entanto, isso pode ajudá-la a tirar um pouco o peso do trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "#Enfim, vou deixar a limpeza com você agora, Cavaleir{F#a}{M#o} Honorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "A Barbara está na Adega do Alvorecer visitando Tunner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
