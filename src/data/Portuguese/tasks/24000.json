						],
						"pointId": 4415
					}
				]
			},
			"dialogs": [
				{
					"id": 240000101,
					"content": "Repito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000102,
					"content": "Sr. Livre, eu entendo seu pedido e estou disposta a auxiliá-lo no máximo que puder, mas... Bem, por favor, confira esta solicitação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000103,
					"content": "A pessoa responsável aqui é o Sr. Clapiers. Todos os materiais que você entregou anteriormente são para ele organizar e resolver. Além desta pessoa responsável, nenhum de nós pode trabalhar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000104,
					"content": "Ele está atualmente fora a negócios e não está no escritório. O carimbo oficial dele é necessário antes que os seus materiais possam entrar em nosso sistema de cálculo de despesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000105,
					"content": "É, é! Quer saber? Eu já estive aqui três vezes — você vai lidar com meu caso ou não vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000106,
					"content": "Por favor, se acalme, Sr. Livre. Há apenas duas pessoas no escritório do Sr. Clapiers — o outro é o Sr. Monthois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000107,
					"content": "Mas ele está bem velho e está esperando a aposentadoria. Na verdade, ele não fez nenhum trabalho de escritório há um tempo. Ele nem recebe mais um salário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000108,
					"content": "Então eu apenas vou ao escritório e vou fazer o velhote carimbar minhas coisas. Arcontes, eu mesmo carimbo se chegar a isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000109,
					"content": "Sinto muito, mas isso não é possível. Primeiro, vai contra as regras, e em segundo lugar, a chave para o carimbo está com o Sr. Clapiers e somente ele pode acessá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000110,
					"content": "Quanto a mim, tenho outras coisas para fazer também... Por favor, acredite em mim quando digo que o Sr. Clapiers retornará para ajudá-lo a resolver este assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000111,
					"content": "...Tudo bem. Tenha um bom dia, Srta. Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000112,
					"content": "Você também, Sr. Livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000113,
					"content": "Cornelia sai com pressa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "Parece que terei que voltar de novo, hein... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000115,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "Nada, na verdade. Eu só desperdicei meu tempo — meio dia, precisamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000118,
					"content": "Estou farto disso aqui com esse tal de Clapiers! O Palais Mermonia encomendou algumas máquinas mecânicas de nós, mas eles ainda não pagaram por elas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000119,
					"content": "A primeira vez que vim procurar por ele, ele me disse que o escritório estava fazendo uma auditoria interna mensal e só podia liberar os fundos à partes externas no mês seguinte — assim, minha solicitação não podia ser processada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000120,
					"content": "Na segunda vez que vim, ele alegou que estavam sem tinta para carimbo e o armazém das tintas havia sido incendiado, o que significava que precisavam comprar tinta de outro lugar. Isso, por sua vez, significou que minha solicitação não pôde ser carimbada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000121,
					"content": "Na terceira vez, ele alegou que o Formulário de Registro de Equipe de Assistência Externa havia sido atualizado e precisava ser preenchido novamente — e claro, eles estavam sem formulários e os novos só chegariam no dia seguinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000122,
					"content": "Eu ia vir hoje e pegar um, mas ele nem está no escritório. Arcontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000123,
					"content": "Hmm? Sr. Livre? Por que você parece tão chateado? Posso ajudar com alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000124,
					"content": "Srta. Rhemia! Que bom te ver. Isso foi o que aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000125,
					"content": "A história é cuspida para fora pela boca de Livre...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "Ah, Sr. Clapiers... Ele não é fácil de encontrar, claro, mas ele realmente está em Erinnyes no momento, e não no Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000127,
					"content": "Independentemente do caso, entretanto, vamos pegar o formulário para você primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000128,
					"content": "Hã? Mas Clapiers disse que não tinha mais formulários...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000129,
					"content": "Eu tenho uma maneira de resolver seu problema. Se me lembro bem, algumas lojas que têm acordos de longo-prazo com o Palais Mermonia tiveram o mesmo problema que você tem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000130,
					"content": "A solução deles é vir regularmente ao Palais de tempos em tempos para coletar formulários e documentos que possam precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000131,
					"content": "Isso facilita concluir e entregar formulários por um lado, e os mantém a par de mudanças feitas em tais documentos, pelo outro... \"Recompensa estar preparado\", como dizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000132,
					"content": "Assim... foi como todos os formulários desapareceram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000133,
					"content": "E é por isso que eu diria que estas lojas devem ter estes formulários extras, então vamos fazer uma visita a elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000134,
					"content": "Além disso, tenho certeza que elas estariam mais do que dispostas a ajudar quando souberem de suas viagens fúteis ao Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000135,
					"content": "Ah, sim. É melhor a gente pegar os formulários que você precisa e os deixar preenchidos, e trazê-los ao escritório do Sr. Clapiers antes do horário de funcionamento do Palais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000136,
					"content": "#Estaria dispost{M#o}{F#a} a ajudar, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000137,
					"content": "Viajante, por favor, me ajude! Se eu não conseguir fazer isso, receio que outra noite em claro me aguarda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000138,
					"content": "Tudo bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "Você só precisa conferir essas duas lojas e tentar pegar emprestado a versão mais nova do Formulário de Registro de Equipe de Assistência Externa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000141,
					"content": "Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000142,
					"content": "Por favor vá à forja de Estelle e à relojoaria de Caron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000143,
					"content": "Há não muito tempo, Estelle ajudou a consertar os postes de luz do Palais, enquanto Caron estava envolvido em ajustar os relógios deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000144,
					"content": "Eles geralmente aceitam serviços do Palais, então certamente eles terão um formulário com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000145,
					"content": "Contaremos com a sua ajuda sobre esses locais e, enquanto isso, Livre e eu nos separaremos para ir às outras lojas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000139,
					"content": "Mas o que eu preciso fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "O que você encontrou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
			"id": 2400002,
