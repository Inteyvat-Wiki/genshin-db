			},
			"dialogs": [
				{
					"id": 240000201,
					"content": "Que dor... É só um pouco de Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "Sobre o Formulário de Registro do Solicitante Externo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "Você descreve as experiências e desejos de Livre para pegar o formulário emprestado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "*Suspiro* Que azar para o Livre... Receio que não tenho nenhum sobrando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000205,
					"content": "Eu trouxe um funcionário da loja para me ajudar quando eu estava consertando a iluminação pública no Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000206,
					"content": "Agora, ele quase não ajudou, então eu não coloquei o nome dele no formulário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000207,
					"content": "Mas quando chegou o momento de entregar o formulário, Clapiers insistiu que eu colocasse todos os nomes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000208,
					"content": "Ele até disse que haveria \"consequências sérias e imprevisíveis\" se eu não preenchesse verdadeiramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000209,
					"content": "Sério, é só um nome faltando. Quais consequências sérias poderiam acontecer? Absurdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
		{
			"id": 2400003,
			"completionStepIds": [
				2400003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
