			"dialogs": [
				{
					"id": 240000301,
					"content": "Que cansativo... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000302
					],
					"speakerTitle": "Caron"
				},
				{
					"id": 240000302,
					"content": "Sobre o Formulário de Registro do Solicitante Externo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000303
					]
				},
				{
					"id": 240000303,
					"content": "Você descreve as experiências e desejos de Livre para pegar o formulário emprestado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000304
					]
				},
				{
					"id": 240000304,
					"content": "Isso acontece com frequência quando você está lidando com o Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
