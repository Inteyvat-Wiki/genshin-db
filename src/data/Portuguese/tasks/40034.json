					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "Ah, você está aqui, como esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340103,
					"content": "Atualmente o Ryuuji está investigando a Ilha Yashiori para seguir alguns de meus palpites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340104,
					"content": "Deixe-me marcar os locais em seu mapa. Se você se apressar, ainda terá tempo de alcançá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340105,
					"content": "Por que estamos com tanta pressa? Ryuuji não iria nos encontrar aqui e sair junto conosco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340106,
					"content": "Porque esta investigação está se aproximando rapidamente de seu fim, é claro. Apresse-se. Estamos prestes a testemunhar a verdade que virá à tona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 400340107,
					"content": "#Ooh, agora que você falou dessa forma, Paimon está ficando toda animada! Vamos lá, {NICKNAME}, vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "Ryuuji! Estamos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340202,
					"content": "#Ah, são vocês {M#dois}{F#duas}. Sango me enviou aqui para fazer algumas investigações preliminares, dizendo que vocês chegariam em breve. E de fato, vocês chegaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340203,
					"content": "Bem, ela nos disse que você estaria aqui! Como está indo tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340204,
					"content": "Hã. Aqui não há nada além de um monte de gaiolas para pequenos animais. Onde estão as pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340205,
					"content": "Eles acabaram de sair. São os Ladrões de Tesouro. Sango me disse que eles estavam planejando roubar cães e treiná-los para se tornarem os Cães de Caça ao Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340206,
					"content": "Tipo o Furão Ladrão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "Exatamente. O problema dos furões é que eles são criaturas maliciosas e difíceis de ensinar. Como tal, seu treinamento foi um fracasso. Desta vez, eles estavam planejando tentar novamente, mas com \"cães\" mais leais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340210,
					"content": "Anteriormente, também lidamos com várias missões relativas aos Ladrões de Tesouro. Agora que pensei nisso, Sango também estava certa a esse respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340211,
					"content": "Assim como as pessoas deixam pegadas para trás, as organizações também deixam traços únicos. Embora houvesse outros animais perdidos e aprisionados que surgiram ao longo deste processo, os sinais acabaram por apontar de volta para os Ladrões de Tesouro, de qualquer forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340212,
					"content": "Eu me referi à solução na época, e depois investiguei aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340213,
					"content": "Ainda assim, não deixar sequer um para trás para ficar de guarda... Devo dizer que estes criminosos são muito descuidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400340214,
					"content": "#Isso é muito complacente da parte deles! Ainda assim, Paimon tem certeza de que até você está cansad{M#o}{F#a} depois de tantos dias de luta, não é mesmo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340215,
					"content": "Bem, já que ninguém está em casa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "Sim, isso é o que Paimon estava pensando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400340216,
					"content": "Acho que podemos pegar os animais sem ninguém ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "Parecida com a Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
