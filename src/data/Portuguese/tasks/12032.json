			"trigger": {
				"objectNames": [
					"Shogun Raiden",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Inazuma ainda tem muitos desafios pela frente, mas eu estou preparada para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320102,
					"content": "Sobre os \"desafios\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Abolir o Decreto Sakoku tem muitas implicações. Seria imprudente dizer que todas são positivas, e que não há repercussões negativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320104,
					"content": "Por exemplo, já consigo imaginar que o mundo exterior se tornará uma ameaça para os negócios de Inazuma. Precisarei resolver esta questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320105,
					"content": "Ei, você pensou muito sobre isso, não foi? Eu só pensei se conseguirei ou não vender bilhetes de entrada para o Grande Santuário Narukami no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Miko, sério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320107,
					"content": "Sobre a atenção divina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "O olhar de Makoto sempre esteve fixo no povo de Inazuma. Sempre assumi que isso era... o seu dever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320109,
					"content": "Mas agora entendi que seu olhar era cheio de expectativa e esperança. Não era apenas seu dever, era também sua alegria. Ela sempre amou a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320110,
					"content": "Se as pessoas no passado mereceram a atenção dos deuses, também a merecerão no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Sim. Não voltarei a ignorar suas paixões ou sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320112,
					"content": "Sobre o duelo que durou séculos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Para dizer a verdade, era uma tortura sem fim à vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320114,
					"content": "Enfrentando uma batalha sem fim, tive que me manter concentrada todo o tempo. Se minha concentração fosse desviada por um segundo, a lâmina da Shogun já teria cortado meu pescoço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320115,
					"content": "Pode se dizer que, se não fossem minhas experiências anteriores de combate, minhas habilidades não teriam sido suficientes para este desafio. É provável que tivesse sido derrotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320116,
					"content": "E você também teve sua parte nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320117,
					"content": "Sobre o dano a Sakura Sagrada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Não se preocupe, eu não me esqueci e irei ordenar à Comissão Tenryou e Comissão Yashiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320119,
					"content": "Não estou preocupada apenas com os monstros. Também me preocupo com o que mais possa escapar da Sakura Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320120,
					"content": "Isso é difícil de dizer... Há muito mais do que memórias presas nas Linhas Ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Já que você sabe do que se trata, talvez possa fazer um esforço também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320122,
					"content": "Yae Miko falou que a deusa dela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "#*Cof* Yae Miko não disse nada do gênero, e {M#o}{F#a} Viajante tem muita cara de pau em criar afirmações sobre ela em sua presença!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Algumas palavras não devem ser repetidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Acredite, você não quer saber o custo de me trair. Apenas pense nas coisas que te contei como nosso segredo. Entendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "Do que vocês estão falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320127,
					"content": "Nada, me deu vontade de comer tofu frito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "Não tenho mais perguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}