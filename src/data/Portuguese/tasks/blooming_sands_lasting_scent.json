			"trigger": {
				"objectNames": [
					"Raef",
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "Nermin, Viajante? O que vieram fazer aqui? Aconteceu algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "Não diga que as plantas deram problema, é isso? Eu ainda estou no expediente, mas quando acabar eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "A Nermin tem algo para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "Aqui, um perfume! A fragrância é de Menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420605,
					"content": "Eu queria fazer com fragrância de Pêssego Zaytun, mas toda vez que eu colocava Pêssegos Zaytun na receita, o perfume acabava grudento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420606,
					"content": "O-obrigado... mas esse \"perfume\" serve pra quê? Repelente de insetos? Ou pra marcar uma trilha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "É pra te deixar mais alerta, e cobrir cheiro do seu suor. Você não fica tonto de sentir o cheiro do seu suor todo dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420608,
					"content": "Bem, acho que acabei me acostumando com o cheiro. Acho que sentiria falta se ficasse sem ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "Não quer não usa. Me devolve aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420610,
					"content": "Ei! Calma, é brincadeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Rápido, me dá o perfume! Já estou começando a ficar zonzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Aqui. A vovó Jawahir disse que só precisa passar nos braços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420613,
					"content": "Esse cheiro é bom mesmo, bem revigorante. O lugar onde passei ficou fresquinho e gostoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Hehe, é uma receita secreta da vovó Jawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420615,
					"content": "#Só consegui fazer um perfume tão bom graças à ajuda d{F#a}{M#o} Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420616,
					"content": "Ajudei só um pouquinho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Te pedi tantos favores, sinto muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Aqui estão suas recompensas, muito obrigada mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "Esse perfume é mesmo muito bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Mas... é... Nermin, por que estão aparecendo essas manchas onde eu passei o perfume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
