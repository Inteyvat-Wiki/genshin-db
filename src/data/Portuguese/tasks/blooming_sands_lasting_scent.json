				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "O Raef com certeza vai ficar surpreso, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "Surpreso com o que?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "Ai! Que susto, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "Eu cheguei bem pela sua frente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Eu estava concentrada, nem percebi você chegando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "Viajante, eu queria te perguntar... você já ouviu falar de algo chamado \"perfume\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "A vovó Jawahir me contou que quando era jovem, ela mesma fazia perfume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "Não apenas podem cobrir o cheiro de suor no corpo das pessoas, mas certos perfumes possuem propriedades revigorantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "O Raef sempre trabalhou como guarda na entrada do vilarejo, e todo dia o calor deixa ele encharcado de suor. Quando volta para casa, sempre reclama que o calor deixa ele tonto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "Então eu decidi preparar um frasco de \"Perfume de Menta\" para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "A vovó Jawahir me escreveu a receita do perfume e me ajudou a comprar muitos materiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "Mas fazer perfume é bem mais difícil do que eu esperava... Pegar os ingredientes por si só já levou um tempão, e depois na hora de fazer já errei tantas vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "Se continuar desse jeito, o Raef vai acabar descobrindo que estou fazendo perfume para ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "#Viajante, será que você pode me ajudar a buscar alguns ingredientes? Mas seja discret{F#a}{M#o}, o Raef não pode descobrir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Qual é o problema em contar pra ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Nem pensar! Essa é uma surpresa que estou preparando há muito tempo, não quero que seja arruinada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "Na verdade não vou te dar muito trabalho. Só precisa pegar a mercadoria que encomendei com o Sr. Azalai, mais um balde de água e pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "#Não se esqueça, seja discret{F#a}{M#o}! Não deixe o Raef suspeitar de nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "*Suspiro* ...Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "#Muito obrigada mesmo! Não se preocupe, você vai ser muito bem recompensad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
