			"dialogs": [
				{
					"id": 230420301,
					"content": "#Bem-vind{F#a}{M#o}! Como posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "É sobre a \"encomenda\" da Nermin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Ah, entendi... já está pronta. Aqui tem umas especiarias de ótima qualidade, e com um preço bem razoável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Imagino que Nermin esteja planejando fazer perfume com esses ingredientes, acertei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "*Suspiro* É bom ser cheia de energia assim, mas a Nermin precisa prestar mais atenção em sua saúde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
