			"dialogs": [
				{
					"id": 700890101,
					"content": "Hã, tem alguém aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890102,
					"content": "Essa também não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890103,
					"content": "Ei, o que você está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Estou tentando encontrar o caminho de volta. Só me lembro de que preciso encontrar uma Estátua do Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890105,
					"content": "Não me lembro de mais nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890106,
					"content": "O seu caminho de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "É uma vaga sensação de saudade de casa, mas não consigo me lembrar de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890108,
					"content": "Quando acordei, a única coisa que eu tinha era um bilhete na minha mão que dizia: \"Você é o 'Maukie'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890109,
					"content": "Então eu suponho que meu nome é Maukie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890110,
					"content": "Acho que já vou indo. Tchau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890111,
					"content": "Que pessoa estranha. Mas ele não parece ser um cara ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "Você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "Eu tive uma visão estranha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "Uma visão estranha? Será que é porque aquela pessoa tocou na estátua agora há pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
