					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "Eu sou uma acadêmica profissional, sabe? Não cometo erros de principiantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "Ok, muito obrigada pela ajuda, não tenho nenhum jeito para os monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
