			"dialogs": [
				{
					"id": 220070101,
					"content": "Onde ela está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Quando estava investigando uma ruína, alguns monstros me atacaram de repente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070104,
					"content": "Eu fiquei em pânico e fugi com pressa, e devo ter perdido a relíquia ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070105,
					"content": "Após os monstros terem saído, voltei e a relíquia já tinha sumido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070106,
					"content": "Eu procurei o dia inteiro, mas não encontrei. Talvez os monstros a tivessem pegado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070107,
					"content": "Você pode ir buscar para mim? Se você encontrar, por favor a guarde nesta caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
