			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ah, Mestre Diluc. Você viu aqueles dois ladrões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "O que aconteceu? Por que vocês mobilizaram tantos guardas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Você ainda não sabe, Mestre Diluc? Dois ladrões estavam tentando roubar a Lira Sagrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Hum? Isso é estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Não é mesmo? A Lira Sagrada é um tesouro que foi tocado pelo mesmo Arconte Anemo. Uma grande peça de valor cultural...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Por que alguém iria querer roubar algo que não poderiam vender? Seria até melhor roubar coisas da minha adega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Desculpe, me desviei do assunto. Aquelas duas pessoas foram para aquele lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Entendido, obrigado, Mestre Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
		{
			"id": 37607,
