					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "Eu gostaria de beber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760702,
					"content": "Devolva a garrafa que você roubou da vitrine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760703,
					"content": "... Algo gelado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760704,
					"content": "Agora, você deveria responder minhas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760705,
					"content": "Deixe-me terminar minha bebida primeiro? Eu lhe pagarei - bem, com uma apresentação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760706,
					"content": "Não é questão de dinheiro. Você parece muito jovem para beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760708,
					"content": "Que tal responder minhas perguntas primeiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "Quem é esse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "Não se preocupe. Quando eu estava bebendo, você estava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760709,
					"content": "Você quer saber quem é, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760711,
					"content": "Ele é o Sr. <color=#00E1FFFF>Diluc</color>, o chefe... O dono desta Taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760712,
					"content": "Ele é muito famoso. Aliás, esta Sidra de Dandelion é minha favorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760713,
					"content": "Embora a maioria das vezes eu só consiga comprar uma ou duas garrafas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760714,
					"content": "Eu acabei de ouvir notícias dos ladrões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760715,
					"content": "Primeiro de tudo, admiro vocês terem coragem de tentar roubar a Lira Sagrada der Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760716,
					"content": "Mesmo que vocês sejam tolos, é difícil de encontrar pessoas como vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760717,
					"content": "Não fomos nós que roubamos nada! O verdadeiro ladrão ainda está por aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3760718,
					"content": "#{M#Este}{F#Esta} é a nova estrela dos Cavaleiros de Favonius. Por que alguém iria roubar o tesouro sagrado de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760719,
					"content": "Nova estrela? Ah, é você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760721,
					"content": "Na verdade, não somos tão próximos assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "Eu apenas ouvi ele tocar uma vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "Então, você e o bardo são amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760723,
					"content": "#Bem, apesar de ser apenas {M#um}{F#uma} Viajante, você contribuiu com sua ajuda para Mondstadt no tempo certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760724,
					"content": "É uma pena que uma pessoa como você tenha se juntado aos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760725,
					"content": "Os Cavaleiros de Favonius... Ineficientes do início ao fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760726,
					"content": "Em relação aos <color=#00E1FFFF>Fatui</color>? Eles também são fracos e conservadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760727,
					"content": "Esquece. Não quero falar sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760728,
					"content": "Parece que você não gosta dos Cavaleiros de Favonius, Mestre Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760729,
					"content": "Eu estou apenas seguindo um caminho diferente deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760730,
					"content": "Eu tenho as minhas próprias esperanças com Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760731,
					"content": "Agora, me responda. Por que você roubou a Lira Sagrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760732,
					"content": "Você tem certeza de que deseja saber? Você pode se envolver em problemas com os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760733,
					"content": "...Tudo bem. Eu sou um causador de problemas mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760734,
					"content": "Se eu contar a história através de uma canção, você acreditará em mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760735,
					"content": "Depende. Eu vou ter que ouvir primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760736,
					"content": "E você vai me pagar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760737,
					"content": "O pagamento vai de 5 Mora até a Lira Sagrada. Dependerá da sua história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760738,
					"content": "Muito bem. Vou fazer o meu melhor para o espetáculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760739,
					"content": "O que foi que eu acabei de ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760740,
					"content": "Isso é uma informação confidencial. Por que você me deixou saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760741
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760741,
					"content": "Por quê? Bem, talvez a direção do vento esteja mudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760742,
					"content": "O que você acha, Mestre Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760743
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760743,
					"content": "Interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760744
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760744,
					"content": "Me dê um pouco de tempo. Eu preciso procurar alguns contatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760745
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760745,
					"content": "#Forasteir{M#o}{F#a}, você como {M#um}{F#uma} dos cavaleiros, não parece ser {M#um}{F#uma} suspeit{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760746
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760746,
					"content": "A única descrição do cartaz é \"cabelos loiros\". Você não precisa se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760747
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760747,
					"content": "Mas é melhor que você fique na Taverna, Bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760748
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760748,
					"content": "Sem problemas! Eu gosto de Tavernas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760749
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760749,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760750
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760750,
					"content": "Tudo bem. Vamos nos encontrar aqui depois da Taverna fechar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760751
					],
					"speakerTitle": "Diluc"
