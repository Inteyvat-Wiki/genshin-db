			"dialogs": [
				{
					"id": 761970120,
					"content": "(test)Texto do roteiro",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Durante meus anos no mar, eu já ouvi um chamado vindo de lugar nenhum. Os outros não reagiram, mas eu fui cativado quase instantaneamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Deve ter sido uma voz de outro mundo. Eu também ouvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Só depois que percebi... Aquele chamado carregava com ele cada sonho que nunca chegou longe. Dá até para chamar de uma reunião de arrependimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Você devia trazer uma Pedra Congelante com você. Olhe pelo buraco no centro e você vai ver quem está te chamando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Mas na época, eu ainda era um jovem temperamental. Até o perigo parecia uma oportunidade para mim. Então eu fui direto, sem pensar por nem um segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Dizem que o buraco no centro da Pedra Congelante é um portal para outro mundo... Mas como exatamente a gente devia atravessar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "E depois disso... o mar e os ventos agitados levaram tudo de mim: minha riqueza, minha honra e até minha família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Aventuras movidas pela ambição e desejo nunca acabam bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, ficou preso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Me deixe te ajudar com isso. E na próxima, tente não repetir isso, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Linnea! O que te traz aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Estou coletando Pedras Congelantes por perto. Vi vocês conversando e pensei em vir dar um oi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Ah! Talvez você consiga usar uma Pedra Congelante para abrir um portal para outro mundo, Linnea! Se alguém consegue, tem que ser você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Nem eu consigo fazer isso. Eu já não disse antes? Isso é só um conto folclórico que as pessoas inventaram. Não há evidência concreta por trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Ugh... Parece que isso não vai funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "...Ah. Então você estava ouvindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Ahem... não. Não sou a pessoa que costumava ser. Esses dias, estou contente com o que tenho, e não quero nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Que pena. Então vou te ajudar a coletar Pedras Congelantes também, Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Seria ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Com a ajuda de Auni, os materiais foram coletados rapidamente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Obrigada, mas já coletei tudo que precisava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Tudo bem, então. Vou para o Vale Toupeirado ver o Vovô Toupeirinha e os outros. Até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
