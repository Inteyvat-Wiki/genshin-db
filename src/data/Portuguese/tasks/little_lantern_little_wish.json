			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mengmeng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "Como é difícil fazer Lanternas Celestes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "Você sabe como fazer Lanternas Celestes? Eu continuo tentando, mas não consigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410104,
					"content": "Pelo buraco, depois volta, e depois... Eu deixo cair. Ou ele quebra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410105,
					"content": "Eu realmente queria fazer uma Lanterna Celeste para Yu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410106,
					"content": "Yu sempre tem que cuidar da loja de chá, então ele nunca tem tempo para brincar ou para fazer uma lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410107,
					"content": "Mas aposto que ele ainda tem um desejo. Por isso, quero fazer uma lanterna para ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410108,
					"content": "Eu posso fazer uma para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "Mas, mas... Eu queria que fosse eu a fazer isso por ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410111,
					"content": "E, e... Quero saber os segredos para fazê-las, para poder contar ao Yu também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410112,
					"content": "Você poderia... Me ensinar como fazê-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410113,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "Yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410115,
					"content": "Então, então... Então a Lanterna Celeste está pronta, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410116,
					"content": "Valeu! Vou fazer um para a Yu agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410109,
					"content": "Eu farei uma para ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "#O—oi... {F#Cara}{M#Caro} cliente, hmm, hmm... Por favor, ponha os pés para cima, tome um pouco de chá e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410203,
					"content": "Estamos aqui para lhe dar uma Lanterna Celeste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "... Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410205,
					"content": "Yu, a Lanterna Celeste é para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410206,
					"content": "Mengmeng? Oh, você fez isto...? Uau... Obrigado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410207,
					"content": "#Foi {M#esse}{F#essa} Viajante que me ensinou, mas não faço bem, você... Você gosta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410208,
					"content": "Você está brincando? É fantástica, eu amei! Estava começando a me preocupar quando teria tempo de fazer uma para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410209,
					"content": "Obrigado, Mengmeng. Encontrarei alguém para pendurá-la em minha porta daqui a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410210,
					"content": "Pendurá-la? Para quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "Bem, a questão é que... Meu pai não está com muita saúde, então ele não pode pendurá-la para mim. E eu sou muito baixinho, então eu certamente não seria capaz de alcançar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410213,
					"content": "Então, se eu quiser pendurá-la na porta, tenho que perguntar a alguém por aqui se eles podem ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410214,
					"content": "Podemos ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "Sério? Tem certeza de que não se importa de ajudar? ... Isso é ótimo, obrigado! Agora não preciso me preocupar com quem vigiaria a loja se eu saísse procurando alguém para ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410215,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "Alguém da sua família não poderia ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134104",
							"2"
						],
						"stepId": 4134104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "Esta Lanterna Celeste está tão bonita! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410402,
					"content": "Vamos lá, Yu... Vamos brincar. Eu conheço um ótimo lugar com as flores mais bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410403,
					"content": "#{M#O Viajante}{F#A Viajante} me ensinou há pouco a fazer lanternas celestes. Vem comigo e eu te ensino, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410404,
					"content": "Eu, uh... Não posso. Preciso vigiar a loja. Mesmo não tendo clientes, eu tenho que manter o lugar bem limpinho, assim como meu pai sempre diz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410405,
					"content": "Certo, bem... Esqueça as Lanternas Celestes, que tal irmos até lá, conversarmos um pouquinho e depois voltarmos imediatamente? Dessa forma, não tomará muito do seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410406,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410407,
					"content": "Eu posso limpar a loja para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "... Oh? T-Tem certeza? Isso, uh... Isso é pedir muito de você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410410,
					"content": "Seremos bem rápidos, vamos direto para lá e voltaremos direto. Prometo que não vai levar muito tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410411,
					"content": "Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410408,
					"content": "Deixe a limpeza por minha conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
			"completionStepIds": [
				4134107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134107",
							"2"
						],
						"stepId": 4134107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410701,
					"content": "Parece que os dois ainda estão brincando. Acho que não temos que nos preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410702,
					"content": "Mas dada a atmosfera... Talvez não devêssemos incomodá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410703,
						413410704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413410703,
					"content": "Eu queria escutar o que eles estão falando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410705
					]
				},
				{
					"id": 413410705,
					"content": "Se fizéssemos uma coroa de flores para o seu pai, você acha que ele melhoraria mais rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410706
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410706,
					"content": "Eu... Eu não sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410707
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410707,
					"content": "Li em um livro que se você continuar feliz, mesmo que adoeça, você vai melhorar muito mais rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410708
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410708,
					"content": "Acho você tão adulto, a forma como ajuda seu pai a vigiar a loja todos os dias... E tenho certeza de que isso deve deixá-lo muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410709
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410709,
					"content": "Mas às vezes ele me manda embora... \"Pare de ficar só na loja, saia e brinque\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410710
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410710,
					"content": "\"Se você não for brincar com a Mengmeng, ela vai colher as flores inteiras do bairro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410711
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410711,
					"content": "Isso nunca aconteceria, tem tantas flores por aqui... Espere um segundo, vou fazer uma coroa de flores para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410712
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410712,
					"content": "Obrigado, Mengmeng. Eu deveria voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410713
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410713,
					"content": "Hum, está bem... Bem, assim que seu pai estiver recuperado, você terá mais tempo, certo? Então eu posso ir brincar com você novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410714
					],
					"speakerTitle": "Mengmeng"
				},
				{
					"id": 413410714,
					"content": "Sim, tenho certeza que meu pai terá uma recuperação rápida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410715
					],
					"speakerTitle": "Yu"
				},
				{
					"id": 413410715,
					"content": "Mas que...! Qu-Quando você chegou aqui?",
					"roleType": "TALK_ROLE_NPC",
