			"dialogs": [
				{
					"id": 740990101,
					"content": "Sobre capturar monstros ao invés de peixes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Oh! Agora que penso nisso... Foi uma experiência única ver minha própria isca atraindo monstros ao invés de peixes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Embora eu não tenha medo de monstros, eu costumava fazer o trajeto entre o Instituto de Pesquisas de Fontaine e a Corte de Fontaine sozinha. Eu lutei muitas vezes contra bandidos pelo caminho e venci na maioria das vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Mas agora eu sou a gerente da Associação de Pesca, então devo me comportar como uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Se eu assustar os peixes ou causar problemas para os pescadores dos arredores, acho que contaria como uma falha minha em atingir as expectativas das pessoas sobre uma gerente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "É por isso que devo prosseguir com controle e cautela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		}
	]
