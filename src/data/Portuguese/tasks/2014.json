				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140601,
					"content": "Kokomi, voltamos - Oh, veja, Gorou está aqui também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140602,
					"content": "O que aconteceu? Eles parecem tão sérios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140603,
					"content": "Aproximadamente quantas pessoas estão exibindo esses sintomas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140604,
					"content": "Ainda não tive a chance de fazer uma contagem completa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140605,
					"content": "Kokomi, Gorou... O que está acontecendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140606,
					"content": "#{NICKNAME}, recentemente alguns de nossos soldados começaram a mostrar sintomas de envelhecimento acelerado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140607,
					"content": "Eu os chamei para serem interrogados e descobri que eles haviam adquirido privadamente algumas armas secretas de nosso patrocinador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140608,
					"content": "A maioria deles são indivíduos altamente ambiciosos, que se opõem veementemente ao Decreto de Caça à Visão. Eles têm usado essas novas armas em segredo desde que as adquiriram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140609,
					"content": "É por isso que a guerra tem corrido excepcionalmente bem... Mas as armas secretas arriscadas não são a resposta. Devemos pôr um fim a isso imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140610
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140610,
					"content": "Gorou, você conseguiu adquirir uma dessas armas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140611
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140611,
					"content": "A maioria dos oficiais se recusaram a entregar as armas. Mas mesmo assim eu dei um jeito de conseguir uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140612
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140612,
					"content": "Isso é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140613
					]
				},
				{
					"id": 20140613,
					"content": "#{NICKNAME}, você sabe algo sobre isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140614
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140614,
					"content": "É uma Ilusão dos Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140615
					]
				},
				{
					"id": 20140615,
					"content": "Então isso significa que nosso patrocinador secreto são os Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140616
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 20140616,
					"content": "Mas por qual motivo os Fatui fariam algo assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140617
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140617,
					"content": "Esqueça isso, não temos tempo. Neste momento, precisamos informar todo o exército para cessar imediatamente o uso de suas Ilusões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140618
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140618,
					"content": "Todos os soldados que mostraram sintomas devem ser levados para tratamento. Só espero que cheguemos a tempo de salvá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140619
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 20140619,
					"content": "#Espere um momento... {NICKNAME}, falando em soldados com sintomas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140620
					],
					"speakerTitle": "Paimon"
				},
				{
