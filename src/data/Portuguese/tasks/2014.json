				},
				{
					"id": 20140802,
					"content": "Ah! São vocês! O que vocês estão fazendo por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Espere! Deixe-me levantar primeiro. Que estranho! Parece que estou sem força!",
