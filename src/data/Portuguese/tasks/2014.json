			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "Deve ser aqui mesmo, mas não estou vendo nenhuma coisa suspeita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140202,
					"content": "#Eles poderiam estar se escondendo? {NICKNAME} vamos ver o que podemos encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140203,
					"content": "Esses <color=#00E1FFFF>Monumentos Electro</color> parecem ser muito suspeitosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Ufa! Finalmente acabamos com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Realmente, que monstro difícil de se lidar... Mas por que será que haveria um Lawachurl da Trovoada grande como esse aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "Não estou entendendo... A atmosfera aqui é meio peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Enfim, todas as coisas aqui foram bem resolvidas, vamos indo agora? Hã? Teppei, o que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "*Cof* ...Uau, isto é uma surpresa. Não sabia que eram vocês que estavam investigando aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Acabei de voltar da entrega de alguns suprimentos para a linha de frente. Imaginei que passaria por aqui e eliminaria qualquer ameaça nesta área no caminho de volta. *Cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "Está tudo bem aí, parceiro? Você está com uma aparência um pouco acabada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "Eu estou bem, não é nada. Devo ter pegado um resfriado há alguns dias enquanto estava no mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "No caminho, soube que alguém tinha acabado de chegar à ilha para investigar, então pensei em vir dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Se tivesse havido algum perigo real, eu poderia ter tido a chance de ser o herói... Heh, uma pena que tenham sido só vocês. Acho que vim aqui para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, você não acha que há algo de estranho neste lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Hmm... Agora que você falou, realmente tem algo um pouco estranho aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Poderia ser porque o Tatarigami seja mais palpável aqui, eu acho. Não estamos muito longe dos restos mortais de Orobashi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "Orobashi? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Um deus. Veja, o corpo dele está bem ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "Aah! É um esqueleto de cobra gigantesco. Parece aterrorizante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Orobashi foi quem trouxe nossos antepassados de Enkanomiya até a superfície. Essa é a origem da Ilha Watatsumi que você conhece hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "Nossos ancestrais a consideravam como uma divindade guardiã, mas durante a Guerra dos Arcontes, Orobashi invadiu a Ilha Yashiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "A Shogun Raiden apareceu pessoalmente e matou Orobashi com a Musou no Hitotachi. Esse mesmo corte também formou o que mais tarde ficou conhecido como Garganta Musoujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "A Shogun Raiden criou a Garganta Musoujin com um único corte? Uau, isso é bem incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Sim. Mas a Guerra dos Arcontes foi brutal, e a Ilha Yashiori foi completamente destruída durante essa batalha. Dizem que a Shogun também perdeu algo muito querido para ela ao longo do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Desde a morte de Orobashi, sempre houve alguma animosidade entre a Ilha Watatsumi e o Shogunato. Mas nossas diferentes crenças não têm nada a ver com a razão pela qual a resistência foi formada. Nós só nos erguemos para lutar contra o Decreto de Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Quando Orobashi atacou a civilização, a Shogun se ergueu e pôs um fim a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Mas agora que a Shogun está arrancando as ambições das pessoas com o Decreto de Caça à Visão, é hora de alguém se impor e parar a Shogun... *Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Muito bem, retornarei agora. Eu estava lidando com alguns dos samurais de elite da Shogun, então acho que vou respirar um pouco, depois farei a minha próxima tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "Você deve se reportar a Vossa Excelência Sangonomiya o mais rápido possível. Não fique aqui mais tempo do que o necessário - estar perto do Tatarigami por muito tempo não vai fazer bem à sua saúde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "*Cof cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Cuide-se.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Ei, não se preocupe comigo. Estou em ótimas condições, ótimas condições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Teppei certamente fez grandes progressos se ele já está lidando com os Samurais do Shogunato. Paimon mal pode acreditar nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#{NICKNAME}, vamos reportar para a <color=#00E1FFFF>Kokomi</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Fique atento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
