						20140806
					]
				},
				{
					"id": 20140806,
					"content": "Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Ainda não tive tempo para contar tudo. Eu fiz muitas grandes contribuições para a guerra ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Lutei contra a marinha da Shogun, enfrentei os Samurai do Shogunato sozinho, resgatei meus camaradas de uma emboscada... Coisas que eu nunca sonharia em fazer quando você me conheceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "Se eu fosse ainda mais forte... Quanto mais forte eu sou, mais posso fazer pela resistência... Espere um pouco, que estranho, onde está minha arma secreta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Arma secreta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "#Hum.... Logo depois que você foi nomea{M#do}{F#da} como {M#capitão}{F#capitã}, eu encontrei uma pessoa misteriosa que dizia estar com nossos patrocinadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "Eles me deram ela, dizendo que essa arma secreta me responderia se eu quisesse me tornar mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Haha. É exatamente como uma Visão, não é? Não tenho uma Visão, por isso não sei qual a diferença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "Essa é uma... Ilusão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Ilusão? Parece ser uma coisa amaldiçoada...",
