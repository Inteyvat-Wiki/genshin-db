					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "O <color=#FFCC33FF>mundo interior</color> não é tão ruim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Isso é verdade. Afinal de contas, essa é sua casa, Esnoir. Paimon tem certeza que você gosta daqui. Além disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Amigos que você conhece vivem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Realmente! Eu tenho medo de perder essas coisas, e penso nisso constantemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "Tudo isso é ótimo. Maravilhoso, até. Eu não desejo que mudem, nem desejo que eu mude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "Mas... Me aventurar por aí fará com que tudo mude. Não vai, Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Sim. Definitivamente irá. Não vou te enganar, nem desejo te entristecer, querido Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "Tá bom... Tá bom. Eu entendo o que você quer dizer, assim como imagino que você me entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "Preciso de um tempo para considerar o seu convite antes de tomar minha decisão. Se mais nada, vamos apenas aproveitar deste chá em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "Muito bem. Te acompanharei, Esnoir. Ainda há muito tempo até minha próxima viagem. Até lá, vamos pensar sobre isso juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "Existem muitas flores bonitas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "E bolos gostosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
