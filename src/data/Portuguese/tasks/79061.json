			"dialogs": [
				{
					"id": 790610601,
					"content": "\"Esta carta é para meus vizinhos, meus amigos, o farol e a pequena flor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "Carta Mal Escrita"
				},
				{
					"id": 790610602,
					"content": "\"Estou prestes a sair em uma aventura com Rozel. Por favor, sintam-se à vontade para usar meu balanço, mesa e banco.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "Carta Mal Escrita"
				},
				{
