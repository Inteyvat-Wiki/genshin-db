					}
				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Não importa quantas vezes você pergunte, Rozel, eu não vou ir me aventurar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Você é meu amigo, sim, e isso nunca mudará. Eu não detesto você. Mas... eu não gosto de viajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir. Não é nem um pouco tão assustador quanto você imagina. É apenas uma viagem, só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "O mundo de fora possui muitas flores que não podem ser encontradas em nossa vila e muitas pessoas que nunca conhecemos — até mesmo o formato das nuvens são diferentes por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Você se lembra da semente que eu trouxe de fora? Posso garantir que você nunca viu nenhuma flor com aquele formato e cores antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Ainda é uma semente. Plantarei, e então veremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Se você estiver disposto a ir comigo, poderemos ser capazes de ver essa flor com nossos próprios olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... Me desculpe, eu não tenho desejo algum de viajar para fora, nem desejo me tornar como aqueles aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Eles sempre se preocupam sobre o valor dos carpetes, e não se importam com chapéus bonitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "É assim que suas viagens te muda, e isso me assusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "Isso é verdade. Mas você notou os mapas, as amostras de plantas e os diários de viagem que enchem suas bagagens a ponto de explodir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Passamos por diferentes arbustos e moitas como uma rajada de vento, como rios passando por outro lago... Encontramos coisas diferentes, e nós também nos tornamos pessoas diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "É assim que viajar te muda, e isso também me assusta... Mas também sou grato por essas mudanças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Eu compararia com um pedaço de pão com creme em ambos os lados. Você vai se melecar todo não importa com quanto cuidado você tente segurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Nesse caso, eu passaria o creme separadamente. Dessa forma, eu posso até passar diferentes sabores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Nada mal. Tenho certeza que seria uma refeição farta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "Ah, é você, finalmente chegou! Rozel tem me contado o quão incrível o mundo a fora é, me convidando para ir me aventurar junto com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "Você conhece muito sobre esse mundo? É... como ele diz que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Não é uma má ideia. Isso manteria suas mãos limpas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
