			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel, talvez... Eu possa ir com você. Mas... Eu simplesmente não sei por onde começar a me preparar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "Isso é fácil. Prepare sua geleia, pão e curiosidade. Vista roupas confortáveis e leve um conjunto extra também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Finalmente, prepare-se... Porque você pode ter que jogar fora algumas dessas coisas pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Ah. Tudo isso parece tão complicado. E eu não quero jogá-los fora, porque são meus, são preciosos e eu gosto deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "Depois que eles te deixarem, você descobrirá novas coisas preciosas, meu querido Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610406,
					"content": "Acredite em mim, será uma jornada fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				}
			]
		},
