					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Sim. Não há falta de coisas novas para descobrir no <color=#FFCC33FF>mundo exterior</color>.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Isso! Tem muitas coisas para comer, e muitas coisas divertidas para fazer, e você até poderá encontrar muitas coisas interessantes e pessoas incríveis. Por exemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Você encontrará aqueles que focam na beleza da essência de todas as coisas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Sério? Minha nossa. Eu acreditava que o mundo a fora apenas pensava em \"valor\", e estar cheio daqueles que desejam usar chapéus, mas não ousam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Hmm, bem, você pode pensar como... Como um bolo com vários chocolates espalhados por cima! Cada mordida é uma nova experiência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Isso é muito melhor do que todos os chocolates terem o mesmo gosto — pois isso tornaria o bolo super comum, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Falou bonito, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Bem, quem não iria depois de ouvir ele por tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "É mesmo? Bem, eu... Eu precisarei de mais tempo para pensar sobre isso. Mas talvez um pouco... só um pouquinho de aventura não faria mal, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Não precisa se apressar com as coisas, Esnoir. Ainda há muito tempo até minha próxima viagem. Até lá, vamos pensar sobre isso juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Vejo que você se especializou no modo de falar local.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Você testemunhará ideais radiantes e inesgotáveis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Você poderá conhecer aqueles que trabalham bastante para realizar seus sonhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
