			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110601,
					"content": "O que é isto? Não entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110602
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110602,
					"content": "Jovem, não tente me enganar com essas coisas aleatórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110603
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110603,
					"content": "Nós encontramos perto dos destroços do carrinho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211107,
			"completionStepIds": [
				7211107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211101",
							"3"
						],
						"stepId": 7211101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
