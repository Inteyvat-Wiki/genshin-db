			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "Você precisa de alguma coisa, jovem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110102,
					"content": "Encontramos as provas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Provas? Quais provas? Eu não estou entendendo nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110104,
					"content": "Em relação aos incidentes estranhos na vila, por favor pare de fingir mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110105,
					"content": "Que absurdo! Que tipo de incidentes estranhos podem acontecer na nossa vila? Está bem, então me mostre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110106,
					"content": "#(Hey {NICKNAME}, comece com o que foi encontrado perto do poço. Paimon vai deixar isso com você!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110107,
					"content": "Isso foi encontrado em um poço seco no quintal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
