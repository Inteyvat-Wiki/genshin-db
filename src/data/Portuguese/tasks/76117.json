					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ihanti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2018.583,
							206.964,
							9782.118
						],
						"pointId": 14266
					},
					{
						"sceneId": 3,
						"position": [
							2020.458,
							206.988,
							9783.119
						],
						"pointId": 14267
					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "*Ofegante*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Quem está aí? Eu não tenho nenhuma Mora, nada... Se veio atrás da minha vida, pode levar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "Trouxe suas coisas de volta, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "...Jahoda, é você? Consigo ouvir sua voz, mas já não enxergo direito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Sou eu, Ihanti — estou bem aqui na sua frente. Por que você não veio me procurar? Você está horrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Nem mesmo um vira-lata faminto se arriscaria a entrar na cidade dos ricos... não após todas as surras que levou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "Eu não sou esse tipo de pessoa, e a Nef— quer dizer, a Chefe Nef também não é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Justamente por isso eu não podia te procurar. Se o pessoal descobrisse que você é do tipo que ajuda os outros, iam bater na sua porta todo santo dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Ninguém seria maluco o bastante pra tentar algo assim com a Chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Mas você tá sempre por aí, ajudando os outros às escondidas — só pra acabar levando uma facada nas costas de quem você ajudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "Ei. Eu aprendi muito com a Chefe Nef, sabia? Ninguém vai me passar pra trás desse jeito de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "...Você simplesmente não consegue deixar de se preocupar com os outros, né, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "...Isso é problema meu, e de mais ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Heh... Talvez seja por isso que a chefe tem tanta consideração por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Talvez seja a única razão de eu ainda estar viva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Hahaha—earghh *tosse*... Você tem razão, Jahoda. Tem toda a razão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "...Enfim. Se tiver algo que eu possa fazer por você, Ihanti, é melhor dizer agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Ainda a mesma de sempre, hein... E se tudo isso fosse só um grande golpe, ou se eu estivesse te atraindo pra uma armadilha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Você não faria isso. Não depois de tudo que a gente já passou juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "E isso é o bastante pra conquistar sua confiança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Vamos, olha só o estado em que você tá. Como é que poderia me ameaçar assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Ha! Finalmente estamos chegando a algum lugar. Acho que salvar uma cobra venenosa que mal consegue abrir a boca é bem seguro, pensando bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Faz um favor pra mim então — enrola a pintura que tá nessa bolsa e coloca no meu bolso. Não tenho forças pra pegar sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "Pintei isso com minha esposa e minha filha. É a única coisa neste mundo inteiro de que ainda me importo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Pra mim, nada mais importa agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "Heh, o antigo você estaria rindo à beça se te ouvisse dizer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Hah... e o que aconteceu com aquelas coisas que eu mais valorizava no mundo? Não conseguiram salvar nem minha esposa, nem a minha vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Mas talvez esse seja mesmo o destino de um ladrão. Tudo o que a gente rouba acaba sendo roubado de volta e, no fim, ficamos de mãos abanando de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Aquele pingente que deixei na comissão era tudo o que me restava... Hah, embora eu nem possa dizer que era realmente \"meu\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "Essa foi a primeira joia que você roubou. Você deve ter me contado essa história umas doze vezes — como conseguiu fazer aquilo e a cara do ricaço quando descobriu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "É. De qualquer forma, agora é sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "A quem ela pertencia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "A um homem de Snezhnaya chamado Holomov. Ele morava em Nod-Krai, mas provavelmente já correu de volta pra Snezhnaya. Não me diga que você tá pensando em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Não sou mais uma ladra, e não vou começar a guardar coisa roubada agora. Esse pingente deve voltar pro verdadeiro dono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Haha... hahaha... Você é mesmo um caso à parte, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "O chefe tinha razão... Alguém como você nunca poderia... *tosse* dar conta como ladra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*Acesso de tosse*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Chega, pare de desperdiçar o fôlego. Vou voltar e procurar um médico pra você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Esqueça. Apenas deixe-me ir como devo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, você conhece o código do chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "\"Conceda descanso a quem o busca.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Você sabe do que estou falando, então me deixe em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Fico feliz que tenha sido você quem veio me ajudar, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Desculpe, não tenho nenhum tesouro pra te dar. Mas, se quiser, pode ficar com esta boneca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Espera, mas... achei que eu tinha te dito pra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "Não se preocupe, fui eu mesmo que fiz esta. As que você montou já se foram faz tempo — queimei todas, uma por uma, do jeito que você mandou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Nada mal, né? Ainda mais pra alguém que já estava quase ficando cego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Leve, Jahoda. Considere como meu último presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Eu voltarei para te ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
