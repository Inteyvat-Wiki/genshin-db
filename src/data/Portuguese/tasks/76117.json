			"dialogs": [
				{
					"id": 761170201,
					"content": "Pfft, que perdedor. O cara tá tão quebrado que não tem uma única coisa que valha a pena levar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "E aí, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Quem vai a— Ora, ora, ora, se não é a Jahoda! O que te traz aqui, pirralha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Relaxa, sem estresse. Dizem por aí que você pegou algo de um tal Ihanti alguns dias atrás. É verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Aqui, pega um trocado e entrega a mercadoria. Tô de bom humor hoje, então vamos fingir que sou eu te pagando pra sair ganhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Olha só pra você, toda educadinha. Acho que é isso que acontece quando Nefer te dá cobertura, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "Acho melhor eu ficar com isso. O que você vai fazer a respeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Faz um favor pra mim, Kaleva. Você e esse seu bando de cabeças-ocas não conseguem agir normal por um diazinho que seja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Ah, por favor, não me diga que veio até aqui achando que ia fazer um negócio honesto com um ladrão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Ou você realmente achou que eu ia te oferecer isso de mão beijada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Parece que essa negociação desandou antes mesmo de começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*Suspiro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Foi mal, Kaleva. Não devia ter tentado lidar com você do jeito que a Chefe Nef faz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Um soco na cara é a única forma de negociar com idiotas como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Vamos lá, {NICKNAME}, vamos derrubar esses valentões junt{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Você está nos menosprezando, é? Vamos, rapazes, já é hora de colocar essa pirralha no seu lugar. Vão pra cima dela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
