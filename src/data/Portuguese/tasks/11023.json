	"talks": [
		{
			"id": 1102303,
			"completionStepIds": [
				1102303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102303",
							"2"
						],
						"stepId": 1102303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Veja isto. Está cheio até a metade do caminho com sal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230302,
					"content": "Parece apenas um suporte de sal chique. Parece que a Deusa do Sal era uma deusa sem tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230303,
					"content": "De acordo com meu conhecimento, não é uma apenas um recipiente comum. Embora esteja apenas meio cheio, é também para sempre meio cheio - ou seja, é sem fundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230304,
					"content": "O quê!? Você está dizendo que mesmo que eu derrame o sal para fora, a quantidade dentro nunca vai mudar!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230305,
					"content": "Exatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230306,
					"content": "Capaz de produzir sal infinito... A Deusa do Sal é realmente muito poderosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230307,
					"content": "Finalmente, depois de todo esse esforço, encontrei um tesouro precioso! Eu o reivindico como meu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230308,
					"content": "Só preciso derramar o sal sem fim em mil, ou dez mil sacos... Eu posso vendê-lo e fazer uma fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230309,
					"content": "Ei! Como você pode usar uma relíquia da Deusa do Sal para uma conquista tão superficial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230310,
					"content": "Se o Sr. Kliment quer este cálice de sal, então o próximo objeto que encontrarmos pertencerá à Srta. Wanyan, de acordo com o que concordamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230311,
					"content": "É claro, como combinamos. Hehe, mas como pode algo valer mais do que este raro achado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230312,
					"content": "Como temos um contrato, não serve de nada lutar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230313,
					"content": "Então, vamos seguir em frente, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102305",
							"2"
						],
						"stepId": 1102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Hunf, apenas um simples medidor. Não parece valer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230502,
					"content": "Isto... Se bem me lembro, isto é algum tipo de ferramenta de medição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230503,
					"content": "De fato. Mas a Deusa do Sal o imbuiu com outro poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230504,
					"content": "Quando você enfia está régua no chão, a área ao redor ficará coberta de sal, como uma maré crescente cobre a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230505,
					"content": "Quanto mais fundo ele estiver preso ao solo, mais sal aparecerá. É essencialmente uma \"colheita abundante\" de sal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230506,
					"content": "Is-Isso é ainda melhor que o cálice de sal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230507,
					"content": "Bem, então, de acordo com nosso contrato, o medidor de sal vai para a Srta. Wanyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230508,
					"content": "Não! Inaceitável! Eu paguei e organizei toda esta expedição. Por que eu deveria ter a ponta curta do palito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230509,
					"content": "E esta garota tem sido inútil. Por que ela está recebendo qualquer coisa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230510,
					"content": "Ah não, lá vamos nós de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230511,
					"content": "*Suspiro*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "Então você está dizendo que quer quebrar o contrato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230514,
					"content": "E daí se eu quiser quebrar? Agora que vi como funcionam os mecanismos desta ruína, não preciso mais de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230515,
					"content": "Não vamos nos esquecer quem contratou quem aqui. Por que eu deveria deixá-lo fazer as regras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230516,
					"content": "Porque você concordou com o contrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230517,
					"content": "Rex Lapis disse uma vez: \"Os que quebrarem seus contratos sofrerão a ira da Rocha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230518,
					"content": "Esse é um de seus deuses de Liyue. Eu sou de Snezhnaya, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230519,
					"content": "Irá \"sofrer a ira da Rocha\" - você talvez ache isso bastante desagradável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230512,
					"content": "Já que estamos falando de pessoas \"inúteis\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102307",
							"2"
						],
						"stepId": 1102307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Eu também confiscarei seu tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "Você não é digno de prosseguir nesta ruína. Saia deste lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Maldito sejas... Você vai ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "Grande \"estudo arqueológico\" este... Ele só podia continuar a fingir por tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "Pelo menos, estávamos atentos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "Sim, ainda bem que a Paimon consegue sentir o cheiro de um mentiroso de longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "O erro do Kliment é resultado da ganância, sim. Mas além da ganância, há muitas outras coisas que podem nos tentar a romper com contratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "Quando as pessoas vêm o objeto de seus sonhos, quantos são realmente capazes de controlar seu desejo e seguir o contrato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "Acho que devemos ser honestos uns com os outros agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Hum? Ser honesto sobre o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "Que, na verdade, nem um único membro desta \"expedição arqueológica\" veio aqui pela arqueologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "Por-Por que você diz isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "Senhorita, lhe falta até mesmo o conhecimento arqueológico mais básico e não se pode reconhecer nada além de algumas simples relíquias. No entanto, você é uma especialista quando se trata de qualquer coisa a respeito da Deusa do Sal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "Você não está interessada em arqueologia ou relíquias - o que realmente lhe interessa é a Deusa do Sal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "Acredito que essas lendas sobre a Deusa do Sal que você mencionou no Barco da Pérola são passadas entre gerações do Pavilhão Yinyuan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Certo, isso já foi o suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "... Senhor, você é de fato um homem de grandes conhecimentos e talentos. Pareço ter tido razão em procurá-lo, uma vez que consegui ter coragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "Você está certo, eu não sou uma estudiosa de arqueologia. Eu sou a enviada do Pavilhão Yinyuan, uma das Oito Corporações de Liyue sob a jurisdição de Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Nossos antepassados foram os protegidos pela Deusa do Sal todos aqueles anos atrás, quando a Guerra dos Arcontes engoliu à terra no caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "Pensando bem, nunca ouvi você dizer \"Rex Lapis\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Ah, certo. Agora que você mencionou isso, o povo de Liyue muito raramente usa o nome \"Morax\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "Durante a guerra, Morax assassinou nossa deusa por inveja de seu poder! Ele nos deixou sozinhos e perdidos no mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "Nós... Nós o odiamos! Mas Liyue é a Liyue de Morax, afinal de contas, e sua história é escrita como ele deseja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "Portanto, busco provas da culpa de Morax! Ele tem sangue em suas mãos, e crueldade no coração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "Concordamos com um contrato que deveríamos enfrentar a verdade de frente, não concordamos Sr. Zhongli!? Você deve julgar esta história de forma justa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Naturalmente, é claro. Mas devo acrescentar que a Liyue não é mais a Liyue de Morax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Venha comigo. Todas as respostas que você procura estão à sua frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "Hmm, nunca ouvi você dizer \"Senhor do Geo\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "Espero que você nunca se torne tão gananciosa quanto ele, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "A Paimon gosta de Mora, mas a Paimon não faz coisas ruins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "Isso é... Uma espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "Aha! É uma espada quebrada, isto é a prova! Isto prova que a Deusa do Sal teve que revidar, revidar contra o maléfico Morax! Mas, infelizmente, ela foi derrotada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "O poder desta espada é certamente muito maior do que o do cálice e do medidor de sal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "Se conseguirmos reparar esta espada, então poderemos mostrar ao mundo o poderoso poder da Deusa do Sal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Hmm... Parece mesmo algo deixado para trás após ter sido derrotada em batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Do ponto de vista da arqueologia, essas duas espadas quebradas são duas relíquias históricas. Segundo o acordo \"Apenas pegar um item\", você pode levar apenas uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "Por-Por quê? É verdade que estávamos alternando as reivindicações dos tesouros, mas Kliment não está mais aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Sim, mas a cláusula \"apenas um objeto por reivindicação\" ainda é válida. Não se pode aceitar duas relíquias ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "Es-Essa lógica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Erm... Zhongli, ela parece ser uma boa pessoa, e ninguém está brigando pelo tesouro. Que se tal se você deixasse essa passar, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "Quando existe um contrato, nada pode ser permitido \"passar\". Se o contrato não for cumprido, então ele é quebrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "Não! Se eu pegar apenas uma metade, então não poderá ser reparada e o poder da Deusa do Sal não será restaurado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "Não importa o que aconteça, devo ser fiel a ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Mesmo se isso quebrar o contrato, eu não me importo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "Então você já está decidida? Então, há um preço a pagar por quebrar o contrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "Ou seja, você se entrega a \"sofrer a ira da Rocha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "Está... Está tudo bem. A Deusa do Sal abdicou de sua vida para proteger seu povo. Meu sacrifício não é nada comparado a isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Me castiguem como quiserem. Apenas deixe-me levar comigo esta prova de minha fé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "Não, você não pode bater em uma garota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "... Talvez essa punição fosse mais fácil para ela, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "Como castigo, irei te contar a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "A verdade? Você está dizendo que a verdade é o meu castigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Sim. A verdade que estou prestes a lhe dizer será seu preço a pagar por quebrar o contrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "Temo em dizer que a Deusa do Sal, Havria, não era a deusa poderosa que você imagina que ela seja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Ao contrário, ela era uma deusa pequena e fraca, que cedeu a todos os outros deuses. Ela era uma perdedora... Nunca foi capaz de ganhar um lugar entre Os Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "O qu-O que..!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "Durante a Guerra dos Arcontes, os deuses deste mundo usaram toda sua força e astúcia para lutar pelo controle de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "Mas a Havria, ao invés disso, optou por fugir. Ela achou que ao desistir antes que uma luta pudesse começar, ela poderia salvar a si mesma e seu povo da guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "Entretanto, durante uma guerra tão longa, não há fim para os avanços dos agressores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "Depois de fazer inúmeras concessões, Havria havia perdido todas as suas terras até que restou apenas um pequeno paraíso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "Não... Não... Não pode ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "Em seus últimos dias, ela não tinha nem mesmo uma única lâmina para defender seu povo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "\"Nem mesmo uma única lâmina?\" Então, esta espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "Sim... Esta espada não é uma relíquia pertencente a Deusa do Sal... Mas sim a arma do crime usada para matá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "Arma do crime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "Não! Isso não é verdade, isso não pode ser verdade! Você está tentando testar minha fé na Deusa do Sal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "Como eu disse antes, eu apenas exponho os fatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "Ridículo! Vo-Você é um seguidor de Morax, não tente me enganar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "Ei! Eeeiii! Volte aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "Isso foi demais para ela lidar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "É um castigo, afinal de contas. Não queria contar a ela estes fatos tão cruéis, mas o contrato foi quebrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Vamos segui-la a fundo nas ruínas. Lá, temo que encontraremos algo que não lhe deixará outra escolha senão enfrentar a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "O que você disse realmente é a verdade, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "De fato. Caso contrário, por que eu usaria a verdade como punição? Não queria contar a ela estes fatos tão cruéis, mas o contrato foi quebrado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
