			},
			"dialogs": [
				{
					"id": 110231131,
					"content": "... O que é tudo isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231132,
					"content": "O que eles viram... O que eles fizeram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231133,
					"content": "O que... O que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231134,
					"content": "Como você não confia em mim, continuaremos seguindo em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231135,
					"content": "O que está além desta porta, lhe mostrará tudo o que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
