					"content": "Fascinante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100502
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100502,
					"content": "#Não se pode chamar isso de caminhar pelo ar, mas você me inspirou da mesma forma. Obrigado pela sua orientação, jovem {F#heroína}{M#mestre}.",
					"roleType": "TALK_ROLE_NPC",
