			},
			"dialogs": [
				{
					"id": 762100101,
					"content": "#Sua técnica é realmente extraordinária, {M#Jovem Herói}{F#Jovem Heroína}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hehe, com certeza! {NICKNAME} se garante mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "#Nesse caso, será que este {M#Jovem Herói}{F#Jovem Heroína} poderia me mostrar a verdadeira essência das <color=#00E1FFFF>Técnicas de Salto</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "De acordo com os registros, os antigos mestres do meu Clã de Guhua conseguiam escalar muralhas da cidade como se estivessem andando em terreno plano. Depois de dominarem de verdade a arte de correr por telhados e escalar paredes, eles condensaram essas habilidades nas Técnicas de Salto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "Incrível!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Hmm... por que não tentar? Afinal, {NICKNAME} já escalou um bocado por aí procurando tesouros mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Parece coisa de um ladrão de gatos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "#Hehe, parando para pensar, {M#Jovem Herói}{F#Jovem Heroína}. Se um ladrão consegue pular um muro para escapar da justiça, mas nós, que a defendemos, não conseguimos, isso não nos deixaria impotentes para impedir que os malfeitores escapem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
		{
