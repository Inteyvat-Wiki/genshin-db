			},
			"dialogs": [
				{
					"id": 762100201,
					"content": "É realmente inspirador. Estou profundamente impressionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "#Sendo assim... tenho mais um humilde pedido. Será que {M#Jovem Herói}{F#Jovem Heroína} já ouviu falar das <color=#00E1FFFF>Técnicas de Caminhar nas Nuvens</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Dizem que o nosso Grande Mestre, Guhua, certa vez ascendeu aos céus em meio a uma névoa roxa, pisando no próprio ar como se fosse chão firme, tudo graças a essa lendária arte secreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Parece meio difícil de acreditar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "É, parece que ele está inventando... Mas pensando bem, se a gente usasse o Planador, talvez desse para fazer algo parecido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "#Hã? Então posso pedir a est{M#e Jovem Herói}{F#a Jovem Heroína} que me mostre uma coisa ou duas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Se a gente pudesse usar o Planador...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
