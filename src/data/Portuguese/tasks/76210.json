			"dialogs": [
				{
					"id": 762100301,
					"content": "Dê uma olhada nisso... Estas são as \"Pilhas Vigia-ameixa\" da nossa própria Seita Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "#Posso pedir a est{M#e Jovem Herói}{F#a Jovem Heroína} que pise nas pilhas de pedra na ordem que eu especificar, dentro do tempo determinado, e me mostre do que é capaz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Sem problema, vai ser moleza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Só que tem tanta \"moleza\" para encarar... ah, deixa pra lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "#Pois bem, {M#Jovem Herói}{F#Jovem Heroína}, chegou a hora de mostrar do que você é capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "Na verdade, aposto que até a Paimon, a mestra do Clã Paimon, conseguiria dar conta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "A Paimon não consegue! Não importa como ela pense nisso. Espera... a Paimon provavelmente conseguiria... mas voar seria trapaça, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
