			"dialogs": [
				{
					"id": 230271101,
					"content": "Você voltou. Como estão as raízes da Árvore Divina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Você descreveu o estado do sistema de raízes para Yasmin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "...Ah! Como ainda há criaturas ali reunidas, significa que a terra ainda tem força e vitalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271104,
					"content": "As raízes da Árvore Divina devem crescer firmes por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271105,
					"content": "A única coisa que me preocupa agora... É que um excesso de nutrientes na água pode aumentar a proliferação de Cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271106,
					"content": "Esta é a sua recompensa, muito obrigada pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271107,
					"content": "É melhor deixarmos Ladep e Pharez monitorarem a concentração de nutrientes da água...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
}