			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Parece que ainda precisa de alguns cuidados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#Você é... Ah, Você é provavelmente {F#uma}{M#um} Viajante, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Meu nome é Yasmin, sou aluna do Darshan Amurta. Estou aqui para investigar esta Árvore Divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "Os anos que esta Árvore Divina presenciou excedem o número de todos os grãos de arroz que existem em todos os pilafs em Porto Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "Além disso, ela sustenta a Academia... É tão importante quanto legumes no Frango Assado Tandoori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "Que tipo de analogia é essa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Mas, se algo de ruim acontecer com ela, a cidade inteira de Sumeru poderá enfrentar uma catástrofe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Por exemplo, pode haver uma infestação de insetos, ou gafanhotos gigantes podem sair de dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Os seus galhos podem crescer fora de controle, e seu enorme sistema de raízes sair do solo, destruindo todas as casas no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Ou talvez, o tronco da Árvore Divina possa secar e a árvore pode ruir, esmagando metade de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "Isso... Isso não vai acontecer, certo?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Claro que não. Bem, tudo está indo bem até o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Mas, novamente, não é como se os cogumelos avisassem antes de atacar enquanto você coleta cogumelos na floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "Bem, eu vim para investigar e observar a condição dessa árvore gigantesca, e preparar as pessoas para qualquer coisa que possa acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Como você pode ver, minha mente é tão veloz quanto um Pássaro do Crepúsculo, mas minha Stamina é tão minúscula quanto um Cogumelo Estrelar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "Viajante, você pode me ajudar a registrar o estado das raízes da Árvore Divina em alguns lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "Geralmente, eu contrato aventureiros para irem comigo, mas ninguém parece estar disponível no momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Todos os acadêmicos falam desse jeito...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Ei? Você está falando das analogias? Desculpe, é apenas como eu falo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "As pessoas da Academia também falaram comigo sobre isso, mas eu não consigo mudar \"do nada\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Obrigada, eu estarei esperando por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "Esse é o seu tipo de analogia. Não é, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Que árvore magnífica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
