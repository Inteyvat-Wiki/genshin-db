			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "...Aqueles Ladrões de Tesouro... Oh, me desculpe! Algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Existem Ladrões de Tesouro ativos em volta de Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Ladrões de Tesouro? Nós mesmos estamos no rasto de um grupo deles. Como ousam esses bandidos esgueirassem tão perto de Mondstadt? Sem mencionar que não sabemos quais são as intenções deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Sejam quais forem as intenções, eles definitivamente não estão fazendo nada de bom. Nós redirecionamos muita mão de obra para lidar com eles, então temo que não tenhamos homens para lidar com seu relatório agora mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "No entanto, vou anotar seu relatório. Assim que terminarmos com esses Ladrões de Tesouro, eu o passarei para cima. Mais uma vez, obrigado por reportar o assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
