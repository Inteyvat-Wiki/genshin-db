			"dialogs": [
				{
					"id": 205190501,
					"content": "O que... O que eu posso fazer por você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190502,
					"content": "Ainda estou esperando a Irmã Victoria me dar sua resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190503,
					"content": "Este incidente... Estou preparado para as consequências, não importa quais sejam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
