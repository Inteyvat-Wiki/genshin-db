			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "#É Arama e Nara dourad{F#a}{M#o}. Você é tão grande! Mas já essa coisinha prateada do seu lado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hmm? O que você tem a dizer sobre a \"coisinha prateada\", hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Como posso dizer... Você deve conseguir entrar até mesmo nos menores lugares entre as árvores. Que conveniente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Bem, de acordo com os costumes Nara, nós devemos nos apresentar primeiro. {M#Estes são}{F#Estas são} {NICKNAME} e Paimon. Este é Arakavi. Vocês deveriam apertar as mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "#Você está um pouco {M#perdido}{F#perdida}, mas cumprimenta Arakavi de toda forma.\\n É uma sensação bem... Peculiar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "Interessante. Eu ouvi muitas coisas sobre Nara, mas é a primeira vez que toquei em um. Isso é tão intrigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "Já faz muito tempo desde que recebemos um Nara aqui. Muitas sementes cresceram e se tornaram árvores, muitas histórias se tornaram lendas. Aquele Nara era um bom Nara, é o que ficamos sabendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} também é {F#boa}{M#bom}. Chei{F#a}{M#o} de força e bravura, como uma muda crescendo na parede de pedra. E vocês estão aqui para ajudar Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Ah, Arana... Já faz um tempo que nos encontramos. Espero que tudo esteja bem, e que aqueles pequenos Nara na Vila Vimara estejam bem também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Você também conhece as crianças da Vila Vimara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Claro que conheço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "Todos nós conhecemos! Arana voltou e nos contou histórias sobre os pequenos Nara. Nara Iotham, Nara Bahram e Nara Rana são nossos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Paimon não tem certeza se isso conta como conhecer alguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Então como se conhece alguém? Precisamos \"apertar as mãos\" e nos \"apresentar\" como os Nara fazem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "Eu entendi o que Paimon quis dizer. Os Nara também comem e procuram \"tesouros\" juntos. É assim que \"se conhece\" alguém, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "Na verdade, não é tão simples assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Enquanto nós conhecermos as histórias um do outro, nós nos conhecemos. É assim porque o mundo de Aranara é um lugar de canções e sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Arakavi está certo. Para os Aranara, basta apenas ouvir uma canção retratando Nara {NICKNAME} e ver Nara {NICKNAME} nos sonhos. Isso já basta para conhecer alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Paimon acha que devemos deixar isso para lá. Afinal, nós já somos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "Bons amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama e Arakavi"
				},
				{
					"id": 730810325,
					"content": "Bons amigos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Sim! Já que vamos celebrar o Festival Utsava, Arakavi precisa fazer algumas preparações!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "É verdade. Precisamos da Bija, certo? Eu mandei Arayasa, Aradasa e Arasudraka, procurarem pelo Pavilhão Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Muito perspicaz! Hmm, mas Paimon estava pensando... Por que vocês não sabem onde o Pavilhão Ashvattha está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "O Pavilhão Ashvattha é um lugar muito sagrado e nós não costumamos ir lá. Preferimos deixar a Árvore Vasara dormir tranquilamente em seus sonhos. Até que todas as lembranças se encontrem em Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "A floresta se lembra de tudo. Todas as coisas boas nunca se dissipam. Todas as dores se tornam alimento para algo belo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "Enfim, você pode encontrar Arayasa, Aradasa e Arasudraka procurando pelo Pavilhão Ashvattha lá. Arama, vá, e ajude-os.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Eu vou. Se Nara {NICKNAME} e Paimon encontrarem comigo na floresta, vamos fazer uma aventura juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Muito bem! Foi ótimo conhecer vocês, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Vamos ao que interessa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Como eu posso dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Eu me alimento e procuro por tesouros com a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "#Isso! Nós somos melhores amig{F#as}{M#os}, não só \"pessoas que se conhecem\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Que ótimo! {NICKNAME} e Paimon são incríveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
