						"rawParams": [
							"7308102",
							"2"
						],
						"stepId": 7308102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308103",
							"2"
						],
						"stepId": 7308103,
