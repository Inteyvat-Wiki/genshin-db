					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Sirva-se!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Deixe-me pensar... Quais pratos do que estávamos falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Ah, sim! Peixe Esquilo, Ensopado de Poleiro com Dorso Negro e Peixe Grelhado de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Vamos decidir e entregar para a senhorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
