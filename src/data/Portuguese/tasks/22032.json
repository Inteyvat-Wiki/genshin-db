			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "Ei? Esta comida... não parece ter o sabor de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320502,
					"content": "Acho que ela não é o que eu queria comer... Mas deixa para lá, basta se encher o meu estômago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320503,
					"content": "Muito obrigada mesmo assim, Viajante, esta recompensa é para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203206,
