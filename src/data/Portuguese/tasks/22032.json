			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Hum... Se conseguisse comer comida de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320802,
					"content": "Está tudo bem com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "#Quem é você? Com base nas suas roupas, você deve ser {M#um}{F#uma} Viajante, certo? Me desculpe, mas estou com muitas saudades da minha casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320804,
					"content": "Você acabou de dizer que quer comer comida de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "Hm? Você... Você sabe fazer comida de Liyue? Que ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320819,
					"content": "Então, por favor, faça uma comida original de Liyue, e agradeço desde já!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320820,
					"content": "Deixe-me pensar... Agora eu tenho vontade de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320821,
					"content": "Eu quero comer peixe! Quero comer peixe como o que minha mãe fazia quando era pequena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320822,
					"content": "Lavar o peixe, fazer cortes em ambos os lados, rechear com especiarias e vinho envelhecido e marinar bem rapidinho, fritar em uma frigideira até dourar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320823,
					"content": "Em seguida, adicionar água quente e molho para ferver, finalmente, temperar em fogo alto, engrossar o molho, prato, e servir... Ah! Isso é que é vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320824,
					"content": "Meu irmão mais novo ficava cheirando tudo por perto, enquanto ele pulava e aplaudia: \"Que bom! Simplesmente lindo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320825,
					"content": "*Snif* Minha mãe é muito boa cozinhando peixe, mas quando que poderei voltar a comê-lo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320805,
					"content": "Você encontrou algum problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Me desculpe, me esqueci de me apresentar. O meu nome é Tang Wen, uma historiadora de Liyue, e estava fazendo investigações de campo para aprofundar a minha pesquisa de costumes e folclores de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320807,
					"content": "Eu já tinha reunido todos os materiais que precisava e estava justamente me preparando para voltar a Liyue. Mas tantas coisas enormes aconteceram recentemente em Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320808,
					"content": "Sinto que estou testemunhando um momento histórico de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320809,
					"content": "Esse período tão especial certamente entrará na história de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320810,
					"content": "Caberá a uma estudiosa como eu testemunhar a história, registrá-la e arquivá-la de forma realista, completa e clara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320811,
					"content": "Mas... Apesar do fato que uma carreira como essa me deixa bastante animada, ela não enche meu estômago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320812,
					"content": "Você está com fome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Não é a questão de fome... Haha, para ser sincera, a comida de Inazuma é saborosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320814,
					"content": "Eu gosto muito de Tempura, ela é uma comida com um revestimento de farinha frita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320815,
					"content": "Depois de tanto tempo comendo comida de Inazuma, eu gostaria de comer comida de Liyue. Mas infelizmente não consegui encontrar um restaurante com comida original de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320816,
					"content": "Uns dias atrás, decidi publicar uma missão de culinária, mas ninguém me respondeu por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320817,
					"content": "Posso tentar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
