			"dialogs": [
				{
					"id": 220320401,
					"content": "Hum... Esse sabor me aparece um pouco estranho, não de Liyue nem de Inazuma, mas o seu sabor realmente é muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320402,
					"content": "Apesar de não ser o prato que eu queria comer, já estou satisfeita com esses pratos com ingredientes tão frescos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320403,
					"content": "Muito obrigada, Viajante. Tome isto como a recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203205,
