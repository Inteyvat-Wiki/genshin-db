						718202102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202102,
					"content": "Ele aceitou mas disse que vinha só daqui a pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "Muito bem. Há pouco encontrei com Qingzhou, mas ele estava com um semblante preocupado. Disse que precisava encontrar alguma inspiração e foi caminhar nas redondezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202104,
					"content": "Obrigada pela sua ajuda, Viajante. Eu ficarei aqui esperando Bohuanzi para verificar uns detalhes com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202105,
					"content": "Eu preciso voltar ao Porto de Liyue para tratar de alguns assuntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202106,
					"content": "Penso que durante esse tempo precisarei de viajar frequentemente entre o Albergue Wangshu e o Porto de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202107,
					"content": "Depois de tratar de meus assuntos, poderemos ir à Vila Qingce. Se você estiver interessado, pode ir até ela e nos encontrar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718202108,
					"content": "*Suspiro* Espero conseguir tratar rapidamente de todos os meus assuntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				}
