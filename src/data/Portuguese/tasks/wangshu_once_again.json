			"trigger": {
				"objectNames": [
					"Bohuanzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "Obrigado, obrigado. *Suspiro* É minha culpa por ser tão descuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201902,
					"content": "O que você estava fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "Vim buscar materiais. Não estamos no Ritual de Lanternas? Queria escrever uns versos bons para oferecer aos meus amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201904,
					"content": "A princípio, pensei em vir aqui para buscar alguns materiais, mas depois vi umas tintas muito especiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201905,
					"content": "Nunca pensei que encontraria tantos monstros, é realmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201906,
					"content": "Sobre a solicitação de Wang'ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "Ir à Vila Qingce ajudar a escrever versos? Está bem, não tem problema. Eu farei isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201908,
					"content": "Vila Qingce... Eu me lembro que lá tem muitos idosos, não é? Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201909,
					"content": "Fazemos assim. Você me ajuda a coletar um Cor Lapis e uma Qingxin e eu levarei de volta para fazer um pouco de tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201910,
					"content": "Essas coisas servem para fazer tinta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "Hahaha! Você não sabia? Se adicionar o pó de Cor Lapis na tinta, quando escrever a tinta terá um brilho dourado sútil e é muito auspicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201912,
					"content": "Se adicionar o suco de Qingxin na tinta, a tinta terá um aroma fresco e se for bem produzida os dois aromas se conjugam muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201913,
					"content": "Isso é bem detalhado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "Hehe. Isso não é nada comparado ao que alguns conhecedores estão dispostos a fazer para produzir suas tintas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201916,
					"content": "Vamos fazer as coisas mais simples dessa vez. Quando você coletar, traga para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201917,
					"content": "Oh... Preciso de descansar um pouco, isso foi muito cansativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bohuanzi"
				},
				{
					"id": 718201914,
					"content": "É tão difícil assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
