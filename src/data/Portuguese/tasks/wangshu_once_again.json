				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "Todo Ritual de Lanternas é a mesma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200202,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "Estamos em uma situação um pouco difícil. Muitos de nossos funcionários voltaram para passar o Ritual de Lanternas com suas famílias. É difícil gerenciar o albergue dessa maneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200204,
					"content": "Cuidar dos convidados, decorar o albergue e fazer os preparativos para a celebração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200205,
					"content": "Além de nossas responsabilidades regulares que não podemos deixar de lado. Não há como o Yanxiao Sorridente conseguir acompanhar esta carga de trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200206,
					"content": "Se você puder ser gentil, Viajante, poderia ajudá-lo um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200207,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "Tenho certeza de que ele vai apreciar. Você pode encontrar o Yanxiao na cozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718200209,
					"content": "Ainda não terminei a minha parte aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao Sorridente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "Quem é!? A cozinha é somente para funcionários... Ah, é você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718200302,
					"content": "Você precisa de alguma coisa? Se você quiser pedir, isso pode demorar um pouco... Minhas mãos estão cheias no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718200303,
					"content": "Então eu lhe darei uma mãozinha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "Você veio para ajudar? Oh... Não posso reclamar disso. Acontece que eu estou cheio de trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718200306,
					"content": "Vá lá para baixo no Albergue. Pegue os ingredientes que acabaram de chegar e traga-os para mim, usarei eles logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718200307,
					"content": "Enquanto isso, você também pode pegar essas Lanternas Celestes e pendurá-las nas árvores pela entrada do albergue... O gerente tem me incomodado com isso há muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718200304,
					"content": "Você precisa de ajuda com alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao Sorridente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "Como foi? Você já cuidou de tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718201502,
					"content": "Sim, tudo feito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "Obrigado, eu te devo uma. Já é hora de eu terminar esses pratos. Não gostaria de receber nenhuma reclamação de nossos clientes famintos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "Oh, você está de volta. Então o Yanxiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201602,
					"content": "Ele deve conseguir agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "Que ótimo. Obrigada por sua ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201604,
					"content": "Nada aqui também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201605,
					"content": "Hã? Wang'ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "Viajante? Que coincidência! Eu não esperava que você estivesse aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201608,
					"content": "Poderia se dizer que estou entregando Lanternas Celestes... Você já ouviu falar da Vila Qingce? Está bem longe da cidade. A maioria dos habitantes da vila são crianças ou idosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201609,
					"content": "Assim, todos os anos por volta do Ritual de Lanternas, o Ministério dos Assuntos Civis delega um representante para trazer-lhes algumas coisas essenciais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201610,
					"content": "O primeiro lote já foi entregue, mas eu gostaria de ir um passo além e garantir que a atmosfera festiva também chegue à vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201611,
					"content": "Foi por isso que pedi ao poeta Qingzhou para preparar alguns quebra-cabeças das lanternas e ir à Vila Qingce para entreter as crianças locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201612,
					"content": "Qingzhou",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "Um poeta tão respeitável como ele deve estar à altura da tarefa. Eu também queria envolver o Sr. Bohuanzi. Ele é um calígrafo muito bom. Seria incrível se ele pudesse ajudar os idosos a escrever seus desejos nas Lanternas Celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201615,
					"content": "Entretanto, apesar dos meus melhores esforços para encontrá-lo, o Sr. Bohuanzi não se encontra em lugar algum. Alguém me disse que ele tinha ido buscar materiais na Ilhota de Dihua, então vim aqui procurá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201616,
					"content": "Não faria mal em perguntar a chefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "Bohuanzi? Deixe-me pensar... Ele realmente veio ao Albergue recentemente, disse que ia procurar algo nas redondezas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201619,
					"content": "Porém, nessa zona tem muitos monstros, não sei se ele ainda está lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718201620,
					"content": "Ah, é? Mas eu combinei com Qingzhou, nos íamos nos encontrar no Albergue Wangshu daqui a pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201621,
					"content": "Viajante, você pode me ajudar a procurar Bohuanzi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201622,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "Muito obrigada. Eu espero pela chegada de Qingzhou aqui, tem uns assuntos que preciso falar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201624,
					"content": "Uff! Isto não acaba mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718201617,
					"content": "Sobre Bohuanzi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "(Ele não marcou com Vermeer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "Você veio aqui trazendo Lanternas Celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
