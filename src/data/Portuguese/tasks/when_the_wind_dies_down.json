			"dialogs": [
				{
					"id": 3980301,
					"content": "Muito obrigado! Finalmente acabou tudo isto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Devido ao desastre de Stormterror, muitas rotas comerciais foram quebradas. Podemos ficar sem suprimentos de grãos e frutas, mas estaríamos com grande problema sem vinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Um dia sem vinho é como um dia sem sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "*Suspiro* Espero que as rotas comerciais voltem ao normal em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
