				{
					"id": 3980402,
					"content": "Perigo, desastres, aventuras, sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "Finalmente, a Guilda de Aventureiros não receberá mais ordens triviais para capturar gatinhos e cachorrinhos! Uma nova era de aventura está chegando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "Jovem, se junte a Guilda de Aventureiros e salve Mondstadt neste período turbulento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Sim, quanto a isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "Hã? O que foi que você disse?！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "O assunto de Stormterror já foi resolvido? E perdi o discurso da Grande Mestre Intendente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "Stormterror não podia aguentar mais um pouco? Nós estávamos a caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
