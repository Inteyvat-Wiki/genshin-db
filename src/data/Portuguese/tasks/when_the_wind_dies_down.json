				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Então, a verdadeira identidade de Stormterror é Dvalin - um dos Quatro Ventos! Nunca deveríamos ter esquecido o seu sacrifício por Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Mas dentro de todas as desgraças, felizmente pelo menos nossa relação com o Dragão do Leste não atingiu um ponto sem retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Graças a vocês e a Mestre Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Com os Cavaleiros de Favonius, Mondstadt retornará à paz e liberdade de sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
