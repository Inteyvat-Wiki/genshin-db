			"dialogs": [
				{
					"id": 200470201,
					"content": "Você encontrou alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470202
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470202,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470203
					]
				},
				{
					"id": 200470203,
					"content": "Por favor, tudo depende de você! As suas descobertas farão toda a diferença em minha aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
