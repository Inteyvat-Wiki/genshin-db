			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Não existe um plano perfeito de aventura! Como você quer ter algum progresso procrastinando desse jeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200470102,
					"content": "Mesmo que não tenha um plano perfeito, é necessário se preparar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "O que vocês estão discutindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Oh, estamos planejando explorar o <color=#00E1FFFF>Templo do Vento Milenar</color>, mas a Sra. Patchi não possui nenhuma experiência em aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "O interior do templo está cheio de monstros, sem falar do temido Guarda das Ruínas na entrada... Vamos acabar colocando nossas vidas em risco se entrarmos nessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Eu só estou tentando manter a segurança do Sr. patch. Bem, então tá, pela minha segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Estou tentando convencê-la dos benefícios de elaborar um plano meticuloso e infalível para esta aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Mas temo que, se começarmos com algum reconhecimento básico perto do terreno do templo, Patchi ficará muito animado e continuará avançando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Eu preciso ficar aqui e ficar de olho nela. Você poderia me ajudar a examinar a área para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Perfeito! Mas certifique-se de olhar tudo com atenção! Um simples detalhe despercebido poderá nos levar ao fracasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Não importa o que você descubra, traga tudo para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Ao invés disso, por que eu não fico de olho na Patchi por vocês?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "N... não! Isso não vai funcionar! Eu, erm... Ainda existem muitos detalhes do plano que preciso discutir com ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Me ajude a ir em busca de pistas, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
