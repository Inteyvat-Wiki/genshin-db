			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isumenasu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "Hmm? Nunca vi ninguém vestido como vocês antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450202,
					"content": "Vocês vieram de algum lugar, ahm, além dos céus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450203,
					"content": "Afinal não só há o Reino de Byakuya no mundo, então apresente o mapa que você usa para viajar e deixe-me dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450204,
					"content": "(Você dá a ele seu mapa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Uau, fascinante. As formas de relevo não só foram desenhadas com a maior precisão, mas até mesmo os caminhos das montanhas e rios podem ser vistos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450206,
					"content": "Bem, então... Qual é o tamanho desta nação a que você chama de \"Teyvat\"? Qual é o seu tamanho em comparação com o Reino de Byakuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450207,
					"content": "Teyvat é um continente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450208,
					"content": "E Enkanomiya... Ou seja, o Reino de Byakuya, é este pequeno lugar na extremidade sul do mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450209,
					"content": "Isso é um absurdo! Nossas terras são vastas e amplas! Como elas podem ocupar um espaço tão insignificante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450210,
					"content": "Este mapa pode parecer desenhado com precisão, mas a verdade é que é uma fraude completa. Fora, fora com isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450211,
					"content": "E pensar que tive um momento de admiração por esse charlatanismo barato... Que desgraça para os meus olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450212,
					"content": "Unf, não precisa acreditar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224503,
