			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piramumon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "#Ah, pelo visto, você é {M#um}{F#uma} forasteir{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "De onde você é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "De Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "Você fala sucintamente sobre a paisagem de Mondstadt para Piramumon...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "É uma cidade que eu nunca tinha ouvido. Mas é incrível que exista uma cidade tão legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Haha. É como o que eu disse! O mundo não pode ser tão pequeno quanto o Reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "Se realmente só existisse o Reino de Byakuya no mundo, acabaria sendo dominado pela solidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "Eu lia muitas histórias que tinha ocorrido antes da fundação do Reino de Byakuya, e cheguei à conclusão que havia um mundo vasto fora dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "Contudo, eu também tinha medo, me preocupando se na verdade havia apenas um vazio fora dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "Viajante, ao saber que você é de longe, eu me sinto mais tranquilo. Afinal há tantos lugares interessantes no mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "É uma pena que ainda tenho que terminar o Ritual do Retorno Solar primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "Viajante, o que você acha de me dizer como você chegou até aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Quando o Ritual do Retorno Solar for terminado, eu vou fugir furtivamente do Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "Então depois a gente pode beber um suco! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
		},
