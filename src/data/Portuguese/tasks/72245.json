			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rikoru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "O quê? Deixe-me em paz, estou pensando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450102,
					"content": "Em uma coisa muito importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450103,
					"content": "O que é então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450104,
					"content": "Você já viu aquele negócio chamado do Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450105,
					"content": "O edifício mais alto do reino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450106,
					"content": "Estou pensando em como construir um prédio mais alto ainda, mais alto que o Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450107,
					"content": "Mas o fato do Dainichi Mikoshi ser tão alto é para iluminar todo o Reino de Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450108,
					"content": "Mas qual é a razão por seu prédio ser tão alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450109,
					"content": "Claro que é para exibir a glória de Rikoru, o Grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450110,
					"content": "Isso vai mostrar para aquele velho Aberaku quem manda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450111,
					"content": "Você conhece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "Claro. Ele construiu o Dainichi Mikoshi e salvou o Reino de Byakuya com a Noite Branca. Eu costumava admirar ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450114,
					"content": "Mas ele cobiçava o trono. Se não fosse graças a aqueles adultos, eu teria morrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450115,
					"content": "É por isso que vou construir um edifício mais alto do que o Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450116,
					"content": "Q—Quanto tempo isso vai demorar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450117,
					"content": "Isso não importa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450118,
					"content": "O povo do Reino de Byakuya deveria ficar feliz por ter a chance de construir uma maravilha histórica dessas para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450119,
					"content": "Bom, parem de me incomodar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450120,
					"content": "Deixe-me pensar... Se as vigas forem deste comprimento... E se fizermos isto assim, a capacidade de carga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450112,
					"content": "Aberaku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
