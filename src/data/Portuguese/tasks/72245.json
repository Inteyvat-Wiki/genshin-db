			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Surepio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "#Viajantes de terras distantes... *Cof cof* Vocês parecem bastante cansad{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "Tomem cuidado. Sabem... Muitas doenças começam como resultado de cansaço excessivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Devem garantir que descansam o suficiente todos os dias, para que... *Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "*Cof cof* *Cof cof*... possam crescer saudáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Na verdade você não parece estar bom de saúde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Haha, é uma doença antiga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "Você deve manter um corpo saudável para cultivar uma mente saudável, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*suspiro* Se eu tivesse mais tempo, eu me tornaria o melhor médico do mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "Dessa forma, mesmo com um corpo como o meu, eu poderia sair do meu quarto e brincar o quanto quisesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
