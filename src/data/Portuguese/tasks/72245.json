				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "#E, você é {M#um}{F#uma} forasteir{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "O que você está procurando? O jeito que você anda me deixa muito aflito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "Triste? O que há de triste neste cenário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Para um cantor, qualquer coisa neste mundo o deixa triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Por exemplo, ao se encontrar com alguém, você também terá que se separar dele um dia. Ao abraçar este mundo pela primeira vez, você sabe que vai ter a última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "Outro exemplo, a reunião é breve de mais para aliviar a dor de despedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Apenas quem está procurando algo embarca em uma jornada ruma para longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Esta jornada soa romântica para os habitantes, mas para o próprio viajante, talvez esteja cheia de dores indizíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "Se você tivesse vindo antes, eu poderia ter cantado para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Só que eu já prometi a uma pessoa que nunca mais cantaria até eu ouvir a sua voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "#Então eu só posso te dar os meus sinceros desejos. Você parece muito mais velh{M#o}{F#a} que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "Espero que todos seus desejos tornam realidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
}