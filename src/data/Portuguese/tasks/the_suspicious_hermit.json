			"dialogs": [
				{
					"id": 761140101,
					"content": "Então, desta vez estamos investigando... um eremita suspeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Mas eremitas já não são todos suspeitos por natureza? Qualquer um que fuja para viver no meio de uma montanha remota não pode ser totalmente normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "As pessoas não mudam sem motivo, seja por fatores internos ou externos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "Além disso, o desaparecimento daquele mercador levanta questões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "Hã? Mas aquela área está cheia de perigos — todo mundo sabe disso. Bandidos, monstros... Há um milhão de formas de um mercador viajante encontrar seu fim por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Já que todo mundo sabe o quão perigoso é, você não acha que um mercador que passa por ali com frequência estaria bem preparado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Mesmo conhecendo bem a região, um mercador experiente simplesmente desapareceu. Algo assim levanta suspeitas com toda a razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, estou deixando com você a visita a esse \"eremita suspeito\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "É uma longa estrada — não desvie do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Ah... Pode deixar, Chefe Nef! Deixe comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
