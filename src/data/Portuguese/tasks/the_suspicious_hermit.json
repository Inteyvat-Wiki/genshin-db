			},
			"dialogs": [
				{
					"id": 761140301,
					"content": "(Hã? Parece que... Não foi completamente queimado...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Eu ouvi dizer que o Sr. Derwent recebia aventureiros feridos... Parece que isso aconteceu recentemente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Por que ele tentaria queimar isso...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
