			"dialogs": [
				{
					"id": 790720101,
					"content": "#Minha nossa, que honra. Você deve ser {NICKNAME}, e no caso, essa ao seu lado deve ser sua companheira, Srta. Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720102,
					"content": "Hehe. Isso mesmo, somos nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "#Somos assim tão famos{M#o}{F#a}s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "As notícias se espalham rápido daqui até aqui e pela Metrópole da Constelação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720105,
					"content": "Devo dizer que você chegou bem na hora — eu estava dando os toques finais nesse meu joguinho, chamado \"Chapéus Voadores\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720106,
					"content": "Não posso ser como o chapeleiro homônimo em \"O Chapeleiro Voador\", que dava a todos um lindo chapéu, receio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720107,
					"content": "Mas acredito que \"Chapéu Voador\" trará alegria para aqueles que o jogarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720108,
					"content": "Também projetei três modos de jogo completamente diferentes para ele... Não se preocupe, não se preocupe, as regras não são muito complicadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720109,
					"content": "Acredito que você entenderá tudo com apenas uma partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720110,
					"content": "Vou experimentar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Sem problemas. Por favor, venham aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Witt"
				},
				{
					"id": 790720112,
					"content": "#Estou ocupad{M#o}{F#a} agora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Ah, está tudo bem. Apenas venha me encontrar quando tiver um tempo. Estarei aqui por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Witt"
				}
			]
		}
	]
