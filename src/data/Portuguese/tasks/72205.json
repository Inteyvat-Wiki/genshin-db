	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Hã. Engraçado. Eu tinha certeza que estava em meu bolso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Isso não vai servir, deveríamos levar à vovó Una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "Ela já está bem idosa e não consegue mais se lembrar claramente de muita coisa. Recentemente, ela começou a falar das coisas que aconteceram com ela quando ainda era jovem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Ela sempre está falando sobre flores isto e flores aquilo... Ela até disse que eram flores do além do Mar de Névoa, que eram ao mesmo tempo diferentes e muito bonitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Mas então um dia tive um sonho ... Sonhei que o nevoeiro da ilha desapareceu. \"Uau\", disse a mim mesmo, enquanto do outro lado do mar se erguia uma gigantesca e bela casa. Mas essa casa não era de madeira, nem de ouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Eu também, eu também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "Nesse sonho, eu escalava uma montanha muito alta, e depois escalava uma árvore enorme para colher muitas flores... Nunca vi as flores de que a vovó Una falou, mas tenho certeza de que eram aquelas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Mas as flores eram pesadas demais e eu caí da árvore. Caí sem parar... até que acordei do sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Unf! Isso porque você é muito ganancioso! Eu disse várias vezes que era o suficiente, por sua culpa caí com você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "A bolsa está vazia... Não temos absolutamente nada. Como podemos voltar para a vovó Una de mãos vazias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Precisa de alguma ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
