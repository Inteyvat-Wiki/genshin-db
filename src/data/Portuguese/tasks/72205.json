					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "Ele não quer brincar com a gente, e não fala nada de interessante, só fica nos dizendo para irmos... Que irritante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "Não é que não possamos ir... Só temos medo que a Vovó Una se preocupe...",
