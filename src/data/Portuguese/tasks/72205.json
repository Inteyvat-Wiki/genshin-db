			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "#Olá, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050302,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "Obrigado por escolher aquelas flores para mim da última vez! Mas... sempre sinto algo estranho perto de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050305,
					"content": "Sim, eu também sinto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050306,
					"content": "Onde quer que eu vá, sempre encontro pessoas infelizes, como se não pudessem ouvir o que os outros estão dizendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050307,
					"content": "Além disso, sempre que encontro uma flor bonita e a coloco na minha bolsa, ela desaparece instantaneamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050308,
					"content": "Isso é porque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Mesmo? Eu não entendi muito bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050311,
					"content": "Vamos partir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050312,
					"content": "Aquele tio dourado também disse algo assim... Mas nós ainda não podemos ir com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050313,
					"content": "Ainda temos que ir levar uma flor bonita para a Vovó Una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050309,
					"content": "É hora de partir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Parecem muito animados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
