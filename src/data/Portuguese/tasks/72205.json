						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050701,
					"content": "#{F#Tia}{M#Tio}, nos encontramos de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050702,
					"content": "Se Kito não quiser falar hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050703,
						722050704
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050703,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "Não é nada... Só estou brincando sozinho, não precisa se preocupar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050706
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050706,
					"content": "#{F#Tia}{M#Tio}, é que... Ele está assim de novo... Irritado sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050707,
						722050708
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050707,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "#Kito, não fique irritado com {F#uma forasteira}{M#um forasteiro}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
					],
