			"dialogs": [
				{
					"id": 4840601,
					"content": "Hum... Uma tira de teia com marcas Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840602,
					"content": "Olhando para o design e a maneira como ele foi tecido, talvez seja uma peça de um Planador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Uau, agora os exploradores precisam ser especialistas em tecido!? É um trabalho mais difícil do que a Paimon pensava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "Se isso realmente pertencer ao Raptor, isso significa que o seu planador está quebrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "As traços elementais apontam para esta direção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841102,
					"content": "Será que ele continua fugindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841103,
					"content": "Só há uma maneira de descobrir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "Amber"
				},
				{
