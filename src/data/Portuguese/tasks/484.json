			},
			"dialogs": [
				{
					"id": 4842201,
					"content": "Hum... Veja onde estamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "Não há mais traços elementais à frente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "O poder elemental do artefato deve ter se esgotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "O Raptor deve ter percebido que as marcas devem ter revelado sua posição e enviou seus soldados para nos atrasar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "Provavelmente para esperar até que o efeito desapareça para poder escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "Ele não vai conseguir escapar! Atrás dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
