					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Maravilha! Os Cavaleiros de Favonius chegaram! Os Hilichurls não vão conseguir me seguir por muito longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843102,
					"content": "O que foi que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "Eu não posso acreditar... Mas os Hilichurls atacaram nossa caravana. Por sorte, conseguimos afastá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843104,
					"content": "Hilichurls? Mas eu pensei que os Cavaleiros de Favonius tinham conseguido se livrar a maioria dos acampamentos de Hilichurls ao redor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "É um pequeno campo não muito longe da vila. Geralmente eu desvio desse local durante as minhas entregas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843106,
					"content": "Mas hoje... Eu juro por Deus que apareceu uma pessoa de repente do céu e posou bem no acampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843107,
					"content": "Hum... Mas isso me faz lembrar de alguém familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Isso realmente os enfureceu. Eles perseguiram o cara de aparência estranha quando ele fugiu, levando-os para o campo aberto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843109,
					"content": "Eu consegui fugir, mas eles esmagaram todas as minhas frutas. Eu não sei o que vou fazer quando a caravana dos comerciantes chegar amanhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843110,
					"content": "Aparência estranha? Em que sentido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Ele estava segurando alguma coisa. Parecia ser algo pesado, pois ele não conseguia voar em linha reta... Deve ter sido por isso que ele caiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843112,
					"content": "Honestamente, pessoas como essas não deviam ser permitidas no céu. Não é preciso ser um gênio para saber que você não deve carregar objetos pesados enquanto voa! Vou denunciar esse idiota e garantir que ele tenha a licença de voo revogada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843113,
					"content": "Objeto pesado... Será um artefato perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "Você viu para qual direção ele foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "Eu consegui dar uma olhada enquanto fugia, parece que ele foi... Naquela direção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843116,
					"content": "#Parece uma boa pista, {NICKNAME}! Vamos por lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "Ah, não se preocupe. Assim que eu voltar, pedirei aos Cavaleiros para eliminarem os Hilichurls restantes o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
