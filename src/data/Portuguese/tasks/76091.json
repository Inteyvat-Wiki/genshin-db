					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Uma fada voadora! Minhas anotações... minhas anotações importantes foram levadas pelos Fatui! Você pode me ajudar a recuperá-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Bom, a Paimon não é exatamente uma fada... mas algo assim vai ser moleza! Mas ainda assim, o que os Fatui querem com o caderno de uma criança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Talvez eles tenham medo que eu conte pra todo mundo o que está nas anotações... Se você me ajudar a recuperar tudo, eu conto o segredo pra você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "A gente pode falar disso depois. Agora, por favor, me ajude a recuperar meu <color=#00E1FFFF>caderno</color>. Algumas <color=#00E1FFFF>páginas podem ter se espalhado</color> também... Devem estar por ali, onde os Fatui estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
