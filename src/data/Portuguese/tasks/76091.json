			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Você entrega o caderno e as páginas que encontrou...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Deixa eu ver... Isso! São essas mesmo. Muito obrigado! Tem muitas provas dos crimes dos Fatui aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "...Provas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Olha só todas aquelas instalações que eles construíram na Ilha Paha, e as máquinas que trouxeram... Aquele lugar já foi lar de tantos animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Acabei de voltar da Bacia Marrom. Deve ser por causa das máquinas dos Fatui — todas as águas-vivas de lá mal estão sobrevivendo... Eu preciso contar isso pra todo mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Hã? Você quer dizer a Gelatina de Valberry e os outros? Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Você conta a ele o que aconteceu na Bacia Marrom...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Então já é tarde demais... mas mesmo assim, isso precisa ser registrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "Vou deixar este caderno com você. Preciso correr de volta e revisar o resto das minhas anotações pra poder transformá-las em um artigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Ah, e se for contar pra alguém, diga que foi o Semyon quem te contou. Afinal, ainda vai levar um tempo até eu conseguir escrever e publicar no jornal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "Enfim, muito obrigado! Até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
