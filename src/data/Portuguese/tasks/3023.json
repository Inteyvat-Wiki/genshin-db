					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Eu estava brincando. Sei que meus livros são difíceis demais para você e não tenho intenção de emprestá-los.",
