			"dialogs": [
				{
					"id": 718190401,
					"content": "*Chorando* Eu-Eu ainda não terminei de escrever meu desejo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190402
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190402,
					"content": "Seja uma boa garota, Pequena Xian. Aquele simpático tio Millelith foi buscá-la para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190403
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190403,
					"content": "Sobre Cai Le...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190404
					]
				},
				{
					"id": 718190404,
					"content": "Você está procurando por aquele simpático Millelith?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190405
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190405,
					"content": "Yi Xian estava escrevendo seu desejo em uma Lanterna Celeste quando de repente ela perdeu o controle sobre ela, e a Lanterna voou para longe naquela direção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190406
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190406,
					"content": "Aquele Millelith nos disse que a tinha visto pendurada em uma árvore e foi buscá-la para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190407,
						718190408
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190407,
					"content": "O que tem de tão especial naquela Lanterna Celeste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				},
				{
					"id": 718190409,
					"content": "Eu disse a ela que podíamos fazer outra, mas ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190410
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190410,
					"content": "Uh... Não... Não podemos. Meu irmão trabalhou tão duro para fazer aquela lanterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190411
					],
					"speakerTitle": "Yi Xian"
				},
				{
					"id": 718190411,
					"content": "Pequena Xian, aquele tio simpático vai trazê-la de volta logo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190412
					],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190412,
					"content": "Minhas desculpas. Se você realmente precisa falar com aquele Millelith, você pode encontrá-lo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yi Zhu"
				},
				{
					"id": 718190408,
					"content": "Você não pode apenas fazer outra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190409
					]
				}
			]
		},
