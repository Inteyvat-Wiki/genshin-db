				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190601,
					"content": "Você conseguiu pegar a Lanterna Celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190602
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190602,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190603
					]
				},
				{
					"id": 718190603,
					"content": "Deixe-me dar uma olhada... Sim, é essa mesmo. Você fez o dia daquelas crianças. Eu irei devolver a elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190604
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190604,
					"content": "Espero que ainda estejam me esperando onde as deixei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190605
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190605,
					"content": "Sobre o presente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190606
					]
				},
				{
					"id": 718190606,
					"content": "Isto deve ser do Ministério dos Assuntos Civis. Muito bem, muito obrigado. Obrigado por ter se incomodado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190607
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190607,
					"content": "Esse também é seu dever como membro dos Millelith?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190608
					]
				},
				{
					"id": 718190608,
					"content": "Você quer dizer recuperar as Lanternas Celestes perdidas? Hahahah, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190609
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190609,
					"content": "Não importa se é encontrar Lanternas Celestes, perseguir os malfeitores ou derrotar monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190610
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190610,
					"content": "O dever dos Millelith é ajudar os que precisam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190611
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190611,
					"content": "Mais uma vez, obrigado. Preciso me apressar e devolvê-la àquelas crianças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190612
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190612,
					"content": "E depois ainda tenho outras tarefas para completar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
