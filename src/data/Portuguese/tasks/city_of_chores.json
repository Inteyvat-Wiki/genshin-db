					"Wang'ya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190101,
					"content": "Não sei mais se estou indo ou vindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190102
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190103
					]
				},
				{
					"id": 718190103,
					"content": "Não se preocupe, estou apenas tentando resolver tudo o que precisa ser resolvido para o Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190104
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190104,
					"content": "É só que... Quanto mais penso sobre isso, mais problemas surgem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190105
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190105,
					"content": "Mesmo que meus colegas tenham tomado parte da carga de trabalho para eles, este ano é a minha vez de coordenar a entrega das Lanternas Celestes. Se eu não me esforçar e preparar tudo, não conseguirei a tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190106,
						718190107
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190106,
					"content": "Enviar uma Lanterna Celeste para quem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				},
				{
					"id": 718190108,
					"content": "Certo... Quando eu disse \"entrega das Lanternas Celestes\", eu quis dizer mais do que apenas enviar as Lanternas propriamente dito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190109
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190109,
					"content": "Simplificando... Trata-se mais de desempenhar o papel de embaixadora do Ritual de Lanternas, transmitindo desejos de bem e criando o clima festivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190110
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190110,
					"content": "Mesmo com a maioria das pessoas não trabalhando durante o festival, incluindo alguns donos de lojas e seus funcionários...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190111
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190111,
					"content": "Ainda há trabalhadores essenciais, que não podem simplesmente fazer uma pausa, por exemplo, os encarregados de manter a ordem durante a celebração, como os Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190112
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190112,
					"content": "O Ministério dos Assuntos Civis geralmente lhes envia presentes para reconhecer seu árduo trabalho em torno da temporada do Ritual de Lanternas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190113
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190113,
					"content": "Estava prestes a visitar os Millelith responsáveis por manter nossa cidade segura para presenteá-los com Lanternas Celestes como sinal de gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190114
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190114,
					"content": "Entretanto... Estamos um pouco sem funcionários e ainda não conseguimos enviar os presentes a todos os soldados da nossa lista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190115
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190115,
					"content": "Você poderia me fazer um favor e entregar estes presentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190116
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190116,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190117
					]
				},
				{
					"id": 718190117,
					"content": "Sério? Isso é incrível! Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190118
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190118,
					"content": "Quem são os sortudos destinatários?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190119
					]
				},
				{
					"id": 718190119,
					"content": "Deixe-me ver... Qual dos Millelith ainda não receberam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190120
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190120,
					"content": "Xiangming... Hongyi... E Cai Le.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190121
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190121,
					"content": "Vou marcar seus postos para você. Não tenho palavras para lhe agradecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190107,
					"content": "Para quantas pessoas você tem que enviá-las?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190108
					]
				}
			]
		},
