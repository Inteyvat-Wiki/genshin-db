					"Wang'ya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718190701,
					"content": "Você está de volta! Como foi a entrega dos presentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190702
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190702,
					"content": "Todos receberam seus presentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190703
					]
				},
				{
					"id": 718190703,
					"content": "#Você é {M#um verdadeiro salvador}{F#uma verdadeira salvadora}... Eu não teria conseguido sem você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190704
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190704,
					"content": "Eles realmente precisam ficar de plantão durante todo o festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190705
					]
				},
				{
					"id": 718190705,
					"content": "Bem... O Ministério dos Assuntos Civis programa turnos alternados para eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190706
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190706,
					"content": "Mas Liyue é muito grande. Há muitos postos e lugares que precisam de patrulhamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190707
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190707,
					"content": "Simplesmente não temos recrutas suficientes. Mesmo que se revezem, alguns deles levarão a pior e trabalharão durante o Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190708
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190708,
					"content": "Além disso, considerando a grandiosidade das celebrações do Ritual de Lanternas a cada ano, algumas partes da cidade exigem recursos adicionais. Não importa como distribuímos nosso pessoal, nunca há mão de obra suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190709,
						718190710
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190709,
					"content": "Parece realmente um trabalho muito árduo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				},
				{
					"id": 718190711,
					"content": "Bem, esse é o nosso trabalho... Faremos o que pudermos para garantir que todos tenham um bom Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190712
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190712,
					"content": "O que me faz lembrar de outras pessoas que podem precisar de ajuda durante o festival. Seria bom da sua parte dar-lhes uma mãozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190713
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190713,
					"content": "Quanto mais pessoas incentivarmos a participar do Ritual de Lanternas, mais festiva será sua atmosfera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190714
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190714,
					"content": "Soltamos Lanternas Celestes porque gostaríamos que todos pudessem soltar uma e fazer seus próprios desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190715
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190715,
					"content": "Em uma escala mais ampla... Gostaríamos que o Ritual de Lanternas se espalhasse por toda parte. Seria ótimo se todos pudessem experimentar a atmosfera do Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190716
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190716,
					"content": "O Ritual de Lanternas é para todos, afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190717
					],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190717,
					"content": "Muito bem, o dever me chama. Espero que você se divirta muito durante o Ritual de Lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang'ya"
				},
				{
					"id": 718190710,
					"content": "Parece bem difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190711
					]
				}
			]
		},
