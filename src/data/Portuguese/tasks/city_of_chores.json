			"dialogs": [
				{
					"id": 718190501,
					"content": "Pelos Arcontes... Como eu chego lá? Talvez eu devesse tentar algo diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190502
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190502,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190503
					]
				},
				{
					"id": 718190503,
					"content": "Viajante? Haha, não é nada. Estou apenas me perguntando como subir essa árvore e recuperar aquela Lanterna Celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190504
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190504,
					"content": "É tão difícil combater a gravidade com toda essa armadura. Eu simplesmente escorrego de volta todas as vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190505
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190505,
					"content": "Errr... Você se importaria de me dar uma mãozinha? Recuperar aquela Lanterna Celeste não deve ser muito difícil para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190506
					],
					"speakerTitle": "Cai Le"
				},
				{
					"id": 718190506,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190507
					]
				},
				{
					"id": 718190507,
					"content": "Ótimo, muito obrigado. Vamos fazer isso o mais rápido possível para que a menininha finalmente se alegre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cai Le"
				}
			]
		},
		{
			"id": 7181906,
