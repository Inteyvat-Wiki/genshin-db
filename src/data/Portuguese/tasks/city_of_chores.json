			"dialogs": [
				{
					"id": 718190201,
					"content": "Hmm? Você precisa de alguma coisa? Eu estou em serviço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190202
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190202,
					"content": "Entrega de presentes do Ritual de Lanternas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718190203
					]
				},
				{
					"id": 718190203,
					"content": "Fale mais baixo!Eu ainda estou em uma missão. De que presente você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190204
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190204,
					"content": "O Ministério dos Assuntos Civis pediu para você entregar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190205
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190205,
					"content": "Mais um ano, mais um Ritual de Lanternas. E eu queria ter ido para casa no início deste ano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190206
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190206,
					"content": "Mas dada a situação atual, ainda não posso relaxar... Acho que voltarei para casa um pouco mais tarde de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190207
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190207,
					"content": "Obrigado por ter vindo de tão longe. Vou ficar com isto. Obrigado mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718190208
					],
					"speakerTitle": "Xiangming"
				},
				{
					"id": 718190208,
					"content": "*Suspiro* Quando é que aquele sujeito vai embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangming"
				}
			]
		},
