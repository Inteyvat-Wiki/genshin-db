					"nextDialogs": [
						733120312
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733120312,
					"content": "Pode não ser o que elas desejaram, porém, essa aparência delas após se agarrarem tanto a este mundo... Urg, que ridículo e feio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120313
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733120313,
					"content": "Elas podem parecer um pouco estranhas, mas seria maldade chamá-las de feias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733120314,
					"content": "E de ver você rodeada de tantas plantas, Paimon até achou que você se sentiria em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733120315,
					"content": "Hunf, apenas me sinto em casa quando estou no campo de batalha. Apenas a batalha que dura até o fim dos tempos pode ser considerada a verdadeira eternidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120316
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733120316,
					"content": "Agora que você está me seguindo, é bom você aprender isso o mais cedo possível, Flutuante Pálida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733120317
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733120317,
					"content": "As Pari lutando contra a impureza que tem corrompido a terra gastaria suas últimas forças e se tornaria uma Árvore Fravashi.",
					"roleType": "TALK_ROLE_NPC",
