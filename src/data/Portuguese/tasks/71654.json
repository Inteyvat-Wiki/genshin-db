			"dialogs": [
				{
					"id": 716540201,
					"content": "Uau... Este bule parece ainda maior por dentro do que o da Madame Ping. Existe até uma grande casa no meio dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540202,
					"content": "Mas não havia nada nos arredores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540203,
					"content": "Paimon, vá quebrar umas pedras e faça uma casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "Paimon não consegue quebrar pedras! Não é você que usa uma espada? Você que quebre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540207,
					"content": "Ainda assim... Por que está tão vazio aqui, além daquela casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540208,
					"content": "Uh? Espere um pouco, o que é aquilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540205,
					"content": "Paimon, cave um túnel para viver nele por enquanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "Ei! Tem uma casa perfeitamente boa ali mesmo. Por que Paimon deveria ter que viver em um buraco no chão!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
