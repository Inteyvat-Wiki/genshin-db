			"dialogs": [
				{
					"id": 710122401,
					"content": "De onde veio essa coisa? Não estava aqui antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "Como você o evocou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "Ah, então isso é o \"tempo e o vento\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "Então, tem outro relógio de sol exatamente igual a este na ilha, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "Aliás, o método para resolver o enigma é igual. Esses dois Relógios Solares, e esses lugares estão relacionados com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "Preciso achar uma forma de chegar a esta ilha, e rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "Obrigado, Viajante. Uma vez que eu tenha feito alguns preparativos, vou procurá-lo, e visitaremos juntos aquela ilha desabitada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
