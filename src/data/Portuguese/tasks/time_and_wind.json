			"dialogs": [
				{
					"id": 710121101,
					"content": "O tempo e o vento... O que aquele sujeito encontrou aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "O Tempo e o Vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Oh, isso é algo que meu amigo mencionou na última carta que me enviou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Ele disse que \"o tempo e o vento\" escondem um dos segredos de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "No entanto, nunca ouvi essa frase antes, e eu sou destas partes. Quem sabe onde ele ouviu isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Você estudou em Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Sim. Embora eu seja de Mondstadt, sempre estive estudando na Academia de Sumeru. Provavelmente passei mais tempo lá do que em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Você quer saber o que acontece lá dentro? Bem, não é um segredo, então... Hmm, como posso dizer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Eles são um bando de pessoas estranhas. Hmm, talvez isso seja muito desrespeitoso... Eu acho que eles são \"pessoas que causam um grande impacto\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Se alguma vez você tiver a chance de ir, verá o que quero dizer. Mas basta dar uma olhada. Você não vai querer ficar lá por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
