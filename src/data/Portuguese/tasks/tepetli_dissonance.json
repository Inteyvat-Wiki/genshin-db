					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "Por acaso seria um Nome Antigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "Qual é! A Arconte Pyro disse que ela até falou com Xilonen para ajudar com isso. Não precisa tornar as coisas mais complicadas do que necessário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Apenas precisamos... de um presente legal, mas, normal, hehe.",
					"roleType": "TALK_ROLE_NPC",
