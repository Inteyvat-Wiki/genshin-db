			"dialogs": [
				{
					"id": 150120401,
					"content": "Bem, eles foram bem decididos... em sair correndo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Isso é o que chamam de \"consciência situacional\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Ufa... muito obrigada.  Eu poderia ter sido jogada montanha abaixo se não fosse pela ajuda de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Salva por pel{F#a}{M#o} Viajante... Parece que hoje é meu dia de sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Ah, desculpe. Esqueci de me apresentar. Eu sou Cheven, uma artesã de gemas. Geralmente não tenho sorte assim, mas talvez as coisas comecem a melhorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Imix pediu para a gente vir ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Aquela garota... *Suspira* Parece que preocupei ela de novo. Eu não imaginava que ficaria mais do que dois dias fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Mas aí eu descobri um novo estrato de Cristal Vulcânico perto do Prego das Sombras... é um depósito grande e com pureza excepcional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Eu desenterrei um monte disso e estava me preparando para voltar, mas os Flogistos dentro dos cristais atraíram monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "A fama tem suas vantagens, eu acho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
