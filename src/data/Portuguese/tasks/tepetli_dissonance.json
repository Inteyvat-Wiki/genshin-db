			"dialogs": [
				{
					"id": 150120501,
					"content": "Eu entrei em pânico e acabei seguindo por um caminho estreito para evitá-los... só para encontrar aqueles bandidos assim que saí. Ainda bem que você chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Se a situação tava tão perigosa, por que você só não largou os cristais e correu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Eu deixei a maioria deles para trás, papo reto. Só fiquei com o pedaço mais puro — tenho que levar ele de volta, custe o que custar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "Por Tlazolli e pela pobrezinha da Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "Desculpe, mas quem são elas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ah, é normal que você não saiba. Tlazolli... era uma artesã de Nome Antigo e Nechca é sua filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "Cheven"
				}
			]
		},
		{
