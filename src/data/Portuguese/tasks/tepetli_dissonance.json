			"dialogs": [
				{
					"id": 150120101,
					"content": "E-Ela não voltou ainda... Espero que nada ruim tenha acontecido com a Mestre Cheven...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Aquela criança ali está chorando. Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "Vamos dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Ei, garotinha! O que foi que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*Soluça* A mestre Ch-Cheven... ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "E-Ela disse que iria coletar alguns Cristais Vulcânicos... Mas não voltou ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Eu falei com os guardas sobre isso, mas eles disseram que não têm pessoas disponíveis no momento e o terreno é muito perigoso por lá, com muitos monstros e malvados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Eles têm que terminar os preparativos antes de tentarem resgatá-la... Mas será tarde demais até lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "Não precisa se preocupar, nós cuidamos disso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Quer dizer que vocês vão ajudar? Ótimo! Espera aí, eu vou desenhar para você os lugares onde os guardas estiveram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Eles disseram que ela pode ter parado mais ou menos por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Ela pode até ter sido forçada a se aproximar do Prego das Sombras. Se for o caso... Então... *Soluça*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "#Por favor, {M#senhor}{F#senhorita}! Me ajude a salvar a Mestre Cheven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "#Parece que teremos que ser {M#heróis}{F#heroínas} mais uma vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
