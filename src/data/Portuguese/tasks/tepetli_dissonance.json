			},
			"dialogs": [
				{
					"id": 150120601,
					"content": "Enfim, suponho que você também tenha visto a área ao redor, certo? Isso tudo é porque o Prego das Sombras, que estava pendurado acima, caiu no chão e deixou uma cratera enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120602
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120602,
					"content": "A veia que encontrei estava mais próxima do exterior, então foi poupada do desastre, mas todos os monstros ao redor ficaram assustados e agora estão agitados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120603
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120603,
					"content": "Os monstros me deixaram em pânico e acabei seguindo por um caminho estreito para evitá-los... só para encontrar aqueles bandidos assim que saí. Ainda bem que você chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120604
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120604,
					"content": "E você ainda estava carregando esses cristais enquanto corria? Por que você não largou eles se são tão perigosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120605,
					"content": "Ah, eu descartei muitos deles, papo reto. Na verdade, tudo o que resta é o pedaço mais puro de todos. Estou determinada a trazê-lo de volta, custe o que custar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120606
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120606,
					"content": "Eu preciso fazer isso pela Tlazolli e pela pobrezinha da Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120607
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120607,
					"content": "Desculpe, mas quem são elas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120608
					]
				},
				{
					"id": 150120608,
					"content": "Ah, é normal que você não saiba. Tlazolli... era uma artesã de Nome Antigo e Nechca é sua filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120609
					],
					"speakerTitle": "Cheven"
				}
			]
