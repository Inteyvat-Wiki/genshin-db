			"dialogs": [
				{
					"id": 191431001,
					"content": "E agora? Será que não vai dar para jogar o Chamado Sagrado dos Sete hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "E se mudarmos de lugar? Mas tem algum lugar além de debaixo da ponte onde os adultos não descobririam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "Ah, já sei! Vamos pedir para a Yoimiya soltar uns fogos de artifício para espantarmos quem roubou nosso lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "Isso é maldade... Embora, ele tenha chutado a gente primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Então a culpa é dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Eu acho que... Apenas deveríamos voltar para fazermos o dever de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Se a gente só jogar carta e não estudar, a gente vai acabar ser tornando <color=#00E1FFFF>esse tipo de adulto que fica embaixo da ponte</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
