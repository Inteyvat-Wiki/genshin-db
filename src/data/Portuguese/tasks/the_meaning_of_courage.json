			"dialogs": [
				{
					"id": 150310301,
					"content": "Tudo pronto! Esse núcleo parece bom. Tá vendo? O Flogisto dentro dele ainda está ativo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Ooh, vamos ver... Eita, quente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Mais alguns pedaços tipo esse devem ser suficientes. Vamos lá, deve ter mais no topo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
