			"dialogs": [
				{
					"id": 150310101,
					"content": "O Chefe Acatl junta todos da tribo para ouvir o relatório da Varesa sobre os cogumelos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310105,
					"content": "Ok, então parecia bem normal na hora, mas ouvir isso de novo parece meio... ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310106,
					"content": "Esse silêncio é ensurdecedor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "Então os cogumelos no pomar são conscientes? Que descoberta impressionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310108,
					"content": "É, sem sua investigação, quem sabe o que poderia ter acontecido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310109,
					"content": "Agradeço por investigar e ir coletar essas informações!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "Xoctli"
				},
				{
					"id": 150310110,
					"content": "Ufa, que alívio... Eu me preocupei em parecer maluca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310111,
					"content": "Hahaha, parece meio estranho mesmo. Afinal, nenhum de nós já conversou com um cogumelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310112,
					"content": "Mas sabemos que você não é de mentir, Varesa. Além disso, a origem dos cogumelos verdes sempre foi um mistério para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310113,
					"content": "Graças a você, agora sabemos que algo sinistro pode estar acontecendo. Então, devemos fazer nossa parte para ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310114,
					"content": "É, só me avise se tiver alguma coisa que eu puder fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310115,
					"content": "Uau, não foi difícil convencer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310116,
					"content": "Valeu, pessoal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "Ah, espera, você disse que os cogumelos precisam ser cozinhados em fogo alto, certo? Eu posso fazer isso agora mesmo — vai ser rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310118,
					"content": "Beleza, voltei! Eu usei ferro fundido, então deve tá quente suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310119,
					"content": "Uau, que cheiro delicioso! De repente, Paimon tá com fome de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310120,
					"content": "B-Bem, aqui vamos nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310121,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310122,
					"content": "Espera, essa é a voz dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310123,
					"content": "Hahaha, parece que vocês encontraram o caminho certo, mas essa temperatura não demonstra nem uma fração da sinceridade que preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310124,
					"content": "Vocês acham mesmo que um fogão normal poderia gerar calor suficiente para conquistar o reconhecimento do Lorde Sábio dos Cogumelos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310125,
					"content": "Humanos são uma grande decepção. Vocês podem solucionar minhas charadas quando as respostas são entregues a vocês em uma bandeja de prata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310126,
					"content": "Mas assim que as dicas acabam... nenhuma fagulha de inteligência fica à vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310127,
					"content": "Tentem usar o cérebro dessa vez, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310128,
					"content": "C-Como foi? Você ouviu a voz dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310129,
					"content": "Ugh! Que cogumelo irritante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310130,
					"content": "O Lorde Sábio dos Cogumelos disso que o calor ainda não é suficiente. Hunf, Lorde Sábio da picuinha, isso sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310131,
					"content": "Mesmo assim, o único jeito de descobrir os objetivos dele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "Não é alta suficiente, né... Acho que isso quer dizer que precisamos de uma fonte de calor mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310134,
					"content": "Atenção, pessoal! Precisamos de itens que conseguem gerar calor intenso. Qualquer coisa que encontrarem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310135,
					"content": "Vou ver o que posso fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310136,
					"content": "Deixa comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310137,
					"content": "A gente devia dar uma olhada também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310138,
					"content": "Definitivamente! Mas a gente não conhece essa área muito bem. Você tem alguma ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310139,
					"content": "Hmm... Nada concreto, mas podemos conferir perto do vulcão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310140,
					"content": "Ele cospe todo tipo de coisa. Talvez haja algo que podemos usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310141,
					"content": "Legal, vamos lá! Paimon vai encontrar uma coisa pegando fogo e vai jogar na cara daquele cogumelo estúpido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310132,
					"content": "É continuar cooperando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
