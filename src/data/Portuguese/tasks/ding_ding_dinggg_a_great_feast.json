			"dialogs": [
				{
					"id": 402070201,
					"content": "Ei, Ineffa! Ah, Jahoda! Você também tá aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070202,
					"content": "Bom, depois de tanto esforço, eu pelo menos mereço uma fatia de bolo, né? Concorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070203,
					"content": "Espera, tem bolo!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070204,
					"content": "Sim. Vocês chegaram bem na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070205,
					"content": "A Aino queria agradecer pela ajuda, então agora que o Trilimlim tá de volta, são e salvo, ela achou que seria legal todo mundo experimentar as receitas dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070206,
					"content": "*Om nom nom*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "Trilimlim 70% Doce"
				},
				{
					"id": 402070207,
					"content": "Uau, então era assim que o Trilimlim devia ser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070208,
					"content": "Sim. Felizmente, o núcleo ainda estava intacto, então tudo que a Aino precisou fazer foi construir um novo corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070209,
					"content": "*Nom nom...*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "Trilimlim 70% Doce"
				},
				{
					"id": 402070210,
					"content": "Ooh, tá pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070211,
					"content": "Gulp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "Trilimlim 70% Doce"
				},
				{
					"id": 402070212,
					"content": "Ei, ele comeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070213,
					"content": "Não é incomum um chef dar umas mordidas antes de servir o prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070214,
					"content": "Não se preocupem. Assim que ele se saciar, ele começa a preparar as sobremesas pra todo mundo. Vai ser rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070215,
					"content": "Certo... Espera, falando em sobremesas, cadê a Aino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070216,
					"content": "Ah, ela teve uma nova ideia pra um robô e se trancou na oficina pra começar. Quando a inspiração bate, ela parte pra ação. É assim mesmo que ela é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070217,
					"content": "Por que a Aino gosta tanto de construir robôs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070218,
					"content": "Hm... Recuperando registros históricos do banco de dados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070219,
					"content": "No começo, acho que a Aino só ficou surpresa de ter encontrado algo que fascinasse mais do que sobremesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070220,
					"content": "E, felizmente, seus amigos respeitaram sua paixão, mesmo que, além das dificuldades pra se manter, sobrasse pouco tempo pra qualquer outra coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070221,
					"content": "Então, um dia, um professor renomado a descobriu e reconheceu sua paixão pelo que ela realmente era... genialidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070222,
					"content": "Assim como seus amigos, ela finalmente descobriu o que queria fazer. E, mais que isso, se destacou nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070223,
					"content": "E quando genialidade e paixão se encontram, pouca coisa consegue ficar no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070224,
					"content": "Então, Aino deixou seus amigos de infância, fundou a Oficina de Rolinho de Ovo Trilimlim e começou a criar todo tipo de companheiro robótico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070225,
					"content": "Talvez tudo se resuma ao instinto natural de um gênio... o desejo de ver sua imaginação ganhar vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070226,
					"content": "Ah... Então é isso que atrai ela para a robótica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070227,
					"content": "Com base na minha própria experiência com a Aino, acho que é mais do que isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070228,
					"content": "Muito antes de me acolher, ela já estava levando suas habilidades ao limite para dar a cada robô uma personalidade distinta, e já os tratava como companheiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070229,
					"content": "O que quero dizer é que isso não começou comigo, só porque tenho uma origem única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070230,
					"content": "Acho que, depois de trilhar o caminho de um gênio por tanto tempo, ela olhou ao redor e percebeu que não havia ninguém ao seu lado — e isso a fez se sentir solitária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070231,
					"content": "Então, eu, o Trilimlim 70% Doce, e todos os outros robôs que a Aino trouxe para a oficina... Não somos apenas provas de sua genialidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070232,
					"content": "Somos a família dela. Damos a ela a companhia que tanto deseja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070233,
					"content": "Na minha visão, essa é a verdadeira relação entre Aino e seus robôs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070234,
					"content": "Uau... Então vocês realmente significam muito para ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070235,
					"content": "Sim. E por isso, não importava para a Aino o quão poderoso o Trilimlim pudesse se tornar, o quanto sua tecnologia fosse temida ou cobiçada entre as facções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070236,
					"content": "Ela decidiu que ele faria parte desta família, e isso significava que ela não mediria esforços para salvá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070237,
					"content": "É, isso faz sentido! Mas deixa a Paimon pensando por que alguém como a Aino escolheria ficar em Nod-Krai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070238,
					"content": "...Receio que minha unidade lógica não consiga entender essa questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070239,
					"content": "Bom, do jeito que a Paimon vê, Nod-Krai é um lugar onde só os mais espertos sobrevivem, cheio de trapaças e enganações. As pessoas que se dão bem aqui parecem feitas pra esse tipo de coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070240,
					"content": "Qualquer outro usaria a tecnologia que a Aino tem pra criar armas e ameaçar os outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070241,
					"content": "Mas a Aino... ela pega algo que poderia ser uma arma e transforma num robô que faz bolos. Simplesmente não parece que ela combina com esse lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070242,
					"content": "Não, minha visão é exatamente o oposto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070243,
					"content": "Já encontrei todo tipo de pessoa que vive aqui em Nod-Krai. Mas, pela minha experiência, são poucos os que realmente representam este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070244,
					"content": "Você diz que a Aino não combina com aqui, Paimon. Eu acredito no contrário. Se eu tentasse definir como deve ser uma pessoa de Nod-Krai... ninguém se encaixa melhor do que a Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070245,
					"content": "*Ding*... *Ding*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "Trilimlim 70% Doce"
				},
				{
					"id": 402070246,
					"content": "Ooh, as sobremesas devem estar prontas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070247,
					"content": "Sim. Só um instante. Permita-me servi-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070248,
					"content": "Eu quero aquele com mais cobertura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070249,
					"content": "Certo, pessoal. Podem atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070250,
					"content": "...Mmm! Valeu muito a pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}