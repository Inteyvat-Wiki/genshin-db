			"trigger": {
				"objectNames": [
					"Autoproclamado \"Tang Wuchou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "O que houve? Você teve azar com os jogos do Chou de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820102,
					"content": "Oh, eu já lhes disse. Essa caçada ao tesouro dele funciona assim: <color=#00E1FFFF>quanto melhor a coisa for, mais barris explosivos haverão ao seu redor, e vice-versa.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820103,
					"content": "Entendeu agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Autoproclamado \"Tang Wuchou\"",
					"Tio He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Seus malditos Ladrões de Tesouro... Uff... Uff... Se eu não estivesse tão cansado... Porque não comi cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820202,
					"content": "Eu já teria dado uma lição em vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820203,
					"content": "Seu ladrão velho! Como você ousa chamar minhas flores... minhas Qingxin, de cogumelos?! E colhê-las e comê-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820204,
					"content": "*Cof Cof* Que direito você tem de fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820205,
					"content": "Ah, por que vocês dois estão brigando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "Eu estava procurando por carne de cogumelo! Sim, carne de cogumelo! Mas eles não me deixaram entrar de volta nas minas! Por isso eu vim aqui procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820207,
					"content": "E após procurar muito, eu finalmente descobri que existem cogumelos aqui! Mas quando fui pegá-los, esse cara aqui me atacou do nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820208,
					"content": "#Haha! Você que se atreveu a entrar nos campos de treinamento do Clã de Guhua! E essas flores são minhas, e {F#da heroica}{M#do heroico} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820209,
					"content": "E a heroica Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Sim, e a heroica Paimon! Com exceção de nós três, ninguém pode entrar nesses terrenos sagrados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820211,
					"content": "Maldito Ladrão de Tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820212,
					"content": "Maldito bandido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820213,
					"content": "Está bem, está bem, Tio He. Tang Wuchou já não é mais um Ladrão de Tesouro. E as coisas que plantou são flores, não cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "Hã? É mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820215,
					"content": "Venha dar uma olhada, não está vendo que são Qingxin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "Ah, sim, são Qingxin mesmo! Eu só ainda estou um pouco tonto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820217,
					"content": "E você, Tang Wuchou, você realmente ainda está pensando em fazer aquele jardim de Lírios de Vidro seu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Bem, seria uma bela vista, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				},
				{
					"id": 710820219,
					"content": "Parem de brigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*Suspiro* Sem cogumelos. Eu vou embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710820221,
					"content": "Agora que aquele velho encrenqueiro foi embora, finalmente posso plantar algumas flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Autoproclamado \"Tang Wuchou\""
				}
			]
		}
	]
}