				]
			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "O Onikabuto da Yanfei é tão forte! O que que a Madame Ping deu para aquela coisa comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "Vê? O Onikabuto da sua salvadora é uma força a se temer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716664103,
					"content": "Mas como da última vez, quando meus generais te jogaram algumas bolas curvas, a lâmina mais poderosa não pode abater seu inimigo, exceto se estiver nas mãos de um espadachim habilidoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716664104,
					"content": "#S-S-Sábias palavras, Grande Mestre... Beleeeeza... Que bom que {M#meu consagrado}{F#minha consagrada} se manteve forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Uau, que legal! Eu poderia me dar bem nessa coisa de Batalha de Besouros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664106,
					"content": "Isso foi muito divertido! Obrigada, pessoal! Eu vou ficar por aqui e jogar um pouco mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				}
			]
		},
