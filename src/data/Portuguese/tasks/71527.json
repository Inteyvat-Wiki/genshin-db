					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Oi! Voltei! Então, como vai o Esplendoroso Acampamento de Batalha de Besouros do Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664002,
					"content": "Ótima hora, Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "Minha salvadora! Muito obrigado por nós ajudar com a permissão! E pela placa com a arte épica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Espera, eu conheço esse olhar... Você por acaso, uh, quer virar alguns besouros também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Hum? Algo de errado com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664006,
					"content": "Tenho uma grande cliente que faz muito comércio entre as fronteiras — enfim, ela já me encheu de presentes uma vez depois que a ajudei a vencer um processo enorme, e entre eles estava um Onikabuto muito especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664007,
					"content": "Eu não sabia como cuidar dele na época, então eu pedi para a vovó cuidar dele por um tempo... Tá parecendo fortão esses dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664008,
					"content": "Se importa se eu me juntar? Vocês não tão preocupados que eu vou atrapalhar a onda de vocês, estão...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664009,
					"content": "Não devemos dispensar nossa salvadora, Rei Oni. O que ela carece de experiência, ela compensa com um dos Onikabuto com a constituição mais forte e mais surpreendente que eu já vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716664010,
					"content": "Você fez uma oferta que não posso recusar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "#Tudo bem, hora de mandar a Mão Direita do Rei Oni com Cajado Carmesim. Sei que {M#meu consagrado}{F#minha consagrada} vai ficar tranquil{M#o}{F#a} sob pressão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "Pode apostar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Então sou eu contra {NICKNAME}? Certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664015,
					"content": "Eu não tenho o entendimento completo desse jogo ainda, então peço desculpas em adiantamento por qualquer erro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Concorrente com Equipamento Apelão"
				},
				{
					"id": 716664013,
					"content": "Obrigado pelo voto de confiança!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
