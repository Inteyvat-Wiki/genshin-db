	"talks": [
		{
			"id": 2300302,
			"completionStepIds": [
				2300302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300302",
							"2"
						],
						"stepId": 2300302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "#Viajante! Ah, quero dizer, {M#o filho}{F#a filha} maravilha da sorte e da fortuna! Você está aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030202,
					"content": "Na última vez que comi o \"Prato de Ouro\" que você preparou, levei a melhor na Bolsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030203,
					"content": "Vim aqui hoje conferir e olha só... Tive ótimos ganhos em todos os contratos futuros que comprei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030204,
					"content": "Vamos para a Taverna de Lambad. Você poderá pedir o que quiser, eu pago! Afinal, eu tenho que lhe agradecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "É tudo graças à sua ajuda! Peça o que você quiser comer hoje, por favor! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030402,
					"content": "Parece que você realmente ganhou muito dinheiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030403,
					"content": "Não é ruim para uma pessoa comum, mas não é muito comparado aos bens que eu, Hatim, possuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030404,
					"content": "#Afinal, sou um especialista com décadas de experiência. Se você estiver {M#interessado}{F#interessada} em contratos futuros, posso compartilhar um pouco da minha experiência pessoal com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030405,
					"content": "Concordamos da última vez que você receberá benefícios adicionais, portanto, peça tudo o que quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030406,
					"content": "Ah! Sabe, este benefício adicional não parece muito diferente de não ter nenhum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030407,
					"content": "Afinal, não brincamos com contratos futuros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Ah, bobagem! Vocês também têm direito a uma parte da Mora, é claro. Mas comparado a isso, o meu conselho é o que realmente tem valor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030409,
					"content": "Então Paimon tem uma pergunta... Será que realmente haverá contratos futuros de Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030410,
					"content": "N-Não é porque Paimon quer ganhar Mora! Só para saber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030411,
					"content": "Apenas mercadorias em circulação podem se tornar contratos futuros, portanto, se houver tanto Condensado de Slime quanto farinha e leite no mercado, é possível formar contratos futuros de Condensado de Slime negociáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030412,
					"content": "Mas eu mencionei isso antes, se você quiser negociar contratos futuros de Condensado de Slime, temo que todos os Slimes na natureza serão extintos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030413,
					"content": "Além disso, podem aparecer instituições ou indivíduos que se especializam em criar Slimes e eles podem produzir continuamente grandes quantidades de Condensado de Slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030414,
					"content": "Quando chegar a hora, o preço do Condensado de Slime também pode subir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030415,
					"content": "O quê?! É só comprar um Condensado de Slime, como ficou tão complicado...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030416,
					"content": "#Paimon vai deixar {NICKNAME} derrotar aqueles Slimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030417,
					"content": "#E você, {M#filho}{F#filha} da sorte e fortuna, tem alguma dúvida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030418,
					"content": "Como surgiu a ideia de \"Prato de Ouro\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "#Ah! Você realmente é {M#um filho}{F#uma filha} da sorte e da fortuna. Você foi direto perguntar sobre a chave para a riqueza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030420,
					"content": "Eu realmente não posso dizer que \"inventei\" isso, mas posso dizer que aprendi esses \"Pratos de Ouro\" durante minha longa carreira na negociação de contratos futuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030421,
					"content": "O mercado de contratos futuros é traiçoeiro... Mas enquanto eu tiver os \"Pratos de Ouro\" poderei pilotar este navio de investimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030422,
					"content": "É realmente besteira infundada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Basta com isso! Vamos lá! Coma a comida! Coma um pouco mais! Pedirei mais ajuda no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030425,
					"content": "Venha! Prove este Rolinho Shawarma, é uma especialidade de Sumeru. Não pode deixar de provar, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030426,
					"content": "Você desfruta de uma comida deliciosa com Hatim...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "Isso não é apenas para \"paz de espírito\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "Mas eu fui ao \"Local de Riqueza\" e até comi o \"Prato de Ouro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030702,
					"content": "E o resultado é esta queda...! Isso não faz sentido! Como esse mercado está fazendo algum sentido? Onde está a justiça!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030703,
					"content": "Hatim, estamos procurando por você há muito tempo. Você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030704,
					"content": "São vocês... eu... estou bem. Estou ótimo... Olha. Não me falta um braço ou uma perna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030705,
					"content": "No entanto, o meu depósito está todo perdido... *ahem ahem*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030706,
					"content": "D-Desculpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "Não! Isso não é culpa sua. Não se sinta mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030708,
					"content": "Claro, certamente não é minha culpa também. O verdadeiro culpado é esse mercado por ser ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030709,
					"content": "Não faz sentido! Não vai de conforme as regras! Ele apenas caiu do nada, e subiu como... como... Não subiu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030710,
					"content": "Realmente, argh... eu realmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030711,
					"content": "Não importa, eu apenas não acredito... Eu, o magnata Hatim de Kalimi, ainda não consigo conquistar a negociação de contratos futuros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030712,
					"content": "Você não perdeu tudo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "Hum, não importa. Eu ainda tenho muitos fundos de reserva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030714,
					"content": "Mesmo sem dinheiro agora, ainda tenho capital de giro e ativos em outros lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030715,
					"content": "É só esperar, Bolsa Kalimi! Eu, Hatim, estarei de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		}
	]
}