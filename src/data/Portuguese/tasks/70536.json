					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "Hehe, Dodoco derrotou muitos guerreiros peixes espinhentos do mal! Até o rei peixe espinhento não tava com nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360102,
					"content": "Dodoco, Bomba Saltitante e as Faíscas Explosivas de Klee são os melhores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360103,
					"content": "Realmente imbatíveis!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "Esse jogo lembra Paimon do incidente acontecendo no Lago de Sidra... Lisa baseou o tema nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360106,
					"content": "Mas pensando bem, por que todo o trabalho de encontrar as espécies invasoras quando podiam só pedir para Klee explodir todo recife suspeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360107,
					"content": "Eles podiam até nos dar umas bombas e a gente cuidava disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360108,
					"content": "Você e Klee são farinha do mesmo saco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "Ora ora, pelo olhar de vocês parece que estão se divertindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360111,
					"content": "É Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360112,
					"content": "Você finalmente voltou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360113,
					"content": "A gente amou jogar Encontro Explosivo de Dodoco! Que jogo legal você fez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360114,
					"content": "Obrigada por jogar, fico feliz que gostaram. Hmm, talvez eu devesser pensar em umas novas atualizações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360115,
					"content": "Oooh, oba! Klee quer ver Dodoco indo em aventuras em todos os tipos de lugares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360116,
					"content": "Não, espera... Você deve ter passado muuuuuito tempo trabalhando no jogo, deve ser cansativo! A gente não devia fazer Lisa trabalhar demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360117,
					"content": "Awn, obrigada por ter tanta consideração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360118,
					"content": "Mas se ajuda a te mander feliz enquanto você fica dentro da idade, ficarei muito contente em passar quanto tempo for necessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360119,
					"content": "Claro, entendo que você prefere sair em suas próprias aventuras sempre que quiser. O jogo é só para ser um novo jeito de passar o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360120,
					"content": "Enfim, também tenho ótimas notícias, eu também trouxe um presente para vocês, fofuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360121,
					"content": "Um presente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360122,
					"content": "#Tenho um presente para {M#o Sr.}{F#a Srta.} Cavaleir{F#a}{M#o} Honorável e Paimon também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360123,
					"content": "Chegaremos aos presentes em breve, deixe-me te contar as novidades primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360124,
					"content": "O incidente no Lago de Sidra está resolvido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "Isso mesmo. Dois cavaleiros da Equipe de Investigação encontraram o ninho das espécies invasoras e o eliminaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360127,
					"content": "Os cavaleiros também determinaram a causa da invasão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360128,
					"content": "As espécies foram introduzidas acidentalmente ao lago por um comerciante sem qualquer intenção maliciosa, então os Cavaleiros o deixaram ir após um esporro e emitir uma multa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360129,
					"content": "Ufa... Ainda bem que eles não causaram muitos problemas. Mas até Paimon acha que o comerciante foi descuidado demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360130,
					"content": "A água no Lago de Sidra está salva!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "Já é hora dos presentes? Klee pode falar primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360133,
					"content": "Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360134,
					"content": "Klee voltou para casa na hora certa todos os dias sem ninguém precisar lembrar, fiquei curiosa sobre o que você tem aprontado recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360135,
					"content": "Hehe~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360136,
					"content": "Quando eu estava em casa à noite, eu dei uma olhada no livro de síntese de Albedo e aprendi a fazer isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360137,
					"content": "Ta-dá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360138,
					"content": "Eita, Dodoco tá arremessando uma Bomba Saltitante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360139,
					"content": "Sim! Eu fiz um boneco que parece Dodoco do Encontro Explosivo de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360140,
					"content": "Mesmo que eu não consiga fazer ele atirar bombas de verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360141,
					"content": "#Espero que isso lembre vocês da diversão que tivemos junt{M#os}{F#as} e exploda seus problemas e o tédio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360142,
					"content": "Um grande boneco de Dodoco! Paimon ama surpresas como essa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360143,
					"content": "Com isso, será como se a gente estivesse se aventurando com Klee e Dodoco onde a gente for!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360144,
					"content": "#Obrigad{M#o}{F#a} pelo presente criativo e considerado, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "Hehe, fico muito feliz que vocês gostaram do meu presente! Eu dei muito duro nele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360147,
					"content": "Qual é o seu presente, Lisa? Quero ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360148,
					"content": "Bem, receio que meu presente é muito menos criativo que o seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360149,
					"content": "É um livro de histórias sobre o Encontro Explosivo de Dodoco—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360150,
					"content": "Uma história de aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360151,
					"content": "Uau, um livro inteiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360152,
					"content": "As fofurinhas voltaram para Mondstadt e foram com Klee em uma aventura com Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360153,
					"content": "Juntos eles derrotaram os guerreiros peixes espinhentos malvados e aproveitaram um chá da tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360154,
					"content": "Uma ótima maneira de terminar o Encontro Explosivo de Dodoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360155,
					"content": "Eita, você planejou a história toda enquanto fazia o jogo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360156,
					"content": "Não. Como os protagonistas da história, você, fofura e Klee fizeram um papel importante em trazer a história à vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360157,
					"content": "Eu deixei um lugar vazio no livro especificamente para ilustrações...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360158,
					"content": "#Mas eu acabei de pensar em uma ideia ainda melhor — já que estamos todos aqui nessa ocasião especial, por que não tiro uma foto de vocês junt{M#os}{F#as}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360159,
					"content": "#Claro! A gente encontrou nossas amigas e brincamos junt{M#os}{F#as}, vale muito a pena comemorar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360160,
					"content": "Vamos tirar uma foto em grupo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#Vamos lá, Sr{F#ta}. Cavaleir{F#a}{M#o} Honorável e Paimon! Pronta, Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360163,
					"content": "Klee se divertiu tanto hoje! Três, dois, um... Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360161,
					"content": "Você tem que curtir as pequenas alegrias da vida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "Dodoco virá com a gente em todas as nossas aventuras a partir de agora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "A indústria de vinho de Mondstadt está salva!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360125,
					"content": "Klee pode brincar do lado de fora de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360109,
					"content": "Não, sem bombas para Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360104,
					"content": "Tome essa, peixe do mal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				}
			]
		}
	]
}