			"dialogs": [
				{
					"id": 191170106,
					"content": "Au! Au! Grrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170107,
					"content": "Você é uma coisinha bravíssima, não é? Você quase me mordeu de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170108,
					"content": "Olha só para você, definhando... Deve estar querendo comer alguma coisa, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170109,
					"content": "Você não precisa voltar com a gente, mas vamos lá - um cãozinho precisa comer, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170110,
					"content": "Você não está com medo que esteja envenenada, não é? Aqui, veja, vou dar a primeira mordida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170121,
					"content": "Viu só? Uma deliciosa comidinha sem veneno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170111,
					"content": "Thoma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Vamos lá, só dê uma mordidinha. Uma mordidinha de nada, e aí eu te deixo em paz. Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170114,
					"content": "Au! Au, au, au!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170115,
					"content": "Parece que ele não tem nenhuma intenção de comer a comida que trouxemos... É impressão minha, ou ele parece um pouco nervoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170116,
					"content": "Tem algo no mar? Ou algo próximo que o deixou em alerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170117,
					"content": "Aqueles monstros, talvez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "Você acha que ele foi atacado por monstros? Hmm, é possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170119,
					"content": "As pessoas costumam perder o apetite em situações perigosas. Talvez seja o mesmo para os cães. Vamos limpar a área em nome de nosso companheiro canino aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170120,
					"content": "#Obrigado por ajudar. Este lugar deve estar um pouco mais tranquilo agora, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170112,
					"content": "Você realmente está se esforçando tanto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
