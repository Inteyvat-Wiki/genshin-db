				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Bem, e eu vim pensando em dar uma olhada por causa dos barulhos assustadores que ouvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Repetindo o tempo todo: \"Qualé, Titu, não é nada...\", mas é algo! Algo incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "#E aqui também está um pequeno Tepetlissauro... foi você quem trouxe ess{F#as}{M#es} forasteir{F#as}{M#os} para cá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "E... foi você quem empurrou para baixo esse Prego das Sombras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "...A gente não devia ter feito isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Hã? Pera, a gente fez algo de ruim, {NICKNAME}? Mas, sabe, só tem uma testemunha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Haha, qualé, não fique assim! Na verdade, vocês nos fizeram um favor! Então você é {NICKNAME}? Quem é sua amiga ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#E esse é {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Eu me chamo Titu, um contador{RUBY#[S]Griô} de contos de nossa tribo. Também sou o responsável por \"cuidar\" dos pilares de pedra nesse vale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "E, claro, esse Prego das Sombras que você enfiou no chão, um de três, está sob minha jurisdição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "Jurisdição... Oh não, parece que a gente vai ter que pagar aos residentes por fazer aquele pilar de pedra cair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Urgh, a gente não devia ter usado nossos nomes de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Pagamento... \"Titu teve um vislumbre inspirador. Talvez ele possa usar isso para coagir essas pessoas a ajudá-lo a alcançar seus objetivos...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "É assim que eu colocaria um trecho como esse na trama, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Ah, sinto muito, eu acabei desviando do assunto com as histórias. Eu sou o responsável{RUBY#[S]Griô} por contar as histórias da tribo, e depois de tantos anos, preciso pensar em algumas originais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "E claro, se algo sair de errado com o Prego das Sombras, como eu estava pensando alguns dias atrás... por que choveria quando poderia jorrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Ahem. Enfim, não vou chantagear vocês. Bem, quero dizer, eu não teria dito meus pensamentos em voz alta se esse fosse o caso, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Veja bem, trocamos nossos nomes, mas não nos golpeamos, por isso somos amigos, correto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "Nesse caso... vocês poderiam escutar o pedido de um amigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Claro... desde que não envolva nenhuma forma de compensação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "Não, é claro que não! Hmm, como posso dizer... quando vocês passaram pelo vale, vocês viram algum tipo de flogisto sólido gigante cheio de entalhes dourados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "Está no centro desse lugar. Você não pode ter perdido ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Acho que me lembro vagamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "Todo esse negócio que eu tô falando tem a ver com aquele pilar enorme de pedra. Chamamos ele de Prego das Sombras, e tivemos alguns problemas com ele recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "Para ser franco, eu tinha desistido antes de conhecer vocês. Eu já tinha até mesmo a linha: \"Os Pregos das Sombras não podiam ser salvos, condenando a tribo a uma destruição catastrófica\"... não soava tão ruim assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Espera, é só um pilar de pedra. Ele não tem como destruir a tribo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "E o que tem de tão especial sobre esses Pregos das Sombras grandes e pequenos? Não são só uns pilarezões de pedra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "#Hmm, já que vocês são forasteir{F#as}{M#os}, suponho que uma explicação mais detalhada seja necessária. Isso é relacionado a uma lenda passada por nossa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "As histórias dizem que o Wayob pendurou os Pregos aqui para selar a sombra do Lorde do Vulcão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Mas o que está selado sob ele é, na verdade, o Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "É assim que a maioria das histórias em Natlan são. São narrativas embelezadas, cheias de retóricas e metáforas, mas que, no fundo, são avisos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Espera, você disse que o Abismo tá selado embaixo daqui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Isso. E recentemente, dois dos três Pregos das Sombras flutuaram para cima. Se o terceiro flutuar também, todo o mal sob a terra subirá como uma maré.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "Para ser franco, é uma bênção inesperada vocês terem conseguido empurrar um de volta. Por isso, nenhuma compensação é necessária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "Na verdade, eu gostaria de perguntar se vocês podiam empurrar o outro também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Hmm... o que você acha, {NICKNAME}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "...Não podemos ficar parados quando o Abismo está envolvido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Até você tá dentro, {REALNAME[ID(2)|SHOWHOST(true)]}? Certo, é isso aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Ah, como uma chama que aparece na escuridão, heróis também surgem em momentos de grandes perigos. A possibilidade humana brilha em momentos de glória como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Quer saber? Isso seria uma ótima história. {NICKNAME}, você tem algumas características que até os heróis das histórias não têm. Estou muito ansioso para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "#Vamos então, {F#minhas caras heroínas}{M#meus caros heróis}. Vamos checar o último Prego das Sombras flutuante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Talvez eu possa dar uma mão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Não, não lembro de ter visto nada desse tipo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Hmm, eu pensei que era óbvio. Mas, tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "Foi Paimon. Eu só tava de passagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Ei! Você toda vez diz isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "#Haha, não se preocupe. É um alívio ver isso. Seu nome é Paimon? Nesse caso, quem é {F#essa jovem senhorita}{M#esse jovem cavalheiro} aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Pode me chamar de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
