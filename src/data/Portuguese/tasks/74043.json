			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "O que eu quero? Direitos trabalhistas! Quando eu quero? Agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Ei, eu trouxe os núcleos que você queria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Hã? Deixe-me ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Por que você está protestando aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Devemos nos levantar onde caímos, é claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "O que você quer que eu faça, hein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Ugh, o que eu vou fazer com você, sério mesmo? Agora, alguém colocou máquinas estranhas desse tipo acima do solo e debaixo d'água. Elas são muito fáceis de identificar também — vai ter uma luz estranha na área delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Se livre delas e traga esses núcleos especializados para mim. Preciso de <color=#00E1FFFF>7</color> ao todo. Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
		{
			"id": 7404303,
