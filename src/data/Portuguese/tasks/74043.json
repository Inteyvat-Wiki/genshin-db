			"dialogs": [
				{
					"id": 740430301,
					"content": "Hmm, aqui está — sete núcleos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "O que você quer com eles mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "Como eu vou saber? Meu chefe só disse que 7 núcleos misteriosos dessas máquinas misteriosas seriam necessários — e se eu conseguisse eles, eu faria um monte de Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "E bem, isso vai servir! Eu combinei de encontrar com ele aqui e relatar a situação, então você mesmo pode perguntar a ele. Em todo caso, eu vou precisar que ele quite as dívidas comigo antes que eu possa dar a sua parte a você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Ugh, certo, se você diz... Vamos esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Você espera um pouco...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Caro Henri, como vão as coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430308,
					"content": "#Muito bem, Chefe! Eu já reuni os sete núcleos misteriosos que você pediu. Enfim, deixa eu te apresentar {M#meu parceiro}{F#minha parceira}... Hmm, qual é o seu nome mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430311,
					"content": "Hmm, bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "Espera? Vocês se conhecem? Ótimo! Então, tudo aconteceu assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#\"Argh! É {NICKNAME}! Por que {M#ele}{F#ela} está aqui?!\"\\nO \"Chefe\" se vira para fugir, mas é capturado de repente por Hunter e Tunner, que aparecem do nada.\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "Argh! Misericórdia, tenha misericórdia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430316,
					"content": "Uau, esses dois são muito bons...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "Não se preocupe, Chefe! Não tem perigo mortal aqui, tenho certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "De fato, de fato. Ninguém está em nenhum perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430319,
					"content": "Por ora, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430320,
					"content": "P-Por ora...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430321,
					"content": "Quanto ao que vem a seguir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430322,
					"content": "Caso você acabe como um frango grelhado ou algo completamente diferente... Bem, cabe a você... Chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430323,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430324,
					"content": "Como vocês acabaram aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "Após nós termos a... honra de conhecer vocês anteriormente, decidimos seguir Henri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430326,
					"content": "Hã? Espera. Por que eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "Na verdade, por que eu era o alvo para começo de conversa? Eu só estava fazendo meu trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "As máquinas que vocês desmontaram eram dispositivos usados pelo Instituto de Pesquisas de Fontaine para monitorar e otimizar a qualidade da água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430329,
					"content": "Hã? Elas não eram para produzir poluição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "O núcleos que vocês desmontaram continham os componentes centrais mais avançados em dados hidrológicos em Fontaine. Assim, esperamos... conhecer o seu parceiro de negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430331,
					"content": "Hã? O quê? Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "Você mentiu para mim, Henri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "Ah! Chocante! Fomos enganados!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "#Não, não, você é {M#meu}{F#minha} grande benfeitor{F#a}! Por que eu mentiria para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "Você mentiu para mim, Chefe! Você sabia que estava me fazendo destruir coisas tão importantes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "E-Eu não queria isso! Eu sou só o elo mais fraco na...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430337,
					"content": "Hã? O que foi isso que ouvi sobre você \"não querer\" fazer algo? Poderia repetir? Eu não acho que ouvi claramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430338,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "Chefe"
				},
				{
					"id": 740430339,
					"content": "Oh, céus, esse Chefe deve estar cansado — ele até adormeceu de olhos abertos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430340,
					"content": "Uhh, i-isso também não era nossa intenção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "Bem, quanto a isso — decidimos não perseguir esse assunto mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430342,
					"content": "Mesmo? As coisas vão ficar bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "Só precisamos dos núcleos e os dados dentro deles. As máquinas não são tão importantes assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430344,
					"content": "Os chefões estão dizendo que tá tudo bem, e não devíamos mexer com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430345,
					"content": "Hã? O que tem em mexer comigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Oh, nada, nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430347,
					"content": "Bem, olha só pra isso, estamos numa caminhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430348,
					"content": "E que coincidência encontrar com você aqui! Que tempo agradável, foi um ótimo encontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430349,
					"content": "Mas, infelizmente, todos os encontros têm que acabar, e o nosso também. Acho que é hora de nos despedirmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430350,
					"content": "Vamos deixar a beleza de um encontro como esse ficar em seu coração, quem sabe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430351,
					"content": "Ah, deixa para lá. Esquecer talvez seja o melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430352,
					"content": "Hã? Então a gente está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "Você preferia o contrário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430354,
					"content": "Oh, pelos Arcontes, não! Estamos bem, claro que sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "*Suspiro* Eu pensei que ia conhecer uma pessoa legal que ia poder mudar minha vida com trabalho. Mas, que pena, esse mundo é cheio de pessoas ruins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "...Ei, Henri, pode dar uma mão aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430357,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "Bem, é uma vergonha, mas aquele seu chefe de bom coração parece ter perdido a cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430359,
					"content": "Vamos precisar de alguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430360,
					"content": "Trabalhador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430361,
					"content": "Confiável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430362,
					"content": "Sabe, um bom amigo que pode mudar a vida através de trabalho honesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430363,
					"content": "Isso mesmo, precisamos de um bom amigo para levar esse homem para nosso esconderijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430364,
					"content": "Lá, vamos poder... falar com ele à vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Hunter"
				},
				{
					"id": 740430365,
					"content": "Claro, nós vamos... expressar nossa gratidão. Com Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 740430366,
					"content": "Oh, claro! Pode contar comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "Obrigado, obrigado. E a vocês também, hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#Eu sou {NICKNAME}. Ela é Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#Obrigado, {NICKNAME} e Paimon. Parece que minha vida mudou mesmo depois que conheci vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "Não precisa agradecer a gente! Só trabalhe duro, Henri, e não se meta em encrenca de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "Sim, não vou! Estou trabalhando duro para ficar rico, e então terei outras pessoas trabalhando para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Hunter, Tunner e Henri cavam o Fatuus inconsciente e o levam embora.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Bem, Paimon realmente espera que a vida do Henri dê uma virada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "Espera só um minutinho aí. E o pagamento que Henri ia dar para a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}