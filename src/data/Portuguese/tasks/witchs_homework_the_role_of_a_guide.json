					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "Já está indo embora? Ei, Barbie! Você não tá esquecendo de nada? Tipo um monte de coisas que você deveria dar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "...Para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "Chegamos numa hora ruim...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Besteira, a chegada de vocês tá mais ou menos alinhada com a profecia de Barbie... Embora, sinceramente, eu achei mesmo que vocês iam chegar um pouco mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "Enfim... Antes da gente ir ao assunto, pode ser melhor se vocês... comerem alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "A-A profecia de Barbeloth dizia que a gente ia tá com fome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "Não, claro que não! Mas minha audição é bem aguçada, então ouvi o estômago de Paimon fazendo barulho a um quilômetro de distância...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*Ronco*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "#Aahh! A... a barriga da Paimon roncou por {NICKNAME}. Nossa barriga está com muita fome, sabia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "Como eu deveria saber que aquele lugar ia ficar sem filés...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "Não se preocupem com isso! Tenho biscoitos e bolos suficientes. E como sabem, nada de ruim nunca aconteceu a aventureiros que aceitaram comida de uma \"bruxa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Você e Paimon comem os biscoitos e bolos felizes enquanto tomam chá. Estranhamente, não importa quanto vocês comam ou bebam, o bule de chá permanece meio cheio, e sempre há um biscoito fresco e uma fatia de bolo nos pratos de vocês...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "P-Paimon tá cheia demais... Não importa quanto ela bote pra dentro, sempre tem mais no prato dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "É assim que são as festas do chá de bruxas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "Claro! Não dá pra ter uma festa do chá sem um amplo fornecimento de comida e bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Embora seja verdade, é difícil exibir uma elegância adequadamente \"bruxônica\" após encher a barriga. É por isso que o bule de chá tá geralmente só meio cheio, e só tem um único biscoito ou fatia de bolo em cada prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Paimon não consegue mesmo comer mais! As costuras dela são explodir... Será que a gente pode ir direto ao assunto agora? *Arrota*... Eita, desculpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Tudo bem. Acredito que estejam aqui para entregar minha \"tarefa\", a que Barbie profetizou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "Você sabia o tempo todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Nada desse tipo. Estávamos discutindo algo completamente diferente. A mudança massiva da lua fez a hidromancia dela ficar completamente louca, então ela precisa voltar por um tempo para passar um período em meditação silenciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "Enquanto ela tá longe, vou ficar com a responsabilidade da tarefa de todos. Também planejo ajudá-la a adicionar a próxima rodada de tarefas ao dicionário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Hã? Você consegue só trocar a pessoa responsável assim?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Bem, se alguém conseguiria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Não é como se eu tivesse muita escolha! Antes de Barbie e Alice sequer me contarem, elas já tinham inscrito minha \"tarefa especial\" no dicionário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Apesar de querer apagar tudo e continuar observando o mundo casualmente, Alice tá ocupada cuidando das fronteiras de Teyvat, e Barbie foi embora realinhar a hidromancia dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia não voltou e pode esquecer Rhinedottir... As outras bruxas todas têm seus próprios assuntos para resolver, então o dever de supervisionar essa tarefa ficou para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Eu não tinha percebido que a Sociedade das Feiticeiras era tão ocupada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "Tem mesmo. Eu nem sei quanto tempo faz desde que todas nos reunimos para realizar uma festa do chá de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "Em todo caso, contanto que eu termine minha tarefa, minha história será inscrita oficialmente no dicionário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#Depois disso, eu poderei observar e guiar todos de verdade... Então, {NICKNAME}, Paimon, me contem qual é a tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "Ah, e já que isso não conta como uma profecia, só algo que Barbie e Alice pensaram dez minutos atrás, provavelmente não há nenhuma informação útil a ser encontrada naquele dicionário que vocês carregam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "Você tem razão, Nicole! Demos uma olhada antes da gente vir pra cá e não tinha nenhuma instrução detalhada. Só tinha essas duas frases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "\"Nicole cumprirá o dever dela.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Tudo bem. Aquela primeira frase foi claramente escrita por Barbie, mas aposto toda minha Mora que foi Alice que adicionou a segunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Enfim, vamos começar com essa tarefa! Deixe-me pensar, por onde devemos começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Espera, você entendeu mesmo o que elas querem que você faça?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Hã? Ah, Barbie me explicou todas as minhas tarefas ainda agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "Basicamente, só preciso ir a alguns locais de tarefas, garantir que está tudo em ordem e realizar um trabalho de campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Espere! Será que isso é possível? Não tem mais nenhuma sensação de \"profecia\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Ah, bem, sabe, eu naturalmente vejo tudo que Barbie me fala como algum tipo de profecia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "Além disso, quando Barbie escreveu essa minha tarefa, tudo que ela fez foi ir direto à última página da minha história e me contar o final antecipadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Mas isso só não vai estragar a experiência?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "É um bom ponto, mas então qual é a diferença entre uma profecia e contar o final da história? Tudo bem, tá bom de tanta conversa, venham, me sigam. Vamos para... Hmm, sim, parece um bom lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "Assim do nada? Espera, como a gente vai—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "Num piscar de olhos, vocês se encontram de pé na beira de um penhasco...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "Isso significa que vim para cá pra nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "Como assim? Essa tarefa tinha que ser entregue por você, esse é um passo muito importante. Certas formalidades devem ser mantidas para a tarefa contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Mas podemos falar disso depois. Tudo bem, tá bom de tanta conversa, venham, me sigam. Vamos para... Hmm, sim, parece um bom lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Eu não entendi uma palavra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "\"Ela definitivamente não permitirá que vocês trabalhem de graça!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "Isso é tudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Agora que você falou, tem muitas de vocês.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "...Seria Nicole!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Então ainda agora, Barbeloth estava...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "A gente vai ter que trazer Varesa na próxima vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "Ela é a campeã de comer do Coletivo da Fartura de Natlan? Alice já falou dela para mim uma vez. Aparentemente, ela é uma jovem fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "Imagino que se ela comparecesse a uma de nossas festas, precisaríamos preparar três... talvez até sete pratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "A gente comeu aquela salada toda, mas pareceu que era só uma tigela de ar verde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "Fome é uma coisa que dá pra se profetizar também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "Talvez a gente volte mais tarde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
