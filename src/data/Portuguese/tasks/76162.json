			},
			"dialogs": [
				{
					"id": 761000701,
					"content": "Saiam da frente, mexam-se!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Hehe... qual é a pressa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000703,
					"content": "De um jeito ou de outro... todos vocês vão morrer. Mas alguns de vocês... só vão um pouquinho antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000704,
					"content": "Ele reclamava de não ter morrido naquela época... há três anos... E agora... vou realizar o desejo dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000705,
					"content": "...Bjorn? O que você fez com ele!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Ele era fraco demais... os fracos... os inúteis... os insetos rastejantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000707,
					"content": "...Morrer é tudo o que eles sabem fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000708,
					"content": "Nem pense em insultá-lo! Ele não é fraco coisa nenhuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Ah... aos seus olhos... ele era forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000710,
					"content": "Mas... mesmo os fortes morrem do mesmo jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000711,
					"content": "Eu pensei... que você entendesse isso melhor do que ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000712,
					"content": "Os que eram mais fortes que você... todos morreram, não foi? Morreram há três anos... e também há dez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000713,
					"content": "...Cale a boca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Sim... o único fraco aqui... é você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000715,
					"content": "Afinal... por que é que toda vez... toda vez... só você é quem sobrevive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000716,
					"content": "...Você fugiu do campo de batalha, não foi? Um covarde se agarrando à própria vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Som do Monstro"
				},
				{
					"id": 761000717,
					"content": "Illuga, não escute essas besteiras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Chega! Hora de morrer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#...{NICKNAME}! Vamos acabar com isso rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
