				},
				{
					"id": 732750307,
					"content": "Teremos que cuidar bem destas mudas - eu pretendo deixá-los para a jovem Sabbah. Quando eu também me for, estas flores pertencerão a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Você ajudou esse velho de verdade, e não pediu nenhuma recompensa - ah, eu teria problemas em descansar a cabeça no travesseiro à noite se eu não ter der pelo menos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Esta muda recentemente rompeu o solo, e Sabbah sugeriu dar ele a você. Ela até fez uma embalagem bonita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Leve como uma lembrança nossa. Que você seja resistente como esta muda, e que você sempre mantenha a fé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
