			"dialogs": [
				{
					"id": 732750102,
					"content": "As Rosas Douradas germinaram e viraram mudas, sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Eles, eh... Onde você encontrou as sementes deles, eu me pergunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Em um lugar distante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Foi mesmo? Bem, acredito que as sementes que o Tio Shafaqat semeou de fato vieram parar aqui no fim de tudo, após serem espalhadas por todo o deserto - mesmo se o caminho que elas tomaram foi um pouco conturbados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Teremos que cuidar bem destas mudas - eu pretendo deixá-los para a jovem Sabbah. Quando eu também me for, estas flores pertencerão a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Obrigado, criança. Há pouco que eu possa te dar... mas por favor, aceite estas frutas e flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
