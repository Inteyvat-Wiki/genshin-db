				"points": []
			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "Sobre a canção...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "#Ah, então você se lembra, não é? Bem, isso faz de você mais um{F#a} jovem que conhece isso. Muito bom, muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "\"Ó, rosa bela rosa, a meu desejo realizar. Ó, rosa dourada, nas rochas a desabrochar, que para mim cantará.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "\"Nesta terra para mim não há lugar, só a música para me sustentar. Meu destino só a música para derrotar, triunfar o meu findar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "\"A eu derrotar, ao tempo conquistar. A predominar sobre o que jamais desaparecerá...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
