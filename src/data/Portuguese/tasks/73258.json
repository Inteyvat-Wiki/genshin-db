					"nextDialogs": [
						732580202
					]
				},
				{
					"id": 732580202,
					"content": "#\"...Arama se sente feliz pelo conhecimento que Paimon me ensinou O feitiço se tornou Tesouro ao invés de Lixo. Nara {NICKNAME} derrotou Vanagni sem muito esforço. Tão incrível...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580203
					],
					"speakerTitle": "Nota Mal Escrita"
				},
				{
					"id": 732580203,
					"content": "#\"...Todo mundo ama eles. {M#O dourado}{F#A dourada} é como um sol bem grande e a prateada é como uma lua pequenina, gentil e brilhante...\"",
					"roleType": "TALK_ROLE_NPC",
