			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "Olá! O terreno daqui não parece como a de outros lugares. Será que possui algum propósito especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680103,
					"content": "Hã? Por que ele não está respondendo? Será que não ouviu Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680104,
					"content": "Olááá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "Uh...? Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680108,
					"content": "Como? Por que há Nara em Vanarana? Estão aqui para me capturar e me assar? Arakara não é tão gostoso como cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680109,
					"content": "#Ei, você acha que somos capazes de fazer uma coisa tão ruim assim? Somos conhecid{F#as}{M#os} como \"{F#as boas}{M#os bons} amig{F#as}{M#os} dos Aranaras\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680110,
					"content": "Ninguém nunca disse isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "Oh, qual é! Nunca disseram, devem sentir isso no fundo. Não deveria ser necessário perguntar isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680114,
					"content": "#Enfim, Paimon é Paimon, e {F#a}{M#o} dourad{F#a}{M#o} aqui é {F#a boa}{M#o bom} Nara, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680115,
					"content": "Você é Arakara, não é? O que está fazendo aqui sozinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680116,
					"content": "Para que Paimon quer saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680117,
					"content": "Hã... Paimon só está curiosa! Como o instinto para pegar uma borboleta ou lagarto! É só um instinto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680118,
					"content": "Paimon é um gato voador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680119,
					"content": "Não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680120,
					"content": "Hã... Se é algo tipo um segredo dos Aranaras que você não quer contar, tudo bem. Não somos tão insensíveis assim, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680121,
					"content": "#Eu ainda estou curios{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "Paimon também, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680123,
					"content": "Segredos? Arakara não tem segredos. Arakara não está fazendo nada. Arakara está esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680124,
					"content": "Esperando? Por outros Aranaras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680125,
					"content": "Aranakula foi com Arapandu para o Reino Ashavan, não sei quando voltam. Máquina Varuna não está bem. Não é hora de parar de cuidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680126,
					"content": "#Nara {NICKNAME} gosta de agricultura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680127,
					"content": "Agricultura é muito problemático.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "Só é problemático em Valuka. Não é problemático em Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680131,
					"content": "Por que você não perguntou para Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680132,
					"content": "Paimon pega borboletas e lagartos, não parece gostar de plantar. Perguntar é inútil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680133,
					"content": "Paimon não concorda... Mas Paimon se importa mais com o resultado que com o processo. Então, o que vocês plantam aqui na sementeira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680134,
					"content": "Gostoso, mas também usado para outras coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680135,
					"content": "Mas agora, se Paimon está com fome, não venha para a sementeira para comer. Coma cogumelos. Há muitos cogumelos em Vana, será bom comer alguns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680136,
					"content": "Enfim, Aranakula ainda não voltou, não posso começar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680137,
					"content": "#Certo, parece que temos que esperar Aranakula voltar... {NICKNAME}, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680129,
					"content": "Adoro agricultura!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "Ótimo! Arakara também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680112,
					"content": "Paimon tem razão!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680106,
					"content": "Vamos comer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "Que cogumelos deliciosos!... Nara? Delicioso? Não, Nara não pode comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
