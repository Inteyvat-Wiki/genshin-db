			},
			"dialogs": [
				{
					"id": 730680201,
					"content": "#Nara {NICKNAME} e Paimon? Aranakula seguiu Arapandu até o Reino Ashavan e ainda não voltou. Que tal comermos alguns cogumelos por enquanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "É Aranakula! Ele voltou para Vanarana sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680302,
					"content": "#Nara {NICKNAME} e Paimon! A Máquina Varuna foi curada, Aranakula agora pode focar na sementeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680303,
					"content": "Esta é a sementeira que Aranakula sempre fala sobre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680304,
					"content": "Sim é a sementeira que Aranakula e Arakara cuidam juntos. O solo aqui é adequado para Viparyas crescerem felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680305,
					"content": "Há Viparyas infelizes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680306,
					"content": "Não infelizes, só não tão felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680307,
					"content": "... Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680308,
					"content": "É como se houvesse um solo adequado para crescimento, e sem ausência de chuva e luz do sol, e sem obstáculos para crescer... Não há nada para ficar infeliz, mas também nada para ficar muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680309,
					"content": "Hmm... Então é uma sensação normal. Hã? Esse lugar é diferente dos outros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680310,
					"content": "O solo de Vanarana é muito bom, mas aqui é melhor. E ainda mais importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680311,
					"content": "Arakara e Aranakula cuidarão delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680312,
					"content": "Cuidar... O que vocês querem dizer com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680313,
					"content": "Tocarão música para elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680314,
					"content": "E elogiarão sua beleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680315,
					"content": "Então essa é a diferença entre Viparyas domesticadas e selvagens?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "Oh, Paimon se identifica... É difícil não ficar feliz quando há música agradável para ouvir e ser elogiada sobre sua beleza todo dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680317,
					"content": "#Sim, assim como Paimon. Antes de {NICKNAME} pescar Paimon, Paimon não era infeliz, só não era tão feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680318,
					"content": "#Depois que passou a viajar com {NICKNAME}, apesar de termos nos deparado com muitas dificuldades, quando Paimon está feliz, Paimon se sente extrafeliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680319,
					"content": "Paimon está certa. Arakara fará lanternas bonitas com Viparyas felizes para o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680320,
					"content": "Hehe, como Aranakula também está de volta, devemos nos apressar! As sementes de Viparya... Hã, Viparyas têm sementes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680321,
					"content": "Viparyas são os murmúrios dos sonhos da terra, é que a terra lembra em sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680322,
					"content": "Aquela semente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680323,
					"content": "Viparyas não têm sementes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680324,
					"content": "Hã? Mas como é possível ser uma sementeira sem sementes?! Ah! Será que Aranakula tem algum Ararakalari que pode crescer Viparyas do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680325,
					"content": "Não, Paimon está errada... Para crescer Viparyas na sementeira, é necessário Vasmrti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680326,
					"content": "O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680327,
					"content": "Vasmrti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "Vanarana se lembra de tudo, por isso, com Vasmrti, a terra se lembrará de tudo novamente em um sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680329,
					"content": "E na sementeira germinará uma Viparya feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680330,
					"content": "#Oh... Então, esse Vasmrti só pode ser obtido pelos Aranaras? Isso quer dizer que {NICKNAME} e Paimon não terão chances de fazer crescer Viparyas na sementeira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680331,
					"content": "#Nara dourad{F#a}{M#o} ajudou Aranakula, e outros Aranaras, é amig{F#a}{M#o} dos Aranaras, por isso Aranakula e {NICKNAME} cuidarão das Viparyas juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680332,
					"content": "#Deixe Vasmrti afundar no solo, e Viparya nascerá. Nara {NICKNAME}, tente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680333,
					"content": "Você segue as instruções de Aranakula e deixa Vasmrti afundar na terra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "É só isso? Não parece nada diferente de crescer outras plantas! Colocar a semente no solo, e esperar germinar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680335,
					"content": "Vasmrti não é semente. Assim como Paimon não é um gato voador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680336,
					"content": "Hmm, certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680337,
					"content": "Falando nisso, o sementeiro ainda tem bastante espaço vazio, um, dois, três... Nossa, são doze locais que podem ser usados para plantar Viparyas. Aranakula, você tem mais Vasmrti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680338,
					"content": "Antes tinha, agora não. É preciso coletar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680339,
					"content": "Além do mundo dos sonhos, há 12 sementeiras que condensam Vasmrti. Com elas, Vanarana estará cheia de Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680340,
					"content": "#O Festival Utsava precisa de muitas Viparyas, e Vanarana tem muitas delas. Os Aranaras ficarão felizes Nara {NICKNAME} e Paimon também ficarão felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680341,
					"content": "Nesse caso, vamos ajudar a coletar Vasmrti! Mas como fazemos isso? Arakara disse antes que está nas sementeiras fora do mundo dos sonhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680342,
					"content": "#Nara dourad{F#a}{M#o} ainda precisa cruzar a terra da sementeira. Mas só precisa uma vez, muitas, não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680343,
					"content": "Apenas uma vez... Então, a terra da sementeira se dará Vasmrti, como a chuva da noite passada se transformando em orvalho nas folhas após o nascer do sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680344,
					"content": "Urgh... Paimon não está entendendo nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680345,
					"content": "Mas, baseado em nossa experiência em lidar com os Aranaras... Quando encontrarmos a sementeira fora do mundo dos sonhos, vamos saber o que Aranakula está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680346,
					"content": "Vamos dar uma olhada nos arredores quando encontrarmos uma sementeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
