			"dialogs": [
				{
					"id": 401930101,
					"content": "#Ah, consagrad{M#o}{F#a}! Um passarinho me contou que vocês foram à Banhos de Aisa na noite passada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Eu tô juntando uma turma e a gente vai colar lá pra comemorar! Vocês tão dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Mas, a gente acabou de vir de lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Hmm, é... Mas aposto que tinha uma galera faltando, né não? Tipo Shinobu... e Gorou... e, sabe... Ayato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Basicamente, o Chefe ouviu falar sobre a ida e agora ele quer muito ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "E-Enfim! Quando vocês tiverem terminado de dar aquela olhada, venham me procurar, que a gente vai DAR! UM! TCHIBUM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
