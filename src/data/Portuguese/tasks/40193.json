			"dialogs": [
				{
					"id": 401930301,
					"content": "Chefe! O Festival da Flor Mikawa foi um sucesso gigante para nós! Tivemos três vezes mais visitantes que o normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "Baseado no que fizemos até agora, acho que vamos conseguir ganhar... esse tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "São ótimas notícias! Talvez a gente até ganhe da Editora Yae esse mês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "Oh? Você parece contente em... dar uma festa sem mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Oh, hehe... Não é nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "Esqueci de compartilhar algumas boas notícias com você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Trinta por cento dos rendimentos do festival foram transferidos para a Editora Yae. Estamos esperando um lucro recorde esse mês... Você não acha que parabenizações são necessárias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "O quê?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "B-Bem, chefe... Acho que parabenizações SÃO necessárias... Essa é nossa 333ª vez competindo contra a Editora Yae em vendas e nossa melhor pontuação até hoje — segundo lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "...Que essa seja uma noite de bons sonhos para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
