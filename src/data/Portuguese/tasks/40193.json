			"dialogs": [
				{
					"id": 401930201,
					"content": "Devido a persistência constante de Itto, todos vocês vão à Banhos de Aisa de novo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Hahaha! Essa deve ser a mais quente! Bora ver quem dura mais tempo! Quem vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930203,
					"content": "Hehe, se você está tão animado com isso, como posso recusar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 401930204,
					"content": "Escutem... Isso não é uma sauna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930205,
					"content": "Aaah... que quentinho... *ronco*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 401930206,
					"content": "Ei, não durma na água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930207,
					"content": "Hmm... Meu pelo tá tão pesado... Quase me sinto tonto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 401930208,
					"content": "Hahaha! Se não aguenta o calor, Gorou, vaza da... água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930209,
					"content": "Ei! Pare de fazer tanto barulho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401930210,
					"content": "No outro lado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Heh, Itto está tão animado quanto sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930212,
					"content": "Não é bom se distrair durante uma partida, irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930213,
					"content": "#Eita! Esse jogo tá esquentando! Qual é a próxima jogada, {NICKNAME}? O que vocês acham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 401930214,
					"content": "Hmm... Eu iria com calma, tentar consolidar minha vantagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401930215,
					"content": "Ou você poderia ser agressivo... correr risco não é uma ideia ruim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Shikanoin Heizou"
				},
				{
					"id": 401930216,
					"content": "(Ir devagar e sempre...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "Oh? Muito esperto, Viajante! Uma derrota decisiva... Eu me rendo! Agora, baseado no sorteio aleatório de antes, o próximo jogador deve ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930219,
					"content": "#Ayaka! Se divirtam, vocês {M#dois}{F#duas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930220,
					"content": "#Oh, hmm... Ok! Pegue leve comigo, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930221,
					"content": "(Ayato deve ter perdido para mim de propósito para dar Ayaka mais tempo para jogar... Sempre metido em esquemas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "#(Ser agressiv{M#o}{F#a}!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
