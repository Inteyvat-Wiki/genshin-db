			"dialogs": [
				{
					"id": 762260101,
					"content": "Maalaus, olha! Achamos todas as suas pinturas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 762260103,
					"content": "Hehe, não precisa agradecer! Afinal, ajudamos com essas pinturas também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260104,
					"content": "E desde quando você consegue entender o que Maalaus fala, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "Qualé, já fomos no Saguão da Lua Prateada tantas vezes. Não é difícil entender o que Maalaus quer dizer a essa altura, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260106,
					"content": "Então o que Maalaus disse que aconteceu com as pinturas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "Hã... bem... deixa Paimon interpretar... Maalaus diz que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260108,
					"content": "Talvez outro kuuhenki roubou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260109,
					"content": "Hmm... ou pode ter sido aqueles mecanismos mágicos de transporte da lua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260110,
					"content": "Ou pode ser que a Columbina tenha roubado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260111,
					"content": "Ei! Isso é impossível!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "Ué? Oh, Paimon errou então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260113,
					"content": "Então você só tava chutando mesmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "Hunf, aprender outro idioma não é nada fácil, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762260115,
					"content": "Paimon só precisa de um bom professor! Quando a hora chegar, Paimon vai pedir que Columbina ensine ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
