			"dialogs": [
				{
					"id": 708151001,
					"content": "Você retornou. Obrigada por sua ajuda. A pequena Liu já retornou, e com um saco cheio de coisas, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151002
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708151002,
					"content": "Jiayi mandou eles para ela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151003
					]
				},
				{
					"id": 708151003,
					"content": "Ah então ele fez isso... Ainda assim, o que a pequena Liu realmente quer é que ele volte pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151004
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708151004,
					"content": "Essa criança realmente cresceu como os bambus ao redor do vilarejo. Pisque, e você vai perder o quanto ela já cresceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151005
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708151005,
					"content": "Os dias em que seu filho é jovem nunca mais voltarão, uma vez que você os perca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				}
			]
		},
