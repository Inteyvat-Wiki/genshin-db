			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequena Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "Você está aqui para me pegar e me levar de volta para a Vila Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150702,
					"content": "A Avó Ruoxin estava preocupada com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Hunf. Então você de fato está aqui para me pegar. Bem, eu não vou voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150706,
					"content": "Volte e diga aos aldeões que estou indo para o Porto de Liyue procurar meu papai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150707,
					"content": "Eles não têm com o que se preocupar. Quando eu o encontrar, só vou falar com ele por um tempo e depois voltarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150704,
					"content": "Eu tenho algo para você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Eu não quero nada vindo de você. Você só está tentando me comprar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Pequena Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequena Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Para que você está me seguindo, afinal? Eu disse que estou indo para o Porto de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150802,
					"content": "Eu mesma vou contornar esses monstros. Eles não vão me encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150803,
					"content": "Não me trate como uma criancinha! Eu já sou crescida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150804,
					"content": "Isso é do seu pai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "Do papai? Ele pediu para entregar isso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150806,
					"content": "Tenho certeza de que são mais coisas para criancinhas brincarem... Se não são pipas, são bonecas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150807,
					"content": "Você não gosta deles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "... Eu gosto. É algo que meu papai me deu. Como eu poderia não gostar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150809,
					"content": "Mas se eu sempre gostar dessas coisas, isso não significa que eu sempre serei uma criança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150810,
					"content": "Se eu continuar brincando com eles, quando vou me tornar uma aventureira, ou ter minha própria Visão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150811,
					"content": "Mas para que você quer ter uma Visão, mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Se eu tivesse uma Visão, seria capaz de fazer várias coisas, seja ganhando dinheiro ou outra coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150813,
					"content": "Então, o papai não teria que trabalhar no Porto de Liyue o tempo todo. Ele poderia voltar e passar o tempo comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150814,
					"content": "Neste momento, eu nem sequer posso ir ao Porto de Liyue sem uma Visão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150815,
					"content": "Mas como o papai já o enviou aqui com seus presentes, talvez eu esteja dando mais trabalho para ele, indo procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Eu também preparei um presente para ele</color>, e queria fazer uma surpresa... Mas agora penso que não vou conseguir entregar pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Se alguém puder entregar por mim</color>... Deixa para lá, vou voltar. Não me sigam, sei o caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Liu"
				}
			]
		},
