			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avó Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150601,
					"content": "Esse Jiayi, também... Como ele pode cancelar assim com sua filha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150602,
					"content": "Ela não o vê mais do que algumas vezes por ano. É assim que um pai deve se comportar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150603,
					"content": "Ele está fazendo isto pelo Porto de Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Isso é o que ele diz todos os anos. Já perdi a conta do número de vezes que ele disse isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Ele apenas está fazendo seu trabalho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Bem, também é seu trabalho cuidar de sua filho. A Pequena Liu está crescendo dia após dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Se ele não tiver cuidado, será ela quem sairá para trabalhar quando ele voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150608,
					"content": "Esse pai e sua filha não conseguem se encontrar, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				}
			]
		},
		{
			"id": 7081507,
			"completionStepIds": [
				7081505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
