			"dialogs": [
				{
					"id": 708151101,
					"content": "Você já entregou os presentes a pequena Liu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151102,
						708151104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151102,
					"content": "Entreguei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151103
					]
				},
				{
					"id": 708151103,
					"content": "Ainda bem. Esses brinquedos são os preferidos dela. Obrigado - por favor, aceite estes como um sinal dos meus agradecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151104,
					"content": "Ela preferiria que você estivesse em casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708151105
					]
				},
				{
					"id": 708151105,
					"content": "Eu também quero voltar. Mas com o Porto de Liyue neste estado, não creio que isto será possível por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151106,
					"content": "Ainda assim, muito obrigado. Espero que esses presentes melhorem um pouco o humor dela - afinal de contas, são seus favoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151107,
					"content": "Por favor, fique com isso como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
