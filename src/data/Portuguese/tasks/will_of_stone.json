					"Pequena Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150901,
					"content": "Bonecas... Pipas... Cata-ventos. O papai mandou as mesmas coisas de novo, como eu já esperava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150902,
					"content": "*Suspiro* É uma pena que eu não tenha sido capaz de enviar meus presentes para ele também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150903,
					"content": "Eu os levarei até seu pai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "Você vai me ajudar? Bem... Mesmo que você também não tenha uma Visão, pareceu que aqueles monstros não lhe deram problema algum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150905,
					"content": "Acho que teremos que fazer desta maneira, então. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 708150906,
					"content": "*Suspiro* Se eu pelo menos fosse tão forte quanto você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Liu"
				}
			]
		},
