					"nextDialogs": [
						708151203
					]
				},
				{
					"id": 708151203,
					"content": "Isso... É da Pequena Liu, para mim? Quanta coisa... Quanto trabalho ela teve que colocar nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151204
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151204,
					"content": "Não quero mais nada do que largar tudo e correr de volta para Vila Qingce agora mesmo. Mas o Ministério dos Assuntos Civis iria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151205,
					"content": "Obrigado mais uma vez. Leve estes como agradecimento, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151206,
					"content": "*Suspiro* Não faço a mínima ideia de quando todo este problema terminará, ou mesmo quando que o Ministério aprovará minha licença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
