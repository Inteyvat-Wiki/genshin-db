			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "*Suspiro* Eu estava fazendo uma contagem regressiva nos dias que eu poderia voltar. Apenas mais dois ou três dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "Com toda a licença que economizar até este ponto, eu poderia ter passado mais de uma semana junto com a Pequena Liu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Mas com apenas uma ordem, todas as nossas licenças foram revogadas. Até mesmo as pessoas que estavam de licença foram chamadas de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Em minha experiência, isso significa pelo menos mais um mês sem nenhuma esperança de retornar à Vila Qingce. Que má sorte horrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081502",
							"2"
						],
						"stepId": 7081502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avó Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Oh, para onde será que essa criança correu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Posso perguntar sobre a Pequena Liu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Você está procurando por ela? *Suspiro* Que coincidência perfeitamente terrível. Eu não sei para onde ela foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150504,
					"content": "Ela recebeu uma carta que seu pai pediu a alguém para enviar do Porto de Liyue que dizia que ele voltaria em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150505,
					"content": "A Pequena Liu estava tão feliz. Ela inclusive disse que queria preparar um presente para seu pai e obrigou algumas outras crianças a colherem flores e frutas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150506,
					"content": "Mas alguns dias depois, ele mandou notícias, dizendo que tinha uma tarefa de última hora e que não poderia voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150507,
					"content": "Ela fez uma birra tremenda, e nada que pudéssemos dizer poderia dissuadi-la de insistir que ela mesma iria ao Porto de Liyue, já que seu pai não estava vindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150508,
					"content": "Por um tempo pensamos que era apenas uma piada. Mas, esta manhã, ela tinha simplesmente sumido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150509,
					"content": "#*Suspiro* Nós já enviamos pessoas para procurá-la, mas se você estiver dispost{M#o}{F#a}, você também pode participar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150510,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Me desculpe pelo incômodo. *Suspiro* Essa criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Onde você acha que ela foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Duvido que ela tenha ido muito longe. Ela provavelmente ainda está por perto, mas a natureza é um lugar perigoso. Por favor, encontre-a rapidamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				}
			]
		},
		{
			"id": 7081506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
