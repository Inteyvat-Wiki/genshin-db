			"dialogs": [
				{
					"id": 766530501,
					"content": "Hmm... Será que eu devia continuar minha pesquisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "Robô-Espião Zip-Zap Número 1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Zip-Zap o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "Para ser exato, é a plataforma de testes para o Robô-Espião Zip-Zap Número 1, o robô espião de última geração que eu projetei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "Ela recentemente comprou uma unidade de limpeza abandonada no mercado clandestino. Depois de modificá-la, ela criou o Robô-Espião Zip-Zap Número 1 que você está vendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "Essa plataforma simulou vários ambientes hostis para testar a capacidade do robô de permanecer escondido sob pressão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Por que Aino está fazendo robôs espiões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "Depois do roubo de Trilimlim 70% Doce, Aino se decidiu: \"Não importa quão forte seja o inimigo, temos que resgatar nossos amigos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Então ela logo terminou o projeto do Robô-Espião Zip-Zap Número 1, e começou a desenvolvê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "De acordo com seu plano, quando o desenvolvimento estiver completo, ele deve ser capaz de se infiltrar até no altamente vigiado Escritório de Design de Experimentos de Kuuvahki e resgatar nossos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "Isso parece incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "Mas Aino logo percebeu que aperfeiçoar o plano ia tomar muito tempo. Por isso abandonou a ideia. Segundo seus cálculos, seria muito mais fácil derrubar toda Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "Eu já me decidi! Como estamos levando essas coisas de forma bem tranquila, vou continuar no Robô-Espião Zip-Zap Número 1! Ele vai nos ajudar a salvar nossos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "Nesse caso, podemos pedir que vocês nos ajudassem com os testes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "Com base nas estatísticas anteriores, se houver dados fornecidos por outros testadores como referência, a velocidade de desenvolvimento da Aino pode aumentar em pelo menos 30%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "Pode contar com a Paimon! Isso parece divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "Eu também vou ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "Então agradeço a vocês dois em nome da Aino. Vou conceder permissões de acesso à plataforma — a partir de agora, vocês poderão usá-la para qualquer teste que precisarem realizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
}