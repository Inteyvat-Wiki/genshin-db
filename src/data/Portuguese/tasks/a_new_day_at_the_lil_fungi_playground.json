			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~ ♪♪~ ♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737100102,
					"content": "♫♫~ ♫~ ♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "Pyroalegria"
				},
				{
					"id": 737100103,
					"content": "Haniyyah, Souka, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100104,
					"content": "De longe, eu podia ouvir os passos alegres de Cabeça de Bongô e Pyroalegria. Parece que vocês se divertiram bastante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100105,
					"content": "Você conseguiu perceber que estavam se divertindo com essa distância toda? Eu ainda não consigo ler as emoções dos meus cogumigos através de seus passos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100106,
					"content": "Acho que ainda tenho muito o que aprender... Sempre há mais o que aprender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100107,
					"content": "Hehe, essa viagem realmente pareceu diferente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100108,
					"content": "Sair correndo por aí com nossos cogumigos, então voltar para o Parque de Diversões dos Cogumigos pareceu como voltar para casa depois de um longo dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100109,
					"content": "Que tal tirarmos uma foto juntos? Paimon lembra de ler no Pássaro a Vapor que muitos viajantes famosos alinham todas as fotos de uma jornada por ordem cronológica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100110,
					"content": "Agora que a Parceira de Prata me lembrou, eu estive junta com os cogumigos por todo esse tempo, e ainda assim, nunca tiramos uma foto juntos..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100111,
					"content": "Hehe, vocês sabem mesmo como dar um final perfeito para uma aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "Pyroalegria"
				},
				{
					"id": 737100114,
					"content": "Certo, vamos usar a câmera de Cabeça de Bongô, montar ela no tripé e fazer a contagem regressiva para uma foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100115,
					"content": "Quando Haniyyah e Souka não estiverem tão ocupadas, podemos sair de novo assim e nos divertirmos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100147,
					"content": "Legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100116,
					"content": "Falando nisso, Cabeça de Bongô é bem talentoso em tirar fotos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100117,
					"content": "Paimon tirou umas fotos boas e juntou elas com nossa foto do grupo. Vocês podem conferir também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100118,
					"content": "Uau... você pensa em tudo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "Oh, aqui... Paimon trouxe umas lembrancinhas pra vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100121,
					"content": "Os macarons que vocês não conseguiram experimentar antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100122,
					"content": "Oh, eu fiz só um comentário, e você lembrou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100123,
					"content": "Parceira de Prata... estou tão comovida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100124,
					"content": "E para fazer com que as coisas fiquem mais fáceis na próxima vez, vou ajustar meus maus hábitos. Vou planejar de antemão na próxima vez, e não só no papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100125,
					"content": "Sabe, quando amigos estão conversando à vontade, são esses comentários que mostram o que realmente está na cabeça de alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100126,
					"content": "Quando você comprou isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "Oh, quando a gente tava tirando fotos em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100129,
					"content": "Quando você tava olhando a paisagem com o Cabeça de Bongô, Paimon pediu pra uma menina e passou a Mora pra ela comprar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100130,
					"content": "Não se preocupe, Paimon comprou sua parte também! Paimon não ia esquecer, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100131,
					"content": "Paimon até mesmo lembrou a essa criança para pedir o seu sabor favorito assim que entrasse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100132,
					"content": "... Mas, já provamos quase todas as sobremesas de Fontaine, por isso não há muita coisa nova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100133,
					"content": "Se é seu, então deve ser bom!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "Hehe... Paimon vai comprar coisas pra você com mais frequência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100136,
					"content": "É só uma pena que não trouxemos nenhum lanche específico para os Cogumigos... Seria tão legal se pudéssemos sentar na mesa com eles para comer um monte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100137,
					"content": "Não precisa se preocupar com isso. No meu estudo \"Sobre Comunidades de Cogumelos\", pesquisei até os fundamentos de que tipos de comidas os cogumelos gostam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100138,
					"content": "Meu objetivo é identificar ingredientes que tanto humanos como cogumelos possam comer, assim nossos cogumigos não vão precisar passar o ano inteiro comendo só Geleia Maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100139,
					"content": "Um dia, descobrirei os ingredientes que satisfazem tanto os gostos humanos e de cogumelos, e farei pratos deliciosos que todos nós podemos aproveitar juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100140,
					"content": "E quanto se trata de colocar a teoria na prática, eu posso lidar com a comida sozinho. Só em caso de Haniyyah acabar destruindo nossa décima primeira panela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100141,
					"content": "Parece que o dia que sentaremos num círculo e comeremos com nossos cogumigos não está tão longe assim, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100142,
					"content": "Vamos esperar notícias suas, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "Nesse caso, lembrem-se de voltar e visitar o Parque de Diversões dos Cogumigos quando tiverem tempo! Nós e os cogumigos vamos estar sempre aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100145,
					"content": "E quem sabe, talvez a surpresa chegue mais cedo do que vocês imaginam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100146,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737100143,
					"content": "Mal posso esperar pelo banquete de Souka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "Mas se é algo que você comprou pra mim, então é muito diferente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "Eu nem reparei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "Você é bem pensativa, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
}