			"dialogs": [
				{
					"id": 715070101,
					"content": "O efeito foi melhor do que eu imaginava, todos os fenômenos e dados foram registrados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070102,
					"content": "O mais importante é que a Lama Preta aqui realmente foi limpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070103,
					"content": "Mas, hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070104,
					"content": "Por que você ainda não parece estar feliz? Não é bom que a mina tenha sido limpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715070105,
					"content": "Deixa eu pensar, quando Khedive e eu analisamos antes, pensamos que a saída da Linha Ley onde a Lama Preta estava sendo jorrada deveria ser na mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070106,
					"content": "A saída da Linha Ley não deveria ser limpa tão facilmente, então a saída da Linha Ley está em outro lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070107,
					"content": "Além da mina, as áreas afetadas pela inundação de Lama Preta desta vez são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070108,
					"content": "Túnel dianteiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "Sim... Significa que a saída da Linha Ley onde a Lama Preta está saindo fica na área do túnel da mina. O túnel da mina é mais estreito, mais fácil de acumular a Lama Preta e de atrair monstros, e o problema é ainda mais sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070110,
					"content": "Mas eu acredito na Ponta de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070111,
					"content": "Este é um grande instrumento que foi construído por Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715070112,
					"content": "Tenho apenas que consertá-la primeiro, e depois esperar que os mineradores carreguem a Ponta para o túnel da mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				}
			]
		}
	]
}