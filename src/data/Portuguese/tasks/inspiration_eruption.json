			"dialogs": [
				{
					"id": 715220101,
					"content": "Esse tipo de jogo é mesmo inspirador, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220102,
					"content": "Que novo jogo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "Viajante! Ótimo momento! Por coincidência preciso de alguém para testar meu novo jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220104,
					"content": "Olhe aqui. Estou chamando este jogo de \"Erupção Inspirativa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220105,
					"content": "Captura perfeitamente o processo inteiro de como poetas criam poesia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220106,
					"content": "Você quer dizer beber, beber e beber mais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Explique os detalhes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "Hahaha, hilário. Apesar de usar vinho para fazer a criatividade fluir, seja uma boa ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220108,
					"content": "Contudo, apenas vinho não é suficiente para realmente inspirar poesia extraordinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220110,
					"content": "Antes de escrevermos um poema, temos que começar buscando inspiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220111,
					"content": "Alguns gostam de viajar, outros preferem solidão, enquanto outros... gostam mesmo de usar vinho para estimular a criatividade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220112,
					"content": "Essa é a parte mais desafiadora, já que não podemos determinar de onde vem a inspiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220113,
					"content": "Então na maior parte do tempo sentimos que não descobrimos nossa musa e ficamos ansiosos e deprimidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220114,
					"content": "Mas, na verdade, a inspiração já nos visitou e deixou sua marca dentro de nossas cabeças sem que a gente soubesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220115,
					"content": "Na conjuntura certa, ela virá explodindo e tomará a forma de um grande poema... ou uma pintura... ou outra coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220116,
					"content": "E você pode transformar tudo em um jogo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Hahaha! Claro! O processo de fazer poesia é bem claro e facilmente compreensível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220118,
					"content": "Por acaso, alguns designers de jogos de mesa em Mondstadt estão interessados em minhas ideias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220119,
					"content": "Após algumas discussões e sessões de debate de ideias, finalmente chegamos a \"Erupção Inspirativa\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220120,
					"content": "Você pode experimentar agora se tiver interesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220121,
					"content": "#Jogue algumas rodadas e talvez você mesmo vire um{F#a} {M#poeta}{F#poetisa}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buies"
				}
			]
		}
	]
