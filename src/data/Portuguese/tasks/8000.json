			},
			"dialogs": [
				{
					"id": 80000201,
					"content": "Parece que... É uma pessoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000202,
					"content": "Será que... É o Grande Ladrão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000203,
					"content": "Por que ele está nessa posição? Ele está orando para algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000204,
					"content": "?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000205,
					"content": "O que... O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000206,
						80000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000206,
					"content": "É... A Estátua dos Sete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000208
					]
				},
				{
					"id": 80000208,
					"content": "Por... Por que a Estátua dos Sete está pendurada dessa forma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000209,
					"content": "Aliás, a Paimon lembra que deveria ter uma orbe na mão da Estátua, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000210,
					"content": "Mas... Esta estátua está segurando... O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000211,
					"content": "Uhh... Paimon tem um pressentimento muito ruim sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000212,
					"content": "O Grande Ladrão sequer se moveu. V-você acha que ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000213,
					"content": "Olá... Está tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000214,
					"content": "(Sem nenhuma resposta e sem respiração)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "Ele... Ele está morto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}, eu... Não estou me sentindo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000217,
						80000218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000217,
					"content": "Que lugar terrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000219
					]
				},
				{
					"id": 80000219,
					"content": "Vamos sair daqui, e rápido! Devemos nos reportar a Ganyu e a Lan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000220,
					"content": "Ahhhh! O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000218,
					"content": "Como será que ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000219
					]
				},
				{
					"id": 80000207,
					"content": "Uma coisa estranha que eu nunca vi...",
