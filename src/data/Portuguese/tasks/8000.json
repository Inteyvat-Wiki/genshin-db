				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Sim, sim. Eles têm a audácia de fazer o que bem entendem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000102,
					"content": "Sete Arcontes, dragões... E até mesmo essas antiguidades relacionadas a essas histórias são alvos deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000103,
					"content": "Mas dessa vez a situação é um pouco diferente! Eles estão malucos, e até foram roubar as coisas da Ordem do Abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000104,
					"content": "Ah, viajante! É você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000105,
					"content": "Ei? Ganyu, é raro te ver aqui com a Lan! Está aqui para publicar algumas missões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Olá, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Estávamos falando sobre os Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Sim, estávamos apenas dizendo que até mesmo os audaciosos Ladrões de Tesouros deveriam saber que não se deve mexer com o Abismo - é simplesmente muito perverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000109,
					"content": "Eu recebi algumas informações do Ministério dos Assuntos Civis, dizendo que dois chefes dos Ladrões de Tesouro estão conspirando para fazer algo grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "Dois chefes... dos Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Sim. São chamados de \"Irmã Velha do Sul\", e \"Raptor do Norte\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000112,
					"content": "Ah! \"Raptor\". Esse nome me parece muito familiar! Paimon se lembra que ele tentou fugir de Amber em Mondstadt... Em relação à \"Irmã Velha\", quem é ela mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "\"Irmã Velha\", significa que ela é a irmã mais velha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Isso mesmo! Ela é a Chefe dos Ladrões de Tesouro de Liyue, e eles chamam ela de \"Chefe\" mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000117,
					"content": "Dizem que ela é abençoada pelo Deus dos Ladrões, por isso, é a irmã do Deus... Porém, é possível ser apenas um rumor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000118,
					"content": "De qualquer forma, os Ladrões de Tesouros descobriram uma ruína intocada por ninguém, que na verdade está sob a guarda secreta da Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Mesmo que seja um presságio muito perigoso, para os loucos como os Ladrões de Tesouro, a ruína conta com vários tesouros valiosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Eles até fizeram um bom plano! Vão primeiro mandar umas iscas para desviar as forças da Ordem do Abismo, e logo depois, um ladrão especialista entrará na ruína e roubará os tesouros rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "Para executar o plano, dizem que a \"Chefe\" e o \"Raptor\" até recrutaram um \"Grande Ladrão\" de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000122,
					"content": "\"Grande Ladrão\"? Me parece ser um nome bastante temido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "Sim! É uma figura lendária!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000124,
					"content": "O assim chamado \"Grande Ladrão\" possui o mesmo valor do \"Grande Aventureiro\" para nós Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000125,
					"content": "Por exemplo a Grande Aventureira, Alice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Você também conhece a autora do \"Guia de Viagem de Teyvat\"? É ela mesmo! O Grande Ladrão possui uma posição tão exaltada quanto ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000129,
					"content": "Portanto, os dois chefes dos Ladrões de Tesouros recrutaram ele a qualquer custo para realizar o plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000130,
					"content": "No momento Liyue está enfrentando muitas mudanças... E o Ministério dos Assuntos Civis e os Millelith estão trabalhando nisso, e ficam sem mãos para lidar com esse rumor infundado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Porém... As minhas intuições me dizem que qualquer coisa relacionada à Ordem do Abismo é uma ameaça em potencial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "Portanto, eu gostaria de publicar uma missão aqui na Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Agora que passei por aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Então, pode deixar conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Ah! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "#Muito bem! Vocês são aventureir{M#os}{F#as} de confiança! Então, boa viagem para vocês, e a Guilda vai tratar dos detalhes dessa missão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000134,
					"content": "Eu sei muito bem que a Ordem do Abismo é realmente um perigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Por exemplo o Grande Aventureiro Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Oh? Você também já conheceu ele em Mondstadt? É ele mesmo! O Grande Ladrão possui uma posição tão exaltada quanto ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000114,
					"content": "Será que ela é a \"Chefe\" dos Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Você parece saber de tudo! Deve já ter se deparado muitas vezes com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 800002,
