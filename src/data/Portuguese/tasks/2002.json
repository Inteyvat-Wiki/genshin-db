				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "Hã? Beidou já saiu? Talvez ela tenha voltado para seu navio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Se você está procurando pela Capitã, ela foi chamada por Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Parece que o Torneio da Frota Crux se descontrolou desta vez e atraiu sua atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "A capitã Beidou estava murmurando algo sobre o fato de Ningguang ser uma estraga-prazeres quando ela se dirigia para fora do porto de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Haha, não é raro que essas duas estejam em desacordo uma com a outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Mas mesmo assim, a Capitã Beidou ficou desapontada por não ter testemunhado a coroação de um novo campeão. Ela estava ansiosa por isso há bastante tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "#Aquele que roubou a Visão era originalmente para ser o adversário dest{F#a heroína}{M#e herói} na rodada final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Ele sabia que não tinha nenhuma chance de ganhar a partida, portanto a ideia perversa de roubar o prêmio se instalou em sua mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "Nesse caso, o Torneio da Frota Crux chega a uma conclusão clara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "Hum, então é isso que aconteceu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "#Se for esse o caso, então as regras estipulam que ele é desqualificado... E {M#nosso herói aqui é o campeão}{F#nossa heroína aqui é a campeã}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Paimon imaginou que ganharíamos e tudo mais, mas não assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Não importa, como diz o ditado, \"honra dada é honra merecida\". Agora, deixe-me ir preparar a medalha de campeão para lhe dar a condecoração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "Então, será que agora poderemos viajar para Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Sim, eu acredito que sim. Embora a Capitã Beidou não esteja mais presente aqui, eu terei certeza de que ela receberá notícias disso. Ela é uma mulher de sua palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "#Mas a viagem a Inazuma é uma viagem traiçoeira. Você será atormentad{M#o}{F#a} por uma tempestade perpétua durante toda a viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "Na verdade, a chuva e os ventos incessantes são também uma encarnação da vontade da Shogun Raiden de fechar a nação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Espere um segundo, você está dizendo que ela pode mudar o tempo só com o poder de sua mente!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Não esqueçamos que esta é uma dos Sete Arcontes. Se o Morax de Liyue pôde formar a Floresta de Pedra Guyun lançando suas lanças de pedra, então não deveria ser uma grande surpresa que a Shogun Raiden seja capaz de invocar uma tempestade eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "#Basta dizer que se você deseja viajar para Inazuma, o Alcor vai precisar de algum tempo. Você será notificad{M#o}{F#a} uma vez que todos os preparativos tenham sido feitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Enquanto isso, pretendo embarcar em uma viagem minha. Viajarei por todas as vastas terras de Liyue, na esperança de encontrar uma maneira de despertar a Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Paimon acredita que você definitivamente vai conseguir encontrar uma maneira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Obrigado. Que ambas as nossas jornadas sejam significativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Uma última palavra de advertência. A parte de sua jornada que se encontra antes da tempestade pode muito bem revelar-se a mais árdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
