		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "Hã, por que ele ainda não está aqui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#Mas, esqueça isso. Agora começa a sua próspera aparição no palco, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "Todos, escutem. Sua atenção, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "Chegamos ao clímax do Torneio da Frota Crux. Esta é a partida final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "Após vários combates muito emocionantes, finalmente temos dois finalistas neste palco, hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "#Primeiro, eu gostaria de apresentar {F#ela}{M#ele}. Vocês nunca devem ter visto, mas com certeza já ouviram falar do nome dela, {F#a}{M#o} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#{F#Ela}{M#Ele} amedronta Osial, e a mera menção de seu nome faz até o rosto dos Mensageiros dos Fatui se empalidecer... Introduzimos a vocês {F#a heroína}{M#o herói} Viajante de Liyue, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "Uaaaaaauu!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Participante"
				},
				{
					"id": 20020209,
					"content": "Eu estava esperando por este momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Participante"
				},
				{
					"id": 20020210,
					"content": "#Penso que todos viram seu incrível desempenho nas semifinais, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "Mas a rodada final de hoje certamente vai elevar o próximo nível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "Quanto a nosso outro combatente... Uh, ele ainda não chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "Vamos lá, por que ele poderia estar demorando tanto? Esta não pode ser como a rodada anterior, diretamente decidida por uma desistência... Esta é a final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "Minhas desculpas! Esperem só um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "Talvez eles tenham confundido o horário das partidas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Não temos outra escolha... Se ele não aparecer, teremos que adiar a partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Espere um momento. Algo não parece certo sobre isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Capitã Beidou, talvez devêssemos checar o prêmio. No caso, a caixa contendo a Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, venha conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "Talvez ele esteja muito intimidado para comparecer às finais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
