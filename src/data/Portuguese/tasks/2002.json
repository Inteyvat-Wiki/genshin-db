					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "A-Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021102,
					"content": "Não, não! Faça o que você quiser, mas por favor, não marque minha testa, por favor!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021103,
					"content": "Hm. Ele perseverou até o fim, e agora a morte se aproxima... Ainda assim, os deuses não lhe concederam sua graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021104,
					"content": "Largue a Visão e saia. Eu mudei de ideia - sem mais punições para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021105,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021106,
					"content": "O que houve? Você está pedindo por mais punições?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021107,
					"content": "A decisão é sua. Tal disposição é louvável e se encaixa no caminho do samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021108,
					"content": "Não, eu não faria isso. Obrigado por me liberar. Você é verdadeiramente generoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021110,
					"content": "Hã, Paimon não entendeu. Você estava apenas tentando assustá-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021111,
					"content": "Eu não tenho prazer em assustar os outros. Eu estava apenas testando todas as possibilidades enquanto a Visão permanecia em suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021112,
					"content": "Quando as pessoas são forçadas a se encurralar, é quando sua maior força aparecerá. Pensei que poderia ser uma oportunidade para ele despertar a Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021113,
					"content": "Mas infelizmente, nada aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021114,
					"content": "Então você esteve planejando isso o tempo inteiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "Sim, eu queria saber se é possível que uma Visão extinguida seja despertada novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021116,
					"content": "A partir do momento em que ele roubou a Visão, decidi usá-lo para este experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021117,
					"content": "Eu tentei muitos outros métodos no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021190,
					"content": "Apesar de poucos contos contarem de um \"despertar da Visão sem mestre\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021191,
					"content": "Depois de ver você comandar vários elementos, imaginei que nada fosse impossível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021192,
					"content": "Venha, você pode tentar. Vamos ver se você consegue me dar a resposta que eu espero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021118,
					"content": "Vou tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "Hmm, a Visão não parece responder de jeito algum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021121,
					"content": "Entendo. Então você também não consegue despertar novamente a Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021122,
					"content": "Não importa, isto era esperado. Suponho que esta Visão ainda seja minha por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021123,
					"content": "Por que você é tão apegado a essa Visão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "Sim, qual é a história por trás dessa Visão, no fim das contas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021126,
					"content": "A história começa com um antigo amigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021127,
					"content": "Talvez um dia eu possa descobrir que tudo o que estou fazendo é apenas sem sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021128,
					"content": "Mas como um samurai errante, não só encontro sentido nas viagens e na beleza da natureza que se espalha pelo caminho. Eu ainda mantenho o \"caminho do guerreiro\" em meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021129,
					"content": "Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021130,
					"content": "Hehe, é só um outro jeito de dizer que eu faço o que eu quero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021131,
					"content": "Muito bem então, é hora de voltarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021132,
					"content": "Vamos lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "Permita-me reunir o vento para nós mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021134,
					"content": "Se você precisa falar mais, estou aqui para ouvir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "...Não deixe meus sentimentos incomodarem você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021136,
					"content": "Mas obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021124,
					"content": "Por que você está determinado a despertar novamente a Visão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
