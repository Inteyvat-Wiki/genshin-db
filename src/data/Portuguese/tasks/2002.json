			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Paimon",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020401,
					"content": "Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020402,
					"content": "Realmente sumiu... A Visão desapareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020403,
					"content": "Hã? Alguém roubou ela? Quem teria coragem de fazer isso em plena luz do dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020404,
					"content": "Nem sabemos quando exatamente ela foi roubada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020405,
					"content": "Hã! Nunca pensei que alguém aqui tivesse coragem de cruzar a Capitã Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020406,
					"content": "Não é preciso se preocupar, mesmo o truque de mão mais astuto não escapa do olhar atento da natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020407,
					"content": "Hmm... O ladrão só agiu recentemente. Ele não deve ter ido longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020408,
					"content": "A Visão era o prêmio que eu havia oferecido, e era minha responsabilidade cuidar dela. Farei questão de recuperá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020409,
					"content": "Bem, se você insiste. Deixarei a questão com você então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020410,
					"content": "Vou ficar aqui e tentar oferecer alguma explicação a todos os espectadores que vieram ver a partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020411,
					"content": "#Oh, sim. {NICKNAME}, siga-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020412,
					"content": "Parece que não há mais nada que possamos fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Umm, mas estamos em uma ilha... Para que lado ele poderia ter ido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020415,
					"content": "Venha comigo. Posso sentir que os ventos estão vindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020413,
					"content": "Meu oponente não veio de qualquer forma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
		{
			"id": 200209,
			"completionStepIds": [
				200209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200209",
							"2"
						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Você me alcançou... Como isso é possível!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020902,
					"content": "Eu tinha até preparado um barco para garantir uma fuga rápida, e mesmo assim, você me pegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020903,
					"content": "Nenhum barco conseguiria se igualar à velocidade do vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "O vento? Do que você está falando? Oh, entendi... Sua visão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020905,
					"content": "Maldição, se ao menos eu tivesse uma Visão... Ou se eu pudesse ativar esta, então você nunca seria capaz de me pegar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020906,
					"content": "Isto não tem nada a ver com Visões. Você pode ser hábil em desaparecer de uma multidão, mas parece que sabe muito pouco sobre como se esconder do olhar da natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Além disso, a rota de fuga escolhida foi falha por razões muito numerosas para entrar em detalhes e, além disso, pude ouvir seus risos arrogantes e orgulhosos ao vento enquanto eu o perseguia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "Em outras palavras, você não cumpriu nenhum dos critérios básicos para um grande golpe: nomeadamente velocidade, furtividade e estilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Você... Você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020910,
					"content": "Mas o mais decepcionante de tudo é o estado da Visão em sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Parece que a Visão não responde ao desejo humano indiscriminadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Tá bom, tá bom! Eu admito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020913,
					"content": "Estou de olho nesta Visão já há algum tempo. Decidi me registrar após ouvir que este torneio de luta estava cheio de um bando de péssimos lutadores. Eu lutei para chegar à final e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020914,
					"content": "Aha, então você deveria ter sido nosso oponente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "Eu sempre tive a intenção de ganhar o concurso apenas pela habilidade, mas então você apareceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020916,
					"content": "Depois de assistir às semifinais, eu sabia que não tinha nenhuma chance. Mas eu não estava prestes a desistir da Visão tão facilmente depois de ter vindo até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020917,
					"content": "#Já que não adiantava tentar enfrentá-l{F#a}{M#o} na partida, decidi usar bem minhas habilidades enquanto a atenção de todos estava voltada para você e a Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020918,
					"content": "Estava convencido de que tinha me preparado completamente para minha fuga... Mas, de alguma forma, você ainda conseguiu me alcançar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020919,
					"content": "Você não tem para onde fugir agora, só desista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Urg... Maldição... Isso poderia - isso poderia ter sido diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020923,
					"content": "Haverá consequências se você resistir mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Pffff! Conheço uma ameaça vazia quando escuto uma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020928,
					"content": "Tudo bem... Mas é melhor ser sincero! Ela não se ativou uma única vez desde que a levei de qualquer forma, não passa de uma casca inútil para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020929,
					"content": "Sabe, de acordo com as leis do mar, a pena por roubo é quebrar os seus braços!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Hã! Você não está falando sério, está!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020931,
					"content": "Sem falar que o item que você roubou era um prêmio, você não apareceu para a partida final e prejudicou a reputação da capitã da Frota Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Parece que seria mais do que justo marcar a palavra \"ladrão\" em sua testa com um ferro quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "Ei, ei, ei! Não precisamos ir tão longe assim, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Ugh, eu nunca teria imaginado que você pudesse ser tão cruel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020935,
					"content": "Se é aqui que uma conversa me leva, então esqueça. Vou arriscar uma briga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020921,
					"content": "Entregue a Visão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Depois de tudo o que passei para consegui-la? Eu acho que não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020925,
					"content": "Apenas faça o que mandamos e não haverá mais consequências.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "S-Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020927,
					"content": "Se você entregar a Visão, deixaremos você ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
