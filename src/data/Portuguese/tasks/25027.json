			"trigger": {
				"objectNames": [
					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Aah, um novo álbum! Os bebês Saurianos vão amar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "Me fale da música de Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "Eu adoro as músicas do Tio Milu — e sério, o Sauriano bebê que a gente tem em casa gosta mais do que eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Sempre que ele fica muito agitado, minha mãe toca uma das músicas dele e ele fica quieto rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Hmm... Mas essas canções são super longas. Eu quase não consigo lembrar da letra, quem dirá cantar elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Hehe, se eu pudesse escrever algumas canções com menos letras, eu colocaria o dia inteiro para aquela criança curtir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
