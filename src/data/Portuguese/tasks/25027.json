				"objectNames": [
					"Mahina Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "O Sr. Milu lançou um novo disco! Será que eu compro ou não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Me fale da música de Milu Nui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Hã? Ah, é ótima! Haloa e os Saurianos bebês amam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Toda vez que eles ficam agitados e teimosos sem querer dormir, toco para eles a \"Canção da Primavera\" do Sr. Milu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Assim que eles ouvem, caem no sono na hora — pronto, tenham bons sonhos, até amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Mas mesmo assim... Haloa diz que preferiria algo mais intenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Se o Sr. Milu pudesse lançar umas canções com um pouco mais de energia, tenho certeza que ela ia se divertir mais com elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
