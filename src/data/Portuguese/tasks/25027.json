					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "Sons...? Ah, você quer dizer que a gente pode só pegar os sons da natureza e usar diretamente nas músicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Hmm... Isso parece mesmo uma boa ideia. Sim, muito bom mesmo! Viu, sabia que você se garantia! Bora, vamos nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Espera, você não tá trazendo nada com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Claro que não. Tá esperando que eu carregue um gramofone por aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Não se preocupe, só vamos ver quais tipos de sons podemos usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Um pato batendo suas asas, por exemplo, ou o som da água quando um Koholassauro cai nela, ou os passos estrondosos de um Tepetlissauro andando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Quando selecionarmos nossos alvos, farei os preparativos para pegar as amostras dos sons... Mas isso fica para depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Quanto ao aqui e agora, vamos partir — sem tempo a perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
