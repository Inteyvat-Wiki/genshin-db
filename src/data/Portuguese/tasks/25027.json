			"dialogs": [
				{
					"id": 250270401,
					"content": "Olhe para esses pássaros, ouça os cantos deles!... Minha nossa, eles vão ser ótimos materiais para o meu próximo trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Mesmo assim, as coisas podem ficar bem monótonas se a gente só gravar poucos deles. Se a gente conseguir encontrar um grupo inteiro deles e gravar o som dos chamados coletivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Espera, aquilo é um rebanho de Koholassauro. Tá escutando como eles arranham pedras com as garras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Koholassauros são do tipo sensível, então não vamos nos aproximar muito. Vou pedir para alguns profissionais da nossa tribo para reunir o que preciso depois — se alguém consegue, são eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Ah, oh... guerreiros se testando um contra o outro. Bom, bom, os sons da batalha são realmente adoráveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Ei! Tá fazendo o que aí? Tá aqui para arrumar briga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Guerreiro Tribal Irritado"
				},
				{
					"id": 250270407,
					"content": "Só estamos... reunindo material...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
