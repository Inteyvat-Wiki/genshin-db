					}
				]
			},
			"dialogs": [
				{
					"id": 401440101,
					"content": "Ah, é você, fofura! A que devo a honra de sua visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Você está aqui para visitar a biblioteca? Ou, talvez esteja aqui para ver uma certa pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Estamos aqui para te ver, é claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "Hehe, gentil como sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Infelizmente, que azar... você acabou me pegando no meio de um trabalho importante. Terei que te pagar um chá da tarde em algum outro momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Espera, você está realmente ocupada... com trabalho? Isso não é algo que se vê todos os dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Haha, você tem razão. A última vez que estive tão consumida com pesquisa deve ter sido bem lá na época da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Não tenho pensado tanto já faz um bom tempo. É bem exaustivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Você está escrevendo uma tese?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "#Hehe, se você está assim tão interessad{M#o}{F#a}, por que não se junta à diversão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "O que me diz? Quer me ajudar a reviver meus dias como uma acadêmica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "Não é educado jogar seu trabalho para os outros, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#Então isso é um não, {NICKNAME}? Seria uma oportunidade rara de trabalharmos junt{M#o}{F#a}s... e você seria, é claro, recompensad{M#o}{F#a} generosamente. Mas, se você não quer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "#Sou tod{M#o}{F#a} ouvidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Como você provavelmente sabe, os Cavaleiros de Favonius estão pesquisando alquimia há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Mas a maior parte desta pesquisa é feita em um ambiente de laboratório. O conhecimento público sobre alquimia é bem mínimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "O que significa que até então, a maioria da nossa pesquisa e descobertas se mantiveram bem distantes da vida cotidiana das pessoas. Colocamos muita Mora na pesquisa, mas temos pouco a mostrar pelos nossos esforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Percebendo isso, Jean decidiu começar uma iniciativa onde compartilharíamos os resultados de nossos trabalhos com as pessoas. Por ora, isso significa introduzi-las a diferentes tipos de poções alquímicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "E acontece que eu já tenho uma certa experiência com esse trabalho. Embora eu normalmente trabalhe na biblioteca, eu já ofereci o meu apoio no passado no gerenciamento de suprimento de poções dos Cavaleiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Criação de poções também foi uma das minhas especializações acadêmicas na época, então Jean achou que eu seria a melhor pessoa para o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Mas para criar poções práticas suficientes para ajudar nas necessidades diárias das pessoas, muitos ajustes precisavam ser feitos nos ingredientes que usamos, e o processo alquímico, em geral, também precisou ser simplificado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "No fim, o que começou como um projeto de pesquisa relativamente simples, logo virou algo extremamente complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "#Então, você está pedindo para te ajudarmos com sua pesquisa? Pois, hmmm, você não está exatamente falando com {M#dois}{F#duas} especialistas em poções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Hehe, sem problemas. Já até pensei no trabalho perfeito para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "As práticas alquímicas estão se tornando cada vez mais avançadas, mas ainda existe uma falta de conexão entre nossa pesquisa e o público. O que realmente precisamos, é coletar as opiniões das pessoas. Caso contrário, não saberemos se estamos realmente satisfazendo suas necessidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Mas, se quisermos fazer pesquisas e coletar opiniões ao mesmo tempo, precisamos fazer as coisas de forma diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "Então, achei que a melhor forma de fazer isso seria abrir uma loja de poções! Dessa forma, podemos continuar a conduzir o lado alquímico das coisas, enquanto também conseguindo interagir com o público e entender suas necessidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Oh! É como derrotar dois Slimes com uma espadada só! Muito inteligente, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#E, é claro, quem melhor para lidar com esse trabalho se não aquel{M#e}{F#a} mais bem-sucedid{M#o}{F#a} entre nossos ranques... {NICKNAME}, é claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Quando eu estava na Academia, os estudantes ajudavam uns aos outros em seus projetos de pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Tenho certeza que minhas fofuras não iriam querer perder essa oportunidade de experimentar esse tipo de entusiasmo jovem por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Você faz tudo parecer bem legal e tal, mas Paimon ainda acha que você só está procurando por uma forma de repassar seu trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Podemos pensar nisso apenas como um favor para a Lisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Hehe, eu sabia que podia contar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "#Quando todo nosso trabalho estiver terminado, irei pessoalmente garantir que você seja generosamente recompensad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Todas as preparações iniciais foram feitas, então vamos para a loja. Terminaremos nossa discussão depois que chegarmos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "#Estou sempre dispost{M#o}{F#a} para um pouco de desafio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Hah, gosto do seu entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Vamos ouvir os detalhes primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Você está trabalhando em um projeto de pesquisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Só estamos de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "E decidiu fazer uma pausa para conversar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
