			"dialogs": [
				{
					"id": 401440601,
					"content": "Parece que você pegou o jeito em cultivar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Ah, eu provavelmente deveria mencionar, uma Cavaleira da Companhia de Logísticas chegou. Ela quem vai lidar com todas as provisões para todas os futuros suprimentos. Você deveria ir lá conversar com ela depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "E depois disso, será sua vez de brilhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "Espera, e quanto a você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "É! Não deveria ser a \"nossa\" vez de brilhar? Sabe, nós três? Qual é o seu papel nisso tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "Meu papel? Naturalmente era o de garantir que minhas fofuras tivessem todos os conhecimentos de negócios e alquimia que precisavam para terem sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "Certo, estarei torcendo por vocês! Boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon sabia que isso aconteceria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
