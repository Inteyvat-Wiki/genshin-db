			"dialogs": [
				{
					"id": 401440701,
					"content": "#Saudações, Cavaleir{F#a}{M#o} Honorável! Saudações, Paimon! Meu nome é Freda. Sou uma Cavaleira da Companhia de Logística. É uma honra de conhecer {M#o famoso}{F#a famosa} {NICKNAME} e sua assistente leal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "#Uau, a fama da Paimon está realmente se espalhando por aí, hehe! Mas só uma pequena correção, Paimon é a companheira del{M#e}{F#a}, não sua assistente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Ah, minhas desculpas. Acho que me deixei levar demais depois de ouvir tudo sobre seus feitos. Parece até com a história de uma novel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Você é praticamente uma lenda. Na verdade, sinto até uma invejinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "Eu adoraria vagar pelas terras em busca de aventura como aqueles cavaleiros que você lê nas histórias! Parece ser uma vida bem divertida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Talvez você terá a chance um dia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "É! Isso que eu espero pelo menos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Enfim, temos um trabalho que precisamos terminar, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "Minhas ordens da Grande Mestre Intendente são de ajudar os seus negócios de qualquer forma que eu puder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "Se houver qualquer coisa que você precise, me avise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Comprar suprimentos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "Você está com sorte! Acabei de receber um novo lote de provisões! Por favor, dê uma olhada e diga se qualquer coisa chamar sua atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "Boa sorte em seus negócios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "Na verdade, não é só diversão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "Isso é verdade. Os cavaleiros nas histórias estão sempre se deparando com todos os tipos de perigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
			]
