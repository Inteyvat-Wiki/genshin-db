			"dialogs": [
				{
					"id": 401440401,
					"content": "Ah, parece que tudo está indo bem. Você já vendeu seu primeiro lote de poções. Nada mal para quem acabou de começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Quanto as poções que você deveria fazer em seguida, precisaremos consultar as novidades do mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "#Isso significa ficar atualizad{M#o}{F#a} sobre as notícias mais recentes e tendências para tentar antecipar as necessidades das pessoas. É uma habilidade essencial quando se trata de negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Hmmm, isso parece meio difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Hehe... não se preocupe. Eu já compilei todas as novidades mais recentes do mercado para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "O que acha? Tem alguma ideia de que tipo de poções você deveria vender a seguir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "Vá em frente e tente cultivar algumas ervas. Processamento de bioalquimia pode infundir as ervas com diferentes efeitos e propriedades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "Usar diferentes ervas no processo de fervura pode alterar os efeitos da poção. Existem várias combinações para tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Muito bem, fofura, por que você não começa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
