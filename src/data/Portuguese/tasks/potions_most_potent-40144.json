				]
			},
			"dialogs": [
				{
					"id": 401440201,
					"content": "Essa é a loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Uau! Parece que você já fez um monte de preparações! Você fez isso tudo sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "Foi uma tarefa em grupo. Vários cavaleiros ajudaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean garantiu os fundos iniciais para abrir a loja. Albedo e Sucrose forneceram os ingredientes e equipamentos necessários para fazer poções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "E a Companhia de Logística está cuidando das provisões para todos os suprimentos futuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Agora, com a sua ajuda, é como se um peso extra tivesse sido tirado dos meus ombros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "Os Cavaleiros andam ocupados espalhando por aí sobre a nossa loja nos últimos dias. Então, devemos estar prontos para abrir quando tivermos terminado nossas preparações finais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Certo, não vamos deixar todo mundo esperando então. Por que você não pega esses ingredientes e tenta fazer uma poção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
