			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Cento e trinta e seis... Certo, vamos fazer mais quatorze vezes e então fazer um intervalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Precisa de uma mãozinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "Uma mão? Não, não preciso. Que tipo de treinamento precisa da ajuda de outro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Apenas aperfeiçoando meu físico poderei me juntar a Legião Athanatoi como um de seus soldados sublimes, assim como esse oficial aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "Ah, sim, deixa eu apresentá-lo! Esse é o meu instrutor. Apenas ao terminar seus testes que posso receber o direito de ascender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Uh, isso não é apenas uma estátua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "#O que você está dizendo, cidad{M#ão}{F#ã}? Todos os Remurianos não são dessa forma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "De qualquer forma, você gostaria de tentar? O teste inicial envolve destruir esses pilares de pedra simultaneamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Mas não os subestime! Mesmo com todo meu treinamento, eu só consigo destruir uma por soco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "Testes? Que testes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Testes de combate, naturalmente. Um ascendente, de forma imortal é uma coisa, mas habilidades de combate devem ser aprimoradas por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "De qualquer forma, você gostaria de tentar? O teste inicial envolve destruir esses pilares de pedra simultaneamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
