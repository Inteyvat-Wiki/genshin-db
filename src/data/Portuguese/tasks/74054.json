			"dialogs": [
				{
					"id": 740540801,
					"content": "Puxar a alavanca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740540802
					]
				},
				{
					"id": 740540802,
					"content": "#Eita! O que você está fazendo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540803,
					"content": "Você puxa a alavanca sem a menor hesitação.\\nA torre inteira começa a imediatamente tremer com um barulho devastador. É como se o céu estivesse se despedaçando e a terra se abrindo...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540804
					]
				},
				{
					"id": 740540804,
					"content": "Então... com um estouro, a máquina cospe um pedaço de fita de papel em suas mãos.\\nAgora, tudo está em silêncio novamente.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740540805
					]
				},
				{
					"id": 740540805,
					"content": "Só... Só isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540806,
					"content": "Hmm, Paimon não tem ideia do que tá nelas, mas parece importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740540807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740540807,
					"content": "#{NICKNAME}, por que a gente não fica com essas fitas por enquanto? Quem sabe, vai que elas um dia serão úteis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
