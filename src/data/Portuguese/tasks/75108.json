			"dialogs": [
				{
					"id": 751080401,
					"content": "Hã? Por que tem Saurianos nas jaulas aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080402,
					"content": "Algo não está certo aqui... Espera. Poderiam eles terem sido capturados por aquelas pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080403,
					"content": "Será que a gente se deparou com algum tipo de rede de tráfico de Saurianos sem perceber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080404,
						751080406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080404,
					"content": "Maravilhoso! Vilões derrotados, por sinal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080405
					]
				},
				{
					"id": 751080405,
					"content": "Isso mesmo! Agora vamos tirar todos esses Saurianos daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080408
					],
					"speakerTitle": "Paimon"
