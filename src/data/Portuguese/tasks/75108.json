			"dialogs": [
				{
					"id": 751080101,
					"content": "Dissemos que íamos cozinhar, mas o que a gente deveria fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Hmm... A gente dava peixe para Baguinha, a Foquinha Rotunda, né? Nesse caso, um prato de peixe deve servir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Se quisermos que a Foquinha Rotunda e {REALNAME[ID(2)|SHOWHOST(true)]} comam bem... A especialidade de Natlan Peixe Grelhado em Molho de Menta deve ser uma boa escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Ah, esse aí eu faço com um braço amarrado nas coisas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Tudo bem, vamos começar então. Paimon vai te dar umas dicas durante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Fazer cortes mais fundos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Isso mesmo! Quanto mais profundo o corte, mais fundo o sabor entra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Um pouco mais de sal, um pouco mais de felicidade!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Hmm, o sabor é bem complexo. {REALNAME[ID(2)|SHOWHOST(true)]} e a Foquinha Rotunda vão adorar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Molho de menta. Quanto mais, melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Hehe, esse sabor refrescante vai ser sensacional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Pimenta é indispensável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "A quantidade exata de picância — suficiente para despertar o apetite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Grelhado em fogo alto: crocante por fora, macio por dentro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Hehehe, parece tão delicioso, Paimon já tá salivando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Após um esplêndido processo culinário, o peixe especial que você grelhou para {REALNAME[ID(2)|SHOWHOST(true)]} e a Foquinha Rotunda está pronto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Assado lentamente — macio e suculento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Uau, incrível! O peixe grelhado secreto de {NICKNAME}... Talvez algum dia a gente prepare uma das suas especialidades para nossos outros amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Animais de Fontaine podem ser alérgicos a comida picante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Mas iria parecer que tem algo faltando se não tivesse nenhuma pimenta, então por que não adicionar só um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Será que um animal aquático como a Foquinha Rotunda tem medo de menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Não é assim que isso funciona. Uma Foquinha Rotunda vai achar a superfície seca e quente, então adicionar um pouco de molho de menta deve ajudar a equilibrar, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "O sabor tá ótimo como está. Não precisa de mais sal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Sim. Ainda temos outros temperos, então não precisamos pesar a mão no sal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Fazer cortes mais rasos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "Nada mau. Deve manter o sabor leve enquanto mantém a característica original do peixe — que a Foquinha Rotunda com certeza vai amar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Não é o meu forte, mas de boa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
