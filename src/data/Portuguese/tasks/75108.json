			"dialogs": [
				{
					"id": 751080501,
					"content": "Espera, tem uma... Foquinha Rotunda aqui? Mas o que—? Acho que pessoas malvadas realmente vão vender qualquer coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
