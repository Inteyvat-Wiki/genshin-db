						751080503
					],
					"speakerTitle": "Foquinha Rotunda Enfraquecida"
				},
				{
					"id": 751080503,
					"content": "Rroo... Mrrooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751080504,
					"content": "#Hã? Você está meio interessado em Foquinhas Rotundas, não está, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080505,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ouve intensamente os gritos da Foquinha Rotunda e, aparentemente entendendo algo, levanta a Foquinha Rotunda pela cauda para levá-la para o raso, onde brincam juntos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751080512
					]
				},
				{
					"id": 751080512,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080506,
						751080507
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751080506,
					"content": "A Foquinha Rotunda parece contente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080508
					]
				},
				{
					"id": 751080508,
					"content": "Sim! Talvez eles consigam virar amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080509,
					"content": "Mas aquela Foquinha Rotunda não parece ter o mínimo de força, e as suas duas... Err, patinhas...? De qualquer forma, elas não parecem ser capazes de se movimentar muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080510,
					"content": "Não tinha nem um prato de comida por perto... Talvez eles tenham ficados trancados por tanto tempo que eles estão com muita fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080511,
					"content": "#Se esse for o caso, então vamos fazer algo para a Foquinha Rotunda e {REALNAME[ID(2)|SHOWHOST(true)]} comerem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080507,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} parece bem feliz também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080508
					]
				}
			]
