					"nextDialogs": [
						751080710
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751080710,
					"content": "Roahh! Rawr... Arr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080712
					],
					"speakerTitle": "Foquinha Rotunda Enfraquecida"
				},
				{
					"id": 751080712,
					"content": "Ah, foi embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080713,
						0
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080713,
					"content": "É assim que as coisas são. Quero dizer, não é como se ela fosse de Natlan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080715
					]
				},
				{
					"id": 751080714,
					"content": "Melhor se voltar ao lugar que pertence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080715
					]
				},
				{
					"id": 751080715,
					"content": "Rooahh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751080716,
					"content": "#Não fique triste, {REALNAME[ID(2)|SHOWHOST(true)]}. Você se divertiu tanto agora há pouco, e vocês já são amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080717,
					"content": "Enfim, Paimon sente que essa não vai ser a última vez que vamos ver essa Foquinha Rotunda!",
