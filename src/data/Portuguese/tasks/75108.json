					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080705,
					"content": "Tenha cuidado. Não seja que nem aquela Foquinha Rotunda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080706
					]
				},
				{
