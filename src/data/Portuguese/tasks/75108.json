					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751080306,
					"content": "Sim, eu devia ter sido cruel e frio naquela época!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080307
					]
				},
				{
					"id": 751080307,
					"content": "#Paimon mal consegue imaginar você sendo assim, {NICKNAME}... Enfim, vamos ajudar eles primeiro!",
