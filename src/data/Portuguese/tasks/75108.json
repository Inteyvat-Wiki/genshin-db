					"nextDialogs": [
						751080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080302,
					"content": "Paimon não achou que eles iriam persistir com seus costumes perversos e continuariam machucando Saurianos, mesmo após destruirmos sua base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080303
					],
					"speakerTitle": "Paimon"
				},
				{
