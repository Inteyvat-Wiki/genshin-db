					"content": "Experimente e você saberá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080708
					]
				},
				{
					"id": 751080706,
					"content": "Ei, o que é esse tom condescendente? Paimon não é uma Foquinha Rotunda. Ela não vai ser tão boba ao ponto de comer assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080708,
					"content": "Ei! Paimon não vai comer assim — ela não é uma Foquinha Rotunda de qualquer forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080709,
					"content": "A Foquinha Rotunda parece ter recuperado força suficiente para se virar e entrar no mar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751080719
					]
				},
