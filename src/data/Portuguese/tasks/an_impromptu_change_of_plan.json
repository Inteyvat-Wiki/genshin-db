			"dialogs": [
				{
					"id": 10020201,
					"content": "E quem poderia ser? Aqueles que ousaram entrar no Relevo de Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "Escultor da Lua"
				},
				{
					"id": 10020202,
					"content": "#Eu fui enviad{M#o}{F#a} para cá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "Por favor, dê uma olhada nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "Um Selo de Permissão... Muitas estações se passaram desde a última vez em que um esteve na presença de tal item.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "Escultor da Lua"
				},
				{
					"id": 10020205,
					"content": "À sua frente, é um dos \"Adepti Poderosos e Iluminados\", Senhor Perfeito da Lua Descendente e do Sol Ascendente. Viajante, diga-me, que motivo te levou para aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "Escultor da Lua"
				},
				{
					"id": 10020206,
					"content": "Na verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10020207,
					"content": "#São {F#as}{M#os} assassin{F#a}{M#o}s! El{F#a}{M#e}s tiveram a coragem de voar para cá no Relevo de Jueyun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "Sargento Millelith"
				},
				{
					"id": 10020208,
					"content": "Chefe, você não acha que já adentramos muito no Relevo de Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "Soldado Millelith"
				},
				{
					"id": 10020209,
					"content": "#Nós... Não temos escolha. Prender {F#a}{M#o} assassin{F#a}{M#o} é a nossa prioridade! Temos que nos apressar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "Sargento Millelith"
				},
				{
					"id": 10020210,
					"content": "... Perturbando nossas fronteiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "Escultor da Lua"
				},
				{
					"id": 10020211,
					"content": "Leve-os, mas não os matem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escultor da Lua"
				}
			]
