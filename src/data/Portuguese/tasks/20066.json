				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "Ugh! Que dor de cabeça! O que devo fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Estou praticando para as provas dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660104,
					"content": "*Suspiro* Mas eu não sou tão forte quanto a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660105,
					"content": "Creio que seja melhor me concentrar nas técnicas em vez da força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660106,
					"content": "Por exemplo, estava pensando como eu posso destruir estes manequins de madeira com um golpe só... Estes manequins de madeira não parecem muito resistentes... Mas o meu pai teve muitas dificuldades em encontrá-los, não posso reclamar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660107,
					"content": "Se você estiver com tempo, venha pensar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660108,
					"content": "Deixe-me pensar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Claro, vá com calma. Não é como se esses espantalhos fossem fugir sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660111,
					"content": "Nem a minha vida vai para algum lugar enquanto estiver presa resolvendo isso, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660114,
					"content": "A essa distância, talvez a melhor solução fosse eu lidar com um lado e soltar uma bomba para lidar com o outro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660115,
					"content": "Hahaha... Estou brincando, as coisas como bombas, não é nada fácil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660109,
					"content": "#E se nós tentarmos junt{M#os}{F#as}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "Você gosta de combate em equipe então? Tudo bem para alguns... Sempre tem alguém para ajudá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660113,
					"content": "Para pessoas como eu, só me resta aprender por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
