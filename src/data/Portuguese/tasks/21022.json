			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210229601,
					"content": "Mais duas Placas de Pedra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Ooh, deixe-me dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "\"... Eles lutaram nas Planícies de Guili, onde poeira negra sufocava os céus e mil rochas estilhaçadas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Oh... Parece estar dizendo que uma vez ocorreu uma batalha nas planícies de Guili. E que foi uma enorme batalha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Deve ter sido a batalha em que a Assembleia de Guili caiu. Mas quanto a essa outra mensagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "...Parece ter sido escrito por alguém que não conseguiu sair da Assembleia de Guili. Por isso, eles ficaram aqui. E tem mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "E há um tesouro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "...Claramente, você gosta mesmo dos tesouros. Mas você não está errado, existe de fato um tesouro nas planícies de Guili se esta passagem for interpretada literalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Mas, está lá escrito... \"Quatro Mandamentos de Guizhong\"... e depois escreveu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "\"Ensinar com sabedoria, ser limitado pela virtude, fortificar os ossos, se unir na ambição. A convergência desse Quatro Mandamentos era conhecida como a Assembleia de Guili\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Como eu posso decifrar isso? Não sei por onde começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Vamos voltar ao Albergue Wangshu. Acho que todos nós precisamos de algum tempo para tentar resolver o enigma dos Quatro Mandamentos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		}
	]
}