			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700280101,
					"content": "Graças aos dados que você obteve, já completei as calibrações finais nas Pontas de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280102,
					"content": "Agora eu posso dizer com confiança que elas funcionarão como esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280103
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280103,
					"content": "Desde que nós coloquemos as Pontas de Pursina em um lugar que o modelo personalizado comumente está vagando, devemos ser capazes de conter a fonte de sua energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280104,
					"content": "Se as Pontas de Pursina forem ativadas, o Colosso das Ruínas não se autorreparará mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280105,
						700280107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280105,
					"content": "#Obrigad{F#a}{M#o} pela sua ajuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280106
					]
				},
				{
					"id": 700280106,
					"content": "Não, não precisa me agradecer. Nós deveríamos agradecer aos nossos antecessores e o conhecimento que eles deixaram para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280109,
					"content": "Se não tivéssemos esse conhecimento para nos guiar, eu não conseguiria pensar numa maneira de lidar com aquele Colosso das Ruínas personalizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280110,
					"content": "Tudo que fizemos até agora foi depender desse conhecimento para nos guiar, e o conhecimento é o recurso mais valioso nesse mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280111,
					"content": "Que complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280112
					]
				},
				{
					"id": 700280112,
					"content": "É normal se você não compreender isso. Afinal de contas, você ainda não recebeu a influência de altos conhecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280113,
					"content": "Mas chega de falar disso. Acho que estava muito interessado em reparar essas Pontas de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280114
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280114,
					"content": "Bem, agora é a última leva de preparativos. E com isso quero dizer que precisamos colocar as Pontas de Pursina na Ilha Tsurumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280115,
					"content": "Me desculpe, mas temo que não poderei lhe ajudar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280116,
					"content": "De acordo com as leis de Inazuma, pessoas que não possuem Permissões de Residência como eu não podem andar livremente, por isso, deixarei essa tarefa com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280117,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280118
					]
				},
				{
					"id": 700280118,
					"content": "Obrigado. Eu sugiro que você não aja imediatamente após colocar as Pontas. Ao invés disso, cheque para garantir que tudo está funcionando corretamente, e depois volte para falar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280119,
					"content": "Eu acho que devemos ser mais cuidadosos para garantir a sua segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 700280107,
					"content": "Agradeçamos ao poder da ciência!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280108
					]
				},
				{
					"id": 700280108,
					"content": "Bem, eu não penso exatamente assim. Nós deveríamos agradecer o conhecimento que nossos antecessores deixaram para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280109
					],
					"speakerTitle": "Hosseini"
				}
			]
		},
		{
			"id": 7002803,
			"completionStepIds": [
				7002803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
