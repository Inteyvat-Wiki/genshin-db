				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "Oh! Viajante... As coisas não parecem estar indo tão bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "Os Fatui reuniram suas forças para perto do núcleo. Parece que eles descobriram algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Acho que eles ainda não conseguem quebrar as defesas do núcleo. Não, não podemos mais nos dar ao luxo de atrasar. Temos que agir agora para iniciar os testes de funcionalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "Os testes de funcionalidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Quero dizer que devemos testar as capacidades de purificação de nosso amigo. Não tenho a intenção de movê-lo apenas para descobrir que ele não funcionará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "Portanto, eu gostaria que você me arranjasse 3 Onikabutos, pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "É que gostaria de colocá-los ao redor da Fornalha Mikage, para pegar alguma energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Em seguida, vamos recuperá-los e usar este dispositivo de purificação para purificá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Este é o teste que eu elaborei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "Onde eu posso encontrar os Onikabutos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Hmm, lembro-me que normalmente podem ser encontrados em áreas ricas em Electro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "Também ouvi dizer que eles conseguem sobreviver perto da Fornalha Mikage. Que pequenos companheiros resistentes eles são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "Bem, por que eu não pego eles na Fornalha Mikage mesmo então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Bem, você poderia fazer isso, mas se você levasse Onikabutos diretamente da Fornalha Mikage para testes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Para dizer a verdade, eu me preocupo com a confiabilidade da minha pequena máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Afinal, é melhor trabalhar passo a passo, através de testes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "*Tosse* Então... por favor, me ajude a encontrar 3 Onikabutos, se puder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Obrigado! 3 já chegam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "#Eu mesm{M#o}{F#a} poderia dar uma olhada dentro da Fornalha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "#Bem... Você poderia usar a si mesm{M#o}{F#a} como sujeito de teste, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Mas, como eu disse antes, a confiabilidade deste dispositivo pode não corresponder às expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Se algo realmente inesperado ocorrer durante o processo de purificação, você pode se deparar com... Hã... Problemas imprevistos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "Ahem. Vamos apenas usar os Onikabutos por enquanto, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "Apenas 3 servirão! Uma vez apanhados, basta trazê-los de volta para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
