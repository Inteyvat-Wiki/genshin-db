					"nextDialogs": [
						110040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040309,
					"content": "Mas nunca vi um desse tipo antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040310,
					"content": "Onde foi que eu vi isso antes? Deixe-me pensar... Aha! Foi na \"Historia Naturalis de Liyue\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040311,
					"content": "Este padrão não tem erro... Pertence a uma raça de javali extinta há 300 anos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040312,
					"content": "Uau! Como é possível? Ainda está vivo depois de tanto tempo!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040313,
					"content": "Cryopreservação acidental?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "Pode ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040317,
					"content": "Eu li que este javali foi caçado até sua extinção pois sua carne era muito apreciada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040318,
					"content": "Uma Regisvine Cryo e um javali extinto. Não um, mas dois tesouros inestimáveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040319,
					"content": "Este será o nosso bilhete premiado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "Ok, então vamos voltar ao Vale Termal!",
