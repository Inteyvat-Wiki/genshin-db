			},
			"dialogs": [
				{
					"id": 790460901,
					"content": "Se a Gotinha se transformar em uma pedra, ela ainda vai conseguir beber a poção? Como que uma Gotinha faz para beber alguma coisa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460902,
					"content": "Será que isso significa que a poção é para uso externo? Vamos tentar rapidamente e ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "Que coisa! É completamente impossível evitar todos esses olhares, isso é injusto, é trapaça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "Paimon adoraria dar um chute em todos os dispositivos dos fantasmas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "Espere, Gotinha, o que você pretende fazer? Aquele lado é sob a visão dos fantasmas, é perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "Que barulhenta! Você enlouqueceu? Ou você desistiu da esperança e quer se encontrar com seus companheiros em outro mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Líder Espectro Furioso"
				},
				{
					"id": 790461005,
					"content": "Não está certo, é necessário usar o corpo para bloquear a visão... Como pode haver uma mentalidade tão antiquada de sacrifício!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Líder Espectral Feliz"
				},
				{
					"id": 790461006,
					"content": "A situação deu uma reviravolta! O Eidolon Hydro Solitário bloqueou o caminho à frente do espectro fantasmagórico, transformando-se lentamente em uma estátua de pedra e usando seu próprio corpo para bloquear a visão mortal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Narrador no Alto-Falante"
				},
				{
					"id": 790461007,
					"content": "A Gotinha... voluntariamente se transformou em pedra... tudo isso para podermos obter a chave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "A Gotinha ainda pode reviver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Sim! O fantasma atacou ela por pouco tempo, não deve ter tido nenhum problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "A Gotinha descobriu isso? Uau, ela é tão espertinha e corajosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, vamos encontrar a chave e o remédio logo! Não podemos deixar a Gotinha sofrendo por muito tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
