			},
			"dialogs": [
				{
					"id": 790460101,
					"content": "O elenco está pronto e todos os dispositivos estão funcionando normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Alto-Falante do Parque"
				},
				{
					"id": 790460102,
					"content": "\"Olhar Petrificante\" de \"Devaneio de Três Dias de Daiya\" está prestes a começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Alto-Falante do Parque"
				},
				{
					"id": 790460103,
					"content": "À beira da misteriosa e sombria floresta, dois sábios corajosos e eruditos descobriram um Eidolon Hydro Solitário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Narrador no Alto-Falante"
				},
				{
					"id": 790460104,
					"content": "Quem poderá me ajudar... Eu não quero abandonar meus companheiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460105,
					"content": "Gotinha? A Gotinha acabou de falar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "Na verdade, é o alto-falante que está falando por ela, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Então, Gotinha é a atriz principal da peça teatral. Ela precisa cooperar com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "Que sorte! Os dois sábios já estudaram a linguagem do Eidolon Hydro e entenderam o pedido de ajuda do ser aquático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Narrador no Alto-Falante"
				},
				{
					"id": 790460110,
					"content": "Isso é simplesmente um encontro do destino! É comovente encontrar-se com o Eidolon Hydro dessa maneira. Como poderíamos não ajudá-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Narrador no Alto-Falante"
				},
				{
					"id": 790460111,
					"content": "A gente também tem um novo enredo? Parece incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Vamos voltar ao assunto principal, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "Nós... nós nos perdemos na floresta e encontramos um castelo, mas acabamos acidentalmente acordando os fantasmas que estão lá dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460115,
					"content": "Dois líderes dos fantasmas lançaram uma... maldição sobre nós. Se eles nos virem, seremos transformados em pedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460116,
					"content": "Eu consegui escapar com grande dificuldade, mas meus outros companheiros... eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460117,
					"content": "Ah... eles devem estar sofrendo muito... Isso é culpa nossa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460118,
					"content": "Claro que não! Mesmo se estiverem de mau humor, não é desculpa para serem péssimos assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "Que horríveis... transformar as pobres Gotinhas que estavam perdidas em pedra... Isso vai além de apenas serem malvados! Esses fantasmas são realmente vilões terríveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "Vamos dar uma boa surra neles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "Não é possível. Os dois líderes dos fantasmas nunca aparecem e o castelo é muito grande. Mesmo as pessoas mais habilidosas não conseguem encontrá-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460123,
					"content": "Mas eu ouvi um dos fantasmas dizer que, no fundo do castelo, num baú, há uma antiga poção que pode quebrar a maldição. Essa é a única esperança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460124,
					"content": "O baú está trancado dentro de uma câmara secreta e precisamos encontrar a chave nas proximidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460125,
					"content": "Mas eu já fui amaldiçoado, se eu voltar sozinho para o castelo, certamente serei alvo dos outros fantasmas. Eu vou acabar me transformando em pedra e acabarei permanentemente preso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460126,
					"content": "Bem, isso não é tão difícil! Deixe a gente escoltar você de volta ao castelo para procurarmos a chave e obter a poção mais crucial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "Contanto que possamos evitar os olhares dos fantasmas, não deve ser um problema, certo? Parece que não vai ser difícil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "Você tem razão, nós somos sábios, e devemos encontrar uma solução... Por favor, nós imploramos a vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Eidolon Hydro Solitário"
				},
				{
					"id": 790460129,
					"content": "Paimon entrou rapidamente no personagem, não é mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Hehe, parece bem simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "Embora não possamos enfrentar diretamente o mestre por trás das cortinas, você pode lidar com todos os fantasmas e ajudar a Gotinha a resgatar seus companheiros facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "#Não se preocupe, Gotinha! Vamos partir junt{M#os}{F#as} em busca daquela poção, remover a maldição e resgatar seus companheiros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "Você adivinhou corretamente a direção da trama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "Será que assim poderemos salvar seus companheiros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "O que aconteceu com seu companheiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "É só considerar que é a Gotinha falando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
		{
