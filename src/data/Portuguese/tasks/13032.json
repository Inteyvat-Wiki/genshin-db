					}
				]
			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "*Ofegante* Você é... ótima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Hehe, se tivéssemos corrido mais, você teria me alcançado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "A Avin é de igual para igual com a Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "Eu já ultrapassei vários adultos antes. Ter pernas longas não necessariamente significa que você corre mais rápido. Treinar também é muito importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Haha, eu nem vou conseguir competir contra você daqui a alguns anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Hm, vamos ver... Para onde deveríamos ir em seguida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Ah, veja! Algo está flutuando ali em frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "Parece ser... uma estrela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Ela quer que a gente siga ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320210,
					"content": "Hmm, talvez. Vamos segui-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1303205,
			"completionStepIds": [
				1303205,
				1303214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303205",
							"2"
						],
						"stepId": 1303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avin",
					"Yoimiya",
					"Arashani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "Então, esse é o nosso destino? Mas Paimon não está vendo um aranara. Apenas essa pedra enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320502,
					"content": "Estou tão feliz... Eu quase esqueci qual é a sensação de ser tão feliz assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320503,
					"content": "Sabe, no começo, eu senti como se meu mundo tivesse se reduzido a apenas um espaço minúsculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320504,
					"content": "Mas desde que eu possa continuar correndo sempre adiante, novas perspectivas sempre aparecerão em minha frente, e meu mundo continuará sempre expandindo bem na frente de meus olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320505,
					"content": "Embora eu não saiba como fiz isso, só sei que tenho que agradecer a vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320506,
					"content": "Oh, isso não é importante. O que importa é que você lembrou da alegria de viver o mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320507,
					"content": "Nossas memórias não simbolizam apenas nosso passado. Elas também iluminam o nosso futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320508,
					"content": "Quando você se recuperar, essa felicidade vai voltar para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320509,
					"content": "Sim! Obrigada, Yoimiya! Obrigada a todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320510,
					"content": "Vamos continuar procurando por Arashani. Não parece que ele está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320511,
					"content": "Pois é... Então por que a estrela nos traria até aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320512,
					"content": "Esta pedra se destaca mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "Não sei como explicar... Eu não sei o que é isso, mas parece bem familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320514,
					"content": "É quase como se fosse parte de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320515,
					"content": "Entendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320516,
					"content": "Essa poderia ser a sua Pedra Cinza-Azulada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320517,
					"content": "P-Pedra Cinza-Azulada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320518,
					"content": "(A Yoimiya é boa no improviso!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(Eu quase me esqueci sobre isso.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "É um minério muito raro que simboliza as aspirações e os sonhos de uma pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320521,
					"content": "Já que você consegue vê-la, significa que você encontrou o que perdeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320522,
					"content": "Ah, então é isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320523,
					"content": "É como nos contos de fadas... Eu achei que tinha parado de acreditar neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320524,
					"content": "Mas estou feliz que encontrei essa crença novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320525,
					"content": "Hã? E-ela passou direto por ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320526,
					"content": "Nós vamos também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320527,
					"content": "Ei, Yoimiya! Ei! ...Bem, não temos escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320528,
					"content": "Passamos, mas nada parece ter mudado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320529,
					"content": "Já faz um bom tempo, Nara Avin. Realmente já faz um tempinho, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320530,
					"content": "Arashani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320531,
					"content": "Por que você parece triste? Oh, Arashani sabe. Você está feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320532,
					"content": "Arashani! *Snif*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320533,
					"content": "Hahaha, os aranaras têm mesmo um toque para jornadas mágicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320534,
					"content": "Eles não só ajudaram Avin a encontrar seu melhor amigo, como também mostraram o que é uma Pedra Cinza-Azulada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320535,
					"content": "Temos que procurar por uma nossa depois — para fazer a lente mais pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320536,
					"content": "Sim! É meio engraçado, mas Paimon acha que podemos conseguir mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320537,
					"content": "Aí está uma aventura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "Isso foi bem divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "Mas nós temos que levá-la de volta à Cidade de Sumeru primeiro. A mãe dela deve estar muito preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320540,
					"content": "A cena diante de vocês é semelhante a um sonho. Antes que percebam, vocês retornaram para onde estavam anteriormente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1303206,
			"completionStepIds": [
				1303206,
				1303207
