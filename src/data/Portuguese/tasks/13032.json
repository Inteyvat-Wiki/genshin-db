				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "O... O sonho acabou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320602,
					"content": "Nós tivemos o sonho mais adorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "Não pareça tão solitária! Ele está logo ao seu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "Arashani! Você... ainda está aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320605,
					"content": "Arashani quer pedir desculpa. Não é que Arashani não queria encontrar Nara. Arashani não conseguia lembrar da hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Arashani não ousa entrar na cidade. Arashani não viu Nara Avin, então Arashani pensou que você tinha feito novos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "Isso é normal e inevitável. Não é algo que deva ser lamentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "Está tudo bem, eu entendo. Isso tudo aconteceu porque eu não consegui me controlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320609,
					"content": "Mas eu acho que entendo agora. Yoimiya está certa. Todos têm má sorte, mas temos que nos apoiar durante esses períodos de azar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320610,
					"content": "Obrigada por me ajudar a redescobrir minhas memórias e sonhos. Eu não vou deixar o seu trabalho ser em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320611,
					"content": "Hehe. Você também nos ajudou bastante, então não seja tão educada! Para ser honesta, nós não sabíamos por onde começar com a Pedra Cinza-Azulada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "Mas agora que estamos neste rastro, acho que vamos encontrar facinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Yoimiya, você precisa dessa Pedra Cinza-Azulada por que quer ver a chuva de meteoros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320614,
					"content": "Sim. Quando a encontrarmos, você deveria vir com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "Se esse for o caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320616,
					"content": "Estou feliz por te emprestar minha Pedra Cinza-Azulada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320617,
					"content": "Hein?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "O-O que acabou de acontecer? Você acabou de tirar... um óculo do seu peito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "#Eu também estou completamente perdid{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "Hahaha, como você sabia que a gente precisava disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "Eu não sabia. Eu só pensei que já que vocês me ajudaram a encontrar meu precioso amigo, eu deveria ajudar vocês usando algo precioso para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320623,
					"content": "E então a luz virou isso. Isso é o que vocês precisavam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320624,
					"content": "Obrigada. Eu não esperava que você fosse resolver nosso problema assim. Maravilha, hora de testar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "Não que eu saiba como usar isso, mas vamos ver o que minha intuição diz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "Onde vocês estão... Onde vocês estão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "Ooh! Acho que entendi! Era bem óbvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "Vamos nessa, eu vou na frente. Quando a gente terminar de assistir à chuva de meteoros, eu te acompanho até sua casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "E também, obrigada por nos ajudar. Na verdade, deixa eu acabar com as gentilezas e te dar um agradecimento de coração no lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "Vocês todos são grandes contadores de histórias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Ah, que coincidência. Eu diria o mesmo para você, Nara Vermelha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
