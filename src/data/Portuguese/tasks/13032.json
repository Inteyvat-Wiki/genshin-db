			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapurva",
					"Avin",
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "Paimon gostaria de perguntar, o que você quis dizer com \"preparada\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320102,
					"content": "Nara Avin não lembrou totalmente. Memórias e sonhos são necessários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320103,
					"content": "Sonhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320104,
					"content": "Mas eu nunca mais vou conseguir ficar de pé novamente. Mesmo que eu me recupere, eu não sei quanto tempo isso vai demorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320105,
					"content": "Tais preocupações não são necessárias aqui. Nara Avin, você precisa se lembrar. Os sonhos estão conectados ao seu coração, não ao seu corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320106,
					"content": "Coração...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320107,
					"content": "Eu te guiarei apenas até aqui. Nara Avin precisa encontrar suas preciosidades sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320108,
					"content": "Hã? E ele se foi? Simples assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320109,
					"content": "Me parece que, de alguma forma, o céu aqui mudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320110,
					"content": "Coração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320111,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320112,
					"content": "Hã!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320113,
					"content": "Eu... estou de pé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320114,
					"content": "Não foi nem um pouco difícil, e não me senti estranha. Foi como... como as coisas eram antes de eu adoecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320115,
					"content": "Espera, então isso significa que nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320116,
					"content": "Estamos dentro de um sonho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "Não é a primeira vez que entramos em um. Ah, não é à toa que Araja disse para não se preocupar... Avin pode se mover livremente nesse sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320118,
					"content": "Vejam, eu estou de pé! Hehe, estou de pé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320119,
					"content": "#Que incrível! Agora todos nós podemos procurar pelo Arashani junt{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320120,
					"content": "Vamos lá, vamos apostar uma corrida! Quero ver o quão boa você realmente é!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320121,
					"content": "Eu não devo ter me recuperado ainda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320122,
					"content": "Tanto faz, vamos lá! Eu não vou perder, nem mesmo para um adulto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320123,
					"content": "Ah, e lá vai ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320124,
					"content": "Bem, isso foi fácil. Paimon achou que ela precisaria de mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320125,
					"content": "Acho que isso é o que chamamos de aptidão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Hehe, isso é verdade. Vamos alcançá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320126,
					"content": "Esse é o poder de um desejo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
		{
