			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "#Ótimo, ótimo! Vocês d{M#ois}{F#uas} realmente dão jeito para tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050302,
					"content": "Tenho a sensação de que desta vez vão crescer bem, agora que tenho a orientação de especialistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050303,
					"content": "O Rolinho Shawarma e o Tahchin estavam gostosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050304,
					"content": "Deliciosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Sendo assim, eu prepararei mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050307,
					"content": "Minha habilidade culinária não se equipara à de minha falecida esposa, mas também não é nada mal. Por favor, levem com vocês. Pena que não tem tanto quanto na última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050308,
					"content": "Isso é delicioso! Você é o melhor, vovô Affan! Visitaremos você sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050309,
					"content": "Haha, vocês não queriam me perguntar que flor é essa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050310,
					"content": "Acho que posso te dizer. Estou cultivando rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050311,
					"content": "Do mesmo tipo que as Rosas de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "Esse tipo se chama Rosa Dourada. É muito mais preciosa que a Rosa de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050313,
					"content": "Anteriormente, eu havia dito que essas sementes foram deixadas por um amigo, recordam-se?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050314,
					"content": "Na verdade, essas sementes e a velha casa onde moro são todas heranças do \"Velho Fantasma\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050315,
					"content": "Ah, eu me esqueci. Vocês não são habitantes da Vila Aaru, com certeza não conhecem esse nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050316,
					"content": "Não se preocupem, é compreensível. Pensem nele como um senhor capaz de cultivar flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050318,
					"content": "Ei, vovô Affan, você está divagando de novo! Olá! Olá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050319,
					"content": "Ah! Ops, fiquei confuso, desculpe. Estou ficando velho, haha. Às vezes minha cabeça vai para outro lugar. Que vergonha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050320,
					"content": "#Novamente, agradeço a vocês d{M#ois}{F#uas}. Se ainda houver algo que vocês desejem ver, podem dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050321,
					"content": "Eu não voltarei a expulsar as pessoas, no entanto, tomem cuidado, não vão sair pisando no sementeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050306,
					"content": "Ainda não provei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
