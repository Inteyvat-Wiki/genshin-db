					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Ah, eu ainda não tive tempo de cozinhar. Receio que não tenho nada para servi-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "Não precisa se incomodar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "A outra criança é sua amiga, né? Ela é fofinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "Depois que as flores que plantei desabrocharem, vocês gostariam de vir vê-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Elas provavelmente florescerão em alguns dias. Volte depois para ver como as flores que vocês ajudaram a plantar estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Ok, ok. Já entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "Não se preocupe, não estou com fome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
