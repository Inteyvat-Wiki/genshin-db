			"dialogs": [
				{
					"id": 732050401,
					"content": "Em primeiro lugar, regar essas três sementes. Depois eu penso em como adubar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Mesmo tendo passado todas essas décadas, eu sei mesmo como se faz um fertilizante simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
