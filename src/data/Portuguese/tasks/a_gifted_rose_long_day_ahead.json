			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Aqui, venham ver essas sementes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "Parece não haver nada de diferente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Sim. Apesar de termos plantado por muitos anos, o cultivo de flores é distinto dos demais cultivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Se não fosse assim, por que não cresceriam, mesmo depois desse tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Deixe Paimon ver... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Vovô, Paimon tem a sensação de que o jardim está muito seco. E a terra pode não ser muito fértil na Vila Aaru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "Há um tempo atrás, ajudamos outras pessoas a plantarem flores, temos experiência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Ah... É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Faz sentido. Estas flores são muito especiais. Eu posso não ter regado ou fertilizado o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Mas o jardim fica um pouco longe das fontes de água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Eu também não tenho muito em casa para o meu uso diário, então não é fácil conseguir água para o jardim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Eu posso ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Certo, então, gostaria de pedir a vocês que regassem essas três sementes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
