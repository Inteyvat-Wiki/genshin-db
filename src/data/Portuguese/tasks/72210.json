			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "Você encontrou eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Encontrei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Vocês! Vocês nunca dão ouvidos a mim, não é? Por que vocês dois não podem ser tão bons quanto Meshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Meshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Hahaha, você realmente dá nomes de coisas boas a eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miau, miau miau miau... miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "Hachichou"
				},
				{
					"id": 722100407,
					"content": "Miau! Miau miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100408,
					"content": "Sem conversa fiada! Por acaso eu não deveria procurar você e simplesmente deixá-lo... deixá-lo passar fome desde o nascer do sol, passando pelo surgimento da lua, até o sol nascer novamente, e deixar você encontrar o caminho para casa sozinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100410,
					"content": "Hah, você é uma boa criatura. Tudo bem, tudo bem. Que bom que voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "Devo muito a você. Se não fosse por sua ajuda, esses pequenos traquinas teriam passado fome por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "Na verdade, acho que eles teriam conseguido voltar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "De qualquer maneira, você tem os meus agradecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "Se você tiver tempo, volte. Eu ainda posso ter outros assuntos em que você pode me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
