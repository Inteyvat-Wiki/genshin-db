			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Oh, miau, miau... Para onde eles foram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah, é você. Alguns daqueles malandros fugiram, e esta não sabe para onde foram. Isto é muito preocupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "O lado de fora é um lugar muito perigoso. Embora eu já lhes tenha ensinado muitas vezes, aqueles bichos peludos com varetas e aquelas bolas de água e fogo ainda são perigosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "E, se eles esbarrarem naquela coisinha chocante, os pelos por todo o corpo ficarão arrepiados. Eu não gostaria de ver aqueles malandros experienciando algo tão terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Mas sempre há alguns que não ouvem e saem vagabundeando por aí. Eu sempre tenho que gastar muito esforço para trazê-los para casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Alguns deles fugiram novamente hoje, o que é realmente muito preocupante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Por favor, eu preciso de sua ajuda para encontrar Konbumaru e Hachihou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "Quem é Konbumaru...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Uma criança boa. Konbumaru desta geração é inteligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "\"Desta geração\", como assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "A Hibiki às vezes falava sobre isso. Eu não posso afirmar ter entendido, mas, pela sua expressão quando falou sobre Konbumaru, deve ter sido algo bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Eu dou aos pequenos o nome de coisas boas e, uma vez que os pequenos não são mais pequenos e partem, eu usarei esses mesmos nomes para gatos cada vez mais jovens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "Konbumaru adora dormir em lugares altos, por isso seria melhor se você começasse por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "Então, Hachihou é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Uma coisinha muito ágil e também muito apaixonado por peixe. Como tal, às vezes ele vai à beira-mar para procurar peixes que encalharam na costa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Mas é muito perigoso. A água é uma coisa muito assustadora. Há muito, muito tempo, um certo... Tanuki, acho? Aquela coisinha caiu na água, e quase não voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "Você provavelmente pode encontrar Hachihou perto da água salgada, à procura de peixes ou caranguejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Essa dica é muito ampla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Sério? É um lugar muito alto e cheio de água salgada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "Uhh, que tal mostrarmos a Neko nosso mapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Você... Você realmente carece de poder da compreensão, não é mesmo? Este é o lugar mais alto, e este é o montão de água salgada. Eles certamente estarão lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "Não se preocupe com isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Então está em suas mãos, miau, miau. Ah, essas crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "Não sou especialista em pegar gatos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miau, miau. Não se preocupe. Esses pequeninos não temem os humanos de qualquer forma... Na verdade, pode-se dizer que é justamente porque ninguém brinca com eles que eles sempre fogem sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "Então está em suas mãos, miau, miau. Ah, essas crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
