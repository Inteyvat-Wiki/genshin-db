			"dialogs": [
				{
					"id": 722100301,
					"content": "Miau! Miau, miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100302,
					"content": "Uau! Isso é um gatinho feroz, isso sim. Tenha cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Miau, miau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Miau miau? Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "Konbumaru"
				},
				{
					"id": 722100307,
					"content": "Hehe, apesar de parecer feroz, Paimon acha que ele deixará você o carregar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "Vim levar você para casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
