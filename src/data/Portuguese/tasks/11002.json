				{
					"id": 110020201,
					"content": "Deve estar aqui por perto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020202,
					"content": "Você já sabe o que está procurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020203,
					"content": "Claro que não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "Então, como você está tão segura de si mesma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "É apenas o meu estilo. Se eu decidir antecipadamente o que cozinhar, não haverá surpresas para o prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "Da mesma forma, se eu soubesse o que estava procurando antes de encontrar, não seria mais uma surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Mas isso é muito arriscado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "Relaxe, foi assim que tive a ideia dos pratos principais do Restaurante Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Vamos dar uma olhada por aqui, avisarei quando encontrar algo que eu gosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
