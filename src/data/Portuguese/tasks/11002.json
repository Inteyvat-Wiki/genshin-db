			"dialogs": [
				{
					"id": 110020701,
					"content": "Ainda sinto que estamos esquecendo de algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020702,
					"content": "O quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "Sim. Falta um pequeno \"bum\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020705,
					"content": "Sim, agora que você mencionou, falta realmente um pouco de \"bum shaka-laka\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020706,
					"content": "\"Bum\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020709,
					"content": "Brook pode ser uma fanática pelo convencional, mas ainda assim é uma chef talentosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020710,
					"content": "Não há dúvidas de que ela usa os melhores ingredientes. Para ganhar, será realmente preciso fazer um super prato incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020711,
					"content": "Algo como salada de serpente do mar, Flor Qingxin frita ou cogumelos cheinho de suco de slime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020712,
					"content": "Urg... Cogumelo com Suco de Slime?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020713,
					"content": "Hahaha, eu sei quão estranho isso soa, mas garanto que o sabor é incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020714,
					"content": "Eu vou preparar alguns para você na próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020715,
					"content": "Não consigo esperar mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "#Hihi, você não ficará desapontad{F#a}{M#o} quando provar, embora pareça um pouco estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020719,
					"content": "Esquece, eu me lembrei de um lugar que não tinha verificado da última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020720,
					"content": "Meu instinto me diz que é ali que vamos obter o grande prêmio. Vamos dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020717,
					"content": "Err... Não precisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "Ei? Não entendi, é realmente delicioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020707,
					"content": "Paimon, como você entende isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "Quer dizer, não é impressionante o suficiente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
			]
