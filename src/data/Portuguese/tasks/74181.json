			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mero Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "O que você está fazendo aqui? Madame Mero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Oh, é você. Eu ouvi que aquele meu marido imprestável tinha um lugarzinho por aqui, então pensei em passar e dar uma olhada nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810103,
					"content": "Mas olhe só o que encontrei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810104,
					"content": "Ele, na verdade, mantém essa foto com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810105,
					"content": "Heh, o tio Rocher se importa muito com você, Madame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "Tivemos nossas suspeitas sobre você e o tio Rocher foi o único discordante. Só ele quem nos garantiu que você nunca poderia ter cometido o crime. Estávamos nos perguntando onde ele encontrou essa confiança toda para nos enfrentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "Provavelmente usou até a última gota de masculinidade que tinha nele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Hã? É sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810109,
					"content": "Isso mesmo! Além disso, ele não disse que perdeu o pingente da senhora por causa de apostas? Isso não é verdade! Ele só estava com vergonha de dizer a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Ah, isso? Eu já sabia disso há muito tempo, mas nunca acreditei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810111,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "Meu marido tem muitos defeitos, ele pode ser um pouco medroso, um pouco fraco e talvez até um pouco indeciso, mas eu sei que ele é uma pessoa honesta. Talvez ele seja enganado por outras pessoas, mas ele definitivamente não é um apostador degenerado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810113,
					"content": "Eu ainda não confrontei ele pessoalmente, só estou esperando que ele venha me contar a verdade por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810114,
					"content": "Uau, que ótimo! Pena que não sabemos aonde ele foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Shh... olhem para lá, tenho certeza absoluta de que ele está escondido naquele canto, dentro daquela caixa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810116,
					"content": "(Hã!?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(Ahem... igualzinho antes, quando brigamos, ele ainda se esconde no armário em silêncio, achando que eu não percebo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Precisa de ajuda para chamá-lo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Não precisa se preocupar, hoje eu vou ficar de olho e ver até quando ele vai se esconder.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810120,
					"content": "Claro, há outra coisa com a qual eu poderia contar com a sua ajuda. Se você algum dia encontrar com Curve e a Agente Talochard, por favor, diga a eles o seguinte:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810121,
					"content": "Eu arrumei alguns quartos e eles são bem-vindos a ficar aqui a qualquer momento. Claro, a casa Lombroso também está aberta para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Mero Lombroso"
				},
				{
					"id": 741810122,
					"content": "#Mas, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "Entendido, senhora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Bem... então não vamos mais incomodar a senhora! Esperamos que o Sr. Rocher possa enfrentar a situação em breve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Obrigada. Desejo a vocês também que possam encontrar soluções para qualquer problema que surja no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mero Lombroso"
				}
			]
		},
