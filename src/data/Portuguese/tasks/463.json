					"nextDialogs": [
						4630307
					]
				},
				{
					"id": 4630307,
					"content": "#Que espert{M#o}{F#a}! Mas é um pouco lent{M#o}{F#a}, porque só descobrimos agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630311
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630311,
					"content": "Eu sou o Izzard.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630312
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630312,
					"content": "#Eu agradeço vocês {M#dois}{F#duas} em nome dos Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630313
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630313,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630314,
					"content": "Temos mantido um perfil discreto, como que se espalhou a notícia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630315,
					"content": "Perfil baixo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630316
					]
				},
				{
					"id": 4630316,
					"content": "Hunf! Não deixarei você ficar com o tesouro sem uma luta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630317,
					"content": "Acho que será melhor você não subestimar nosso poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630318
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630318,
					"content": "Minha turma está do lado de fora esperando meu pedido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630319
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630319,
					"content": "Contudo, eles não são tão sociáveis como eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630320
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630320,
					"content": "(Entram o Kaeya e os Cavaleiros de Favonius)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630321
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630321,
					"content": "Sinto muito por decepcionar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630322
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630322,
					"content": "Mas sua gangue... O que posso dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630323
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630323,
					"content": "Você pode visitá-los na Prisão de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630324
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630324,
					"content": "Ou melhor, você pode fazer companhia para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630325
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630325,
					"content": "Os Cavaleiros...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630326
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630326,
					"content": "Ei, é o Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630327,
					"content": "Kaeya, ele quer pegar o seu tesouro! Pegue-o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630328,
					"content": "Tsc... foi por pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630329
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630329,
					"content": "Oh, o tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630330
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630330,
					"content": "Desculpe, mas não tinha nenhum tesouro desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630331
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630331,
					"content": "Você veio de tão longe... Para nada. Apenas desista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630332
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630332,
					"content": "Quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630333,
					"content": "Não tem... Nenhum tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630334,
					"content": "O Kaeya acaba de dizer que não tem nenhum tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630335,
					"content": "Haha, você me pegou... Não imaginava que os Cavaleiros recorreriam a tais artimanhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630336
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630336,
					"content": "Um ladrão não tem o direito de criticar os métodos dos Cavaleiros de Fav... Espere, o que você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630337
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4630337,
					"content": "Você não vai me pegar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630338
					],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630338,
					"content": "O que... É isso? Eu não fiz de propósito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Izzard"
				},
				{
					"id": 4630308,
					"content": "O mercado negro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630309
					]
				},
				{
					"id": 4630309,
					"content": "Bem, eu tenho alguns negócios com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630310
					],
					"speakerTitle": "???"
				},
