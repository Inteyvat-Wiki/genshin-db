					"content": "Como Kaeya... Como os ladrões de tesouro que o Kaeya nos disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630009,
					"content": "Enfim, queria apenas pegar a espada emprestada para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Paimon"
				},
				{
