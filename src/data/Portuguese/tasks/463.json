					"content": "Vamos reportar ao Kaeya primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "Hum? A Paimon acha que não é necessário! Não há necessidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630006,
					"content": "Você leu a minha mente! Paimon está tão feliz!",
