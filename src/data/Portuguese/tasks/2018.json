					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Senhora Guuji. Aqui estou, como prometido. Tenha certeza de que vim aqui sozinha e não contei a ninguém sobre esta viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "Eu sabia que você iria cumprir sua promessa, afinal de contas... Tenho certeza de que mal conseguiu tirar sua mente disso nos últimos dias — conseguiu dormir um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "Eu... Eu... Você está muito enganada. Eu nunca duvidaria dos líderes do meu clã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "Então. Onde está sua prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ah, que maravilha. Todos estão cumprindo suas promessas hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "Você não acreditaria no que tivemos que passar para colocar as mãos nessa coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Entregue-os a Sara. Ela pode examiná-los por si mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "Isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "...Vejo que este documento tem o selo oficial do chefe do Clã Kujou. E não parece uma falsificação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "Eu não entendo... Nenhuma palavra sobre a resistência, Sangonomiya, ou a situação na linha de frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "E os soldados que deram suas vidas na linha de frente ou as adversidades enfrentadas pelo povo? Não merecem nenhuma menção?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "Total desprezo pela vida humana. Por que eles querem esconder isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "Para o bem do Decreto de Caça à Visão, é claro. Você não acha que a Shogun poderia reconsiderar sua política se todas as coisas que você acabou de mencionar aparecessem neste relatório?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "Então a Comissão Tenryou... eles estão deliberadamente enganando a Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Sim. Agora... quem mais você acha que pode se beneficiar com o Decreto de Caça à Visão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "Também tenho uma carta confidencial aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Esta é uma carta da Comissão Tenryou aos Fatui. O chefe do Clã Kujou também manteve isso em segredo da Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "Bem, as coisas que você queria ver, mas também que não esperava ver estão aqui na sua frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "Certamente... você não está planejando fechar os olhos para elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "Então, tudo em que eu acreditei... É tudo... Como eles puderam... Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "Essa traição é imperdoável... Takayuki, você tem algumas explicações a dar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara realmente está furiosa. Parece que a provocamos com sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "O Exército do Shogunato está sem um líder por enquanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Sim, vamos segui-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "Viajante, espere um pouco, eu ainda tenho algo que gostaria de falar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "A primeira vez que você entrou no Plano da Eutimia foi quando estava na frente da Estátua da Deusa Onipresente, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "Você deve encontrar uma maneira de recriar as circunstâncias daquele dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "Se você conseguir que a Shogun Raiden \"abra o coração\" para você mais uma vez diante da Estátua da Deusa Onipresente, você terá a oportunidade de que precisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "Farei o meu melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Leve isso com você, pode ser visto como um presente de despedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "É um Omamori do Grande Santuário Narukami, mas ele nunca foi muito útil para mim. Estou dando um especialmente para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Agradeço...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Ficarei feliz com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "Ou, se você alguma vez pensar em mim durante sua jornada, tire-o, certo? Quem sabe, talvez eu acabe aparecendo bem na sua frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "#Pare com isso, Senhora Raposa. Esta não é a hora nem o lugar para tirar uma com a cara {M#do}{F#da} Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Hehehe... Desculpe. Bem, vá em frente, está na hora de você encarar minha tola e desesperada amiga. Estou contando com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "Cuidarei bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Vamos segui-la, talvez tenhamos uma chance de encontrar com a Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
