						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "Você me seguiu até aqui? Você tem coragem, devo admitir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "#Já que vocês são testemunhas, suponho que posso precavê-l{M#o}{F#a}s da prisão - pelo menos até ter recebido uma explicação de Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "#Mas... Caso se verifique que você tenha sido desonest{M#o}{F#a} neste assunto, não só será pres{M#o}{F#a} imediatamente, como também será acusad{M#o}{F#a} de mais um crime. Me expliquei claramente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Perfeitamente clara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Hnf. Ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180305,
					"content": "Lidere o caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Takayuki",
					"Kujou Sara",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "Pare! Sara, você ficou insana!? Como você ousa desprezar minhas ordens!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180404,
					"content": "M-Mestre, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180405,
					"content": "Vá em frente, pergunte a ele! Não deixe que ele te intimide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180406,
					"content": "...Mestre Takayuki, eu vi o relatório ao trono e a carta aos Fatui... Por favor, diga-me o motivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "Então foi assim que meus documentos desapareceram da sede? Você os roubou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "Devo interpretar suas palavras no sentido de que... Estes documentos não eram falsificações? Eles realmente foram escritos por sua própria mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Diga-me, Mestre, eu preciso saber... A Comissão Tenryou realmente... Traiu o Shogunato!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "Hnf... Sim, eu tenho relações com os Fatui. E sim, o relatório que você viu foi escrito pela minha mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Heh, ele simplesmente foi e admitiu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "Os diplomatas de Snezhnaya prometeram uma recompensa muito generosa... E tudo o que eles me pediram em troca foi ver que o Decreto de Caça à Visão fosse cumprido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "Por muito tempo, a posição do Clã Kujou tem sido cobiçada por muitos. Não faltam clãs que nos derrubariam na primeira oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "Então, quando surgiu a chance de ganhar o apoio de outra nação poderosa e reprimir nossos inimigos ao mesmo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "Me pareceu ser um excelente negócio. Eu simplesmente não vi necessidade de informá-la, Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "Mas... Você adora à Shogun. Como você pode traí-la depois de todo esse tempo e agir como se não fosse nada!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "Traição? Como você ousa chamar isso de traição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "Os Fatui podem pensar que estão me usando, mas na verdade é o contrário. O que eles poderiam esperar alcançar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "Quando o relâmpago atingir Inazuma, eles cairão de joelhos e tremerão, paralisados pelo medo e pela trepidação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "Afinal de contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "Ninguém pode competir com o poder supremo da Toda-Poderosa Shogun Raiden e da Musou no Hitotachi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "Sua intenção não era trair a Shogun Raiden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Sim... Ele não adora a Shogun Raiden em si, mas seu poder como guerreira - especialmente a Musou no Hitotachi. Na verdade, ele parece estar muito interessado nela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "Mas Mestre... E quanto à lealdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Desde que fui adotada pelo Clã Kujou, você me ensinou a importância da lealdade dos servos a seus superiores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "Mas está claro para mim agora que você queria que minha lealdade parasse com o Clã Kujou. Então você estava com medo de que eu o traísse um dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "Seu hipócrita! Pregando sobre a virtude apenas para mascarar seu próprio egoísmo miserável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "Egoísmo? Eu estou apenas salvaguardando a eternidade do Clã Kujou. Tenho certeza de que a Toda-Poderosa Shogun seria simpatizante a isso, assim como o antigo chefe do nosso clã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Odeio dizer isto, mas seu ego está se metendo no caminho. Se ele acha que o Clã Kujou está à altura dos Fatui, Paimon acha que ele vai ter uma surpresa desagradável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "Não vale a pena tentar discutir com ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "Eu duvidei do Decreto de Caça à Visão no passado. Eu me perguntei, isto é realmente a coisa correta a se fazer? Mesmo que vá contra o que eu sei no meu coração estar certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "Mas eu escolhi obedecer a Shogun. Enquanto ela liderar o caminho, quem entre nós está qualificado para julgar entre o certo e o errado quando ainda não chegamos ao fim do caminho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "Mas agora percebo que o caminho da eternidade é um caminho sem fim, enquanto este caminho... Há muito tempo foi profanado por seus motivos egoístas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "Portanto, vou contar a Shogun a verdade sobre tudo isso. Se nada mais, minha consciência ficará limpa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "Isso é teimosia e inútil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Apresente-se a Shogun se assim desejar. A posição do Clã Kujou é agora inabalável, e nada que você possa fazer mudará isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "A Shogun está em <color=#00E1FFFF>Tenshukaku</color> recebendo uma diplomata de Snezhnaya - a Mensageira de nome \"Signora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "Signora é quem está por trás de tudo isso? Urg, ela de novo não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "Em Ritou, Sra. Hiiragi disse algo sobre a reunião do Comissário Kanjou com uma mulher arrogante... Nós deveríamos ter adivinhado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "Uma diplomata de Snezhnaya? Bem! Se ela pensa que vai deixar Inazuma inteira, está para ser surpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara saiu irritada... Você acha que ela vai entrar em Tenshukaku agora mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "De qualquer forma, temos contas a acertar com a Signora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "Certo! Então, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "Vamos para <color=#00E1FFFF>Tenshukaku</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Vamos ver o que Kujou Sara acha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "Ele está apenas excessivamente confiante em seu poder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
