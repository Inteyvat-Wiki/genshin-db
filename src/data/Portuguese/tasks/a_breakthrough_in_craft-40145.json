			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}! Paimon! Olá! Existe algo com que posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450202,
					"content": "#Bem, estivemos meio abarrotad{F#as}{M#os} ultimamente, então a Lisa recomendou que encontrássemos formas de aumentar nossa eficiência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450203,
					"content": "Ah, sim! Eu discuti isso com ela também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450204,
					"content": "Atualmente, existem três áreas que você pode melhorar — fazer a poção, cultivar e vendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450205,
					"content": "Aumentar sua eficiência nessas áreas tornará muito mais fácil de gerir os seus negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450206,
					"content": "Uau, isso parece exatamente o que precisamos! Vamos tentar, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450207,
					"content": "Aumentar a eficiência de operação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Parece que todos os preparativos necessários para aprimorar foram feitos! Por favor, experimente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450209,
					"content": "Comprar suprimentos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "Você está com sorte! Acabei de receber um novo lote de provisões! Por favor, dê uma olhada e diga se qualquer coisa chamar sua atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450211,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "Boa sorte em seus negócios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				}
			]
		}
