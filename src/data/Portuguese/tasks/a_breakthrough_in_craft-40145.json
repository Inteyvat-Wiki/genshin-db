			"dialogs": [
				{
					"id": 401450101,
					"content": "Após um breve período de testes, a loja de poções abre com um enorme sucesso...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "*Suspira* Não paramos de ser rodeados de mais e mais clientes. Não tem tido nem uma pausa já faz tanto tempo, Paimon está começando a ficar tonta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "Os negócios realmente estão bombando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Temos muitos pedidos. Paimon não tem certeza se conseguimos completar todas elas por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Talvez devêssemos contratar ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "Fazendo uma pausa, fofuras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Eu estava de olho nos dados das vendas, e parece que vocês têm um enorme talento com negócios. As poções parecem voar das prateleiras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Oh, Lisa! Momento perfeito! Estávamos falando como seria bom a sua ajuda pela loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Oh? Os pedidos já estão se amontoando? Tendo problemas em acompanhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Sim, estamos oficialmente abarrotadas! Paimon jamais imaginou que teríamos tantos clientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Bem, não posso dizer que estou surpresa pelo sucesso. Eu, na verdade, estava esperando esse tipo de resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "#Enquanto vocês estavam ocupad{M#o}{F#a}s com a loja, eu estava falando com Freda sobre possíveis formas de fazer os negócios mais eficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "Depois de observar o seu trabalho, notei várias melhorias que podemos fazer de fazer poções, cultivos e vendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Espera, então você tem feito tudo isso por debaixo dos panos esse tempo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Paimon meio que achou que você não estava fazendo nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "Oras essa, na verdade, eu sou bem confiável em momentos cruciais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Então, como deveríamos colocar essas melhorias em ação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Bem, eu discuti as coisas com Freda e nós duas bolamos um plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "Mas eu deixarei ela te dar os detalhes. Por que não vai falar com ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "Fizemos um bom nome para nós mesmos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
