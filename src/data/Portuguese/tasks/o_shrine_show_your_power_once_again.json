			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{F#Tia}{M#Tio}! Escute! Escute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Depois que fiz uma oferenda ao santuário da última vez, meu desejo foi atendido... uma pequena parte dele, pelo menos! Mas embora seja apenas uma pequena parte... Esta deve ser a resposta da Arconte, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Qual desejo você fez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Err... o desejo que fiz da última vez foi que o autor do mangá que estou lendo fosse mais produtivo. Seria melhor fazer uma atualização a cada dois dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "E então, o autor realmente dobrou a quantidade de conteúdo atualizado em uma edição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "No entanto... Também ouvi dizer que ele vai fazer uma pausa para as 3 edições futuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Bem equilibrado, creio eu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Hmm... De qualquer forma, tenho certeza que a Arconte ouviu meu desejo. Isso significa que a razão pela qual a outra parte do meu desejo não foi atendido é que eu não ofereci coisas suficientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "Então, vamos fazer uma oferenda a outros santuários hoje! Assim, tenho certeza que meu desejo será completamente atendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Eu perguntei aos meus pais, e eles disseram que ainda existem dois santuários por aqui. Um fica perto da Casa de Chá Komore e o outro está na saída da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "Qual santuário você acha que devemos ir primeiro, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Parece que você terá menos uma edição no geral...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
