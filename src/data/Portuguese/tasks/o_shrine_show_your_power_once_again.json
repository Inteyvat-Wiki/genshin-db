			"dialogs": [
				{
					"id": 220280501,
					"content": "Deve ser aqui mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "Ouvi dizer que o Doushin fez sacrifícios de Tsuru a esse santuário, desejando muita paz para todos em Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Depois, um incêndio queimou uma casa, que tinha sido feita com menor qualidade. A casa foi destruída logo pelo fogo, antes que se espalhasse para outros lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Aí todos acham que os deuses estão nos protegendo, portanto, eu também trouxe alguns Tsurus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Mas chega de conversa! O que vamos oferecer dessa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Assim como o Doushin, se oferecermos um Tsuru, talvez possamos ser respondidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Mas para mim, já que este santuário fica perto da casa de chá, então sacrificar confetes de sabor matcha não seria melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Hum... Além do mais, gosto muito de confetes de matcha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "Viajante, e você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
