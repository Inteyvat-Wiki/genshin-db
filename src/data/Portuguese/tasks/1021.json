			"dialogs": [
				{
					"id": 10210201,
					"content": "Hu? É apenas a Paimon, ou tem uma fragrância doce no ar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210202,
					"content": "Hum... Você ouviu isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210203,
					"content": "Parecia alguém pedindo por ajuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "Parece que veio daquelas ruínas ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210207,
					"content": "Oh não, parece que os Ladrões de Tesouro prenderam alguém lá dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210205,
					"content": "Parecia que alguém estava cantando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "Uh, não! Definitivamente parece alguém com problemas! Veio daquelas ruínas ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
