					"Buyun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Segundo a Keqing, isto é o que deveríamos dizer...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Com licença, você vende a lua aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Sim. Quantas você gostaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210304,
					"content": "Não é conveniente falar de números aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "Boa resposta! Vocês são os convidados da Ningguang, né? Vão seguir este caminho para subir, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Buyun"
				},
				{
					"id": 10210306,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Mas isso não é o código para convidados, mas para a Yuheng. O que está acontecendo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buyun"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
