			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "Acredito que você já ouviu falar da Guerra dos Arcontes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211302,
					"content": "Não tenho certeza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "Neste mundo, existiam vários arcontes, bem como as lutas duradouras que se acabaram apenas há dois mil anos, em que incontáveis vidas se perderam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211305,
					"content": "No final, apenas sete vitoriosos permaneceram de pé em Teyvat. Eles construíram cidades e nações sobre os cadáveres dos perdedores, e assim começou a era dos Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211306,
					"content": "Você consegue ver a Floresta de Pedra Guyun daqui, correto? Não é uma formação rochosa natural - são lanças gigantes de rocha, lançadas pelo Rex Lapis durante a guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211307,
					"content": "Sob as lanças de rocha, estão contidos os derrotados pela Rex Lapis, os que não conseguiram o trono de Sete Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211308,
					"content": "É natural que os arcontes morram, apesar de serem os Sete Arcontes, eles sofreram de algumas alterações ao longo da história. O falecimento do Rex Lapis é um desastre fora da imaginação, mas de qualquer forma, o sistema de Sete Arcontes de Teyvat nunca entrará em colapso... Nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211309,
					"content": "O próximo Arconte Geo aparecerá mais cedo ou mais tarde, mas como podemos nos esquecer do Rex Lapis? Até então, a relação entre o povo de Liyue e os arcontes será diferente que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211310,
					"content": "Mesmo na era nova, os Qixing de Liyue ainda fazem parte do povo antigo do Rex Lapis. Você realmente acha que podemos assumir a responsabilidade de... violar o Rex Lapis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211311,
					"content": "Por que esconder a Exuvia, então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211313,
					"content": "Naquele dia no Terraço de Yujing - foi tudo muito repentino. Até eu fui pega completamente desprevenida. Você estava lá, você sem dúvida viu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211314,
					"content": "Mas nosso inimigo há muito se escondeu dentro do porto. Se não agirmos contra eles agora, eles certamente ganharão a vantagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211315,
					"content": "Esconder a Exuvia foi uma manobra necessária para retomar a iniciativa, para imitar uma aranha enquanto nossos inimigos se dispersam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211316,
					"content": "Quem é esse \"inimigo\" de que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211317,
					"content": "O que você acha, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211318,
					"content": "É \"ele\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "Hum? Que tipo de jogo você e Ningguang estão jogando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211321,
					"content": "Bem dito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211322,
					"content": "Hã!??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211323,
					"content": "... Ha... A paisagem de fora é lindíssima sim, todavia, o vento aqui em cima é muito forte... Portanto, por favor, sigam-me ao interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211319,
					"content": "É \"ele\", não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "Tenho uma ideia geral.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
