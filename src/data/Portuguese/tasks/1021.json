			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "Estava esperando por você, regressante do Relevo de Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210402,
					"content": "Ah, é a Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Como esta é a nossa primeira reunião, preparamos um presente! Espero que você goste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "Oh, para mim? Você tem meus agradecimentos. Parece que eu tornei as coisas mais difíceis para você, considerando que você deveria ser meu convidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210405,
					"content": "Hehe... Oh não, não é nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "Que lugar lindo, a Câmara de Jade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Haha, estou feliz que você também tenha gostado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210409,
					"content": "No ponto mais alto deste palácio, onde todas as montanhas estão ao seu pé, toda a vista do Porto de Liyue está capturada pelos seus olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210410,
					"content": "Desde pequena quando eu aprendi fazer negócios, comecei a economizar para construí-lo. Após ser Tianquan, convidei uns artesões peritos para expandir a construção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210411,
					"content": "No início, era apenas do tamanho de uma sala. Agora, ela é grande o suficiente para apagar a lua nos céus acima de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210412,
					"content": "Um dia, acredito que isso irá ofuscar todas as sete nações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210413,
					"content": "(Esta Tianquan é muito ambiciosa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Poucos convidados estrangeiros são qualificados para subir à Câmara de Jade, contudo, eu e a Grande Mestre Intendente temos comunicado muito por meio de carta, e ela sempre te elogia bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210415,
					"content": "Como tal, tenho colocado olhos e ouvidos por aí desde que você chegou a Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210416,
					"content": "O quê?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "E eu finalmente soube apropriadamente sobre seus movimentos quando você estava a caminho do Albergue Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210418,
					"content": "Espere. Verr Goldet era um de vocês!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "Não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210420,
					"content": "Todos no Albergue Wangshu é um de nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210421,
					"content": "##%^%*&……!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "Nós também nos encontramos com a Yuheng não faz nem muito tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "Na Balista Guizhong, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210424,
					"content": "Vocês estavam nos espiando dos céus o tempo todo, por acaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "Haha... Temo que espiar teria sido um pouco difícil dessa altitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210426,
					"content": "#Nossos olhos e ouvidos são mais do que suficientes. Vocês {M#dois}{F#duas} são pessoas muito interessantes, afinal de contas. Seria natural que se interessassem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210427,
					"content": "Keqing disse que os Qixing não iriam desejar mal ao Rex Lapis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "Bem, eu não esperaria que você confiasse em nós, considerando que você teve muito mais interações com os Adepti. O motivo pelo qual o convidei a vir aqui foi para esclarecer alguns mal-entendidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210408,
					"content": "É minha primeira vez que venho a um lugar tão alto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
