			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "Ei? Não é preciso escolher! A maior nota fica no lugar mais marcante! Bom, vamos pegar essa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211202,
					"content": "La la la... Vamos ver o que está escrito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211203,
					"content": "Hum? Tem um lugar marcado com um círculo vermelho aqui. Oh, seria um tesouro!? Seja o que for, vai nos deixar podres de rico! Vamos ver o que está escrito aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211204,
					"content": "\"Selo\"... \"da Permissão\"... Uhum uhum hmmm e... \"Fatui\"... \"Pesquisa\" ... \"Cópia\"... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211205,
					"content": "Aww, não soa nem um pouco como um tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211206,
					"content": "Este papel mostra que um espião dos Qixing descobriu rastros de pesquisas confidenciais dos Fatui, sobre <color=#00E1FFFF>um Selo da Permissão</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211207,
					"content": "Oh, Ningguang disse que os Fatui têm feito de todo tipo de travessuras nas sombras de Liyue. Espalhando rumores, cobiçando o corpo do arconte, e coisas do gênero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211208,
					"content": "Mas pesquisa no Selo da Permissão? Me pergunto o que eles estão fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211209,
					"content": "#Deve haver alguma conexão entre você e o Selo da Permissão, {NICKNAME}. Parece que ainda há mais para nós descobrirmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211210,
					"content": "Está tudo desenrolando um pouco perfeitamente demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "Oh? Você realmente acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211213,
					"content": "Bem... Então é melhor irmos andando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211214,
					"content": "Não, eu tenho outra ideia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "Oh, então você está dizendo que enquanto não pudermos confiar completamente em Ningguang, devemos ter cuidado com tudo o que ela diz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211216,
					"content": "Isso está bem fora da liga de Paimon. Paimon acha que ela não tem sido nada além de boa para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211217,
					"content": "De qualquer forma, vamos ver se você está no caminho certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211218,
					"content": "Antes de irmos procurar por Zhongli na Ilhota de Dihua, vamos ao lugar marcado nestes papéis e ver se os Fatui realmente não estão fazendo nada que preste por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211211,
					"content": "Ningguang está claramente tentando nos guiar até lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
