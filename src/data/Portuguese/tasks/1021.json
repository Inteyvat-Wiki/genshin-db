			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211101,
					"content": "Olá! Um cara chamado Mengdan nos disse que podíamos comprar uma caixa bonita e brilhante em sua loja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "#O Tio Meng já me falou sobre isso. Obrigada {M#aos dois}{F#as duas} por tê-lo salvado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "As melhores mercadorias da minha loja foram recolhidas pelo Tio Meng. Se lhe acontecesse algo ruim, não teria como continuar os meus negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "Olhe, essa caixa de presente é uma antiguidade de 140 anos de história... Já está tudo limpo. Dê uma olhada!... Então, gostou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "Sim, sim, sim! Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Aguarde um momento. Poderíamos pedir emprestado mais uma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Claro, por favor, sintam-se à vontade - desde que esteja em nossas prateleiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "Viajante, este jarro de barro parece realmente fantástico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "Se usarmos uma antiguidade como tigela para a mistura, podemos ser capazes de fazer um ótimo lanche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "Já está feito! Slimes Açucarados Gelados! Vou colocá-los na caixa de presente, com muita atenção, junto com pó de açúcar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "Oh sim. Talvez você queira usar estas duas flores recém-colhidas também como Decorações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "Uaaauu! Parece tão lindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(De alguma forma, eu me sinto um pouco culpado...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Bom! Colocamos tudo que temos nesta caixa. Não vamos perder mais tempo, vamos encontrar com a Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102112,
			"completionStepIds": [
				102112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
