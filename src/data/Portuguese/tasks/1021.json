				{
					"id": 10213101,
					"content": "Então, você fez sua escolha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213102,
					"content": "Você não precisa me perguntar nada. Apenas tome sua decisão, e pegue o que precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213103,
					"content": "Depois disso, por que não se senta um pouco na Câmara de Jade, ou dá um pequeno passeio? O descanso também é uma parte muito importante da jornada.",
