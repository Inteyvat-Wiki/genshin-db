			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mengdan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "Muito obrigado pela sua ajuda, viajante! Se não tivesse vindo em meu auxílio, teria apodrecido nessa prisão. Aqueles Ladrões de Tesouro, quando estavam de bom humor, ajeitavam os potes de Flores Doces, mas quando o humor estava ruim, descontavam em mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210802,
					"content": "Ah, não foi nada. Não precisa agradecer a todos nós de uma só vez nem nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "#Haha, eu entendo. Não se preocupe, irei recompensar {M#os dois}{F#as duas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210804,
					"content": "Realmente não precisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "Não diga isso! Eu só escapei desta situação graças a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210806,
					"content": "Eu sou o Mengdan, fornecedor da Joalheria Mingxing. Eu percorro pelas montanhas em busca de antiguidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210807,
					"content": "Nunca imaginei que os Ladrões de Tesouro estavam de olho na mesma ruína que eu... Antes que pudesse perceber, eles já haviam me prendido. *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210808,
					"content": "Você ainda precisa de mais alguma coisa? Antiguidades, tesouros ou umas peças para decoração? Se o que você quiser é o que eu tenho, posso lhe ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210809,
					"content": "Sua boa vontade é mais do que suficiente para mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "Espere um pouco! Na verdade, estamos à procura de algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "Oh, e o que seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210812,
					"content": "Você tem caixas para presente? A Paimon quer comprar uma bonita para colocar lanches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Claro que temos. Quem trabalha com antiguidade sempre tem caixas de presentes. A <color=#00E1FFFF>Joalheria Mingxing</color> tem as melhores caixas de presente de primeira qualidade das sete nações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210814,
					"content": "Espere mais um pouco. Vou avisar o meu chefe. Você pode ir vê-la sempre que precisar da caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Mengdan"
				},
				{
					"id": 10210815,
					"content": "Ótimo! Agora os Slimes Açucarados Gelados da Paimon vêm em um lindo pacotinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102111,
			"completionStepIds": [
				102111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
