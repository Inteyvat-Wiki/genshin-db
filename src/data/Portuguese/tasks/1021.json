					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "Vamos lá, não há necessidade de ficar de pé na cerimônia. Relaxe um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213106,
					"content": "Chegou a hora de darmos um grande passo. Até a próxima...",
