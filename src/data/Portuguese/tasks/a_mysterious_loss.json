			},
			"dialogs": [
				{
					"id": 411270501,
					"content": "O que aconteceu quando você estava correndo de volta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270502
					]
				},
				{
					"id": 411270502,
					"content": "Quando estava correndo de volta? Deixe-me pensar... Eu não me lembro exatamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270503
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270503,
					"content": "Bom, eu vi um grande grupo de Slimes Electro ao lado do <color=#00E1FFFF>Templo do Vento Milenar</color>, fui atingido por eles, e acabei deixando a caixa cair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270504
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270504,
					"content": "Eu consegui pegar a caixa de volta. Mas depois de correr confusamente por um tempo, perdi ela de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270505
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270505,
					"content": "Mas, como grupo de Slimes Electro encontrou a caixa, ela deve ter algum <color=#00E1FFFF>Vestígio Elemental</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270506
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270506,
					"content": "Resumindo, procure por traços elementais Electro para ver o que encontra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270507
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270507,
					"content": "Assim que encontrar a caixa, traga-a de volta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
