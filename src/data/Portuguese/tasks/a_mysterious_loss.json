			"dialogs": [
				{
					"id": 411270201,
					"content": "O quê? Você ainda precisa de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270202
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270202,
					"content": "Não é fácil fazer uma busca sem pistas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270203
					]
				},
				{
					"id": 411270203,
					"content": "Um, está bem, espere um pouco, eu vou tentar me lembrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270204
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270204,
					"content": "Nada vem a minha mente, e parece que não tem nada de especial sobre a caixa também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270205
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270205,
					"content": "Então vou lhe perguntar algumas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270206
					]
				},
				{
					"id": 411270206,
					"content": "Perguntas? Tudo bem, que perguntas você tem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
