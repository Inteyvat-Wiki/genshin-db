			"dialogs": [
				{
					"id": 411270301,
					"content": "O que você foi fazer lá fora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270302
					]
				},
				{
					"id": 411270302,
					"content": "Ei, por que você está com essa cara de suspeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270303,
					"content": "Eu fui lá fora fazer uma caminhada, só isso! Depois que os meteoritos começaram a cair, voltei o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270304,
					"content": "Bom! Vá dar mais uma olhada. <color=#00E1FFFF>Volte e me procure se você não conseguir encontrá-los</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270305,
					"content": "Eu vou me esforçar mais, talvez consiga me lembrar de algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
