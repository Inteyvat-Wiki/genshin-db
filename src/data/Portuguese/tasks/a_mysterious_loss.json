			"dialogs": [
				{
					"id": 411270401,
					"content": "O que tinha na caixa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270402
					]
				},
				{
					"id": 411270402,
					"content": "Ah, não era importante, só algumas coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270403,
					"content": "Ei! Não me olhe com essa cara de quem está suspeitando de algo! Eu não sou uma pessoa ruim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270404,
					"content": "Mas você é um Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270405
					]
				},
				{
					"id": 411270405,
					"content": "Fatui... Todos os Fatui são suspeitos? De onde você tirou essa conclusão?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270406,
					"content": "Bom! Vá dar mais uma olhada. <color=#00E1FFFF>Volte e me procure se você não conseguir encontrá-los</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270407
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270407,
					"content": "Eu vou me esforçar mais, talvez consiga me lembrar de algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
