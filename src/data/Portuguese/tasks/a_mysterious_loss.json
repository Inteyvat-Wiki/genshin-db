			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411270101,
					"content": "Isso é terrível, com certeza é o meu fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270102,
					"content": "Algo errado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270103
					]
				},
				{
					"id": 411270103,
					"content": "Ai, ficar aqui todo dia é muito chato, ainda mais com as freiras me encarando, daí eu decidi sair daqui para uma caminhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270104,
					"content": "Assim que eu saí da cidade, pensei em ir para os arredores do Templo do Vento Milenar, mas de repente, sem que sequer chegasse nele, começaram a jorrar meteoritos do céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270105,
					"content": "De jeito nenhum eu ficaria ali, imediatamente voltei correndo... Mas foi aí que percebi, eu esqueci de trazer uma caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270106,
					"content": "Mas está um caos lá fora, eu não tenho coragem de ir procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270107,
					"content": "Além disso... Eu sou um Fatui, se fizesse algo inesperado, levantaria suspeitas de estar fazendo algo errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270108
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270108,
					"content": "Chega de falar besteira, você pode me ajudar a procurar aquela coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270109,
					"content": "Nossas transações foram amigáveis até agora, e eu ainda desejo manter boas relações de negócios com você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270110,
					"content": "Não fale essas coisas suspeitas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411270111
					]
				},
				{
					"id": 411270111,
					"content": "O que... Como isso é suspeito? Eu só lhe contei uma história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411270112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 411270112,
					"content": "Está bem, você vai me ajudar ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
