				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#Irmãozão}{F#Irmãzona}! Espera um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390102,
					"content": "#Com licença... Você é {M#um}{F#uma} Aventureir{M#o}{F#a}? Daquel{M#es}{F#as} que se aventuram por diversos lugares e são muito fortes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390103,
					"content": "Pode-se dizer que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#Olhe! Hilmi, bem que eu disse que {M#o irmãozão}{F#a irmãzona} era {M#um}{F#uma} Aventureir{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390106,
					"content": "Mas os Aventureiros não vestem aquelas roupas verdes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390107,
					"content": "Como eu sou muito forte, não preciso me vestir assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390110,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390111,
					"content": "#Então, {M#irmãozão}{F#irmãzona}! Você com certeza pode nos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390112,
					"content": "Você viu aquele grande armazém do vilarejo, não é? O irmão Habachi disse que lá dentro tem muita coisa importante guardada, e que devem ser bem protegidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390113,
					"content": "Ele ainda me disse que, se algum bandido atacasse o vilarejo, primeiro ele deveria suspender o funcionamento do elevador, então, cortar a ponte levadiça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390114,
					"content": "Só que tem uma certa distância entre o armazém e o elevador, certo? Se o irmão Habachi quiser suspender o funcionamento do elevador, terá que correr muito e muito rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390115,
					"content": "Então eu tive uma ideia, queremos ajudar o irmão Habachi a praticar, mas ele não nos dá atenção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390116,
					"content": "Toda vez que queremos brincar de quicar pedras na água ele tem uma reação muito exagerada, tsc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390117,
					"content": "Enfim! Se os bandidos atacassem o vilarejo, o irmão Habachi não conseguiria sair do lugar, assim nós quem teríamos que suspender o funcionamento do elevador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390118,
					"content": "#{M#Irmãozão}{F#Irmãzona}, você é {M#um}{F#uma} Aventureir{M#o}{F#a}, deve ter habilidades incríveis, por favor, nos ajude a treinar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390119,
					"content": "Então eu posso correr com vocês.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#Oba! Obrigado, {M#irmãozão}{F#irmãzona}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390126,
					"content": "#Já escolhemos o ponto de partida, então vamos para lá, {M#irmãozão}{F#irmãzona}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390127,
					"content": "Hehe! É a minha vez de disputar com você. Já aviso que sou muito bom em corrida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390121,
					"content": "Pode confiar em Habachi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "Hã? Vamos brincar juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390123,
					"content": "#Venha, vamos treinar juntos {M#irmãozão}{F#irmãzona}, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390124,
					"content": "Tudo bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#Oba! Obrigado, {M#irmãozão}{F#irmãzona}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390108,
					"content": "Como eu sou especial, não preciso me vestir assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "Bem, pode se dizer que sim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
		},
