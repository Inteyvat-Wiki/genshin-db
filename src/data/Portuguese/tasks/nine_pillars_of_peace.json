			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "\"Ganância, nostalgia, visão, ciúme, raiva, luxúria, delírios de grandeza, competição, caos...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Inscrições"
				},
				{
					"id": 710051202,
					"content": "\"Estes nove desejos mortais podem curar o mundo, ou fazer-lhe muito mal. Seu fogo nunca diminuirá, e nunca se apagará... Assim, estabelecemos nove pilares para trazer paz, para acabar aqui com os conflitos que assolam este mundo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Inscrições"
				},
				{
					"id": 710051203,
					"content": "\"Se alguém que vier depois quebrar esses pilares e entrar, a guerra voltará a consumir o mundo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Inscrições"
				},
				{
					"id": 710051204,
					"content": "\"Ó você que leu esta inscrição, reivindique o tesouro que está dentro e traga a paz a Liyue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscrições"
				}
			]
		},
