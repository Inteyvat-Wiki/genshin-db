			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Você poderia nos ajudar e dar uma olhada nesta antiguidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Antiguidades e curiosidades? Não estou muito familiarizado com elas, mas vou dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Este anel... Hum, é incrustado com uma gema de jade, e outra de boa qualidade também. Só a joia já valeria uma boa quantia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "Há também uma inscrição nela... \"O desastre corre desenfreado pelo mundo, e todos os que vivem o fazem em agonia...\" Onde você encontrou este anel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "Em uma ruína próxima à Encosta Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Encosta Cuijue, hm... Tsc, tsc, que pena. O Relevo de Jueyun também está tão perto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Se este anel tivesse vindo de uma ruína do Relevo de Jueyun, com certeza teria conseguido um ótimo preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Infelizmente não tem uma história por trás, como tal, o preço não vai ser ideal. Mas ainda bem que este anel é de primeira qualidade, com certeza vai haver interessados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Então fazemos assim, eu pago <color=#00E1FFFF>180 mil Mora</color>, e ofereço mais alguma coisa para comprar esse anel. O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
