					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Deixa-me pensar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Você... Bem, tudo bem. Pense um pouco. Talvez minha oferta não tenha sido a melhor que você recebeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Mas quando se trata de negócios, serei justo com você, caso decida me vender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Pense comigo, estamos cooperando a prazo longo. Você me vende o anel, e eu te ofereço informações comerciantes de primeira mão no futuro. Boa ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "#Além disso, estou disposto a adicionar algumas coisas para compensá-l{M#o}{F#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Pense direitinho, e volte até mim a qualquer hora caso você decida me vender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
