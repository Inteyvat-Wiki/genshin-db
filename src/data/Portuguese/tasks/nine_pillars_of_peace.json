			},
			"dialogs": [
				{
					"id": 710050101,
					"content": "\"Todos os distúrbios do mundo têm sua raiz no vício humano...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050102
					],
					"speakerTitle": "Inscrições"
				},
				{
					"id": 710050102,
					"content": "\"Erguemos aqui nove pilares para suprimir o conflito, para nunca mais levantarmos exércitos uns contra os outros...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inscrições"
				}
			]
		},
		{
			"id": 7100502,
			"completionStepIds": [
				7100531
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
