				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "Esta ruína dá arrepios a Paimon. Mas devemos estar no fim dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050202,
					"content": "E também conseguimos algum tesouro pelos nossos esforços - até mesmo conseguimos esse anel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050203,
					"content": "Vamos pedir ajuda a alguns <color=#00E1FFFF>especialistas de antiguidade</color> para saber o valor desse tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7100503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
