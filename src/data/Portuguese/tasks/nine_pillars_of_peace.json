				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Você poderia nos ajudar e dar uma olhada nesta antiguidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "Uma antiguidade? Bem, você veio até a pessoa certa. Eu diria que sou o mais justo em valorizar tais coisas em toda Liyue. Vamos dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Hmm, tanto a pedra preciosa quanto o anel são de ótima textura, e o anel é muito antigo... E está muito bem preservado, altamente incomum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Ainda assim, não posso dizer que já tenha ouvido a frase; \"O desastre corre desenfreado pelo mundo, e todos os que vivem o fazem em agonia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Não importa isso. Onde você encontrou este anel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "Em uma ruína próxima à Encosta Cuijue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Você... Você deve ser bom nisso, não é? Poucos se atrevem a ir lá à caça de tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Essas ruínas por acaso estavam rodeadas por nove pilares, com uma placa de pedra no centro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "#Não fique tão surpreendid{M#o}{F#a}. Os comerciantes sempre falam sobre essa ruína, e dizem que deve ter bons tesouros, já que a aparência parece tão magnífica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Eles até dizem que esses pilares e aquela ruína foram construídos pelos antepassados de Liyue a fim de acabar com os conflitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Mas lenda é lenda, se esses novo pilares de pedra tivessem conseguido suprimir a guerra, o mundo teria sido pacificado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Não importa se essas lendas sejam verdadeiras ou falsas, esse anel foi encontrado nessa ruína, portanto, deve ter a ver com essas lendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Tem um nome, uma história para acompanhar, e também é de boa qualidade. Deve valer um bom preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "... Relaxe, não vou perguntar como você entrou aí. Eu apenas faço negócios. Outros assuntos não são da minha conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Enfim, esse anel... Eu pago <color=#00E1FFFF>200 mil Mora</color>, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
