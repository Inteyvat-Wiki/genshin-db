			"dialogs": [
				{
					"id": 710050401,
					"content": "Temos um acordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "#Maravilhoso! Bem decisiv{M#o}{F#a}. Aqui está o dinheiro, é todo seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Ah, este anel é um verdadeiro tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Deve haver algumas outras preciosidades similares nessas ruínas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
