					"nextDialogs": [
						210340604
					]
				},
				{
					"id": 210340604,
					"content": "Eram apenas alguns monstros comuns. Não precisou muito esforço. Uma pena, não encontrei nada de valioso. Apenas lixo por aqui.",
					"roleType": "TALK_ROLE_NPC",
