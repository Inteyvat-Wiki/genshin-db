					"content": "E então, como foi? Você derrotou os monstros do seu lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "Os monstros daqui... Você já derrotou todos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Hã? Mas é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Digo, sou a presidente da Guilda de Aventureiros de Liyue. Lidar com monstros é algo bem normal para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
