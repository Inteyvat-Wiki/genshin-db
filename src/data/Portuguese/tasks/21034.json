						210340605
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340605,
					"content": "Como foi do seu lado? Você encontrou algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340606
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340606,
					"content": "Encontrei isto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Hã... Isso parece ser um pedaço de uma espada... Obrigada. Levarei de volta comigo e darei uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340608
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340608,
					"content": "Obrigada, Viajante. Aqui está seu pagamento. Por favor, aceite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
