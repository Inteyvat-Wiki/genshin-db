			"dialogs": [
				{
					"id": 220220401,
					"content": "Em Liyue, há um prato chamado Sopa de Bambu. Dizem que ele é muito delicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220402
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220402,
					"content": "Xudong... Ele também mudou esse daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220403
					],
