			"dialogs": [
				{
					"id": 220220201,
					"content": "Em Mondstadt há um prato chamado Ensopado de Maçã do Norte mas Xudong rabiscou bastante na receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "\"A manteiga é bastante cara e a carne crua é difícil de conservar. A melhor coisa a fazer seria amassá-lo, retirar o glúten, vaporizá-lo e colocar frutas e vegetais para obter a textura da carne\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Este homem! A manteiga não é cara e a carne você pode ir comprar na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "Deixa para lá... Viajante, o que eu quero perguntar é \"além de maçãs, manteiga e carne crua, o que mais há no Ensopado de Maçã do Norte\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Amêndoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Uh... Assim? Vou anotar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Pimenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Uh... Assim? Vou anotar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Pimenta de Jueyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Presunto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
