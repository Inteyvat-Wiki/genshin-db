			"dialogs": [
				{
					"id": 220220301,
					"content": "Há um prato famoso chamado Carne de Tianshu em Liyue, vamos ver... Uh, Xudong tomou notas de algo aqui também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "\"Cozinhe no vapor as batatas descascadas, amasse ainda quente, ponha azeite e sal. Em seguida, coloque em uma tigela e despeje um molho grosso por cima. A primeira mordida é como uma carne macia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "A primeira mordida... isso significa que você pode distinguir depois de mais algumas mordidas? Vamos lá, isso só vai enganar aqueles que nunca comeram Carne de Tianshu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "Esqueça... Viajante, o que eu quero perguntar é: \"além de Carne Crua, Açúcar e Matsutake, o que mais tem na Carne de Tianshu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
						220220306,
						220220308,
						220220309
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220305,
					"content": "Violeta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220310,
					"content": "Uh... Assim? Vou anotar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220306,
					"content": "Qingxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220307
					]
				},
				{
					"id": 220220307,
					"content": "Uh... Assim? Vou anotar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
