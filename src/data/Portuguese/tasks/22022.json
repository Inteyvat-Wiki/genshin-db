					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Esta receita deve ser assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Estamos organizando essas receitas. Mas algumas delas não estão bem registradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Por que não pergunta a Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Xudong ... Ele e seus \"pratos criativos\" são o principal motivo pelo qual não consigo me lembrar deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Cada vez que ele consegue uma nova receita, ele só a segue por um ou dois dias, no máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Depois, ele... usa várias maneiras para melhorá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Por que ele faria isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Segundo ele, é para torná-los mais baratos... Mas não sei bem por que ele fez tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Com base no resultado, todos seus pratos foram bem modificados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Os modificados e os originais possuem o mesmo sabor, mas os anteriores saíram muito mais baratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "Eu ando com ele por causa das suas técnicas de culinária exageradas, e a razão pela qual ele me aceitou devia ser por causa das minhas técnicas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Então em que posso ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Ah sim! Com todas as conversas sobre o Xudong, quase me esqueci de te dizer a coisa mais importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Como Xudong está sempre mudando as receitas e escrevendo e rabiscando nelas... Eu não entendo mais o que diz sobre algumas delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "A fim de ter uma comparação mais rigorosa, quero recuperar a versão original dessas receitas e fazer uma cópia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "Viajante, se você ainda se lembra deles, poderia me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Muito obrigada! Vou organizar estas receitas primeiro, e depois você pode me ajudar a corrigir as que não estão claras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "Claro. Viajei e comi por todo Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Sua técnica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Eu te contei que o tema da minha investigação na Academia é o Tempero Multiúso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Basicamente é um tempero que torna qualquer prato super delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "Para conseguir fazer tal tempero, viajei por todo os lugares para reunir informações gastronômicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Bem, chega de conversa fiada, vamos voltar logo a falar sobre receitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Como exatamente ele as melhoraria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Hum... Suas variações não são como as de outros chefs. Normalmente, quando uma receita é modificada, ela é feita para torná-la mais variada e para aumentar o preço do prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Mas quando o Xudong modifica as receitas, parece que ele tem suas próprias ideias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Por exemplo, ele usa ingredientes baratos como Batatas, Cogumelos e outros para fazer um prato de legumes... Mas o sabor que sai fica ótimo, foi como se fosse o sabor do Frango de Pimenta de Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "E a versão simples de Tentação de Adeptus feita com batatas, arroz, cabeças de Lótus, Pimenta de Jueyun, farinha e carne possuía o mesmo sabor que a original...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Espere. Vocês não são Os Supremos Gourmet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Por favor, não mencione esse nome novamente. Essas palavras nunca vão aparecer na minha tese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "Além disso, Xudong e seus \"pratos criativos\" são a principal razão pela qual não consigo me lembrar dessas receitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
