			"dialogs": [
				{
					"id": 742480201,
					"content": "Esse jogo da \"Trupe de Mesa\" é realmente muito divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 742480202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480204,
					"content": "É. Acho que a vampirozinha terrível e malvada também deveria ir para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 742480203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
