			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111401,
					"content": "Edna! Nós nos livrámos no meteorito atrás da montanha. Os doentes recuperaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111402,
					"content": "Graças a vocês, há pouco, dois doentes acordaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111403
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111403,
					"content": "Estou com sono... *Bocejo*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111404
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111404,
					"content": "Incrível! Parece ter funcionado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111405,
					"content": "Se conseguirmos nos livrar todos os <color=#00E1FFFF>meteoritos</color> nos arredores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111406
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111406,
					"content": "Todos irão despertar de seus sonhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111407
					]
				},
				{
					"id": 411111407,
					"content": "Ah! Que notícia boa, ela alegra o coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111408
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111408,
					"content": "Hehehe... É muito gratificante, de fato. No entanto, a notícia de que eu estaria atenta a este assunto pessoalmente era certamente a única garantia de que meus fiéis súditos alguma vez precisariam de um resultado feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111409
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111409,
					"content": "Senhor, você acordou agora? O que você viu em seus sonhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111410,
					"content": "Me lembro do frio e de andar pelos caminhos da montanha... Deveria ser uma <color=#00E1FFFF>montanha de neve</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111411
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111411,
					"content": "Andar pelos caminhos da montanha? Sem um destino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111412,
					"content": "Hmm, também não sei. Parecia não ter controle sobre mim mesmo em meu sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111413
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111413,
					"content": "É certamente uma maldição. Oh, quão infeliz é essa terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111414
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111414,
					"content": "(Maldição? É sério?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111415
					]
				},
				{
					"id": 411111415,
					"content": "Bom, não importa. O que importa é que derrotar os meteoritos tem efeito. Parece que precisamos nos esforçar mais ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4111115,
