				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "Ah! Eu pensei que morreria aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111702,
					"content": "Seu idiota! O que você estava pensando, vagabundeando por aí por conta própria em um momento como este!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111703,
					"content": "Eu errei! Não volto a fazê-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 411111704,
					"content": "Me desculpem. Allan causou muitos problemas, eu vou me assegurar que ele aprenda uma lição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111705,
					"content": "A próxima vez, pense melhor antes de agir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111706,
					"content": "O meteorito está ali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "Vou ver o que está acontecendo aí...? A sua <color=#00E1FFFF>Visão</color> está <color=#00E1FFFF>brilhando</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111708,
					"content": "Oh? Será que, por acaso, a minha Gema das Trevas pressente o fim certo desta maldição profana do frio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111709,
					"content": "Talvez...? Sua Visão reage ao que exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111710,
					"content": "Aos enigmas mais profundos... Os segredos sussurrados das estrelas... Azarações profanas dos ossos de demônios, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111711,
					"content": "O quê? Por que você sempre tem que falar desse jeito tão engraçado? Paimon não entende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111712,
					"content": "Peço desculpas, minha Princesa não é bem versada na língua do povo comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111713,
					"content": "Então ela depende de você para traduzir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111714,
					"content": "Creio que você não entendeu. Não sou um tradutor, apenas um transmissor da intenção da Princesa. Eu temo que a <color=#00E1FFFF>Visão</color> dela esteja reagindo à <color=#00E1FFFF>Energia Elemental</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111715,
					"content": "Obrigada, Oz. Aqueles com a mente cheia das questões mundanas deste mundo são incapazes de entender meu intento nobre como você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111716,
					"content": "Então, tem energia elemental nos meteoritos? E a sua Visão brilha, reagindo ao chamado da energia elemental?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111717,
					"content": "Será que a Visão consegue procurar a energia elemental na direção oposta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "Creio que... Irá funcionar? Que tal usarmos a <color=#00E1FFFF>Visão</color> para procurar as <color=#00E1FFFF>peças de meteoritos</color> e limpá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111718,
					"content": "Será que isso pode acontecer nas duas direções?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
