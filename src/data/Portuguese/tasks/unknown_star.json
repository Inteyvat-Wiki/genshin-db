			},
			"dialogs": [
				{
					"id": 411111501,
					"content": "Aqui tem outra vítima caída!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111502,
					"content": "Cavaleiro, responda às minhas questões. Que tragédia se abateu sobre esse infeliz homem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111503
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111503,
					"content": "Hmm... Ele... Ele dormiu durante todo o dia e não parece que irá acordar cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111504,
						411111506
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111504,
					"content": "O motivo foi ter tocado em um meteorito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111505
					]
				},
				{
					"id": 411111505,
					"content": "Sim. Está dormindo profundamente e falando em seus sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111508,
					"content": "Não aguento mais. É sério. Preciso descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111509
					],
					"speakerTitle": "Adler"
				},
				{
					"id": 411111509,
					"content": "O que-O que ele está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111510,
					"content": "Seu sonho obscuro esconde o fruto proibido, preso entre as mandíbulas de uma fera. Seus olhos negros como uma noite sem luar seduzem os fracos e os levam até ao abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111511
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111511,
					"content": "Isso significa que tem algo atraindo ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111512,
					"content": "Mesmo sem provas, a intuição da Princesa nunca falha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111513
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111513,
					"content": "Hmm... É melhor continuar a investigar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111506,
					"content": "Além de dormir, tem outros sintomas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111507
					]
				},
				{
					"id": 411111507,
					"content": "Por enquanto, não. Mas por vezes ele fala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111508
					],
					"speakerTitle": "Adler"
				}
			]
		},
		{
			"id": 4111116,
			"completionStepIds": [
				4111116
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
