			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411111601,
					"content": "Oi. Eu sou a Irmã Edna, sou responsável por cuidar dos doentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111602
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111602,
					"content": "Diga seu nome logo, vil criatura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111603
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111603,
					"content": "Me desculpe, a Princesa não está falando de você. Esse senhor aí deitado no chão... Ele falou algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111604
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111604,
					"content": "Acho que ele falou que quer voltar ao seu trabalho, ou algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111605
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111605,
					"content": "Ah... Vinho, o vinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111606
					],
					"speakerTitle": "Hartman"
				},
				{
					"id": 411111606,
					"content": "O trabalho dele é relacionado com vinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111607
					]
				},
				{
					"id": 411111607,
					"content": "Ele parece dormir profundamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111608
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411111608,
					"content": "Isso não é um sonho comum... É uma maldição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111609
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111609,
					"content": "Podemos acordar ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111610,
					"content": "Eu já tentei. Ele acordou por um momento, mas passado pouco tempo, adormeceu novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111611
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111611,
					"content": "Ele revelou alguma informação enquanto esteve acordado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111612,
					"content": "Ele disse que em seu sonho ele estava caminhando em uma montanha e estava muito frio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111613
					],
					"speakerTitle": "Edna"
				},
				{
					"id": 411111613,
					"content": "Montanha? Frio? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111614,
					"content": "Será que é uma maldição de um demônio da montanha de neve... Esse Vale Termal guardado pelas Fadas da Fonte agora se tornou alvo dos demônios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111615
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111615,
					"content": "A situação é bem grave, mas não tenham medo, irei fazer a condenação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111616
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411111616,
					"content": "Peço desculpa pelo incômodo, vocês têm tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111617,
					"content": "É o Sr. Draff! O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111618,
					"content": "Hmm, nem sei bem como falar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111619,
					"content": "Há uns <color=#00E1FFFF>meteoritos</color> nas <color=#00E1FFFF>montanhas por trás da vila</color>, e o <color=#00E1FFFF>Allan</color> quis dar uma olhada e fugiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111620,
					"content": "Você já sabe o quão perigosos são os meteoritos, e estou preocupado com ele. Portanto, eu gostaria de pedir a sua ajuda para buscá-lo na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111621,
					"content": "Espera aí, então... Grandes rochas em chamas caem do céu e tudo que o Allan está preocupado é em perder toda a ação!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411111622,
					"content": "Exatamente! Uma vez que recuperarmos aquele canalha em segurança, ele vai ser repreendido pela vida inteira, se é que você quer saber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111623
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 411111623,
					"content": "Paimon também concorda! Vamos buscar ele!",
