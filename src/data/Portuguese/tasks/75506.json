				]
			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#Xilonen? {NICKNAME}, Paimon, vocês também? Olá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060202,
					"content": "Ororon! O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060203,
					"content": "Você se recuperou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "Obrigado pela sua preocupação. A vovó passou alguns dias enfiando umas coisas amargas na minha garganta e me forçando a descansar. Estou bem melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060205,
					"content": "Ei, Ororon! Você veio ajudar Xilonen a pegar Afídios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060206,
					"content": "Afídios? Oh, então foram vocês que sequestram 100% Doce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060207,
					"content": "Não surpreende Doçura Extrema e Doce Incomum também terem desaparecido... foram vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060208,
					"content": "Hã... isso são os nomes dos Afídios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060209,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060210,
					"content": "É mais fácil de distinguir eles. Não avalio eles, mas ainda assim, são fantásticos, mesmo que não produzam mel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060211,
					"content": "Então... você que criou esses Afídios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060212,
					"content": "Na verdade, eu não faço muito pra interferir nos comportamentos naturais deles. Por coincidência, vivemos no mesmo território. É um tipo de relação em que nos damos bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060213,
					"content": "Hã, sinto muito, eu não sabia. Mas eles haviam sido contaminados pelo Abismo, e isso estava afetando a tribo, por isso tivemos que lidar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060214,
					"content": "Sim, isso mesmo! E não ferimos eles também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060215,
					"content": "Mesmo? Isso é ótimo. Ainda assim, não precisam se preocupar. Na verdade, eu também vim aqui para lidar com esse problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060216,
					"content": "Mas, tenho que deixar algo claro. Os Afídios não foram contaminados pelo Abismo. Eles são criaturinhas espertas que escolhem comer a energia Abissal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060217,
					"content": "É o quê?! Eles escolhem comer?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060218,
					"content": "Exato. Eles comem de pouco em pouco. Isso é suficiente para seus corpos expandirem, mas não vai matá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060219,
					"content": "Depois de um tempo, eles voam para algum local distante e criam Pérolas de Mel de Flogisto que envolvem a contaminação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060220,
					"content": "A casca externa da Pérola age como uma barreira contra a contaminação. Dessa forma, eles podem aos poucos retirarem a energia Abissal de sua casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060221,
					"content": "O processo precisa ser repetido várias vezes, mas eles são insetos pacientes. Mesmo que os Afídios sejam movidos, não tem problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060222,
					"content": "Oh, então eles estão protegendo sua casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060223,
					"content": "Primeira vez que escuto falar nisso. Então eles sabem que a terra está sendo invadida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060224,
					"content": "Sim, 100% Doce e os demais estiveram lutando bastante! Eles são Afídios incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060225,
					"content": "Bem, parece que Natlan é realmente a nação da guerra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "Mas, Ororon, como você encontrou esse lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060227,
					"content": "Oh, é porque eu dei algumas sementes de Fruta Atordoadora para eles. Eles não podem digeri-las, por isso não demora muito até as liberarem através de suas excreções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060228,
					"content": "Depois que as sementes caem no chão, crescem rapidamente em arbustos frutíferos. Se eu seguir os arbustos, posso encontrá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060229,
					"content": "Então, pego as Pérolas de Mel que eles produziram e me livro delas, e então trago mais Frutas Atordoadoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060230,
					"content": "Mas parece que vocês já fizeram isso por mim, e não os machucaram no processo. Estou muito agradecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060231,
					"content": "Então foi isso que tava rolando com as Frutas Atordoadoras! Paimon tava fazendo o cérebro dela trabalhar tentando descobrir se tinha alguma coisa por trás disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060232,
					"content": "Hã? Paimon causou algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060233,
					"content": "Não, claro que não! Só relaxem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060234,
					"content": "Ororon, fique tranquilo que vamos devolver todos os Afídios para você como estavam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060235,
					"content": "Isso seria ótimo! Eles são seres vivos muito importantes, e devem ser bem tratados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060236
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060236,
					"content": "Bem, já que todos os problemas foram resolvidos, vejo vocês depois! Fiquem à vontade para me visitarem na próxima vez, vou levar vocês para conhecerem uns bons amigos meus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060237
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 755060237,
					"content": "#Estou ansios{F#a}{M#o} para isso. Até a próxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060238
					]
				},
				{
					"id": 755060238,
					"content": "Ufa! Nunca imaginei que a situação chegaria a esse ponto. Ororon é realmente surpreendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060239
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060239,
					"content": "#E obrigada a vocês {F#duas}{M#dois}. Sem vocês, essa correria teria sido um tédio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060240
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060240,
					"content": "Aqui, para vocês. É uma Pérola de Mel de Flogisto não contaminada. Não se preocupe, não vale nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060241
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060241,
					"content": "Só pensem nela como uma lembrança, algo para lembrar esses guerreirinhos que lutam por Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		}
	]
}