			"dialogs": [
				{
					"id": 755060101,
					"content": "Hehe, vocês vieram. Esse foi o último lugar que os Afídios Abissais foram avistados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060102,
					"content": "Então, a gente encerra isso se pegar os daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060103,
					"content": "Sim. Mesmo que uns escapem, não é nada de mais. Vou depois lidar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060104,
					"content": "Eu ouvi da tribo que os pacientes melhoraram bastante nos últimos dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060105,
					"content": "Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060106,
					"content": "Ainda assim, você errou, Paimon. Sua teoria da conspiração era só teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060107,
					"content": "Parece que essas frutinhas crescem naturalmente onde os Afídios costumam se reunir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060108,
					"content": "Hã... Paimon nunca imaginou que algum Fatui... ou um Ladrão de Tesouro... ou outro tipo de mente ia tá nos bastidores puxando umas cordinhas... Paimon tava só sendo cautelosa, como qualquer guia decente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060109,
					"content": "Você sempre será cautelosa, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "Hehe, é óbvio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755060111,
					"content": "Certo, vamos logo terminar tudo por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755060112,
					"content": "Certo, Esquadrão Caça-Insetos, hora da batalha final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
