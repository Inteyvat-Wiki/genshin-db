				]
			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "Jahoda? E... Sr. Zompaynco. O que traz vocês aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "Eu...Uhh...sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260103,
					"content": "Ele quer passear nos Filhos da Lua Gelada, mas está com vergonha de dizer isso, então ele está pedindo sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "Sim! Sim, é exatamente isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260105,
					"content": "S–Saudações, Srta. Lyylikki! É um grande prazer conhecê-la. Hmm... Eu trouxe este fóssil de Natlan comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260106,
					"content": "Obrigada, mas Sr. Zompaynco... hmm... Nós já nos conhecemos, não foi? Você realmente não precisa ser tão formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "Hã? Então... como foi que você me notou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260108,
					"content": "Você sempre esteve lá quando eu estava distribuindo as refeições, não é? Andando pela fila, indo e voltando, mas nunca entrando de fato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Pensei que talvez você quisesse uma porção, mas tivesse vergonha de pedir, então eu deixava uma separada para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Mas você nunca apareceu para pegar. Na verdade, como você não veio hoje, eu ia pedir para alguém verificar se você precisava de ajuda ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Ah... E—eu sinto muito. Eu estava hesitando, tentando descobrir como dizer olá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260112,
					"content": "Então, Srta. Lyylikki... seria possível eu visitar os Filhos da Lua Gelada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260113,
					"content": "Claro. Já recebemos alguns convidados de fora antes. Mas posso perguntar por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Gostaria de tirar algumas fotos e fazer anotações, dar uma olhada em alguns registros e, se possível... perguntar a alguém sobre as lendas locais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260115,
					"content": "Sou membro da Associação de Relíquias Saurianas de Natlan. Se eu pudesse encontrar materiais relacionados à minha pesquisa, isso seria inestimável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260116,
					"content": "Entendo... então você espera passar algum tempo nos arquivos, certo? Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Bem, agora que vocês estão se divertindo conversando, eu vou considerar essa comissão concluída. Devo voltar e relatar isso à minha chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "Obrigado, Srta. Jahoda! Mas... eu realmente devo te pagar pelo seu trabalho — seria errado fazer você viajar até aqui à toa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260119,
					"content": "E, por favor, não se esqueça de comunicar minha gratidão à Chefe Nefer quando você voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260120,
					"content": "Claro. Vou me retirar agora. Aproveitem sua conversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
