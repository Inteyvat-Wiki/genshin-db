				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "Ah... Jahoda? O que te traz aqui? Hum... A Chefe Nefer está disponível agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260202,
					"content": "(Assim como imaginei, ele quer ver a Chefe Nef... Hum, é um assunto tão simples que eu mesma posso resolver.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "Não precisa se preocupar. A chefe me enviou para te ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "Hã? O—O que você quer dizer? Isso significa que a Chefe Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260205,
					"content": "Você sempre quis visitar os Filhos da Lua Gelada, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Então, você quer primeiro se dar bem com Lyylikki, e então pedir a ela para te levar até os Filhos da Lua Gelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "O quê!? A Srta. Nefer sabia sobre isso o tempo todo? Mas eu guardei isso no meu coração e quase não contei para ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260208,
					"content": "(É hora de dizer aquela frase super legal! Qual era mesmo aquela frase super legal que a Chefe Nef disse... Oh!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Hehe, Sr. Zompaynco, quando você guarda um segredo, você também deve aprender a esconder o fato de que está guardando um segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "Caso contrário, não importa quão alta seja a muralha que você erga em seu coração, mais cedo ou mais tarde o vento encontrará suas rachaduras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "*Suspiro* Eu nunca fui bom em guardar meus sentimentos, mesmo quando ainda estava na minha cidade natal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260212,
					"content": "(Eu disse! Todo aquele treino valeu a pena, hehehehe!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Bem, agora que você sabe, poderia me ajudar a fazer uma apresentação? Sou um forasteiro, e não quero incomodar a Srta. Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260214,
					"content": "Não se preocupe, Lyylikki é muito gentil. Não importa se o visitante é de fora da cidade ou até mesmo não é bem humano, ela o tratará com gentileza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "Hã? É mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260216,
					"content": "Mas mesmo assim, entrar sem avisar é um pouco indelicado... Hum, se você por acaso a conhece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260217,
					"content": "Claro que conheço! Eles devem ter acabado de distribuir as refeições, vamos até lá agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "A propósito, a chefe também disse que não terá cobrança desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "Oh, muito obrigado! Eu vou pegar minhas coisas imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		}
	]
}