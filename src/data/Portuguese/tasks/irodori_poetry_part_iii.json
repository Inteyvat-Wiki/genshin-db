				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "Muito bem, então, como estão ficando as fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930202,
					"content": "Aqui estão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "Obrigado, muito obrigado. Ah, agora sim, finalmente poderei escrever um poema satisfatório. Agora, deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930204,
					"content": "Aqui está meu rascunho, escrito baseado nas fotos que você trouxe. Por que você não escolhe quais versos deveríamos usar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
