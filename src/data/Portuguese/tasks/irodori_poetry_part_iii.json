					"nextDialogs": [
						726930903
					]
				},
				{
					"id": 726930903,
					"content": "Desculpe te incomodar. O que precisamos hoje são fotos de <color=#00E1FFFF>especialidades regionais de Mondstadt</color>. Assim como antes, umas <color=#00E1FFFF>4 fotos</color> vão servir.",
					"roleType": "TALK_ROLE_NPC",
