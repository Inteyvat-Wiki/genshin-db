			"dialogs": [
				{
					"id": 726930401,
					"content": "Fazer a conexão de uma flor com amantes é algo comum em todas as nações, e esta sentença compara ver as paisagens de Inazuma com o sentimento do primeiro amor.",
					"roleType": "TALK_ROLE_NPC",
