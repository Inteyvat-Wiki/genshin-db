			},
			"dialogs": [
				{
					"id": 726930501,
					"content": "A fruta selvagem descrita aqui deve estar fazendo referência a algumas experiências dolorosas. Não é apenas uma recordação feliz, como experimentar álcool ou ler um poema pela primeira vez. Mas de qualquer forma, é uma impressão marcante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269306,
			"completionStepIds": [
				7269305
