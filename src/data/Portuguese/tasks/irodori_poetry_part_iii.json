				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "Ah, você está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "Lenne escreveu sobre nosso arrependimento de não termos nos conhecido mais cedo, hoje. Portanto, eu gostaria de presenteá-lo com um poema também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "Haha, é uma honra aceitar tal presente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Embora eu já seja velho, depois ter feitos novos amigos de Mondstadt nos últimos dias, me interessei bastante pelo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "Para este poema, eu escrevi de forma a imitar os estilos dos bardos de Mondstadt, e em alguns versos também menciono algumas de suas paisagens mais emblemáticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "Infelizmente, eu nunca estive em Mondstadt... Mas você poderia me ajudar e tirar algumas fotos de <color=#00E1FFFF>especialidades regionais de Mondstadt</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Haha, neste caso, conto com você. Assim como das outras vezes, 4 fotos serão suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
