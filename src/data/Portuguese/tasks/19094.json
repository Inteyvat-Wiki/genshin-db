			"dialogs": [
				{
					"id": 190940701,
					"content": "...Kaeya é uma pessoa difícil de se lidar, mas vinho de graça sempre é o mais delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940702,
					"content": "Você sempre pode recusar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "Ah, não tem problema. Quero dizer, os hinos dos corais da igreja não são meu ponto fonte, com todas aquelas formalidades e tal... Mas se houver amor pela música, tenho certeza que vou conseguir ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940704,
					"content": "Parece que, na verdade, vai dar muito trabalho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "Ei, se eu estou feliz, e a Irmã Grace também, e a plateia também, é ótimo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 190940705,
					"content": "Você não está fazendo isso apenas pelo vinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
