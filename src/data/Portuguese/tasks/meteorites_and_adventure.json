				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "*Suspiro*... Se eu pudesse ir dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ah, é você. No final não aconteceu nada de especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Uh, na verdade sim, algo bem especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Os meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Sim, vá dar uma olhada, os meteoritos não param de cair do céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Graças a proteção do Arconte Anemo, ou talvez apenas por sorte, nenhum dos meteoritos atingiu a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Mas muitos meteoritos caíram fora da cidade e, alegadamente... Quem tocou meteoritos entrou num sono profundo, e nunca mais acordou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "O senhor Cyrus já publicou um anúncio para convocar mais aventureiros, para informar aqueles que ainda estão fora da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Outra parte é para ajudar os Cavaleiros de Favonius a localizar todos os pontos de queda dos meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Depois, realizar operações de busca e resgate ao redor daqueles meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Por minha vez, o senhor Cyrus diz que é melhor ficar dentro da cidade para cuidar as pessoas em sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Talvez as minhas habilidades ainda sejam insuficientes... Eu sempre assumo tarefas pequenas, não tenho muita chance de me melhorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "*Suspiro* De qualquer forma, eu tenho que fazer bem o meu trabalho... Mas Viajante, posso pedir um favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "Eu gostaria de pedir um favor que você procure mais informações sobre meteoritos na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "Por que você está precisando dessa informação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "O senhor Cyrus sempre diz: antes da aventura, é necessário estar com tudo preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Se eu puder convencer o Cyrus que eu já sei muito bem a situação, e já estou bem preparado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Talvez ele me deixe juntar-se as equipes de investigação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Mas agora ainda estou ocupado em cuidar das pessoas, não tenho como ir lá fora para recolher mais informações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "Então, muito obrigado, viajante. Por favor vá para fora da cidade fazer a investigação. Basta só ir ao Bosque Sussurrante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Se você encontrar mais informações, por favor venha me contar! Depende muito de você se eu vou conseguir me juntar às investigações de campo ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Então você quer sair escondido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Ah? Sair escondido...? De jeito nenhum! De maneira alguma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Embora eu queira muito investigar fora da cidade... Também precisam da gente na cidade... Você sabe, né, os assuntos dentro da cidade também são importantes! Eu tenho que ficar no meu posto de trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "Sim! É verdade. Como o senhor Cyrus sempre diz: antes da aventura, é necessário estar com tudo preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Se eu puder convencer o Cyrus que eu já sei muito bem a situação, e já estou bem preparado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Talvez ele me deixe juntar-se as equipes de investigação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Mas agora ainda estou ocupado em cuidar das pessoas, não tenho como ir lá fora para recolher mais informações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "Você quer dizer o desconto na metade do preço no Caçador de Cervos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "O quê? Como eu não sabia disso? O Caçador de Cervos tem um evento hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Ah! Não, não... O que eu deveria ter dito não era isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Dê uma olhada, não para de chover meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250112,
					"content": "Graças a proteção do Arconte Anemo, ou talvez apenas por sorte, nenhum dos meteoritos atingiu a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				}
			]
		},
