			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pallad Imprudente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250201,
					"content": "Acho que os assustei. Ainda assim, o que é que está acontecendo aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250202
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250202,
					"content": "Você veio investigar os meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Sim. Eu recebi mais missões da Guilda, para investigar o assunto de meteoritos na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250204,
					"content": "Mas é curioso, não sei por que os monstros que estavam perto dos meteoritos caídos se tornaram peculiares de repente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250205,
					"content": "A força de ataque, status de movimento e entre outros, são totalmente anormais, além disso, o número aumentou bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250206,
					"content": "Eu fui descoberto por eles, não queria ficar lá por mais tempo, portanto, peguei outro caminho para tirá-los do meu rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250207,
					"content": "Tenho que relatar essas anormalidades a Cyrus o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250208,
					"content": "Há algo mais que deva ser mencionado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Algo mais? Bem, se eu tivesse que dizer isso, é que alguns estudiosos estão se recusando a voltar para a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250210,
					"content": "Por mais que eu tentasse convencê-los, eles insistiam em continuar suas pesquisas na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250211,
					"content": "Não há aventureiros suficientes aqui também, então não podemos simplesmente informá-los cada poucos dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250212,
					"content": "Que dor de cabeça terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 411250213,
					"content": "Bom, viajante! Se não tiver assuntos urgentes, é melhor voltar para a cidade. Agora é perigoso ficar fora dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad Imprudente"
				}
			]
