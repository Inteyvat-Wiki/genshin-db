			"dialogs": [
				{
					"id": 750150501,
					"content": "Ufa, finalmente limpo... Paimon acha que é hora de começar a pescar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150502,
					"content": "Só espera um pouco, Paimon vai pegar um grandão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150503,
					"content": "Infelizmente, a superfície fica tão parada quanto um espelho, sem nenhuma onda à vista.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "Hmm... Tem alguma coisa errada com a água aqui? Os peixes não parecem querer sair dela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150505,
					"content": "Tão perto, hehe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "Tão perto! Porém... tão longe. Urg, por que parece que isso vai demorar uma eternidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150507,
					"content": "É um pouco cedo para dar esperanças a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "Você consegue! Você consegue!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Ei, pare de ser uma distração... caramba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Hããã!? Temos uma mordida, temos uma mordida! Hora de puxar e ver o que Paimon pegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Mas o quê... isso não é um peixe, é uma garrafa! E está até amarrada a uma das tábuas no local de pesca... Urg, bem, o fato que {NICKNAME} sempre está pegando coisas estranhas também deixa Paimon se sentindo um pouco melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "Você parece conseguir pegar qualquer coisa... menos peixe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "Ei, você pega coisas estranhas o tempo todo também! Enfim, já que Paimon já pegou, custa nada dar uma olhadinha no que tem dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Poderia ser aqueles dois que deixaram para trás aquela pilha de coisas agora pouco? Pessoas que são assim tão obcecadas em pescar são... bem assustadoras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "Parece que eles estão usando essa garrafa para enviar mensagens um ao outro... é melhor jogarmos de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "Eeeenfim, Paimon tem a sensação de que definitivamente será um peixe da próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "De repente, a vara é puxada para baixo e começa a ser violentamente arrastada.\\nParece que algo grande e pesado bem nas profundezas mordeu a isca.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Uma mordida, finalmente! Deve ser um peixão... Pode vir, grandalhão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Isso mesmo, seu grandalhão! Pode vir chegando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "R-Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Vendo Paimon sofrendo,\\nvocê e {REALNAME[ID(2)|SHOWHOST(true)]} seguram ela...\\nmas a linha está sendo puxada com uma força imparável...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "Finalmente, com um estouro repentino, o peixe escapa...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "*Snif* Deve ter sido um peixe imenso, caso contrário jamais teria fugido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
					"content": "Urg, que irritante... Hã? Ainda está nadando perto da superfície! Que piada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "Rawrr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "Não, não, não, o mar é muito perigoso! E você nunca vai alcançar ele mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150531,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#Se pelo menos pudéssemos encontrar uma forma de pegar aquele peixe, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150508,
					"content": "Não vai demorar muito, confia em mim! Só fica tranquila!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
					"id": 750150509,
					"content": "Hmm, você provavelmente tem razão. Afinal, quando as mordidas começarem a aparecer, acontece tudo tão rápido. Igual quando você vai colher uma Flor Doce, mas no fim das contas era uma Flor Gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150510,
					"content": "Tudo que você precisa fazer é ficar focado e esperar... e esperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
