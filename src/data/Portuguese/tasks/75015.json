			"dialogs": [
				{
					"id": 750150401,
					"content": "#Ta-dá! O que Paimon te falou? Se alguém ia conseguir pegar esse escorregadio, seria {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150402,
					"content": "Falando em habilidades, se só jogássemos todas as iscas e deixássemos os peixes ficarem tão cheios que eles se virariam e flutuariam para a superfície... isso ainda ia contar como \"pesca\", certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150403,
					"content": "Rarrrr... Rawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#Então {REALNAME[ID(2)|SHOWHOST(true)]} também acha? Paimon pode perceber do jeito que seus olhos brilham! Hehe, vamos tentar de novo da próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150405,
					"content": "Rawrrrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#Espera um segundo, ainda não acabou! Temos que esperar {NICKNAME} terminar de cozinhar primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "Quando o peixe termina de grelhar, todos se sentam e comem juntos.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "Aah... No quesito Peixe Grelhado, esse foi especial. Você consegue mesmo perceber que foi Paimon que pescou ele, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150410,
					"content": "Ótimo trabalho, Paimon! Você está encarregada de pescar a partir de agora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "Hmmm... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150412,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#Ei, não tem nada de graça por aí, sabia, {REALNAME[ID(2)|SHOWHOST(true)]}! Você também vai ter que ajudar da próxima vez — se quiser algum peixe, claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150414,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "Hunf, olha quem tá se fazendo de besta agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
