			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "Então um ser transcendente vive aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070102,
					"content": "Brr... Se alguém vive aqui, então por que está tão frio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070103,
					"content": "Hmm... Estou me fazendo a mesma pergunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070104,
					"content": "Que estranho, tenho certeza de que este é o local sobre o qual minha mãe escreveu, mas... Certamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070105,
					"content": "#Talvez estejamos enganad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "Hmm... Isto está me fazendo ter dúvidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070108,
					"content": "Mas, já que estamos aqui, ainda acho que devemos entrar e explorar por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070109,
					"content": "Sim, faz sentido. Quem sabe, talvez haja uma surpresa esperando lá dentro por nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070110,
					"content": "Então, um... O que diz o caderno, exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070111,
					"content": "Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070112,
					"content": "\"Uma garça traz <color=#00E1FFFF>1</color> flor fresca em seu bico para decorar meu cabelo, enquanto um coelho branco costura uma bainha de <color=#00E1FFFF>4</color> raios do luar. Vestida apropriadamente, eu viro para o <color=#00E1FFFF>leste</color> e chamo pelo nome da Tsubaki <color=#00E1FFFF>7</color> vezes. Num piscar de olhos, estou de pé no caminho que leva à sua casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070113,
					"content": "Soa como um conto de fadas... Então sua mãe faria um pequeno ritual e, assim, Tsubaki viria ao seu encontro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070114,
					"content": "Na verdade, soa muito como um Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "Tenho a sensação de que poderia ser algum tipo de código...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070116,
					"content": "Vamos dar uma olhada de perto antes de tirar uma conclusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070117,
					"content": "Fico feliz que tenha gostado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070106,
					"content": "Será que Tsubaki realmente é uma Raposa Emissária?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
