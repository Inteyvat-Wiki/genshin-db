			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "Vocês já abriram? Tem alguns tesouros deixados por Adepti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070202,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070203,
					"content": "Hum... É um livro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070204,
					"content": "Parece ser um diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070205,
					"content": "Será que é o diário de Tsubaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070206,
					"content": "Pessoal, vamos sair daqui. O ambiente aqui está bem estranho, e não estou com vontade de abri-lo aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070207,
					"content": "Você tem razão. A luz tão escura também faz mal à visão. Vamos, vamos lê-lo lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200707",
							"2"
						],
						"stepId": 1200707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "Aqui já está bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070302,
					"content": "Vamos dar uma olhada no que está escrito no diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070303,
					"content": "Será que é sobre os tesouros misteriosos, a Paimon está bem ansiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070304,
					"content": "Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "#O que foi? Por que está falando tão baixinh{M#o}{F#a}, isso me deixa ainda mais nervosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070306,
					"content": "Venha comigo, vamos até lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070308,
					"content": "Ohhhh, você quer que a Ayaka leia o diário sem distração. Parece que o que está escrito é importantíssimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070309,
					"content": "Mas com base na sua expressão...Talvez não seja uma pista sobre um tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070310,
					"content": "Hum... Quais informações este diário poderia conter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070312,
					"content": "Hum",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070313,
					"content": "#Viajante, Paimon, desculpe por mantê-l{M#os}{F#as} esperando por tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070314,
					"content": "Não se preocupe. Não foi tanto tempo. Você realmente lê muito rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070315,
					"content": "Você já leu todos os conteúdos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070317,
					"content": "Acho que devo compartilhar a verdade do diário com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070318,
					"content": "Embora o conteúdo seja completamente diferente do que eu esperava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070319,
					"content": "Diferente como? Não foi a Raposa Emissária que escreveu isto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070320,
					"content": "Não. Não foi ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070321,
					"content": "A identidade real de Tsubaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070322,
					"content": "É a minha própria mãe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070323,
					"content": "Ei!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070324,
					"content": "Surpreendida, né? Eu também! Mas... É o que está escrito no início do diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070325,
					"content": "\"Tsubaki e eu somos a mesma pessoa, mas mesmo assim somos diferentes. Quando eu me torno Tsubaki, deixo de ser Kamisato Kayo e me torno a mulher mais comum do mundo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070326,
					"content": "\"O que se segue nestas páginas é a vida comum e cotidiana de uma pessoa comum. Nada mais, nada menos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070327,
					"content": "Este diário é, em sua maior parte, uma coleção de reflexões de minha mãe, tanto privadas quanto triviais. Todas as coisas que pensávamos que eram sobre Tsubaki... Eram de fato sobre a minha mãe mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070328,
					"content": "Então... isso significa que o design do quimono, e os pratos internacionais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070329,
					"content": "São coisas que minha mãe gostaria de experimentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070330,
					"content": "Tenho certeza de que tudo isso parece totalmente bizarro para você, mas para mim, pelo menos, o comportamento dela é completamente compreensível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070331,
					"content": "Ou, dito de outra forma, eu... Na verdade, eu também tenho outro lado meu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070332,
					"content": "Eu estava sem palavras quando comecei a ler o conteúdo do diário. Quase parecia... Como se alguém tivesse olhado dentro da minha mente, examinado meus pensamentos e depois os tivesse escrito todos no papel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070333,
					"content": "Ayaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070334,
					"content": "Desde o momento em que minha mãe se casou com meu pai, ela se tornou a dona da família Kamisato, e com isso vieram todos os tipos de deveres. Ao mesmo tempo, o prestígio da Comissão Yashiro trouxe suas várias responsabilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070335,
					"content": "Além disso, cada ação que ela tomou representa a família Kamisato. As pessoas estavam sempre de olho nela. Sob tais circunstâncias, ela nunca teve muito tempo para fazer as coisas que realmente queria fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070336,
					"content": "Depois que meu pai faleceu, meu irmão e eu assumimos a responsabilidade pelos assuntos da família. Encontramos todo tipo de dificuldades durante esse tempo. Não tenho certeza se as pessoas fora da família poderiam alguma vez imaginar como era.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070337,
					"content": "Toda vez que me encontrava diante de um problema difícil, eu me perguntava: minha mãe também passou por isso? O que ela teria feito nesta situação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070338,
					"content": "Talvez por ter passado tanto tempo desde a última vez que a vi, mas... De alguma forma, tudo o que me restou em minha mente foi o seu lado que inspirou admiração e respeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Mas... minha imagem dela estava incorreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070341,
					"content": "Quando li este diário, percebi... que ela era como eu. Não importa qual posição ela pudesse ter ocupado, ela era apenas uma pessoa comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070342,
					"content": "Ela gostava de quimonos bonitos, queria experimentar comida de diferentes lugares, ansiava ver coisas que nunca tinha visto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070343,
					"content": "Talvez tudo isso pareça imaturo para você, mas... Eu me sinto exatamente da mesma maneira. Eu quero viver a vida não como Kamisato Ayaka, mas como uma mulher comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070344,
					"content": "A mãe escreveu que sempre quis ir a um festival local de Inazuma. Ela disse que às vezes, em uma noite clara, se você olhasse para fora de nossa casa, você podia ver as luzes à distância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070345,
					"content": "Eu também já vi essas luzes! Parece tão animada com tanta gente e é tão brilhante que faz todo o céu iluminado... Claro que, às vezes, me deixa um pouco ansiosa do ponto de vista da ordem pública.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070346,
					"content": "Mas para alguém da minha posição aparecer em um festival sem nenhum aviso, isso poderia ser considerado um comportamento impróprio. Especialmente na geração de meus pais, quando a Comissão Yashiro não tinha um relacionamento particularmente próximo com o povo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070347,
					"content": "Mesmo que ninguém nos impedisse, a ideia da Comissão Yashiro sair para o meio da multidão... Certamente atrairia alguns olhares estranhos. As pessoas provavelmente começariam a pensar que havia problemas à frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070348,
					"content": "A mãe diz que não queria deixar as pessoas nervosas, ela queria que todos desfrutassem da diversão e liberdade do festival... Ela não queria perturbá-los, e não tinha muito tempo livre de qualquer maneira, então ela nunca foi, nem mesmo uma única vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070349,
					"content": "Oh... Então o desenho do quimono, que deve ter sido a roupa que ela planejou usar se ela alguma vez fosse a um festival, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070350,
					"content": "É isso mesmo. E às vezes, nos festivais se vendem comidas internacionais. Ela também queria experimentar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070351,
					"content": "Espero que isto não seja uma coisa desrespeitosa para dizer, mas... Eu nunca soube que minha mãe tinha esse lado tão fofo, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070352,
					"content": "Isso não é de forma alguma desrespeitoso! Paimon acha que sua mãe era a melhor de ambas - fofa por dentro e responsável por fora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070354,
					"content": "Sem saber, acabei concluindo vários dos desejos de minha mãe. Mas ir a um festival é a única coisa que eu não posso fazer por ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070355,
					"content": "Talvez esta seja uma coisa que simplesmente nunca poderá acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070356,
					"content": "Você já conseguiu tantas coisas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Sim, eu entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070359,
					"content": "...Obrigada. Acho que agora percebo algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070360,
					"content": "Minha mãe e eu somos tão parecidas em tantos aspectos. As coisas que ela enfrentou são coisas que eu também vou enfrentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070361,
					"content": "Ela escolheu colocar seus desejos não realizados sob a identidade de Tsubaki. Quanto a mim... Já tenho a minha decisão tomada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070362,
					"content": "Oh! Então você também decidiu fazer a mesma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070363,
					"content": "Não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070364,
					"content": "Eu não planejo fazer nada parecido. Eu acho que... Acho que vou criar um novo objetivo: viver cada dia sem arrependimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070365,
					"content": "Então... Viajante... Eu... Hum... Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070366,
					"content": "Hu~ Respire fundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070367,
					"content": "Você teria algum interesse em festivais de Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070368,
					"content": "Paimon está morrendo de vontade de ir desde que vimos aquele cartaz! Você está dizendo que também quer ir, Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070369,
					"content": "Então, você realmente nunca foi a um festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "Ei, vamos lá, parem de rir de mim! É só porque eu costumava ter as mesmas preocupações que minha mãe tinha... mas agora, acho que não preciso me preocupar tanto com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070371,
					"content": "Vou ser fiel a mim mesma e realizar o desejo que minha mãe e eu compartilhamos. Sei que você, de todas as pessoas, pode entender o meu desejo de seguir meu próprio caminho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070372,
					"content": "#Então... Vamos fazer isso, você e eu! Vamos junt{F#as}{M#os} a um festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070373,
					"content": "Claro! Gostaria muito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "Paimon quer ir! Os festivais aqui também tem muitos petiscos saborosos, certo? Ah, e diversão e jogos! Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070375,
					"content": "Que ótimo! Muito obrigada, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070376,
					"content": "Se formos agora, chegaremos a tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070377,
					"content": "Certo! Hoje é o último dia, não é? Vamos nos apressar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070357,
					"content": "A culpa não é sua, é apenas do jeito que as coisas estão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}