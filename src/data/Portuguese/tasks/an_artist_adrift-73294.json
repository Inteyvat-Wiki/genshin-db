			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Ele não parece muito bem... Deve estar faminto! Vamos dividir um pouco da nossa comida com ele, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Que essa comida dê forças a ele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "Sem tentar ser parcial ou algo do tipo, mas Paimon acha que você cozinha muito bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Você dá Ovo Frito de Teyvat ao homem desmaiado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Eu... eu estou vivo! Estou vivo novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Uau, acho que ele estava faminto mesmo. Era só um ovo frito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Ah, que gosto indescritível, foi o bastante para reviver os mortos, com certeza! Se eu soubesse que ovos fritos podiam ter um sabor tão glorioso, teria comprado aquele ovo misterioso daquele sujeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Qual ovo misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Dizem que comer um deles faz com que você evite um dia inteiro de azar. Acho que eu deveria ter comprado um... ou quem sabe uma dúzia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Hã, isso parece realmente suspeito e Paimon sabe reconhecer quando vê um golpe. Como você veio parar aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Eu... Bem, eu sou um artista renomado de Fontaine, eu vim aqui para Sumeru procurar por inspiração para o meu trabalho. Pode me chamar de Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "Inspiração? Por aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "É mesmo. Não tem lugares melhores para buscar inspiração? Tipo algum lugar com uma vista melhor ou quem sabe melhores medidas de segurança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Além disso, se você é um artista de Fontaine, por que está de mãos vazias? Você... não é um espião Fatui, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Que raciocínio mais extremo! Tão extremo que me faz pensar quais experiências vocês tiveram para pensar dessa forma! No entanto, eu sou, de fato, um artista e somente isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "É só que... Bem, eu realmente encontrei muita inspiração aqui e estava pronto para voltar para Fontaine com as minhas novas descobertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Eu não esperava que o clima de Sumeru fosse tão seco, a ponto de fazer o Vale Chenyu parecer um pântano. E isso foi antes da tempestade de areia começar a ficar mais forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Eu devo confessar que prefiro climas mais úmidos, por isso estava planejando voltar viajando por água para ver paisagens diferentes, mas a minha jangada foi levada pela correnteza e eu não sou um bom nadador, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "Imagino que você deve ter passado por momentos difíceis morando em Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Esse é o caso, embora não seja somente uma questão de ser um bom nadador ou não... *Suspiro* Deixa para lá. Encontrei um lugar para descansar perto da água e algumas folhas de chá que ainda não ficaram completamente encharcadas. Permita-me agradecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Você está nos convidando para tomar chá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "#Ah, claro! Claro! Eu gostaria de expressar a minha gratidão pelo ovo frito que você me presenteou. Como eu deveria chamá-l{M#os}{F#as}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Ah, sim. Paimon quase esqueceu das apresentações!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#Somos {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Ah, que nomes incríveis. Bem, seja como for, venham beber chá. O meu acampamento está perto, estamos quase chegando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "#{M#O enviado}{F#A enviada} da justiça e sua companheira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#{NICKNAME} e sua melhor companheira de viagem, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Ouro Radiante e Brilho Prateado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Somos {M#o}{F#a} Ouro Radiante, {NICKNAME} e a Brilho Prateado, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Quem é que se refere como \"renomado\" em alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Isso! Isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Haha, mas ele não é a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Qual é! Todo mundo já deve ter desmaiado de fome pelo menos uma vez na vida, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
