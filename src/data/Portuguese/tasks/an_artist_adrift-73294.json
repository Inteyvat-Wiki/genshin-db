		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Que lugar péssimo! Você tem certeza que pode chamar isso de acampamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Bem, a paisagem é ótima, e existe uma sensação de vastidão quando você está na praia. Honestamente, é mais relaxante do que quando eu estava em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "Que tipo de vida você tinha lá, falando sério? Isso... não é exatamente o que Paimon esperava de um artista renomado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Na verdade, a minha casa em Fontaine é bem pequena. Eu não sou uma pessoa que gosta de esbanjar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Pode até ser, mas até os acampamentos de aventureiros são melhores do que isso. Hã? Isso é um... Onde está seu animalzinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Hmm, eu não tenho um. Deve ter sido deixado por algum aventureiro, ou algo do tipo. Falando nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Eu receberia vocês de uma forma melhor, mas a minha bagagem caiu na água quando a minha jangada desmontou, e eu não sei nadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Mas se vocês puderem encontrar a minha bagagem perdida por mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "Será que ainda poderiam ser usadas depois de ficarem molhadas assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Eu guardei tudo com cuidado, mas tem algumas coisas que... *Suspiro* Bem, eu perdi tudo, tudo! Bem, eu posso sempre desenhar de novo... isso, posso desenhar de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "#Hmm... Talvez possamos dar uma ajuda, {NICKNAME}; Esse cara parece estar em um péssimo momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "Eu não tenho ninguém com quem contar aqui, só posso pedir ajuda para vocês. Ficarei esperando aqui com um chá quentinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329410,
			"completionStepIds": [
				7329410
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329410",
							"2"
						],
						"stepId": 7329410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cão"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Estranho. Por que tem um cachorrinho aqui? Ele parece estar protegendo alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "(Olha para você com cautela.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Cão"
				},
				{
					"id": 732941003,
					"content": "Parece um cachorro esperto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Dá um pequeno latido.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Cão"
				},
				{
					"id": 732941007,
					"content": "É verdade, não tinha uma tigela de comida no acampamento de Julien? Pode ser desse bom menino! Estranho, o Julien não disse que não tinha nenhum companheiro animal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "*Choramingo*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Cão"
				},
				{
					"id": 732941009,
					"content": "O cachorro corre em direção ao acampamento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Ele fugiu... Vamos perguntar para o Julien mais tarde. Agora Paimon está curiosa com o que há debaixo desse monte de areia. Vamos dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "De onde será que esse cachorro selvagem veio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Dá um rosnado baixinho.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Cão"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329412",
							"2"
						],
						"stepId": 7329412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "Estamos de volta! Hã!? Então esse é o seu companheiro animal, Julien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Deixa escapar um ruído ameaçador.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Cão"
				},
				{
					"id": 732941203,
					"content": "...Ótimo, Pimenta... Rosnando para mim, né? Você não sabe quem está nos mantendo alimentados aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Ah, então tem nome! Mas, por outro lado, será que esse cara está legal mesmo? Discutir com um cachorro dessa forma...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Parece que o relacionamento deles é ótimo.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(Você chama isso de \"ótimo\"?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Ei, Julien! Encontramos o que você tinha perdido! Pimenta é seu animal de estimação, não é? Por que você mentiu para a gente mais cedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Eu? Com esse ingrato? Eu preferia me juntar a um Cão da Fenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Eu duvido que isso daria certo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Exatamente. Se alguém como você, que desmaia de fome, encontrasse um Cão da Fenda, o problema não poderia ser resolvido com apenas um simples Ovo Frito de Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "Falando nisso, parece que ele estava guardando uma prancheta na praia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Acho que ele estava tentando escondê-la...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Sério? Cachorrinho malvado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Late, como se estivesse protestando.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Cão"
				},
				{
					"id": 732941218,
					"content": "Você está seriamente reclamando disso? Se eu não tivesse seguido você até este canto, poderia ter retornado a Fontaine pelo meu caminho original...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Hã? Você não disse que acabou voltando de jangada porque queria ver as paisagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "Ah, certo. Não se tratava realmente de ver a paisagem. Eu estava apenas seguindo esse cara por aí, e foi assim que vim parar aqui. As estradas por aqui são bastante sinuosas. É difícil não se perder mesmo se você tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Ah, então foi assim. Vamos lá, você deveria ter apenas nos contado a verdade desde o início! Por que você não fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Hmm... Foi para... para preservar a minha imagem como artista renomado...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Aff, você soa como se estivesse apenas tentando nos enganar quando gagueja assim, e você também não é muito bom nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Falando de paisagens daqui de Sumeru, {NICKNAME} e Paimon conhecem várias incríveis. Podemos levar você até lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "E-Está tudo bem. Só estou dizendo que, bem, obrigado pela ajuda... Mas, afinal, sou um artista renomado. No fim, acredito que as paisagens que valem a pena ser vistas devem ser aquelas que nós mesmos descobrimos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Ah sim. O chá está pronto. Vamos tomar um pouco? Além disso, por acaso você também tem alguns ovos fritos para acompanhar o chá? Sabe, tipo um lanchinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Ovos fritos com chá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#Exatamente! {NICKNAME} conhece muitos pratos! Podemos comer alguma outra coisa, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Você aproveita o chá com um lanchinho.\\nO gosto do chá é difícil de ser descrito...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Hm, esse chá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Um amigo meu me vendeu. Dizem que pode ativar a sabedoria potencial dentro de você. Eu sinto que tem um gosto muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Ainda bem que eu não tenho amigos como os seus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Por que você diz isso? Ter amigos é uma coisa muito boa. Na verdade, eu vim para Sumeru por recomendação de um amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Obrigado por tudo que fizeram por mim hoje. Eu não sei se essa remuneração será o suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Está tudo bem, é só que... Você tem certeza que não precisa da nossa ajuda para procurar inspiração? Paimon sente que você vai se perder de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "#O sentido de uma peregrinação... quer dizer, o sentido de uma viagem está em percorrê-la sozinho. Não vou mais incomodar vocês {M#dois}{F#duas}. Eu mesmo farei isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Bem, claro, se você diz. Não desmaie de fome na estrada novamente, viu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "Você poderia me dar outro copo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#Tem alguma coisa errada com as suas papilas gustativas, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Haha, sem querer ser mesquinho nem nada, mas ainda vou ficar em Sumeru por um tempo, então preciso de um pouco de sobra para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "Isso soa como pensamento positivo para mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "Sério...? Mas, somente chá faz Paimon sentir que alguma coisa está faltando, sabe? Vamos preparar alguma coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "Ele poderia estar protegendo a prancheta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "Mas ele fugiu depois que o encontramos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(Eu não sinto cheiro de vinho...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(Ele costuma ser assim? Parece um cara bastante problemático...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}