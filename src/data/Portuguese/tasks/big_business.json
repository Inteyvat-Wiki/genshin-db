			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Parece que é inútil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "Desculpe, você viu uma caixa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Uma caixa? Bem, eu realmente encontrei uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "Eu já dei uma olhada lá dentro, e era um monte de faturas. Parece que alguém estava fazendo um empreendimento comercial realmente enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "Não sei quanto o dono queria pagar para ter esta caixa de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "... O que isso significa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Não se preocupe, estou brincando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "O valor das mercadorias nessas faturas não é nem um pouco baixo. Não sei qual comerciante poderia fazer um negócio assim tão grande em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "Tenho noção de tempo e de lugar. Não estou prestes a chutar um vespeiro só porque posso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "Ainda assim, você não acha um pouco irrazoável apenas levar isso e ir embora depois de todo o tempo e esforço que gastei protegendo ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "Então, vamos resolver este problema de uma maneira mais tradicional, trocar mercadoria por mercadoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "Me traga três Jades Nocticulosas, e vou te dar estas faturas, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "Quero dizer, três Jades Nocticulosas não são nada em comparação com o valor das coisas nessas faturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Então, vá lá procurar. Trocamos quando encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "O que está escrito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Você não sabe? Então você está aqui apenas para fazer o trabalho de outra pessoa. Bem, está tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "Olhe bem, o negócio desse tamanho, não é algo que precisamos saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "Tudo bem, vá me trazer as Jades Nocticulosas, e eu lhe darei as faturas. Em seguida, você poderá entregá-las à pessoa que te enviou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "Tudo pronto, sem bagunça ou confusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
