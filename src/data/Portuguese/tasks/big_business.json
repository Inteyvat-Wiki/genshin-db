			"dialogs": [
				{
					"id": 210240901,
					"content": "Você encontrou as faturas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Já encontrei tudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Muito obrigado mesmo! Que bom! Estou tão feliz que nada deu errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Se essas faturas tivessem sido perdidas, o meu chefe teria ficado furioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "Você quer perguntar para que negócio essas faturas servem, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Desculpe, eu não posso te dizer. É um segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Este é a sua recompensa. Espere... por que esta caixa foi aberta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "... Você encontrou alguém fora e ele deu uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Estou ferrado! Tenho que dizer ao meu chefe rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Oh, não se preocupe, confio em você. Quer dizer, eu já sei sobre o seu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Bem, preciso arranjar uma maneira de entrar em contato com o meu chefe. E boa continuação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
