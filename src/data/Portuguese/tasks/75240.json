					"Nawatlali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "#Bem-vind{M#o}{F#a}s à Copa dos Heróis Ayar, amig{M#o}{F#a}s. Eu sou a organizadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nawatlali"
				},
				{
					"id": 752400102,
					"content": "Hoje é o último dia da competição. Se quiser ganhar, terá que derrotar em sequência nossos três melhores heróis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nawatlali"
				},
				{
					"id": 752400107,
					"content": "O que é a Copa dos Heróis Ayar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "É uma luta pela glória de Ayar! Use seus punhos, armas, ou qualquer truque que exista para derrotar seu oponente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nawatlali"
				},
				{
					"id": 752400109,
					"content": "E Ayar é uma pessoa, ou...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "#{M#Meu amigo}{F#Minha amiga}, apenas um campeão é qualificado para fazer perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nawatlali"
				},
				{
					"id": 752400111,
					"content": "Suba no palco! Veremos se você tem a força para ganhar esse respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nawatlali"
				}
			]
		},
