			"dialogs": [
				{
					"id": 740090301,
					"content": "Por favor, deixe-me explicar... Isso tudo é um mal-entendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090302,
					"content": "Sr. Sonny... Perceba, só entramos nesse negócio por ouvimos que tinha Mora a ser ganha, e como os chefões não concordaram, pensamos... Pensamos que podíamos ganhar o dinheiro primeiro e então entregar todos os juros, é, foi exatamente isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090303,
					"content": "Ugh, ele está ignorando Paimon totalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "Eu não tenho reclamações contra a organização, nenhuma... Oh, certo, eu também fui enganado por esses vigaristas! Essa é a única razão por eu ter feito algo tão tolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Impressionante, muito impressionante. {NICKNAME}, você é cada centímetro tão forte quanto as histórias sugerem. Não concorda, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "Super forte. Incrivelmente formidável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090307,
					"content": "Por favor, se você ainda lembra de qualquer coisa do tempo que passamos juntos... Sr. Sonny... Sr. Luca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090309,
					"content": "Argh! Por favor, por favor não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090310,
					"content": "#Luca, noss{M#os}{F#as} convidad{M#os}{F#as} ainda estão aqui. Não façamos nada descortês que possa acabar com clima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090312,
					"content": "Hunf! Viu os erros em seu caminho agora, Virgil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Aah, foi minha culpa, foi tudo minha culpa... Por favor, tenham misericórdia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090314,
					"content": "Ok, pelo menos você admitiu que fez algo errado. Agora garanta que não vai fazer de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Meu caro Virgil jamais faria algo assim de novo. Paimon, {NICKNAME}, eu posso prometer pela honra de Sonny, o Luva Branca, assim como pela do meu pai e filho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Vamos embora, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "Ahã! Muito obrigada, Sonny e Luca. Parece que tem mais gente boa do que ruim em Fontaine, no fim das contas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Adeus, cara Paimon e {M#meu caro senhor}{F#minha adorável senhorita}. Espero que chegue o dia em que possamos trabalhar juntos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Eeee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090317,
					"content": "O que vocês vão fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#A vida pode frequentemente ficar tediosa quando você entende tudo neste mundo, não é verdade, {M#meu caro senhor}{F#minha adorável senhorita}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "E se vocês devem saber, nós teremos... uma conversa muito séria e longa com ele. Mas não tomaremos mais do seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
		},
