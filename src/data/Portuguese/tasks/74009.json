					}
				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Agora, essa é uma coincidência muito feliz. Não concorda, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090103,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Desculpe. Olhe para mim, começando uma conversa sem nem me apresentar. Eu sou Sonny, aquele que geralmente chamam de \"Luva Branca\". Meu amigo aqui é Luca, o Pescador. Ele é bem famoso em alguns círculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "Ah, olá! Paimon é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Está tudo bem. Eu sei que você é Paimon e est{M#e}{F#a} viajante de cabelos loiros é {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Hã? Já conhece a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "Mas é claro! É só que antes de hoje, meu conhecimento de vocês era muito parecido com meu conhecido do Juiz Supremo. Em outras palavras, eu conhecia vocês, mas vocês não me conheciam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "Com sua fama e conquistas, é natural que notícias de sua chegada nos alcançaria assim que pisassem em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "#Somos famos{M#os}{F#as} assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Ah, que humilde. Como devo dizer?... Hmm, para certas pessoas, sua chegada a Fontaine seria como se alguém explodisse uma bomba no palco da casa de ópera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "—Claro, digo isso apenas da forma mais positiva. Não concorda, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Er, mas como uma bomba explodindo pode ser bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Hmm... Não sou muito bom com as palavras. Como você diria, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "O show de mágica de Lyney e Lynette. Explodindo todas as barreiras para alcançar o impossível. Uma experiência de arrepiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090116,
					"content": "Precisamente! Viu, eu jamais teria pensado em dizer isso assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "S-Se você diz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Mas por que te chamam de \"Luva Branca\", hein? Paimon não vê luva nenhuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Ohh, essa aí é difícil de responder. Como devo explicar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Imagina, se puder, que você está vestindo uma luva. Se algo sujo caísse em sua mão, então uma marca escura seria deixada na luva. Meu dever... seria encontrar essa marca escura e removê-la de vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Hã... Então você é o cara da limpeza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Exatamente, minha cara Paimon! Viu, eu nunca pude resumir tão sucintamente a natureza do meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "Aah, então gente como você são o motivo das ruas da Corte de Fontaine sempre estarem tão organizadas e limpas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Hahaha, é isso que eu gosto de ouvir! Sim, você pode entender assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Ok, faz sentido para Paimon... Mas por que alguém da limpeza precisa de uma faca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Você pode pensar que é apenas uma pequena ferramenta de trabalho que trazemos quando tem marcas particularmente difíceis de remover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Entendi, valeu! Então... seu amigo Luca aqui é \"Luca, o Pescador\" porque ele se garante na pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Hmm — receio que isso seja só uma parte da história. Sabe, tem muitos tipos de peixe em Fontaine também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "E Luca aqui tem muita experiência em ensinar as pessoas a passar um tempo de qualidade com todos os diferentes tipos de peixe. Estou certo, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090131,
					"content": "Hã? Paimon não entende... se esse é o caso, então—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Devo dizer, cara Paimon, que você tem talento para fazer as perguntas mais fascinantes e difíceis. Seria maravilhoso se pudéssemos ter uma conversa mais longa, em que eu pudesse responder tudo até ficar satisfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, está tranquilo parar de perguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Hã? Tudo bem então... Sonny e Luca, tem alguma coisa que querem pedir à gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Sabe, estamos extremamente intrigados pela prática de mergulho. As águas de Fontaine são cheias de tesouros inestimáveis, deixados tanto pela natureza quanto nossos ancestrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Nossos amigos nos disseram que vocês fizeram outro bom amigo recentemente, e até saíram para um mergulho com ele. Seus poderes eram tamanhos que você nem precisou de equipamento de mergulho, não é verdade, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090139,
					"content": "Você quer saber de Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Isso. Queremos saber de Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgil... Aquele mentiroso traidor! Ahh, só de lembrar Paimon fica indignada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Você reconta suas experiências com Virgil para Sonny, o Luva Branca e Luca, o Pescador.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "...Entendo, entendo. Obrigado por nos contar tudo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Não há de quê! Hunf, Paimon não esqueceu nada daquele cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "Nós somos, claro, extremamente gratos que puderam compartilhar conosco a história inteira. Entretanto, da minha perspectiva, eu estou ainda mais aliviado que não considerem Virgil um amigo. Se esse não fosse o caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Hmm, talvez eu possa dizer assim: se o vissem como amigo, as coisas se tornariam bem estranhas entre nós. Não é verdade, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "Provavelmente... não precisamos fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090148,
					"content": "Concordo, concordo. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Do que vocês estão falando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Eles são inimigos de Virgil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Ahh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Suas palavras me machucam, {M#meu caro senhor}{F#minha adorável senhorita}. Eu tenho muitos amigos e nenhum inimigo. Virgil é apenas um dos meus muitos amigos — e ah, falando do caro Virgil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#Acho que é hora de termos uma \"conversa\" séria com ele. Certamente você entende o que quero dizer, {M#caro}{F#cara} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "#Claro, isso é para que possamos retribuir a ele pelo que ele fez com vocês. É o mínimo que podemos fazer para {M#nossos convidados}{F#nossas convidadas} de honra, não acham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Er, Paimon está boiando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "Ele é o Luva Branca. Isso é tudo que você precisa saber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Ermm... Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Já encontramos a base de Virgil e do resto dos amigos dele. Por que não nos encontramos lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Por que precisamos ir também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#Meu caro senhor}{F#Minha adorável senhorita}! Com o tanto que Virgil ofendeu vocês, não podemos de forma alguma ter... nossa conversa com ele sem informar a você nossos planos antecipadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090164,
					"content": "Viu, Luca também concorda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Hunf! Eu também quero conversar com Virgil! Ele tem que se desculpar de verdade com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Hahaha, vocês são muito gentis. Então vamos nos encontrar no destino combinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "Certo, então vamos nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Está tudo bem não entender tudo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#A vida pode frequentemente ficar tediosa quando você entende tudo neste mundo, não é verdade, {M#meu caro senhor}{F#minha adorável senhorita}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "Algo que em que a gente possa ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
