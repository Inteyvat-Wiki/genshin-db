			"dialogs": [
				{
					"id": 740090201,
					"content": "#Cara Paimon, e {M#meu caro senhor}{F#minha adorável senhorita}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090202,
					"content": "Essa é a base que Virgil tem usado recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Eu juro, por que Virgil ainda não voltou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Homem Aparentemente Malvado"
				},
				{
					"id": 740090204,
					"content": "Se ele vai nos deixar esperando, eu posso não conseguir... me segurar com essa remessa de Sinthe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Homem Aparentemente Perigoso"
				},
				{
					"id": 740090205,
					"content": "Ei, pode parar! Aquela remessa nos custou um rim para conseguir. Virgil não terá misericórdia se você pegasse sem permissão dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Homem Aparentemente Desonesto"
				},
				{
					"id": 740090206,
					"content": "Que pena. Parece que meu caro amigo Virgil ainda não voltou à base. Mas ainda podemos ter nossa conversa com esses caras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Er, mas não parece... que esses caras estão a fim de um papo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "Hmm, mas acho que eles vão mudar de ideia logo, logo. O que acha, meu caro Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 740090210,
					"content": "Ei! Tem certeza que não teria problemas? Paimon acha que eles provavelmente só vão tentar te bater!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Ah, não! Você é considerada demais, cara Paimon. Algo assim seria realmente infeliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "...Para eles, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		},
