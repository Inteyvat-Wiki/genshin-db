			},
			"dialogs": [
				{
					"id": 722260301,
					"content": "#Obrigado, {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260302,
					"content": "O poleiro parece em bom estado. A cerimônia desta vez com certeza será boa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260303,
					"content": "Tranquilo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "Muito assustador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "#Hehe, Paimon e {NICKNAME} já viram muitas coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260306,
					"content": "#Falando nisso, {NICKNAME}, de onde vocês vieram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260307,
					"content": "As pessoas que vieram antes falaram de lugares como Inazuma e Ilha Narukami. Você é de Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260308,
					"content": "Falando em termos relativos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "Sim, nós viemos da Ilha Narukami, não foi... Espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260310,
					"content": "Paimon quase se esqueceu que estamos aqui por causa da Maushiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260311,
					"content": "Nós somos de um lugar muito, muito distante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "É verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260314,
					"content": "Que incrível! Você até mesmo escalou para o topo da cabeça de um dragão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260315,
					"content": "Bem, foi algo um tanto desconfortável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "Foi tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "Que incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260318,
					"content": "O mundo é um lugar muito grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260319,
					"content": "Não imaginei que haviam tantos lugares além da neblina, nem tantas pessoas! Se eu puder sair um dia, quero ir ver todos eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260320,
					"content": "Eles sempre dizem que nossas almas ficarão perdidas se nós sairmos da neblina, e que ela nos protege da escuridão do mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260321,
					"content": "Mas eu conheci muitas pessoas do mundo exterior. É por isso que eu sei que o Mar do Silêncio deve ser habitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260322,
					"content": "Você pode ver conosco se tiver uma chance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "Certo, está confirmado então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260324,
					"content": "#Vocês {F#duas}{M#dois} podem ir seguindo na frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260325,
					"content": "Quando a cerimônia acabar, vamos explorar o mundo além da Ilha Tsurumi juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260326,
					"content": "Uhuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
