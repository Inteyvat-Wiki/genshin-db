			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "Sobre o estranho objeto perto da água...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "Hã? Você colocou ele próximo da água?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500803,
					"content": "Como foi? Algo de especial aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500804,
					"content": "Um Dragarto Geo apareceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "Um Dragarto Geo? Então, se transformou em um Dragarto Geo na água?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500806,
					"content": "Oh, não. Ele não se transformou em um, mas, na verdade, atraiu um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500807,
					"content": "Meu coração quase parou! Se ele realmente tivesse se transformado em um Dragarto Geo, toda minha visão do mundo teria sido revirada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500808,
					"content": "Então, o que é exatamente essa coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "A resposta é simples. Como devo dizer? Hmm, bem, por que você não me diz primeiro se tinha algo de especial sobre esse Dragarto Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500810,
					"content": "Diga-me, ele tinha poderes Hydro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500811,
					"content": "Parece que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Então, é isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500816,
					"content": "Aquele Dragarto Geo provavelmente é capaz de usar o poder Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500817,
					"content": "A água subterrânea do Despenhadeiro contém um denso poder Hydro. Então, certamente alguns grandes pontos de concentração se tornaram o local perfeito para o crescimento desses objetos semelhantes a algas, que você pescou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500818,
					"content": "O Dragarto Geo — e outras criaturas marinhas do Despenhadeiro — também tiveram seus poderes aumentados ao se alimentarem dessas algas que são ricas em elemento Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500819,
					"content": "Então, aquela coisa é... apenas uma alga que contém elementos ricos em Hydro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500820,
					"content": "Eram apenas algumas agas, ugh...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Sim, alga — só que contém um denso poder Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500822,
					"content": "Você normalmente não encontra isso em ambientes normais — a menos que algum poder imenso e puro tenha alterado a fonte da água... Esqueça, essas algas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500823,
					"content": "Podem se tornar organismos elementais conscientes algum dia. Que tópico de estudo fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500813,
					"content": "Não vi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#Você deve ter derrotado ele muito rápido para ter percebido sua habilidade especial. Que incrível, como esperado {M#do lendário}{F#da lendária} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500815,
					"content": "Mas essa é a minha hipótese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
}