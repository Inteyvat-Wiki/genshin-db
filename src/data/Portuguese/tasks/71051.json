			"dialogs": [
				{
					"id": 710500501,
					"content": "Sobre o objeto estranho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "Hã? Você pescou isso? Pesca, hm? À primeira vista, realmente parece com uma isca de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500503,
					"content": "É normal as pessoas encontrarem coisas assim enquanto pescam? Anisa nunca deixa de pescar um só dia na Ilha Watatsumi, mas ela nunca descobriu nada de especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500504,
					"content": "#Talvez seja {M#o pescador}{F#a pescadora} que faça toda a diferença, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500505,
					"content": "Deixe-me ver. Hmm, posso sentir uma enorme concentração de poder Hydro dentro dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500506,
					"content": "A água subterrânea do Despenhadeiro realmente contém um poder elemental excepcionalmente poderoso. Será que isso tem a ver com este objeto e as coisas que crescem nas águas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500507,
					"content": "Mas desde que você o pescou, a energia elemental tem se dissipado. Talvez devêssemos colocar na água para ver do que seu poder é capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500508,
					"content": "Colocar do lado da água?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Sim, e o ative com energia Hydro. Então, veremos seus segredos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500510,
					"content": "#Que tal você mesm{M#o}{F#a} ir lá ativar? — Quero dizer, foi você que pescou ele. Me avise se você tiver algum resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500511,
					"content": "Te pagarei por isso se sua descoberta tiver algum valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105008,
			"completionStepIds": [
				7105104
			],
