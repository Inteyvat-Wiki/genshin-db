			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730600201,
					"content": "#Nara dourad{F#a}{M#o} não parece ter medo de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "#Nara dourad{F#a}{M#o} é {F#uma}{M#um} Nara corajos{F#a}{M#o}, assim como Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "#Apesar de estar preocupado com Arabalika na Ruínas de Dahri, e Arakunti na Floresta Onírica, com a ajuda de Nara dourad{F#a}{M#o}, tudo ficará bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "#Agora que a Máquina Varuna está curada, nenhum cara mau perturbará mais o jardim. Aranakula gostaria de dar as flores do sementeiro para {F#ela}{M#ele}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
		{
