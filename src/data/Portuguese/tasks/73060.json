			"dialogs": [
				{
					"id": 730600701,
					"content": "Aranakula está no Monumento Yasna. Lá há muitos Cogumelos. Me preocupo com Arabalika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600702
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600702,
					"content": "Arabalika não irá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600703,
					"content": "Aranakula sabe se esconder, os Cogumelos não o encontrarão. Por que Arapandu se preocupa?",
