				"points": []
			},
			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika deve voltar em breve da Ruínas de Dahri. Com o Ararakalari de Arabalika, os gigantes de ferro e os Cogumelos não são mais amedrontadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Se Aranakula tivesse um Ararakalari tão forte como o de Arabalika, poderia proteger o jardim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Aranakula não possui metade do que Arabalika possui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "*Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "#Aranakula pode ser mais corajoso, como Nara dourad{F#a}{M#o}, só precisa de tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
