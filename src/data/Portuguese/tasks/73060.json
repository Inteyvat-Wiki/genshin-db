				"points": []
			},
			"dialogs": [
				{
					"id": 730600401,
					"content": "A Floresta Onírica... Melodia calma, o som da água, de pássaros batendo suas assas, e de pousarem em um galho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Falar com Nara e Paimon... Paimon é engraçada. Infelizmente, Paimon não quer virar uma semente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Porque Paimon não é Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "A Floresta Onírica está bem. Arabalika está na Ruínas de Dahri, mas não se preocupem. Há muitos Cogumelos no Monumento Yasna, me preocupo com Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
