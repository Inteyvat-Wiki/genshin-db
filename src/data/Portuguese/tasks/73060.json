			"dialogs": [
				{
					"id": 730600601,
					"content": "Muitos caras maus no Monumento Yasna, mas Aranakula voltou. Bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "#Nara dourad{F#a}{M#o} e Aranakula escaparam dos caras mau, e purificaram a Memória de Pedra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Quando a Máquina Varuna estiver curada, as flores do jardim retornarão. Os Aranaras não esquecerão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Agora apenas resta Arakunti na Floresta Onírica. Quando Arakunti retornar, poderemos nos livrar dos insetos maus comendo as raízes da Máquina Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
