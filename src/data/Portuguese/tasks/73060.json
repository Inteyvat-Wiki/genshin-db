				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika está bem, mas Arabalika ainda está preocupado com Aranakula no Monumento Yasna e Arakunti na Floresta Onírica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... Muitos cogumelos ruins, se Aranakula for capturado de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "#Preocupar-se muito, inútil. Nara dourad{F#a}{M#o} é muito forte, derrotou Bloco de Ferro Grande, como um vento forte soprando madeira podre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Só precisamos curar a Máquina Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
