			"dialogs": [
				{
					"id": 3081301,
					"content": "Mesmo que esteja aqui fora, posso sentir uma perturbação no fluxo elemental lá dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Vamos retornar este templo ao seu estado normal para eu poder ficar mais tranquila.",
