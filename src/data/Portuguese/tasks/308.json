			"dialogs": [
				{
					"id": 3081101,
					"content": "Olá, fofura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081102,
					"content": "Você vai me ajudar também? Muito gentil da sua parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081103,
					"content": "Não hesite em me procurar para o que precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081104,
						3081108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081104,
					"content": "Que tipo de coisas uma bibliotecária faz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081105
					]
				},
				{
					"id": 3081105,
					"content": "Essa é uma boa pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081106,
					"content": "Basicamente, são trabalhos que não exigem esforço físico e mental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081107,
					"content": "Então, o que está faltando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081111,
					"content": "Por isso, você também deveria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081108,
					"content": "Por que uma bibliotecária estaria nas ruínas...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081109
					]
				},
				{
					"id": 3081109,
					"content": "Essa é uma boa pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081110,
					"content": "Bem, porque a Jean confia em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081111
					],
					"speakerTitle": "Lisa"
				}
			]
		},
