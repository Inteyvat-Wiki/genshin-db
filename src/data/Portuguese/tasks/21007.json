				"objectNames": [
					"Yuancheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Que irmãos o que! Todos só pensam em pegar o melhor para si!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070302,
					"content": "O seu pai também está um pouco confuso na sua idade, às vezes pretende ignorar os problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070303,
					"content": "Eu não sei se eles já sabem que o tesouro está na mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070304,
					"content": "Tenho que buscar o tesouro o mais rápido possível, e ir longe, muito longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuancheng"
				}
			]
		},
		{
