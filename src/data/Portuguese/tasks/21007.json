						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100701",
							"3"
						],
						"stepId": 2100701,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuanqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "Oh, não! O que é que eu fiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuanqing"
				},
				{
					"id": 210070202,
					"content": "Eu finalmente consegui escapar quando eles estavam distraídos a fim de ser o primeiro para obter o tesouro na mina. Mas... por que é que tem tantos monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuanqing"
				},
				{
					"id": 210070203,
					"content": "Que horror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuanqing"
				}
			]
		},
		{
