			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuanliang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Hehe, agora o tesouro é todo meu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuanliang"
				},
				{
					"id": 210070402,
					"content": "Os meus dois irmãos são idiotas. Fugiram depois de ter agarrado umas linhas, achando que o problema já foi resolvido. Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuanliang"
				},
				{
					"id": 210070403,
					"content": "Honrar o testamento do pai? Só tem uma linha que vale a pena ler, o tesouro está na mina, hehehe. agora todo o tesouro é meu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuanliang"
				}
			]
		},
