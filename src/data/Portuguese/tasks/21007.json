				"objectNames": [
					"Yuanhong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Já foram embora, todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuanhong"
				},
				{
					"id": 210070502,
					"content": "Yuanqing, Yuanliang, Yuancheng... meus filhos tontos... Pensem melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuanhong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
