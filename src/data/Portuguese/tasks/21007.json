				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuanqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Ei, olhe! São os caras de antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "A árvore sozinha não tem uma floresta para sustentá-la... Haha, é verdade, não consegue fazer nada sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuanqing"
				},
				{
					"id": 210070603,
					"content": "As esplêndidas folhas outonais vermelhas, partem sem a brisa... Se eu acreditasse no meu irmão e no meu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuancheng"
				},
				{
					"id": 210070604,
					"content": "As gloriosas folhas outonais vermelhas foram embora com uma brisa... o tesouro... perdi tudo por causa do tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuanliang"
				},
				{
					"id": 210070605,
					"content": "As árvores devem misturar suas raízes e sombra, e é aí onde a casa fica... Filhos, somos uma família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuanhong"
				},
				{
					"id": 210070606,
					"content": "Vocês realmente acham que eu escondi o tesouro na mina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuanhong"
				},
				{
					"id": 210070607,
					"content": "Há um tesouro. Vocês se lembrem da árvore que plantamos juntos quando éramos crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuanhong"
				},
				{
					"id": 210070608,
					"content": "Eu venho todos os anos, e coloco algumas coisas para dentro, desejando que possamos escavar juntos quando vocês forem maiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuanhong"
				},
				{
					"id": 210070609,
					"content": "E depois os usamos para comprar alguma coisa para comer, umas garrafas de vinho, nos reunimos juntos, como a família, e falamos sobre o passado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuanhong"
				},
				{
					"id": 210070610,
					"content": "Oh, crianças, as minhas crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuanhong"
				}
			]
		}
	]
}