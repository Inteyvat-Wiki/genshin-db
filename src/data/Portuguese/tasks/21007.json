			},
			"dialogs": [
				{
					"id": 210070101,
					"content": "Uma árvore sozinha não tem uma floresta para sustentá-la... Juntos somos mais fortes... Há ouro no interior das rochas, então unam-se e compartilhem da suas bênçãos... Com a descoberta desta fortuna, vos digo: \"Honrem a vontade de seu pai...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notas Perdidas"
				}
			]
		},
		{
			"id": 2100702,
			"completionStepIds": [
				2100712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100712",
