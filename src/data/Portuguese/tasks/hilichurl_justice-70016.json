					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "Na verdade, ele só não gosta de falar. Mas nós já perguntamos o que queríamos saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700160110,
					"content": "Você precisa apenas ajudar ele a derrotar os inimigos, deixarei com vocês!",
