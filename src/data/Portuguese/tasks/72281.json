					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810907
					],
					"speakerTitle": "Onodera"
				},
				{
					"id": 722810907,
					"content": "Urgh... Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810908
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810908,
					"content": "Você está bem? Sua cara não está boa.",
