			"dialogs": [
				{
					"id": 722810501,
					"content": "Gorou, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810502,
					"content": "Ah! São vocês... *suspiro* Não pensei ver aquela pessoa aqui... Me pegou completamente de surpresa e eu não sabia o que dizer. Quando voltei a mim, eu já estava me escondendo aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810503,
					"content": "Vim aqui para garantir a segurança de Vossa Excelência, mas no final não pude fazer nada por ela... Apenas me tornei um fardo para seus ombros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810504,
					"content": "Gorou, não se culpe tanto. Na verdade, Kokomi nos pediu para lhe dar uma missão importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810505,
					"content": "Você dá a lista de livros de Kokomi para Gorou.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "É a lista de compras de Vossa Excelência... Entendo, é assim que ela quer que eu redima meus erros! Muito bem, deixe comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810507,
					"content": "Gorou, deixe-nos acompanhá-lo. Assim podemos mostrar-lhe o Festival Irodori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810508,
					"content": "Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
