					"nextDialogs": [
						722811113
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811113,
					"content": "Hã? Você quer dizer que está desistindo do grande prêmio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811114
					],
					"speakerTitle": "Murata"
				},
				{
					"id": 722811114,
					"content": "Gorou! Não desista do prêmio! Se você não quer ver Miko, nós encontraremos uma solução!",
