			},
			"dialogs": [
				{
					"id": 722811601,
					"content": "#{NICKNAME}, Paimon, obrigada por virem nos ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811602
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811602,
					"content": "Como foi a viagem a Ritou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811603
					]
				},
				{
					"id": 722811603,
					"content": "Valeu muito a pena. A sessão de resenha de livros foi um sucesso, e me deu esperanças para as futuras reuniões formais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811604
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811604,
					"content": "Gorou também contribuiu muito. Ele ganhou imensos livros úteis para a Ilha Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811605
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811605,
					"content": "Embora eu tenha ganhado o grande prêmio, foi Yae Miko quem ofereceu esses livros. Espero ter a oportunidade de agradecê-la adequadamente no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811606
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811606,
					"content": "Falando em Yae Miko, ela não lhe escreveu uma carta ontem? O que disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811607
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722811607,
					"content": "Ah, quase esqueci! Vou ler agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811608
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722811608,
					"content": "Querido Gorou, imagino que você deve ter ficado muito nervoso quando soube da cerimônia e de tirar uma foto comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811609
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811609,
					"content": "Foi uma surpresa para mim que você não apenas aceitou os termos, mas também fez suas próprias exigências. Sua coragem ganhou meu respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811610
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811610,
					"content": "Esses livros são um símbolo de minha boa vontade para com a Ilha Watatsumi e um presente para você. Espero que você goste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811611
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811611,
					"content": "Ah, tenho certeza que neste momento você deve estar se sentindo muito grato pela minha bondade e procurando uma maneira de me retribuir, não é? Bem, vou lhe dar uma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811612
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811612,
					"content": "A Editora Yae está realizando um evento no próximo mês e estamos procurando alguém que possa se vestir como um personagem de uma Light Novel para interagir com os fãs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811613
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811613,
					"content": "Gorou, você não é apenas paciente, mas também é muito bonitinho. O que você acha de vir nos ajudar? Vou preparar uma roupinha feita especialmente para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811614
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811614,
					"content": "Oh, e a propósito, será uma roupinha de mulher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811615
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722811615,
					"content": "Aaaaaaahh!!! Eu sabia que ela tinha algo na manga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		}
	]
