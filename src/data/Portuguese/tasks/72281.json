				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "#{NICKNAME}, Paimon, há quanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810202,
					"content": "Uau, é Kokomi e Gorou. Não pensei que a Sacerdotisa Divina da Ilha Watatsumi também viria participar do Festival Irodori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810203,
					"content": "Sim, mas não estamos aqui representando a administração da Ilha Watatsumi. Fomos convidados individualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810204,
					"content": "As coisas na Ilha Watatsumi estão tranquilas no momento, e eu queria comprar alguns livros. Então resolvi vir aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810205,
					"content": "Na verdade, Gorou não estava interessado em vir ao Festival Irodori. Mas ele disse que se eu fosse a Ritou, ele viria comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810206,
					"content": "Afinal, Vossa Excelência está viajando de Sangonomiya para encontrar sua amiga por correspondência. Como seu general, é meu dever garantir sua segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810207,
					"content": "Amiga por correspondência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810208,
					"content": "Sim. Começamos a nos corresponder recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810209,
					"content": "Minha amiga por correspondência e eu temos um gosto por Light Novels muito semelhante, e sempre trocamos ideias sobre os livros que lemos. Claro, também há vezes em que discordamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810210,
					"content": "Como nós dois estávamos vindo para o Festival Irodori desta vez, decidimos aproveitar a oportunidade para fazer uma sessão de resenha de livros e discutir nossas opiniões sobre diferentes romances com mais profundidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810211,
					"content": "Parece muito profissional! Ei, já que vocês dois gostam de romances, por que não escrevem um juntos? Quem sabe revolucionarão o mundo literário em Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810212,
					"content": "Hehe, isso é uma ideia muito interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810213,
					"content": "#Está quase na hora, {NICKNAME}. Gorou e eu temos que encontrar minha amiga por correspondência no local marcado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810214,
					"content": "Kokomi, para falar a verdade, Paimon está muito curiosa para saber quem é sua amiga por correspondência. Paimon também pode ir junto? Não se preocupe, Paimon vai apenas assistir de longe, Paimon não vai atrapalhar o encontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810215,
					"content": "Deixe-me pensar... Hmm, acho que não tem problema. Vamos juntos então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
							"2"
						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Gorou",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "O ponto de encontro é aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810402,
					"content": "Não há mais ninguém aqui, parece que chegamos cedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 722810403,
					"content": "Ai ai, mas quem temos aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810404,
					"content": "M-Miko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810405,
					"content": "(Oh não, Paimon não pensou que iríamos encontrar Miko! Não só ela e Kokomi não estão do mesmo lado, mas também não acreditam nos mesmos arcontes...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810406,
					"content": "(Elas vão acabar... Lutando entre si?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810407,
					"content": "Senhorita Guuji do Grande Santuário Narukami, não é à toa que eu estava sentindo uma aura de superioridade pairando no ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810408,
					"content": "Hehe, como esperado da líder da Ilha Watatsumi, cuja aparência é suave como uma água-viva, mas suas palavras machucam como uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810409,
					"content": "Oh não... O que vamos fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810410,
					"content": "Olá, prazer em conhecê-la, \"Senhorita Tofu Frito Delicado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810411,
					"content": "O prazer é todo meu \"Senhorita Linguado das Profundezas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810412,
					"content": "Hehehehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810413,
					"content": "Hã... O que está acontecendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810414,
					"content": "Miko é a amiga por correspondência de Kokomi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810415,
					"content": "Não pode ser. Olhe para elas, elas claramente já se conheciam! Isso significa que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810416,
					"content": "Este encontro de amigas por correspondência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "Hmm? Do que você está falando? Não entendi. Eu simplesmente vim para a sessão de resenha de livros com a Senhorita Linguado das Profundezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810419,
					"content": "Vamos lá, o local da reunião é a sede da Comissão Kanjou. A vista de lá é excelente, especialmente indicada para um chá e um bate-papo sobre criatividade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810420,
					"content": "Quem organiza uma sessão de resenha de livros na sede da Comissão Kanjou? Você realmente acha que vamos acreditar nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810421,
					"content": "Você não está aqui para falar sobre agitar o mundo literário em Inazuma... Você querem falar de agitar todas as coisas em Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810422,
					"content": "Hehe, em breve, a Ilha Watatsumi entrará em negociações com o Shogunato sobre o futuro desenvolvimento de Inazuma. É essencial ter esse tipo de reunião informal antes do início das reuniões formais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810423,
					"content": "Sim. Especialmente com alguém que não pertence ao Shogunato como eu, que posso ajudar todos a se entenderem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810424,
					"content": "Mas essa é apenas nossa primeira reunião. Ainda é muito cedo para fazer qualquer anúncio ao público.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810425,
					"content": "Hmm, entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810426,
					"content": "A propósito, onde está o seu general? Você não disse que ele viria junto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810427,
					"content": "Hmm, é verdade... Onde está Gorou...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810428,
					"content": "Gorou foi me comprar alguns livros. Ele não vai participar da reunião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810429,
					"content": "Oh, que pena. Eu queria tanto ver aquelas orelhas peludinhas novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 722810430,
					"content": "#{NICKNAME}, gostaria de falar com você por um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810431,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "Tenho a sensação de que Gorou não gosta de interagir com Guuji Yae, então inicialmente não queria trazê-lo para Ritou comigo desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810433,
					"content": "Eu notei como ele se escondeu instintivamente assim que a viu. No entanto, Gorou é uma pessoa muito responsável e ficará muito envergonhado da próxima vez que me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810434,
					"content": "Então pensei que dar a ele a tarefa de comprar os livros, o ajudaria a não se sentir tão culpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810435,
					"content": "Mas Gorou raramente compra alguma coisa. Então queria pedir a vocês para irem com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810436,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "Kokomi, você pode focar na reunião com Miko. Deixe os livros e Gorou para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722810438,
					"content": "Obrigada. Eu fiz uma lista dos livros que quero comprar. Por favor, entreguem para Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 722810417,
					"content": "... Era apenas uma desculpa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
