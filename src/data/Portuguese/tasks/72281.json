					"nextDialogs": [
						722811115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722811115,
					"content": "Não, você entendeu errado. Não quero desistir do prêmio, e posso lidar com a cerimônia e a foto com Miko.",
