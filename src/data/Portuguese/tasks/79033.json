				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330101,
					"content": "Hã, a imagem está projetada no centro da cena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330102,
					"content": "O que estas duas pessoas estão fazendo? Parece que uma está falando e a outra está sentada no chão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330103,
					"content": "Ooh, Paimon sabe! Ela deve estar contando uma história de dormir para a outra. É exatamente isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330104,
					"content": "Os Fatui também escutam histórias para dormir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330105
					]
				},
				{
					"id": 790330105,
					"content": "Talvez hajam Fatui que precisem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330106,
					"content": "Agafya, Persikov ordenou que fizéssemos alguns testes de recepção de sinais. Parece que nós quatro temos que ir... Chevka provavelmente ficará com furioso comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330107,
					"content": "Yakov, é uma ordem de cima, e Chevka certamente não o culpará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330108,
					"content": "...Sabe, se você está com tanto medo, eu vou com você falar com Chevka, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330109,
					"content": "Hã, então no fim das contas ela não estava contando histórias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330110,
					"content": "Mas, esse diálogo parece meio sem sentido. Não dá para saber o que está acontecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7903302,
			"completionStepIds": [
				7903307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903307",
							"2"
						],
						"stepId": 7903307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330201,
					"content": "Sério? A concha simplesmente saiu flutuando do poço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330202,
						790330203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330202,
					"content": "Bem, ela está sendo afetada pela miragem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				},
				{
					"id": 790330204,
					"content": "#Isso é incrível. Ooh, veja, {NICKNAME}! Alguém está se curvando... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330205,
					"content": "#{NICKNAME}, não se mova, atrás de você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330206,
						790330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330206,
					"content": "Tem algo assustador atrás de mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330208,
					"content": "Ah, espera. Era apenas uma ilusão criada pela concha. É que apareceu do nada atrás de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330209,
					"content": "Dois conjuntos de testes de sinais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330210,
					"content": "Na verdade, eu pensei que ele estava bem encrencado dessa vez. Mas no final, era apenas para lhe encarregar de um trabalho mais irritante. Bem, pelo menos é um alívio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330211,
					"content": "Hah! Você deveria ter visto como ele estava com medo de levar um sermão seu. Era como ver um irmão mais novo com medo do seu irmão mais velho dar um sermão nele. Sabe... você acha que ele tem medo de desapontar a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330212,
					"content": "Bem, nós somos membros do mesmo pelotão.. Mas às vezes parece que também somos uma família...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330213,
					"content": "Como uma família...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330214,
					"content": "Hmm... Paimon está com a sensação de que a gente ouviu algo que não deveria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330215,
					"content": "Para ser sincera, esses Fatui não parecem ser ruins...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330207,
					"content": "Não é hora de pegadinhas, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330208
					]
				},
				{
					"id": 790330203,
					"content": "Provavelmente tinha um pouco de ar dentro dela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790330204
					]
				}
			]
		},
		{
			"id": 7903303,
			"completionStepIds": [
				7903305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7903305",
							"2"
						],
						"stepId": 7903305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "Oh, parecem duas pessoas deitadas no chão... Será que estão vendo as estrelas no céu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330302,
					"content": "Para ser sincera, essa imagem é um pouco estranha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330303,
					"content": "Yakov, o que o comandante te disse que você ficou tão triste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330304,
					"content": "Bem, as ondas estavam fortes, e por isso eu escorreguei e caí enquanto carregava o dispositivo. Felizmente consegui salvá-lo a tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330305,
					"content": "Mas o comandante ainda assim brigou um monte e ordenou que nosso pelotão fizesse testes de recepção de sinais. É um trabalho muito cansativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330306,
					"content": "Oh, está tudo bem, não fique assim. Já fizemos isso várias vezes. Se anime, vá comer algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330307,
					"content": "Eles apontaram para aquele lugar alto. Será que estão procurando algo para comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790330308,
					"content": "Será que essa concha foi mal colocada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}