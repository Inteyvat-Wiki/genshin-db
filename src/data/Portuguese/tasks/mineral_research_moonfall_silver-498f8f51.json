			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota? O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Você chegou na hora certa, Linnea! Estava contando a todos sobre as maravilhas da Prata Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Oh, Prata Lunar, Prata Lunar... tem alguma gema mais perfeita na esfera sublunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Olhe! Sua forma perfeita, sua textura suave e arredondada! E aquela cor branca iridescente combinado com uma afinidade elemental incomparável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "Ao meus olhos, apenas a lua no céu pode se comparar a você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Uhm... é. A Prata Lunar é um minério bonito. Eu mesmo coletei algumas amostras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Viu, eu sabia que você ia entender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Mas, ainda assim, quem realmente entende da Prata Lunar sou eu! Mesmo que você seja uma consultora da Guilda de Aventureiros, eu não vou desistir do primeiro lugar tão facilmente. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "Oh, e já que você é quem costuma ensinar os aventureiros, que tal eu te testar para variar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Eu tenho três pedaços de Prata Lunar aqui. Infelizmente duas delas tem pequenos defeitos. Porém, a última é o meu tesouro mais precioso. A Prata Lunar mais valiosa entre todas as Pratas Lunares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Consegue dizer qual é a mais perfeita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "A da esquerda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Hum? O que Lumi está fazendo?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Eu escolho essa daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Haha, parece que até mesmo você pode se enganar algumas vezes, Linnea. Essa daqui tem um pequeno defeito escondido em um lugar bem discreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Certo, você ganhou. Mas da próxima vez, eu não vou desistir tão facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Por mim, tudo bem. Estou sempre preparado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Linnea acaba participando do evento de apreciação do evento de apreciação de Prata Lunar organizado por Dorota, e ela se divertiu bastante...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Uau, não esperava que todos fossem ficar tão entusiasmados. É uma pena que momentos como esse nunca pareçam durar... Muito bem, hora de arrumar tudo e voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Deixe-me te ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Oh, isso seria ótimo! Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Deixe-me pensar novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "A do meio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Lumi parece ter gostado dessa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Eu escolho essa daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960223,
					"content": "Ah, você também sente isso, não é? Aquela atração irresistível que apenas algo verdadeiramente perfeito pode ter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
