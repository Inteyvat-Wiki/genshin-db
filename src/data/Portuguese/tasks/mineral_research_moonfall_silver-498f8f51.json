			"dialogs": [
				{
					"id": 761960301,
					"content": "Ufa... não faltou nada, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Hum... não, tudo está certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Eu vi você fazendo aqueles desenhos divertidos no chão com a Prata Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Sim! Deu bastante trabalho, mas acho que realmente ajuda a despertar o amor de todos pela Prata Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Falando nisso, ouvi dizer que há um conto popular de Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "É sobre uma garota que originalmente vivia entre as estrelas. Quando ela caiu na terra, ela deixou vários desenhos no chão em sua tentativa de voltar ao céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "No final, o pai dela, o sol que estava nos céus, viu o pedido dela e trouxe ela de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Talvez ele veja os padrões que você criou e acabe se tornando um fã da Prata Lunar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Haha, se esse for o caso, então eu vou ser a melhor embaixadora da Prata Lunar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Mas, comparado a isso, ainda estou mais preocupada em chamar atenção dos pássaros lá de cima. Você sabe, corvos e tudo mais, eles gostam de coisas brilhantes também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "É verdade. E além de corvos, nós também temos que tomar cuidado com as Toupeiras Cheiradeiras e os Furões Ladrões no chão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "E Lumi também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, certo! E Lumi também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Enfim, obrigada pela sua ajuda. Apesar de isso ser apenas uma pequena parte da minha coleção... aqui, fique com ela! Considere isso um presente para Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "Hehe, hoje é um dia de sorte, não é, Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnea"
				},
				{
