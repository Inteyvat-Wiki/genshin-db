			"dialogs": [
				{
					"id": 250260401,
					"content": "Vamos dar uma lição naqueles Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "#Você tá dispost{M#o}{F#a} a vir também? Valeu! Vai ajudar muito — posso ver que você é um{F#a} aventureir{M#o}{F#a} experiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260403,
					"content": "Vou garantir de pagar a você o que as regras da Guilda estipularem. Então vamos lá — vamos mostrar àqueles canalhas como a gente faz as coisas por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teamo"
				}
			]
		},
		{
