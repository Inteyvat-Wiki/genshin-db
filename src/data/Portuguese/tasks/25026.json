			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teamo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "É aqui que ele costuma ficar, mas hoje não há sinal dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260302,
					"content": "Ele deve ter se escondido depois do susto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260303,
					"content": "Vamos procurar por ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "...Não. Vamos deixar ele em paz por um tempo. Vamos só deixar os cogumelos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260305,
					"content": "Vejo que você tem experiência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Cuidando daquele menino? Definitivamente. Eu sei que ele é muito sensível. Só ver estranhos já pode assustá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260307,
					"content": "Só depois que alimentei ele por muito tempo que ele ficou disposto a se aproximar de mim... Mas duvido que ele saia em breve, agora que aqueles vilões bagunçaram tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260308,
					"content": "Vamos precisar deixar ele quieto por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260309,
					"content": "Obrigado por vir junto. Aqui está sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260310,
					"content": "É uma pena a gente não ter conseguido ver ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Não se preocupe, ele lembra daqueles que o trataram bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260311,
					"content": "Adoraria ter conhecido aquele pequeno Yumkassauro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
