			},
			"dialogs": [
				{
					"id": 250260601,
					"content": "...Shh. Olha ali. Ele tá nos esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260602
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260602,
					"content": "...Woo? Mmwoo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260603
					],
					"speakerTitle": "Yumkassauro Tímido"
				},
				{
					"id": 250260603,
					"content": "Venha aqui, criança. Não vamos machucar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260604
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260604,
					"content": "Mwoo? Mmmmrawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260605
					],
					"speakerTitle": "Yumkassauro Tímido"
				},
				{
					"id": 250260605,
					"content": "Eu sou Teamo. Você lembra de mim? Fui eu quem te dei aquela comida deliciosa da última vez.",
					"roleType": "TALK_ROLE_NPC",
