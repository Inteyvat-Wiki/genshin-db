			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teamo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Aquele pobre Yumkassauro... Já deu. Vou mostrar a eles. Vou mostrar àqueles patifes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260102,
					"content": "Vocês podem correr, seus bandidos, mas não podem se esconder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260103,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "#Você é... um{F#a} viajante de longe, não é? Saudações — embora temo que não possa estender minha hospitalidade além disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260105,
					"content": "Aqueles malditos Ladrões de Tesouro estavam querendo pegar aquele Yumkassauro pequeno de novo. Felizmente, eu consegui expulsar eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260106,
					"content": "Mas o pobrezinho ficou muito assustado. Ele não se aproxima, não importa quanto eu chame ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260107,
					"content": "Que seja. Eu já encontrei o esconderijo deles. Vou ensinar uma lição a eles e, quando eu terminar, vou amarrar eles numa árvore e vai ser só chicotada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260108,
					"content": "Além disso, vou ter que encontrar alguma coisa gostosa para confortar aquele pobre Yumkassauro assustado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teamo"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2502601",
							"2"
						],
						"stepId": 2502601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teamo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Sugiro que foque em confortar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Hmm... Você tem razão. Aquela criança já se assustou demais. Tudo bem. Vamos acalmar ele primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260203,
					"content": "#Venha, então. Pelo que parece, você deve ser um{F#a} aventureir{M#o}{F#a} experiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260204,
					"content": "Com nós dois aqui, aqueles ladrões não vão tentar nada. E não se preocupe com o pagamento. Conheço as regras da Guilda e vou seguí-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260206,
					"content": "Aquele pequenino ama comer Cogumelo Castiçal... E se eu me lembro bem, muitos deles crescem debaixo daquela árvore ali. Por que você não começa a colher alguns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260205,
					"content": "Vou coletar Cogumelos Castiçais no outro lado. Quando você terminar com o seu, vamos nos encontrar no penhasco próximo ao Estádio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260207,
					"content": "É aí onde o pequeno Sauriano geralmente descansa. Talvez a gente possa encontrar ele lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teamo"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
