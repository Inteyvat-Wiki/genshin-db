				]
			},
			"dialogs": [
				{
					"id": 250260501,
					"content": "Hunf. Quero ver eles se atreverem a machucar meu Yumkassauro de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260502,
					"content": "Parece que teve algum tipo de mal-entendido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "Não escute as baboseiras deles. Ora, eu vi eles amarrarem uma corda nas asas daquele pobre Yumkassauro com meus próprios olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260504,
					"content": "Quem sabe o que poderia ter acontecido se eu não tivesse aparecido na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260505,
					"content": "Agradeço a ajuda, de toda forma. Aqui está seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Teamo"
				},
				{
					"id": 250260506,
					"content": "É só uma pena que eles fugiram tão rápido. Se a gente tivesse pegado eles, podíamos acabar com a pilantragem deles de uma vez por todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teamo"
				}
			]
		},
