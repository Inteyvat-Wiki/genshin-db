					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090602,
					"content": "Bem, uma vez que tenham terminado, esta tem a certeza de que eles informarão outros humanos, e que estes visitarão este santuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Miau, miau, miau... Parece que, além de \"limpar\" e consertar essa caixa, essa prateleira também é muito importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "Bom, muito bom. Miau, miau, miau! A este ritmo, o santuário certamente será restaurado à sua vivacidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Por que você quer restaurar o santuário, afinal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Miau, miau... Porque, de fato... Eu sou a sacerdotisa chefe provisória, afinal. É dever meu cuidar do santuário, fazer com que muitas pessoas prestem homenagem aqui, fazer deste santuário um lugar animado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "Além disso, Hibiki ficaria muito triste se ela voltasse e encontrasse este santuário todo quebrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Miau, miau, mas, com sua ajuda, ele certamente retornará à sua antiga glória em pouco tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "Eu ainda posso exigir sua ajuda de vez em quando, miau. Não recuse quando chegar a hora, miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
