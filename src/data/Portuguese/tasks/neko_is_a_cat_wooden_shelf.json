				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "Olá, Viajante. O que posso fazer por você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090402,
					"content": "O Suporte de Placa de Oração foi consertado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "É? Você o consertou? Você é mesmo uma alma bondosa, não é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090404,
					"content": "#Fui encarregad{M#o}{F#a} pela sacerdotisa chefe provisória.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "A S-senhorita Neko te encarregou de fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090406,
					"content": "Será que ela notou nossas ações, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090407,
					"content": "Eu não diria isso exatamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Senhorita Etsuko! Vamos até onde está o Suporte de Placa de Oração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090410,
					"content": "Primeiro a Caixa de Oferendas, agora o Suporte de Placa de Oração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090411,
					"content": "Essa sacerdotisa chefe provisória está realmente empenhada em reparar o santuário, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090412,
					"content": "Mas todos os habitantes destas regiões migraram há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090413,
					"content": "Resumindo, ninguém nesta ilha vem prestar respeito a este santuário a não ser nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090414,
					"content": "O que você está tentando dizer, Senhorita Etsuko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090415,
					"content": "...Essa sacerdotisa chefe provisória não percebeu isso? Que motivo ela tem para reparar esse santuário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090416,
					"content": "...Não importa, talvez eu esteja apenas deixando minha suspeita levar a melhor de mim. Podemos ir até aquele Suporte de Placa de Oração, sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090417,
					"content": "Mas eu recomendaria permanecer em guarda como a opção certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090418,
					"content": "Senhorita Etsuko, a Senhorita Neko é apenas uma gatinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090408,
					"content": "Pode-se dizer que sim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
