			"dialogs": [
				{
					"id": 722090501,
					"content": "Você fez um belo trabalho no conserto deste Suporte de Placa de Oração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090502,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Mas quase não é mais possível ver o que está nas Placas de Oração... Quanto tempo será que se passou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090505,
					"content": "Senhorita Etsuko! Encontrei algumas tábuas de madeira nas proximidades e fiz com elas Placas de Oração para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Uma vez que este Suporte de Placa de Oração foi reparado, ele precisa de algumas Placas de Oração penduradas nele, afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Você tem algum desejo, Senhorita Etsuko? Eu posso desenhá-los para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Pendurar uma Placa de Oração neste santuário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090509,
					"content": "Hehe, que pensamento interessante. Passe-me uma dessas tábuas, eu mesma cuidarei do desenho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090510,
					"content": "Bem, parece que eles estão se preparando para colocar algumas Tábuas de Oração, hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Vamos dizer à Neko. Certamente ela ficará satisfeita!",
