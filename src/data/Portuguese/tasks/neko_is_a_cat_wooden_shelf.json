			"dialogs": [
				{
					"id": 722090201,
					"content": "Aquela Placa de Oração parece ter sido destruído à muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "Olá, Viajante. A Srta. Etsuko e eu estamos atualmente investigando a área ao redor deste santuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Embora as diversas instalações do santuário tenham caído em ruínas há muito tempo... No entanto, tudo isso está completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "As pessoas das vilas próximas devem ter vindo a este lugar para prestar respeito. Suponho que sua ruína deve ter algo a ver com a abandonada Vila Koseki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
