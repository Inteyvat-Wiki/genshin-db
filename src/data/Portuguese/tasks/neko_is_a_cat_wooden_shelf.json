				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Mais um dia calmo hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Ah, chegou, já? Eu dormi melhor ontem à noite depois que você limpou o santuário... miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Essas duas pessoas de verde também passaram por aqui para um passeio ontem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Dito isto, nenhum outro ser humano além deles veio aqui para fazer orações. Muito estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "Mas, quando aqueles dois humanos verdes apareceram, eles pareceram bastante interessados naquela prateleira de madeira ali, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Eu lembro Hibiki chamando a própria prateleira de \"Placa de Oração\", e estes pequenos blocos de madeira de \"Placa de Oração\". Parece que muitas pessoas que vieram ao santuário vieram por causa deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Hmm... Isso significa que os humanos amam a madeira? É verdade que muitos visitantes iriam até aquela prateleira de madeira para pendurar pequenos blocos de madeira depois de oferecerem alguma Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "Não acho que seja por causa da madeira, na verdade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "É verdade? Então eles fizeram isso porque adoram cavalos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "O que você quer dizer com cavalos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Seja qual for o caso, a prateleira está quebrada e os blocos de madeira são muito poucos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "Esta não sabe o que os humanos querem com madeira ou cavalos, mas um santuário também deve ter estes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "Deve ser a ruína da prateleira e do santuário que está ficando sem madeira e sem cavalos que ninguém mais aparece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "Como tal, eu devo pedir outra coisa a você - consertar aquela prateleira de madeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "Não se preocupe com isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Agora que você disse isso, devemos ter algum material sobrando de quando consertamos aquela Caixa de Oferendas, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "De tais coisas, eu não entendo uma... Por que vocês humanos amam tanto madeira, afinal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Uh, sabe de uma coisa, não importa... Paimon se lembra que temos algumas peças sobrando. Vamos dar uma olhada ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Seja qual for o caso, eu deixarei a questão da prateleira de madeira para você. Afinal de contas, este santuário não cuidará de si mesmo, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Uma vez que a caixa e a prateleira estejam ambas consertadas, o número de visitantes que vêm aqui deve aumentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "Há quanto tempo esta coisa está em ruínas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Muito tempo. Ela desmoronou antes da caixa, e a caixa caiu em ruínas há muito, muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "Então você não faz ideia, não é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Hah. Eu não acompanho em especial o número de vezes que o sol nasce ou se põe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Bem, deveríamos ter algumas coisas sobrando de quando estávamos consertando aquela Caixa de Oferendas, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "De tais coisas, eu não entendo uma... Por que vocês humanos amam tanto madeira, afinal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090127,
					"content": "Uh, sabe de uma coisa, não importa... Paimon se lembra que temos algumas peças sobrando. Vamos dar uma olhada ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "Seja qual for o caso, eu deixarei a questão da prateleira de madeira para você. Afinal de contas, este santuário não cuidará de si mesmo, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090111,
					"content": "Não tem nada ver com cavalos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
