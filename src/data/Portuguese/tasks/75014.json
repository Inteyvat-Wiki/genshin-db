			"dialogs": [
				{
					"id": 750141201,
					"content": "Hã? Pequenino, você está perdido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141202
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141202,
					"content": "Rawr! Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "Você parece bem animado e saudável, e tem um padrão especial no seu chifre... nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141204,
					"content": "Por que vocês vieram aqui juntos? Há algo errado com meus ensinamentos? Não, isso é impossível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141205,
					"content": "Rawr... Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "Hã? O que há de errado? Ele te trouxe aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141207
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141207,
					"content": "(Não posso deixar ela me descobrir...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "Por que ele está fazendo um barulho tão estranho? Está doente? Também parece estar agindo tão fora do normal. Acho que precisa ser checado cuidadosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141211,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "Não seja impaciente, Pequenino. Logo será sua vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141221,
					"content": "Você é o primeiro. Siga-me. Entendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141213,
					"content": "*Acenar com a cabeça*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "Onde você aprendeu a fazer isso? Oh, minha nossa, você entende o que estou falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141219,
					"content": "#Nesse momento, um barulho bem alto vem de fora...\\n\"Quem abriu a caixa... Ei! Solte! Pare de lutar por elas! Quilla vai ficar irritada logo!\"\\nNão há tempo para descobrir o que aconteceu. Aproveite o caos para fugir do acampamento com {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "*Sacudir a cabeça*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "Onde você aprendeu a fazer isso? Oh, minha nossa, você entende o que estou falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141217,
					"content": "*Seguir ela*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "Isso é estranho — eu não te dei nenhuma instrução ainda. Você entende o que estou dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750141209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				}
			]
		},
