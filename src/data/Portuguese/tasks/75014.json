			"dialogs": [
				{
					"id": 750141001,
					"content": "#{M#Sr.}{F#Srta.} {NICKNAME}! Graças aos céus você está bem. Fiquei tão preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "Foi muito emocionante! Uh, é um pouco difícil descrever, então vamos falar disso depois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Você conta a Taruka o que você viu e ouviu no acampamento...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "Sério? Você viu a Srta. Quilla, mas não Lamizana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Bem, eles mencionaram uma corrida aérea e uma transação. Paimon não sabe os detalhes, mas parece que é algo que será usado durante a corrida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Srta. Quilla é uma comerciante que só chegou recentemente. Segundo Paran, ela vende todo tipo de mercadorias. Lamizana pode ter comprado alguns itens perigosos com ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Algo perigoso que ele precisa para fazer seu plano perigoso durante a corrida aérea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Que tipo de plano perigoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Não sei... mas tenho certeza que ele está planejando algo perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Isso é ótimo! Então aqui está você. Você deve ser {NICKNAME}. Lamizana me contou que você experimentou a pista de treino e se saiu muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Não foi nada de mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "Essa é a situação. A corrida aérea está prestes a começar, mas o competidor que deveria competir contra Lliwa abandonou no último minuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "Ah, como Taruka também sabe, ela sempre foi extremamente competitiva, então ela não vai ficar feliz se ganhar sem uma corrida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Então ela também pode sair da corrida. O que também é justo — vou convencer ela agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "I-Isso não vai ser nada bom! Ela também se preparou bastante para essa corrida, então a melhor solução é encontrar alguém tão bom quanto ela para competir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#Foi por isso que você veio até {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "Sim. Se você participar, te daremos uma recompensa mesmo se você terminar ou não com uma classificação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Você realmente está me menosprezando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "Uh? Oh, você tem razão... Bem, se você terminar com uma classificação, te daremos a recompensa da classificação e uma recompensa bônus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Obrigado por concordar! Você receberá uma carta de convite. Tenho outros preparativos para fazer, então provavelmente não te verei até o dia da corrida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran sai, deixando Garef Uivo com ele...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#{NICKNAME}, você disse sim, pois nos daria a chance de investigar mais de perto, não é? Se algo acontecer durante a corrida, os competidores seriam definitivamente os primeiros a saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "Eu tenho a sensação de que as coisas não são tão simples quanto parecem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "A propósito, a voz de Paran parece meio familiar. A gente já ouviu em algum lugar recentemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Ele está encarregado de tudo por aqui na escola de voo. Ele e Garef Uivo estão sempre correndo por toda parte, então seria estranho se você nunca tivesse ouvido a voz dele antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "Faz sentido! Pensando nisso, Paimon parece ter lido sobre algo assim em uma história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Se alguém que se mistura com o ambiente comete um crime, as pessoas normalmente não pensam nessa pessoa porque estão acostumadas com a presença dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Hmm... Provavelmente é melhor não dizer isso na frente dele. Sua família foi exilada, pois um membro dela cometeu algo horrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "As pessoas sempre usam isso como uma desculpa para tornar as coisas difíceis para ele... Talvez esse seja o motivo dele ser tão rigoroso consigo mesmo, mas tão atencioso com os outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Embora ele seja bem próximo de Lamizana, tenho que admitir que ele é um cara bem legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Lamizana é algum tipo de praga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Acho que até pragas são centenas de vezes mais fofas do que ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "Valeu por contar isso a Paimon! Seria péssimo se a gente machucasse ele, mesmo que por acidente. Enfim, sobre a corrida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Taruka, você não precisa se preocupar com sua irmã, pois {NICKNAME} vai cuidar dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Hmm... Estarei esperando por vocês perto da linha de chegada. Lamizana e eu devemos terminar primeiro, então vou ficar de olho nele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Ainda não chegou sua hora de brilhar, {REALNAME[ID(2)|SHOWHOST(true)]}. Só aproveita o show com Paimon dessa vez, beleza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141046,
					"content": "Waah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141040,
					"content": "Parece que a vida é difícil para ele também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "Não, eu só quero o prêmio de participação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "#Você deveria ir com o que Paimon disse mesmo que seja só para te fazer parece descolad{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "Ótimo, um prêmio de participação garantido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "#Você deveria ser um pouco mais ambicios{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "O quê? Como ele ousa me menosprezar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "Não, não foi isso! O que Temach diria em uma situação dessas... Já sei! A pista de treino que não estava à sua altura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141015
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141009,
					"content": "Mas qual é o motivo dele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				}
			]
		},
