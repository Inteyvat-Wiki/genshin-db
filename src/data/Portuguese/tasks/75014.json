			"dialogs": [
				{
					"id": 750140801,
					"content": "(Hmm... Paimon não consegue ver claramente daqui, mas eles podem acabar nos vendo se nos aproximarmos. É melhor ouvir de onde estamos por enquanto.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "Estamos realmente felizes com a qualidade do último lote de mercadorias. Conto com vocês mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Kuyan"
				},
				{
					"id": 750140803,
					"content": "Por nada. Devemos fazer o mesmo de sempre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140804,
					"content": "Sim, e deve ser entregue antes da corrida aérea, pois algumas pessoas vão precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Kuyan"
				},
				{
					"id": 750140805,
					"content": "Sem problemas. Acho que eles estão quase terminando por lá. Podemos ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140806,
					"content": "(Hã? Eles já estão saindo? Isso não é o que Paimon imaginou... Deveríamos voltar primeiro. Não deixe eles perceberem você.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
