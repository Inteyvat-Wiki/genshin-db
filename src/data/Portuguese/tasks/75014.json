						750141325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141325,
					"content": "É verdade que ninguém pode acusar os Iktomissauros... ou você, mas não diga algo tão assustador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141326,
					"content": "E-Enfim, Paimon só estava se adaptando à situação! Você não teria conseguido fugir se Paimon não tivesse feito algum barulho do lado de fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141327,
					"content": "Coincidentemente, a caixa estava cheia de Bolachas Saurus. Os Iktomissauros voaram nelas depois que a caixa foi derrubada. Foi uma verdadeira bagunça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141328,
					"content": "Mas Paimon também não viu Lamizana do lado de fora. Mais cedo, Paimon não conseguia ver as duas pessoas claramente, mas eles não devem ser Lamizana, pois suas vozes soavam diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141329,
					"content": "Hmmm... de qualquer forma, vamos contar a Taruka o que vimos e ouvimos mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
