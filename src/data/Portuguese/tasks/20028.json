			"dialogs": [
				{
					"id": 200280101,
					"content": "#Obrigado, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280102,
					"content": "Eu posso ser um caçador por profissão, mas com certeza encontrei meus rivais com esses malditos Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280103,
					"content": "Graças a eles, mais uma vez voltarei de mãos vazias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280104,
					"content": "Espero que os outros caçadores não tenham a mesma sorte que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280105,
					"content": "Falando sobre os Slimes, você poderia dar uma olhada ao redor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280106,
					"content": "Pode ser apenas minha imaginação... eles parecem estar aparecendo em cada vez mais quantidade ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280107,
					"content": "Você pode procurar por slimes na estrada à frente? Se você vir algum... Já sabe o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280108,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Você está me fazendo um grande favor. Bem, é melhor eu voltar e reportar ao Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280111,
					"content": "Espero que ele não esteja bêbado a ponto de entrar por um ouvido e sair pelo outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 200280109,
					"content": "Ainda tenho outro assunto para tratar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "A única pessoa que pode resolver isso é você, pelo bem todos no Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Medroso"
				}
			]
		}
