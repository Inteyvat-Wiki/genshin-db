			"dialogs": [
				{
					"id": 721850301,
					"content": "Viajante, você voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850302,
					"content": "E então? Que resposta lhe deram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850303,
					"content": "Sobre a opinião dos clientes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "A Pizza de Cogumelos original... Hmm, posso tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850305,
					"content": "Os ingredientes necessários para prepará-la são Queijo, Repolho e Cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850306,
					"content": "Nós temos os outros ingredientes, mas geralmente não guardamos Queijo aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850307,
					"content": "Viajante, você poderia me trazer uma porção de Queijo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850308,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "Estou contando com você. Só uma porção de Queijo já basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850310,
					"content": "Vocês realmente não usam Queijo no restaurante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "Não é que não usemos, apenas que usamos raramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850312,
					"content": "Afinal de contas, não são tantos pratos no restaurante que precisam dele, por isso não mantemos muito Queijo em estoque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850313,
					"content": "De qualquer maneira, estou contando com você, Viajante. Por favor, traga uma porção de Queijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
