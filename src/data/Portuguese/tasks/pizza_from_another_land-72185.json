			"dialogs": [
				{
					"id": 721850201,
					"content": "*Suspiro* Será que há algo no mundo que irá satisfazer meu paladar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "Sobre a pizza do Restaurante Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Oh, a pizza que você mencionou tem um gosto ótimo. E muitos ingredientes locais também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "Entretanto, eu já provei a autêntica Pizza de Cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "Lembro que a pizza era feita de Queijo, Repolho e Cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Hahaha, apenas acho que para iguarias estrangeiras é melhor que elas mantenham seu sabor autêntico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
