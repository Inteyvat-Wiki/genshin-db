			"dialogs": [
				{
					"id": 722610401,
					"content": "Ainda bem que lhe encontramos! Você está bem, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610402,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610403,
					"content": "Não se preocupe, está tudo bem. Mas não saia por aí correndo na próxima vez, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610404,
						722610408,
						722610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610404,
					"content": "Paimon, você parece ser a irmã mais velha dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610405
					]
				},
				{
					"id": 722610405,
					"content": "Paimon é mais velha que Kichiboushi, é claro que Paimon é a irmã mais velha dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610406,
					"content": "Não parece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610407
					]
				},
				{
					"id": 722610407,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610412,
					"content": "#Mmmh! Obrigado {NICKNAME}, obrigado Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610413
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610413,
					"content": "Kichiboushi quase selado! Muito assustador. Mas Paimon chamando Kichiboushi, não ter mais medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610414
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610414,
					"content": "Ah, sim. Ioroi nos disse que alguns Tanukis pequenos também foram selados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610415,
					"content": "Dentro do âmbar, assustador. Escuro, não poder ver. Não poder falar. Não poder \"caboom\"! Como virar pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610416
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610416,
					"content": "Ioroi é pedra, mas ainda muito poderoso. Pode falar, pode ver. Mas não se mover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610417,
						722610420
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610417,
					"content": "Kichiboushi, você quer ajudar Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610418
					]
				},
				{
					"id": 722610418,
					"content": "Hmm. E então, ajudar outros Tanukis de pedra também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610419
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610419,
					"content": "Mas nós estamos aqui com você, Kichiboushi. Não deixaremos que você seja selado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610422,
					"content": "Uhul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610423
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610423,
					"content": "Mas você tem que se comportar bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610424,
					"content": "Hmm. Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610425
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610425,
					"content": "Bom tanuki! Que tal pararmos por aqui? Você deve estar cansado, Kichiboushi, precisa descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610426,
					"content": "Kichiboushi não cansado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610427
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610427,
					"content": "Argh, que dor de cabeça. Se Kichiboushi não se comportar, Paimon não sabe para onde iremos a seguir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610428,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610429
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610429,
					"content": "Kichiboushi é forçado a admitir que está cansado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610430
					]
				},
				{
					"id": 722610430,
					"content": "Ufa! Kichiboushi realmente é como uma criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610431,
					"content": "E você está lidando com crianças melhor, não é, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610432
					]
				},
				{
					"id": 722610432,
					"content": "Mesmo? Talvez seja porque Paimon está viajando com você por tanto tempo, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610433,
						722610435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610433,
					"content": "Oh, está me tratando como uma criança?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610434
					]
				},
				{
					"id": 722610434,
					"content": "Não, não! Nós conhecemos muitas crianças, como Pequena Ming e Changchang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610437,
					"content": "Paimon aprendeu muito ao viajar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610438,
					"content": "E dessa vez, a lição é... Bake-Danuki e Adepti talvez não se deem bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610439,
					"content": "Temos que pensar um pouco sobre a nossa próxima parada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610435,
					"content": "Hmm, pensando bem, não tivemos a chance de cuidar de muitas crianças...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610436
					]
				},
				{
					"id": 722610436,
					"content": "Exatamente! Como Pequena Ming e Changchang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610420,
					"content": "Vamos lhe proteger.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610421
					]
				},
				{
					"id": 722610421,
					"content": "Sim! Se nós estivermos aqui, você não será selado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610408,
					"content": "Paimon, você parece a mãe dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610409
					]
				},
				{
					"id": 722610409,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610410,
					"content": "Paimon, você parece a avó dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610411
					]
				},
				{
					"id": 722610411,
					"content": "#\"Ooh, {NICKNAME}, você precisa comer mais. Você ainda está crescendo! Se não comer, como irá crescer?\"",
