			},
			"dialogs": [
				{
					"id": 722610101,
					"content": "Ei... Formatador de Montanha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610102,
					"content": "Ei! Montanhão—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610104,
					"content": "Que dor de cabeça! O Adeptus parece não estar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610105,
					"content": "Não sejamos rudes com o Adeptus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "Paimon, o que é Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610107,
					"content": "Hum... Os Adepti são pessoas ou animais muito especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610108,
					"content": "Como Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610109,
					"content": "Uh, não exatamente! Eles têm poderes fascinantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610110,
					"content": "Também podem caboom? Então, Kichiboushi também Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610111,
					"content": "Hmm... Os Adepti são bem mais antigos, e eles também possuem um certo... Prestígio? Dignidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610112,
					"content": "Oh, então Kichiboushi não Adeptus. Ioroi é Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610113,
					"content": "Urgh, isso é bem difícil de explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610114,
					"content": "Os Adepti são guardiões antigos que protegem Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "Oh, Kichiboushi entende. Ioroi protege a Floresta Chinju, por isso, não é Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610116,
					"content": "Paimon tem certeza que não é exatamente isso, mas se é assim que você vai entender, tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610117,
					"content": "Mas já que estamos de frente para essa morada Adepti, vamos tirar uma foto de Kichiboushi aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610118,
					"content": "Hmm! Kichiboushi posar para foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610119,
					"content": "Muito bem, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7226102,
