			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"\"Kichiboushi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "Ótima foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610202,
					"content": "Mhahaha! Kichiboushi bonito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610203,
					"content": "Esse garoto não tem humildade nenhuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610204,
					"content": "Oh, sim, Paimon. Que magia Adepti usam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610205,
					"content": "Os Adepti são super poderosos! Por exemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610206,
					"content": "Esse âmbar daqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "O que é âmbar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610208,
					"content": "Oh, Paimon se lembra. Formatador de Montanha possui flores que podem criar âmbar para prender coisas más dentro de si que invadem sua terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610209,
					"content": "Montanhão incrível. Proteger Liyue, prender coisas más.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610210,
					"content": "Muito tempo atrás, os Quatro Oni de Ogata foram na floresta e intimidaram muitos Bake-Danuki. Ioroi se transformou em um oficial e os deu comida Bake-Danuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610211,
					"content": "Depois, Ioroi e Rei Otogi jogaram eles em papel e selaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610212,
					"content": "Bem, também existe esse tipo de história. Não surpreende quando ele entrou em pânico quando viu a foto de Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610213,
					"content": "Ioroi não é Adeptus, não defender Liyue. Mas Ioroi proteger floresta. Ele proteger tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610214,
					"content": "Pessoas diferentes possuem coisas diferentes que precisam defender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610216,
					"content": "Você vai entender quando crescer, Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "É por isso que você tem que treinar bastante e se tornar um Bake-Danuki muito forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610218,
					"content": "Hmm! Sim! O Bake-Danuki famoso no mundo, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610219,
					"content": "Paimon tem curiosidade de saber como Ioroi se parecia antes de ser selado. Ele provavelmente era muito divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610220,
					"content": "Ah! A Paimon lembrou de repente que alguns Ladrões de Tesouro também ficaram presos no âmbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610221,
					"content": "#E eles até pensaram que éramos mensageir{M#os}{F#as} Adepti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "Parece que séculos se passaram desde então... Mas na verdade aconteceu não faz muito tempo, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610223,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610224,
					"content": "Bom, depois que chegamos em Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610225,
					"content": "#\"O Ritual de Descensão só acontece uma vez ao ano! Hahaha, eu, {NICKNAME}, comerei toda aquela comida deliciosa! Vamos lá, Paimon, vamos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610226,
					"content": "\"E todas as oferendas, também! Paimon irá voar até lá agora mesmo!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610228,
					"content": "Não fale besteira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "Certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610230,
					"content": "Você explica o que aconteceu em Liyue de forma simples.\\nVocê para na parte em que foi procurar os adepti em Minlin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#.... E então, {NICKNAME} e Paimon foram para o local do Pavilhão de Liuli que estávamos antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610232,
					"content": "Montanhão e Nuvenzona incríveis. Construíram casa que se move!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610233,
					"content": "Nuvenzo... Retentora de Nuvem adora muito comida gourmet! Nós tivemos que fazer muitos pratos deliciosos na época antes de poder conhecê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610234,
					"content": "Esfomeada, como Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610235,
						722610236
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610235,
					"content": "Feito a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610238,
					"content": "Paimon é Adeptus? Paimon muito poderosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610239,
					"content": "Bem, isso é um pouco complicado. Foi um elogio, mas Paimon não se sente muito bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610240,
					"content": "De qualquer forma, Paimon não é uma Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610241,
					"content": "Quero brincar com Adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610242,
					"content": "Os Adeptus geralmente não aparecem perante as pessoas. Mas nós podemos dar uma olhada ao redor. É bem legal aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722610243,
					"content": "Kichiboushi, vá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722610236,
					"content": "Ela pode voar também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
			]
		},
