			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "Eu tenho um tesouro que gostaria de vender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "Er... Na verdade, já temos os nossos fornecedores fixos. Geralmente não temos o hábito de colecionar objetos estranhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720104,
					"content": "Mas olhando para sua impressão, acho que você deve ter algo de interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720105,
					"content": "Bem... Por que você não deixa eu dar uma olhada nisso então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720106,
					"content": "Você conta a Mikoshi Genichirou a história da Pérola Osso de Dragão.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720108,
					"content": "Vou ser sincero com você, embora esta história seja muito interessante, mas é um pouco estranha demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720109,
					"content": "Este tipo de coisa está além da minha compreensão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720110,
					"content": "Não ria. Eu sou apenas um simples artesão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720120,
					"content": "Vamos fazer assim: 8.000 Mora, e o máximo mais 5 Pratos de Sashimi, este tipo de prato não é barato não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720111,
					"content": "Se você aceitar esse preço, eu vou comprar este tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720112,
					"content": "...Para que você vai usá-lo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "Não tenho certeza agora. Eu preciso pensar um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720114,
					"content": "Se a situação estiver boa, talvez eu possa transformar isso em uma miniatura de netsuke e vender por um bom preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720115,
					"content": "É um preço justo. Feito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "Nesse caso, fique com esse Mora. Eu farei um bom estudo nisso daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720117,
					"content": "Deixe-me pensar mais um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "Me parece justo. Preciso pensar nisso um pouco também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720119,
					"content": "Você pode voltar para me procurar quando tiver pensado o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				}
