				"points": []
			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "Que dor de cabeça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "Oh? Ele é um dos nossos hóspedes? Desculpe, mas está meio estranho nos arredores recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030104,
					"content": "Nossos convidados continuam sendo atacados por monstros próximos e agora, muitos agora estão menos inclinados a ficar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030105,
					"content": "Se esse padrão continuar, as coisas eventualmente vão sair do controle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030106,
					"content": "A julgar pelo seu traje, você é um viajante, correto? Você se importaria de cuidar disso em nome da pousada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "#Muito obrigada. Você é muito simpátic{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030113,
					"content": "Portanto, é melhor que você lide com isso em vez disso. Eu terei a certeza de providenciar uma compensação adequada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030108,
					"content": "Os monstros são perigosos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "Perigoso? Na verdade, não muito. Na realidade, são a menor das minhas preocupações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030111,
					"content": "Mas o problema é que... se um dos monstros infelizmente encontrar um certo jovem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030112,
					"content": "Quando ele lida com os monstros, nunca pensa na ocasião ou pessoas presentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
