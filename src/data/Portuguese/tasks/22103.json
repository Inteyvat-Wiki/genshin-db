			"dialogs": [
				{
					"id": 221030201,
					"content": "Está tudo resolvido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Ainda não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Apresse-se, por favor. O jovem cavalheiro tende a aparecer sem aviso prévio e desaparecer sem deixar rasto. Não há como dizer quando ele estará aqui a seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "Se ele aparecer no evento, com certeza tenho que fechar o meu albergue por alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
