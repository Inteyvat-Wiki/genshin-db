						221030302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030302,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Excelente! Agora poderei voltar a trabalhar em paz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030304,
					"content": "Aqui. Sua remuneração, conforme acordado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030305,
					"content": "Quem é aquele \"certo jovem\"? Você nunca o viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030306,
					"content": "De vez em quando, ele descansa aqui em cima, talvez você já tenha visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030307,
					"content": "Mas se você o notar, tente não incomodá-lo. Ele prefere ficar sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		}
