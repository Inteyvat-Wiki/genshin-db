				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291301,
					"content": "O Sauriano Voador está aberto o dia todo! Se deseja se juntar ao treinamento especial de Matahga, então venha decolar no Sauriano Voador! Observação: Assim como um treinamento sério e proativo é algo para se ter orgulho, então a preguiça e a negligência são motivos para se ter uma grande vergonha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291302,
					"content": "Se não trabalharmos duro hoje, nós seremos tão inúteis como o lixo amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291303,
					"content": "Apenas aqueles que seguirem em frente bravamente saberão verdadeiramente a grandeza de ser um cavaleiro Sauriano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7500001",
