			},
			"dialogs": [
				{
					"id": 750290701,
					"content": "#Maravilhoso! Você me superou, guerreir{M#o}{F#a}! Mas não comece a fazer corpo mole agora — continue se esforçando para se tornar {M#um herói}{F#uma heroína} ainda mais incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502908,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
