				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291401,
					"content": "A ordem é: <color=#00E1FFFF> Sopre primeiro a trombeta esquerda, então o da direita, e depois o da esquerda de novo </color>! Não misture as coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291402,
					"content": "(Parece um lembrete que alguém chamado Matahga deixou para si. Você consegue sentir realmente a intensidade das emoções nas suas palavras.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291403,
					"content": "(Mas certamente colocar pontos de exclamação no fim de todos os lembretes é o mesmo que não colocar nenhum... não é?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
