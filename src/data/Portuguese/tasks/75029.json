			"dialogs": [
				{
					"id": 750290101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290102,
					"content": "Errr, olá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "Bahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290105,
					"content": "Arg! Você quase matou Paimon do coração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290106,
					"content": "Imagino que você também esteja aqui pelo treinamento especial!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290107,
					"content": "Eu sabia, eu sabia! Seja humano ou Sauriano, guerreiros ambiciosos são sempre atraídos uns aos outros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290108,
					"content": "Bem, então, sem mais delongas, vamos direto para o treinamento especial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290109,
					"content": "Então eles também têm isso por aqui, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "Sequer demos uma palavra! O que te faz pensar que estamos aqui pelo seu treinamento especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290112,
					"content": "Mas, da forma que você fala... Você não é algum tipo de Mestre Treinador, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290113,
					"content": "Não é qualquer um que pode se tornar um Mestre Treinador, sabe. Não sou tão habilidoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290114,
					"content": "Mas espera, você quer dizer... Você não voou até aqui para ter um treinamento de guerreiro especial de mim, Matahga!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "Matahga",
					"speakerSubtitle": "Reserva de Guerreiro do Clã das Plumas de Flores"
				},
				{
					"id": 750290115,
					"content": "Só estamos de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "Voar em cima de um Sauriano mostra que você sabe o básico, mas tamanha falta de ambição... que desperdício!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290118,
					"content": "#Achei que você era {M#um guerreiro}{F#uma guerreira} que pensava da mesma forma... que pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290119,
					"content": "Parece que eu te julguei mal... Honestamente, que lástima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290120,
					"content": "Paimon deveria dizer que Natlan certamente é uma nação de heróis, ou que seu povo só tem o sangue quente mesmo? Até as crianças são super animadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290121,
					"content": "Crianças? Não é bem assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "É o total oposto! Preguiça não é desculpa uma vez que você decidiu se tornar um guerreiro! Aqueles que não têm coragem, determinação e ambição jamais terão sucesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290124,
					"content": "E eu já tenho doze anos! Parei de ser uma criança no momento que cheguei aos dois dígitos... Mas, eu te perdoo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290125,
					"content": "Claro, minha altura não mudou, não importa o quanto de leite eu beba, mas minha determinação? É inquebrável e forte suficiente para derrubar qualquer obstáculo em meu caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290126,
					"content": "#Além disso, ainda estou crescendo, e não é como se vocês fossem tão alt{M#o}{F#a}s também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290127,
					"content": "Q-Quanta energia! Mas por que você nos arrastou para isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290128,
					"content": "Hnf! Admito que a força física de uma pessoa depende de seu físico, mas um guerreiro de verdade jamais deixaria isso se tornar uma limitação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290129,
					"content": "A mente domina o corpo, em qualquer dia da semana... E isso precisa de fé e crença em seus próprios sonhos e ambição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290130,
					"content": "Até aventureiros devem ser capazes de entender verdades tão simples!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290131,
					"content": "O que ele disse faz sentido, mas... Para Paimon quase soa como se... ele estivesse tirando onda com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290132,
					"content": "É.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "#Eu estava explicando a necessidade de ambição para pessoas preguiçosas como você. Você jamais vai ser {M#um herói}{F#uma heroína} de verdade se você é sempre tão relaxad{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290135,
					"content": "Como um guerreiro... Não, como uma pessoa... Sem ambição e trabalho duro nos campos de treinamentos, você não é nada além de um fracasso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290136,
					"content": "Se você não consegue voar pelos céus como um herói, ou receber o reconhecimento de um Mestre Treinador, então você não é nada além de um fracasso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290137,
					"content": "Então você precisa treinar bastante! Entendido!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290138,
					"content": "E-Entendido! Uh... O que fazemos agora? Ele fala tão alto e tudo que ele diz é razoável, isso é impossível de Paimon debater!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290139,
					"content": "#Ótimo! Se você está pront{M#o}{F#a} para aprimorar suas habilidades, venha me ver para ter alguns treinamentos especiais! Seu objetivo é voar seu Sauriano a toda velocidade ao longo da pista e marcar a pontuação mais alta que conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290140,
					"content": "Durante o treinamento, observarei e pontuarei as performances em cada ponto de verificação. Os resultados serão divididos em quatro categorias baseado nessas pontuações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290141,
					"content": "Voem o mais rápido que puderem! Mesmo que não consigam chegar à maior categoria, pelo menos, vocês devem chegar à segunda maior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290142,
					"content": "Agora, é hora de vocês se animarem, e não deixem que minha sombra coloque vocês para comer poeira! Vai, vai, vai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290143,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "#Guerreir{M#o}{F#a}, aguardo sua resposta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290145,
					"content": "E-Entendido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "Não consigo te ouvir, você precisa FALAR MAIS ALTO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290147,
					"content": "ENTENDIDO!!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "É aqui que guerreiros aspirantes vêm para aprimorar suas habilidades. Agora, me mostre sua determinação e nunca pare de desafiar seus limites!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290149,
					"content": "#Venha falar comigo para treinar quando estiver pront{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290150,
					"content": "Entendido! Mas, prefiro não fazer isso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "O quê!? Você ainda se recusa a largar sua preguiça!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290152,
					"content": "Que coisa deplorável! Mas, não importa. Chegará um dia em que você não mais será capaz de tolerar suas falhas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290153,
					"content": "Ficar fugindo e com medo para sempre não vai te levar a lugar nenhum, e te deixar sem nada! Apenas a seguir adiante que você pode esperar se sobrepor e fazer o mundo ressoar com sua risada estrondosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290154,
					"content": "Hnf, marque minhas palavras! Mas mesmo quando esse momento chegar, não será tarde demais para vir se aperfeiçoar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290133,
					"content": "Por que você está tirando onda com a gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "Isso é meio extremo, moleque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "#Nunca subestime a curiosidade de {M#um aventureiro}{F#uma aventureira}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "O que você quer dizer com \"treinamento especial\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502904",
							"2"
						],
						"stepId": 7502904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "Maravilhoso, excepcional! Você me superou, me ultrapassou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290202,
					"content": "Tenho mantido meu treinamento especial, sozinho, na esperança de um dia conseguir quebrar meu próprio recorde. Infelizmente, isso é algo que eu ainda não consegui fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290203,
					"content": "Mas você conseguiu! Você provou para mim que eu deveria sair desse lugar, já que deve haver muitos outros Valentes no mundo cujos feitos superam os meus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290204,
					"content": "Certamente conseguirei melhorar treinando e trocando dicas com eles. Um dia, meu pai e minha irmã reconhecerão minhas conquistas — apenas espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290205,
					"content": "Tirando Acomitl, claro. Esse preguiçoso não tem nenhuma ambição. Tenho vergonha de chamá-lo de meu irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290206,
					"content": "Acomitl...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "Uh, deixa para lá. Chega de conversa fiada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290208,
					"content": "#Guerreir{M#o}{F#a}, me escute agora! Nunca pare de aperfeiçoar suas habilidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290209,
					"content": "Se você deseja virar uma lenda, você deve ir em frente com toda sua força! Em frente, ouviu, em frente! Essas palavras são meu presente de despedida para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502906",
							"2"
						],
						"stepId": 7502906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "#Guerreir{M#o}{F#a}! Como está indo seu treinamento nesse percurso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290502,
					"content": "Estou fazendo progresso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "Pah, fraco! Se você não está dando um passo para frente, então é um passo atrás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290506,
					"content": "Ugh, como que a Paimon deve dizer isso... parece que \"em frente\" e os seus sinônimos são as únicas palavras no dicionário de Matahga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290507,
					"content": "Isso mesmo, eu sou mais focado do que os outros! Sabe por que? Porque a única coisa que reconheço é o trabalho duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290508,
					"content": "Você precisa treinar, e eu também. Apenas treinar para trabalhar com Saurianos não me fará um guerreiro todo-poderoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290509,
					"content": "Eu tenho que procurar um palco maior para me aperfeiçoar! E isso significa que estarei saindo por algum tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290510,
					"content": "Não se preocupe! Manterei o curso daqui intacto, mas irei desmontar essa cabana e levá-la comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290511,
					"content": "Aonde você vai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "Oh... Vou ver meu pai e minha irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290515,
					"content": "Hã? Matahga não está soando tão confiante quanto antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290516,
					"content": "E o que tem de errado com isso? Amar e respeitar sua família é uma virtude que todo guerreiro deveria possuir! Não seja tão mente fechada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290517,
					"content": "Meu pai é o Mestre Treinador mais profissional de todo Clã das Plumas de Flores, e a minha irmã é a melhor montadora de Saurianos! Estou muito orgulhoso deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290518,
					"content": "Ei, calma aí! Paimon não estava querendo questionar a decisão deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290519,
					"content": "Entendo. Boa sorte então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "#Boa sorte para você também, guerreir{M#o}{F#a}! As palavras que deixarei com você dessa vez são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290521,
					"content": "#Deixe-me pensar... Nunca desista! Se torne {M#um herói}{F#uma heroína}, não importa o que custe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290513,
					"content": "Como planeja treinar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "Hmm... Pedirei pelas opiniões deles antes de decidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290504,
					"content": "Não tenho tido tempo para treinar recentemente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "Quanta indolência! Não me diga, você esteve gastando sua vida com perambulações sem sentido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
