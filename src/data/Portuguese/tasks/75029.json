			},
			"dialogs": [
				{
					"id": 750290601,
					"content": "Você não foi tão ruim assim, então continue dando seu melhor. Sei que você consegue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290602,
					"content": "#Pah, você não realmente achou que essas seriam as minhas palavras de despedida, achou? Não! Ser \"não ruim\" e \"se bastar\" não é o jeito de {M#um guerreiro}{F#uma guerreira}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290603,
					"content": "#Você deve apenas focar em ser {M#o}{F#a} melhor! Qualquer um que falhar nisso é uma falha, simples assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "Desde que você ainda tenha a coragem, então continue tentando! Treine até que consiga me superar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502907,
