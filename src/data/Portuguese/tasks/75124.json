							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "*Suspira* Ele correu para longe de novo. Argh, só resta um na área de natação... O que vamos fazer agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Quanto tempo isso vai durar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Hã, parece que tem alguém tirando fotos... dos Pássaros do Fluxo Aéreo daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Bem, eles são bem fofinhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Sim, e como eles ficam balançando de um lado para o outro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Né? São tão fofinhos, balançando enquanto andam. E depois viram uma bola e flutuam na água... ah, isso deixa Paimon feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Isso aí, esse é o espírito, jovem senhorita de prata! De verdade, o criador desses Pássaros do Fluxo Aéreo merece todos os elogios que esse mundo pode lhe oferecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "Fantástico... ah, espere, ainda não me apresentei. Eu sou um entusiasta fotógrafo de Pássaros do Fluxo Aéreo. Podem me chamar de Jonvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Claro! Paimon se chama Paimon, e ess{F#a}{M#e} aqui é {NICKNAME}... Ainda assim, por que você tá suspirando deprimido aí? Não tá cheio de Pássaros do Fluxo Aéreo por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "Essa é uma longa história, mas vou resumir. Há muitos como eu, e todos nós queremos tirar fotos interessantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "E alguns dias atrás, bolei uma ideia genial... isto é, colocar todos os Pássaros do Fluxo Aéreo no meu enquadramento em anéis de natação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "E qual o propósito disso, exatamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Claro, o significado é que não há significado aqui. Pássaros do Fluxo Aéreo podem nadar, e tal, e fazer eles usarem esses anéis de natação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "É uma coisa tão vazia quanto o significado de ganhar Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Parece que você tá colocando muita coisa nos ombros deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "Sim, isso é o que chamam de \"fotografia surrealista\", alguém deve procurar significados mais profundos nas fotos... infelizmente, tivemos alguns problemas nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Como esperado, Pássaros do Fluxo Aéreo reais não usam anéis de natação, e assim, não podem tirar fotos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Você que chamou de surreal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Espera... podíamos colocar os anéis de natação em todos os Pássaros do Fluxo Aéreo, não? Vamos, {NICKNAME}. Vamos ajudar ele, de um entusiasta de Pássaros do Fluxo Aéreo para outra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Uhul, isso, cooperação entusiasmada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Espera, sério? Você me ajudaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Hehe, desde que você nos dê algumas fotos legais quando terminar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "B-Bem, fico te devendo uma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "#Prefiro esquilos-voadores, para ser sincer{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Ei, agora não é hora dessa conversinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "Claro, isso não é algo que uma pessoa normal teria considerado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Quando Pássaros do Fluxo Aéreo, que podem flutuar na água, usam anéis de natação, isso criará um superfluxo de significados em camadas na foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "Assim, corporificar suficientemente os temas de \"uso exacerbado\" e \"desperdício\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "Prefiro Esquilos-Voadores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Bem, eles também são fofinhos, mas dá pra dizer que os Esquilos-Voadores são mais fofos do lado da cara de um Pássaro do Fluxo Aéreo nadando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
