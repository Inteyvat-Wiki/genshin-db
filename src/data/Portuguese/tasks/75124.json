			"dialogs": [
				{
					"id": 751240301,
					"content": "Ah, momento perfeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Mal consigo acreditar que minha aventura fotográfica, que achava ser impossível, apesar de tanto trabalho, foi completada tão rapidamente com sua ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Todos esses Pássaros do Fluxo Aéreo com seu balançado, e com suas formas circulares sentando nos anéis de natação! É tão lindo que quero chorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "É tão emocionante assim mesmo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Às vezes, a busca de nossa vida é algo que outras pessoas não entendem, e chegam até a considerar um absurdo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Ainda assim, acredito que o número de pessoas que amam os Pássaros do Fluxo Aéreo aumentará, desde que eu continue tirando essas fotos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Paimon também acredita cem por cento nesse futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "#Ah, muito obrigado a vocês d{M#ois}{F#uas} pela ajuda! Por favor, aceitem isto como um sinal da minha gratidão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
