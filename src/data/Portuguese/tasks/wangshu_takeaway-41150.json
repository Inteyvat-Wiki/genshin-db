					"nextDialogs": [
						411500304
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>Não seja afetado por nenhum elemento, ou os sabores serão misturados</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 411500305,
					"content": "Se a comida ficar ruim, volte até mim que eu a farei de novo.",
