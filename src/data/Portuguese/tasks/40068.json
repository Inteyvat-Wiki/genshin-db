			"dialogs": [
				{
					"id": 400680901,
					"content": "Uau! Que flor enorme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680902,
					"content": "Está tão quente aqui... Tem algo a ver com aquela flor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680903,
					"content": "Uau, isso aí, não estava esperando visitantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680904
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680904,
					"content": "Aaaah! Ela fala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680905,
						400680906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680905,
					"content": "O esquilo de ontem também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				},
				{
					"id": 400680907,
					"content": "Paimon sabe! Mas isso é diferente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680908,
					"content": "Olá. Nós tocamos aquelas plantas em forma de tambor na praia, e fomos teletransportados para cá. Você é a dona desse lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680909,
					"content": "Esse é o salão da música, eu sou apenas sua guardiã. Contem-me, amigos, vocês estão aqui em busca da maior expressão musical?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680910
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680910,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680911
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680911,
					"content": "Digam-me, o que vocês desejam expressar com música?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680912
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680912,
					"content": "O espírito da resistência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680913,
					"content": "Oh, ótima resposta! Estou feliz em ouvir isso. Que sorte tenho de encontrar uma compositora com os mesmos ideais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680914,
					"content": "Até mesmo flores gigantes se dão bem com Xinyan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680915,
					"content": "Pessoas simpáticas sempre fazem amigos, não importa para onde vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680916,
					"content": "Se vocês chegaram até aqui, deve ser porque desejam entrar no salão da música. Entretanto, eu tenho que me desculpar, pois preciso cantar para que vocês entrem, mas minha cordas vocais agora estão doendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680917,
					"content": "Você está bem? Quer um remédio para resfriado ou algo do tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680918,
					"content": "Eu apenas não tomo a Água da Nascente Glacial há muito tempo. Se pudesse bebê-la, minha voz estaria pronta para abrir o caminho para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680919,
					"content": "Água da Nascente Glacial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680920,
					"content": "Sim, com um gole dessa água, qualquer um pode cantar uma bela canção, não importa se é um adulto cansado, um pássaro sonolento ou até uma criança inocente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680922,
					"content": "Está bem, vou procurar para você. Onde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680923,
					"content": "Obrigada, você é a melhor! Bem, as águas de nascente ajudam plantas a crescerem fortes para que escalem montanhas no seu caminho... Acho que a água poderá ser encontrada nas montanhas cobertas de plantas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680924,
					"content": "Então precisamos escalar? Paimon pensou que uma água do mar qualquer bastaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680925,
					"content": "Água de nascente e água do mar são completamente diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680926
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680926,
					"content": "Oh, mas vocês talvez precisem de meus poderes para verem essa água. Me dê sua mão, assim verá por meus olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680927
					],
					"speakerTitle": "Coração Flamejante"
				},
				{
					"id": 400680927,
					"content": "Obrigada! Você apertou minha mão, acho que agora somos amigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680906,
					"content": "O barco de ontem também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680907
					]
				}
			]
		},
