			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680201,
					"content": "#Vamos, levante-se, preguiços{F#a}{M#o}! O sol já despertou e está batendo nos seus olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680202,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680203
					]
				},
				{
					"id": 400680203,
					"content": "Paimon, eu durmo de costas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680204
					]
				},
				{
					"id": 400680204,
					"content": "Bom, então é por isso que você não podia ver que ele estava batendo nos seus olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680205,
					"content": "#{NICKNAME}, você dormiu bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680206,
						400680207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680206,
					"content": "Mais ou menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				},
				{
					"id": 400680208,
					"content": "Todos parecem ter dormido do mesmo jeito. Eu levantei primeiro, fiz uma caminhada e peguei algumas frutas para nosso café da manhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680209,
					"content": "E Paimon estava esperando você levantar para que finalmente possa comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680210,
					"content": "Vocês todos saboreiam o café da manhã juntos e conversam...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400680211
					]
				},
				{
					"id": 400680211,
					"content": "Hã? Fischl fugiu logo cedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680212,
					"content": "Sim, ela parece não querer ficar conosco. Ela disse que tinha algo para fazer para a Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680213
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680213,
					"content": "Que mentira! O que aconteceu com a história de vir para cá para restaurar a glória do Reino da Noite Eterna? Ela do nada agora tem trabalho da Guilda de Aventureiros para fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680214,
					"content": "Calma, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680215
					]
				},
				{
					"id": 400680215,
					"content": "A julgar pela aparência dela... Ela provavelmente está preocupada com algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680216,
					"content": "Tentamos mandar Mona para confortá-la como antes... Mas ela disse que Mona não entende seu trabalho na Guilda de Aventureiros, por isso não pode ir com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680217
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680217,
					"content": "Ela nem inventou uma desculpa sobre o Reino da Noite Eterna para ficar sozinha? Que quebra de personagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680218,
					"content": "Ela deve estar bem preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680219,
					"content": "Como amiga dela, adoraria ajudá-la... Mas ela estava certa sobre algo. Hoje vamos explorar outra ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680220,
					"content": "Hã? É isso mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680221
					]
				},
				{
					"id": 400680221,
					"content": "Sim, decidimos por unanimidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680222,
					"content": "Mas como é unanimidade se eu não votei?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680223
					]
				},
				{
					"id": 400680223,
					"content": "#Oh, sim, isso... Paimon votou por você. Como ela disse que vocês sempre estão junt{F#as}{M#os}, a opinião dela conta como a sua, e vice-versa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680224
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680224,
					"content": "#Hehe, você é {F#uma}{M#um} aventureir{F#a}{M#o}. Paimon sabia que você iria querer explorar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680225,
					"content": "(Ah, Paimon... Bem, paciência...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680226
					]
				},
				{
					"id": 400680226,
					"content": "Fischl disse que havia algo que ela queria investigar e sugeriu que seguíssemos em frente por enquanto. E também disse para não se preocuparem, ela nos alcançará quando tiver terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680227
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680227,
					"content": "Apesar de suas... Peculiaridades, ela é uma aventureira experiente. Eu acho que devemos confiar nela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680228
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680228,
					"content": "Eu não a conheço há muito tempo, isso é apenas uma observação... Mas ela parece estar passando por algum conflito interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680229
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680229,
					"content": "Hmm, parece que sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680230,
					"content": "Em um conflito com outras pessoas, você o resolve ou o ignora. Mas quando ele é interno, é muito mais difícil de fazer qualquer um desses dois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680231
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680231,
					"content": "... Eu também tive um período assim em minha vida, por isso entendo o que ela está passando. Talvez o melhor seja dar espaço a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680232
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680232,
					"content": "Concordo. Ainda assim, é uma pena para a aventura de hoje. Sempre é mais divertido fazer uma quando todos estão juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680233
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680233,
					"content": "Xinyan sempre tem um bom espírito de trabalhar em equipe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680234,
					"content": "#Oh, outra coisa. Essa manhã vimos uma miragem na ilha no norte. Podemos ir lá dar uma olhada quando você terminar seu café da manhã, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680207,
					"content": "Nada mal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400680208
					]
				}
			]
		},
		{
			"id": 4006803,
			"completionStepIds": [
				4006803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006803",
							"2"
						],
						"stepId": 4006803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400680301,
					"content": "Essa ilha parece bem normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400680302,
					"content": "... Sinto o cheiro de algo queimado no ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680303,
					"content": "Urgh... Meu Hydroprofetizador está ficando mais claro, mas ainda não vejo muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680304,
					"content": "Ei! Olhem o que eu achei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680305
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680305,
					"content": "É um... Tambor? Ou uma planta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680306
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680306,
					"content": "É um instrumento feito de uma planta? Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680307,
					"content": "Xinyan, você acha que essa é a sua ilha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400680308,
					"content": "Oh, você acha que esse instrumento está aqui por minha causa? Deixe-me tentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400680309,
					"content": "Esperem. Quando eu toquei no jardim de rochas no bonsai ontem, fomos teletransportados para outro espaço. Xinyan, você quer se preparar um pouco primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400680310,
					"content": "Você está certo, mas está tudo bem. Sempre estou pronta para tocar música!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4006804,
			"completionStepIds": [
				4006804
