			"dialogs": [
				{
					"id": 401251101,
					"content": "Você não planeja levar a concha de volta com você, Srta. Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "Não, acho que é melhor que fique aqui com Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "A Ilha Watatsumi já tem um novo tesouro e lentamente, mas constantemente, as pessoas estão vendo progresso em perseguir suas aspirações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "Será mais útil aqui, onde pode proteger este domínio em uma garrafa e os sonhos de todos que se aventuram por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
