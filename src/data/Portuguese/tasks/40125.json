			"trigger": {
				"objectNames": [
					"Collei",
					"Eula",
					"Lessig",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "...Se começarmos na Vila Aaru e fizermos um leve desvio, poderemos ver o Ribat de Caravanas e Pardis Dhyai no caminho para a Cidade de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Ah, muito bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Planejando comprar lembrancinhas no caminho? Você pode só focar em comprar os presentes, eu carrego as sacolas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Não se preocupe com o peso, eu aguento! Contanto que não seja nada gigantesco, vou fazer caber na sacola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Acalme-se, para quantas pessoas você acha que vamos comprar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Mamãe, Albedo, Mestre Jean, Razor... Ooh, e Diona, e Mona e Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "O que está olhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Nada, nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "Então, Klee, o que você planeja comprar para todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Hmm... Doces com sabor de Fruto do Pôr do Sol! E chapéus em forma de Cogumelo gigantes! E, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "...E um montão de livros de histórias para todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Mas eu ainda não decidi o que comprar para minha mãe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Não tem pressa. Vamos ver o que eles têm e se você ainda estiver indecisa, podemos te ajudar a decidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Oba! Obrigada, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
