			"dialogs": [
				{
					"id": 752430101,
					"content": "#Ah, car{M#o}{F#a} cliente, você salvou mesmo meu dia. Aqueles Fatui estavam passando dos limites!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752430102,
					"content": "Aquela gente apareceu do nada, sem dizer uma palavra, já enfiou a mão no meu bolso! São verdadeiros bandidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752430103,
					"content": "Graças aos céus você apareceu! Eu teria perdido tanto se não fosse por você... Por favor, você precisa aceitar minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752430104,
					"content": "Oh, sim, eu quase esqueci de apresentar o local. Esse é o agradável Parque das Alpacas, onde demonstramos Alpacas gentis. Claro, também tem um monte de brinquedos do tipo à venda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752430105,
					"content": "Mas, aqueles capangas acabaram de espantar meus funcionários e clientes... Eu preciso ir lidar com a bagunça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aroja"
				},
				{
					"id": 752430106,
					"content": "#Se você também estiver interessad{M#o}{F#a} em ver nossas Alpacas, por favor, volte amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aroja"
				}
			]
		},
