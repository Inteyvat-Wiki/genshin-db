				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220201,
					"content": "Oh? É você. Quanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220202
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220202,
					"content": "Onde estou? Isto é uma caverna? Ugh... Estou tão tonto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220203
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220203,
					"content": "Quem é você? Por que você está dormindo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220204,
					"content": "Quem sou eu... Ugh, tão tonto. Deixe-me pensar... meu nome é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220205
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220205,
					"content": "Meu nome é Araphala! Hehe, eu me lembrei agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220206
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220206,
					"content": "Então você é Araphala! Estávamos nos perguntando aonde você tinha ido. Você estava dormindo nesta caverna o tempo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220207,
					"content": "Araphala... Vocês sabem meu nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220208,
					"content": "Eh? Nara!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220209
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220209,
					"content": "Ele está bem acordado agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220210,
					"content": "Realmente está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220211
					]
				},
				{
					"id": 730220211,
					"content": "Snif. Eu não estou pronto ainda. Não faça mingau de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220212
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220212,
					"content": "Hã? Por que alguém faria mingau com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220213,
					"content": "M-Minha irmã disse que se eu estiver sempre dormindo assim, um Nara ruim vai me levar e fazer mingau comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220214,
						730220217
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220214,
					"content": "Você realmente parece muito saboroso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220215
					]
				},
				{
					"id": 730220215,
					"content": "Aaaahhh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220216
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220216,
					"content": "#Ei! {NICKNAME}, não faça piadas assim! Araphala, ninguém vai cozinhar você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220218,
					"content": "...Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220219
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220219,
					"content": "Sim, sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220220,
					"content": "De verdade mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220221
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220221,
					"content": "#É a verdade. O nome de Paimon é Paimon, e {M#este}{F#esta} Nara alt{M#o}{F#a} é {NICKNAME}. Arapacati nos enviou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220222,
					"content": "Arapacati? Ela está bem? Há quanto tempo estou aqui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220223
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220223,
					"content": "Quanto tempo foi? Paimon acha que foram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220224,
					"content": "Deixe Paimon pensar... Muitas, muitas luas atrás, mudas brotaram da terra, e se tornaram árvores. Quantas vezes mais alto que Arapacati era mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220225,
						730220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220225,
					"content": "Sete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220226
					]
				},
				{
					"id": 730220226,
					"content": "#Uau! Como esperado d{M#o}{F#a} {NICKNAME}! Que memória incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220229,
					"content": "Oh, já se passou tanto tempo assim. Oh não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220230
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220230,
					"content": "De qualquer forma, deixe-nos colocá-lo em dia. O Festival Utsava está chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220231,
					"content": "Você atualiza Araphala sobre os eventos até então...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220232
					]
				},
				{
					"id": 730220232,
					"content": "Ah, é tempo de celebrar o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220233
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220233,
					"content": "Sim, Arapacati quer você de volta em Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220234,
					"content": "Ugh... Mas ainda não completei meu Treinamento Culinário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220235
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220235,
					"content": "Hã? Você não estava dormindo? Paimon pensou que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220236,
					"content": "\"Dormindo\"? Estava só pensando no passado. Não foi tão sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220237
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220237,
					"content": "Dormir parece muito sério para os Aranaras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220238,
					"content": "Hmm... Como devo dizer isso... Hibernamos quando estamos em grande perigo, e comprimimos nossas memórias e sonhos em uma semente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220239
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220239,
					"content": "Se o perigo passar e for o momento certo, a semente voltará para a floresta e se transformará em um Aranara de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220240,
						730220241,
						730220242
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220240,
					"content": "Parece muito cansativo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220244,
					"content": "#Mas eu sei que Nara devem dormir. Eu tive {M#uma amiga}{F#um amigo} Nara uma vez, {M#uma}{F#um} Nara {M#dourada}{F#dourado} como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220245
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220245,
					"content": "#Eu vim aqui com {F#ele}{M#ela} uma vez para colher as Frutas Frescas Incomparáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220246
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220246,
					"content": "#Então, eu as tenho colhido aqui desde então. Se {M#ela}{F#ele} retornar, ou se eu fizer novos amigos Nara, podemos comer algumas, juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220247
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220247,
					"content": "Eu colhi tantas Frutas Frescas Incomparáveis desta vez... hã? Para onde elas foram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220248
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220248,
					"content": "Então foi você que deixou cair os Frutos do Pôr do Sol que vimos ao longo do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220249,
					"content": "Eu deixei cair tantos assim? Ah, tudo bem. Hehe, guardei o mais fresco e saboroso comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220250
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220250,
					"content": "Ugh... Como eu deixei cair tantos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220251
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220251,
					"content": "Lembro-me de sair com meus irmãos para o Treinamento Culinário. Mas eles não sabiam que fruta fresca é o melhor ingrediente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220252
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220252,
					"content": "Mas enquanto eu estava colhendo frutas... Sim, enquanto eu estava colhendo frutas, um monstro realmente enorme apareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220253
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220253,
					"content": "O monstro enorme era cinco vezes mais alto que Araphala e tinha uma cauda longa. Até o chão tremia sob seus pés. Inclusive, acho que senti a aura da Marana vindo dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220254
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220254,
					"content": "Além disso, ele era tão durão. Que até mesmo Arama e Arabalika sofreriam para conseguir derrotá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220255
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220255,
					"content": "Quê? Eles são realmente tão fortes assim!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220256,
					"content": "Sim, mas eu não sou. Então, tive que me esconder aqui. Pensei no passado enquanto esperava que ele saísse, e quando dei por mim, vocês estavam na minha frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220257
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220257,
					"content": "Falando nisso, vimos um \"Dragão das Ruínas\" a caminho daqui. Esse é o monstro enorme que você viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220258,
					"content": "É assim que os Nara o chamam? Talvez. Deveria ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220259,
						730220260
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220259,
					"content": "Nós lidamos com ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220264
					]
				},
				{
					"id": 730220264,
					"content": "#Uau! Eu não esperava que Nara {NICKNAME}, que parece tão {M#pequeno}{F#pequena}, fosse tão forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220265
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220265,
					"content": "#Hum, então vamos. Nara {M#bom}{F#boa}, vamos comer frutas juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220260,
					"content": "Ah, monstro enorme! Tão assustador!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220261
					]
				},
				{
					"id": 730220261,
					"content": "...Foi tão assustador assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220262,
					"content": "Sim, parece que Nara entende que é um monstro assustador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220263
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220263,
					"content": "#Não se preocupe. {NICKNAME} derrotou aquele monstro enorme antes de conhecermos você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220241,
					"content": "Parece tão conveniente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220244
					]
				},
				{
					"id": 730220242,
					"content": "Paimon, você pode se transformar em uma semente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220243
					]
				},
				{
					"id": 730220243,
					"content": "Ei, você tem algum problema com Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220227,
					"content": "Sua memória também é incrível, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220228
					]
				},
				{
					"id": 730220228,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220217,
					"content": "Ninguém vai te transformar em mingau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220218
					]
				}
			]
		},
		{
			"id": 7302203,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
