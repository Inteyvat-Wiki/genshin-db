			"dialogs": [
				{
					"id": 730220901,
					"content": "(Uma folha enorme. Alguém escreveu nela com uma bela caligrafia...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220902
					],
					"speakerTitle": "Folha com Caligrafia Cuidadosa"
				},
				{
					"id": 730220902,
					"content": "\"...As folhas amarelaram. Escolhi um Fruto do Pôr do Sol fresco e saboroso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220903
					],
					"speakerTitle": "Folha com Caligrafia Cuidadosa"
				},
				{
					"id": 730220903,
					"content": "\"...Ramos ficaram verdes. Não encontrei nenhuma fruta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220904
					],
					"speakerTitle": "Folha com Caligrafia Cuidadosa"
				},
				{
					"id": 730220904,
					"content": "\"As folhas estão crescendo novamente, e 40 luas se passaram. Eu peguei Fruto do Pôr do Sol fora do acampamento e as trouxe de volta para Vanarana, mas irmãzinha disse que elas ainda estão muito verdes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Folha com Caligrafia Cuidadosa"
				}
			]
