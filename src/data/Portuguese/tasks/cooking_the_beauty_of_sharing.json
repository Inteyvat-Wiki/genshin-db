					"Paimon",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "Oh? É você. Há quanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220302,
					"content": "Uau, onde estou? Isto é uma caverna? Ugh... Estou tão tonto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220303,
					"content": "Quem é você? Por que você está dormindo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220304,
					"content": "Quem sou eu... Ugh, tão tonto. Deixe-me pensar... meu nome é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220305,
					"content": "Meu nome é Araphala! Hehe, eu me lembrei agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220306,
					"content": "Então você é Araphala! Estávamos nos perguntando aonde você tinha ido. Você estava dormindo nesta caverna o tempo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220307,
					"content": "Araphala... Vocês sabem meu nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220308,
					"content": "Eh? Nara!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220309,
					"content": "Ele está bem acordado agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220310,
					"content": "Realmente está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "Snif. Eu não estou pronto ainda. Não faça mingau de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220312,
					"content": "Hã? Por que alguém faria mingau com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220313,
					"content": "M-Minha irmã disse que se eu estiver sempre dormindo assim, um Nara ruim vai me levar e fazer mingau comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220314,
					"content": "Você realmente parece muito saboroso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "Aaaahhh!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220316,
					"content": "#Ei! {NICKNAME}, não faça piadas assim! Araphala, ninguém vai cozinhar você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220318,
					"content": "...Mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220319,
					"content": "Sim, sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220320,
					"content": "De verdade mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220321,
					"content": "#É a verdade. O nome de Paimon é Paimon, e {M#este}{F#esta} Nara alt{M#o}{F#a} é {NICKNAME}. Arapacati nos enviou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220322,
					"content": "Arapacati? Ela está bem? Há quanto tempo estou aqui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220323,
					"content": "Quanto tempo foi? Paimon acha que foram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220324,
					"content": "Deixe Paimon pensar... Muitas, muitas luas atrás, mudas brotaram da terra, e se tornaram árvores. Quantas vezes mais alto que Arapacati era mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220325,
					"content": "Sete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#Uau! Como esperado d{M#o}{F#a} {NICKNAME}! Que memória incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220329,
					"content": "Oh, já se passou tanto tempo assim. Oh não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220330,
					"content": "De qualquer forma, deixe-nos colocá-lo em dia. O Festival Utsava está chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220331,
					"content": "Você atualiza Araphala sobre os eventos até então...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "Ah, é tempo de celebrar o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220333,
					"content": "Sim, Arapacati quer você de volta em Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220334,
					"content": "Ugh... Mas ainda não completei meu Treinamento Culinário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220335,
					"content": "Hã? Você não estava dormindo? Paimon pensou que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220336,
					"content": "\"Dormindo\"? Estava só pensando no passado. Não foi tão sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220337,
					"content": "Dormir parece muito sério para os Aranaras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220338,
					"content": "Hmm... Como devo dizer isso... Hibernamos quando estamos em grande perigo, e comprimimos nossas memórias e sonhos em uma semente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220339,
					"content": "Se o perigo passar e for o momento certo, a semente voltará para a floresta e se transformará em um Aranara de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220340,
					"content": "Parece muito cansativo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "#Mas eu sei que Nara devem dormir. Eu tive {M#uma amiga}{F#um amigo} Nara uma vez, {M#uma}{F#um} Nara {M#dourada}{F#dourado} como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220345,
					"content": "#Eu vim aqui com {F#ele}{M#ela} uma vez para colher as Frutas Frescas Incomparáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220346,
					"content": "#Então, eu as tenho colhido aqui desde então. Se {M#ela}{F#ele} retornar, ou se eu fizer novos amigos Nara, podemos comer algumas, juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220347,
					"content": "Eu colhi tantas Frutas Frescas Incomparáveis desta vez...Hã? Para onde elas foram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220348,
					"content": "Então foi você que deixou cair os Frutos do Pôr do Sol que vimos ao longo do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220349,
					"content": "Eu deixei cair tantos assim? Ah, tudo bem. Hehe, guardei o mais fresco e saboroso comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220350,
					"content": "Ugh... Como eu deixei cair tantos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220351,
					"content": "Lembro-me de sair com meus irmãos para o Treinamento Culinário. Mas eles não sabiam que fruta fresca é o melhor ingrediente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220352,
					"content": "Mas enquanto eu estava colhendo frutas... Sim, enquanto eu estava colhendo frutas, um monstro realmente enorme apareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220353,
					"content": "O monstro enorme era cinco vezes mais alto que Araphala e tinha uma cauda longa. Até o chão tremia sob seus pés. Inclusive, acho que senti a aura da Marana vindo dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220354,
					"content": "Além disso, ele era tão durão. Que até mesmo Arama e Arabalika sofreriam para conseguir derrotá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220355,
					"content": "Quê? Eles são realmente tão fortes assim!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220356,
					"content": "Sim, mas eu não sou. Então, tive que me esconder aqui. Pensei no passado enquanto esperava que ele saísse, e quando dei por mim, vocês estavam na minha frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220357,
					"content": "Eu não quero sair enquanto um monstro tão assustador e enorme está vagando pela área. Sinto muito, minha \"irmãzinha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220358,
					"content": "Entendo. Mas o Festival Utsava está chegando, você tem que voltar para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220359,
					"content": "O Festival Utsava deveria ser tranquilo, mas cuidarei da minha vida se deixar este lugar. *Ronca* Eu não posso fazer isso no Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220360,
					"content": "Zzz... Zzz... Nara Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220361,
					"content": "Ugh... Esse cara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220362,
					"content": "#O que faremos, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220363,
					"content": "Vamos lidar com o grande monstro assustador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "...Paimon não acha que nada pode ser mais assustador do que o Stormterror. Como acha que um Aranara descreveria o Stormterror?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220366,
					"content": "\"Um milhão de vezes mais alto que Araphala!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "\"A lua irá nascer e se por enquanto andando de sua cauda até a cabeça!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220368,
					"content": "De qualquer forma, vamos lá lidar com o monstro lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220364,
					"content": "Ah, monstro enorme! Tão assustador!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "Parece tão conveniente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "Paimon, você pode se transformar em uma semente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "Ei, você tem algum problema com Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220327,
					"content": "Sua memória também é incrível, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220317,
					"content": "Ninguém vai te transformar em mingau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
