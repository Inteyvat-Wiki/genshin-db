				"points": []
			},
			"dialogs": [
				{
					"id": 730220501,
					"content": "*Ronco* *Ronco*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220502
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220502,
					"content": "Araphala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220503,
					"content": "Hã? Oh, é Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220504,
					"content": "#Sim, Paimon está aqui para lhe dizer que {M#o}{F#a} {NICKNAME} lidou com o enorme monstro assustador lá fora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220505,
					"content": "#Uau! Eu não esperava que Nara {NICKNAME}, que parece tão {M#pequeno}{F#pequena}, fosse tão forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220506,
					"content": "Foi tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "#Hum, então vamos. Nara {M#bom}{F#boa}, vamos comer frutas juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220507,
					"content": "Foi bem difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
			"completionStepIds": [
				7302204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302204",
							"2"
						],
						"stepId": 7302204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araphala",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "Oh, vamos fazer um prato com essas \"Frutas Frescas Incomparáveis\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220602,
					"content": "Qual a diferença entre esta \"Fruta Fresca Incomparável\" das frutas comuns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220603,
					"content": "Eu sei que todas as frutas são iguais para Nara, mas não são.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220604,
					"content": "Apenas árvores fortes produzem \"Frutas Frescas Incomparáveis\". As árvores fortes cantam primeiro quando o vento sopra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220605,
					"content": "#Os produtos de uma árvore forte, as Frutas Frescas Incomparáveis, são sua bênção para nós. {M#A}{F#O} amig{M#a}{F#o} Nara disse que essas frutas são tão saborosas que cantam no estômago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220606,
					"content": "Paimon mal pode esperar para ver que tipo de iguarias serão feitas com elas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220607,
					"content": "Araphala começa a cozinhar imediatamente...\\nEle parte a fruta na mão...\\nEntão, Araphala dá alguns pedaços para você e Paimon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "Vocês experimentam as frutas frescas juntos.\\nElas atendem às expectativas. Realmente tem gosto de fruta fresca.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "Tão bom. Obrigado, árvore forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220610,
					"content": "Espere! Você chama isso de cozinhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220611,
					"content": "A própria Fruta Fresca Incomparável é a melhor Iguaria Suprema. Tão perfeita que não precisa de mais nada para ficar melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220612,
					"content": "Falar é fácil, você vai entender assim que experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220613,
					"content": "É gostoso, mas é só... é como uma fruta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220614,
					"content": "É uma fruta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "Sim, acho que é o caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220616,
					"content": "Vocês Nara não tem um prato em que vocês cortam frutas e as servem em uma travessa também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220617,
					"content": "Hã? Existe? Espera, você está falando de uma bandeja de frutas!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220618,
					"content": "Uma bandeja de frutas é considerado um prato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220619,
					"content": "Acho que sim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "Parece um pouco estranho para Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220623,
					"content": "Oh, não se atenha a essa forma de pensar. Encontrar ingredientes melhores é uma forma de cozinhar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220624,
					"content": "Enquanto procurando ingredientes, pude viajar pela floresta e me aproximar dela. Esse é o verdadeiro significado do Treinamento Culinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220625,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220626,
					"content": "Com certeza é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220627,
					"content": "Colhi Frutas Frescas Incomparáveis e fiz minha Iguaria Suprema. Meu Treinamento Culinário está completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220628,
					"content": "Posso voltar com orgulho para Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220629,
					"content": "#Oh... Se Nara {NICKNAME} e Paimon não tivessem lidado com os monstros gigantes na caverna, eu com certeza teria perdido o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220630,
					"content": "Tudo bem, volte logo para Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220631,
					"content": "De fato, de fato... A irmãzinha vai me repreender se eu perder o Festival Utsava... Só de pensar nisso é assustador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220621,
					"content": "Eu não acho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "Né? É tão estranho chamar de prato algo que não foi... sabe, processado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Paimon"
				}
			]
		},
