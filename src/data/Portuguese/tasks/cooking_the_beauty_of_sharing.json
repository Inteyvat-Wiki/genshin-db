			"dialogs": [
				{
					"id": 730220101,
					"content": "Olá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220102,
					"content": "*Ronco* *Ronco*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220103,
					"content": "Ei! Olá...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220104,
					"content": "Mmm... Fruta saborosa. *ronco*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220105,
					"content": "Ugh, ele está em sono profundo. Oh, certo. Arapacati mencionou que <color=#00E1FFFF>o poder do Dendro</color> deve resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220106,
					"content": "#Paimon vai deixar contigo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302202,
			"completionStepIds": [
				7302207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302207",
