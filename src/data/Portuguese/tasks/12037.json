			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "Oi! Você sabe onde está Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "Vocês também estão aqui procurando por Kazuha, pelo visto, ele realmente fez algo incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "\"Também\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Hahaha, viemos neste pequeno barco para suprimentos. Pouco depois de chegarmos, muitas pessoas de Inazuma vieram perguntar sobre Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Se for por causa daquela batalha na Praia Nazuchi, a capitã Beidou também levou crédito, mas não a vejo recebendo esse tipo de atenção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "Ele também não tem muita presença na frota. Na verdade, há momentos em que ele nem ouve a capitã, mas ela apenas ri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "Então você não sabe o que ele fez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "Conheci um pouco sobre a sua história, tipo, ele bloqueou a \"Musou no Hitotachi\" de Shogun Raiden e coisas do gênero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "E isso é algo tão fantástico como todos estão fazendo parecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "Você poderia comparar com a técnica que a Beidou usou para derrotar o Haishan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "Sério? Uau, quando você explica assim, tudo faz sentido. Haha, por isso que ele é bem popular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Ele foi chamado mais cedo por algumas pessoas da Comissão Tenryou. Disseram que tinham algo importante para discutir com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "A princípio pensei que iriam prendê-lo, mas na verdade, eles foram o mais amigáveis que podiam. Parece que o respeitam bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Não imaginei que isso aconteceria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Talvez o Shogunato também gostaria de mostrar gentileza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Obrigada! Vamos para a sede da Comissão Tenryou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Certo, enquanto isso, vou continuar lidando com as pessoas por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Afinal, a mentalidade da Shogun Raiden também mudou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
