						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Oh? É você, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "#Olá. Estávamos falando sobre a abolição do \"Decreto de Caça à Visão\". Já que você está aqui, é bem-vind{M#o}{F#a} para se juntar e ouvir a conversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "Gostaríamos de expressar a cordialidade da parte do Shogunato, e convidamos o Kaedehara Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "Foi graças aos seus esforços que chegamos até aqui. E agora, tenho uma oportunidade de corrigir os erros da minha família, e estou muito grato por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "A Toda-Poderosa Shogun está tentando resolver ou suavizar os problemas acumulados do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "A Comissão Tripla propôs aproveitar esta oportunidade para restaurar a reputação do Clã Kaedehara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Você deve saber as histórias do Clã Kaedehara, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Mais ou menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Resumindo, Inazuma tinha um grupo de fabricantes de lâminas que serviam diretamente à Shogun, responsáveis por manter e desenvolver a habilidade tradicional de forja da Toda-Poderosa Shogun. E o Clã Kaedehara era um destes fabricantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "No entanto, em um certo período, alguns fabricantes abandonaram Inazuma e fugiram para Snezhnaya. Tanto o Clã Kaedehara quanto o Clã Kamisato foram acusados pela incompetência na administração e passaram por um período de grande tumulto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "Mais tarde, soubemos que toda a desventura havia sido secretamente orquestrada pelos Fatui. Atribuir toda a culpa aos clãs Kamisato e Kaedehara não era apropriado, nem justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "Desta vez, o Sr. Kaedehara Kazuha levou mérito, e a Toda-Poderosa Shogun achou que não deveriam apenas recompensá-lo, mas também compensá-lo pelos erros do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Para evitar mais assédio dos clãs de cuteleiros pelos Fatui, optamos por não divulgar publicamente as descobertas de nossas investigações sobre esses assuntos. Acreditamos que você pode entender por que isso foi necessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "Não precisa! Estou mais do que feliz pela gentileza demonstrada da Toda-Poderosa Shogun e Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Mas, essa gentileza não deve ser gratuita, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Posso te assegurar que não é nada desse tipo. Apenas procuramos corrigir as injustiças do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Com a restauração da reputação, o Clã Kaedehara pode retomar o negócio de forjamento de lâminas, e você não precisa mais levar uma vida errante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Você poderá levar uma vida segura e próspera na cidade de Inazuma com a proteção da Toda-Poderosa Shogun e o total apoio do Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Ando com a companhia do vento e da chuva, receio que não me acostumarei com uma vida vivendo entre quatro paredes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "No entanto, meus ancestrais sempre se orgulharam do nome de Kaedehara e de suas habilidades transmitidas de geração para geração, e eu tenho a responsabilidade de restaurar sua honra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "Parece que você ainda está indeciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Se você concordar, acho que muitos rumores sobre você que circulam na cidade irão desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "Rumores? Ouvimos apenas coisas boas a seu favor ao longo do caminho, e alguns deles são meio exagerados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Para algumas pessoas, a \"Musou no Hitotachi\" é algo invencível, e eles não conseguem acreditar que o Sr. Kaedehara o bloqueou tão facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Além disso, testemunhas o viram usando o poder de Electro, além do de Anemo. Como resultado, os rumores de que \"Kaedehara Kazuha estava usando uma ilusão\" começaram a se espalhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "O quê? Mas isso não faz sentido. Usar uma Ilusão deixa você velho e frágil, e Kazuha ainda parece bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Correto. No entanto, para algumas pessoas, a ideia de uma única pessoa empunhando dois elementos ao mesmo tempo, é uma noção ainda mais inconcebível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Este é apenas um dos muitos rumores semelhantes. Estou muito desconfortável em ser objeto de discussão pública, não importa se isso traz suspeita ou estrelato para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Mas se o Shogunato estiver disposto a me apoiar, este assunto pode se acalmar mais rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "Então você pode pensar mais um pouco sobre essa proposta. Beneficiaria a todos nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Hum, deixe-me pensar mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Vamos deixar essa proposta de lado por enquanto. O que vocês estão procurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "Ah, Paimon quase esqueceu de algo importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Você conta a Kaedehara Kazuha sobre o ataque do lado de fora da cidade.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "Uma pessoa tão perigosa está me procurando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "Você tem irmãos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Não, agora também estou confuso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Minhas formas de luta me foram ensinadas por minha família, com base em técnicas originalmente desenvolvidas para testes de lâminas. Passamos por um treinamento rigoroso para padronizar cada movimento pelo qual a lâmina é submetida, para que cada um possa ser avaliado de forma justa quanto à qualidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Com o tempo surgiu a arte de testar espadas e as técnicas correspondentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "Isso é muito diferente das artes marciais do campo de batalha, e é difícil imaginar que seja apenas uma coincidência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "Então você tem que ter mais cuidado, Paimon sente que essa pessoa é bem estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Sim, ele é muito agressivo, se atacar alguém provavelmente terminará mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "Se sim, enviarei alguém para investigar agora mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Espero que não seja incômodo. Estou bastante curioso sobre este assunto. Sobre sua proposta anterior, preciso pensar um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "#Vou investigar quem atacou {M#eles}{F#elas} primeiro e depois te darei a minha resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "Tudo bem, mas tenham cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Vamos! Vamos encontrar aquele agressor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "Você tem colegas do clã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Não me lembro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
