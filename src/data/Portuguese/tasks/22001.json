					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010603,
					"content": "Eu odeio ser empregado de mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010604,
					"content": "A Lulu e a Meng só se preocupam com elas próprias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010605,
					"content": "Hum! Estou te assaltando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "Pirata? Desculpe, mas sou um marinheiro novato, e não tenho nada que você possa roubar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010607
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010607,
					"content": "Se quiser assaltar, procure uma pessoa mais rica... Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010608
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010608,
					"content": "Eu sei! O capitão é realmente rico, vocês deviam roubá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010609
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010609,
					"content": "Ei? Você é o empregado de mesa deste barco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010610
					],
					"speakerTitle": "Paimon"
				},
				{
