				},
				{
					"id": 220010410,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220010411,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010412,
					"content": "Uau! Funcionou! Agora está quieto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Eu disse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010414,
					"content": "Como você sabia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Temos brincado muito, claro que sabemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010416,
					"content": "A Lulu é incrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Hehe, obrigada, mas a Beidou é ainda melhor.",
