			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "Meng, hoje posso ser o capitão, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, eu já fui o capitão muitas vezes seguidas, agora deveríamos deixar Fei ter sua vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220010103,
					"content": "Mas creio que você pode fazer um bom trabalho. Quero que continue seguindo o capitão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010104,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Estamos tentando jogar um jogo. Eles me prometeram que eu poderia ser a capitã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010106,
					"content": "Mas a Lulu sempre diz que é mais divertido quando o Meng é o capitão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010107,
					"content": "*Suspiro* A pequena Lulu sempre faz isso... Mas, se é o que ela quer... acho que está tudo bem para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010108,
					"content": "Você está com tempo livre para se juntar? Você pode ser o pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010109,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "Afinal, eu sou empregado de mesa de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010113,
					"content": "#Como na última vez, venha quando estiver preparad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010111,
					"content": "Eu quero ser uma pessoa boa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "Ugh, eu quero ser o capitão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Pequeno Fei"
				}
			]
		},
