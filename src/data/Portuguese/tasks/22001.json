			"dialogs": [
				{
					"id": 220010301,
					"content": "Chegamos, é aqui onde está o capitão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010302,
					"content": "O que você está fazendo trazendo os piratas aqui?! Você não devia estar os distraindo enquanto eu e Lulu fugimos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220010303,
					"content": "Por que você pode acompanhar a Lulu, mas eu tenho que ficar aqui para arrastar os piratas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010304,
					"content": "Eu tive uma ideia melhor: entrego você aos piratas enquanto eu fujo com Lulu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010305,
					"content": "A Beidou disse que não podia abandonar os amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220010306,
					"content": "Mas a Beidou disse que o capitão devia levar as pessoas para fugir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010307,
					"content": "Seu... Nunca mais vou compartilhar minhas Cabeças de Lótus com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220010308,
					"content": "Está bom! Só você é que valoriza tanto essas Cabeças de Lótus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220010309,
					"content": "Por que eles estão brigando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Não se preocupe, eu sei uma maneira para resolvermos isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010311,
					"content": "As Cabeças de Lótus são as coisas favoritas deles... Se dermos um pouco para eles, definitivamente, eles se acalmarão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010312,
					"content": "Você pode buscar algumas Cabeças de Lótus para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010313,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Obrigada, você precisa ser ágil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010315,
					"content": "O que eles mais gostam são as Cabeças de Lótus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Sério? Quem é? De que eles gostam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010317,
					"content": "...Enfim, arranje algumas Cabeças de Lotus para que eles parem de brigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				}
			]
		},
