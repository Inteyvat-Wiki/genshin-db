					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220010409,
					"content": "Temos que decidir quem vai ser o capitão, quem vai ser o empregado de mesa. Boa ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
