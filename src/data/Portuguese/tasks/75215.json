			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "Bem, você também tem interesse nesse campo de treinamento de força?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150102,
					"content": "Use os equipamentos à vontade, mas ao julgar pelos gravetos que você tem como braços... apenas não se machuque, ouviu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150103,
					"content": "Ei, eu me exercito um monte todos os dias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "Sério? Por que você não vai treinar suas habilidades de contar garganta naquele bloco quadrado gigante perto de você primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150106,
					"content": "<color=#00E1FFFF>Ataque-o</color> ou <color=#00E1FFFF>se empurre</color> contra ele para marcar pontos baseados em sua força. Vamos lá, quero ver do que você é capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150104,
					"content": "Pois saiba que eu posso mandar um Hilichurl voando com um único soco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
