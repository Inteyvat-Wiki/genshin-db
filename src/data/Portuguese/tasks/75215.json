			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "...Sério? Você acabou de quebrar um dos cantos do bloco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150202,
					"content": "A última pessoa que fez isso foi Varesa... Parece que você tem um dom para isso, assim como ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150203,
					"content": "Não vou mentir, precisei de um pouco de esforço.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "#Acho que as aparências realmente enganam. Sabe, eu te contrataria como {M#instrutor}{F#instrutora} daqui, se você deixasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150206,
					"content": "Ah, sim. Experimente esse \"Suco da Fartura\". É bem popular entre nossos aprendizes — dizem que consegue aprimorar seu desempenho atlético.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150204,
					"content": "Heh, isso foi facílimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
