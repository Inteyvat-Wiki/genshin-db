			"dialogs": [
				{
					"id": 752150301,
					"content": "Recrutar novos integrantes não é a parte difícil — isso vem um tempo depois, quando vários deles começam a criar desculpas para tirar folga, ou simplesmente param de vir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "A treinadora criou todos os tipos de ideias para elevar a motivação deles, aquele desafio do bloco sendo um deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Mas no fim, algumas pessoas tentaram melhorar suas pontuações ao se jogarem contra o bloco e acabaram todos roxos por isso. Isso apenas aumentou o número de pessoas pedindo folga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
