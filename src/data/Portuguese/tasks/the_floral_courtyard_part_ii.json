			"dialogs": [
				{
					"id": 726880101,
					"content": "Nos encontramos novamente, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880102,
					"content": "#O \"Pátio Floral\" anterior realmente foi realmente incrível. Vocês são muito talentos{M#o}{F#a}s. Compreenderam a essência da arte rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880103,
					"content": "Como de costume, o novo tema lhes aguarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880104,
						726880110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880104,
					"content": "Bem, então vamos começar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880105
					]
				},
				{
					"id": 726880105,
					"content": "#Vamos! Estamos pront{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726880106,
					"content": "Haha, que brilho maravilhoso em seus olhos, é como se eles refletissem um mar de flores radiantes. Realmente muito encantador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880107,
					"content": "Neste caso, o tema de hoje é um pouco mais complicado que o último, nada melhor para vocês aprimorarem suas habilidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880108
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880108,
					"content": "\"Sedosa e robusta, a lótus na lagoa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880109
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880109,
					"content": "Pense cuidadosamente no significado deste tema e selecione suas flores cuidadosamente para criar o \"Pátio Floral\" especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880110,
					"content": "Ainda tenho outras coisas para fazer no momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726880111
					]
				},
				{
					"id": 726880111,
					"content": "Tudo bem. Afinal de contas, a Ikebana requer atenção total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726880112
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726880112,
					"content": "Uma vez que você tenha completado todos os seus assuntos, ficando livre de todos os problemas, tenho certeza de que seu Pátio Floral ficará ainda mais perfeito por conta disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
