				},
				{
					"id": 760150207,
					"content": "Conhece a melodia, né? Yo-ho, vamos lá! A gente canta um verso, você canta o próximo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150208
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150208,
					"content": "\"O som da dança vinha dos vizinhos, meus pés começaram a bater, ah!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150209,
					"content": "\"Vocês sorrindo, eu no violino,\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "\"E todos dançando pra lá e pra cá!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150211,
					"content": "\"Chega mais perto, vamos dançar!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Haha! Isso aí, assim que se faz! Você pega rápido as coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150213,
					"content": "Meu nome é ███. Pronto, agora somos conhecidos. A cadeira é toda sua, afinal, sou um sujeito generoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150214,
					"content": "Você é um Ratniki também, né? Não se preocupe, essa bebida é por minha conta. Talvez a gente se veja de novo durante o treinamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150215,
					"content": "Valeu — mesmo que eu não possa beber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Bem, estou indo patrulhar. Até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150216,
					"content": "Muito prazer, senhor. Pode me chamar de Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "E se eu disser que quero sentar aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
