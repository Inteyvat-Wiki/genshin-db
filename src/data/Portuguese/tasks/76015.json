			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fantasma Barulhento"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Quem é você? Esse é o meu lugar, todo mundo na taverna sabe disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150102,
					"content": "Veio pra ilha fazer um relatório ou o quê? Não fique pegando o lugar dos outros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150103,
					"content": "E cadê a minha cerveja, caramba? Anda com isso, vai? Já já tenho que sair pra patrulha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150104,
					"content": "Taverna? Cerveja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "Se faz tanta questão! Mas antes, venha beber e cantar com a gente. Quando formos amigos, pode sentar onde quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150107,
					"content": "Conhece a melodia, né? Yo-ho, vamos lá! A gente canta um verso, você canta o próximo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150108,
					"content": "\"O som da dança vinha dos vizinhos, meus pés começaram a bater, ah!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "Não, não, não! Tá falando sério? Todo mundo de Nod-Krai conhece essa música, qual é!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150113,
					"content": "Se não cantar e se divertir, não vai se enturmar, entendeu? E as coisas não acabam bem pros soldados sem parceiros quando a Caçada Feroz aparece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150114,
					"content": "Vai aprender a música e depois volta aqui, entendeu? Ia-hê! Manda mais uma cerveja aqui, vai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fantasma Barulhento"
				},
				{
					"id": 760150110,
					"content": "\"Minha parceira Paimon é engraçada demais, me faz rir sem parar, ho-ho-ho!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "\"Os fantasmas da ilha vêm cercar a cadeira, cantando e dançando pra lá e pra cá!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Só me empresta o assento um pouquinho, pode ser?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
