			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "Meu nome é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410602,
					"content": "Aberaku, criador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410603,
					"content": "E... Uh... Paimon é Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410604,
					"content": "Então agora estamos nos apresentando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "Bem, já que ele começou, fale o seu também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410606,
					"content": "Acho que é só uma questão de educação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410607,
					"content": "Oh, não é nada demais. Realmente fui eu que lhe tratei com desconsideração, e lhes recebi em um estado tão deplorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410608,
					"content": "#Não se preocupe! {NICKNAME} e Paimon não se importam, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410613,
					"content": "Entretanto, por que você ainda está aqui, senhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410614,
					"content": "Eu... Eu sou o criador de Helios, e esse lugar... É onde descansarei para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410615,
					"content": "Adormecer em um local escuro e frio para nunca mais acordar... Como que eu, criador de Helios, poderia morrer assim?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410616,
					"content": "O criador de Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410617,
					"content": "O que é Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410618,
					"content": "Ah, sim. Helios é como eu chamo privadamente a minha criação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410619,
					"content": "Talvez isso seja desconhecido para você, mas o povo do Reino de Byakuya chamam essa coisa de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410620,
					"content": "Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410621,
					"content": "Helios é o Dainichi Mikoshi. A carruagem solar que transporta o Hype{RUBY#[S]Byakuya no Hikari}rion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410622,
					"content": "Então você é o criador do Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "Sim, sou eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410625,
					"content": "Ó, Viajante de uma terra longínqua... Apesar de eu ter o criado, eu fui posto em prisão domiciliar, e me encarceraram sobre minha própria criação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410626,
					"content": "Após minha morte, minha alma foi espalhada pela terra do Reino de Byakuya, e muitas de minhas memórias foram perdidas nesse processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410627,
					"content": "Lembro que havia algo muito importante... Acima do Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410628,
					"content": "Mas eu esqueci. Por favor, Viajante de longe... Poderia me ajudar a recuperar minhas roupas, coroa e ossos que foram colocados em três locais diferentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410629,
					"content": "Você pode encontrar no Estreito, no Templo da Noite Eterna e no Coração da Serpente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410630,
					"content": "Ofereça-os aos três altares, assim minha alma será reunida e eu serei capaz de abrir o caminho do Dainichi Mikoshi para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410631,
					"content": "Assim você será capaz de viajar acima do Dainichi Mikoshi, nos espaços fechados escondidos no véu da Noite Eterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410623,
					"content": "É você então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "Meu nome é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "#...Entendo. Você é {F#uma}{M#um} visitante de longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410611,
					"content": "Só lamento que vim lhe encontrar em um estado tão deplorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410612,
					"content": "Não tem problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224112",
							"2"
						],
						"stepId": 7224112,
						"stateName": "QUEST_STATE_UNFINISHED"
