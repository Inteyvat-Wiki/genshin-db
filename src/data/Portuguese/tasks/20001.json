						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "Meu plano era pegar algumas frutas aqui e vender na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "Eu não estava à espera de que haveria um obstáculo pelo caminho e me surpreenderam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Vou voltar a Mondstadt agora. Faça uma visita à loja na cidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Tome isso como o meu agradecimento! As minhas frutas são bem frescas, razão pela qual a Beatrice sempre vem comprar!",
