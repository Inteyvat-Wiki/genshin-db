			"dialogs": [
				{
					"id": 701080401,
					"content": "Olá, como posso ajudar você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Tenho uma carta aqui para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Uma carta?... Oh, é dela. Aposto que ela está perguntando novamente sobre a próxima equipe de exploração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*Suspiro* Não sei o que posso fazer, é raro encontrar uma equipe que esteja disposta a enfrentar a montanha hoje em dia. É muito perigoso lá em cima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Vou escrever uma carta para ela em breve e explicar a situação. Obrigado por vir até aqui para entregar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Por falar em cartas, ela mandou outra faz pouco tempo me pedindo para preparar uma recompensa para você. Por favor, aceite isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Uma última coisa... vejo que você é resistente, mas mesmo assim tenha cuidado nas montanhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ah, Espinha do Dragão... Se em algum momento surgisse a chance de liderar uma equipe de exploradores lá pessoalmente, eu certamente a aproveitaria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
