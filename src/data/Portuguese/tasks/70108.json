			"dialogs": [
				{
					"id": 701080301,
					"content": "Você colocou o sinalizador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Ótimo! Obrigada, agora posso finalmente obter uma medição confiável da altura da montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Ah, e com relação à compensação - pedi a Cyrus para fazer algo. Peça a ele na próxima vez que estiver na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "E já que você o verá antes de mim, poderia entregar a ele esta carta? Ele prometeu me manter informada sobre uma segunda equipe de exploração a caminho das montanhas, mas ainda não falou nada sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Assim que o restante dos meus sinalizadores for consertado, precisarei voltar para ajustá-los. Há muitas coisas que ainda precisam ser examinadas naquela montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
