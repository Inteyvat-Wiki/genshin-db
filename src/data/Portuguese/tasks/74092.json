			"dialogs": [
				{
					"id": 740920101,
					"content": "Por que... por que tem que ser assim... que maldade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "Srta. Chronie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}! Você está aqui! Que maravilha... é você... pelo menos você sabe a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Se acalme, Srta. Chronie. Você... você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Mesmo... mesmo que meu artigo não seja publicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "Qual o problema com seu artigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "É! Estávamos pensando quando que poderíamos finalmente ver ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "Não viu... é, você não viu, você provavelmente não viu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "Você parece... meio nervosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "É assim... desde que eu voltei do Instituto de Pesquisas de Fontaine, eu comecei a escrever meu artigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "Eu coloquei tudo que vi, escutei e senti em um rascunho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "Bem como o Instituto nunca removeu completamente o Arkhium, mas ao invés disso, recomeçou outro projeto de pesquisa relacionado ao Arkhium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Alguém que costumava trabalhar sob Edwin foi enviado para explorar as ruínas do Instituto, mas perdeu sua vida em uma explosão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "O Técnico Sênior Raimondo recusou confirmar sua morte e insistiu que a explosão foi uma parte planejada do projeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "Além da máquina gigante fora de controle nas ruínas, e a água poluída...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "Tudo que o Instituto de Pesquisas de Fontaine queria esconder, eu detalhei tudo no artigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Mas... após eu entregar ele, me disseram que o Instituto moveu uma ação contra mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Segundo regulamentos editoriais, tudo que eu relatei sobre o Instituto de Pesquisas de Fontaine no artigo deve passar por uma análise de credibilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "E meu artigo sobre o Instituto de Pesquisas de Fontaine foi rejeitado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "Uma análise de credibilidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "Não, a análise não era sobre nenhum relatório específico, mas sobre mim pessoalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "Em termos simples, o Instituto de Pesquisas de Fontaine me acusou de inserir minhas próprias emoções subjetivas na reportagem devido a conflitos de interesse com o Instituto e espalhar informações falsas ao público...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "Mas você tem um conflito de interesses com o Instituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Ela só tirou umas fotos de rochas desgastadas e máquinas quebradas... Qual conflito de interesse poderia existir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "Por que você expôs as práticas antiéticas deles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Eles... Me acusaram de vazar o design da nova linha Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Eles insistiram que algumas das fotos que tirei nas ruínas revelaram partes do último design de Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Eles devem ter examinado minuciosamente cada foto. Até lá, eles não removerão a ação e devo continuar sujeita à análise de credibilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "É obviamente um esquema para impedir meu artigo de ir a público... mas eu não desistirei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "Aqui, pegue isso! É uma cópia do jornal que imprimi secretamente. Vou distribuir mais cópias em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Tenho que informar a todos da verdade por trás do Instituto de Pesquisas de Fontaine, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Srta. Chronie! O que você ainda está fazendo aqui? Estive te procurando em todo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "Ah não, alguém tá vindo. Não posso ficar aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Aqui está uma cópia, guarde bem. Eu escrevi a verdadeira história nela! Toda ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "Conforme as regras, agora você deveria estar na Maison Gestion para sua análise rotineira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "Ei, por favor, não fuja, Srta. Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "É só Fonta e provavelmente é apenas um mal-entendido! Se você só explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "Espere! Por favor, pare, Srta. Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "Seu jornal não acredita que seu relato era confiável?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}