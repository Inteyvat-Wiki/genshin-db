			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "Que bom te ver de novo! Você ainda se lembra de mim? Se não, pelo menos se lembra das conversas de amizade com os Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Ugh, não me olhe assim. Para aprender uma língua, tem que praticar bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Relaxa! Seus esforços não foram desperdiçados! O meu nível oral de Hilichurlês já melhorou bastante desde a última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Mas o escrito também não se pode deixar atrás. Então depois de umas pesquisas intensas, tenho escrito algumas séries de poemas em Hilichurlês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Mas... Há algumas frases das quais ainda não tenho a certeza. Você pode confirmar por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "...\"Confirmar\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Sabe, tipo... Leia-os para um Hilichurl e veja como eles reagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Mas, não se preocupe. Já <color=#00E1FFFF>marquei</color> as linhas onde eu tenho dúvida. Creio que não está longe do significado verdadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "Já selecionei uns alvos. Aqueles Hilichurls parecem simpáticos. Vá lá e leia as frases a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Obrigada por sua ajuda! Volte aqui depois de ter lido a poesia para os Hilichurls, eu quero saber tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "Ler aos Hilichurls de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Sim. Parece que já está muito familiar com isso. Não se preocupe, já <color=#00E1FFFF>marquei</color> as linhas onde eu tenho dúvida. Creio que não está longe do significado verdadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "Já selecionei uns alvos. Aqueles Hilichurls parecem simpáticos. Vá lá e leia as frases a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Obrigada por sua ajuda! Volte aqui depois de ter lido a poesia para os Hilichurls, eu quero saber tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "E, se não correr como planejado, tenho certeza de que você não terá problemas para resolver a situação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
