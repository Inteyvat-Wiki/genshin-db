					"content": "Então? Ao ver a sua cara, parece que correu bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "Sim, correu muito bem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Então a minha compreensão das palavras estava certa! Que bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Mais um passo grande na área dos estudos de Hilichurlês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Um dia, eu vou poder conversar livremente com os Hilichurls, e perceber todos os segredos escondidos! Quando chegar este dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "Eu posso dizer orgulhosamente que eu mereço o sobrenome \"Musk\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "Oh, tome isto como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
