			"dialogs": [
				{
					"id": 201031501,
					"content": "Não sei se os Hilichurls vão gostar dessas frases ou não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Porque você compõe os poemas em Hilichurlês?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Hum...Para ser sincera, há certas coisas que ainda não domino em Hilichurlês, por exemplo: gramática, sintaxe, e regência verbal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Eu me esforcei para escrever estas frases, mas talvez os Hilichurls não as achem naturais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "E se mudar uma palavra, pode mudar totalmente o significado da frase... Então praticar com os Hilichurls é única maneira de aprender Hilichurlês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Mas muita gente acha intolerável aprender Hilichurlês com os Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Mas não eu! Ou melhor dizendo, eu tenho que fazer isso para dominar Hilichurlês e compreender os Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "E seria uma ótima ideia se comunicar com os Hilichurls em volta de Mondstadt através de poemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Sobre as anotações...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "Ah, está falando das marcas no final? Hum, todo o vocabulário destes poemas, eu tenho certeza absoluta de ter visto nos outros textos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Eu segui rigorosamente a utilização original de cada palavra que li no livro, e tentei reunir os versos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "Mas os ideogramas são sempre complicados. A mesma palavra em contextos diferentes mudará o significado dos versos",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Tenho mais confiança nestes versos, relativamente falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "Há alguns versos que eu não sei traduzir. É melhor não te mostrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Então já entendeu mais ou menos com estas notas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Apenas mais ou menos... Eu queria ter uma interação boa com os Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "Mas se acontecer algo inesperado, os Hilichurls talvez não me deixem explicar. Se eles me atacarem, não tem jeito de me aliviar do ataque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "Então, por favor, me ajude. heheh, não se preocupe, não vai acontecer nada se seguir as minhas notas. Relaxa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Sim... assim espero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
