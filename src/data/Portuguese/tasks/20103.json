					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "Então? Ao ver a sua cara, parece que as coisas não estão bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031204,
					"content": "Houve um pequeno problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "Você se certificou de seguir minhas anotações? Ou elas estavam erradas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "Desculpe, eu não sou tão competente como imaginava. Tenho que estudar mais. Muito obrigada pela sua ajuda. Leve isto como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031207,
					"content": "...Tenho que me esforçar mais para não desonrar o sobrenome \"Musk\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
