			"dialogs": [
				{
					"id": 413400701,
					"content": "Vocês vieram. Já escrevi meu desejo na Lanterna Celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400702,
					"content": "Agora é o momento perfeito... Vamos soltar a Lanterna Celeste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400801,
					"content": "Meu desejo é que todas as pessoas de Liyue não fiquem doentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400802,
					"content": "Quanto aos negócios do Chalé de Bubu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "Haha, isso é o meu desejo pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400804,
					"content": "Eu dou receitas médicas às pessoas porque não gosto de ver elas sofrerem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400805,
					"content": "Como diz um velho ditado: \"Que as doenças não afetem ninguém, ainda que nossas prateleiras acumulem poeira.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400806,
					"content": "Haha, se todos estiverem saudáveis, eu não estarei ocupado, portanto isso deve ser uma coisa boa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400807,
					"content": "Ah, droga! Agora eu lembrei, ainda há alguém que não entreguei o remédio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400808,
					"content": "Desculpe, eu preciso ir indo! Feliz Ritual de Lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herborista Gui"
				}
			]
