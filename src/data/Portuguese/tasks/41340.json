			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "Será que comi algo estragado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400202,
					"content": "Sobre o remédio de Herborista Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "Oh, obrigado! Este é o remédio que pedi ao Herborista Gui? Estou com indigestão, minha barriga não consegue mais aguentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400204,
					"content": "Eu estava caminhando pela cidade, comendo aqui e ali, e acidentalmente acabei comendo mais que devia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400205,
					"content": "O que exatamente você comeu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "Uh... Arroz frito, peixes, frutas, muitos camarões. E também bebi muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400207,
					"content": "Não surpreende que você está com uma indigestão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "Por isso que eu preciso de um remédio. Mas pense, se não posso comer o que eu quiser em um dia como esse, para que serve esse dia então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400210,
					"content": "Enfim, obrigado pelo remédio. Aproveitarei essa chance para descansar um pouco mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 413400208,
					"content": "Ainda que seja um festival, você não pode sair fazendo isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
