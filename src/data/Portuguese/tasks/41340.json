				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "Com licença, mesmo sendo um festival, preciso de sua ajuda. Todos os anos, muitas pessoas chegam doentes ao Chalé de Bubu durante o Ritual de Lanternas, estamos muito ocupados agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400102,
					"content": "Por que isso sempre acontece comigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "Durante o Ritual de Lanternas, todos saem de seus trabalhos para verem sua família. Naturalmente, comem e bebem de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400104,
					"content": "Desta maneira, é difícil que não sofram algum tipo de indigestão, ou outro tipo de doença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400105,
					"content": "Apesar de eu sempre dizer as pessoas para comer e beber com moderação, mas quando um festival chega, essas palavras não valem nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400106,
					"content": "Algumas famílias entraram em contato comigo e pediram remédios para indigestão e problemas intestinais. Mas não posso simplesmente largar o Chalé de Bubu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400107,
					"content": "Viajante, se você quiser, poderia me ajudar a entregar alguns remédios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herborista Gui"
				}
			]
		},
		{
