			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "Obrigado. Vocês entregaram todos os remédios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400402,
					"content": "Creio que eles continuarão doentes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "Não há o que fazer. Problemas estomacais não desaparecerão a não ser que se preste atenção ao estilo de vida. O máximo que podemos fazer é tratar os sintomas quando eles aparecem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400405,
					"content": "Mas, finalmente, eu posso descansar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400406,
					"content": "Sobre a Lanterna Celeste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "Soltar Lanternas Celestes? Nós não podemos soltar. Se soltam lanternas para fazer um desejo, mas o que o Chalé de Bubu desejaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400408,
					"content": "Os outros comerciantes desejam que seus negócios prosperem. Mas nós tratamos pessoas doentes, não podemos desejar que isso aconteça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400409,
					"content": "Você é uma pessoa muito bondosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "Mas como eu disse, eu ainda assim quero soltar Lanternas Celeste. Afinal de contas, é um festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400412,
					"content": "Eu tentei fazer uma Lanterna Celeste nos últimos dias, mas como estou muito ocupado, só tive tempo de começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400413,
					"content": "Poderia trabalhar um pouco nela agora que tenho tempo livre, mas quando a Lanterna Celeste estiver pronta, temo que o Ritual de Lanternas já terá acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400414,
					"content": "Vim ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "Mesmo? Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 413400410,
					"content": "Você é muito honesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400403,
					"content": "Creio que eles só melhorarão por um tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				}
			]
		},
