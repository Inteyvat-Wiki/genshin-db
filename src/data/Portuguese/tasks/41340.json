			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanhai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "Ai... Que dor... O que... O que você quer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400302,
					"content": "Sobre o remédio de Herborista Gui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "Oh, obrigado! É meu pedido! Chegou na hora certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400304,
					"content": "Melhorarei com esses remédios. Creio que peguei um resfriado por causa da brisa do mar durante a noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400305,
					"content": "Não é indigestão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "Indigestão? Meu estômago é muito forte. Deixe-me lhe dizer, antes eu conseguia comer três peixes assados de uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400307,
					"content": "Ainda hoje quando como e bebo, nenhum amigo meu consegue me rivalizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400308,
					"content": "Está bem, chega. Melhor eu tomar meu remédio logo, ainda há uma rodada de bebidas em seguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400309,
					"content": "Enfim, cuide de seu corpo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "Hahaha, não se preocupe, eu sou jovem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400312,
					"content": "Mas obrigado, vocês têm boas intenções. Eu tomarei cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanhai"
				},
				{
					"id": 413400310,
					"content": "Cuide de sua saúde antes que você se arrependa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
