				"points": []
			},
			"dialogs": [
				{
					"id": 220360201,
					"content": "Como posso utilizar o fertilizante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Oh, sim, certo, ainda não te expliquei isso. Os fertilizantes que você está levando para lá devem ser usados de uma certa maneira específica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Agora, deixe-me ver... De acordo com o manual, a ordem deve ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Primeiro adicione <color=#37FFFF>água limpa</color>, depois adicione <color=#37FFFF>folhas moídas</color>, e por último <color=#37FFFF>misture bem</color> e coloque no solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Não se engane na ordem, ou ele pode causar problemas, que afetarão a impressão que nossos clientes têm de nós. Nosso negócio futuro está em jogo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Eu me lembro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "Então, conto com você. Uma vez que você entregue a Bênção Anahitiana ao cliente, o primeiro pagamento será seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "Pode repetir o processo novamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Primeiro adicione <color=#37FFFF>água limpa</color>, depois adicione <color=#37FFFF>folhas moídas</color>, e por último <color=#37FFFF>misture bem</color> e coloque no solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "Conto com você, Viajante... Vamos todos trabalhar duro. Com alguma sorte, os negócios este mês podem ser bons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
