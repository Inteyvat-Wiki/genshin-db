			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Esse negócio é tão difícil. Todas as minhas mercadorias são boas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "Mas por qual motivo ninguém aqui quer comprar nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "Oh, é você Viajante. *Suspiro* Esqueça. Eu ainda não posso vender nenhum fertilizante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "Você não tem a Alrani para te ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Ela me ajudou um pouco. Mas o problema é que nenhum de nós sabe como promover essas coisas. Só podemos esperar que os clientes apareçam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "E você sabe como está a situação em Ritou. Ninguém está comprando nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Portanto, visitei os cavalheiros da guilda de mercantes para pedir ajuda, e eles sugeriram que fizéssemos algo chamado marketing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "Em resumo, eles querem que falemos mais sobre os efeitos dos fertilizantes e a teoria por trás deles com os clientes. Também deveríamos fazer uma promoção mais orientada aos dados, e deveríamos oferecer um serviço como \"testes gratuitos\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Mas... Eu realmente não entendo desses assuntos tão complexos. E não fui eu que inventei esses fertilizantes, então como posso explicar isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "De qualquer forma, mesmo que seja apenas recitar as instruções, acredito que ainda precisarei me virar e fazer alguma promoção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "A Alrani já está lá fora promovendo nossos produtos. Eu também vou sair mais tarde. Viajante, você poderia nos ajudar, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "Ótimo, então conto com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "O lugar que você está indo fica na \"Vila Konda\", não é muito longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Há um cavalheiro chamado Konda Densuke que demonstrou algum interesse em nossos fertilizantes. Ele também veio até a loja e conversou comigo um pouco mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Se você pudesse promover alguns de nossos produtos em sua casa e oferecer-lhe um teste gratuito, ele talvez poderia comprar alguns fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Aonde Alrani foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Ela disse que ia aproveitar para coletar alguma coisa, que precisava ir um pouco mais longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "O lugar que você está indo fica na \"Vila Konda\", não é muito longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203602,
			"completionStepIds": [
				2203602,
