				{
					"id": 411350201,
					"content": "Onde está o Grande Mestre? Uma coisa como essa acontece, mas não sei se ele recebeu as informações ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350202
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350202,
					"content": "Entretanto, ainda que ele tenha recebido a mensagem, não poderá estar aqui logo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
