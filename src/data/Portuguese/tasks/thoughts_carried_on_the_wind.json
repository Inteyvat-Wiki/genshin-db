				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "Vocês derrotaram todos aqueles monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350302,
					"content": "Já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "Muito obrigado, Viajante. Esses monstros não serão mais uma ameaça por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350304,
					"content": "Volte logo para a cidade, fiz você ficar fora da cidade durante uma situação como essa, peço muitas desculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350305,
					"content": "Depois que você voltar para a cidade, pode me ajudar com outra questão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350306,
					"content": "É muito simples! Só precisa ver algo e está resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350307,
					"content": "O que é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "Quando você voltar, pode dar uma olhada em como Glory está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350309,
					"content": "Ela está na cidade, não deve ter nenhum perigo, mas eu gostaria de relaxar ao saber que ela está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350310,
					"content": "Peço a você, por favor veja como ela está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350311,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "Obrigado, Viajante. Sim, por favor, diga... Diga à Glory que estou aqui... Que estou em um lugar distante em uma missão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350313,
					"content": "Sinto muito, mas por favor diga para ela o que eu digo para você: eu tenho as minhas desculpas e os meus sofrimentos. Muito obrigado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
