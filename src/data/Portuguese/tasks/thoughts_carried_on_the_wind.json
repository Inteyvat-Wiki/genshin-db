			"dialogs": [
				{
					"id": 411350101,
					"content": "Não sei como Glory está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "Você... É um viajante, os arredores da cidade são muito perigosos agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350104,
					"content": "Se você quer encontrar um local para se abrigar, então corra logo para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350105,
					"content": "Você não vai para a cidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "Eu... Agora não posso ir, no fim das contas, eu sou um Cavaleiro de Favonius... Não posso me acovardar nessas horas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350107,
					"content": "Mas devido a algumas coisas, não posso retornar para Mondstadt, mas posso ajudar a resolver a situação nos arredores da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350108,
					"content": "Depois que os meteoritos caíram, devido a sua influência, muitos monstros se tornaram mais violentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350109,
					"content": "Se ninguém lidar com eles, será um desastre, eu estou me preparando para ir fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350110,
					"content": "Você consegue resolver sozinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "Apesar daqueles monstros serem muitos... Se eu tiver cuidado, nada acontecerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350112,
					"content": "Posso lidar com eles sozinho, mas não sei quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350113,
					"content": "Viajante, se você quiser, pode me ajudar a destruir o acampamento dos monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350114,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "Muito obrigado, será de grande ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350116,
					"content": "Por que você não solicita ajuda para os Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "Pedir ajuda aos Cavaleiros de Favonius... Não é possível, eu só tenho a mim mesmo, não me pergunte mais sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350118,
					"content": "Por favor, me ajude a destruir o acampamento dos monstros, é o mesmo que ajudar os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
