			"dialogs": [
				{
					"id": 411350401,
					"content": "Espero que Godwin esteja bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350402,
					"content": "Godwin pediu que eu viesse ver como você está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "Godwin? Você sabe onde ele está? Faz um bom tempo desde que recebi notícias dele, estou preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350404,
					"content": "Ele ainda está em uma missão em um lugar distante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "Mesmo? Então... Tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350406,
					"content": "Se não fossem esses meteoritos caindo do céu, eu iria até os Cavaleiros perguntar sobre seu paradeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350407,
					"content": "Eu fico sempre dentro da cidade, portanto, ainda estou segura. Mas ele pode ter missões nos campos. Se todos os lugares do mundo tiver meteoritos caídos, é difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350408,
					"content": "Ai, espero que ele esteja bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350409,
					"content": "Ele está bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "Obrigada, assim é melhor. Se você quiser, pode me ajudar com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350411,
					"content": "Eu pedi para Flora comprar uma semente de Dandelion, queria encontrar alguém que me ajudasse a ir até um lugar alto para as jogar para o vento, e que ele as levasse até Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350412,
					"content": "Mas você está vendo a situação da cidade agora, não tem ninguém que possa me ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350413,
					"content": "Você chegou bem na hora, poderia me ajudar e levar essas sementes para Godwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350414,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
					"content": "Obrigada, ele com certeza está em um lugar muito distante, afinal ele está seguindo o Grande Mestre em uma missão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350416
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 411350416,
					"content": "Por favor, leve essas sementes de Dandelion para ele, diga que estou bem e... Depois diga para ele tomar cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
