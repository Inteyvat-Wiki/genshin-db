				{
					"id": 411350501,
					"content": "Viajante, você encontrou Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350502,
					"content": "Como Glory está? Ela está bem? Não está ferida? Ela sempre deve estar na cidade, mas ainda assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350503
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350503,
					"content": "Ela lhe mandou essas sementes de Dandelion.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350504
					]
				},
				{
					"id": 411350504,
					"content": "Uh? Sementes de Dandelion... Isso é bem o estilo dela. Ai, Glory... Espero que ela não esteja com raiva de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350505
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350505,
					"content": "Obrigado pela sua ajuda, por favor, receba isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 411350506,
					"content": "Ai, se o Grande Mestre puder retornar, não haverá mais problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
