			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "Sr. Guanchui, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230302,
					"content": "As 100 caixas de Frutas do Festival que você precisa foram encomendadas. Aqui está o recibo, pegue-o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230303,
					"content": "Ora, ora, ora! Vocês foram de grande ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230304,
					"content": "Vou pesquisar sobre o \"Frutas do Festival\". Irei misturar com uma proporção determinada de chá para tirar o melhor sabor dele. Trará bastante vigor para os camaradas quando tiverem no campo trabalhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230305,
					"content": "Uh, até soa como uma mistura de coquetéis, porém, misturar com chá... da para fazer assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230306,
					"content": "Fique tranquilo. Fui chefe de cozinha por um tempo quando estive fora. Este método consegue encontrar um equilíbrio entre custo e sabor, já o preparei diversas vezes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230307,
					"content": "Gostaria de ver...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "Quando voltarem a Vila Qingce, irei recebê-los com a bebida pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230309,
					"content": "#Ótimo! Então {NICKNAME} irá experimentar primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230310,
					"content": "Muito bem! Seu chef-tender!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "Obrigado pessoal! Quando tiver tempo, apareçam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
