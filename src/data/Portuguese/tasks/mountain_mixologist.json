			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "As bebidas especiais desta edição do Festvinho combinam com os chás feitos com água da nascente da Vila Qingce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230402,
					"content": "Obrigado pela contribuição de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230403,
					"content": "Conte-me sobre você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "Não demorou muito para que meus camaradas e eu voltássemos para o vilarejo. Normalmente sou responsável por preparar algumas refeições e levar para eles, que estão trabalhando nos campos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230405,
					"content": "No entanto, a maioria dos pratos que cozinho são simples e rudimentares, seria meio vergonhoso servi-los a convidados vindo de fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230406,
					"content": "A Vila Qingce pode não ser muito animada, no entanto, suas delicadezas são muitas, é só dar uma volta por aí você vai ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230407,
					"content": "Sobre o chá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "Os camaradas que trabalham no campo estão sempre sedentos. Eles geralmente vêm até aqui para virar uma grande chaleira de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230409,
					"content": "Há uma certa distância entre o campo e a barraca de chá no vilarejo, o que torna as coisas um pouco inconveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230410,
					"content": "O Tio Kai está muito velho para ser incumbido da tarefa de servir chá para os camaradas, então, cuidarei deste trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230411,
					"content": "Eu e alguns camaradas tentamos a sorte por aí por um tempo, o chá servido em grandes chaleiras era meio fraco para nós, alguns queriam beber algo mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230412,
					"content": "Por isso, irei introduzir algumas bebidas no chá, para buscar um sabor especial, o que deixará os camaradas bastante alegres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230413,
					"content": "Claro, os chás que preparo são somente para o consumo dos camaradas. Jamais desejaria tirar os negócios do Tio Kai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230414,
					"content": "Quando temos tempo livre, também iremos até à barraca de chás do Tio Kai para beber um pouco e ajudá-lo com algumas tarefas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230415,
					"content": "Voltaremos logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "Que maravilha! Esperarei por boas notícias suas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guanchui"
				}
			]
		},
		{
			"id": 7052321,
			"completionStepIds": [],
