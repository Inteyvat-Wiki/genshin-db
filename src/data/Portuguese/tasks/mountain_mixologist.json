			"dialogs": [
				{
					"id": 705230201,
					"content": "Ué! São vocês de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230202,
					"content": "Este pedido também é para o pessoal de fora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230203,
					"content": "Isso mesmo, hoje precisamos de 100 caixas de \"Frutas do Festival\", o solicitante se chama Guanchui. Ele é chefe de cozinha na Vila Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230204,
					"content": "Preparamos o preço, Sr.Georg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230205,
					"content": "Como que me parece que teremos um duelo comercial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "Oh! Que impulsivos! Então deixe-me ver a sua inspiração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				},
				{
					"id": 705230206,
					"content": "Por favor, aceite, Sr. Georg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
