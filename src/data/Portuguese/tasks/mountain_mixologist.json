					"Guanchui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "#Clientes vindo de fora? Bem-vind{F#as}{M#os} à Vila Qingce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230102,
					"content": "Olá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "Vamos com as apresentações, Paimon primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230105,
					"content": "#Este é o Viajante onipotente {NICKNAME}, e Paimon é a melhor companheira do Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230106,
					"content": "Estamos ajudando clientes estrangeiros com encomendas de bebidas especiais do Festvinho. Nós vimos a sua Comissão, por isso viemos falar diretamente com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230107,
					"content": "Ah, eu gosto de como você age de forma direta! Vamos direto ao ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230109,
					"content": "Sou o chef de cozinha Guanchui, gostaria de encomendar <color=#00E1FFFF>100 caixas de Frutas do Festival</color>. Vou misturar com água e chá para preparar uma boa bebida para os companheiros que estão trabalhando pesado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230110,
					"content": "Certo, então vamos ao trabalho. Por favor, nos forneça os fundos para a encomenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230111,
					"content": "Está preparado há um bom tempo! Por favor, aceite estas \"Geleias de Vinho\"! Tenho certeza de que haverá um excedente depois que o pedido for feito, e o que sobrar será a recompensa por seu trabalho duro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230112,
					"content": "Recebido! Já iremos partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230113,
					"content": "Que maravilha! Esperarei por boas notícias suas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "Guanchui"
				},
				{
					"id": 705230114,
					"content": "Que comunicação rápida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#Não fique aí parado, {NICKNAME}, vamos logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230117,
					"content": "Se tiver algo para dizer, espere até o pedido ter sido concluído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230118,
					"content": "Quanto antes terminarmos estes trabalhos, o mais rápido abriremos a loja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230119,
					"content": "Abir a loja, hunf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705230115,
					"content": "Paimon também está na estrada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "Com licença, você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
			"id": 7052302,
