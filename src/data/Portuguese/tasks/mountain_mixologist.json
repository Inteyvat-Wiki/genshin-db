			"dialogs": [
				{
					"id": 705232101,
					"content": "Nada disso, é muito pouco! Mesmo que quantidade total de pedidos seja maior, o preço unitário da caixa também não precisa ser tão baixo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7052322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705232201,
					"content": "Bem, esta não é uma oferta ruim, no entanto, se considerar a dificuldade para transportar até a Vila Qingce, isso se torna impraticável.",
					"roleType": "TALK_ROLE_NPC",
