			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600201,
					"content": "Olá, você gostaria de tentar o Labirinto de Vento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600202,
						706600217
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600202,
					"content": "O que é o Labirinto de Vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600203
					]
				},
				{
					"id": 706600203,
					"content": "Ah, ótima pergunta! O Labirinto de Vento é um jogo que carrega a história de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600204
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600204,
					"content": "Você deve saber que no passado havia um grupo de nobres que governava Mondstadt, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600205
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600205,
					"content": "Eles faziam atrocidades terríveis na cidade sem parar, muitas pessoas viviam em sofrimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600206
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600206,
					"content": "Para resistir às atrocidades dos nobres, algumas pessoas corajosas de Mondstadt se ergueram e formaram um grupo secreto de resistência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600207
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600207,
					"content": "Esse grupo de pessoas corajosas realizavam operações por toda a cidade, causando problemas para os nobres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600208
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600208,
					"content": "Mas os nobres rapidamente também treinaram lacaios para reprimirem esses heróis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600209
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600209,
					"content": "E assim, os rebeldes lutaram contra os lacaios dos aristocratas em toda a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600210
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600210,
					"content": "O Labirinto de Vento é baseado nessa história épica real! Ele também era muito popular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600211
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600211,
					"content": "Era?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600212
					]
				},
				{
					"id": 706600212,
					"content": "Sim, mas os jovens de hoje não parecem estar tão interessados no Labirinto de Vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600213
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600213,
					"content": "Mas eu não posso deixar o Labirinto de Vento desaparecer dessa maneira. Por isso, fiz algumas alterações nas suas regras originais para que o jogo possa ser mais facilmente compreendido, e também mais interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600214
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600214,
					"content": "Além disso, eu também aumentei alguns mapas do jogo. Creio que dessa maneira mais pessoas venham participar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600217,
					"content": "Então, qual a situação com o Labirinto de Vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600218
					]
				},
				{
					"id": 706600218,
					"content": "Anteriormente consegui que algumas pessoas fizessem uma rodada de testes para o Labirinto de Vento. Algumas delas foram extremamente boas. Causaram uma verdadeira impressão em mim, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600219
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600219,
					"content": "Mas muitas pessoas disseram que o jogo estava muito difícil. Ou eram os Cavaleiros Errantes alegando que tinham poucas opções de fuga, ou eram os caçadores reclamando que não conseguiam encontrar ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600220
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600220,
					"content": "Alguns até mesmo se queixaram que você tem que estar muito familiarizado com cada mapa para jogar corretamente, e pediram que eu simplificasse a jogabilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600221
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706600221,
					"content": "*Suspira* Eu não sei a quem ouvir, então eu decidi convidar mais umas pessoas para testar o jogo, e então ouvirei o que elas tem a dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				}
			]
		},
