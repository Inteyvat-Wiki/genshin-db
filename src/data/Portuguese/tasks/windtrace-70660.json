					"content": "Jogar Labirinto de Vento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 706590303,
					"content": "Sair.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706590304
					]
				},
				{
					"id": 706590304,
					"content": "#Está bem. Se você estiver interessad{F#a}{M#o} em jogar o Labirinto de Vento, venho me procurar.",
