			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706600101,
					"content": "#Bem-vind{M#o}{F#a}, aventureir{M#o}{F#a}. Como têm sido suas viagens até então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600102,
						706600105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600102,
					"content": "Acho que estão indo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600103
					]
				},
				{
					"id": 706600103,
					"content": "#Isso é bom. Você está no caminho certo para se tornar {M#um aventureiro}{F#uma aventureira} realmente incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600104,
					"content": "#Ah, sim, se você estiver interessad{M#o}{F#a}, você pode ir até o Gygax e tentar a última edição do Labirinto de Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600108,
					"content": "Isso tem algo a ver com a Guilda de Aventureiros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600109
					]
				},
				{
					"id": 706600109,
					"content": "Bem, na verdade, o Gygax colocou uma comissão para que nós o ajudássemos a procurar pessoas para testarem o Labirinto de Vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600110,
					"content": "Então acho que nessa questão você poderia dizer que estão relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600111,
					"content": "#De qualquer forma, tente, se você estiver dispost{M#o}{F#a}. Segundo os aventureiros que já o jogaram, é na verdade bastante divertido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600105,
					"content": "Tem alguma comissão nova?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706600106
					]
				},
				{
					"id": 706600106,
					"content": "No momento não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706600107,
					"content": "#Mas se você estiver interessad{M#o}{F#a}, você pode ir até o Gygax e tentar a última edição do Labirinto de Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706600108
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7066002,
