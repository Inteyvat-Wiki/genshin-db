			"dialogs": [
				{
					"id": 790501501,
					"content": "Hehe, foi um sucesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501502,
					"content": "As Gotinhas estão felizes, Paimon está se sentindo alegre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501503,
						790501504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501503,
					"content": "Temos que proteger o cristal da amizade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501505
					]
				},
				{
					"id": 790501505,
					"content": "Sim, falando nisso, as obras e amigos daquele pintor estão na Miragem Veluriyam. E tudo está em ótimas condições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "Paimon espera que no futuro ele possa voltar a se encontrar com seus amigos e ver a obra-prima que deixou para trás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "Falando nisso, o estilo dessa pintura é único... Parece não ser muito refinado, mas é muito belo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "O importante é que Paimon consegue entender o que está vendo. Será que se Paimon copiar o estilo dessa pintura poderá pintar algo lindo como isso também? Paimon quer pintar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501509,
						790501510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501509,
					"content": "Uma pintura refinada não significa que ela tem que ser complexa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501511,
					"content": "Sim! Se você achar que não tem problema, podemos tirar uma foto desse mural!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501512,
					"content": "E com isso, Paimon poderá estudar a técnica desse pintor quando quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501514,
					"content": "Quando Paimon fizer uma pintura linda como essa, talvez acabe chamando a atenção das Gotinhas e então vamos virar amigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501510,
					"content": "Você quer aprender esse estilo, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790501511
					]
				},
				{
					"id": 790501504,
