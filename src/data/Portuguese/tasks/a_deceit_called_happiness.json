			"dialogs": [
				{
					"id": 120460201,
					"content": "Mizuki, estamos aqui para agendar nossa próxima consulta de terapia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460202,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Hyakujitsu Hakushion"
				},
				{
					"id": 120460203,
					"content": "Agh... Isso dói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Shibamura Saki"
				},
				{
					"id": 120460204,
					"content": "Oh, não... O que tem de errado com elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460205,
					"content": "Elas estiveram assim desde que acordaram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460206,
					"content": "...É um caso extremo de indigestão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460207,
					"content": "Hã? Como pode? Elas comeram muitos pesadelos ontem à noite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460208,
					"content": "#Duvido... Nós só tivemos quatro clientes ontem, incluindo vocês {M#dois}{F#duas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460209,
					"content": "Paimon culpa os outros dois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460210,
					"content": "Você está certa. Algo está definitivamente errado com os pesadelos deles... Nossa habilidade de digerir sonhos não é somente questão de quantidade. Depende da intensidade emocional também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460211,
					"content": "Meu ponto é, nenhuma pessoa normal deveria ter um pesadelo dessa magnitude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460212,
					"content": "Bleerg...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Hyakujitsu Hakushion"
				},
				{
					"id": 120460213,
					"content": "A situação é grave. Se eu não conseguir encontrar uma maneira de ajudá-las a digerir os sonhos logo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460214,
					"content": "O que podemos fazer? Deixe a gente ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460215,
					"content": "Nós precisamos encontrar aqueles dois clientes de ontem e descobrir a causa dos seus pesadelos. Sem saber disso, eu não tenho como tratar elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Paimon, Eu sei que vocês conversaram com eles. Acham que podem encontrá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460217,
					"content": "Vamos ver... Hmm, eles disseram que eles teriam uma consulta com o Emura Ichigensai novamente. Provavelmente a gente encontra eles lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460218,
					"content": "Mostre o caminho. Vou com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
		{
			"id": 1204603,
