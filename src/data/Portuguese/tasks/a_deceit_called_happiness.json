			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Susukida"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3098.524,
							214.543,
							-4296.803
						],
						"pointId": 322100690
					},
					{
						"sceneId": 3,
						"position": [
							-3097.322,
							214.326,
							-4298.16
						],
						"pointId": 322100714
					}
				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "Sabe, eu saí para o mar mais cedo hoje, mas estava tão distraído que perdi a minha rede... Ah, bem, não é um grande problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "É, eu também fiz bobagem hoje... mas ei, qual é o problema? Alguns bandidos fugiram, não é o fim do mundo, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "Ei, vocês dois! Murasaki e Shion estão doentes e é tudo culpa dos seus pesadelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Uau, alguém está de mau-humor, hein? Tão engraçado, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "Pois é, né? Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Uhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "Eles estão agindo tão estranhos! Paimon foi bem agressiva agora há pouco, mas eles não parecem nem um pouquinho ofendidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "...Permitam-me. Senhores, vocês ainda se lembram de terem feito uma visita à Banhos de Aisa ontem à noite para uma terapia de regulamento dos sonhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "Nós fizemos isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "Eu acho que não...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Hã... Vocês se lembram de terem qualquer pesadelo recentemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "Não, por que eu teria? O que nesse mundo seria tão ruim ao ponto que me daria pesadelos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Hum... Não, nada vem à minha mente. Pesadelos devem ser bem irregulares, certamente? Você não tem que olhar longe para ver que a vida é bela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "O que está acontecendo? É como se eles tivessem esquecido completamente do que eles fizeram ontem à noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "Apesar que Paimon consegue acreditar no que eles estão dizendo. Eles não parecem exatamente preocupados com pesadelos... Isso significa que a orientação do Emura Ichigensai realmente funciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#Não, eles claramente não estão de pleno juízo... {NICKNAME}, Paimon, se concentrem bastante por um segundo. Vou tentar algo pouco ortodoxo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "Uau, o que você fez...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "Entrei no subconsciente deles. Eu percebi que eles dois estão desassociados de seu subconsciente, o que significa que consigo acessar eles — é parecido com a maneira que entro nos sonhos das pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "Não, nãooo! Aqueles ladrões, não vou deixar eles escaparem dessa! Não vou permitir!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Susukida com Raiva"
				},
				{
					"id": 120460321,
					"content": "O mar está muito agressivo hoje... eu deveria ficar em terra firme até as coisas se acalmarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Umihiko Assustado"
				},
				{
					"id": 120460322,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "Como pode ver, os problemas deles não foram a lugar nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Susukida parece ter um pavio curto, que faz com que ele aja fora de linha. Tenho certeza que isso lhe causou muito sofrimento em sua área de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "Quanto a Umihiko... Acredito que ele desenvolveu um medo a ondas tempestuosas depois de uma experiência de quase morte. Agora, ele fica relutante em sair para o mar, o que está tendo um impacto devastador em seu sustento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Suas emoções negativas foram isoladas de suas mentes conscientes e deixadas para flutuar pelo seu subconsciente. É por isso que, por fora, a única emoção que parecem sentir é felicidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "Mas essas emoções suprimidas apenas continuarão a apodrecer em seu subconsciente, eventualmente se tornando os pesadelos que andam causando indigestão em Murasaki e Shion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "Como isso aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "...Se isso é coisa de Emura Ichigensai, acho que ele não é o simples trapaceiro que achávamos que era. Talvez ele realmente tenha formas de influenciar as emoções humanas. Isso explicaria o motivo de ninguém ter dedurado ele ainda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "Você notou algo estranho quando veio aqui ontem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Na verdade, não. Eles pareciam bem mais sérios do que hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "Na verdade, já que você perguntou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "Você se lembra do sonho estranho de ontem e conta para Mizuki.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "Você deixou isso quieto mesmo, hein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "Não pensei muito sobre isso no momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "Oh, não, não, não... Veja, temos que encontrar Emura Ichigensai imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki... O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "#Algo sobre-humano está acontecendo em Emura Ichigensai. Os sonhos {M#do}{F#da} Viajante confirmam isso... Todos que receberam sua suposta orientação são vítimas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "Se não o encontrarmos e o impedirmos o mais rápido possível, suas vítimas podem sofrer danos irreversíveis em sua psique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "Eita... Bem, acho que temos que pressionar mais esses caras. Vocês sabem quando Emura Ichigensai estará aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "Que urgência é essa? Do que importa quando ele vai aparecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "É, ele vai aparecer quando estiver pronto. Não adianta apressar ele, heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "Urg, isso é irritante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "...Vocês se lembram do que aconteceu ontem à noite, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "Só que vocês não querem falar sobre isso, pois não conseguem conciliar a presença de um pesadelo com a felicidade que sentem no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Só de pensar nisso, vocês têm uma sensação avassaladora de estarem sendo destroçados. Vocês não conseguem descrever exatamente, mas sentem que estão por um fio, à beira de um colapso total... Não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "...Por favor, pare. Tudo vai ficar bem, desde que não pensemos sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "O tratamento de Emura Ichigensai claramente os deixou feridos e vulneráveis. Mas não se preocupem — não estou aqui para os arrancar da sua negação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "...Pelo menos, desde que vocês respondam nossas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "Tudo bem... Mas, sério, realmente não fazemos ideia. Já perguntamos e tudo que sabemos é que ele não virá hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Sim, uh... aparentemente a sessão de ontem meio que... cansou ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "Ele está tentando se esconder de mim de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "Eles realmente não sabem de nada? Droga. Parece que chegamos a um beco sem saída...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "Imagino que você não saiba onde ele mora, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "Não. Perguntamos ontem, mas nem mesmo seu guarda sabia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "Nesse caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Você encontrou o que veio procurar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Sim, acho que sim... Agora que sei o que está causando seus sonhos ruins, posso administrar o tratamento correto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "Então, vá fazer isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "...Honestamente, você já fez sua parte ao me trazer até aqui. Não posso continuar te incomodando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "Não se esqueça que queremos marcar nossa próxima sessão de terapia! Quanto mais cedo você puder parar de se preocupar com Emura Ichigensai, mais cedo você ficará livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "Então, não vamos parar até que isso tudo esteja resolvido e a casa de banho esteja de volta ao normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "...Parece que eu não tenho escolha além de aceitar sua ajuda mais uma vez. Tenho que garantir que Murasaki e Shion recebam o tratamento que precisam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Mesmo assim, vou precisar de toda sua cooperação. Se vocês encontrarem Emura Ichigensai, por favor, não se aproximem dele. Apenas me mandem uma mensagem e fiquem de olho nele até que eu chegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "A última coisa que quero é que vocês se coloquem em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "Ah, não se preocupe com isso! Você deveria ver alguns dos outros malvadões que já enfrentamos. Esse cara não é nadinha de nada comparado a eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "...Tá bom, tá. Vamos ficar longe e te mandar uma mensagem, heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Certo. Então, vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "...Muito ousado da sua parte, dizer que vai encontrar esse cara. É legal da sua parte dar à Mizuki uma coisinha a menos para se preocupar e tal, mas... o que porcarias fazemos agora? E se não conseguirmos encontrar ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "Pois, caso não tenha percebido, esses caras não têm salvação. Eles não sabem de nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Sim, eles definitivamente não fazem ideia de nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Miko? Espera, você tem razão — foi ela quem nos contou sobre esse lugar ontem! Ela provavelmente sabe bem mais do que está deixando parecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "Não há tempo a perder! Para o Grande Santuário Narukami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "Mas, suspeito que Miko saiba de algo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "Eu procurarei Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "Você consegue ajudar Murasaki e Shion agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204604",
							"2"
						],
						"stepId": 1204604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2470.723,
							445.64,
							-4409.953
						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "Ela normalmente está em algum lugar por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460402,
					"content": "#Vieram tirar um rolinho da sorte, pequenin{M#o}{F#a}s? Ou visitar uma amiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460403,
					"content": "Eita! De onde você veio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "Já faz um tempo, Senhorita Guuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "#Isso foi meio fraco. Você está começando a soar parecidinh{M#o}{F#a} com ela... Mas, deixando as formalidades de lado, qual o problema? Você parece meio afoit{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "Precisamos encontrar alguém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "Você deve se lembrar que deixei uma dica-não-tão-discreta sobre seu paradeiro ontem. Você está querendo me dizer que ainda não encontrou ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "Ahá, então você realmente falou dele de propósito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "...Não vamos perder o foco. Vocês vieram me pedir pela minha ajuda. Então, poderiam me explicar a situação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "É, justo... Fomos para o lugar que você mencionou, mas ele escorregou feito quiabo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Aí soubemos que ele não está mais recebendo pacientes por lá — aparentemente, ele ama sua paz e solidão... Então, obviamente não fazemos ideia de onde encontrar ele agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "*Suspira* Depois de tudo que fiz para conseguir a localização para vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Não sei se isso ajuda, mas realmente descobrimos algumas outras coisas sobre ele ontem. Por exemplo, um cara que combina com a descrição de Emura Ichigensai foi uma vez até Mizuki procurando terapia — só que seu nome era \"Emura Chuuya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "Espera, o quê? Emura Chuuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "Você conhece ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "Certa vez pedi à Editora Yae para organizar um evento para os contribuidores da coluna de cartas dos leitores. Eu esperava que poderia ser uma oportunidade divertida de conhecer pessoas com pensamentos parecidos para conversar... até que ele apareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "Você está me dizendo que aquele Emura, o criador de problemas e Emura, o curandeiro, são as mesmas pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Baseado em tudo que aprendemos até agora, certamente parece ser o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Certo. Bem, nesse caso... tentem esse endereço aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Uhh... Sério? Quem escolhe viver em um lugar desses?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "Esse era o endereço de entrega que uma vez ele deu à Editora Yae quando fez um pedido de algumas dezenas de livros de uma vez. Ele também pediu para pagar no recebimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "O armazém deu uma olhada e achou que era algum tipo de pegadinha, então rejeitaram o pedido... Ganhando uma menção honrosa em sua carta de reclamação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "É claro que, refletindo agora, é bem óbvio o motivo dele viver lá. Alguém tão antissocial quanto ele não seria bem-vindo em nenhum outro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "Você tem um bom ponto... Bem, claramente tomamos a decisão certa em vir falar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "Só estou feliz de poder ajudar minha velha amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "Está falando da Mizuki? Então, você realmente quer ajudar ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "Consigo perceber que ela está bem investida na Banhos de Aisa. É natural que eu tenha algumas preocupações quando vejo os negócios de uma amiga com problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "Sério? Porque ontem parecia mais que você estava procurando uma briga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "Imagino que Mizuki te contou que somos competidoras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "Ela sempre acreditou nisso, desde que éramos colegas. E agora que sou a Guuji do Grande Santuário Narukami, tenho certeza que ela deve sentir a necessidade de se provar através de seus esforços na Banhos de Aisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "A última coisa que ela gostaria é de que eu, de todas as pessoas, chegasse e salvasse o dia no momento que as coisas ficam difíceis... Então, se eu quiser ajudar, tenho que ter noção dos sentimentos dela e ir com cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "É raro te ver sendo tão atenciosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "Levarei isso como um elogio. Mizuki é sempre bem atenciosa com os outros — seria legal da parte de alguém retribuir isso de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Bem, já que você está em uma posição difícil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "#Muito bem, você entendeu a dica. Agora, apesar de eu ter certeza que vocês amariam conversar por mais tempo, vocês pareciam estar bem apressad{M#o}{F#a}s quando chegaram. Vocês não deveriam estar indo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "Oh, é mesmo! Vamos lá, vamos enviar uma mensagem para a Mizuki imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "...Talvez eu possa fazer as honras em vez disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "Sabe onde podemos encontrar Emura Ichigensai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
