				]
			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "Boas-vindas de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "Mas ainda não é hora de uma despedida extensa e tremendamente emocionante... Afinal, vocês não terminaram o tour da minha humilde moradia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "Mas Paimon podia jurar que a gente já viu todos os cômodos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Bem, eu nunca disse que não havia cômodos secretos, disse? Nós, bruxas, gostamos dos nossos segredinhos, sabe... vocês já deveriam estar acostumadas com isso a essa altura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "Por aqui, por gentileza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "Como um dos pontos de observação fixos de mudanças no mundo, preciso que tenha visibilidade excelente. Assim como um escultor precisa de um cinzel, um escritor precisa de tinta e caneta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "Minhas conquistas nesses dois campos das artes podem estar em discussão, mas, quando o assunto é minha área de trabalho, eu levo as coisas muito a sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}, com certeza você já deve ter notado: ultimamente, os abalos no \"destino\" de Teyvat estão ficando cada vez mais comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "Às vezes não consigo evitar pensar que, se eu ainda tivesse a forma, poder e habilidades que outrora tive, eu poderia fazer muito mais do que posso agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "Mas logo dissipo esses pensamentos de minha mente. Se as coisas fossem como eram antes, eu teria muito mais restrições impostas a mim pelos céus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "Só de pensar em ter tantas coisas das quais não posso nem falar, faz parecer uma troca terrível. Digo, como eu contaria história sem a liberdade de dizer o que eu quero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "É por isso que nunca me arrependi do preço que paguei, ou de nenhuma das escolhas que fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "Eu queria me tornar humana, viver como uma pessoa normal... mas tal vida é um luxo. Não posso esquecer que sou um anjo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Mesmo que eu estivesse presa sendo um anjo em silêncio, eu ainda cumpriria meus deveres, defendendo a civilização, defendendo a vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Ó, céus, comecei a falar sério demais de novo? Talvez seja por causa de onde estamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "Na verdade, estou bem feliz com meu lado angelical. Dá até para dizer que tenho orgulho dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "Devia mesmo! Você não se envolve tanto mas, quando faz, todo mundo sabe que tá em boas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "Você merece sentir orgulho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "Vocês acham mesmo? Hehe, contanto que me vejam como alguém confiável, vou saber que tô fazendo um trabalho fantástico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "Está ficando tarde. Aqui, peguem minhas bênçãos e continuem suas aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "Jamais tenham medo de perder o caminho e nunca esqueçam que têm um anjo cuidando de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
