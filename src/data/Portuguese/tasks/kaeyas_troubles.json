					"nextDialogs": [
						4610409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610409,
					"content": "De qualquer forma, contanto que eu não lhe diga a localização do tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610411,
					"content": "Não se preocupe, contanto eu não lhe diga a localização do tesouro...",
