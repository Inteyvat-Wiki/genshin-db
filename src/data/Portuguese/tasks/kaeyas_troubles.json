						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610404,
					"content": "Hum! Não viemos para fazer algo tão simples!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
