					"nextDialogs": [
						4610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610413,
					"content": "(E assim ela falou tudo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
