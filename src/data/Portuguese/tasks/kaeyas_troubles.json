			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "Este lugar serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610202,
					"content": "Nos conte logo o que é!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610203,
					"content": "Por onde começar? Ah, certo, deixe-me contar um segredo primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610204,
					"content": "É um segredo do meu passado e eu confio em você para guardá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610205,
					"content": "Não se preocupe, não irei falar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610206,
					"content": "Na verdade... Meu avô era um pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610207,
					"content": "Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610208,
					"content": "Não, não... Não é boa reação. Você acha que eu estou inventando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610209,
					"content": "Olhe para o meu tapa-olho! Eu a herdei do meu avô e isso é uma prova sólida de que somos parentes pelo sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610210,
					"content": "Nunca pensei que você poderia herdar o tapa-olho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#Hahaha, {NICKNAME}, como que você não sabe de algo tão básico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610212,
					"content": "Isso não é diferente das crianças que herdam os penteados dos pais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610214,
					"content": "Ontem, eu estava dando uma olhada nas anotações que meu avô deixou e encontrei alguns registros que falavam sobre um <color=#00E1FFFF>tesouro</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610215,
					"content": "... Tesouro!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610216,
					"content": "Segundo suas anotações, o tesouro está enterrado nas \"Ruínas Perdidas de Arcadia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610217,
					"content": "Tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610218,
					"content": "Mas o paradeiro dele ainda é desconhecido, ainda não temos pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610219,
					"content": "Tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610220,
					"content": "Kaeya! Que tipo de tesouro é? Ouro? Gema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610221,
					"content": "Hunf! Tesouros que são apenas ouro e gemas são tesouros de terceira categoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610222,
					"content": "O tesouro do meu avô é uma espada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610223,
					"content": "Uma espada mágica que concede um poder implacável ao portador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610224,
					"content": "Uau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610225,
					"content": "A espada foi lançada de Celestia ao mar por um deus. Posteriormente, foi recuperada por uma tripulação do meu avô por coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610226,
					"content": "No momento em que ele segurou a espada, trovões rugiram, ondas uivaram, e o céu claro foi subitamente engolido por ventos furiosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610227,
					"content": "Com o poder da espada mágica, meu avô derrotou uma hidra, uma Banshee de cabelos prateados, um dragão do abismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610228,
					"content": "O poder imenso da espada atraiu muitos mais piratas gananciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610229,
					"content": "Para evitar conflitos, meu avô escondeu a espada mágica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610230,
					"content": "Hidras, Banshees... Essas criaturas realmente existem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "O mundo em que vivemos é fascinante, cheio de maravilhas desconhecidas e inexplicáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610233,
					"content": "Essas aventuras incrivelmente emocionantes são romances que só poderiam ser contados pelos piratas, você não concorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610234,
					"content": "Uau, isso é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610235,
					"content": "Uma gangue de <color=#00E1FFFF>Ladrões de Tesouro</color> tem estado muito ativa ultimamente e roubou as relíquias de muitas ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610236,
					"content": "Tenho receio de eles acabarem descobrindo as Ruínas de Arcadia e acabarmos perdendo a espada mágica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610237,
					"content": "Não vamos deixar cair nas mãos erradas! Temos que pegar a espada antes que eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610238,
					"content": "#Sem dúvida você pode contar com {NICKNAME} e comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610239,
					"content": "Oh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610240,
					"content": "Mas, por favor, mantenha isso em segredo. Espero boas notícias suas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610241,
					"content": "#Ei, então, o que você acha, {NICKNAME}? Não soa emocionante? Digo, parece ser uma espada super poderosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610242,
					"content": "É sério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "Bem... Vamos para a <color=#00E1FFFF>Guilda de Aventureiros</color> e ver o que conseguimos descobrir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610245,
					"content": "Os aventureiros devem saber mais sobre as ruínas, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610243,
					"content": "Será que realmente é verdade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
					"content": "Que surpresa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610214
					]
				}
			]
		},
		{
			"id": 46104,
