			"dialogs": [
				{
					"id": 401730501,
					"content": "#Hm? Estava me procurando, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730502,
					"content": "Em breve tenho que devolver a espada cerimonial ao chefe, mas deixarei o resto do acampamento do jeito que está. Sinta-se livre para usar a vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730503,
					"content": "Uh... Tenho o último volume dos \"Guerreiros das Miragens\" bem aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730505,
					"content": "...Bem como a edição especial de \"Os Documentos do Caso da Srta. Orith\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "HÃ!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730507,
					"content": "Quer ler comigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730509,
					"content": "#(O que é isso? O que está acontecendo? Como que {M#ele}{F#ela} sabia que eu gosto desses livros? Não me diga que... {M#Ele}{F#Ela} anda procurando sobre meus gostos?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730510,
					"content": "(Não, isso é ridículo, não seja idiota... Aposto que Ororon saiu falando, aquele ridículo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730511,
					"content": "#(Mesmo assim... {M#Ele}{F#Ela} se lembrou dos meus gostos? Bem, na verdade, não faria diferença mesmo se {M#ele}{F#ela} não se lembrasse, não é algo tão importante sobre mim assim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730512,
					"content": "#(O que eu deveria focar é no fato de que {M#ele}{F#ela} acabou de me chamar para sair! O que eu deveria fazer? Como deveria responder!?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730513,
					"content": "Ahem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730514,
					"content": "Claro, por que não. Devo ter um tempinho mais tarde. Te avisarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
