						710380403
					]
				},
				{
					"id": 710380402,
					"content": "Não se preocupe, te levarei de volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380403
					]
				},
				{
					"id": 710380403,
					"content": "Desculpe... me desculpe, Jinwu... e... cof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380406,
					"content": "Não fica olhando para mim assim, por favor *Cof, cof*... Eu não queria desapontar ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710380407,
					"content": "A cidade dourada... a torre de vigia negra...! Cof. Os emissários celestiais partiram...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380404
