				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Olá, Viajante, sente-se por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Sobre a aventura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Você quer perguntar por que eu estava tão teimosa deixando todo mundo se preocupar comigo? Haha... Me perdoe por favor, sei que estava errada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "Mas pensando bem, o apego pelos \"riscos\" é algo com que nós aventureiros nascemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "Afinal de contas, nascemos com força e agilidade. Parece... errado, ter essas ferramentas, mas se contentar com uma existência plácida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Na verdade eu também pensei em riscos fatais... mas... eu poderia fazer uma pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "O grande aventureiro de Mondstadt, Stanley, é conhecido por ter atravessado o Mare Jivari... mas ele perdeu seu melhor amigo nesta aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "Mesmo que pouca gente lembre do nome desse amigo que infelizmente morreu em aventura, as histórias sobre ele têm se espalhado entre aventureiros até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Estou pensando... Haha, não me ache infantil, por favor... Estou pensando... Errrr, será que o amigo do Stanley não morreu, mas continua \"vivendo\" de verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "O que importa é a própria vida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Apesar de ter morrido cedo pela aventura, ser lembrado por todo mundo não é uma continuação da vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "Quer dizer, ele continua vivendo entre todos de outro jeito, sendo lembrado, comentado e admirado por outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "Não se importe com o que outros acham de você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "Muitas pessoas me disseram a mesma coisa. \"Seja você mesmo\", \"Cuide da sua vida\"... Parece que eles estão tentando te ajudar, mas eles só querem que você desista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Eu sempre digo, não vou em aventura por ninguém, nem mesmo por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Hmm... Você pensa o mesmo, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Este mundo é dominado pelos Arcontes, mas nós, pessoas mortais, mesmo sem uma Visão, também não queremos ir em silêncio e ser esquecidos assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Acredito que esse sentimento de descontentamento é a razão porque nos aventuramos e corremos esses riscos. Afinal de contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "Quero dizer, lutar com coisas que até mesmo os arcontes temem, mesmo com nossos corpos frágeis... não é o que nos fazem \"humanos\"? Isso é o que eu acredito pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Mas não é apenas você que faz a sua aventura significante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Eu sei... Eu nunca vou me esquecer da ajuda de todos e dos problemas que lhes causei... Afinal de contas, esta aventura não é apenas minha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "Haha, isso não é o que as aventuras são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Você quer ser uma heroína tanto assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "Heh, ainda estou bem longe de onde você está... Ao invés de \"heroína\", eu me chamaria de alguém que \"não tem medo de morrer se realmente tiver vivido\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "Foi uma aventureira de Sumeru que me disse. E ela aprendeu isso com os Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Acho que isso faz muito sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Bem, Paimon acha que você é mais \"alguém que vive procurando problemas\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Ser lembrado por alguém também é um tipo de sucesso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Hum... Eu nunca pensei em ter uma vida de sucesso. Muito pelo contrário, desde que eu consiga deixar uma impressão, ficaria feliz mesmo que minha vida seja um fracasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Pelo menos, alguém diria \"Zhiqiong uma vez desafiou o Despenhadeiro\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "Na pior das hipóteses, eu não seria esquecida, ao contrário de mim e dos aventureiros que morreram em terras despovoadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "Eu nunca pensei em uma pergunta dessas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "Sério? Talvez você se torne o foco de todos naturalmente, não importa onde você esteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
					"content": "Acho que é como as crianças que nascem em berço de ouro. Eles acham a ideia da pobreza interessante e emocionante, porém uma aventura desnecessária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360421,
					"content": "Ah, desculpe, isso não era o que eu queria dizer. Eu apenas estava.... Ei... esqueça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Urgh, é Zhiqiong de novo... Ela saiu para recolher os sinalizadores e não voltou desde então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Dei a ela três horas extras, sabendo deste hábito imbecil dela de sair andando por toda parte... Mas já fazem pelo menos cinco ou seis horas desde então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "Você poderia me ajudar a procurá-la? Ela realmente te respeita bastante, então deve ser mais fácil... e eu não quero ninguém tendo problemas novamente enquanto estou de vigia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
					"content": "Urg, queria entender o problema dela. Saindo por aí dessa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380205,
						710380206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380205,
					"content": "Tudo bem, irei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380207
					]
				},
				{
					"id": 710380207,
					"content": "Ah, sim! Perdão, quase esqueci de te dizer a coisa mais importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380208,
					"content": "Ela provavelmente não foi muito longe, mas ainda assim, onde ela poderia ter ido...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380209,
					"content": "Muito bem, não se preocupe, Jinwu! Primeiro iremos ao local onde colocamos os sinalizadores ontem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380210,
