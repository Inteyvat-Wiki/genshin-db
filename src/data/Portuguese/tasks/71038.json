			"dialogs": [
				{
					"id": 710380601,
					"content": "Khedive deu alguns remédios a ela... e ela conseguiu recuperar a consciência, mas não quer me dizer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380602
