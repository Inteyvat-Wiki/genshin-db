					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380602,
					"content": "Você sabe o que aconteceu? Como ela ficou daquele... jeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380603
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380603,
					"content": "Ela estava presa na lama preta quando a encontramos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710380604
					]
				},
				{
					"id": 710380604,
					"content": "Isso mesmo, e conseguimos tirá-la bem a tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710380605,
					"content": "...",
