					"nextDialogs": [
						710380606
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380606,
					"content": "Esqueça isso por enquanto. O que a Zhiqiong precisa agora é descansar. Você poderia me ajudar a entregar essa tigela de sopa para ela, enquanto ainda está quente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380607
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380607,
					"content": "Não sou exatamente uma boa cozinheira, mas já tive que cuidar de muitos mineradores, e nenhum deles reclamou da minha comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380608
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380608,
					"content": "Muito bem, vá. Veja se ela está um pouco melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380609
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380609,
					"content": "Tenho que dizer ao Muning que a Zhiqiong não pode ficar mais nas minas.",
					"roleType": "TALK_ROLE_NPC",
