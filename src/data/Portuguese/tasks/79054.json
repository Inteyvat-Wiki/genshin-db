			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jeroney"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Ei, o que vocês estão fazendo aqui? Não há trilhos aqui e é muito alto. Estamos em um local na margem da Miragem Veluriyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "Dificilmente alguém vem aqui, até mesmo Idyia... Eu suspeito que ela sequer sabe que esse lugar existe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Não tem nada aqui. O que você estava fazendo, Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Eu só queria espairecer um pouco... Nem me venham com \"Não brigue com Ferdinand de novo ou você vai sair de casa!\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "Não, nós não brigamos. Eu só queria sair andando por aí... Argh, como posso dizer... Eu gosto disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Eu não disse antes? Eu que pensei no Carrinho Piuí primeiro. Minha ideia era de transportar qualquer coisa facilmente para um lugar alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Foi assim que eu... Foi assim que Jeroney pensou no carrinho e nos trilhos. Porque gosto dos céus e de lugares altos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Eu pareço um idiota, mas lembro de ter ouvido um provérbio em Inazuma, era algo como somente alguém sem juízo que gosta de fogos de artifício e correr, ou algo do tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "Poder andar nesse carrinho é maravilhoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Mas eu só posso construir algo como ele na Miragem Veluriyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "... Enfim, não importa, vamos deixar isso para lá. Também há outra razão para eu ter vindo aqui — admirar as estrelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Apesar das estrelas da Miragem Veluriyam serem uma sombra das estrelas do lado de fora da garrafa, elas são lindas para mim do mesmo jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Todas as noites, tudo que preciso é ver esse céu estrelado para que meu coração se sinta em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Jeroney gosta de ver as estrelas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Não importa quem seja, todos que olham para essas estrelas gostam. Mas que pena, e se elas pudessem ser vistas durante o dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Claro, se eu não tivesse que subir aqui todo dia para vê-las seria ainda melhor, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "Ah, Paimon pensou numa maneira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Hã, no que você pensou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Fotografar já basta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "Fotografar? Então uma tecnologia avançada como essa existe hoje em dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Que tal a gente tirar uma foto do céu e dar para Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "Vocês fariam isso por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Claro que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Mas, onde é que a gente pode tirar uma foto bonita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "Ah, aqui! Posso ver as lindas estrelas dessa plataforma durante a noite. É por isso que venho aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Oh, que legal! Fique aqui esperando a gente voltar com a foto, Jeroney!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Ele é muito divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
