			"dialogs": [
				{
					"id": 240190301,
					"content": "O que eu disse, hein? Verdadeiros cavalheiros — modos muito melhores do que aqueles grosseiros perto do Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Elas tinham bons modos mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Não é mesmo? Me deixa relaxado só sentar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Digo, só se imagine sendo uma gaivota. Com as pessoas vindo te alimentar, e tudo que você tem que fazer é tomar banho de sol e pensar sobre o significado da vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "*Suspiro* Por que sou um Fiscal e não uma Gaivota Pescadora Violeta Dourado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
