			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Bem, isso é tudo que tenho. Espero que estejam todas cheias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "O que você pretende?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Estou alimentando estas gaivotas. Viu, elas estão quase cheias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Nossa... Quando foi que vocês se aproximaram tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Elas não roubaram suas batatinhas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Não. Parece que as pessoas vêm aqui especificamente para alimentar as gaivotas, então elas não têm interesse nas minhas batatinhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Mas você não disse que se fosse para muito longe do escritório, poderia perder o trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Hahaha, está tudo bem. Hoje é minha folga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Nenhum colega aqui para me arrastar para conversas de trabalho e ninguém ou nenhum animal para roubar minhas batatas fritas... Sim, este é um lugar realmente adequado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "As gaivotas aqui são muito amigáveis. Elas não roubarão minhas batatinhas, nem vão investir contra mim para causar um tumulto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Desde que eu as alimentei pessoalmente algumas vezes, elas parecem me reconhecer. Elas não parecem resistir nem quando toco nas penas delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "Eu até diria que são perfeitos cavalheiros comparados à gente no Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Se elas pudessem usar suas garras para escrever usando máquinas de escrever, elas praticamente nos deixariam sem emprego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Gaivotas não vão ajudar com assuntos humanos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Mas pelo menos elas também não pioram as coisas. E todos sabem que algumas coisas são simplesmente difíceis demais para elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Mas vamos deixar isso de lado primeiro. Gostaria de tentar fazer amizade com essas gaivotas gentis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Ufa, elas já são aves gentis aos seus olhos, né...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Seria rude de mim só ir até elas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Não, elas são bem tolerantes. Contanto que você não bagunce as penas delas, vai dar certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Venham, deixe-me te dar esse peixe que eu processei especialmente. Só leve e coloque na tigela ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Só relaxe. As gaivotas são bem tolerantes. Elas gostam de quem as alimentar e não fazem perguntas sobre onde você pegou o peixe ou como ele foi feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Tem algo que eu preciso prestar atenção para fazer amizade com elas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Não muito, na verdade. Só não tente bagunçar as penas delas diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Gaivotas não falam a nossa língua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Eu não teria tanta certeza. Talvez elas simplesmente finjam para poderem viver vidas mais confortáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
