				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "Como... Como você poderia fazer isso? Eles não são aqueles rufiões em frente ao Palais Mermonia, tá sabendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Desculpe, foi um acidente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "*Suspiro* Eu nem tive tempo de te parar. Por que você fez aquilo... Uma delas te atacou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "De qualquer forma, elas se foram agora. Oh, céus. Eu terei que voltar em alguns dias para oferecer um pouco de comida como pedido de desculpas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
