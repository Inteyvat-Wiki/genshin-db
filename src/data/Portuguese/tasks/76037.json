					"nextDialogs": [
						760370602
					]
				},
				{
					"id": 760370602,
					"content": "\"Alvo: Hark, o Mandíbula Quebrada, timoneiro anterior do Atra. Procurado por: Múltiplos assassinatos. Completamente perverso. Paradeiro desconhecido.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370603
					],
					"speakerTitle": "Recompensa de Caça"
				},
				{
					"id": 760370603,
					"content": "\"Qualquer um que puder fornecer informações sobre seu paradeiro será recompensado imensamente se a informação for verificada.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Recompensa de Caça"
