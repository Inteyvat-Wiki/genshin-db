			"dialogs": [
				{
					"id": 760370501,
					"content": "(Sobre o contrabandista...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "\"Alvo: Nova Gangue do Sal de Ferro. Procurada por: Suspeita de contrabando em grande escala e tráfico de mercadorias perigosas e restritas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Recompensa de Caça"
				},
				{
					"id": 760370503,
					"content": "\"Investigações indicam que a gangue mantém um posto avançado temporário no <color=#00E1FFFF>acampamento na praia ao norte da cidade</color>. Aqueles que auxiliarem no desmantelo das operações de contrabando serão recompensados generosamente pela Spina di Rosula.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Recompensa de Caça"
				}
			]
		},
