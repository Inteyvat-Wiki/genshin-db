			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(Sobre Hidimbi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "\"Alvo: Hidimbi, uma adivinha de Sumeru. Mulher, idade desconhecida. Procurada por: Suspeita de amaldiçoamento e fraude de alto valor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Recompensa de Caça"
				},
				{
					"id": 760370303,
					"content": "\"Aquela mulher me deu um golpe de 18 milhões de Mora! Disse que eu seu usasse um colar que ela alegou ter implorado para o Deus do Amor, Al-Ahmar, as gatinhas iam se apaixonar por mim de primeira!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Recompensa de Caça"
				},
				{
					"id": 760370304,
					"content": "\"Na verdade, Al-Ahmar não era deus do amor coisa nenhuma. Ele tá morto há milhares de anos e nem conseguiu o amor da garota que ele gostava.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Recompensa de Caça"
				},
				{
					"id": 760370305,
					"content": "\"Mas o colar que ela me vendeu era de verdade, só que era muito amaldiçoado para me impedir de encontrar o amor. Qualquer um que a encontrar e remover a maldição será recompensado imensamente.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Recompensa de Caça"
				}
			]
		},
		{
			"id": 7603704,
