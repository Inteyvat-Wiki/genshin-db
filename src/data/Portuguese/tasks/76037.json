			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "Detalhes sobre os quatro alvos estão no quadro. Posso te deixar a par se precisar, mas nem tente negociar o pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Você apresenta prova dos alvos que lidou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "Sobre os alvos da recompensa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Há quatro alvos no momento, mas apenas três pistas. Uma delas é a Adivinha de Sumeru, Hidimbi, procurada por fraude. Ela é geralmente vista perto das <color=#00E1FFFF>docas do sul</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "O furioso de Inazuma, Kairagi, que tomou a vida de vários comerciantes atravessando o <color=#00E1FFFF>Corredor Vazio</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Um membro de uma gangue de contrabando vendendo produtos perigosos, com relatórios de esconderijo num <color=#00E1FFFF>acampamento na praia ao norte da cidade</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "O pirata perverso conhecido como Hark da Mandíbula Quebrada. Nenhuma pista no momento. Ele está provavelmente se escondendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Até depois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Tchau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
