			"dialogs": [
				{
					"id": 760370401,
					"content": "(Sobre o Kairagi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "\"Alvo: Gonpachi, um homem de Inazuma vestido em vestes do estilo Kairagi. Procurado por: Ataques aleatórios a comerciantes viajando. Múltiplas vítimas reportadas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "Recompensa de Caça"
				},
				{
					"id": 760370403,
					"content": "\"O alvo foi visto pela última vez perto do Corredor Vazio. Quem o derrotar e fornecer prova da morte dele será recompensado imensamente pela Guilda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Recompensa de Caça"
				}
			]
		},
