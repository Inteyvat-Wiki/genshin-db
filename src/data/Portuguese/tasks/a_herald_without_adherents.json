				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "Aqueles Feiticeiros do Abismo... Estavam tentando nos emboscar e nos atacar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010202,
					"content": "Não! Eles apenas estavam procurando algo nos restos do Guarda das Ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010203,
					"content": "#Ah é?... Parece que {M#o}{F#a} Viajante sempre faz o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010204,
					"content": "\"Dispositivo do Caos\", e \"Circuito do Caos\" e tal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010205,
					"content": "Sim, sim! São materiais importantes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "Eles não devem estar procurando algo tão comum assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010208,
					"content": "A razão pela qual estou investigando aqui perto é que alguns Feiticeiros do Abismo saem da ruína de vez em quando para fazer investigações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010209,
					"content": "Ao que parece, eles queriam procurar um certo objeto precioso nos restos dos Guardas das Ruínas e levá-lo de volta para as ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010210,
					"content": "Porém, eles pareciam estar um pouco decepcionados... Aposto que eles ainda não tinham encontrado o que eles precisavam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010211,
					"content": "Ok, então, por que a gente não pega um deles e faz um bom interrogatório?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010212,
					"content": "Eu me lembro que o Diluc já fez isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "Claro, eles não merecem nem um pouco de piedade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010215,
					"content": "Só que... O meu sexto sentido me diz que o plano com esse objeto pode ser muito significativo para a Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010216,
					"content": "Por isso, um interrogatório rígido não ia nos levar a lugar algum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010217,
					"content": "Ou melhor, esses Feiticeiros do Abismo provavelmente temem algo muito mais do que um interrogatório doloroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010218,
					"content": "Algo que temem mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "A Paimon está sentindo um frio na espinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010221,
					"content": "Bom! Não temos tempo a perder! Vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010219,
					"content": "Será que tem a ver com o que aconteceu nas ruínas?...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "Você tem que ser mais bruto com eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "Talvez não sejam essas coisas que os Feiticeiros do Abismo estavam procurando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "Hum... Além da Ordem do Abismo, os Guardas das Ruínas também estão bastante ativos por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010302,
					"content": "Parece que onde quer que encontremos um esconderijo dos Feiticeiros do Abismo, muitas vezes há um bando de Guardas das Ruínas circulando também. Isso é apenas coincidência, ou...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010303,
					"content": "Coincidência? Não há coincidência neste mundo! Tudo é apenas um fruto das sementes plantadas há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010304,
					"content": "É como o seu aparecimento naquela Taverna... O tempo estava apenas esperando que a semente brotasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010305,
					"content": "Mas eu só ouvi falar de você por acaso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "Esqueça. São apenas as minhas reflexões desnecessárias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010308,
					"content": "Mas enfim, a relação entre a Ordem do Abismo e os Guardas das Ruínas não é uma mera coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010309,
					"content": "Ou seja, são os ramos do mesmo tronco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010310,
					"content": "Ramos? Tronco? O que você quer dizer com isto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010311,
					"content": "Eles são provenientes de Khaenri'ah, um país antigo que foi destruído quinhentos anos atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010312,
					"content": "Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010313,
					"content": "Sério? Então a Ordem do Abismo e os Guardas das Ruínas são sobreviventes da destruição de Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010314,
					"content": "Por falar em Khaenri'ah, é um nome super antigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010315,
					"content": "Ah, certo. Como sua guia, Paimon deveria explicar um pouco aqui. Há muito tempo atrás, a nação de Khaenri'ah era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010316,
					"content": "Eu conheço Khaenri'ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010318,
					"content": "Porque eu tenho memórias de Khaenri'ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "Você tem lembranças de estar lá? Mas essa nação foi destruída há 500 anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010320,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010321,
					"content": "Cada um com seus segredos! Você não se meteu nos meus, por isso não me meterei nos seus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010322,
					"content": "Mas se quiser compartilhar, eu sou um bom ouvinte. Então, como é que era Khaenri'ah nas suas memórias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010323,
					"content": "(Bem, não posso mais continuar escondendo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "Então foi assim que tudo aconteceu... A Paimon achou que você já tinha encontrado a Deusa Desconhecida no início...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010327,
					"content": "#Depois de descer a esse mundo, sua primeira memória é de {F#seu irmão}{M#sua irmã} lhe despertando nesse meteorito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010328,
					"content": "#Parece que {F#o seu irmão}{M#a sua irmã} acordou mais cedo que você, mas o quão cedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010329,
					"content": "#Depois, {F#o seu irmão}{M#a sua irmã} te contou que a destruição de Khaenri'ah tinha deixado todo o mundo em colapso, e vocês dois precisariam deixar esse mundo chamado Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010330,
					"content": "#\"A destruição de Khaenri'ah\"? O que {F#ele}{M#ela} disse foi isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010331,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "A devastação que você presenciou ocorreu 500 anos atrás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010334,
					"content": "Parece que a primeira vez que você acordou neste mundo foi de fato durante esse período.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010335,
					"content": "#Se for o caso, {F#o seu irmão}{M#a sua irmã}, que tinha acordado antes de você, devia ter um conhecimento melhor que você sobre esse mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010336,
					"content": "E em seguida, vocês dois foram parados por essa Deusa desconhecida, e não tinham como fugir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010337,
					"content": "Hum... A Paimon já conhece muito bem essa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010338,
					"content": "... Eu entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010339,
					"content": "Logo depois, você acordou, e queria sair urgentemente desse mundo, mas não sabia nada sobre Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010340,
					"content": "Com o acúmulo dos conhecimentos sobre Teyvat, você está achando que a luta decisiva naquela época de fato era a luta que deu fim a Khaenri'ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010341,
					"content": "Hum! A Paimon recorda que você tem feito muitas investigações nos livros antigos durante a nossa jornada nesses últimos meses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010342,
					"content": "Antes de ir a Mondstadt, você apenas tinha lido alguns materiais quaisquer. E depois, começamos a coletar livros antigos em toda a parte de Mondstadt e Liyue, mas você disse para a Paimon que eles \"não serviam para nada\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010343,
					"content": "#Afinal de contas, você quer saber mais sobre Khaenri'ah para encontrar {F#o seu irmão}{M#a sua irmã}, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010344,
					"content": "É a segunda pista mais importante depois dos \"Sete Arcontes\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "Certo! Para encontrar os Sete Arcontes, basta vagar pelas Sete Nações. Mas o caso de Khaenri'ah, que já foi destruída há 500 anos, seria mais complicado já que não há aonde ir para encontrá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010347,
					"content": "Sobre o Khaenri'ah, estou convencido que sei um pouco melhor do que vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010348,
					"content": "Khaenri'ah era um país sem Arcontes. Não me refiro que os Arcontes tinham morrido ou foram embora, mas nunca existiu um na história de Khaenri'ah desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010349,
					"content": "Era um país forte estabelecido por seres humanos, e os seres humanos estavam orgulhosos pela sua civilização moderna e a sua prosperidade sem precedentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010350,
					"content": "Um país... Sem Arcontes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010351,
					"content": "E depois, como as suas memórias dizem, tudo aquilo foi destruído pelos Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010352,
					"content": "O que você quer dizer com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010353,
					"content": "Quinhentos anos atrás, os Arcontes desceram juntos e deram o fim a Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010354,
					"content": "O assim chamado \"orgulho dos seres humanos\" foi esmagado, como os galhos do jardim dos Arcontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010355,
					"content": "Minha nossa! Os livros de história não mencionam nem uma palavra sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010356,
					"content": "Que horrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "Sim. Bem, continuar a discutir o passado agora só vai destruir nossos ânimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010359,
					"content": "(Mas... Na próxima vez que encontrar o Venti e o Zhongli...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "Vamos seguir em frente. Vou te contar tudo o que quiser saber no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010360,
					"content": "(Espero que eles possam esclarecer tudo isto.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#Que mundo perigoso... Gostaria tanto de encontrar {M#a minha irmã}{F#o meu irmão} o mais rápido possível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "Mesmo sendo apenas uma pista do nome de um lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "Foi o que eu escutei naquele momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Dain e Khaenri'ah... Vale a pena tentar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "(Quem me acordou...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "(Além disso, assim que acordei, vi um mar de fogo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "#Estou um pouco confus{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
