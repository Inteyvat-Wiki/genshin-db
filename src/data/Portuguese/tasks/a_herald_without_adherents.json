			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "Então nos encontramos de novo... Um pouco mais cedo do que eu esperava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010102,
					"content": "Ei, é o Dain!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010103,
					"content": "Que cara é essa? Vocês encontraram algo estranho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010104,
					"content": "Vocês se depararam com o Apóstolo do Abismo na ruína?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010105,
					"content": "Ei? Como você sabia disso, Dain?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010106,
					"content": "Ainda estou caçando o Apóstolo do Abismo, mas não esperava ter me encontrado com vocês por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010107,
					"content": "Na verdade, encontramos muito mais do que apenas o Apóstolo do Abismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "Uma estátua pendurada de cabeça para baixo... Carregando a energia do Abismo na mão? Não, eu nunca vi uma coisa tão estranha na minha luta contra o Abismo! Porém, eu tenho algumas suspeitas também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010110,
					"content": "Mas primeiro terminem o que estavam dizendo sobre a sua experiência. O que houve após ter fugido do fundo da ruína repleta da energia do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010111,
					"content": "#E quando estávamos chegando à saída da ruína, fomos parad{M#os}{F#as} pelo Apóstolo do Abismo que apareceu do nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010112,
					"content": "Nós tivemos uma boa luta... Talvez ele ainda não tenha fugido para longe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010113,
					"content": "É uma oportunidade de ouro então! Venham comigo para capturar ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010114,
					"content": "Sem problemas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "Vamos! Vamos aproveitar essa oportunidade! Com a ajuda do Dain, talvez possamos sair com muitos enigmas desvendados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010115,
					"content": "Espere, eu me lembro que fui eu quem lhe contratou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "Tinha algo ainda mais estranho que o Apóstolo do Abismo naquela ruína.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
