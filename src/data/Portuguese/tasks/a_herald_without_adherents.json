			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "Olha! É o Guarda das Ruínas e os Feiticeiros do Abismo de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010502,
					"content": "O Dain acabou de dizer que essas máquinas antigas também vêm de Khaenri'ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010503,
					"content": "Será que também haviam muitas ruínas em Khaenri'ah que precisavam de proteção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010504,
					"content": "Não. O nome \"Guarda das Ruínas\" foi dado por pessoas de hoje de acordo com suas impressões sobre eles. Ninguém de 500 anos atrás chamavam eles desse nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010505,
					"content": "Os \"Guardas das Ruínas\" eram conhecidos como \"Cultivadores da Terra\" na época.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010506,
					"content": "Cultivador da Terra? Que nome estranho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010507,
					"content": "Afinal era uma ferramenta agrícola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "Não é o que vocês estão pensando! O assim chamado \"Cultivador da Terra\" era apenas um codinome. Na época, o povo de Khaenri'ah costumava dar um codinome às armas produzidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010510,
					"content": "Baseado no entendimento de que \"a terra não serve para cultivar, mas sim, lutar com ferro e sangue\", veio a origem do nome \"Cultivador da Terra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010511,
					"content": "\"Lutar com ferro e sangue\"? O povo de Khaenri'ah interpretava \"cultivador\" de uma forma... Meio... Negativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010513,
					"content": "Após a destruição de Khaenri'ah, os Cultivadores da Terra sem donos perderam o controle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010514,
					"content": "Ao longo da história, eles acabaram vagando e hibernando em toda a parte de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010515,
					"content": "Talvez seja porque eles compartilham a mesma tortura de perder as suas civilizações, eles acabaram ficando em várias ruínas e hibernando nelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010516,
					"content": "Isso soa... Tão triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010517,
					"content": "Vagando sem rumo por 500 anos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "Uma vez que você entender mais, esses detalhes não significarão muito para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010521,
					"content": "Mas não importa seu passado, tudo o que resta deles agora é o perigo que eles representam. Vá, destrua todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010518,
					"content": "Então parece que... Seria bom dar um fim ao seu sofrimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "Sim... Paimon acha que você tem feito um bom trabalho com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010508,
					"content": "Mas enfim, o que são aquelas armas letais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
