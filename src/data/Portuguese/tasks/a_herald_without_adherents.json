			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "Será que esse talismã do Feiticeiro do Abismo serve como... Uma carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010402,
					"content": "Hmm, este talismã parece estar ligado ao Apóstolo do Abismo. Mas por que um Feiticeiro do Abismo estaria carregando isto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010403,
					"content": "Talvez realmente contenha informações sobre sua operação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010404,
					"content": "Mas... A gente não sabe ler a escrita de Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010405,
					"content": "#\"... Envolva a fé do inimigo em chamas e traga glória a Sua Alteza, {F#o Príncipe}{M#a Princesa}...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010406,
					"content": "Ah? Isso é o que está escrito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010407,
					"content": "\"...\"Tear do Destino\" - Operação Inicial\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010408,
					"content": "O Abismo está efetuando um plano, cuja palavra-chave era \"Tear do Destino\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010409,
					"content": "Ao que parece, ainda está na fase inicial, ou seja, na fase experimental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010410,
					"content": "\"Tear do Destino\"? O que isso se refere? Levando ao pé da letra, é literalmente uma máquina de tecer destinos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010411,
					"content": "Os Feiticeiros do Abismo vieram daquelas ruínas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "Pelo sentimento horrível que Paimon está tendo, essas ruínas misteriosas são muito prováveis de estarem relacionadas a esta operação de tecer o destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010414,
					"content": "Bom, Dain! O que diz exatamente essa carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010415,
					"content": "Ainda estou lendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010416,
					"content": "Hum... Um plano ambicioso... Mas algumas partes são difíceis de entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010417,
					"content": "Como assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010418,
					"content": "Resumindo, essa fase inicial tem a ver com o Osial, Deus do Vórtice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010419,
					"content": "O Deus do Vórtice! É aquele arconte no mar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010420,
					"content": "Da última vez, não conseguimos derrotá-lo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "Mas... O que eles querem com o Osial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010423,
					"content": "Será que vão fazer a mesma coisa que nem com o Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "Eu conheço sobre seus atos heroicos com relação ao Dvalin, e também sei do papel da Ordem do Abismo no incidente do Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010425,
					"content": "Embora você possa não ter tido conhecimento disso na época, você estava impedindo uma operação da Ordem do Abismo semelhante a esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010426,
					"content": "Da última vez, foi um velho amigo dos Arcontes, e agora é um grande deus antigo? A Ordem do Abismo está ficando cada vez mais ambiciosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010427,
					"content": "A Ordem do Abismo irá corromper o Osial com mentiras e magia negra, tal como ao Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010428,
					"content": "Não! Pelo visto, o plano desta vez é muito melhor desenvolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010429,
					"content": "Eles não irão apenas corromper a mente de Osial, mas também planejam usar a antiga tecnologia por trás do \"Cultivador da Terra\" para transformar o corpo de Osial completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010430,
					"content": "Isso é... Possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010431,
					"content": "Então espera, a Ordem do Abismo quer fazer algum tipo de... Lula Cibernética Deus da Destruição em Massa!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010432,
					"content": "Parece que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "Hoje em dia, muito poucas pessoas conhecem a civilização de Khaenri'ah, e claro, é difícil estimá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010435,
					"content": "Apenas a Ordem do Abismo buscou incessantemente os vestígios de Khaenri'ah. Apesar de não serem humanos, ela busca essa civilização humana perdida constantemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010436,
					"content": "Essa carta diz que eles queriam criar um Arconte Mecanizado, usando a Estátua Profanada como a base e juntando os membros do Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010437,
					"content": "E o novo núcleo para substituir o orbe na mão da Estátua é... O olho do primeiro Cultivador da Terra do mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010438,
					"content": "O olho do primeiro Cultivador da Terra? Oh! Entendi! Então talvez seja isto que os Feiticeiros do Abismo estavam procurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010439,
					"content": "Faz sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010440,
					"content": "Eles ainda não conseguiram encontrá-lo, então, ainda temos tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "Está sendo cada vez mais complicado! Mas afinal de contas, está altamente relacionado àquela Estátua dos Sete peculiar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010443,
					"content": "Sim! De acordo com a carta, o olho deve ser colocado na mão da Estátua Profanada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010444,
					"content": "Assim, imbuindo o deus recém-nascido com o poder de \"derrubar os tronos divinos de Celestia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010445,
					"content": "(Celestia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "Então esse plano está contra algo realmente forte... Fora da nossa imaginação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010448,
					"content": "Hmmm. Agora que ninguém de nós sabe onde está o primeiro Cultivador da Terra, convém começar a nossa investigação pela Estátua, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010449,
					"content": "Aquela Estátua parece ser a Estátua do Arconte Anemo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "Não é fácil encontrar aquele Bardo Desafinado, que vaga por todo o mundo. Então é melhor perguntar diretamente na <color=#00E1FFFF>Catedral de Favonius</color>! Talvez a gente possa encontrar algo útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010452,
					"content": "Catedral... Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010453,
					"content": "O que foi, Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010454,
					"content": "Nada. Vamos então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010450,
					"content": "Devemos perguntar à Catedral de Favonius sobre isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "(Derrubar os tronos divinos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "Teremos que encontrá-lo antes dos Feiticeiros do Abismo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "Esses apelidos estão ficando cada vez maiores!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "E apenas foi detido pela Câmara de Jade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "Será que tem a ver com a Estátua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
