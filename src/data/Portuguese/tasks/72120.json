			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Muito bem! Maravilha! Os testes anteriores correram muito bem. Os Onikabutos foram completamente purificados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "E agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Tudo que precisamos fazer agora é confirmar nossa rota de entrada para começarmos o nosso trabalho. Entretanto, devemos evitar esses Fatui... Parece que teremos que fazer o caminho mais longo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Afinal de contas, ele é bastante grande, então seria melhor garantirmos que haja caminhos suaves para nós à medida que o movemos para dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "Como tal, gostaria que você voltasse à Fornalha Mikage para investigar mais um pouco. Se você encontrar alguma estrada quebrada, por favor, a restaure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Ainda tenho que decidir nossa rota, mas ter mais de uma também não faz mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "Mas eu não sei restaurar estradas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Você não precisa restaurá-las de maneira... perfeita. Basta colocar uma camada de tábuas de madeira acima da estrada para que possamos mover este dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Ah, você pode pegar algumas tábuas de madeira aqui perto. Vou ficar aqui e tentar fazer a nossa máquina mais confiável quanto possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
