			"dialogs": [
				{
					"id": 401290901,
					"content": "Então essas são as ruínas submarinas que Freminet encontrou? São incríveis, mas ainda não são do tipo que Paimon tava imaginando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "Esse é o Reino das Sereias, Paimon, não um monte de ruínas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Oh, sim, Paimon sabe, é só que... Paimon pensou que a gente ia ver um mundo de conto de fadas, com as casas coloridas das sereias, e uma ponte arco-íris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Eu sinto muito... eu estava com esperanças de colocar algumas decorações, mas fiquei sem tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290905,
					"content": "Está tudo bem, é hora da fantasia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "Uau! É como se você já tivesse entrado no modo fantasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#Parece que {NICKNAME} já tá por dentro. Você devia fazer seu melhor também, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290908,
					"content": "Hnf, não subestime a Paimon! Paimon também consegue mudar radicalmente. Agora, entrando... Modo Paimon da Fantasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "Ahem... jovens aventureiros! Essa é Paimon, a deusa guardiã desta região. Digam seus objetivos e intenções de visitar esta nação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Uhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290911,
					"content": "Somos os companheiros do Príncipe Thelxie, cara mestra deusa. Viemos ajudá-lo a recuperar a glória que ele perdeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290912,
					"content": "Ooh! Recuperar sua glória! A deusa aqui tem glória dourada, glória prateada e glória de bronze. Qual foi a que o príncipe perdeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290914,
					"content": "Uhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290915,
					"content": "Você saiu do personagem, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Não, nem um pouco! Esse foi o teste da deusa! Pela sua resposta, a deusa concluiu que vocês são corajosos aventureiros que não estão manchados pela ganância! Por isso, merecem o respeito de todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Por favor, aceitem as recompensas da deusa. A deusa agora vai conceder três tipos de glórias a vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "E quanto ao Príncipe... a deusa também vai conceder a ele a glória do arco-íris, assim seu futuro será sempre cheio de luz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Muito obrigada, cara mestra deusa. O poder agora está fluindo por todas as partes de meu corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290921,
					"content": "Eu também... essa é a inspiração divina da lenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290922,
					"content": "Tudo graças ao poder da deusa Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Hehe, agora, aventureiros, sigam em frente e derrotem os monstros que invadiram seu reino! Vocês com certeza encontrarão o que buscam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
