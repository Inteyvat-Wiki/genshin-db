			"dialogs": [
				{
					"id": 401290601,
					"content": "Ufa, finalmente acabou! Então, derrotamos os monstros malignos e recuperamos o Reino das Sereias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Sim, agora deve ser a hora de irmos até a cerimônia de coroação do Thelxie... O único problema é que, eu não esperava que tudo fosse correr tão bem. Eu achei que teria demorado mais tempo para chegarmos até o coração das ruínas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290603,
					"content": "Foi tudo erro meu. Eu deveria ter dito ao Freminet mais cedo que ele também precisaria de uma coroa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290604,
					"content": "#É tudo por causa da força de {NICKNAME} e da deusa Paimon! Erradicamos todos os monstros de uma vez só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "Está tudo bem, Zuria. Podemos voltar quando terminarmos a coroa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290606,
					"content": "Então eu agradeço vocês mais uma vez por tomarem seu tempo. E você também, Thelxie, minha criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "Thelxie está se mostrando bom de briga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Ele é como um príncipe de verdade... não acho que há nada que possa pará-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290610,
					"content": "Sim, Freminet! Eu também acredito nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290611,
					"content": "#Vamos voltar para o acampamento. Pedi {M#ao}{F#a} {NICKNAME} para procurar por alguns materiais no caminho porque eu queria fazer a coroa o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290612,
					"content": "Podemos adicionar uma atualização nas Aventuras Fantásticas de Thelxie! Agora que reconquistamos o Reino das Sereias, é hora de voltar a desenhar alguns novos cenários no livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
