				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "Hã? Por que Paimon tem a impressão de que apareceu um aquário extra aqui de repente? O que tá escrito nessa placa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "\"Perigo - Mantenha Distância!\" O que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Significa exatamente o que diz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010104,
					"content": "Uaaah! Sandrone... Você fez Paimon pular! Você colocou essa placa aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Sim. Com a pretensão de manter qualquer curioso bem distante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010106,
					"content": "O que esse aquário tem de tão especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Está cheia de piranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010108,
					"content": "Como é?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Haha, brincadeira. Não me diga que você acreditou mesmo nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010110,
					"content": "Descobri que alguns peixes do aquário são muito territoriais e podem ficar bem agressivos. Então, eu os trouxe pra cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010111,
					"content": "Não assusta Paimon desse jeito! Então esse lugar é tipo uma zona de quarentena especial para peixinhos agressivos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Exatamente, a água desse aquário é muito mais profunda e há bem mais espaço. Isso ajuda a acalmar os peixes mais territoriais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010113,
					"content": "Também pedi a Enfermeira Sigewinne na Fortaleza de Meropide uma isca especial para ajudar a acalmá-los um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010114,
					"content": "Ah, uau... Então você realmente se preocupa com o bem-estar dos peixinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Não acho que alguém queira ver o aquário virar um banho de sangue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010116,
					"content": "Com certeza! Por que você não deixa isso com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Se insistem. Quando os peixes do lago se sentirem confortáveis o suficiente para nadar até a superfície, significa que estão se recuperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010118,
					"content": "Então, quando estiverem todos relaxados e felizes, podemos colocá-los de volta no aquário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Onde vocês os colocam é com vocês. Eu só sou responsável por pescar os encrenqueiros e trazê-los para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747010120,
					"content": "Entendido! Mas essa placa é assustadora demais. Será que não podemos trocar por algo um pouco menos... aterrorizante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Hmm... Se vocês quiserem. São seus peixes, então deixo a decisão com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}