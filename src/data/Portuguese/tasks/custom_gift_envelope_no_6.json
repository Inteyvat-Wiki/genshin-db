			"dialogs": [
				{
					"id": 715380101,
					"content": "#Olá, {NICKNAME}. Feliz Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Você está aqui... por um caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Estou sendo forçada a tirar férias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Forçada... a tirar férias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "O Maison Gardiennage estipula que todos os empregados devem usar o período de férias até o final do ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Os cálculos de fim de ano chegaram e a Patrulha descobriu que eu não tinha tirado nenhum dia de folga, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Pra que isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Não. Nossos membros operam numa escala rotativa, mas como capitã do esquadrão, estou sempre de serviço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Eu também lido com muitos casos de emergência, então com o tempo eu só... esqueci de tirar folga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Eu estava bem sem tirar nenhuma folga esse ano, mas o pessoal da minha equipe não quis saber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Eles começaram a gritar sobre como as \"regras devem ser seguidas\" e \"uma capitã precisa dar um exemplo na liderança\". Basicamente, eles não aceitaram um não como resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Um dos Gestionnaires que trabalha conosco mencionou como Liyue está no topo dos destinos de férias durante o festival do Ritual de Lanternas. Ele tirou uma passagem de navio lá na hora, ao vivo, e aí... aqui estou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Tenho que admitir — Liyue é uma maravilha de se admirar nessa época do ano. Eu acabei de voltar da Vila Qiaoying, na verdade. Eu adorei o dim sum com chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "Comprei alguns para compartilhar com a Patrulha Especial. Eu estava planejando seguir costumes locais e fazer uns envelopes de presente também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Eu só... Não sou muito boa com esse tipo de coisa. Não importa o que eu faça, sempre acaba esquisito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#Você sabe como fazê-los, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Tenho algumas sugestões...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "É assim pra todo mundo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Você... não parece tá aqui a trabalho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
