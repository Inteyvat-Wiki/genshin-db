			"dialogs": [
				{
					"id": 715380301,
					"content": "Uau, ficou ótimo! Hmm... Você merece alguma coisa por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Aqui, fica com esse dim sum como agradecimento pela sua ajuda. Receber esse envelope de você faz a viagem valer realmente a pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "...Mesmo assim, estou fora há algum tempo. Queria saber se o pessoal da minha equipe continuou com os treinos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Bem, acho que chegou a hora de elaborar um teste físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
