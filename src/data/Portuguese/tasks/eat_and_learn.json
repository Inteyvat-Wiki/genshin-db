				{
					"id": 230100301,
					"content": "É um ótimo raminho de Menta. Aguarde um instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100303
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100302,
					"content": "Jafar pegou os outros ingredientes e começou a cozinhar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100303,
					"content": "Esta \"Sopa de Feijão com Menta\" foi feita com o ingrediente que você me trouxe, experimente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100304
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100304,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100305
					]
				},
				{
					"id": 230100305,
					"content": "De nada, apenas aproveite esta refeição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100306
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100306,
					"content": "Para mim, quando estou saboreando uma boa refeição, deixo para trás todos aqueles assuntos cansativos e pesquisas complicadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100307
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100307,
					"content": "Deixo minha mente fluir pacificamente por aquela corrente serena de que falei... É assim que relaxo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100308
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100308,
					"content": "Bem, aproveite sua refeição ao máximo. Espero que isso também possa colocar sua mente em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
