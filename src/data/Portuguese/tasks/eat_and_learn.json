				"objectNames": [
					"Jafar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "#{M#Amigo}{F#Amiga}, você parece com pressa, com o que está preocupad{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100102,
					"content": "Muitas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "#Então... Notei que você parecia cansad{M#o}{F#a} e bem apressad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100104,
					"content": "Você deve ter algo em sua mente que precisa ser resolvido o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100109,
					"content": "#Se você estiver dispost{M#o}{F#a}, gostaria que você se juntasse a mim para degustar um prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100110,
					"content": "Essa pressa é de fato uma parte normal da vida, sim... Mas como costumamos dizer, mesmo um rio furioso às vezes deve fluir pacificamente por um riacho sereno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100111,
					"content": "Você deve fazer uma pequena pausa de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100112,
					"content": "Pensarei nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100113,
					"content": "Que tal degustarmos uma \"Sopa de Feijão com Menta\" juntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100114,
					"content": "Você não tem que me pagar nenhuma Mora. Apenas me ajude a encontrar um raminho de Menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100115,
					"content": "Ah, sim – E não seja muito exigente ao procurar por um raminho de Menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100116,
					"content": "Lembre-se, você está apenas procurando por um raminho de planta qualquer. Você não está procurando por problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100105,
					"content": "Na verdade, estou bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "Ah, que bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100107,
					"content": "Mas os seus passos estão tão apressados, creio que esteja a caminho para resolver algum problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100108,
					"content": "Bem, embora eu não saiba qual problema você precisa resolver, eu tenho uma sugestão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				}
			]
		},
