				{
					"id": 708120501,
					"content": "Você conseguiu pegar todos eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120502
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120502,
					"content": "Sim, senhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708120503
					]
				},
				{
					"id": 708120503,
					"content": "Você tem os meus mais sinceros agradecimentos. Levarei estes pôsteres e os devolverei aos seus respectivos comerciantes em um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120504
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120504,
					"content": "Quanto àquela placa, é do Presentes dos Anjos. Eu já notifiquei Charles - ele enviará alguém para levá-la de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120505
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120505,
					"content": "Aqui está uma pequena remuneração por sua ajuda. Aceite-a por favor. Quanto a mim, preciso resolver para outras tarefas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120506
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120506,
					"content": "Embora a tempestade tenha cessado, seus efeitos permanecerão conosco por algum tempo.",
