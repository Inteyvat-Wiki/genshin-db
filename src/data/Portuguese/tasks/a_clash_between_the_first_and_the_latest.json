			},
			"dialogs": [
				{
					"id": 745090101,
					"content": "Após um tempo, você e Paimon chegam ao estande da Festa Fúngica Fantástica...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745090102
					]
				},
				{
					"id": 745090102,
					"content": "Oh, as Estrelas Gêmeas do Valor Brilhante! Voltaram para mais Festa Fúngica Fantástica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090103
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090103,
					"content": "Srta. Enghiene recebeu ordens para retornar à Maison Gardiennage, então eu vou jogar contra vocês agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090104
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090104,
					"content": "Ei, Souka! Você voltou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090105,
					"content": "Paimon ficou bem surpresa quando a gente encontrou Haniyyah, mas você subiu o nível! Sua roupa é tão... Bem, você é mesmo entusiasmada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090106,
					"content": "E isso é bom, porque eu tenho muito trabalho... Preciso ficar motivada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090107,
					"content": "E é por isso que vou diminuir meus problemas, uma machadada por vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090108,
						745090109
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090108,
					"content": "Como estão as coisas no jornal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				},
				{
					"id": 745090110,
					"content": "Nosso plano está progredindo com estabilidade. Eventos novos como esse atraem muita atenção e o jornal não vai perder nenhuma oportunidade de promoção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090111
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090111,
					"content": "Não conseguimos a página mais importante, mas tá claro que o evento tá ficando mais popular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090112,
					"content": "Isso mesmo. Temos visto um aumento de cidadãos comuns que quiseram experimentar nosso jogo recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090113
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090113,
					"content": "Muitos têm falando sobre qual é a melhor equipe de Pequenos Cogumelos para vencer uma rodada rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090114
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090114,
					"content": "Eu também soube que pessoas estiveram procurando vocês para jogar, para poderem ver como especialistas jogam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090115,
						745090116
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090115,
					"content": "A gente quer ficar na surdina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090117,
					"content": "Exceto caso vocês joguem contra nós, claro. Vocês já conhecem nossas estratégias muito bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090118,
					"content": "Paimon acha que uma partida entre vocês e nós... vai ser um teste de técnica de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090119,
					"content": "Bem, vocês estão aqui agora, que tal um amistoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090120
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090120,
					"content": "Pensando nisso, a última vez que nos enfrentamos foi durante a primeira Copa Nilotpala de Domadores de Feras, em que vocês me derrotaram tranquilamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090121
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090121,
					"content": "Que nostálgico! Depois disso, Haniyyah e eu passamos por muita coisa juntas, e muitas coisas mudaram. Aposto que foi o mesmo com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090122
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090122,
					"content": "Mas sua... coragem pura e aura destemida ainda são resolutas e resistentes como cristal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090123,
					"content": "Apenas isso seria suficiente para decidirmos que seguiríamos vocês, quando ainda estávamos preparando o Fungo Mechanicus. Acho que fizemos a escolha certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090124
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090124,
					"content": "Hmm, por que entramos no túnel do tempo tão de repente? Isso é algo que escritores fazem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090125,
						745090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090125,
					"content": "Também sinto saudades dessa época.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090127,
					"content": "Sim! Que fala incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090128
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090128,
					"content": "Enfim, como uma das desenvolvedoras do jogo, tenho uma carta na manga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090129
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090129,
					"content": "Tá falando \"daquilo\", Souka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090130
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090130,
					"content": "Isso mesmo. Vou começar, então Haniyyah vai controlar poderosos oponentes contra vocês. Deve ser uma partida emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090131
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 745090131,
					"content": "Vamos nessa, Cometa Dourado e Parceira de Prata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090132,
						745090133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745090132,
					"content": "Tudo bem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090134,
					"content": "Depois de todo esse tempo, você enfrentando Haniyyah de novo... Ooh, isso tão é emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090135,
					"content": "Mas é só um amistoso, vamos só nos divertir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745090133,
					"content": "Bora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090126,
					"content": "#Podemos fazer novas memórias junt{M#os}{F#as}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090116,
					"content": "Infelizmente, tantas pessoas, tanta pressa de perder...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090109,
					"content": "Como a publicidade tá indo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				}
			]
		}
	]
}