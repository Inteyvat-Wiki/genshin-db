						730410502
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410502,
					"content": "#Nara dourad{F#a}{M#o} realmente é impressionante, me reconheceu tão rapidamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410503,
					"content": "#Embora Nara dourad{F#a}{M#o} seja excepcional, Aralila também é fraca, e Aranishat não será encontrado tão facilmente. Me observe!",
