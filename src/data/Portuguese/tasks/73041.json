			"dialogs": [
				{
					"id": 730410601,
					"content": "Eh! Como pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "Aranishat foi descoberto tão rapidamente, é tão fraco quanto Aralila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "#Todos fracos, apenas Nara dourad{F#a}{M#o} é forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "#Isto não pode continuar, precisamos treinar Ararakalari. Com Ararakalari muito forte, amig{M#o}{F#a} Nara não vai me encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "Não acho que funciona assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "Tem medo de perder? Jogue o jogo, não se preocupe em ganhar ou perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "#Apesar de ter perdido, me diverti muito, Nara dourad{F#a}{M#o} é {M#um bom}{F#uma boa} Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "#Amig{M#o}{F#a} Nara ganhou. Que bom! Leve as nossas flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "#Obrigado {M#bom Nara! Você é um bom amigo!}{F#boa Nara! Você é uma boa amiga!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "Mais sorte da próxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
