			"dialogs": [
				{
					"id": 730410101,
					"content": "#Oh, é {M#o}{F#a} Nara dourad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "#Amig{M#o}{F#a} Nara, venha se divertir com Aralila! Aranishat é muito fraco, não brinque com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Pfff... Da última vez Aralila perdeu para Aranishat, Aralila é a mais fraca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "Tá bem. Não vamos nos importar com o Sol ou a Lua, vamos brincar com Nara e ver quem é o mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Vamos competir, Aranishat não tem medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "#Aralila se esconde primeiro e depois {M#meu}{F#minha} amig{M#o}{F#a} Nara vem me procurar. Depois Aranishat se esconde também. Quem for encontrado primeiro é o perdedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "#Amig{M#o}{F#a} Nara, quer brincar? Se já estiver pront{M#o}{F#a}, vamos começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
