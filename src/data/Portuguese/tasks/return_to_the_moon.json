			"dialogs": [
				{
					"id": 60280201,
					"content": "Este é... este é o lugar onde o povo de Hiperbórea costumava se comunicar com as luas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280202,
					"content": "Lua Eterna, Lua Gelada, Lua Iridescente... Quando o poder das três convergir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "O portal para as luas será aberto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280204,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "As Medulas Lunares estão posicionadas. Só resta o passo final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60280206,
					"content": "...Tenho certeza de que a Cidade de Nasha está mais animada do que nunca neste momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280207,
					"content": "É... Desculpe ter que ser agora... Sabe, pela despedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "Tudo bem. Estou mais do que satisfeita com isto — minha última e única bagagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280210,
					"content": "Já consigo sentir... o chamado da lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280212,
					"content": "Este raio de luz vai te guiar de volta para casa, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 60280213,
					"content": "De agora em diante, finalmente teremos um motivo para orar à verdadeira lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Sim. Estou ouvindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280216,
					"content": "Não deixe de voltar e encontrar a gente quando tiver a chance!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Haha... Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280218,
					"content": "Mas se essa chance não aparecer... Lembre que você tem amigos nesse planeta, pessoas que sentirão sua falta, \"Columbina\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Sim, farei isso. Obrigada por tudo que fizeram por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280220,
					"content": "E lembre-se... Seja noite ou dia, a luz da lua sempre nos unirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60280221,
					"content": "#Ufa... Então... Adeus, {M#meus amigos}{F#minhas amigas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
