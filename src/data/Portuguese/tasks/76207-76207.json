			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah... Eu já fui a própria linguagem. Agora, fui reduzido a um sujeito despedaçado de delírio, retornando mais uma vez a este \"símbolo\" imperfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Eca! Um esquisitão falando coisas esquisitas acabou de sair de um livro esquisito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "\"Esquisito\" é um termo impreciso. Ele sugere uma entidade única que não pode ser descrita, registrada ou caracterizada. Eu claramente não me encaixo nessa definição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Eu só estava tentando encontrar, nestas páginas, um ponto de entrada para a \"realidade\", mas acabei escorregando sem querer para um adiamento infinito de metáforas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Eu virei um resto que desafia a simbolização. Foi graças à sua intervenção que eu fui arrancado da tirania da linguagem e finalmente posso começar a me reconhecer errado mais uma vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Em termos mais simples, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "...Eu acabei caindo sem querer nas páginas e fiquei preso. Obrigado por me puxar para fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
