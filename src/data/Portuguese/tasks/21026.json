					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Como foi? Você soltou a garrafa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Será que o Pequeno Meng irá recebê-la?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Heh. Normalmente, seria algo bem difícil. Praticamente impossível, eu diria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "Então qual o motivo de termos feito tudo isso!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Haha, relaxe. Eu disse que um certo adulto responsável ajudaria ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Você conhece um lugar chamado Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "Eu tenho alguns amigos que são homens de negócios. Atualmente, eles estão planejando entrar no mercado de cogumelos, por isso estão indo lá para realizar pesquisas de mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Mas como você sabe, as \"pesquisas de mercado\" também tendem a deixar muito tempo livre para o lazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Como aquele garoto chamado Pequeno Meng quer viajar, posso perguntar a esses meus amigos se eles podem levar outra pessoa junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Não se preocupe com isso. Eu cuidarei de todos os preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Eu fiz outra cópia da carta para outras finalidades. Quanto à garrafa... deixe-a seguir seu caminho, embora eu duvide que alguém a pegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "#Obrigad{M#o}{F#a} por ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Realizar os sonhos das crianças não é algo que os adultos devem fazer? Relaxe, você pode deixar este assunto comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Ah, sim. Eu deveria pedir àqueles meus amigos que se vestissem um pouco melhor. Assustar as pessoas é simplesmente muito errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Por que você está disposto a ajudar o Pequeno Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
