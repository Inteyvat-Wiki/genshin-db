			"dialogs": [
				{
					"id": 411230101,
					"content": "Olá, Viajante. Por favor, neste período fique dentro da cidade, não vá para fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "Agora, acredito que você também tenha visto aqueles meteoritos que caíram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230104,
					"content": "Não sei por que essa chuva de meteoritos é muito forte, os arredores da cidade não são seguros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230105,
					"content": "Os problemas dentro da cidade são cada vez maiores, os Cavaleiros de Favonius estão sobrecarregados. Além disso, recentemente descobrimos nos arredores da cidade rastros de muitos Ladrões de Tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230106,
					"content": "Esse grupo asqueroso que faz tudo por dinheiro, temo que estejam se aproveitando desse momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230107,
					"content": "Se você tiver interesse, poderia ir aos arredores da cidade ajudar a expulsar os Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230108,
					"content": "Originalmente isso era responsabilidade dos Cavaleiros de Favonius, mas não temos pessoas que possam ir lidar com isso, só nos resta contar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230109,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "Você tem meus agradecimentos. Sinto muito, sei que não causa uma boa impressão para nós te pedir que nos ajude nestas circunstâncias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230111,
					"content": "Os Cavaleiros de Favonius não temem os meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "Urg... Por dinheiro, aqueles caras não deviam temer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411230113,
					"content": "Você tem meus agradecimentos. Sinto muito, sei que não causa uma boa impressão para nós te pedir que nos ajude nestas circunstâncias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
