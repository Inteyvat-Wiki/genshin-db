			"dialogs": [
				{
					"id": 411230401,
					"content": "Ah! Não... Não se aproxime...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230402,
					"content": "Uh? Não é um monstro... Você, quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230403,
					"content": "Quanto aos monstros mágicos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "A situação dos monstros... Isso importa? Eu acabei de vir de lá correndo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230405,
					"content": "Um grupo de monstros está ali do lado, parece que vão atacar a vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230406,
					"content": "Se eu não tivesse corrido, não tenho certeza se você teria me visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230407,
					"content": "Onde estão aqueles monstros mágicos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "Estão ao redor da cidade, muito próximo, se der alguns passos poderá vê-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230409,
					"content": "Você vá se esconder, eu vou ficar aqui descansando um pouco... Depois de descansar vou retornar para a vila e contar às pessoas a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Medroso"
				}
			]
		},
