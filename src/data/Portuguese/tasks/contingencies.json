			"dialogs": [
				{
					"id": 411230801,
					"content": "Uh? Você de novo? Você foi fazer o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230802
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230802,
					"content": "Já derrotei todos os monstros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230803
					]
				},
				{
					"id": 411230803,
					"content": "Derrotou... Mesmo? Você sozinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230804
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230804,
					"content": "Você pode ir ver se quiser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230805
					]
				},
				{
					"id": 411230805,
					"content": "Uh... Eu não tenho coragem de ir ver, se os monstros me descobrirem, é o meu fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230806
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230806,
					"content": "Deixe para lá, independentemente do que você falou ser verdade ou não, eu tenho que ir reportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230807
					],
					"speakerTitle": "Morrow Medroso"
				},
				{
					"id": 411230807,
					"content": "Se você realmente derrotou os monstros, os Cavaleiros de Favonius terão um jeito de verificar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morrow Medroso"
				}
			]
