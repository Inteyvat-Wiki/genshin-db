			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "Uma vez ouvi um emissário da Ilha Narukami falar sobre uma criatura chamada \"pássaro\". Possui asas e pode voar nos céus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370402,
					"content": "Isso é incrível! Vocês conseguem imaginar algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370403,
					"content": "Algumas pessoas acreditam que são mensageiros dos deuses, e que carregam as palavras de destino dos humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370404,
					"content": "E se alguma pessoa exilada acabar falecendo na natureza, esta mesma criatura virá para bicar e consumir sua carne mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370405,
					"content": "Esses animais são fascinantes para mim. Se eu puder ver a luz do dia depois de hoje, com certeza criarei um pássaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223708",
							"2"
						],
						"stepId": 7223708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "Vocês conseguiram pegar os livros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370502,
					"content": "Sim. Você realmente é inocente, Antei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370503,
					"content": "Pelo jeito que vocês falaram antes, vocês não são Jibashiri... Que pena. Vocês poderiam ter dito que eu era inocente no local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370504,
					"content": "Assim minha inocência já estaria provada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370505,
					"content": "Bem, me sinto enérgico, mas tenho certeza que eu estava exausto por ter perdido tanto sangue. Não posso me livrar dessa sensação que morrerei em breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370506,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370507,
					"content": "#*Suspiro* Forasteir{F#as}{M#os}, deixe-me lhes perguntar uma coisa. Ser acusado injustamente pelo Reino de Byakuya conta como um pecado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "Se eu, devido ao meu estado mental perturbado, fui deixado por aqui por Tokoyo Ookami como uma Sombra Pecaminosa, seria isso uma transgressão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370510,
					"content": "Será que sou culpado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370511,
					"content": "Não, você é inocente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#Ei, {NICKNAME}! Se ele perceber isso... Ele vai desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370513,
					"content": "Você é só uma sombra que Antei deixou para trás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370515,
					"content": "Você é inocente, e garanto que todos saberão disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "Haha, mesmo? Eu sou apenas uma sombra que ficou para trás após minha morte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370517,
					"content": "E... Sou inocente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370518,
					"content": "A ilusão de Antei começa a recitar algumas passagens quebradas...\\n\"Que leis divinas eu quebrei...? Por que os desafortunados confiam nos deuses?\\nMeus atos têm significado, agora que meus atos mais sinceros me fizeram ganhar um nome pecaminoso?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		}
	]
}