			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Vocês são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Você é Antei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Isso mesmo, sou eu. Me sinto um pouco... Estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "Eu lembro de perseguir esses vigaristas... Eles arrancaram um núcleo e o jogaram num acampamento. Após isso, eu fiquei tonto por causa de minhas feridas... elas eram bem graves...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Mas então eu acordei e lhe conheci, e agora me sinto bem. Diga-me, eu vou morrer em breve ou algo do tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "... Não, isso não é importante agora. Você está aqui para me prender de novo? Eu já provei minha inocência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Foram esses caras de Khaenri'ah. Foram eles que roubaram o livro da biblioteca. Me responsabilizaram como um de seus guarda-costas, mas eu jamais agiria junto com eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Eu rastreei o grupo de emissários até aqui e derrotei todos eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Mas eu passei muito tempo lidando com alguma criatura mecânica gigante que eles tinham consigo. Finalmente fui capaz de tirar o seu núcleo, mas fiquei seriamente ferido no processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "A máquina desativada caiu em cima do livro perdido. Não há como recuperá-lo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Uau, os Jibashiri do Reino de Byakuya são bem durões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "#Espere, vocês não são Jibashiri ou candidat{F#as}{M#os}? *Suspiro* Os Jibashiri originalmente eram heróis que lutaram contra os Dragartos das Profundezas. Somente depois que eles se tornaram em agentes da justiça, os juízes do submundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "O núcleo da máquina está no acampamento. Vá até lá e dê uma olhada se não acredita em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
