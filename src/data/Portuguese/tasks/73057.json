			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "Nara... Hmm, qual o nome? Aranakin não precisa dormir com isso, por isso esqueceu a palavra, é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570502,
					"content": "É \"cama\". Parece nova... Alguém já dormiu nela antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Hehe, Aranakin sempre mantém aqui arrumado... Se querem dormir aqui, tudo bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305706,
