			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "\"... Eu consertei o oud que o tio Bakr deixou cair, então pare de chorar, tá bem? Fale com Khayyam e comigo se você estiver infeliz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570902,
					"content": "\"... Fui admitida na Academia! Parabéns para mim! Não quero ser a esposa de um guerreiro qualquer, vou ser a grande sábia, Siman!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570903,
					"content": "\"...Hehe, o grande músico Irfan e o sábio Khayyam! Não se esqueçam de mim! Especialmente você, Khayyam! Não se esqueça de mim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570904,
					"content": "\"...Adeus, caderno! Adeus, Irfan e Siman, meus melhores amigos! Espero que a floresta nunca esqueça nossa história, e espero que nos lembremos uns dos outros...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570905,
					"content": "(...O resto é bagunçado e cheio de lembranças felizes e tristes das crianças...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570906,
					"content": "\"...Aranakin realmente se foi, desapareceu no ar. É hora de me despedir do oud também. Eu serei uma artesã, assim como meu pai esperava que eu fosse...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570907,
					"content": "(Parece haver mais, mas está coberto de tinta preta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570908,
					"content": "\"...Para a pessoa que está lendo este caderno, se um milagre me permitir encontrar Aranakin e os outros novamente daqui a alguns anos, então, por favor, dê esta flor a ele...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Caderno Desgastado"
				},
				{
					"id": 730570909,
					"content": "Hã?... Algo parece ter caído do caderno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "Parece... uma flor? Parece... exatamente como a flor que recebemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
