			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "Ah, se foi... Bem, ele com certeza esqueceu todas as nossas aventuras juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570102,
					"content": "Não fique triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "Sim, você tem razão... Ah, sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570105,
					"content": "Aranakin nos ensinou uma música, certo? Vamos tocar, talvez ele possa reconhecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570106,
					"content": "Você tem razão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "Hehe, porque Paimon é Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570108,
					"content": "Finalmente, um conselho útil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "#Você é muito malvad{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570103,
					"content": "Podemos nos tornar amigos novamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "Haha, ele veio! Olá, coisinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570202,
					"content": "Aranakin não é uma coisinha! Você é! Coisinha branca voadora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570203,
					"content": "... Falando nisso, areia dourada... Nara, como vocês conhecem essa canção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570204,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570205,
					"content": "Foi você que nos ensinou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "Sim, você nos ensinou essa música quando fizemos nossa última aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570209,
					"content": "Mesmo...? Hmph, Aranakin não é esperto, mas vocês não parecem areia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570210,
					"content": "#Sim! Areia é Valuka, é Nara ruim. Mas nós somos {F#boas}{M#bons} Nara! Foi isso que você disse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570211,
					"content": "Hã? Eu disse isso para vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570212,
					"content": "#Haha, sim! {NICKNAME}, vamos contar as histórias para ele novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570213,
					"content": "Vocês recontaram sobre as aventuras para Aranakin, e como conseguiram eliminar o Definhamento juntos.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "...Oh, entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570215,
					"content": "Aranakin não é inteligente, mas o que vocês disseram parece verdade. Aranakin não consegue lembrar, sinto muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570216,
					"content": "Oh, não precisa se desculpar! É normal esquecer as coisas... Além disso, podemos nos tornar amigos de novo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570217,
					"content": "Você é legal, Aranakin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "Hmm... Como somos bons amigos, sigam-me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570221,
					"content": "Oh? Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570222,
					"content": "#Nara dourad{F#a}{M#o}, Branca Voadora! Para a minha casa, sigam-me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570218,
					"content": "Paimon, você é legal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "Hehe, isso é verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570207,
					"content": "Eu toquei a música para poder lhe rever.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#Hehe, como {NICKNAME} se saiu? Está vendo? Nós ainda lembramos da música que você nos ensinou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
