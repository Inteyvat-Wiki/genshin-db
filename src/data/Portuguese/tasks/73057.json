					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570601,
					"content": "Há folhas que Nara deixou lá em cima, mas... Não posso lê-las, não entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570602,
					"content": "Essas daqui são... Folhas que Nara usou para deixar memórias. Nara escreve em folhas, e as coloca juntas. Mas as palavras de Nara, Aranakin não entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "Você quer dizer... \"Caderno\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "\"Caderno\"? É assim que Nara guardam suas memórias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Hmm, sim... Aranakin, você se importa se subirmos e vermos juntos o que está escrito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "Eu? Nem um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
