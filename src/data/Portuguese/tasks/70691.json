			"dialogs": [
				{
					"id": 706910101,
					"content": "#Cavaleir{F#a}{M#o} Honorável! Aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "Eu acabei de fazer novas amigas! Quer brincar com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "As crianças mais velhas nos ensinaram um jogo novo chamado Corrida na Neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "As regras não são difíceis. É só um tipo especial de esconde-esconde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Uau, Klee, Yaoyao e Sayu viraram amigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "Esse nome... Hmmm, é como se fosse uma outra versão do Labirinto de Vento? Deve ser bem divertido de jogar com vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Esconde-esconde? Que legal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "ATCHIM! Apesar de não estar tão frio assim no acampamento, já estou me sentindo com sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Hmm, meus olhos estão me enganando, ou ess{F#as}{M#es} são {NICKNAME} e Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Seus olhos estão bem. É só {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Oi, Yaoyao e Sayu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Boa ideia! Quando começarmos a nos divertir, não vamos ter sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "E aquela super séria Senhorita Aoi não disse que passar mais tempo na Espinha do Dragão ia ser bom para suas habilidades, Sayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Hã, não acredito que vocês lembram disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Certo, mas se eu perder para esses companheiros aventureiros, ou para aquele super Ninken, vai ser bem mais difícil ficar de bobeira no futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Parece que vou ter que arregaçar minhas mangas nessa viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "Eu bolei uma nova receita de cozido de vegetais e carne com Pimenta de Jueyun e pimenta em pó. Acabei de fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Pegue um pouco antes de começar o esconde-esconde, prometo que você não vai sentir frio durante o jogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Que legal! Vou tomar toda uma tigela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Paimon quer também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Certo, então vamos começar nosso esconde-esconde aqui na Espinha do Dragão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "Uau! A Espinha do Dragão tá coberta de neve. Paimon vai se esconder, ninguém vai encontrar ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Querem brincar de Esconde-esconde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "Eu adoraria conhecer suas novas amigas, Klee...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
