			"dialogs": [
				{
					"id": 3572301,
					"content": "O Stormterror... Está atacando a cidade de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}, vocês vieram na hora certa. Nós precisamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Espere, Amber. Você está se esquecendo de nos apresentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "Ah... Está bem. Este é o Kaeya, o Intendente de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#{M#Estes}{F#Estas} são viajantes de longe, {NICKNAME} e a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "(De longe? Isso é tudo o que sabemos?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "Bem, resumindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "#Entendi. Bem-vind{F#as}{M#os} a Mondstadt, mas temo que vocês não chegaram uma boa hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Entendo a dor de ser separado da família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "Não entendo por que estamos indo atrás do Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Mas, todos têm um segredo guardado, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "Haha, relaxe! Eu não vou mais pressionar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "Enfim, em nome dos Cavaleiros de Favonius, estamos muito agradecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "Bem, não podíamos ficar apenas de braços cruzados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "Muitos habitantes de Mondstadt viram a sua luta contra o dragão para defender a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "#A Grande Mestre Intendente dos Cavaleiros de Favonius está muito interessada em conhecê-l{F#as}{M#os} e convidá-l{F#as}{M#os} formalmente ao nosso <color=#00E1FFFF>quartel-general</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "De nada, então onde está a recompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Hum... Que tal um prato típico de Mondstadt, Carne Frita com Cenoura e Mel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "Eu já ouvi falar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
