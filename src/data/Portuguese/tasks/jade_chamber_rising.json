	"talks": [
		{
			"id": 1100901,
			"completionStepIds": [
				1100901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100901",
							"2"
						],
						"stepId": 1100901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Eu reuni todos aqui hoje para fazer um anúncio importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Talvez alguns de vocês já tenham ouvido a notícia. Estou de fato planejando reconstruir a Câmara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "Reconstruir a Câmara de Jade? Não é uma tarefa simples...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Então os rumores são verdadeiros. É por isso que o preço dos materiais de construção subiu tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "A Câmara de Jade tem um significado muito especial para a Srta. Ningguang. Se eu conseguisse aproveitar essa oportunidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Srta. Ningguang, em que posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Sem pressa! Muitas pessoas já ouviram falar disso, e entraram em contato comigo, dizendo que gostariam de fazer parte do projeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Por acaso, eu também gostaria de lhes pedir um favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "O local de construção foi escolhido, e os materiais foram reunidos. Entretanto, ainda faltam três itens importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Estes três itens são \"Plaustrite do Pôr do sol\", \"Núcleo Maravilhoso\" e \"Selo Adepti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "Perdoe minha franqueza, com exceção da Plaustrite, nunca ouvi falar dos outros dois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Apenas as Plaustrites de tamanho suficientemente grande são chamados de Plaustrites do Pôr do sol. São elas que garantem a ascensão da Câmara de Jade enquanto os Núcleos Maravilhosos são os componentes centrais da estrutura mecânica interna dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "E os Selos Adepti servem para combinar os dispositivos mecânicos e artes de Adepti, também é algo imprescindível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Apesar de serem extremamente raros no mundo, creio que com suas conexões e capacidades, encontrá-los não será uma questão de \"se\", mas de \"quando\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "Eu levo o ditado \"tempo é dinheiro\" a sério, portanto, a eficiência é o que mais importa. Comprarei os materiais encontrados por um bom preço. Além disso, as primeiras 3 pessoas que os encontrarem terão a chance de me realizar uma pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "E responderei com grado. Espero que essas condições atendam às suas expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Não é fácil encontrar essas coisas, mas se eu pudesse perguntar sobre o plano de Liyue para o ano que vem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "Isso será um negócio super lucrativo. Quem obterá informações de primeira mão diretamente da senhorita Ningguang terá uma enorme vantagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Haha... que coincidência. Alguns dias atrás, cheguei a saber algumas notícias sobre a Plaustrite. Por isso, com licença, mas tenho que ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Droga! Não há tempo a perder. Não podemos deixar essa oportunidade para outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "Reconstruir a Câmara de Jade? É algo muito importante para Liyue, a gente vai dar uma olhada também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "#Vocês também ouviram o que acabei de dizer, não é? E então? Interessad{M#o}{F#a}s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Posso perguntar qualquer coisa mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Sim, desde que eu saiba responder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "#(Talvez a gente consiga algumas informações sobre {M#a minha irmã}{F#o meu irmão}.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Ah, sério? Então Paimon gostaria de perguntar como a Ningguang faz seus negócios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "Assim nunca nos faltará Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Sim, claro. Entretanto, o quanto eu falarei depende do desempenho de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "Como a Câmara de Jade consome muito espaço, reservei uma mina abandonada do lado de fora da Casa Dourada. Podem deixar os materiais encontrados lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "Vou precisar tratar um outro assunto, e não posso ir com vocês. Quando chegarem, é só procurar a minha secretária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "Se apressem! Esta é uma oportunidade de ouro, não a percam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Ningguang realmente está muito ocupada... Vamos nos apressar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Vamos primeiro sair do Terraço de Yujing... Hã? {NICKNAME}, parece que tem algo de estranho acontecendo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Senhorita, você é uma pessoa de elegância e destaque! Vejo que você facilmente ganhará essa competição que a Srta. Ningguang está realizando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090135,
					"content": "Nós temos algumas informações que achamos que você pode estar interessada. Por favor, vamos para um lugar mais calmo para falar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090136,
					"content": "Não é necessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Ei! Não diga isso! Ei! Não vá embora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090138,
					"content": "Por que você está aí parado? Atrás dela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090139,
					"content": "Sim, senhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiang, o Corajoso"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Hehe. Olha só, senhorita. Não há mais para onde fugir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090202,
					"content": "Não se preocupe. Não estamos com más intenções. Nos dê um pouco de Mora, que nós lhe damos algumas informações. Todos saem ganhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090203,
					"content": "Chefe, não estou com um bom pressentimento. Olhe para ela, esse cabelo branco, e essa aura diferente... Não parece uma pessoa comum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Qiang, o Corajoso"
				},
				{
					"id": 110090204,
					"content": "E daí? Ela com certeza tem Mora! Como que vamos pagar nossas dívidas de apostas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090205,
					"content": "Eu já disse. Não preciso de suas informações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Se você não entendeu, vou repetir pela última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "*Suspiro* Senhorita... Você parece uma pessoa inteligente. Eu tenho que ser mais claro ainda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090208,
					"content": "Não se trata de uma questão de você precisar da informação ou não. Se trata de você nos dar seu dinheiro e ninguém sai daqui machucado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090209,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "Chega de desculpa! Eu sei que você tem dinheiro! Eu vi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090211,
					"content": "Eu vi você ir primeiro ao Pavilhão de Liuli, pedir comida para encher mesa, mas só beliscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090212,
					"content": "E depois foi ao Quiosque de Xinyue e Restaurante Wanmin, pediu de tudo, e também só beliscou um pouco de cada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090213,
					"content": "Se você não fosse uma senhorita rica, como teria hábitos de tanto desperdício? E já que você é tão rica assim, que tal dividir conosco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090214,
					"content": "A mestra me alertou para não pôr minha mão em uma pessoa sequer de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Mas aqui estamos... Talvez isso seja o destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Chefe... algo não está certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Qiang, o Corajoso"
				},
				{
					"id": 110090217,
					"content": "Do que você está com medo? Nós só estamos vendendo informações, isso não é ilegal. Se ela pôr um dedo em nós, a processaremos por cada centavo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090218,
					"content": "Aqui estão eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Hã? Vocês de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Os Millelith? Quem chamou a atenção dos Millelith? Você? Você devia cuidar dos seus próprios assuntos! Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090222,
					"content": "Silêncio! Como se atreve a intimidar civis inocentes? Vocês vêm comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Hehe, não se irrite, senhor... Deixe-me explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Liu, o Cicatriz"
				},
				{
					"id": 110090224,
					"content": "Os homens que cercaram a moça de cabelo branco foram levados pelos Milleliths",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "Tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "É o meu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Ohh, então seu nome é Shenhe! O nome de Paimon é... bem, Paimon! E est{F#a}{M#e} é {M#o}{F#a} companheir{M#o}{F#a} de viagem da Paimon, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "#Eu ouvi falar de vocês {F#duas}{M#dois}. Obrigada por me ajudarem a resolver essa situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Mas, eu poderia ter lidado com isso eu mesma. Creio que bastaria bater as cabeças deles contra o chão algumas vezes que eles se renderiam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Aah! Não! Isso é muito violento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Estamos no Porto de Liyue. Temos que respeitar as leis daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "Leis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Shenhe, você não sabe o que é a lei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Não. Aparentemente não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Sério? Então você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "Hmm? Que barulho estranho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "É o meu estômago roncando. Estou com fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Ela é tão franca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Por falar nisso, aquelas pessoas disseram que você foi para todos os restaurantes, pediu de tudo, mas só comeu um pouco de cada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "É claro que você está com fome! Você está com vontade de comer algo em específico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Qingxin, Lírio de Vidro e Violeta... Isso é o que costumo comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Esses também são ingredientes medicinais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Ingredientes medicinais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "É difícil de explicar... Bem, o Chalé de Bubu não é muito longe, vamos levar Shenhe para lá para comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Afinal de contas, não podemos trabalhar bem com estômago vazio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Relaxe, tudo está bem agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Eles estão forçando ela a fazer um negócio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herborista Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Oh, vocês vieram comprar ervas? Trouxeram a receita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 110090302,
					"content": "Qingxin, Lírio de Vidro e Violeta, meio quilo de cada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Que receita é essa? Parece mais o pedido de uma refeição... Aqui está, isso é tudo que temos estocado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 110090304,
					"content": "Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Ela... ela realmente está comendo as ervas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Com todo mundo observando chocadamente, Shenhe comeu todas as ervas.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Não tenho mais fome. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Qual o sabor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Apesar de terem uma boa fragrância, só resta um sabor amargo depois de as consumir em grande quantidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Então por que você preferiu engolir isso tudo e mal tocar na comida do restaurante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Se Paimon tivesse muita Mora, Paimon iria para o melhor restaurante da cidade e pediria uma mesa inteira de comida, e engoliria tudo de uma só vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Porque não tenho certeza se vou ficar aqui no futuro ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "A comida no restaurante é definitivamente deliciosa, mas caso um dia eu retorne à vida nas montanhas, sentir falta da comida daqui será um obstáculo no meu desenvolvimento espiritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Por isso, provar um pouco de cada prato para se apreciar é o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#\"Retorno às montanhas\"... Isso mesmo. {NICKNAME}! Paimon sabia que ela era uma adeptus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Deixe meus assuntos de lado. O que vocês vão fazer em seguida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Ah! Sim! A Paimon quase esqueceu... A gente está aqui para participar da competição da reconstrução da Câmara de Jade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "#E provavelmente estamos muito atrasad{F#as}{M#os} porque perdemos muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Entendo. Ouvi falar nessa competição quando passei por ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Hehe... Se vencermos, poderemos fazer qualquer pergunta para Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Shenhe, você também veio participar dessa competição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Vim para cá para reconstruir a Câmara de Jade sim, mas não tinha intenção de me juntar à competição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Vocês foram gentis comigo, por isso desejo lhes ajudar. Não se preocupem, pois não cobrarei nada para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Uau! Paimon está muito grata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Com a ajuda de uma Adeptus, as coisas devem correr sem problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Então vamos lá começar a trabalhar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Então vamos. Tenho um plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Ótimo! Paimon aposta que o seu plano será o melhor, Shenhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Não sei dizer se, ou até onde esse plano pode ser dito como \"o melhor\". Mas acredito que será eficaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "#Simplesmente teremos que eliminar todos que estão a nossa frente. Assim seremos {F#as}{M#os} primeir{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "De jeito nenhum! Nem pensar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Mesmo? Mas ouvi dizer que competição é sobre conflito e se colocar contra os demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "Nós queremos ganhar de forma justa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "\"Plaustrite do Pôr do sol\" \"Núcleo Maravilhoso\" e \"Selo Adepti\", vamos procurar em ordem. Então primeiro, vamos tentar encontrar a Plaustrite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Ah, então são vocês que estão discutindo em minha loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu! O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "A Srta. Ningguang quer comprar um lote de ervas medicinais para feridas. Não temos muitas na loja, por isso vim pegar algumas pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "Hã? Por que Ningguang precisa de tantos remédios para feridas do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Não tenho certeza. Ouvi dizer que ela está reconstruindo a Câmara de Jade, talvez sejam para primeiros socorros no local de construção? Eu não perguntei, não tenho interesse nos assuntos privados de meus clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Ela até mesmo pegou Qiqi emprestada... Por isso, o Chalé de Bubu está com falta de pessoal. Será que vocês gostariam de trabalhar meio expediente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "Não, não, temos outras coisas para fazer... Já que você está, e você sabe de muita coisa — você já ouviu falar de algo como \"Plaustrite do Pôr do Sol\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Ah, a Plaustrite que é usada na Câmara de Jade? Há algumas menções a ela em \"Sete Tratados da Montanha\". Quando ativada, a Plaustrite do Pôr do Sol sobe até as nuvens. É muito rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
