			"dialogs": [
				{
					"id": 200270101,
					"content": "#Muito obrigado, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "Eu só queria dar uma olhada nas vinhas, e então... isso aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "*Suspiro* Não diga uma palavra sobre isso para o meu filho. Ele é um dos Cavaleiros de Favonius, ele também está muito ocupado com o seu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "Eu apenas sou um incômodo, não queria causar problemas para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Recentemente, parece que temos tido alguns problemas com Slimes ao redor da área do Vinhedo. Eu fico constantemente com medo de que eles estraguem minhas videiras. Mal consigo dormir à noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "Não sei se você tem tempo para um velho como eu... mas, se você tiver tempo, poderia me ajudar a acabar com eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Que ótimo! Agora vou poder descansar em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "Ainda tenho outro assunto para tratar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "*Suspiro* Eu faria com todo prazer, mas na minha idade minha força não é mais o que costumava ser... Para um jovem como você, isso não deve ser problema. Vamos lá, faça o dia de um velho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
	]
