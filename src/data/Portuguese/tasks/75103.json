			"dialogs": [
				{
					"id": 751030101,
					"content": "Uau, quantos peixes! O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Hmm? Oh, e aí, {M#irmãozão loiro}{F#irmãzona loira}! E sua, uh... Irmãzinha... branca, eu acho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Iway e eu estamos esperando pelos Pássaros do Fluxo Aéreo voltarem para a margem. Enfim, não há muito que podemos fazer no momento mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Voltar para a margem? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Hrroo, Roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751030106,
					"content": "Tá, venha, Iway. Você é bonzinho, não é? Agora seja paciente. Não precisa se apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751030108,
					"content": "Enfim, nosso plano inicial era de vir aqui para brincar. Mas ninguém vem aqui embaixo além do tio Lonko, então essa é nossa base super secreta... ou algo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Mas a gente não imaginou que esses pássaros estariam tirando vantagem da gente hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "E é por isso que temos todos esses peixes prontos para atraí-los. Pássaros do Fluxo Aéreo amam isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Mas, eles não parecem ter sido atraídos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "É. Será que é por que estamos muito longe, e eles não conseguem sentir o cheiro do peixe? Se pelo menos pudéssemos trazer eles até a margem de algum jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "Se o tio Lonko estivesse aqui, ele diria algo tipo <color=#00E1FFFF>\"Apenas empurre eles logo para a margem!\"</color>... Mas Iway e eu não temos a força bruta para isso. Eles que acabariam nos empurrando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hmmm... Então, por que você não tenta no nosso lugar, {NICKNAME}? Se conseguirmos fazer com que eles venham para a margem, podem acabar atraídos pelo peixe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Entendo, então \"Paimon\", na verdade, é uma subespécie do Pássaro do Fluxo Aéreo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Redondinha feito um rocambole e gosta de peixe... É, consigo entender o que você está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Hmm! Hmmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751030115,
					"content": "O quê? Não! Enfim, de volta ao assunto — você não atraiu nenhum Pássaro do Fluxo Aéreo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
