					{
						"sceneId": 3,
						"position": [
							-2948.067,
							200.301,
							8506.227
						],
						"pointId": 9629
					}
				]
			},
			"dialogs": [
				{
					"id": 751030801,
					"content": "Uau, quantos peixes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "#Espera, não se mova, {M#irmãozão loiro}{F#irmãzinha loira}! Eles são para atrair os Pássaros do Fluxo Aéreo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Hã? É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Sim! Iway e eu estamos esperando pelos Pássaros do Fluxo Aéreo voltarem para a margem. Enfim, não há muito que podemos fazer no momento mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Hrroo, Roooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751030806,
					"content": "Tá, venha, Iway. Você é bonzinho, não é? Agora seja paciente. Não precisa se apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751030808,
					"content": "Enfim, nosso plano inicial era de vir aqui para brincar. Digo, ninguém vem aqui embaixo além do tio Lonko, então essa é nossa base super secreta... ou algo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Mas a gente não imaginou que esses pássaros estariam tirando vantagem da gente hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "E é por isso que temos todos esses peixes prontos para atraí-los. Pássaros do Fluxo Aéreo amam isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Mas, eles não parecem ter sido atraídos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "É. Será que é por que estamos muito longe, e eles não conseguem sentir o cheiro do peixe? Se pelo menos pudéssemos trazer eles até a margem de algum jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "Se o tio Lonko estivesse aqui, ele diria algo tipo <color=#00E1FFFF>\"Apenas empurre eles logo para a margem!\"</color>... Mas Iway e eu não temos a força bruta para isso. Eles que acabariam nos empurrando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Hmmm... Então, por que você não tenta no nosso lugar, {NICKNAME}? Se conseguirmos fazer com que eles venham para a margem, podem acabar atraídos pelo peixe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Entendo, então \"Paimon\", na verdade, é uma subespécie do Pássaro do Fluxo Aéreo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Redondinha feito um rocambole e gosta de peixe... É, consigo entender o que você está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Hmm! Hmmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751030815,
					"content": "O quê? Não! Enfim, de volta ao assunto — você não atraiu nenhum Pássaro do Fluxo Aéreo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
