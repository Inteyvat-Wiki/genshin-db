				{
					"id": 751031101,
					"content": "#Uau, eles realmente vieram! Muito obrigado, {M#irmãozão loiro}{F#irmãzona loira}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031102
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751031102,
					"content": "Hroo, roo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031103
					],
					"speakerTitle": "Iway"
				},
				{
					"id": 751031103,
					"content": "Preparei muitos peixes, então se você pudesse atrair todos os Pássaros do Fluxo Aéreo para cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751031104,
					"content": "Hehe, vamos <color=#00E1FFFF>empurrar o resto daqueles pássaros para a margem</color>, assim como antes, beleza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pania"
				}
			]
		}
	]
