			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Como você tem dormido recentemente, pai? Você ainda tem episódios de insônia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500502,
					"content": "Oh, estou muito melhor. Nem sequer tive pesadelos recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(As vozes da família Leroy ficam cada vez menos distintas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bater uma vez"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
