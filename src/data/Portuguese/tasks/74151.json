			"dialogs": [
				{
					"id": 741510901,
					"content": "Tem algo errado com esse casal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Paimon também acha. Um deles fala um monte e o outro quase não diz nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "O momento da aparição deles foi muita coincidência.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Você quer dizer que eles apareceram assim que Benoit estava pensando em contratar uns trabalhadores horistas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Euphrasie disse que ele ainda tava contratando um semestre antes, mas nesse tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Esse casal se tornou seus filhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "É verdade. Foi tudo tão deliberado... parando pra pensar, esse casal parece ter problema mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
