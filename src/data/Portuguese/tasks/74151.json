				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "Ah, vocês voltaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510102,
					"content": "#Paimon é Paimon e el{M#e}{F#a} é {NICKNAME}. Pode chamar a gente assim a partir de agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Você veio ver Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Isso mesmo, mas eu não consegui falar com ele... *Suspiro* Parece que minha redação entrou num beco sem saída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510105,
					"content": "Sua redação? Ah, certo! Você tava fazendo boas ações porque tinha dever de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "Ei, isso não é verdade! Eu gosto mesmo do Sr. Benoit. Ele é muito... maneiro? Sim, isso mesmo, maneiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510107,
					"content": "Pfft, que tipo de descrição é essa? Você quer dizer que ele interage bem, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Enfim, por favor, Srta. Paimon, pode me ajudar, por favor? Se não me ajudar, minha redação vai pro beleléu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510109,
					"content": "Srta. Tutor disse que minha redação sobre ajudar ele a alimentar sua gata tava \"cheia de um senso genuíno desprencioso de margem à margem\", e queria que eu escrevesse outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510110,
					"content": "O quê? \"Desprencioso\"? Você não quis dizer \"despretensioso\"? Enfim, Paimon entende. Então é por isso que você precisava voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Bem, é mesmo para meu dever de casa, claro, mas eu gosto mesmo do Sr. Leroy. Ele queria que eu desse oi aos meus pais por ele, e eu fiz isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510112,
					"content": "Eles não ficaram muito felizes em ouvir o nome dele e não queriam que eu viesse. Eu não sei por quê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510113,
					"content": "Bem, esse assunto é bem fácil, né? Você pode só falar sobre como alimentou a gata de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "Mas isso ia ser só uma linha! É muito pouco, não serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510115,
					"content": "Bem, a gente pode ir com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "É, isso mesmo. Você vai alimentar a gata e nós vamos limpar a porta e a parte de trás da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "E quando a gente acabar, vamos bater na porta e falar com Benoit. Esse vai ser todo o conteúdo que você precisa, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Isso mesmo, é isso que a gente pode fazer! Você é tão inteligente, Srta. Paimon. Deixa eu ir alimentar a gata agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moli"
				}
			]
		},
		{
			"id": 7415103,
