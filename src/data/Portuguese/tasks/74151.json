			"trigger": {
				"objectNames": [
					"Moli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Srta. Paimon, Sr{F#ta}. {NICKNAME}, alimentei a gata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510302,
					"content": "Legal! Nesse caso, vamos ver o Sr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Mas eu tô preocupada. Ele vai sair? Eu fui lá recentemente, mas ele não falou comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510304,
					"content": "Eu fui antes de vocês chegarem, mas assim que ele saiu, aquele genro assustador dele veio e arrastou ele de volta para dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510305,
					"content": "Ele me deu uns doces e me disse para voltar para meus pais. Então ele fechou a porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510306,
					"content": "Aff. Benoit é um cara tão tranquilo, por que a família dele é fria assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "O genro do Sr. Leroy disse que o sogro dele tava doente e não podia me ver, mas eu achei que ele parecia bem, por que ele não pode falar com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510308,
					"content": "Sinceramente, tô mais preocupada com o Sr. Leroy do que com minha redação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510309,
					"content": "Ele deve se sentir terrível se ele tá doente. Mamãe me disse que pessoas doentes precisam do nosso cuidado e atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510310,
					"content": "Então, vocês podem vir comigo perguntar àquele genro que tipo de mal pegou o Sr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510311,
					"content": "Ele comeu bolo demais, ou ele não se cobriu quando tava dormindo? Eu posso perguntar aos meus pais o que fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510312,
					"content": "De qualquer forma, vamos bater na porta primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Eu sei, só estou... um pouco assustada com aquele genro, porque ele é... bem, assustador. Vocês podem me ajudar a falar com ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510315,
					"content": "Fica tranquila, Moli. Deixa com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Bem, a gente tinha um acordo, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
