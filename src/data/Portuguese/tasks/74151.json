			"dialogs": [
				{
					"id": 741510501,
					"content": "Atos, que vocês viram antes, abre a porta e sai.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "Vocês de novo? O que raios querem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510503,
					"content": "#A gente quer saber se Benoit tá em casa. Soubemos que ele ficou doente, estamos meio preocupad{M#os}{F#as} com a saúde dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "#Meu pai está em casa, mas ele não tem condições de receber convidad{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510505,
					"content": "A gente pode saber do que ele tá doente? Eu posso pedir para meus pais ajudarem ele a conseguir uns remédios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510506,
					"content": "Não precisa. Nós mesmos vamos comprar os remédios que forem necessários — não que estejam faltando remédios para meu pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510507,
					"content": "#Só estamos preocupad{M#os}{F#as} com a saúde dele. Você não precisa ser tão frio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(Atos tá recusando categoricamente que a gente veja Benoit, não tá?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(Agora, essa frieza é totalmente desnecessária...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "#Vocês estão muito preocupad{M#os}{F#as} com assuntos que não são seus. Mais alguma coisa? Se não tiver, vou voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510512,
					"content": "Espere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "O que você quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510514,
					"content": "Benoit tá doente mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Claro que sim. Muito seriamente, na verdade. Mas Morticia e eu pensaremos em alguma coisa. Não precisam se preocupar — ninguém precisa, falando nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510518,
					"content": "Atos, que algazarra é essa aí fora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "Nada, Morticia, só algumas crianças dizendo que querem ver nosso pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "Você se dá bem mesmo com crianças, não é, pai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Bem, já que essas crianças querem te ver, por que você não vai dar um oi a elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "...Eu gostaria... Posso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510524,
					"content": "Claro que pode, pai. Você que manda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "A porta abre e Benoit surge lentamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "Ah, são vocês de novo, crianças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510527,
					"content": "Você tá bem, Sr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510528,
					"content": "Eu? Cof, oh, não estou tão bem, mas não se preocupem, estou me esforçando para me recuperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510529,
					"content": "Minha filha e genro são muito bons para mim, então tudo está bem — podem ir para casa, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510530,
					"content": "Tem certeza que você tá bem, pai? Se for demais para você, é melhor entrar de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510531,
					"content": "Benoit observa o olhar nos olhos de Atos antes de voltar para dentro em silêncio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "Então? Vocês viram ele. Meu pai não está bem mesmo. Isso satisfaz vocês? Se não houver mais nada, vou voltar para dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510533,
					"content": "Nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "Atos ignora todos vocês.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Bem, pelo menos conseguimos dizer algumas palavras para o Sr. Leroy. *Suspiro* Espero mesmo que ele melhore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510536,
					"content": "Parece que eu causei problemas para eles, Srta. Paimon. Aquilo... não era o que eu queria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510537,
					"content": "Não pense assim! Você não causou nenhum problema! Na verdade, Paimon acha que aquele tal de Atos é o problema aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "Hunf. O tempo todo, ele só estava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "Você devia ir para casa primeiro, Moli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#Hã? {NICKNAME}, você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "Verdade, eu devia voltar também. Meus pais não gostam quando eu venho aqui, sabe? Eles iam ficar com raiva se soubessem aonde eu fui hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510543,
					"content": "Eu não sei se vamos conseguir ver o Sr. Leroy novamente. Eu queria mesmo dizer a ele que os lanches dele eram super gostosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510544,
					"content": "Bem, vocês podem me ajudar dizendo isso a ele se o virem — depois que ele melhorar, quero dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510545,
					"content": "Sem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "Você também tem a palavra de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "Certo. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510549,
					"content": "Tenho que ir para casa agora. Até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741510550,
					"content": "#Você tá pensando em alguma coisa, {NICKNAME}? Você tá com cara de quem tem algo pra falar há um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Vamos conversar em outro lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Claro, vamos achar outro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Não vamos falar alto de coisas assim aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Você tem minha palavra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Paimon e eu vamos voltar também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Por que você tá impedindo a gente de ver Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "#E por que eu deveria permitir pessoas estranhas de ver meu pai? Como eu disse antes, ele não tem condições de receber convidad{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741510510,
					"content": "(Bem, isso é bem repentino, não é...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
