			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "\"Depois de tantos anos, este lugar ainda é tão animado! Toda vez que venho aqui me lembro do tempo que passei com ele no café discutindo a tarde toda sobre a interpretação de um ideograma.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732011302,
					"content": "Somos gratos a você por animar nossa loja, portanto, venha nos ver novamente no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
