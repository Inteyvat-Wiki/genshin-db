			"dialogs": [
				{
					"id": 200430601,
					"content": "Você falou com Quinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Sim, ele disse que você precisa descansar um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "De qualquer forma, não há nada para fazer na tenda de Quinn hoje, vá para casa e descanse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Sério? *Suspiro* Parece que vou ter que encontrar outra coisa para fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "Ei, o quê? Você não vai descansar? Justo hoje que não precisa trabalhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Pare e sinta o que está acontecendo ao seu redor. São os ventos de Lorde Barbatos, ainda trabalhando duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Somos abençoados pelo Barbatos, e não temos desculpa de sermos preguiçosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "Mas, o que você estava fazendo? Por que está suando tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "#Parece que você está muito ocupad{M#o}{F#a}. Mas isso não é uma coisa ruim, pois quanto mais trabalhamos, mais suamos e mais sentimos os ventos de Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Aqui está, pegue esta garrafa de leite. Beba e volte a fazer o que estava fazendo, o trabalho não pode parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
