			"dialogs": [
				{
					"id": 200430401,
					"content": "Você já encontrou <color=#00E1FFFF>Frutos do Pôr do Sol</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Por favor! Deve ter monte de <color=#00E1FFFF>Frutos do Pôr do Sol</color> fora da cidade. Mas eu preciso ficar aqui, pode ir buscá-los e regressar rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
