				"points": []
			},
			"dialogs": [
				{
					"id": 200430301,
					"content": "Onde está a minha encomenda? Isso é ridículo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430302,
					"content": "O que foi que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "*Suspiro*, acabaram todos os Frutos do Pôr do Sol, acabei de pedir mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430304,
					"content": "Mas não chegaram ainda. E meus clientes não vão esperar para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430305,
					"content": "A Eury já veio três vezes, tudo o que ela quer é apenas <color=#00E1FFFF>três Frutos do Pôr do Sol</color>, e agora eu tenho medo de perdê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430306,
					"content": "Preciso ficar no posto... Se ao menos alguém pudesse ir e colher alguns Frutos do Pôr do Sol selvagens para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430307,
					"content": "Se for urgente, eu posso ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Sério? Maravilha! Não sei nem como agradecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430309,
					"content": "A Michelle está a caminho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Espere! Por que a Michelle está colhendo frutas nestas condições?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430311,
					"content": "Nós podemos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
