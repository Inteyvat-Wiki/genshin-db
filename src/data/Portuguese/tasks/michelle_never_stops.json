			"dialogs": [
				{
					"id": 200430501,
					"content": "Você já encontrou os Frutos do Pôr do Sol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430502,
					"content": "Eu venho com ingredientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "Obrigado, isso deve ser o suficiente para a Srta. Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430504,
					"content": "*Suspiro* Mas agora parece que a maioria dos meus clientes foram embora. Ao que parece não é um trabalho de uma pessoa só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430505,
					"content": "Oh, obrigado pela ajuda de vocês, vou lhes dar alguns presentinhos, só um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430506,
					"content": "Não precisa, mas eu tenho um pedido para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430507,
					"content": "É sobre a Michelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "Michelle? Você a viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430509,
					"content": "Quer que eu dê um trabalho menos exigente a ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430510,
					"content": "Tudo o que eu sempre pedi foi que ela olhasse a tenda de frutas para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430511,
					"content": "Oh, é sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430512,
					"content": "Mas agora, sem clientes, acho que não vou mais nem precisar que ela faça mais isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430513,
					"content": "Por favor digam à senhora Michelle para ela ir para casa e descansar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430514,
					"content": "Daqui a pouco irei dar uma olhada para ver o que aconteceu com essa entrega...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
