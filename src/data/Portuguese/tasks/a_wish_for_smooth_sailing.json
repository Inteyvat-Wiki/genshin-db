			"dialogs": [
				{
					"id": 401970201,
					"content": "Legal! Quer um <color=#C4D6EAFF>branco</color>?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Hmm, sabor de creme? Tradicional, mas também... delicioso! Isso, está aprovado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "#Certo, agora que você é {F#a dona orgulhosa}{M#o dono orgulhosa} desse mapa comemorativo, você pode desenhar bigodes de sabores diferentes à vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hehe, parece um mapa gostoso. Vamos guardá-lo com muito carinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Ótimo! Esperamos que vocês adorem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Tudo está organizado. Agora é hora de relaxar. Esqueça o trabalho e aproveite o parque!",
					"roleType": "TALK_ROLE_NPC",
