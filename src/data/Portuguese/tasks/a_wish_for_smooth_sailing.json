			"dialogs": [
				{
					"id": 401970101,
					"content": "Agora que as coisas chegaram até esse ponto, devíamos acrescentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "Um pouco de sal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "Não, pimenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Ah, brilhante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "Vocês por acaso não tão falando de um novo cardápio de sobremesas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Pimenta não combina com uma sobremesa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Não é uma sobremesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "É para o roteiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Hã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "Minha cara parceira, fotógrafa, diretora amadora... nossa criatividade deve acompanhar o entusiasmo sobrepujante de nossos fãs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "Não há espaço para roteiros chatos no meu palco! Reviravoltas devem chocar a audiência como uma nuvem de pimenta, deixando eles espirrando de surpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "A mesma lógica se aplica a um prato e um palco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "Ouvi a Srta. Emilie mencionar que pimenta pode ser utilizada em perfumes. Talvez eu possa encontrar uma forma de fazer elas funcionarem numa sobremesa também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Hmm... a picância pra complementar a doçura de um creme, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Uau, essas duas vão dar certo trabalhando juntas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "Agora Paimon tá com dificuldade pra imaginar qual seria o gosto de um bolo de pimenta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Olha só, quem temos aqui? Escoffier está fazendo um novo bolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Sim, e está apimentando umas novas ideias.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Uau, incrível! Quando estiver pronto, me avise, adoraria provar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "É só a Paimon, ou parece que tá todo mundo ainda mais entusiasmado agora que largaram do trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "E por que não? Quando seu trabalho duro dá certo... você deveria celebrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "É como Macarons que acabaram de sair do forno... você não deve deixar o medo da doçura lhe impedir de colocar ainda mais creme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "Afinal, se é pra se entupir de açúcar, que seja comendo Macarons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "Se entupir de açúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "Se entupir de açúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970127,
					"content": "...Hmm, um momento. Posso perguntar com que tipo de açúcar vamos nos entupir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lepine-Pauline, você chegou! Está pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Claro! Foi de acordo com o planejado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Hã? Você saiu para alguma tarefa importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "Sim! Por favor, aceite isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970132,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Uau! É uma vista panorâmica do parque de diversões, e tem as ilustrações de todo mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Hehe, como o Mundo Fantástico está um sucesso tão grande, decidimos criar um souvenir único para lembrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "Construímos esse parque juntas, tijolo por tijolo. Por isso decidimos contribuir para desenhar esse mapa também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "Sinceramente, isso foi principalmente graças a Lepine-Pauline — ela é nossa especialista quando se trata de desenhar. Mas todos fizemos o possível para deixar nossas próprias marcas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#E, além disso, {NICKNAME}, estou te oferecendo um privilégio especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "Você poderá adicionar um bigode no meu retrato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
