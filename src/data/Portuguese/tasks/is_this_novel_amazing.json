				},
				{
					"id": 220100202,
					"content": "E eu acho que ele está precisando de uma arma mais forte ainda... Deixe-me pensar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100203
					],
