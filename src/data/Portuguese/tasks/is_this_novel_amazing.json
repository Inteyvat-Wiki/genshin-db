					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Os leitores conseguem entender melhor quando a diferença das forças é apresentada em números.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Em relação a isso, podemos arranjar uma habilidade de disfarce para o protagonista, que permite que ele mude de aparência e de voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "Uma habilidade que apareceu tão de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Não foi de repente! É uma habilidade oculta, que só aparece em casos de emergência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
