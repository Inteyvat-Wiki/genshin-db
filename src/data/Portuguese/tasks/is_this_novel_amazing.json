				{
					"id": 220100801,
					"content": "Os Doushins protegem o Hanamizaka dos riscos e perigos, não permitindo que nenhum suspeito escape dos olhos deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "Os Cavaleiros inimigos têm a mesma responsabilidade que os Doushins. Mas para criar mais reviravoltas, eles poderiam ter uma força 10 vezes maior que a dos Doushins?",
					"roleType": "TALK_ROLE_NPC",
