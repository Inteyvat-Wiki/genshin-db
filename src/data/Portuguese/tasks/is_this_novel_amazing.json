			"dialogs": [
				{
					"id": 220100601,
					"content": "Surgem faíscas quando os martelos batem nas bigornas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "A Ferraria Amenoma realmente é um lugar bem animado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "Com apenas algumas ferramentas básicas, os ferreiros conseguem tornar os protótipos e minérios em armas fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "E se eles ainda usarem alquimia durante o processo, será possível fazer uma arma invencível, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "A alquimia não é tão mágica como você imagina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Hum! Boa ideia. Vou arranjar a arma mais forte feita com alquimia para o meu protagonista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Ainda mais, devo arranjar um nome bonito e inventar uma boa história para essa arma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "Sim, é isso que devo fazer agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "Viajante, vamos voltar agora? Mal posso esperar para contar a minha ideia para Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "Não é assim que funciona a alquimia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "Não? Mas a alquimia não serve para tornar o impossível em possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
