			"dialogs": [
				{
					"id": 220100401,
					"content": "Na parte que ainda está faltando no meu romance, o protagonista foi ao território do inimigo sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100402
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100402,
					"content": "Ele gostaria de enfrentar os inimigos lá, portanto, a coleta de informações tem que ser feita antes da sua batalha. Como será que devo escrever para que ele possa enfrentar as dificuldades com mais facilidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100403
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100403,
					"content": "Neste caso, que tal dar uma observada em como os Doushins trabalham?",
