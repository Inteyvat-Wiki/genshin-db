			"dialogs": [
				{
					"id": 220100701,
					"content": "Na Mercearia Tsukumomono podemos encontrar vários tipos de mercadorias que se parecem com os itens coletados durante as aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Senhorita Aoi sempre me diz que alguns produtos podem não ter uma boa aparência, mas acabam sendo preferidos por certos compradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Hum... Parece que entender bem a necessidade dos compradores é algo essencial para poder aumentar os preços dos produtos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Mas se for assim, eu vou ter que gastar uma boa parte do meu romance falando sobre psicologia e negociações, acho que isso não se encaixa muito bem com o tema do meu romance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "Mas se o meu protagonista tiver a habilidade de ler mentes? Dessa forma, ele poderá saber do que o comprador precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "Uma habilidade que apareceu tão de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Isso é chamado de \"crescimento\", viu? É algo bastante normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Bom! Agora estou com inspirações, e já sei o que vou escrever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "Viajante, vamos voltar agora? Mal posso esperar para contar a minha ideia para Shigeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Mas sem nenhum contexto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
