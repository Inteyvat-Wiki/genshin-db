			"dialogs": [
				{
					"id": 750880101,
					"content": "Então, vocês encontraram aqueles fragmentos de Inscrição Iridescente...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinua"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "Haha! Bom, bom! Vou decifrar o código nos desenhos dourados nas Inscrições em breve... então... A recompensa será minha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880202,
					"content": "Não que eu tenha escolha — se eu falhar novamente, estarei sem financiamento. É nadar ou naufragar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880203,
					"content": "Ah, certo. Aqui está seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinua"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "Hmm, se eu tivesse amostras suficientes... eu poderia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880302,
					"content": "Hmm, olha só para isso? Tem um esquisitão murmurando umas coisas aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "Eu? Você pode achar gente como eu em todo lugar em Natlan. Se tem alguém estranho aqui, são vocês... Se não tiver mais nada, por favor, não interrompam minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880304,
					"content": "Minhas despesas esse mês excederam minhas expectativas, então tenho que compensar lidando com algumas recompensas de pesquisa da Associação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880305,
					"content": "Hmm, Paimon não sabia que dava pra ganhar dinheiro para fazer pesquisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "Esse é o tipo de organização que a Associação de Relíquias Saurianas é. Mora é como você encoraja pesquisa em todo tipo de assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880307,
					"content": "Dessa vez, vou decifrar as Inscrições Iridescentes... Dizem que esse grande trabalho nunca foi concluído e que a Mora paga é realmente imensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880308,
					"content": "É só que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880309,
					"content": "Que o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "Vou precisar de fragmentos da Inscrição suficientes para fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880311,
					"content": "Hmm... Que tal isso? Se vocês me trouxerem fragmentos de Inscrição Iridescente, pago vocês. E aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880312,
					"content": "#Digo, vocês parecem aventureir{M#os}{F#as} experientes. Tenho certeza que recebem comissões assim o tempo todo, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880313,
					"content": "Bem, claro, a gente pode te ajudar. Mas você já não acabou com os fundos do mês...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "Bem, já que estamos acima do orçamento, não importa até onde a gente vá... Mas isso deixará de ser um problema se eu pegar aqueles fragmentos e os decifrá-los — eu garanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880315,
					"content": "Só vamos encontrar os fragmentos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "Não se preocupe. Tudo que vocês têm que fazer é garantir de me trazer itens \"genuínos\". Falo sério — só de pensar que um golpista me vendeu uns itens das \"Ruínas da Fonte Secreta\" falsificados... Ai, faz meu sangue ferver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880318,
					"content": "E não foi pouca Mora que entreguei naquela transação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880319,
					"content": "Ah, então foi assim que você estourou o orçamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "E precisamente por isso que é necessário recuperar-se usando a própria Inscrição Iridescente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880321,
					"content": "Então, por favor! Conto com vocês para encontrar aqueles fragmentos! Achem eles e me tragam aqui, por gentileza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880322,
					"content": "Eu nem preciso de tantos assim. Só... Três? Não, quatro! Digo, não posso pagar por mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880316,
					"content": "Sem garantia que eles vão ser úteis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
		{
			"id": 7508806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
