			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "Ah, são vocês! Agradeço por me trazerem aqueles fragmentos de Inscrição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880602,
					"content": "Mesmo assim, o progresso que estou fazendo decifrando elas é... preocupante. As similaridades com Gravura de Flogisto são meramente ostensivas — a complexidade nela é muito maior do que antecipei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Kinua"
				},
				{
					"id": 750880603,
					"content": "Mas não há volta agora, então... Tenho que fazer isso de todo jeito, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinua"
				}
			]
		}
	]
}