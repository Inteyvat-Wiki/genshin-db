			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "Pequenino, você não me trouxe aqui? Vamos, continue andando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740102,
					"content": "Não importa, é melhor você ficar aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "Infelizmente, fui enganado por esse \"carinha\" de novo... Vou contar brevemente desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740107,
					"content": "Para começar, você pode não acreditar que os Seelies são de alguma forma facilmente atraídos por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740108,
					"content": "Entre os Seelies que vieram me seguir, encontrei um tipo que é particularmente interessado em buscar tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740109,
					"content": "Eu também não sei como nomeá-las, então eu apenas os chamo de \"Seelies dos Tesouros\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740110,
					"content": "Eles são muito bons em caçar tesouros. Com a ajuda deles, desenterrei muitos tesouros e encontrei muitas riquezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740111,
					"content": "Mas às vezes eles começam a me ignorar, não sei se estão cansados de caçar tesouros, ou acham que eu sou muito chato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740112,
					"content": "Nessa época, costumo procurar um ajudante que possa parecer interessante para os Seelies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740113,
					"content": "Ele fica encarregado de caçar tesouros com o \"Seelie dos Tesouros\" e eu... Sou responsável por vender esses tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740114,
					"content": "Dizem que ruínas e antiguidades estão por toda parte em Sumeru. Então vim buscar minha fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740115,
					"content": "Quando vim, eu realmente atraí um monte de Seelie, e vários dos \"Seelie dos Tesouros\" me trouxeram aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740116,
					"content": "Mas eu nem sequer comecei a cavar quando eles começaram a me ignorar de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740117,
					"content": "Hã? Por que de repente começou a se mover? Poderia ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740118,
					"content": "#Viajante, você está interessad{M#o}{F#a} em caçar tesouros com os Seelies?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740119,
					"content": "Eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "Isso não será necessário. Basta segui-lo e cavar onde ele parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740122,
					"content": "O que você acha? Apenas tente... Se você pegar algum tesouro, eu só quero as \"Moedas de Ferro Antigas\" se houver alguma. O resto é todo seu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740123,
					"content": "E se você me ajudar a encontrar algumas dessas moedas, eu pagarei por elas a um preço justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740124,
					"content": "Posso tentar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "Claro! Eu gosto de pessoas como você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740130,
					"content": "Resumindo, agora estamos em parceria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740131,
					"content": "Pegue este caderno. Gravei nele alguns locais de tesouros escondidos que encontrei antes, mas não tive a chance de cavar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740132,
					"content": "Conto com você então, Viajante. Volte e me traga as \"Moedas de Ferro Antigas\" se você encontrar alguma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740126,
					"content": "O que é a \"Moeda de Ferro Antiga\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "Simplificando, é uma espécie de antiguidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740128,
					"content": "Com boas conexões, poderei trocar as moedas por coisas decentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740129,
					"content": "Embora... Eu ainda não tenha encontrado boas conexões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740120,
					"content": "Eu não sei como falar com um Seelie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "Esse é... um Seelie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "Você diz esse rapazinho? Ah... Mesmo que fosse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "Ulman"
				}
			]
		},
