			"dialogs": [
				{
					"id": 736740301,
					"content": "Pequenino, você não me trouxe aqui? Vamos, continue andando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740302
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740302,
					"content": "Não importa, é melhor você ficar aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740303,
						736740304
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740303,
					"content": "Ulman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				},
				{
					"id": 736740305,
					"content": "Viajante? Há quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740306
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740306,
					"content": "#Você ainda está viajando pelo mundo? Ouvi muito dos seus feitos incríveis, você é realmente extraordinári{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740307
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740307,
					"content": "Ei! Que problema você veio resolver em Sumeru desta vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740308,
						736740310
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740308,
					"content": "Ei! Vire essa boca para lá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740309
					]
				},
				{
					"id": 736740309,
					"content": "Muito bem, vamos ao que interessa. Viajante, que tal trabalharmos juntos novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740313,
					"content": "A terra de Sumeru está repleta de tesouros. Tem Mora em todos os lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740314
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740314,
					"content": "Seelies são atraídos para mim como de costume. E os Seelie dos Tesouros com os quais nos familiarizamos também estão entre eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740315
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740315,
					"content": "O mesmo de antes. Você e os Seelies procuram tesouros, e eu preparo seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740316
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740316,
					"content": "Trabalhando juntos, definitivamente podemos ganhar muito dinheiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740317,
						736740321
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740317,
					"content": "\"Moedas de Ferro\" outra vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740318
					]
				},
				{
					"id": 736740318,
					"content": "Não. Desta vez estou procurando por \"Moedas de Ferro Antigas\", que valem mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740319
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740319,
					"content": "Parece que a diferença é só de uma palavra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740320
					]
				},
				{
					"id": 736740320,
					"content": "Não é! As antigas vendem por mais Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740326,
					"content": "Então este assunto está resolvido, vamos trabalhar juntos como antes e lucrar muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740321,
					"content": "Você não consegue encontrar ninguém além de mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740322
					]
				},
				{
					"id": 736740322,
					"content": "#Bem... Quando você escolhe {M#um}{F#uma} parceir{M#o}{F#a}, é claro que tem que escolher a pessoa com quem está mais familiarizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740323
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740323,
					"content": "Além disso, nós somos amigos. Eu não iria deixar uma oportunidade dessas cair no colo de uma pessoa qualquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740324
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740324,
					"content": "Da última vez que nos encontramos, você não tinha essa lábia toda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740325
					]
				},
				{
					"id": 736740325,
					"content": "Hehe, é só assim que você consegue persuadir os seus clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740326
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740310,
					"content": "Vou \"dar um jeito\" em você primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740311
					]
				},
				{
					"id": 736740311,
					"content": "Haha, melhor não. Eu não seria forte o suficiente para aguentar os seus socos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740312
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740312,
					"content": "Sério, Viajante! Que tal trabalharmos juntos novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740313
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 736740304,
					"content": "O que te traz aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740305
					]
				}
			]
		}
	]
}