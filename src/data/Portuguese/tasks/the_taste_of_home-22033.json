			"dialogs": [
				{
					"id": 220330601,
					"content": "Ei? O sabor desse prato é meio estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330602
					],
					"speakerTitle": "Tang Wen"
				},
				{
