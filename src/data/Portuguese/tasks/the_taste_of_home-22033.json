					"content": "Bolinha de Arroz, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330709
					]
				},
				{
					"id": 220330709,
					"content": "Parece ótimo! Vamos logo preparar a Bolinha de Arroz para a Senhorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330710,
