			"dialogs": [
				{
					"id": 220330301,
					"content": "Ah!!! Isso mesmo! É o sabor da minha terra que só aparece no meu sonho... Estou muito emocionada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330302,
					"content": "Muito obrigada! Estou muito mais animada com essa comida saborosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330303,
					"content": "Tome isto como recompensa, e boa viagem para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
