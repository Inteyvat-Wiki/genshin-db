					"content": "Não é estranho, mas estranhíssimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330603,
					"content": "A sua técnica de culinária está longe de ser comum. Hehe..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330604,
					"content": "Bom trabalho, Viajante. Tome isto como recompensa, e depois darei mais uma experimentada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
