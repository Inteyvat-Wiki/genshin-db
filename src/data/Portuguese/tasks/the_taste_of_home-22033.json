					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330707
					]
				},
				{
					"id": 220330707,
					"content": "Hehe. Sem problema, confie em Paimon! Escolha um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330708,
						220330710,
						220330712,
						220330714
					],
					"speakerTitle": "Paimon"
				},
				{
