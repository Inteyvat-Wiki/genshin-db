			"dialogs": [
				{
					"id": 220330201,
					"content": "#Já voltou tão rápido? Você também é {M#um}{F#uma} chef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330202,
					"content": "Hum... Mal posso esperar, deixe-me dar uma provada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330203,
					"content": "Sirva-se!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "Deixe-me pensar... Quais pratos do que estávamos falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "Ah sim... Bolinha de Arroz, Bolinho de Flor Lótus e Dango de Três Cores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330206,
					"content": "Vamos decidir e entregar para a senhorita Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
