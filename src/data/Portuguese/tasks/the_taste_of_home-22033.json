					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330702,
					"content": "Deixe-me ver... Meu lanche favorito ultimamente tem sido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330703
					],
					"speakerTitle": "Paimon"
				},
				{
