			"dialogs": [
				{
					"id": 765040701,
					"content": "#Olá, {NICKNAME} e Paimon. Vocês já comeram? Vocês têm algum compromisso especial hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Entendido. Caminhar e capturar o que você vê no quadro é uma boa maneira de relaxar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "Porem, não consigo detectar nenhum Aparelho Fotográfico em você. Você o deixou em algum lugar na pressa de sair de casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "E procurando algum material para fotos enquanto estamos nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
