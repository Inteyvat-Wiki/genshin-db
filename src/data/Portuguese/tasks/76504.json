			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#Olá, {NICKNAME} e Paimon. Vocês já comeram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? O que você está fazendo aqui no telhado? Você está... observando as formas das nuvens para calcular a probabilidade de chuva... ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Estou realizando uma tarefa que está apresentando um... desvio inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "O plano original era comprar uma \"engrenagem de alta precisão\" e um \"parafuso hexagonal especial\", conforme estipulado na lista de Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "No entanto, eu encontrei um... incidente imprevisível que interrompeu o fornecimento durante a viagem de volta. Um falcão, voando a alta velocidade, arrancou das minhas mãos o parafuso especialmente fabricado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "Então você subiu ao telhado para procurar o tal falcão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Afirmativo. Os hábitos dessa espécie indicam uma propensão a usar telhados como pontos de parada temporários. Resposta: Análise visual e auditiva compreensiva. Objetivo: localizar o alvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "No entanto, até agora não encontrei nenhum rastro do meu alvo. Dedução inicial: o alvo escapou do raio de detecção ou pode ter levado o seu \"prêmio\" para um ninho mais isolado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Iniciando plano reserva: Retorne ao fornecedor designado e adquira um parafuso do mesmo modelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "#De qualquer forma. Vocês {M#dois}{F#duas} também estão aqui a procura de algum animal pequeno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Oh, não, nada disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Sim. Originalmente, queriamos encontrar um lugar com uma boa vista para poder tirar algumas fotos panorâmicas da Cidade de Nasha em toda sua glória agitada e movimentada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "Não esperávamos te encontrar enquanto você estava atrás de um ladrão. Acho que isso também é um \"desvio inesperado\" super raro, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Bem, já que a oportunidade apareceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Sim. Indique a posição preferida, a orientação e a expressão facial recomendada. Farei o meu melhor para cumprir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "Estimativa: As chances de eu subir no telhado, encontrar vocês e ter minha foto tirada por vocês são ainda menores do que as chances do falcão me devolver o parafuso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Portanto, certifique-se de capturar com precisão essa \"surpresa agradável\" rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Podemos tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Estamos apenas procurando algum material para fotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
