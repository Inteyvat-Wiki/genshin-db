			"trigger": {
				"objectNames": [
					"Asagiri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 725010201,
					"content": "Por que a Srta. Moriko sempre me dá comissões tão estranhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010202,
						725010203
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010202,
					"content": "Você ainda está desenhando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010203,
					"content": "Você está sem inspiração de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010204
					]
				},
				{
					"id": 725010204,
					"content": "Ah, Viajante! O que traz você aqui? Já faz algum tempo, imaginei que você teria viajado para outros lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010205
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010205,
					"content": "*Suspiro* Eu gostaria tanto de estar em condições melhores. Eu queria poder viajar livremente como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010206
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010206,
					"content": "Assim, não precisaria aguentar a Srta. Moriko me cobrando coisas do trabalho todos os dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010207
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010207,
					"content": "As minhas ilustrações foram muito bem recebidas da última vez. Muitos escritores estão requisitando os meus trabalhos desde então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010230
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010230,
					"content": "Apesar de a Srta. Moriko ter rejeitado muitos trabalhos meus, ainda há muitas comissões sobrando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010208,
					"content": "Além disso, os escritores que a Editora Yae tem contratado estão cada vez mais criativos com os seus temas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010209
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010209,
					"content": "Eu pensava que além de Inazuma, Mondstadt e Liyue eram os cenários mais distantes que eles iriam em suas histórias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010210
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010210,
					"content": "Eles agora escrevem sobre protagonistas que se aventuram em Sumeru, e até em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010216
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010216,
					"content": "Bom, chega de reclamar. Viajante, seu Aparelho Fotográfico ainda está funcionando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010217,
						725010218
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010217,
					"content": "Está funcionando bem, sim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010218,
					"content": "Você quer que eu tire mais fotos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010219
					]
				},
				{
					"id": 725010219,
					"content": "Bem, o pagamento da última vez foi bem justo, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010220
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010220,
					"content": "Então, Viajante, por favor, tire mais fotos ao redor do mundo para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010221,
						725010224
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010221,
					"content": "*Suspiro* Está bem, deixa comigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010222
					]
				},
				{
					"id": 725010224,
					"content": "Você sabe que basta publicar uma Comissão na Guilda de Aventureiros, não sabe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010225
					]
				},
				{
					"id": 725010222,
					"content": "Conto com você, então! Hehe, meu caderno já está pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010223
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010223,
					"content": "Se você não tivesse aparecido, eu teria pedido que a Srta. Moriko procurasse por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010225,
					"content": "Ah! De jeito nenhum! Por favor, por favor, me ajude! Eu publiquei Comissões, mas não consegui achar ninguém capaz de usar o Aparelho Fotográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010226
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010226,
					"content": "Só me ajuda dessa vez, pode ser? Se eu perder outro prazo, a Srta. Moriko com certeza vai bater na minha porta e ameaçar vir morar comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010227
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010227,
					"content": "Meu estômago já está me avisando que não quer mingau de Arroz com Flor de Sakura que ela vai fazer! Viajante, minha vida está nas suas mãos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725010228
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 725010228,
					"content": "Tudo bem, pode deixar comigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725010229
					]
				},
				{
					"id": 725010229,
					"content": "Ufa... Que alívio. Espere um pouco, deixe eu procurar meu caderno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				}
			]
		}
	]
}