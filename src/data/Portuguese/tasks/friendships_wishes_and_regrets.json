			"dialogs": [
				{
					"id": 111120801,
					"content": "#Meus agradecimentos a vocês {M#dois}{F#duas}, isto parece estar ótimo. Por favor, esperem um momento, este é o passo final.",
					"roleType": "TALK_ROLE_NPC",
