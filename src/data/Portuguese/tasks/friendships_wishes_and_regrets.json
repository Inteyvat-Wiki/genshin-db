				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Isso se agravou depressa. Não tenho mais certeza do que está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Eu também não esperava esbarrar no Grande G assim sem mais nem menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "Na verdade, não estou nem um pouco surpresa. Lembra-se do que eu disse? Há apenas alguns espíritos malignos neste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120105,
					"content": "Foi uma reviravolta do destino que o levou a deixar a Colina de Wuwang em primeiro lugar. Agora, por alguma razão, ele não pode voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120106,
					"content": "Esta explicação me soa um pouco forçada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "Na verdade... Ela praticamente resumiu a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120108,
					"content": "Ei?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Hehe, nunca questione meu profissionalismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120110,
					"content": "Eu só queria checar meus amigos. Foi por isso que vim ao Porto de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120111,
					"content": "Prometo não ter feito nenhuma travessura! Eu nunca quis assustar ninguém!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120112,
					"content": "Há alguns dias, algumas pessoas vieram a Colina de Wuwang em um desafio. Os ouvi dizer que tinham vindo do Porto de Liyue, então eu segui um deles de volta e acabei aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120113,
					"content": "Aha, deve ter sido o pobre Luocheng que você seguiu. Talvez ele não tenha reparado em você, mas ainda podia sentir sua presença. Agora sabemos o que causou seus pesadelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120114,
					"content": "Hã? E-Eu fui descoberto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120115,
					"content": "Suponho que sim, caso contrário ele não teria morrido de medo daquele jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120116,
					"content": "Por que você não veio mais cedo à procura do Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Sim, Hutao e Tio Meng estavam procurando por você em toda parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Oh, isso é porque eu não conseguia encontrá-los. É a primeira vez que estou no Porto de Liyue e me perdi na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120119,
					"content": "Agora que você mencionou isso, o Grande G sempre teve um péssimo senso de direção. Quando éramos crianças, ele nunca descia a colina sozinho, sempre tivemos que guiá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Tio Meng"
				},
				{
					"id": 111120120,
					"content": "Então tudo isso foi só porque você se perdeu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Por que você simplesmente não voou como qualquer outro fantasma ou espírito? Você não acha que é muito mais fácil encontrar seu caminho lá de cima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "Eu... Não posso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120123,
					"content": "É muito alto para mim, fico com medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120124,
					"content": "Isso mesmo, sim, ele costumava ter tanto medo de altura que nem sequer descia a colina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Tio Meng"
				},
				{
					"id": 111120125,
					"content": "Hahaha, você não mudou nem um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Tio Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Eu sabia que não deveria me manifestar aos vivos, e com tantas pessoas andando pelo Porto de Liyue, minha única opção era me esconder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120129,
					"content": "Eu não o teria encontrado se não fosse a convocação do Monolith de Linhas Ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120130,
					"content": "Estou tão aliviado por você não ter se tornado um espírito maligno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Tio Meng"
				},
				{
					"id": 111120131,
					"content": "Nunca duvide do meu julgamento profissional. Agora, tudo o que temos que fazer é escoltar esta criança perdida de volta para a Colina de Wuwang, e devemos estar resolvidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120132,
					"content": "Mas ele acabou de dizer que queria visitar seus amigos. Além de mim, há também o Pequeno Wu, Mumu e Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Tio Meng"
				},
				{
					"id": 111120133,
					"content": "Bem... Se for esse o caso, não podemos desapontá-lo. Vamos pedir a todos eles que nos ajudem a preparar uma cerimônia de despedida do Grande G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120134,
					"content": "Meng e eu vamos escoltar o Grande G de volta para a Colina de Wuwang. Você se encontra com esses três e lhes pede lembranças para simbolizar cada um deles durante o ritual, depois venha e nos encontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120135,
					"content": "Todos eles são amigos, não podemos simplesmente ir lá todos juntos? Ou talvez possamos levar o Grande G até eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Hum... Não é uma boa ideia. Eu não quero assustá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Grande G"
				},
				{
					"id": 111120137,
					"content": "Eu não gostaria que o povo comum se tornasse supersticioso. Quanto menos eles souberem, melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120138,
					"content": "Portanto, tenha cuidado com o que você diz quando coletar as lembranças!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hutao"
				},
				{
					"id": 111120127,
					"content": "Talvez \"Grande G\" não seja o melhor nome para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "Então o Grande G não é um espírito maligno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeno Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Olá! Você lembra da gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Você... Desculpe, eu não vou precisar dos serviços da funerária tão cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120203,
					"content": "Meng nos contou a história dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Sim, Tio Meng e eu crescemos juntos. Ainda mantemos contato até hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120206,
					"content": "Não sei porque ele começou a trabalhar para a Funerária de Wangsheng. Para ser honesto, acho a diretora deles bastante peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120207,
					"content": "Mas ele deve ter tido seus motivos. Afinal, ele está por conta própria agora, e ainda não consegue superar o que aconteceu com o Grande G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120208,
					"content": "Ele lhe falou sobre isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120209,
					"content": "Sim, ele disse. Se você pudesse escolher uma coisa para dar ao Grande G como lembrança, o que escolheria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "#...Só que, teoricamente falando. Estamos sendo apenas hipotétic{M#os}{F#as} aqui, definitivamente não vamos comemorá-lo nem nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Isso foi um pouco óbvio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120214,
					"content": "Eu cozinharia algo para ele. Ele podia comer comida apimentada como nenhum de nosso grupo podia. Sua refeição favorita era o Frango de Pimenta de Jueyun extra picante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120215,
					"content": "Posso fazer isso para você se me trouxer algumas Pimentas de Jueyun.",
					"roleType": "TALK_ROLE_NPC",
