						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "Relembrar os velhos tempos, pensando em eventos passados... Estamos nisto há anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120503,
					"content": "Nossa cidade natal foi completamente destruída em um desastre, por isso não temos para onde voltar. Agora, o lar é onde quer que estejam os amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "Eles acabaram de me dizer que você está procurando por lembranças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120505,
					"content": "Eu faço Lanternas Celestes no Porto de Liyue. Acho que elas me representam melhor do que tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120506,
					"content": "Há alguns dias atrás comprei alguns Fragmentos de Plaustrite de qualidade, atualmente todos eles estão no armazém no cais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120507,
					"content": "Já falei com o gerente, posso te pedir para ir buscá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120508,
					"content": "#Parece que já está tudo esclarecido. {NICKNAME}, vamos voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
