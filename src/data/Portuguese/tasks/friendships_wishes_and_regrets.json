					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "Obrigada, nós o passaremos adiante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120811,
					"content": "O Grande G tem muita sorte de ter amigos como vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120809,
					"content": "E eu não vou pressioná-lo sobre \"as coisas de que você falou uma vez\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
