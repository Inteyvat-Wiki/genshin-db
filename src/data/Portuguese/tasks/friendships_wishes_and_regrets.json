						111120802
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120802,
					"content": "Pronto, aqui está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120803,
					"content": "Eu escrevi todos os nossos cinco nomes dentro da lanterna. Sabe, durante o Ritual de Lanternas, todos nós soltamos uma lanterna como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120804,
					"content": "Não importa o que os dias possam trazer, quaisquer que sejam as estradas que escolhemos tomar... Enquanto este ritual permanecer cumprido, cada um de nós permanece o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120805,
					"content": "Quanto à questão do Grande G, nós três já discutimos entre nós e concordamos que não vamos pressionar vocês sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120806,
					"content": "Mas se você tiver a chance, por favor, avise a ele que... Estamos indo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120807,
					"content": "E que as coisas de que uma vez falamos, todas elas aconteceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120808,
					"content": "Você pode contar com a gente.",
