			},
			"dialogs": [
				{
					"id": 111120301,
					"content": "Ótimo, isso deve ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120302
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120302,
					"content": "Vou começar com o Frango de Pimenta de Jueyun. Imagino que você tenha outras pessoas para procurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120303
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120303,
					"content": "Quando todos estiverem prontos, eu levarei a comida até você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120304
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
					"id": 111120304,
					"content": "Ótimo! Até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120305
					],
					"speakerTitle": "Paimon"
