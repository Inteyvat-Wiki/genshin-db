					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Urg... Você de novo não. Já lhe disse, não estou interessado no funcionamento do interior da Funerária de Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Meng nos contou sobre você, vocês são bons amigos, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "Isso é verdade, sim. Pensando bem, eu me lembro que ele se juntou recentemente à Funerária de Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "Não demorou muito tempo para que seus bons amigos descobrissem o porquê... O incidente do Grande G.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Mas eu sei que não há nada que possamos dizer para ajudá-lo a superar isso. Deixar o passado para trás é um processo doloroso. Eu sei bem disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Então, o Grande G é o motivo que você veio me ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "Como você soube!? Nós nem falamos nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Haha, eu também sou um homem de negócios, sabe, não posso sair contando meus segredos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Todos ouvem o nome \"Mumu\" e acham que eu devo ser insensato, nunca calaram a boca quando montei a loja. Mas... Eu diria que provei que algumas pessoas estavam erradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "Pegue isto, é uma caixa de brinquedos de primeira linha que todos nós sonhávamos em ter quando criança. Naquela época, nenhum de nós podia arcar com isso, não tínhamos um tostão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Hoje, os negócios estão prosperando. Acabei comprando muitos destes. Era um sonho tornado realidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "Uau, você deve ser tipo, super rico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Haha... Para mim, é uma lembrança de infância há tempos passada. Sem ela, não estaríamos onde estamos hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Então, tendo me encontrado, suponho que você estará procurando o Pequeno Wu e a Congzi a seguir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "Uhum! Já vimos o Pequeno Wu, agora temos que encontrar a Congzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Entendo. Se é da Congzi que você anda atrás, vamos nos encontrar no viaduto da Encosta de Feiyun. É logo acima da escadaria que leva à doca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "Tenho um compromisso a cumprir, irei te procurar assim que eu terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
