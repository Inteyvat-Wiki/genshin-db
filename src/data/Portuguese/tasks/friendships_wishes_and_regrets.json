					"content": "Tenho certeza que ele apreciará o sabor de seus tempos de infância. Eu ainda uso essa velha receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Pequeno Wu"
				},
				{
