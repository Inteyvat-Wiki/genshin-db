			"trigger": {
				"objectNames": [
					"Mulher Crente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Agora eu sempre sinto que todo dia está cheio de esperança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Mulher Crente"
				},
				{
					"id": 111000502,
					"content": "Sobre o Ladrão de Estrelas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "#Vocês também são discípul{F#a}{M#o}s do Ladrão de Estrelas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Mulher Crente"
				},
				{
					"id": 111000504,
					"content": "Eu choro todos os dias desde que meu noivo partiu sem dar adeus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Mulher Crente"
				},
				{
					"id": 111000505,
					"content": "Depois eu tentei usar a Arte de Adeptus: queimar o seu retrato, e soprar a cinza para o mar ao nascer do sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Mulher Crente"
				},
				{
					"id": 111000506,
					"content": "Eu tenho um pressentimento de que ele vai voltar em breve... É verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Mulher Crente"
				},
				{
					"id": 111000507,
					"content": "Por isso, eu ofereci todos os meus dotes ao Ladrão de Estrelas. Sem a sua ajuda para encontrar o meu noivo, nunca teria chance de usá-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mulher Crente"
				}
			]
		},
