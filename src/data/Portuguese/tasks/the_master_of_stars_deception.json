							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladrão de Estrelas, Senhor Celestial"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "Então? Os discípulos podem ser um pouco exagerados, mas são sinceros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000802,
					"content": "Eu diria que é tudo fruto da imaginação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Hahaha... Você me faz rir. Havia um Adeptus, Xue Wuliang, os humanos o chamavam de Liangzi, ele disse uma vez——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000804,
					"content": "\"Tudo está conectado, a mente, a alma e o corpo possuem uma relação de causalidade...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000805,
					"content": "Quer dizer, todos os desejos estão a caminho de ser realizados! Entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000806,
					"content": "Não estou entendendo nada... De qualquer forma, os seus desejos irão ser todos realizados, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Certo. Sua percepção é muito boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000808,
					"content": "Ainda tenho uma pergunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Uh? Pode perguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000810,
					"content": "Por que você usa uma máscara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Eu... Viajo pelo mundo inteiro, ajudo os vulneráveis sem mostrar a minha identidade, tudo isto é para evitar problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000815,
					"content": "Ooh, Paimon entende agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "#Agora, quais são os desejos de vocês {F#duas}{M#dois}?",
