			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Comerciante Crente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "Já que o Ladrão de Estrelas está aqui, será que todos os Millelith podem ser dispensados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Comerciante Crente"
				},
				{
					"id": 111000602,
					"content": "Sobre o Ladrão de Estrelas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Eu sou um comerciante, minhas novas mercadorias são muito valiosas, pedi a ajuda do Ladrão de Estrelas para me acompanhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Comerciante Crente"
				},
				{
					"id": 111000604,
					"content": "Eu vi que o Ladrão de Estrelas lançou um feitiço, e os monstros todos correram, não sobrou uma sombra na estrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Comerciante Crente"
				},
				{
					"id": 111000605,
					"content": "Não foi barato, é claro... Mas solicitar os serviços de um deus é algo monumental - basta olhar para o Ritual de Descensão! Posso aceitar, mas duvido que a maioria das pessoas fora de Liyue esteja disposta a fazer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Comerciante Crente"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
