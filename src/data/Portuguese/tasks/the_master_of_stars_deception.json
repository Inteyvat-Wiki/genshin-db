			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Homem Crente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Você viu a magia do Ladrão de Estrelas? Ele realmente é muito poderoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Homem Crente"
				},
				{
					"id": 111000402,
					"content": "Certamente há esperança para a doença de meu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Homem Crente"
				},
				{
					"id": 111000403,
					"content": "Sobre o Ladrão de Estrelas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Sem dúvida ele é um Adeptus de verdade, visto que ele domina essas magias dos Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Homem Crente"
				},
				{
					"id": 111000405,
					"content": "Antes eu pedi uma receita de medicina para o meu pai doente, que é totalmente diferente que a receita passada pelo Chalé de Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Homem Crente"
				},
				{
					"id": 111000406,
					"content": "Depois de fervido, soltou uma névoa, parecia algo bem Adeptus para mim! Mas também pode ter sido causado porque tinha Flor da Neblina dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Homem Crente"
				},
				{
					"id": 111000407,
					"content": "O remédio do Adeptus é ótimo, meu pai está melhorando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Homem Crente"
				},
				{
					"id": 111000408,
					"content": "Você tem que fazer alguns sacrifícios se quiser obter a ajuda de um Adeptus como o Ladrão de Estrelas. Dei-lhe algumas antiguidades como oferendas, mas a vida de pai é muito mais valiosa do que isso, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Homem Crente"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
