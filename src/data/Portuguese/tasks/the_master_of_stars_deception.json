			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Ei, {NICKNAME}... É apenas Paimon, ou há algo de estranho naqueles Hilichurls ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Seu corpo está emitindo... Uma energia maléfica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Sim, apesar de serem monstros, os Hilichurls que encontramos antes nunca estiveram assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "Ah! O Albergue Wangshu é ali perto, será que podem ir ameaçar os hóspedes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Agora que vimos isso, se não fizermos nada, a Paimon se sentirá muito culpada... Vamos lidar com eles, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Um tanto agitados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "Certo! Talvez tenha algo a ver com aquela... energia escura que estão emitindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
