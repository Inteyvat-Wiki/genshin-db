					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111001010,
					"content": "*Cof, cof*... Eu sou o Adeptus conhecido pelos meus seguidores como Ladrão de Estrelas.",
