					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Eu sou Paimon! Ess{F#a}{M#e} é {F#a minha}{M#o meu} companheir{F#a}{M#o} de viagem, {NICKNAME}.",
