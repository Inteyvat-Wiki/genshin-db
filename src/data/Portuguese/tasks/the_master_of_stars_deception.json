					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000825,
					"content": "Bem, falta alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
