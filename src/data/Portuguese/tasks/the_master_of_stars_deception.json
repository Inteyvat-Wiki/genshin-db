					"content": "Falta alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "Os Adepti dependem da percepção, mas parece que vocês não estão entendendo o que quero dizer, desta forma, não posso ajudá-los.",
