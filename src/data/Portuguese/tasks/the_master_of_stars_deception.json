					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000817,
					"content": "#Quero saber o que aconteceu com {F#meu irmão}{M#minha irmã}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Hmmm... Eu sinto uma dor terrível em seu passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111000824,
					"content": "Está bem, eu gostaria que você pudesse realizar esses desejos, mas como isso não é possível...",
