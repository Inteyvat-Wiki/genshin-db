					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111001011,
					"content": "#Desci para ajudar os meus seguidores e encontrei vocês {F#duas}{M#dois}, era o nosso destino. Se vocês tiverem desejos, podem me contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111001012,
					"content": "Desejos? Você, também pode realizar os nossos desejos? Sério? Eu achava que os Adepti só eram bons em lutas.",
