			"dialogs": [
				{
					"id": 761360301,
					"content": "(Talvez <color=#FFCC33FF>Jahoda</color> queira inspecionar o baú...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Hehehe... vamos ver quanto ganhamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "Eu lembro da Chefe dizer que queria me dar um bônus. Que tal eu ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "Hã? Cadê o dinheiro? Só tem uma folha de papel aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "\"Minha cara Jahoda, seu bônus não vem dessa caixa. Feche ela corretamente depois.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "Pff, a chefe tá tentando me dar um susto de novo. Talvez tenha um compartimento escondido dentro dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "Não tem compartimento secreto nenhum aí. Seu bônus está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360308,
					"content": "Oh, obrigada, chefe. Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "Ai, ai, ai, ai, ai! Aaaaai! Chefe! Eu tava só contando o caixa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "Eu vou voltar pro trabalho agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Alto aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360312,
					"content": "Sim, Chefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Feche a caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360314,
					"content": "Sim, Chefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360315,
					"content": "Agora você pode ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Nefer"
				},
				{
