			"dialogs": [
				{
					"id": 752570701,
					"content": "Ufa, essa foi a última! Vocês realmente me salvaram. Se não fosse sua ajuda, talvez eu já estivesse ouvindo um sermão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "#Haha, não precisa agradecer. Somos aventureir{F#as}{M#os} prestativ{F#as}{M#os}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "#Aventureir{F#as}{M#os}? Que tal eu tirar uma foto de vocês? Vamos capturar esse seu espírito prestativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Vamos, sorriam! Natlan tranquila em um verão tranquilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Obrigada mais uma vez. Por favor, fiquem com isso em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
