			"dialogs": [
				{
					"id": 752570801,
					"content": "A última ficou perfeita! Finalmente, esse belo jovem aqui, que tipo de foto você tem em mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Ora, obrigado pelo elogio! Desde que nasci, sempre valorizei uma boa postura e modos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Sem boas posturas, falta elegância. Sem bons modos, falta refino. Entendem o que digo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
