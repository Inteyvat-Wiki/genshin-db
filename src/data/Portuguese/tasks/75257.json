				"objectNames": [
					"Yiztli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "Parece legal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "Fantástico! Certo, quem quer começar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570203,
					"content": "Eu sugiro que as moças vão na frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570204,
					"content": "Por mim tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570205,
					"content": "Oh, que cavalheiro! Na verdade, eu adoraria tirar uma foto com jovens como vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570206,
					"content": "Hã? Certo, tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570207,
					"content": "*Cof* Tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570208,
					"content": "Hmm... espere, isso não é o bastante. Eu também gostaria de adicionar mais três jovens. Você pode cuidar disso, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570209,
					"content": "Oh, e talvez alguns fogos de artifício? Eu adorava esse tipo de atmosfera quando tinha sua idade, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570210,
					"content": "Sem problemas. Vamos nessa, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
