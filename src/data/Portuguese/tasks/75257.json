			"dialogs": [
				{
					"id": 752570101,
					"content": "Jovem, esse local parece estar em boas condições. Por que ele não está aberto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Ah, eu sinto muito. Infelizmente, o decorador de nosso palco ficou bêbado, e não conseguiu vir para o trabalho hoje. Você se importaria de retornar amanhã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Oh céus, estou velha demais para voltar esse caminho todo amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Sim, e temos outros planos para amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Lamentamos muito. Toda a ideia desse Estande Fotográfico de Verão é criar um plano de fundo personalizado para cada cliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Mas, sem nosso decorador, não podemos fazer isso acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Posso ajudar em algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "#Mesmo? Vocês estão dispost{F#as}{M#os} a ajudar? Isso seria incrível! Não é complicado, vocês só precisam configurar os panos de fundo de acordo com os requisitos dos clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
