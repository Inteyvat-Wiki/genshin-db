			"dialogs": [
				{
					"id": 752570301,
					"content": "A última saiu perfeita! Agora é a vez desse grandalhão Fatui, que tipo de foto você tem em mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Por favor, quero parecer um franco-atirador. Sabe, aqueles que as pessoas veem uma vez, e sabem que nunca erro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Assim não vou precisar me preocupar em me classificar nas posições finais na competição de tiro ao alvo das tropas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "Sem problemas. Vamos nessa, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
