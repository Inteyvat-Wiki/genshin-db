						4860514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860514,
					"content": "Sara e Charles também precisam de nossa ajuda com urgência. Vamos ver a Jean primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860515,
					"content": "Você está indo ver a Jean? Que coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860516
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860516,
					"content": "Pensava que você estava procurando um gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860517,
					"content": "Sim, eu queria ver se a Jean poderia ajudar a procurar o meu gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860518
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4860518,
					"content": "Sério? Você quer que a Jean lhe ajude a procurar o seu gato?",
