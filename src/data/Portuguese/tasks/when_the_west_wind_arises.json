					"nextDialogs": [
						4860815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860815,
					"content": "A Jean tem muito trabalho para fazer. Seria muito bom ter mais assistentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860816
					],
					"speakerTitle": "Barbara"
				},
