			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "Tem alguma coisa de errada, Sara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "Desculpe, mas eu já comi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "Ah, finalmente, te encontrei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860205,
					"content": "Não estou aqui para fazer promoções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860206,
					"content": "Tem uma coisa que eu gostaria que os Cavaleiros de Favonius fizessem por mim e eu gostaria que você passasse minha solicitação à Grande Mestre Intendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860207,
					"content": "Então você veio procurar a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860209,
					"content": "Somos companheiros de confiança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "Bem, ouvi falar que ela tem muito respeito a você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "#Eu sou {F#uma servente}{M#um servente} leal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "Oh, você conhece bem a Mestre Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860210,
					"content": "Sério? Deve ser uma boa sensação saber que Jean está nas suas costas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860212,
					"content": "Bem, eu ouvi dizer que ela tem muito respeito por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860214,
					"content": "Servente? Não sabia que algo tão antigo ainda existe nos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860215,
					"content": "#Desculpe, {NICKNAME}tem um senso de humor estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860216,
					"content": "...Enfim, o que você queria dizer a Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860217,
					"content": "Ah, sim... devo me desculpar por não poder visitar os Cavaleiros pessoalmente, mas o restaurante está tão ocupado ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860218,
					"content": "Infelizmente, é exatamente nesse período movimentado que a rota entre aqui e o Vale Termal, usada para a entrega de nossos ingredientes, parece ter sido ocupada por Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860220,
					"content": "Então, você quer que os Cavaleiros limpem o caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "Já entendi, você quer dar uma lição para aqueles caçadores!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "O problema é que os caçadores no Vale Termal dizem que as entregas não têm nada a ver com eles, eles são apenas responsáveis pela caça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860221,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860223,
					"content": "O quê? Não! Como que isso vai nos ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860225,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "Por favor, <color=#00E1FFFF>pergunte a Mestre Jean</color> para enviar uma equipe para eliminar os Hilichurls na rua do Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860226,
					"content": "Pff, finalmente ajuda. Com a Jean no caso, isto será resolvido em pouco tempo. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860227,
					"content": "Parece que todos realmente confiam na Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860228,
					"content": "Oh! Parece que o <color=#00E1FFFF>Charles, aquele bartender</color> também tem alguns problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860229,
					"content": "Por que vocês não aproveitam e vão junto com ele dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4860230,
					"content": "Bem, o estilo da Paimon é ajudar as pessoas até o fim... apesar de não parecer ser um caminho fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charles"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "O que você pensa que é aqui? Uma loja de sucos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860302,
					"content": "Hunf! Que rude! E de pensar que viemos ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860303,
					"content": "Ajudar? Oh! Vocês são estrelas principais da Grande Mestre Intendente, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860304,
					"content": "Hum... Isso é estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860305,
					"content": "Excelente! Por favor peçam o relatório trimestral de imposto a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860306,
					"content": "Afinal chegou a hora de pedir ao Elzer fazer a contabilidade... Porém, a taxa de impostos do álcool em Mondstadt é bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860307,
					"content": "Você realmente precisa envolver a Jean em coisas como essa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "E ainda assim, a Adega do Alvorecer segue fazendo muito dinheiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "Graças ao Senhor Diluc, ele tem um bom modelo de negócio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860310,
					"content": "Por que a conta está com a Jean? Ela também faz contabilidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860311,
					"content": "Todas as contas são verificadas pela Grande Mestre Intendente Jean pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860312
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860312,
					"content": "Afinal de contas, a indústria de vinho é a principal fonte de receita de Mondstadt. A Jean se esforça para garantir que nenhum detalhe passe desapercebido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860313
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860313,
					"content": "O trabalho da Jean é mais duro do que eu imaginava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4860314,
					"content": "O trabalho duro da Grande Mestre Intendente realmente torna nossas vidas mais fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860315
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4860315,
					"content": "Certamente temos muita sorte, mas... para ser franco, nós apenas assumimos que essa é a norma agora.",
