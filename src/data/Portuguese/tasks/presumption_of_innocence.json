			"dialogs": [
				{
					"id": 200230301,
					"content": "Olá? Como posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230302,
					"content": "Me conte sobre o Nimrod.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "Ele está bebendo já faz algumas horas. Olha, aqui está a comanda dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "Se continuar assim, vamos ter que acabar chamando a Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "Emprestar? Eu acho que não faz mal nenhum nisso, mas por que você precisa disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
