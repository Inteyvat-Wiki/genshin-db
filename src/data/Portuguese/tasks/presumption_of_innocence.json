			"dialogs": [
				{
					"id": 200230401,
					"content": "Você já foi ver como ele está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230402
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230402,
					"content": "Essa é a conta de Nimrod da Taverna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "Hunf. Exatamente como imaginei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230404,
					"content": "As pessoas esquecerão tudo o que aconteceu no passado, a menos que tenham realmente sofrido por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230405,
					"content": "Por favor, aceite isto para lhe retribuir pelo seu transtorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230406,
					"content": "E quanto ao pagamento de Nimrod... Vou pensar no caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
