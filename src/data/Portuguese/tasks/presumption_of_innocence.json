			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Do que ele se arrependeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "Se arrepender do quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Muitas pessoas vêm aqui diariamente para confessar seus pecados e pedir por perdão aos deuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Mas, se você apenas disser da boca para fora e não agir, não acha que seria uma perda de tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Veja o Nimrod como exemplo. Ele vem aqui para confessar seu pecado com o álcool diversas vezes, mas ele nunca mudou em nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Se você tiver tempo, poderia dar uma olhada para ver como ele está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "E se ele estiver bebendo de novo, por favor, traga alguma prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "Oh, para esses tipos de pessoas, é necessária alguma coisa mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "Beber é um pecado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Beber não é um pecado, mas pode ser um pecado quando você chega ao ponto de perturbar os outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Se todos se comportassem de maneira tão inescrupulosa, mais cedo ou mais tarde toda a cidade de Mondstadt se encontraria em uma situação muito angustiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Portanto, toda vez que um pecado eleva sua cabeça, ele precisa ser cortado pela raiz. Agora, rápido, vá verificar Nimrod para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
		{
			"id": 2002302,
			"completionStepIds": [
				2002302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
