			"dialogs": [
				{
					"id": 745250401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250402,
					"content": "Que cara séria essa sua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "Ah, é você. Não, as investigações de hoje estão completas. Nada de incomum foi encontrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250405,
					"content": "Eu só estava pensando porque aqueles Eremitas pareciam tão desanimados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250406,
					"content": "Talvez uma jornada cansativa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "Eu aposto que eles estão com problemas financeiros. Eremita riqueza, agora é só Eremita pobreza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250409,
					"content": "Que tal algo mais animado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Ah, entendi. Ainda assim, se eu só ficar ali parado, a imagem pode não ter impacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250412,
					"content": "Não se preocupe, eu vou usar Electro. Isso deve Electro-minar, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250413,
					"content": "... Ótimo. Vou fotografar você em ação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "Certo. Conto com você. Não perca o momento crítico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250410,
					"content": "Posso tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Será que falharam em sua missão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Você está caçando por um criminoso?",
