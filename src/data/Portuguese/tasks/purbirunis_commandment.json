			},
			"dialogs": [
				{
					"id": 733480401,
					"content": "Hã? Você voltou? Encontrou a pessoa da Casa de Purbiruni? Acho que não deve ter dado tanto trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Encontrar, encontrei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hã? Por que você está com essa cara de quem não quer me contar tudo? Aconteceu algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Você conta para Khedive sobre Sadife...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Sadife... Ele é conhecido por ser muito obstinado, às vezes até mesmo os professores têm dificuldade em lidar com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "E ele recusou toda ajuda, insistindo na pesquisa sozinho... Disse que queria garantir a pureza de sua pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "Então esse é o significado de \"Dinheiro não pode ser a recompensa da sabedoria\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Esse é um princípio da Casa de Purbiruni... Haha, nós, discípulos de Pursina, não somos tão intransigentes assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Hã... Não acho que podemos dizer isso, é só que nós temos dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "E como você ganha dinheiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "#Por que você está com essa cara de desconfiad{F#a}{M#o}? Eu tive que dar muito duro para ter todo esse dinheiro. Você tem alguma ideia de quanto o mercado de contratos futuros é complicado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "Con... contratos futuros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Para se negociar com contratos futuros, você tem que ficar de olho nas transações de mercadorias, nas flutuações do mercado e pensar na direção que vai investir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Eu só investi um pouco de dinheiro no começo, apenas por diversão, sem intenção de afetar minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Mas, ninguém imaginaria que quanto mais dinheiro eu colocasse no mercado, mais eu ganharia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "Minha profissão principal é ser acadêmico! Eu quero fazer pesquisa, eu quero ser um estudioso! O que eu quero são resultados acadêmicos, não resultados financeiros! Eu sempre me lembro disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Mas sempre que estou dentro da Cidade de Sumeru, acabo indo ao mercado involuntariamente e fazendo negociações uma após a outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Minha fortuna está aumentando cada vez mais, mas não estou fazendo nenhum progresso na minha pesquisa acadêmica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "Então! Aqui estou eu, convidando várias pessoas para entrar no Despenhadeiro e realizar pesquisas por aqui. Só estando em um lugar sem mercado financeiro, posso me concentrar em realizar pesquisas acadêmicas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Se eu não conseguir resultados em minha pesquisa, eu... não sairei do Despenhadeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Você ganha dinheiro com isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Então como você tem tanto dinheiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Mas aconteceram algumas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
