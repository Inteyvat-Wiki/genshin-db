			"trigger": {
				"objectNames": [
					"Dara"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1856.942,
							155.632,
							5478.944
						],
						"pointId": 330700023
					},
					{
						"sceneId": 3,
						"position": [
							-1855.365,
							155.684,
							5479.971
						],
						"pointId": 330700024
					},
					{
						"sceneId": 3,
						"position": [
							-1855.176,
							155.344,
							5478.426
						],
						"pointId": 330700025
					}
				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "Espere! Espere! Pare, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480202,
					"content": "*Ofegante*... É só uma caixa com livros, não precisa dar essa surra. Vamos, é toda sua, pode ficar com ela se quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480203,
					"content": "Só tem isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "Eu juro em nome dos Arcontes! Essa caixa foi tudo que desenterramos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480206,
					"content": "Além dos livros, haviam algumas pedras e garrafas com pedras dentro... E tinham umas gemas bonitas dentro das pedras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480207,
					"content": "Vocês levaram essas gemas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "Ei! Tragam as gemas de volta! Elas são amostras geológicas importantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480209,
					"content": "Amostras... geológicas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480210,
					"content": "Tragam elas de volta. Agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "Sim! Sim! Vamos trazer todas de volta! Rápido, pessoal, coloquem tudo de volta na caixa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480213,
					"content": "Colocamos tudo dentro de volta da caixa, nós vamos embora agora, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480214,
					"content": "O que o Sadife está procurando provavelmente está dentro da caixa, vamos levá-la de volta para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480215,
					"content": "Ele entrou sozinho no deserto, escavou todas essas amostras e fez tantas anotações... Ele é um pesquisador fantástico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480211,
					"content": "Eu vou contar até três.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "Há alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
