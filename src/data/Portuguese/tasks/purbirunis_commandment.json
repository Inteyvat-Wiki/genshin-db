			"dialogs": [
				{
					"id": 733480901,
					"content": "*Suspiro* Eu só tenho isso de dinheiro sobrando? Como vou continuar a minha pesquisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Com licença, desculpe interromper...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Um acadêmico da Casa de Purbiruni? Oh, você está procurando Sadife, que surpresa... Alguém realmente veio procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Ele ultimamente está trabalhando na Academia, você pode encontrá-lo por lá... Mas, por que você está atrás dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "Sobre a Carta de Recomendação de Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive? Ele terminou sua pesquisa? Ah, ter dinheiro é muito bom... poder contratar sua própria equipe de escolta para te acompanhar em sua pesquisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "Enquanto isso, estou eu aqui, sem conseguir me inscrever para ter mais subsídios para minha pesquisa de campo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Você conhece Khedive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Claro, nós acadêmicos, que sempre estamos preocupados com financiamento e não sabemos como ganhar dinheiro, já ouvimos muito sobre a riqueza dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Uau... Então Khedive... Os pesquisadores da casa dele são todos ricos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Então isso quer dizer que a gente vai ganhar um dinheirão?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Não, não. Khedive é uma exceção da regra. Você está confundindo os pesquisadores da Casa de Purbiruni e de Pursina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480914,
					"content": "Especialmente aqueles que se concentram em astrologia, com história e biologia como assuntos secundários... Com essas poucas áreas de pesquisa, se tiverem azar, nem conseguem obter financiamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480915
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480915,
					"content": "E eles também falam algo sobre \"Dinheiro não pode ser a recompensa da sabedoria\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480916
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480916,
					"content": "Ah, eu acho que eu falei demais... Sadife está lá, vá perguntar a ele sobre qualquer outra coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480903,
					"content": "Sobre o estudioso da Casa de Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
