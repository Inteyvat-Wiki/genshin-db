			"dialogs": [
				{
					"id": 733480101,
					"content": "Mas... se eu não tiver esses espécimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "Sobre a Casa de Purbiruni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Sim. Eu sou um Herbad da Casa de Purbiruni. Posso ajudar você com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "É relacionado a algo acadêmico? Pela sua aparência, você não parece ser alguém da Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "Sobre a Carta de Recomendação de Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Esse é... uma carta a punho de Khedive? Um instante, deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Parece que a pesquisa dele no Despenhadeiro está correndo muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "...Investigação de fungos... ambiente aquático... fósseis de organismos antigos... ambiente geológico especial... amostras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Ótimo, fantástico! O olfato acadêmico e habilidades de observação dele estão afiados como sempre! Eu sabia que ele não me decepcionaria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "#Apesar de eu não querer admitir isso na frente de {F#uma}{M#um} forasteir{F#a}{M#o}, mas as habilidades acadêmicas dos discípulos de Pursina são confiáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Além disso, Khedive enfatizou bastante na carta o quanto você o ajudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Com a sua ajuda, a pesquisa dele foi \"tão suave quanto um gato voando pelos ares\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Por favor, isso de novo não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Oh, mesmo? Ahem! Que falta de educação da minha parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Quando ele voltar para a Academia, certamente adicionará uma nova e gloriosa entrada nos registros acadêmicos de Pursina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "Ah, e a amizade milenar entre nossas duas Casas certamente será muito fortalecida também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "Muito bem! Em nome dos Purbiruni e dos Pursina, agradeço mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Oh sim. A carta mencionava algo sobre preparar um presente para você... Só um minuto, está por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Você não vai me dar uma carta de recompensa também, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Oh, mas é claro que não! Você laborou exaustivamente, ajudou Khedive com sua investigação. Mora é nada mais, nada menos, do que a recompensa mais justa pelo seu suor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Mas, eu tenho que pedir seu perdão, pois hoje estou demasiadamente ocupado e não estou com Mora suficiente. Se você não se importar, poderia esperar aqui um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Embora ambos sejam estudiosos muito orgulhosos de suas respectivas Casas, ele é completamente diferente de Khedive, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Você parece ser alguém que... sabe, está com as mãos vazias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "O que você quer dizer? Nós, da Casa de Purbiruni, somos de gerações de acadêmicos, não temos nenhum problema com riquezas materiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "É só que... gastamos a maioria do dinheiro com pesquisa, e o que sobra para o resto... É apertado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Mas isso não nos impede de continuar nossas pesquisas! Pode-se dizer que nossos olhos não são cobertos pela cobiça material, e por isso eles abrem-se para o caminho claro da sabedoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Vou pegar a sua recompensa. Mas antes disso, gostaria de lhe pedir uma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "#Eu li na carta de Khedive que suas habilidades físicas são excelentes e sua experiência em combate é muito rica, fazendo de você um{F#a} aventureir{M#o}{F#a} excepcional e únic{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Se você estiver disponível, poderia me ajudar com algo? Recentemente, eu fui sozinho para o deserto para investigar o ambiente geológico de uma determinada área...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "É porque... Eu não tenho muito dinheiro, por isso não tive como contratar nenhum guarda-costas. Eu pensei que se entrasse e saísse rápido, não haveria risco algum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Mas como a minha sorte não é boa, no meu caminho de volta, fui atacado pelos Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Embora eu tenha conseguido escapar ileso na cidade, a caixa com todas as minhas amostras e anotações foi perdida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Para os comerciantes e Ladrões de Tesouros, essa caixa não vale a pena... Mas para mim, ela é inestimável, insubstituível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "Eu não consegui encontrar nenhum aventureiro disposto a me ajudar... Viajante, você poderia me dar uma mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Posso ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Muito obrigado! Se não fosse por você, eu não saberia o que fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Eu marquei o local onde fui atacado no mapa, aqui. A caixa deve estar por perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Eu já ouvi falar isso antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Com licença, você é o pesquisador Purbiruni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
