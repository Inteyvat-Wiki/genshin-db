			},
			"dialogs": [
				{
					"id": 733480301,
					"content": "Viajante, você voltou! Conseguiu encontrar a minha caixa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Fantástico! Muito obrigado! Fique com essa Carta de Recomendação. Eu sinto muito por ter te dado todo esse trabalho... Por favor, também fique com essa Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "Vocês não disseram que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Hã? Você conhece até essa frase? De fato, na Casa de Purbiruni, há um ensinamento assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "Mas essa frase é apenas usada para nos aconselhar a não vacilar em nossos princípios de estudo devido à Mora ou outras razões externas, em qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Afinal, se um pesquisador coloca o lucro como seu principal princípio acadêmico, então... ele não merece ser um pesquisador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Mas como você trabalhou bastante para mim, eu deveria lhe dar uma recompensa razoável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Obrigado mais uma vez pela sua ajuda. Se você precisar de mim depois, pode ficar à vontade para falar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "\"Dinheiro não pode ser a recompensa da sabedoria\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "Eu trouxe ela de volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
