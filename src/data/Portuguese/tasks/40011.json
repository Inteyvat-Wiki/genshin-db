					"nextDialogs": [
						400110509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110509,
					"content": "É incrível, não importa como você pense nisso. Usar uma carta para nos atrair até aqui e nos desafiar com este tipo de mecanismo... Este tal de Rei-Dodo não é nenhum amador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110510,
					"content": "Me sinto da mesma maneira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "Aw, lá se vai o clima de férias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "Barbara"
