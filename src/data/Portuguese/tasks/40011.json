					"nextDialogs": [
						400110620
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110620,
					"content": "Mas considerando a situação atual de Inazuma, como poderia ocorrer algo assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110621,
					"content": "Uma máquina forasteira abandonada... Esquisito! Alguém o trouxe aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110622,
					"content": "Oh não! O Rei-Dodo não está se movendo mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110623,
					"content": "Klee, talvez o Rei-Dodo esteja cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110624,
					"content": "Certo, certo, Rei-Dodo provavelmente está dormindo. Ele esteve esperando tão pacientemente e então *boceja* - hora de dormir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110625,
					"content": "Vamos com Klee para brincar em outro lugar e voltamos quando o Rei-Dodo acordar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110626,
					"content": "Sério?",
