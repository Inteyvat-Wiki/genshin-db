					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110701,
					"content": "#Cavaleir{F#a}{M#o} Honorável, olhe aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110702,
					"content": "Hã? O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110703,
					"content": "Veja estas pedras empilhadas e pequenas flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110704,
					"content": "Parece que isso é um memorial para alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110705,
						400110706
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110705,
					"content": "Você é muito perspicaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "Ei, você vai me deixar envergonhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110708,
					"content": "Mas a única outra coisa por aqui é aquela máquina com roupas de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110709,
					"content": "Talvez o memorial seja para aquela máquina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110710,
					"content": "Talvez uma vez tenha realizado algum ato que merecesse um memorial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110712
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110712,
					"content": "Tudo o que vimos aqui indica que houve uma vez uma presença humana nestas águas. Ainda assim, não há o suficiente para que possamos inferir que tipo de civilização foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110713,
					"content": "E, até agora, ainda não vimos nenhuma pessoa ou lápide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110714,
					"content": "Mestre Jean, posso ir até lá e dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110715
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110715,
					"content": "Sim, mas tenha cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110716,
					"content": "Ok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110717
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110717,
					"content": "Quantos segredos essas ilhas guardam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "A Klee é muito jovem para ter uma noção adequada do perigo. Viajante, o resto de nós devemos ficar atentos à situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110719,
					"content": "Honestamente falando, eu pensava que essa carta era apenas uma brincadeira no início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110720
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110720,
					"content": "Isso é o que pensávamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110721,
					"content": "Eu também suspeitava disso, mas quem enviaria uma carta de brincadeira dessas a uma criança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110722
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110722,
					"content": "Uma carta que nos orienta a ativar mecanismos em um arquipélago deserto... É bizarro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110723
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110723,
					"content": "Isso me faz pensar se isso não é algum tipo de armadilha planejada há muito tempo. Temos que manter a guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110724
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110724,
					"content": "Senhorita Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110725
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110725,
					"content": "Klee, o que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110726
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110726,
					"content": "Você acha que o Rei-Dodo não quer ver a Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110727
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110727,
					"content": "Por que o Rei-Dodo não iria querer ver você, Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110728
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110728,
					"content": "A Dodoco me ama, e-e eu amo a Dodoco, então o Rei-Dodo jamais pode nós separar. É por isso que o Rei-Dodo não quer ver a gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110729
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110729,
					"content": "*Chora* Klee não quer que ele separe a gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110730
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110730,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110731
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110731,
					"content": "Ei Klee, você sabe o que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110732
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110732,
					"content": "É um Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110733
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110733,
					"content": "Ouvi dizer da minh-, uh, Mestre Jean dizer que a Klee sempre quis brincar com um Harpastum, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110734
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110734,
					"content": "Sim! Klee estava agora mesmo pensando sobre o Ludi Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110735
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110735,
					"content": "Fiz este Harpastum especialmente para a Klee. Agora, todos os dias podem ser o Ludi Harpastum, hee-hee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110736
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110736,
					"content": "Certo~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110737
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110737,
					"content": "A gentileza de uma diaconisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110738
					]
				},
				{
					"id": 400110738,
					"content": "Então, mantenha a cabeça erguida, Klee! Depois que encontrarmos o Rei-Dodo, todos nós podemos ajudá-la a convencê-lo de deixar você e a Dodoco ficarem juntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110739
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110739,
					"content": "Ok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110740
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110740,
					"content": "Vamos dobrar nossos esforços. Temos que encontrar ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110741
					]
				},
				{
					"id": 400110741,
					"content": "Oba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110742
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110742,
					"content": "Deixa com a gente Klee. Esse Dodo-Idiota não pode se esconder para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110743,
					"content": "Mesmo que leve mil anos e mil buscas... Uh, n-nós vamos pegá-lo! Cof...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110744,
					"content": "Mas até lá, vamos dar uma boa olhada ao redor da área!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110706,
					"content": "Essa é a intuição de uma diaconisa, isso sim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				}
			]
