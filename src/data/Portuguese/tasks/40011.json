					"nextDialogs": [
						400110513
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110513,
					"content": "Farei o meu melhor para exercer o mais alto nível de vigilância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "Jean"
				},
