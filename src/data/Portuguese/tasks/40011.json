					"nextDialogs": [
						400110506
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110506,
					"content": "Com todo o arquipélago situado em uma estrutura mecânica, ele poderia ser ativado para elevar cada ilha de embaixo da água.",
