				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Jean",
					"Barbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Ahh... O tempo está tão bom. Ainda parece que Paimon está sonhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "Bom Dia! Uau, o que aconteceu com as roupas de todo mundo!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "Hehe! Então, como estamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110104,
					"content": "Trocamos para nossas roupas de verão! Embora não tenhamos vindo aqui para nos divertir, não queremos perder um lindo dia de verão à beira-mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110105,
					"content": "Is-Isso não parece estranho, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "Roupas tão elegantes e leves definitivamente não combinam comigo... Cof. Perdoe-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "Não, não mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "Sério...? Obrigada, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "A Mestre Jean trouxe propositalmente uma roupa de verão, isso é realmente inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "Oh não, minha irmã mais velha nunca os prepararia ela mesma. Lisa e eu que escolhemos para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110112,
					"content": "Soltar um \"irmã mais velha\" e nem mesmo perceber... Barbara já está bêbada pelo verão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "Roupa de verão... Bem, isso é uma longa história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "Eu pensava que a bolsa que a Lisa deu era para emergências, mas não havia imaginado que dentro dela havia uma roupa de verão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "Todos esses acessórios, também... Definitivamente obra da Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "Todos dos Cavaleiros de Favonius estão sempre tentando que eu tire umas férias. Suponho que me esforço demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "Pessoal, venham aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "Essa é a voz da Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "Tem algo estranho aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "Hã? O que está acontecendo? O que você quer dizer com algo estranho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "Olhe para o oceano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "Viu? Tem algo estranho flutuando na água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "Aquela coisa estreita... Parece ser uma boia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "Mas não vimos nada quando chegamos aqui ontem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110125,
					"content": "Rei-Dodo deve ter colocado ela ali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "Um dispositivo estranho que apareceu da noite para o dia... Algo não está certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "Ele nunca veio à procura da Klee. Isto significa que ele não me reconhece? Ou talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "Talvez ele esteja esperando que eu vá encontrar ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "Existe alguma razão para que a boia tenha aparecido de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110130,
					"content": "Vamos dar uma olhada de perto e descobrir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Certo, não vamos resolver nada se ficarmos adivinhando da terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "Mas está tudo bem de irmos lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110133,
					"content": "Seria melhor ir mais perto da boia e confirmar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
					"content": "É difícil dizer o que estará esperando por nós no mar. Por via das dúvidas, preparem-se para o combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110135,
					"content": "#Quando estiverem pront{F#as}{M#os}, por favor, reúnam-se aqui, e nós iremos junt{F#as}{M#os} para o barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110136,
					"content": "Essa é a nossa Mestre Jean!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "N-Não mesmo. Esse é meu dever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110139,
					"content": "Certo, então, vou confiar os esforços de preparação a todos vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110137,
					"content": "Mesmo com roupa de verão, ela é muito confiável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "Você parece maravilhosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001109",
							"2"
						],
						"stepId": 4001109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "Qual será o significado dessa boia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110202,
					"content": "Sobre o arquipélago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "Estas ilhas estão isoladas do mundo exterior, como um domínio secreto criado pela própria natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110204,
					"content": "#Fomos guiad{F#as}{M#os} aqui pela carta e com a ajuda de Venti e Dvalin. Tudo parece um pouco coincidente demais. Estou um pouco preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110205,
					"content": "Mas, o motivo para eu estar aqui é para proteger todos. Por isso, não se preocupem. Não importa o que aconteça, eu estarei aqui para enfrentar junta com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110206,
					"content": "Sobre a roupa de verão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "Ah... Ro-Roupa de verão, elas... Uh... Isso foi um presente de Lisa. Eu imagino que tenha sido ideia da Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "Jean"
				},
				{
