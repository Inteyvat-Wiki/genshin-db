					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110515,
					"content": "A Paimon e eu também faremos o melhor para exercer o mais alto nível de vigilância.",
