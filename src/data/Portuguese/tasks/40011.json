					"nextDialogs": [
						400110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110505,
					"content": "Antes dos tremores, eu ouvi um som parecido ao de um mecanismo. Na minha opinião, há algum mecanismo gigantesco sob essas águas.",
