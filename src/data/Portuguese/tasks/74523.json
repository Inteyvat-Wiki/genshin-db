			"dialogs": [
				{
					"id": 745230401,
					"content": "O vento tem um toque de sal marinho e o cheiro distante de navios mercantes... e que trazem notícias de velhos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#Como você está, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Há quanto tempo, Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "A Frota Crux está ancorada em Inazuma para reabastecer. Eu decidi aproveitar essa oportunidade para visitar minha terra natal, ver suas paisagens, ouvir seus sons e o vento que sopra aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "Os ventos de Ritou sempre são mais clamorosos que os de outros lugares, misturados com despedidas e reencontros, esperança e confusão... é um lugar onde você pode ouvir muitas grandes histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Você se importa se eu tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Hehe. Tudo no mundo tem sua forma, o vento não é exceção, mas visto por folhas que caem, ondas que sobem e o momento que as roupas remoem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Espero que minha presença lhe permita dar forma a essa força efêmera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Vamos começar então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "Nesse caso, que você escreva o verso que melhor descreve esse momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Só fique como você estava antes e sinta o vento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Eu gostaria de capturar o vento que está soprando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "O que te traz aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
