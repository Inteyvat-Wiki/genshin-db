			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sukhovykh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Com licença! Tenho uma coisa para perguntar a vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Você apresenta o item que obteve anteriormente aos dois Ratniki. Você também conta a eles sobre uma figura estranha, vestida com roupas de Ratniki, que lutou ao seu lado para repelir a Caçada Feroz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "...Será que poderia ser Sigurd? Parece que ele ainda não conseguiu descansar em paz, nem mesmo até agora. Se ao menos eu pudesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Pode parar, Lushne. Esse não é seu fardo para carregar sozinho. Contanto que a Caçada Feroz exista, ele vai continuar lutando contra ela. Tudo que podemos fazer é cumprir nossa missão da melhor maneira possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Então... Esse Sigurd, ele costumava ser membro dos Portadores da Lâmpada, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Sim. Ele era um Portador da Lâmpada formidável e, quando a Caçada Feroz avançou contra Nod-Krai, ele lutou heroicamente até o fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "#Dizem que até feras sem consciência hesitam quando aqueles sinos de alarme tocam, infligindo medo em todos que o escutam... Mas quem diria que a relíquia dele seria encontrada por vocês {M#dois}{F#duas}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Se possível, por favor, levem a relíquia até o túmulo dele. Ele fica perto das ruínas do campo de batalha leste na Ilha Lempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Pode deixar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Obrigado. Que o dia de descanso da alma dele chegue logo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
