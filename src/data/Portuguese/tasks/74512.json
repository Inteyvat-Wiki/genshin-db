				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "Os dados indicam que essa invenção foi um sucesso. Obrigado, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120102,
					"content": "Isso, obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120103,
					"content": "Viu, eu disse que isso daria certo! Com sua genialidade, Frejus, esse negócio de canhão remoto foi facílimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120104,
					"content": "P-Pois é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120105,
					"content": "Nesse caso, vamos começar a nova próxima invenção incrível — e eu tenho uma ideia incrível para uma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120106,
					"content": "O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120107,
					"content": "Que tal um dirigível que pode explorar os céus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120108,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120109,
					"content": "Ou uma broca gigante que pode furar bem nas profundezas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120110,
					"content": "Hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120111,
					"content": "Parece que ela está tentando fazer da vida dele mais difícil de propósito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Isso parece ser um pouco complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Oras, você quem rejeitou a oferta do Instituto três vezes. Tenho certeza de que você consegue fazer coisas que nem mesmo eles conseguem, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120114,
					"content": "É claro. Só digo que vai ser meio complicado, mas não são grandes coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120115,
					"content": "*Suspira* Sabe de uma coisa? Eu não quero mais essas coisas. Voar até os céus ou ir até as profundezas da terra parece entediante. É frio lá em cima e abafado lá embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120116,
					"content": "Compartilho do sentimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120117,
					"content": "Nesse caso, você poderia fazer algo que podemos usar normalmente? Oooh, isso mesmo! Eu adoro dormir até tarde pelas manhãs, então você poderia me fazer uma máquina de café da manhã automática?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120118,
					"content": "Bem, isso parece possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Acho que as sugestões anteriores dela eram intencionalmente impossíveis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "Muito bem, deixe-me pensar como isso pode ser feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120121,
					"content": "Legal! Vou acatar isso como um acordo — e se isso se provar impossível, você apenas terá que me fazer café da manhã no futuro, não é, Frejus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120122,
					"content": "Hã? Que tipo de pedido é esse...? De qualquer forma, você não precisa se preocupar, tenho certeza de que uma invenção tão pequena está em minhas capacidades. Afinal de contas, eu sou um \"gênio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				}
			]
		},
