				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020301,
					"content": "Já a encontrei! É mesmo esta caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Ainda bem que não foi danificada nas explosões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020303,
					"content": "Missão concluída! Vamos trazê-la de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 1050204,
			"completionStepIds": [
				1050207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050207",
							"2"
						],
						"stepId": 1050207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "Vocês finalmente chegaram! Estava farta de esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "Eu pretendia ler um livro para matar o tempo, mas este era apenas um diário ridículo, e não tenho vontade de ler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "Ele caiu da mochila da Klee, então, eu pensei que era sobre algum conhecimento antigo, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "Sei lá. Então, já encontraram a caixa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "Claro! E na forma original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "Que bom! Espere! Por que... está destrancada? Err... está totalmente vazia dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "Hein!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Ah! Bem... é porque eu usei esta caixa para guardar os meus tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "Emprestado!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "Mas já que você quer que eu devolva a caixa, tirei todos os meus tesouros. Por isso está vazia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "Para guardar os seus tesouros?! Então, onde está o objeto original na caixa? Isso é o que eu quero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Oh, você quer o objeto que estava originalmente na caixa? Você deveria ter dito antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "Você não... quebrou, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "Não! Não está nem um pouco quebrado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "*Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "É o livro na sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "O quê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "É... é este livro? Este diário... é da minha mestra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "O que ela quer buscar depois de cinquenta anos... é a história sombria na sua juventude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "Ah! Estou ferrada! Isso explica o motivo de a velhinha não me deixar ver de forma alguma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "Será que estou em apuros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Ah, foi você que disse que queria a caixa, em vez do objeto dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "Não vou me envolver nisso, vou me embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "É uma conclusão emocionante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Hum... Mas se você não disser nada, a sua mestra nunca vai saber que você já leu o diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "De jeito nenhum! A astrologia consegue perceber todas as mentiras. Você já viu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "*Suspiro* Depois de ter gastado todo o meu Mora para vir para Mondstadt, não consegui os conhecimentos que eu queria, e nem dá para voltar. Como eu cheguei a este ponto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "Coitada! Talvez você possa esquecer tudo naquele livro e depois volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "Isso é... muito difícil. Mesmo que eu queira ficar em Mondstadt, seria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "Muito embaraçoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Sim. Como eu mantenho o estado da mente se eu viver com os plebeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "Não temos mais opções! Então, você só precisa voltar para enfrentar a sua mestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "P... pare de falar sobre isso! Eu... acho que vou ter que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "Vou ter que ficar temporariamente em Mondstadt. Quando a velhinha chegar ao fim de seus dias, ficarei livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "Uma resolução intimidadora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "Então, como continuo a minha pesquisa da astrologia... Nem tenho um lugar para ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "Deixe-me só perguntar a <color=#00E1FFFF>Katheryne da Guilda de Aventureiros</color>, ela pode ajudar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "A Guilda de Aventureiros? Claro. Você pode fazer missões para eles em troca de... Você sabe o que eu quero dizer, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Oh, então, obrigada... Ah!... Nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "Era o meu plano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "Será que eu entendi mal a palavra \"temporariamente\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "Não tem dinheiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Sim... quero dizer, não! Você realmente não tem jeito com as palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "Mas não faz sentido ficar brava com a Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050208",
							"2"
						],
						"stepId": 1050208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "Sobre a história e o dilema da Mona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020502,
					"content": "Entendi. Faz sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020503,
					"content": "Em Mondstadt, tem um <color=#00E1FFFF>Laboratório Mágico</color> livre, só que foi selado por um desconhecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020504,
					"content": "Mesmo que alguns especialistas pudessem quebrar esse selo, todos eles têm os seus próprios laboratórios e não estão interessados neste assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020505,
					"content": "Acredito que se a astróloga que você mencionou puder quebrar esse selo, não tem problema que ela more lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020506,
					"content": "Creio que ela vai conseguir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "Tudo bem. Então, permita-me dizer onde fica a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020507,
					"content": "Vou levá-la para ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050211",
							"2"
						],
						"stepId": 1050211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "A pessoa que deixou este selo... não é uma pessoa simples. Quebrar este selo pela força é quase impossível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020602,
					"content": "Interessante. Suponho que vale a pena usar minha astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020603,
					"content": "Deixe-me ver... Sim, é isso... Primeiro... e depois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020604,
					"content": "Ok, pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020605,
					"content": "Uau! Que incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020606,
					"content": "Só falta informar a Katheryne, e você poderá morar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020607,
					"content": "Não é necessário, você tem o meu agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020608,
					"content": "Quem é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020609,
					"content": "Oh, eu sou o Goth, o dono desta casa. Acabei de passar pela Guilda de Aventureiros, e a Katheryne me contou sobre o assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020610,
					"content": "Eu nunca pensei que este selo problemático fosse dissipado tão rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020611,
					"content": "Isso significa que posso ficar aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020612,
					"content": "Claro. De qualquer maneira, ninguém está usando os equipamentos aí dentro, se alguém puder utilizá-las, fico contente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020613,
					"content": "Para expressar o meu agradecimento, posso alugar esta casa pelo menor preço possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020614,
					"content": "A... alugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020615,
					"content": "Não ouvi nada sobre aluguel e também ajudei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020616,
					"content": "Ajudar? Sim, claro, estou muito agradecido. Por isso, vou te dar o melhor preço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020617,
					"content": "Eu... Quero dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020618,
					"content": "Parece que a Mona entendeu mal, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020619,
					"content": "Esta talvez seja a melhor opção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "Não tenho mais opções. Vou alugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020622,
					"content": "Então, fechou! Vou preparar alguns documentos, só espere um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020623,
					"content": "Agradeço, mas peço desculpa por não conseguir acabar o que eu prometi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020624,
					"content": "Ainda vai levar um tempo para ver o seu destino, pois me faltam as ferramentas necessárias e alguns conhecimentos novos da astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020625,
					"content": "Mas garanto que você será a primeira pessoa a quem farei previsões quando eu estiver preparada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020626,
					"content": "Como você disse, não havia nada a se perder com esta jornada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "Agradeço. Nossa viagem foi traçada pelo destino, e foi muito boa por sinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020630,
					"content": "Boa viagem para vocês! Quanto a mim... eu preciso pensar no meu futuro também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020631,
					"content": "Se ela não quer ganhar a vida com a astrologia, como conseguirá sobreviver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020632,
					"content": "Vamos visitá-la de vez em quando. Seria ruim se ela morresse de fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020628,
					"content": "Acho que você deve continuar trabalhando nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "É verdade. Realmente não sei o que fazer, mas... farei o meu melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020620,
					"content": "As Mora se acumulam com tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
