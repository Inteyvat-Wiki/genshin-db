			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "Chegaaaaamos! É bem aqui. Vamos desenterrá-los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020202,
					"content": "Deve ser coisa dos Slimes Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "Não pode ser! Porque eu deixei algumas marcas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020205,
					"content": "Argh, Slime Dendro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020206,
					"content": "Sim, Slime Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020207
					]
				},
				{
					"id": 105020207,
					"content": "Err. Podemos conversar mais tarde, vamos expulsá-los primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020203,
					"content": "Com certeza foram os Slimes Dendro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				}
			]
		},
		{
			"id": 1050203,
			"completionStepIds": [
				1050206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050206",
							"2"
						],
						"stepId": 1050206,
						"stateName": "QUEST_STATE_UNFINISHED"
