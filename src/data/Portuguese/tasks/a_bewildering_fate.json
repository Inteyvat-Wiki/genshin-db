			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "#Você está preparad{M#o}{F#a}? Não envergonhe a sua mestra agora, estamos prestes a conhecer essa sucessora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020102,
					"content": "Não sei nada sobre adivinhação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "#Eu acho que... Espere, não! Não servirá se você não tiver a mínima ideia de nada, mesmo se você for {F#uma aprendiz falsa}{M#um aprendiz falso}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020105,
					"content": "Temos uma regra que é proibido ensinar forasteiros, mas eu imagino que... Talvez eu poderia te ensinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020106,
					"content": "A minha astrologia é baseada na hidromancia e, como o nome sugere, uso os reflexos na água para observar o verdadeiro céu estrelado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020107,
					"content": "Permita-me demonstrar. Observe de perto agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020108,
					"content": "Vamos ver... Segundo a posição das estrelas e a sua trajetória... Vejo que esse sucessor é uma jovem... Mulher... Dos Cavaleiros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020109,
					"content": "Isso não soa como... A Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020110,
					"content": "Iremos nos encontrar com ela aqui no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020111,
					"content": "Bom, já temos informações suficientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020112,
					"content": "Iss-Isso é tudo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "*Suspiro* Parece que nem mesmo a astrologia básica pode ser apreendida de uma só vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020115,
					"content": "Não importa. Explicarei em detalhes mais tarde - ela está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020116,
					"content": "#Uau. É {M#o Cavaleiro}{F#a Cavaleira} Honorável! E a Paimon também! Vocês voltaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020117,
					"content": "É ela! É a sucessora da grande sabedoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020118,
					"content": "... Você se refere a Klee!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "Sucessora...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020121,
					"content": "Isso! Eu sou a astróloga que percebe os segredos do oceano de estrelas! Certamente, você também calculou por muito tempo minha chegada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020122,
					"content": "Oceano de estrelas? O que é isso? Há peixes também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020123,
					"content": "Peixe...? Não, não se faça de boba. Isto é algum tipo de jogo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020124,
					"content": "Eu é que deveria estar dizendo isso! Eu não entendi nada do que você disse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020125,
					"content": "Isso tudo não está nos levando a lugar algum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "Mas a minha astrologia não comete erros. É melhor perguntar para confirmar. A sua mãe é a Alice, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020128,
					"content": "Isso mesmo! Oh, então você é amiga da mamãe! Mas ela foi para muito longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020129,
					"content": "Isso eu já sabia, porque a astrologia já disse tudo. Mas antes de ela ir embora, ela tinha te ensinado todos os conhecimentos de misticismo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020130,
					"content": "Misticismo? Não entendi. A mamãe só me ensinou como se faz Bombas Saltitantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020131,
					"content": "Então, no final, a mãe da Klee é a amiga e a rival da professora da Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020132,
					"content": "Sim. a minha mestra é muito versada em astrologia, mas só em astrologia mesmo. A Alice, por outro lado, é hábil em muitos outros campos místicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020133,
					"content": "Bem... A Klee é tão jovem, então mesmo que ela tivesse ouvido esses conhecimentos tão profundos, ela pode não ter entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020134,
					"content": "Sim. Parece que ela herdou o sangue, mas não o conhecimento... Que erro de cálculo. Não pode haver uma competição como esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020135,
					"content": "Ah, sim. Então, antes da Alice ir embora, ela lhe contou alguma coisa sobre o acordo de cinquenta anos e sobre uma caixa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020136,
					"content": "Ooh, eu sei essa! Então você está aqui por essa caixa. Eu vou procurar. Espere aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020137,
					"content": "Hmm... Não é essa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020138,
					"content": "Hmm... Hm... Nem essa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020139,
					"content": "Não, não, nem essa também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020140,
					"content": "Ah! Me lembrei! Eu escondi a caixa em conjunto com outros tesouros novos na <color=#00E1FFFF>Origem do Vento</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020141,
					"content": "É uma bomba de novo, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "Me espere. Eu já volto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020144,
					"content": "Klee, não simplesmente saia correndo! Você não precisa das coisas em sua mochila?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020145,
					"content": "Vou ajudar ela a arrumar essas coisas de volta. Você vai atrás dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020146,
					"content": "*Suspiro* Observando como ela é precipitada, eu me preocupo com a caixa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020142,
					"content": "Por que você sempre enterra coisas importantes ao ar livre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "Viu, eu disse que isto era um engano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020119,
					"content": "Deve ser algum engano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020113,
					"content": "Ainda não tive a oportunidade de ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020103,
					"content": "Não consigo ler as estrelas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				}
			]
		},
		{
			"id": 1050202,
