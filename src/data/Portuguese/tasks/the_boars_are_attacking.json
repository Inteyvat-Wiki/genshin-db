				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "Tem alguma coisa que eu possa fazer para ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "Você é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "...Ah, viajantes... Muito gentil da parte de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "Está na época da maturação das uvas, mas uma manada de javalis apareceu do nada e está de olho no vinhedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "Eu não consigo afastá-los sozinho e meu filho não está comigo agora, então tudo o que posso fazer agora é assisti-los destruindo a minha terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "Se você puder me ajudar a afastar esses javalis, eu irei recompensá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
