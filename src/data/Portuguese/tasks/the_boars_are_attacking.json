					"content": "Eu ainda tenho algo a fazer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "Bem, então eu acho que apenas posso esperar pelo meu filho quando ele voltar e punir esses javalis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
