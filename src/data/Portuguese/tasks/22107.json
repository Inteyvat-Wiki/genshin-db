				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071601,
					"content": "Um par de pássaros no teto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "Ok... Esplêndido! Isso é bom sinal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Dois pombos abandonaram os seus bandos para poder estar juntos, o que conta é só um por outro, e voam juntos para o fim do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "Esse sinal só pode significar uma coisa: em breve encontrarei quem me ama e só a mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "E quando ela superar as dificuldades e conseguir escapar da agitação das pessoas, vamos voar juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "Hum! Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Eu me pergunto que reviravolta do destino os levou a se conhecer... a entender um ao outro... e a experimentar o verdadeiro amor juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "*Suspiro* Oh, que pena que eu não sou uma pomba... Nunca conhecerei o sabor doce do amor de outra pomba no meu bico... Oh, que destino cruel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "Mas você pode provar sabor de pombo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "Sabor de pombo?... Espere... Você... você quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "O que você fez!? Foi uma metáfora, seu palhaço! Uma metáfora! Não é como se fosse possível saborear o amor literalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "Você não precisa ser tão insensível! Nesse caso, minha sorte no amor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "Esquece, deixa para lá. Eu preciso de um tempo para refletir. Por que vocês não voltam a fazer o que estavam fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
