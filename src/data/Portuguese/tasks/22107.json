			"dialogs": [
				{
					"id": 221071501,
					"content": "Você encontrou mais alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071502
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071502,
					"content": "Por enquanto é isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071503
					]
				},
				{
					"id": 221071503,
					"content": "Ok, tenho que perguntar à Qiming.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210716,
			"completionStepIds": [
				2210716
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210716",
							"2"
						],
						"stepId": 2210716,
						"stateName": "QUEST_STATE_UNFINISHED"
