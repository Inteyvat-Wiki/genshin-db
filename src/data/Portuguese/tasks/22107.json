			},
			"dialogs": [
				{
					"id": 221071301,
					"content": "Um gato e um peixe fizeram amizades...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "Pelos deuses! Que sinal fantástico! Vocês realmente sabiam o que eu estava à procura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071303,
					"content": "É uma amizade tão incomum, é ótima, não importa se é entre gatos e peixes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "Isso é o significado do amor! O poder do amor verdadeiro bloqueia todas as barreiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "Se for possível, gostaria de poder demonstrar minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Claramente, esse sinal está me dizendo que... Não tema obstáculos na busca do amor. Só então Qiming poderá ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "...Enfim, só tenho a agradecer a vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210714,
			"completionStepIds": [
				2210714
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
