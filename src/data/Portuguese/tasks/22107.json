				"points": []
			},
			"dialogs": [
				{
					"id": 221071701,
					"content": "Folhas caídas...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071702
					]
				},
				{
					"id": 221071702,
					"content": "Hum... Acho que isso não tem muito a ver com amor, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071703,
					"content": "Folhas caídas? Tem tudo a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071704
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071704,
					"content": "Você pode olhar para essas folhas mortas e descartá-las como murchas e perdidas... Mas eu vejo potencial. Potencial ilimitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071705
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071705,
					"content": "Basta uma pequena faísca para transformá-los em fogo estrondoso, e a menor rajada de vento pode fazê-los subir majestosamente para o céu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071706
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071706,
					"content": "Uma analogia adequada para o meu amor não correspondido... Armazenado em meu coração esse tempo todo... Sempre esperando por algo, algo que mude tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071707
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071707,
					"content": "*Suspiro* Mas ninguém sabe como, quando ou onde, apenas depende dos céus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071708
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071708,
					"content": "Mas não há com o que se preocupar, tudo tem uma razão. Eu só preciso de paciência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071709
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071709,
					"content": "Eu é que sou o pré-destino destas folhas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071710
					]
				},
				{
					"id": 221071710,
					"content": "Como assim? O que você quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071711
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071711,
					"content": "Espere... Espere! Você foi... Não me diga que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071712
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071712,
					"content": "Oh não... É isso, está tudo acabado! Se você interromper o momento natural do ponto de virada... isso estraga tudo! O destino e o amor serão mergulhados no caos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071713
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071713,
					"content": "Quem você pensa que é? Acha que você é Deus? Responsável pelo destino das folhas? Talvez você quisesse dar as mãos, mas está a ser ao contrário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071714
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071714,
					"content": "O que devo fazer... Ugh, saia daqui, vá incomodar a vida de outra pessoa! Preciso de um tempo para me refrescar a mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
