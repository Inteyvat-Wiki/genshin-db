				},
				{
					"id": 221071902,
					"content": "Oh? Isso é um meu sinal! Isso indica que o meu amor já chegou ao fim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071903
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071903,
					"content": "Espere, o quê? Aqueles cachorrinhos pareciam ser muito amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071904,
					"content": "Eu conheço aqueles cães, são amigos próximos e sempre andam juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071905,
					"content": "Pode parecer uma coisa boa, mas o fato é que... Nenhum desses cães jamais encontrou um companheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071906,
					"content": "E pelo fato de eles estarem cercados de amigos sempre, eles não ficaram incomodados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071907,
					"content": "Eles devem ter um incentivo para encontrar parceiros agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "O que você quer dizer? Então... Você foi expulsá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071909,
					"content": "Se for assim, ainda bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071910,
					"content": "Às vezes, se aliviam dos momentos perdidos com força externa, para procurar o amor verdadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071911,
					"content": "Muito obrigado. Eu entendi o significado verdadeiro deste sinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071912,
					"content": "Qiming... Eu juro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
