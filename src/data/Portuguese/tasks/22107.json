				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Um comerciante está fazendo bem hoje...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "Os negócios estão bombando? Nada mal... parece promissor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071103,
					"content": "Não há ganho sem dor. Paciência e dedicação sempre dão frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071104,
					"content": "Esse sinal certamente significa que na vida e no amor é assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071105,
					"content": "*Cof cof* Err... muito obrigado, eu preciso pensar no assunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071106,
					"content": "Qiming, o dia certo chegará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210712,
			"completionStepIds": [
				2210712
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210712",
							"2"
						],
						"stepId": 2210712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "Folhas caídas...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "Hum... Acho que isso não tem muito a ver com amor, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071203,
					"content": "Folhas caídas? Tem tudo a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071204,
					"content": "Você pode olhar para essas folhas mortas e descartá-las como murchas e perdidas... Mas eu vejo potencial. Potencial ilimitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071205,
					"content": "Basta uma pequena faísca para transformá-los em fogo estrondoso, e a menor rajada de vento pode fazê-los subir majestosamente para o céu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071206,
					"content": "Uma analogia adequada para o meu amor não correspondido... Armazenado em meu coração esse tempo todo... Sempre esperando por algo, algo que mude tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071207
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071207,
					"content": "*Suspiro* Mas ninguém sabe como, quando ou onde, apenas depende dos céus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071208,
					"content": "Mas não há com o que se preocupar, tudo tem uma razão. Eu só preciso de paciência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071209
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071209,
					"content": "Oh, então... muito obrigado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
