			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071401,
					"content": "Uma matilha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071402
					]
				},
				{
					"id": 221071402,
					"content": "Oh? Isso é um mau sinal! Isso indica que o meu amor já chegou ao fim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Espere, o quê? Aqueles cachorrinhos pareciam ser muito amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "Eu conheço aqueles cães, são amigos próximos e sempre andam juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "Pode parecer uma coisa boa, mas o fato é que... Nenhum desses cães jamais encontrou um companheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Quando eles envelhecerem, vai ser tarde demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Esse sinal está realmente tentando me dizer para passar o tempo até que eu morra com meus amigos, pois nunca vou encontrar minha alma gêmea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "Eu preciso sentar e pensar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210715,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
