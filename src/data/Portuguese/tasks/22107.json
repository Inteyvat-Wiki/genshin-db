					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071806,
					"content": "Especialmente para esse peixe. Naturalmente, ele sabe que é um gato, mas ele ainda está disposto a expressar seu amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071807
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071807,
					"content": "Agora você pode expressar os seus sentimentos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "O que você quer dizer? Oh... Você trouxe o peixe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071809,
					"content": "Não me diga que você pegou o coitadinho deste peixe diretamente enquanto o seu gato estava vendo ao lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071810,
					"content": "Essa amizade além das espécies! Não devemos protegê-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Além disso, não foi fácil encontrar um sinal suspeito, e olha o que você fez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071812,
					"content": "Por favor, deixe-me em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
