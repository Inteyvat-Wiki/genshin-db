	"talks": [
		{
			"id": 2210701,
			"completionStepIds": [
				2210701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210701",
							"2"
						],
						"stepId": 2210701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221070101,
					"content": "\"O verdadeiro amor pode estar impossivelmente distante, ou pode estar bem debaixo do seu nariz. Você não pode forçá-lo; mas, quando chegar o dia, ele se revelará a você bem diante dos seus olhos...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070102
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070102,
					"content": "O que é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070103
					]
				},
				{
					"id": 221070103,
					"content": "Claramente é sobre o meu horóscopo de amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070104,
					"content": "Foi isso que Qiming, a cartomante, me aconselhou sobre a minha vida amorosa: pode estar impossivelmente longe, ou pode estar bem debaixo do meu nariz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070105,
					"content": "Ouso dizer que ela deve estar sugerindo algo... Mas o que poderia ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070106,
					"content": "Ouvi contadores de histórias dizerem que você consegue adivinhar quando sua sorte está prestes a se tornar realidade, porque os sinais aparecem ao seu redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070107
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070107,
					"content": "Eu tenho um intenso sentimento de que o amor verdadeiro aparecerá em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070108
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070108,
					"content": "Você pode ir ver se tem mais alguns sinais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070109,
						221070110
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070109,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070111
					]
				},
				{
					"id": 221070111,
					"content": "Yay! Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070110,
					"content": "Por que você não vai por conta própria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221070112
					]
				},
				{
					"id": 221070112,
					"content": "É costume se dizer, \"quando se está fora de uma situação, você vê com outros olhos, o que não via dentro dela\", então se fosse eu ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070113
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070113,
					"content": "...Receio interpretar tudo e qualquer coisa que vi como um sinal de que o verdadeiro amor está a caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221070114
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221070114,
					"content": "É por isso que eu preciso da sua ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
