				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "Ah, você está aqui. O Mestre Curao já deixou as pedras preciosas processadas na loja e deixou instruções para que eu as entregasse pessoalmente a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Hã? O Mestre Curao também não está aqui hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Isso mesmo, ele saiu para buscar inspiração novamente. A propósito, ele também fez um conjunto de cadeados para levar com ele, disse que era para evitar que suas ferramentas fossem roubadas... Muito estranho... Alguém realmente gostaria de roubar nossas ferramentas de corte e vendê-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Claro que não! É que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(...Então Imix ainda não sabe que foram roubadas por pássaros... Vamos poupar Curao do constrangimento!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Porque... Porque há alguém que acha que pode roubar suas habilidades dessa forma também, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Deixa pra lá... Enfim, vamos pegar as gemas! A forma é tão bonita, não é à toa que ele é um mestre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Parece que {REALNAME[ID(2)|SHOWHOST(true)]} também gostou muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#Permita-me agradecer em nome de {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Ei, contanto que seu pequeno Sauriano goste! Vou garantir que os elogios cheguem ao Mestre Curao, por favor, voltem sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
