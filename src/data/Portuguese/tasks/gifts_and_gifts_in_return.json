			"dialogs": [
				{
					"id": 750350101,
					"content": "Licença... Hmm, você é Mestre Curao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "Esse é, na verdade, meu nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Curao"
				},
				{
					"id": 750350103,
					"content": "Hehe, então você é o Mestre das Gemas que tá procurando inspiração! Viemos procurar por você pela recomendação de Imix. A gente percebeu que você tava encarando aquela árvore ainda agora, você tava no meio da mineração de gemas por criatividade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Hmm, na verdade... Esqueça. Não é mais importante... *Suspiro* Tem alguma coisa que eu possa ajudar vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Curao"
				},
				{
					"id": 750350105,
					"content": "#Trouxemos uma bela gema e estávamos esperando que você processasse para {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hehe, vai logo e dá a gema a ele, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "Rawr! Rawr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#Vocês ouvem o bater de asas de pássaro perto dos seus ouvidos...\\nQuando você se recupera, a gema desapareceu das garras de {REALNAME[ID(2)|SHOWHOST(true)]} sem deixar rastro.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "Raaaaah! Rwaaarrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Es-Espera um segundo, cadê a gema? Onde uma gema tão grande poderia ter ido parar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Parece que um pássaro levou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "Qual foi?! Os pássaros aqui são ladrões? Que falta de educação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "Rawrrrr! Rwarrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Na verdade, o que eu estava prestes a dizer era que, mesmo que a gema não tivesse sido roubada, eu não ia poder ajudar vocês a lapidá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Curao"
				},
				{
					"id": 750350116,
					"content": "...Já que todas as minhas ferramentas também foram roubadas por esses malditos pássaros! Na verdade, eu estava agora mesmo olhando com cuidado para esses pássaros, indo até eles um por um, para ver qual deles botou as garras sujas nas minhas ferramentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Curao"
				},
				{
					"id": 750350117,
					"content": "#Isso... Isso é sequer possível? Esses pássaros são os piores! Bora, {NICKNAME}, vamos pegar aquela gema de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "E não se esqueça das minhas ferramentas também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Curao"
				}
			]
		},
