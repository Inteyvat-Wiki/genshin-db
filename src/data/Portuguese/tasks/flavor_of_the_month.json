			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "Eu... Eu fui salvo! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000602,
					"content": "Não esperava que caçar javalis na floresta fosse tão trabalhoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000603,
					"content": "Sobre os ingredientes de Brook...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "Foi Brook que mandou você aqui? Ah... Ela quer Carnes Cruas frescas, já tenho elas comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000605,
					"content": "Entretanto, quando fui atrás do javali, não prestei atenção e acabei cruzando com um monte de monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000606,
					"content": "Apesar de ter pego o javali, acabei sendo cercado por eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000607,
					"content": "Viajante, posso pedir-lhe para dar esta carne a Brook? Vou primeiro à cidade e pedir à igreja para curar a minha ferida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000608,
					"content": "*Suspiro* Se Draff me ver nessa situação ficará falando sem parar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
