					"Schuster Assustado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "Uff, isso me deu um alívio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001302,
					"content": "Foi você que acendeu a fogueira? Que Viajante de bom coração, muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001303,
					"content": "Está tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "Agora está mais quente. Ainda bem! Eu recebi uma missão para pegar a Carne Fresca Fria na Montanha Nevada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001305,
					"content": "No começo, eu queria dar uma olhada na Montanha Nevada, mas acidentalmente perdi a tocha e acabei me perdendo também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001306,
					"content": "Se não fosse por vocês, não saberia o que fazer. Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001307,
					"content": "Sobre a Missão de Brook...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Foi a Brook que pediu a você para me encontrar? Ela deve estar esperando desesperadamente. Mas eu realmente estou sem forças para entregar a carne em uma vila tão longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001309,
					"content": "Apesar de ser um incômodo, vocês poderiam me ajudar a entregar essa Carne Fresca Fria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 708001310,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Muito obrigado. Eu devo voltar para o acampamento no pé da montanha e beber uma boa sopa quente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schuster Assustado"
				}
			]
		},
