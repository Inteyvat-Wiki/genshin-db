			"dialogs": [
				{
					"id": 708000201,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Na verdade eu estou pensando em criar um novo prato para o Festival da Brisa Florescente, com sabor do vento. E agora estou preparando os ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000203,
					"content": "No entanto... Eu pedi ao Allan para caçar as carnes mais frescas no Cânion da Coroa Brilhante, mas ele está demorando muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000204,
					"content": "Se continuar assim, os ingredientes podem perder o seu frescor. Viajante, você poderia ir ao Cânion da Coroa Brilhante por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000205,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Muito obrigada. Quando voltar, venha aqui provar as comidas novas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
