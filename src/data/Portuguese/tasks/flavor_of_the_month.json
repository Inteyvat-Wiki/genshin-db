				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Obrigada, esses ingredientes estão prontos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000902,
					"content": "Obrigada, por favor fique com isso, é sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000903,
					"content": "Entretanto, como posso fazer com que a comida tenha um sabor do vento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000904,
					"content": "Cozido ao vapor e frito... Humm, caso contrário, tomamos como base o sabor original dos pratos e colocamos as Sementes de Dandelion por cima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
