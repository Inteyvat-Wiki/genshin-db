			"dialogs": [
				{
					"id": 708001001,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "#Você... Eu me lembro de você. Você é {F#a}{M#o} assistente de Xiangling, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001003,
					"content": "Na competição culinária passada deixei uma impressão forte nas pessoas, lembro-me como se fosse hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001004,
					"content": "Apesar de eu ter perdido para Xiangling na última vez, dessa vez eu decidi descobrir um prato com o \"sabor do vento\". Depois, irei competir e vencer a Xiangling!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001005,
					"content": "Para cozinhar bem esse prato, eu fui pessoalmente pedir a um aventureiro para pegar algumas Carnes Frescas Frias na Montanha Nevada para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001006,
					"content": "Mas aquele aventureiro, Schuster, ainda não retornou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001007,
					"content": "Ouvi dizer que é muito perigoso na Montanha Nevada. Será que aquele aventureiro está enfrentando problemas? Você pode ir procurá-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001008,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
