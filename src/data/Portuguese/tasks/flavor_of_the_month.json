						708001502
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001502,
					"content": "Já levamos a carne de volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "Ótimo! Uh? Schuster... Será que ele encontrou algo perigoso no caminho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001504,
					"content": "Ele deve estar bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "Ainda bem que não correu mal. Assim que terminar o meu novo prato, leve-o para ele experimentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001506,
					"content": "Falando nisso, essa Carne Fresca Fria realmente parece ser diferente que as carnes comuns. Se eu usar isto como ingrediente, talvez possa sair um prato com sensação de \"boom shaka-laka\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001507,
					"content": "Mas, se quiser que a comida tenha um sabor do vento, preciso de algumas Sementes de Dandelion como ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001508,
					"content": "Se for assim, não vejo muita diferença entre ele e outros pratos de carne, ou seja, pelo menos ainda falta um ingrediente de destaque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001509,
					"content": "Ah, falando nisso, eu encontrei a Xiangling algumas vezes depois daquela competição e cheguei a ouvir falar de um prato chamado \"Slime com Cogumelo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001510,
					"content": "Ainda não cheguei a usar esse ingrediente tão peculiar... No entanto, para fazer um prato totalmente novo é necessário usar esse ingrediente peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001511,
					"content": "Viajante, você poderia me trazer um Condensado de Slime e uma Semente de Dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001512,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "Muito obrigado! Ficarei por aqui pensando sobre as minhas receitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
