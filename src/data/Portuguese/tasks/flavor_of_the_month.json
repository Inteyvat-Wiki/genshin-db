			"dialogs": [
				{
					"id": 708000701,
					"content": "Ah, vocês vieram! Trouxeram a Carne Crua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000702,
					"content": "Trouxemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Hum! Me parece... Muito fresca! Bom, vamos fazer um prato de Carne Crua, acompanhado com algo com sabor de Vento....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000704,
					"content": "Ingredientes que possuam o sabor do vento... É claro, só podem ser as Sementes de Dandelion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000705,
					"content": "Viajante, você poderia me ajudar a coletar algumas Sementes de Dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000706,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Muito obrigada. Eu tenho que preparar essa Carne Crua agora, depois de coletar, traga elas logo para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
