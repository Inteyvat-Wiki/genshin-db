			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziwei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "Desse ângulo... Essa constelação parece um cachorro... Qual nome seria melhor para ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330702,
					"content": "Oh, Ferro! O que te traz aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330703,
					"content": "Errr... Estávamos apenas dando um passeio aí no Porto de Liyue, mas acabei me deparando com um lugar bem bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330704,
					"content": "Um lugar? Um lugar para observar as estrelas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330705,
					"content": "Sim! Isso! Também é um bom lugar para lançar Lanternas Celestes. Eu já preparei tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330706,
					"content": "Olha! Eu até escrevi um poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330707,
					"content": "\"Faíscas voam onde pás e meteoritos se encontram.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330708,
					"content": "Hum... Apesar de não saber qual desejo que eu ia fazer, o seu poema parece ser muito interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330709,
					"content": "Mas os desejos na Lanterna Celeste não podem ser vistos por outros, caso contrário, não irão ser realizados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330710,
					"content": "O que te trouxe para aqui hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330711,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330712,
					"content": "Ele encontrou um bom lugar para lançar a Lanterna Celeste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "Soltar Lanterna Celeste? Desculpe... Na verdade, eu gostaria de ficar em algum lugar longe delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330715,
					"content": "Porque o brilho das Lanternas afeta a minha observação das estrelas... Portanto, eu gostaria de ficar longe delas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330716,
					"content": "Muito obrigada. Vou indo. Feliz Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "Ziwei"
				},
				{
					"id": 413330717,
					"content": "Ah... Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330718,
					"content": "Ela foi embora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "Eu... Eu estou bem. Devo ter escrito de forma abstrata demais. Ziwei não entendeu de jeito nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330721,
					"content": "#Fique tranquil{M#o}{F#a}, não estou desiludido. Eu farei ela entender o meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330722,
					"content": "Viajante, obrigado pela sua ajuda. Fique com isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330723,
					"content": "Ugh... Pelo menos eu vou lançar essa Lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330719,
					"content": "Não fique desiludido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "Se você também quiser lança-la, por que é que não vai junto com ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
		},
