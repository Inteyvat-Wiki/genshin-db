			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ferro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330101,
					"content": "\"Adeptus Enigmático no Mais Alto Céu\"... Que lindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330102
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330102,
					"content": "Você está olhando para as estrelas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330103
					]
				},
				{
					"id": 413330103,
					"content": "Sim, e não... Não estamos no Ritual de Lanternas? Ver coisas tão belas assim é comum nessa época...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330104
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330104,
					"content": "Eu aprendi a escrever poemas. Ouvi alguns colegas dizerem que as garotas todas gostam de coisas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330105
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330105,
					"content": "Assim como a Ziwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330106,
						413330107
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330106,
					"content": "Escrever uma poesia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				},
				{
					"id": 413330108,
					"content": "Eu ouvi muitos nomes de constelações de Ziwei... Eles soam muito bonitos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330109
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330109,
					"content": "Olha, eu tenho que exprimir os meus agradecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330110
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330110,
					"content": "Eu estava pensando que deveria escrever um poema em uma Lanterna Celeste e encontrar um lugar para soltá-la junto com Ziwei... Vamos comer lanches e cantar canções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330111
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330111,
					"content": "Se isso não funcionar, nada irá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330112
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330112,
					"content": "Terminou...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330113
					]
				},
				{
					"id": 413330113,
					"content": "... Hum! Quero dizer, isso nos fará aproveitar mais o festival! É isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330114
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330114,
					"content": "De qualquer forma, eu gostaria de encontrar um lugar com atmosfera boa, vista fantástica, mas menos gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330115
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330115,
					"content": "Eu até perguntei aos meus amigos, e encontrei esses dois lugares ideais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330116
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330116,
					"content": "Dizem que costumavam lançar Lanternas Celestes aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330117
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330117,
					"content": "Mas eu tenho que escrever o meu poema... Entretanto, temo que se ficar andando por aí, acabarei por perder minha inspiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330118
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330118,
					"content": "Você pode ir dar uma investigada nesses locais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330119
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330119,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330120
					]
				},
				{
					"id": 413330120,
					"content": "Muito obrigado! Vou deixar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330107,
					"content": "Ziwei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330108
					]
				}
			]
		},
		{
			"id": 4133302,
			"completionStepIds": [
				4133304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
