					"nextDialogs": [
						413330302,
						413330303
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330302,
					"content": "#Estou pront{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 413330303,
					"content": "Vou precisar mais um pouco de tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330304
					]
				},
				{
					"id": 413330304,
					"content": "Ah, não, não, não é nada. Vou pensar em como eu poderia escrever este poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ferro"
				}
			]
		},
