			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ferro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "\"O encontro de Ferro e Ziwei...\" Não, não! Não dá, é demasiado direto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330202,
					"content": "Hein? Quando vocês chegaram? Encontraram os dois lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330203,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "Tão rápido? Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330205,
					"content": "Deixe-me ver... Enquanto o primeiro lugar é único, outro, por sua vez, tem uma paisagem muito pitoresca... É exatamente como um provérbio diz: \"Cada lugar possui a sua própria propriedade\" e... Esqueci resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330206,
					"content": "Deixa para lá... Entretanto, esses locais parecem brilhantes e impressionantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330207,
					"content": "Bom! Eu sei qual lugar vou escolher. Viajante, posso pedir mais um favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330208,
					"content": "Meus amigos me disseram que quando você vai ver alguém, é melhor trazer algo para comer. O que você acha que eu devo preparar quando eu for ver Ziwei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330209,
					"content": "Peixe Tigre Frito",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "Parece ser muito oleoso, não?? Realmente não é muito apropriado... Talvez seja Tofu de Amêndoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330212,
					"content": "Sim! Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330213,
					"content": "Viajante, você pode preparar um Tofu de Amêndoas por mim? Eu tenho que me focar nesse poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330214,
					"content": "\"Inúmeras faíscas voam\"... Isso soa bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ferro"
				},
				{
					"id": 413330211,
					"content": "Tofu de Amêndoas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
