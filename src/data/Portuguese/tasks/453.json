			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hopkins, O Maravilhoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "Como estão indo suas investigações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530602,
					"content": "O qu- Você está de pé!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Felizmente, eu me recuperei. Consegui sair das profundezas do inferno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530604,
					"content": "Então, o que vocês encontraram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530605,
					"content": "Ao inspecionar o pelo do lobo que foi deixado em cena, podemos confirmar que os lobos vêm do Reino dos Lobos. Mas além disso, não sabemos de mais nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Mas por favor, mantenha a calma. Irei partir para o Reino dos Lobos em breve e chegar ao fim disso tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "Os Cavaleiros de Favonius não vão permitir que este perigo continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Ótimo. Antes tarde do que nunca, suponho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530609,
					"content": "Que grosseria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Ao mesmo tempo, nós vamos ter que continuar lidando com isso por nossa conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530611,
					"content": "Por favor, não faça nada estúpido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Haha! Fazemos as coisas de maneira um pouco diferente por aqui, você provavelmente não está acostumada a isso. Eles vão pagar pelo que fizeram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530613,
					"content": "Adeus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4530614,
					"content": "É terrível, realmente terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "O que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Digo, o futuro deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Concordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "As pessoas jovens costumam ser impulsivas às vezes. Se não for pedir muito, eu espero que você possa ficar de olho neles, para que não entrem em problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Não tem problema, é por isso que estamos aqui. Apesar desse cara não ser muito amigável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Deixa com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "Vamos ao Reino dos Lobos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
