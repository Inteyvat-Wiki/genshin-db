						4530802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530802,
					"content": "Ele deve ter batido na porta quando atacou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530803,
					"content": "Talvez tenha deficiência de cálcio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530804
					]
				},
				{
					"id": 4530804,
					"content": "De qualquer forma, parece muita sorte que ninguém no vilarejo tenha ficado seriamente ferido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
