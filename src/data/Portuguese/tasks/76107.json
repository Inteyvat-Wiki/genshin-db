			"dialogs": [
				{
					"id": 761071001,
					"content": "Quem é você? O que está fazendo aqui? A equipe de carga devia estar lá no porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
