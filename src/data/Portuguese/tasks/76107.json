			"trigger": {
				"objectNames": [
					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071501,
					"content": "Claro, deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Você dá algumas boas pancadas no Cruzador Terrestre. *Bam, bam, bam* E agora ele está completamente morto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Ele... quebrou de vez? O que a gente faz agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "Pft, eu sabia que tinha algo errado com você desde o começo. Uma pesquisadora de verdade jamais faria afirmações tão absurdas. Você claramente é uma impostora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610716,
			"completionStepIds": [
				7610701
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
