					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071601,
					"content": "#Você poderia dizer que sou praticamente um{F#a} mentor{F#a} para ela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "Ah! Falando nisso, já ajudei a reunir vários artigos de pesquisa do Instituto de Pesquisas de Fontaine para ela. Ela falou muito bem das descobertas do Dr. Mosso. Espere... será que você é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*Cof cof*... Uhum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "S-sim! Nunca pensei que a reputação do Dr. Mosso chegaria tão longe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Pft. Pelo que sei, o Dr. Mosso morreu há trinta anos. Então por que você não vai fazer companhia a ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
