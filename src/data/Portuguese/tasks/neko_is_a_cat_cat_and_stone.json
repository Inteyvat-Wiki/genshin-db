					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "Ah, eu entendi. Eu estou muito ansiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120605,
					"content": "É como fazer comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Ah, eu entendi. As refeições que você e Hibiki fizeram foram todas coisas boas. Portanto, as pedras feitas por humanos de pedra também são boas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120607,
					"content": "Os humanos podem ser bastante habilidosos às vezes, parece. Você tem a minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
