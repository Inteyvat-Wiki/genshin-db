			"dialogs": [
				{
					"id": 722120401,
					"content": "Ah, você voltou. Este humano deve ser o humano de pedra, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120402,
					"content": "Este é o artesão que contratamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "Hã? O quê?! Essa gata realmente pode falar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120405,
					"content": "Miau, miau, miau, é tão estranho assim eu poder falar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120406,
					"content": "Não há necessidade de fazer barulho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Espere. Você está dizendo que isso é algo super normal para você?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120409,
					"content": "Muito normal, na verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "O que é que você já passou por nessa vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120411,
					"content": "Está bem, está bem, não estamos aqui para jogar conversa fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120412,
					"content": "Voltando ao nosso ponto principal: humano de pedra, você pode bater em uma pedra e fazer com que fique como eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120413,
					"content": "Hã? Humano de pedra? Você está se referindo a mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120414,
					"content": "\"Bater em uma pedra\"... Bem, eu posso tentar esculpir com ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120415,
					"content": "Mesmo? Maravilha, miau, miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120416,
					"content": "Bem, acho que esta é minha situação agora... Bem, ter um trabalho é melhor que nada. Apesar de nunca ter trabalhado para um gato... Quanto ao meu pagamento, acho que discutiremos isso depois, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120417,
					"content": "Humm. De qualquer forma, vou precisar fazer alguns preparativos. Existem algumas pedras aqui nesta ilha. Vou precisar escolher uma boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120418,
					"content": "Sim, como devo lhe chamar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120419,
					"content": "Eu me chamo Neko, a sacerdotisa chefe provisória do Santuário Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120420,
					"content": "Quanto a como me chamar, você pode me chamar do que quiser, humano que bate na pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120421,
					"content": "Bem, então suponho que devo chamá-la de Senhorita Sacerdotisa. Afinal de contas, você é minha patroa, quem vai me fazer o pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120422,
					"content": "\"Broa\"? \"Condimento\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120424,
					"content": "#B-Bem, vou dar uma olhada e escolher uma pedra para usar. Vocês tod{F#as}{M#os}, fiquem aqui por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120425,
					"content": "Trabalhar para um gato... Isso sim é uma novidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120426,
					"content": "O Sr. Ooshima parece ter se esquecido completamente do pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120407,
					"content": "É apenas uma gata falante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Sim, o humano de pedra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
