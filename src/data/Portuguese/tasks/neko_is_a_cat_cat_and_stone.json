				{
					"id": 722120601,
					"content": "Mesmo assim, eu sou curiosa. Como uma coisa tão dura como pedra assumirá o semblante de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "Aquele humano de pedra é muito poderoso? Ele pode usar um pouco de magia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "Neko"
				},
				{
