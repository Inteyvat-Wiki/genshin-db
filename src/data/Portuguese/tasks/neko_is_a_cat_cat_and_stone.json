			"dialogs": [
				{
					"id": 722120201,
					"content": "Olá, o que vocês estão fazendo hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Ajudando Neko a fazer uma estátua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Hum... O quê? Uma estátua, aqui? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "Estudarei como esculpir uma agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "Não creio que dê tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Humm... É outro pedido da Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "Para falar a verdade, devido aos problemas que ocorreram em Tatarasuna, acho que muito artesãos estão procurando por trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "A Guilda recebeu algumas encomendas relacionadas a isso, e ouvi dizer que algumas pessoas ainda estão em Tatarasuna procurando por trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "Eu encontrei um acampamento assim durante uma comissão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "Então, se você quiser, pode tentar sua sorte lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Hahaha, não tem problema, não foi tão difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "E sabe de uma coisa? Eu gostaria de ver o que pode acontecer se esse santuário realmente prosperar novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Especialmente essa tal de \"Hibiki\" da qual Neko continua falando. Que tipo de pessoa poderia ser tão amada por essa gata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Tudo bem, não se preocupe, estou apenas falando comigo mesma. Vá logo procurar por um artesão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "Mas se vocês acharão um artesão que saiba esculpir pedra ou não... Haha, acho que dependerá de sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Vamos, Srta. Etsuko, você só quer ajudar Lady Neko também, não é? Haha, você é tão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, nosso plano de pesquisa já está pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "Ugh! Está quase... Desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Você parece diferente do usual, Etsuko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "#O que foi? Não está acostumad{F#a}{M#o} em eu te dar informações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
