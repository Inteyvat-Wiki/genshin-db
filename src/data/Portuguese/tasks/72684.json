			"dialogs": [
				{
					"id": 726840632,
					"content": "Qual o conteúdo desse festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "Hahahaha! O conteúdo é muito diversificado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840634,
					"content": "Vocês podem ver aquele penhasco ali? É a Colina Singalong. Nela vocês podem cantar observando o mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840635,
					"content": "E esta fogueira, serve para assar Melões de Lavanda, os normais ou mesmo os chatos que voam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840636,
					"content": "Há também essa pilha de caixas. Poderão jogar o Chamado Sagrado dos Sete ou até mesmo a Batalha de Besouros sem se sentir apertados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840637,
					"content": "Parece realmente \"diversificado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840638,
					"content": "Claro, o destaque do festival é a apresentação dos tambores. Venham ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840639,
					"content": "Vou lhes contar um segredo: eu consegui isso através de um fornecedor secreto. Dizem que esse tambor é um tesouro deixado por um Onmyouji, seu preço de venda inicial era de 8 milhões de Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840640,
					"content": "Graças à minha aparência irresistível e ao fato de que a vendedora disse que o destino nos uniu, ela aceitou me dar um desconto e me vender por somente 800 mil Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840641,
					"content": "De 8 milhões para 800 mil Mora? Soa como uma farsa na opinião de Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840642,
					"content": "Claro! Eu nunca cairia em um truque barato como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840643,
					"content": "Foi só eu bater o olho e vi que as bordas do tambor estavam danificadas! E ela ainda disse que o destino nos uniu, ridículo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840644,
					"content": "Então continuei pechinchando e o consegui por apenas 80 mil Mora. Hahahaha! Consegui um bom negócio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840645,
					"content": "Acho que foi ela que se deu bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840646,
					"content": "Ainda assim, é bastante impressionante que você possa realmente ter pago algo no valor de 80 mil Mora. Bom trabalho, Joga-boi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840647,
					"content": "Não me subestime, são só 80 mil Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840648,
					"content": "Eu dei 20 mil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840649,
					"content": "Eu também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840650,
					"content": "Hein? Chefe, por que eu dei 30 mil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840651,
					"content": "20 mil + 20 mil + 30 mil = ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840652,
					"content": "Então você não gastou nada, você juntou 80 mil Mora com o dinheiro dos seus companheiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840653,
					"content": "*Cof Cof*... As últimas 10 mil Mora saíram do meu bolso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840665,
					"content": "Muito bem, já conversamos o suficiente. Eu preciso voltar para me encontrar com Shinobu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840666,
					"content": "O festival acabou de começar, precisamos trazer mais convidados para animar a coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840667,
					"content": "#Fique com este tambor, e quando estiver preparad{F#a}{M#o} para a apresentação dos tambores basta procurar pelo Genta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840668,
					"content": "#Até mais, amig{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
