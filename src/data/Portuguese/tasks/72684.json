			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "Precisa de ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840302,
					"content": "Sobre o próximo festival.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "Quê? Festival? Eu não ouvi falar de um festival acontecendo recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840304,
					"content": "#Vocês podem ser mais específic{M#os}{F#as}? Como nomes ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840305,
					"content": "O nome é Arataki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "Arataki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840307,
					"content": "Tambores Arataki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "É o Glorioso Festival de Tambores do Muito Respeitado Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840310,
					"content": "Ah! A Gangue Arataki que causou problemas no Festival Irodori da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840311,
					"content": "Então vocês estão falando daquele evento sem licença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840312,
					"content": "Sem licença? Não não, você está enganado. É o Glorioso Festival de Tambores do Muito Respeitado Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840313,
					"content": "Está bom, não precisa enfatizar o nome, eu provavelmente já sei, então deixe-me lhe contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840314,
					"content": "Nós vimos membros da Gangue Arataki aqui há uns dias, e eles estavam empilhando algumas coisas bem feias por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840315,
					"content": "O cara que liderava alegou estar realizando um festival de grande escala que ultrapassa o Festival Irodori, que deve ser o que você mencionou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840316,
					"content": "Depois de algumas perguntas, notei que eles não possuíam licença do evento e nem o comprovante de aluguel do local, sem falar que deveriam ir à Estação de Polícia com antecedência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840317,
					"content": "Pff. Se essa não é a definição de um festival não autorizado, amador e sem caráter oficial, eu não sei o que é. Segundo as regras, nós tivemos que forçá-los a acabar com o evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840318,
					"content": "Eh? Parados à força! Eles foram capturados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840319,
					"content": "Na verdade não. Embora eles sejam inexperientes na organização de eventos, eles prepararam um plano de segurança adequado. Então, nós apenas lhes demos um aviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840320,
					"content": "Plano de segurança, eles são bastante responsáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840321,
					"content": "Caso estiver procurando pela Gangue Arataki, talvez você possa ir para a Ilha Amakane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840322,
					"content": "A Ilha Amakane é um local designado pela Comissão Yashiro para uso em todos os tipos de festivais. Foi criado para incentivar eventos culturais da comunidade. O processo de inscrição é muito mais fácil e mais barato também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840323,
					"content": "Contamos tudo à Gangue Arataki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840324,
					"content": "Se eles ainda quiserem sediar um evento, ali será a melhor opção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "Kimura"
				},
				{
					"id": 726840325,
					"content": "#Hmm...{NICKNAME}, tudo isso está começando a parecer pouco confiável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840326,
					"content": "Mas, já que estamos aqui... podemos ir dar uma olhada na Ilha Amakane, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840308,
					"content": "Festival de Tambores Arataki",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
