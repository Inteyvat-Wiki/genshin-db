			"dialogs": [
				{
					"id": 726840501,
					"content": "Como posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840502,
					"content": "Viemos procurar a Gangue Arataki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "Oooh, já sei, vocês também estão aqui para participar daquele grande festival do Arataki, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840504,
					"content": "Também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "Sim, há pouco, a Madame Kujou Sara da Comissão Tenryou, e Yoimiya da Loja de Fogos de Artifício Naganohara vieram aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840506,
					"content": "Quando Yoimiya veio entregar os fogos de artifício, ela viu aquele grupo de pessoas reunido. Talvez ela estivesse interessada, então foi dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840507,
					"content": "Quanto ao motivo pelo qual a Madame Kujou Sara veio aqui, já não sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840508,
					"content": "#{NICKNAME}, alguém chegou antes de nós! Hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840509,
					"content": "Então, onde está a Gangue Arataki agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840510,
					"content": "Tenho vergonha de dizer, porque recentemente não há locais vagos na ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840511,
					"content": "Tivemos que os colocar na pequena praia no noroeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840512,
					"content": "Se eles tivessem solicitado mais cedo, podíamos ter arrumado um lugar melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "Hirohiko"
				},
				{
					"id": 726840513,
					"content": "Se você caminhar na direção noroeste, poderá vê-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirohiko"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
