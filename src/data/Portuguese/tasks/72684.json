			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "#Eu sou o Genta, Embaixador Anfitrião do Festival de Tambores Arataki, está pront{F#a}{M#o} para começar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840702,
					"content": "Ah sim, sobre este tambor há algo que ele esqueceu de dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840703,
					"content": "Como o pessoal não entende muito de instrumentos musicais, antes de começar, você precisa afiná-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840704,
					"content": "Assim seu som ficará mais agradável e preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840705,
					"content": "Experimente, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
			]
