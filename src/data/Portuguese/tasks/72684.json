				"points": []
			},
			"dialogs": [
				{
					"id": 726847201,
					"content": "Eu sou o Mamoru, Embaixador de Ambiência do Festival de Tambores Arataki. Você precisa de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847202,
					"content": "Você está perguntando do meu trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847203,
					"content": "Eu sou Embaixador de Ambiência, meu trabalho consiste em criar uma atmosfera animada, e fazer com que os participantes digam \"Estou a ponto de pirar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847204,
					"content": "Você está se sentindo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847205,
					"content": "Nem um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "Por... Por favor não fale assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847208,
					"content": "Não destrua meu otimismo com essa frieza! Desse jeito, meu trabalho perde o sentido, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847209,
					"content": "#Você é amig{F#a}{M#o} do chefe, me dê algum suporte no lugar dele. Diga aquela frase para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847210,
					"content": "Qual frase?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "\"Eu estou a ponto de pirar\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847212,
					"content": "Eu estou a ponto de pirar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "Ótimo! Ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847214,
					"content": "Esse é o melhor elogio que posso receber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847218,
					"content": "Vamos, amigos! É hora da música! É hora da dança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847215,
					"content": "Eu vou... Eu vou... Desculpa, não posso falar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "Mesmo que seja como você diz, o pessoal da Gangue Arataki está trabalhando duro, por isso, de qualquer forma, eu não posso relaxar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847217,
					"content": "Não importa qual seja o ataque sofrido, não desista, essa é a lição que o chefe ensinou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726847206,
					"content": "Nem de longe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
