			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "#Ha ha ha ha ha ha! {M#Meu caro amigo}{F#Minha cara amiga}! Você finalmente chegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840602,
					"content": "Há pouco estava pensando quando iria te encontrar, e aqui você está, o que me deixa muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840603,
					"content": "Olhe para este local. O que você acha? Não é uma localização privilegiada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840604,
					"content": "Cercado pelo mar, o ar é fresco, longe dos barulhos da cidade, e possui uma paisagem esplêndida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840605,
					"content": "De costas para a Ilha Amakane, você pode desfrutar exclusivamente das principais instalações do centro cultural do festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840606,
					"content": "Com excelentes ligações de transportes terrestres e marítimos, é muito fácil chegar onde precisa, seja a pé ou de barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840607,
					"content": "Realmente, o lugar é muito bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "No momento em que vi este lugar, soube que era o certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840610,
					"content": "Foi o momento que mudou o mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840611,
					"content": "Chefe, você é um gênio!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840612,
					"content": "Obviamente, vieram aqui porque a Comissão Tenryou os enviou para este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840613,
					"content": "*Cof*... Vamos ao que interessa primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840614,
					"content": "Convidei todos vocês aqui para participar do Glorioso Festival de Tambores do Muito Respeitado Arataki! Este festival é de grande importância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840615,
					"content": "O chefe disse que, em primeiro lugar, era para promover o nome da Gangue Arataki, para facilitar o recrutamento novos recrutas no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840616,
					"content": "Em segundo lugar, é para celebrar a formatura da Shinobu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840617,
					"content": "E em último lugar, para compensar todos os eventos anteriores que foram cancelados devido a falta de fundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840618,
					"content": "É como três festivais em um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840619,
					"content": "Akira... É melhor não tocar nesse último ponto novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840620,
					"content": "Por que Shinobu ainda não está aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "Para um festival como esse, muita publicidade vai fazer com que mais pessoas participem, então Shinobu foi distribuir folhetos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840622,
					"content": "Ei! Shinobu não é a protagonista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840623,
					"content": "Ela está trabalhando lá fora e vocês vagando aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840624,
					"content": "Eu também estou seriamente... Seriamente recebendo vocês aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840625,
					"content": "O chefe na verdade acabou de voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "Genta"
				},
				{
					"id": 726840626,
					"content": "Acho que ele estimou que vocês estariam vindo, então voltou especialmente para receber vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 726840627,
					"content": "Ele estava junto com Shinobu lá fora, tentando atrair mais pessoas para o festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 726840628,
					"content": "Não precisa me elogiar, não precisa me elogiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840629,
					"content": "Oh, o Joga-boi está realmente se esforçando. É raro podermos contar com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726840630,
					"content": "Hmph, eu não vou nem discutir com você, esse Melão de Lavanda voador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840631,
					"content": "#Falando nisso, {M#meu amigo}{F#minha amiga}, você ainda tem alguma dúvida quanto ao festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 726840608,
					"content": "Realmente, vocês são otimistas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
