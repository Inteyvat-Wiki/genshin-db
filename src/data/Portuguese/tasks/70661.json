			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "#Ad astra abyssosque! Bem-vind{F#a}{M#o} à Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "Recentemente recebemos uma comissão da Associação de Pesca, que afirma que a atividade pesqueira nas águas próximas tem sido anormal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Mas os detalhes não foram explicados. Você pode ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "Acho que se for você, não importa qual seja o problema, ele será resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "Associação de Pesca? É tipo aquela pesca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Hã? Aquela pesca? Não compreendo... Que tipo de pesca você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "Oh, a Associação de Pesca, Associação de Pesca, parece uma associação que pega muitos peixes deliciosos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Não vamos perder mais tempo, vamos lá dar uma olhada! Heh, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066102",
							"2"
						],
						"stepId": 7066102,
						"stateName": "QUEST_STATE_UNFINISHED"
