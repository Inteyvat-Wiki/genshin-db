				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "Os peixes têm estado muito ativos estes dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610202,
					"content": "Você precisa de ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "Ah, a ajuda finalmente chegou, olá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610204,
					"content": "O meu nome é Nantuk, pescador sênior da Associação de Pesca de Mondstadt. Cof, cof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610205,
					"content": "Recentemente, muitas novas espécies de peixes surgiram repentinamente em águas próximas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610206,
					"content": "Eu imediatamente me comuniquei com meus amigos em outras regiões e, com certeza, isso tem acontecido em todos os lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610207,
					"content": "Algumas pessoas dizem que foi a última vez que Teyvat viu um surto de peixes em um século.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610208,
					"content": "Na verdade, o motivo não foi totalmente investigado, mas acho que tem a ver com a melhoria do ambiente ecológico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610209,
					"content": "Oh... Deve haver muitos deles causando problemas, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610210,
					"content": "Não se preocupe, Paimon vai cuidar disso! Contanto que não tenham gosto ruim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610211,
					"content": "Haha, não é um problema. Para a Associação de Pesca, claro, quanto mais peixe, melhor, mas primeiro, precisamos de mão de obra suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610212,
					"content": "Mas para ser honesto, com a mão de obra que temos disponível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610213,
					"content": "Pegar todas as novas espécies de peixes para pesquisa em um curto período de tempo... é realmente um pouco estressante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610214,
					"content": "Mas, por outro lado, esta também não seria uma grande oportunidade de crescimento para a Associação de Pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610215,
					"content": "Então, eu publiquei uma missão na Guilda de Aventureiros. O que acha? Quer se juntar a nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610216,
					"content": "Pescar é muito divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610217,
					"content": "#Sem problemas, sou {M#bom}{F#boa} em pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "#Ótimo, que jovem chei{M#o}{F#a} de energia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610223,
					"content": "Então... Vamos começar indo ao Lago de Sidra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610224,
					"content": "Há zonas de pesca que eu preparei para os novatos. Ensinarei a vocês o básico primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610219,
					"content": "Posso ir lá e pegá-los direto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "Não é perigoso mergulhar diretamente? Vocês, Aventureiros, são muito corajosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610221,
					"content": "Infelizmente, esses peixes não são tão corajosos quanto você. Todos eles devem estar assustados depois de ver um ser tão grande pular na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610222,
					"content": "É melhor não fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
