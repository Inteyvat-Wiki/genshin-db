		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Este lugar serve! Vê aqueles peixinhos na água? Eles são lindos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Estas são as ferramentas para você: varas de pescar, iscas e receitas para fazer iscas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Primeiro, coloque a isca no anzol, depois aponte para onde os peixes estão se juntando... e lance a linha! Em seguida, espere obedientemente o peixe morder a isca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Ouvi dizer que os recém-chegados têm algo chamado \"sorte de principiante\". Eu peguei um robalo grande com mais de meio metro de comprimento naquela época! Você deveria tentar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Vamos torcer para eu pegar outra Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Ei! Você não precisa de nenhuma outra Paimon além desta Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon? Que nome estranho, é uma espécie de peixe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "É um \"marisco maravilhoso\" que consegui apanhar da última vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Ei! Paimon acabou de passar de \"comida de emergência\" para \"marisco maravilhoso\"!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "#Entendi! Não sabia que você já era {M#um}{F#uma} {M#pescador}{F#pescadora} experiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Estou ainda mais animado para ver o que você pegará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
			"id": 7066106,
			"completionStepIds": [
				7066106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066106",
							"2"
						],
						"stepId": 7066106,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"7066110",
							"3"
						],
						"stepId": 7066110,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Como foi? Pela sua cara, você deve ter pescado muitos peixes! Deixe-me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Oh? É uma espécie de peixe recém-descoberta! Que bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "Você está quase igual a mim nos meus dias de glória, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Você também consegue pescar apenas usando as mãos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Aham... Parece que esses peixinhos comuns são fáceis demais para você, eu deveria lhe dar algo mais desafiador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
