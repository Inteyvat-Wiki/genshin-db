			},
			"dialogs": [
				{
					"id": 760510301,
					"content": "Isso deve servir, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "Ah! Lá vai ela, já pintando de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "Ahem... Prezados jurados, preparem-se para se maravilhar! Que tipo de obra-prima nossa talentosa artista kuuhenki vai nos trazer para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Hã? Já terminou!? A Paimon nem conseguiu terminar a apresentação...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Bom, vejamos aqui. Oh! Outro desenho da Columbina. Nenhuma surpresa aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "É lindo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Isso é... uma floresta em algum lugar de Nod-Krai? Tem tantos animaizinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Receio que... você teria que voltar ao tempo antes de eu deixar os Filhos da Lua Gelada para ver uma cena assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510312,
					"content": "Uau, a Paimon tá com inveja! Animais fofinhos realmente se juntavam ao seu redor assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Sim, a maioria deles era atraída pelo kuuvahki ao meu redor. Eles se sentiam seguros ao se enroscarem perto de mim desse jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510314,
					"content": "Isso é incrível! Você podia acariciá-los o quanto quisesse sem que eles corressem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Hm... Eu diria que os Texiques eram os mais gostosos de acariciar. São aqueles com os grandes rabos fofinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510316,
					"content": "A pelagem no pescoço de um Cervo de Chifre de Gelo também é bem macia. Faz um travesseiro muito confortável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510317,
					"content": "Qual você prefere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510318,
					"content": "Ahm, nós não temos exatamente o mesmo tipo de experiência para comparar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Mas a Paimon provavelmente escolheria acariciar o rabo de um Texique.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Os Texiques podem ser bem tímidos. Se quiser acariciá-los, eles precisam se sentir seguros primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510321,
					"content": "Ah... Mas eu teria cautela, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510322,
					"content": "Por quê? Eles... mordem, ou algo assim? A—A Paimon promete ser super delicada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "Não. Estou me referindo a um perigo vindo de cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510324,
					"content": "Perigo vindo de cima...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Sim... Os íbis costumam caçar animaizinhos como esses. Precisei dar um aviso a eles para que parassem de perseguir os kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510326,
					"content": "E você só está contando isso pra Paimon agora!? É um milagre ela ainda não ter sido carregada embora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah... Então, da próxima vez que eu vir um, também vou avisá-los de que você está fora dos limites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510328,
					"content": "Da próxima vez? Não, você precisa encontrar um agora, ou Paimon vai ficar com medo demais até de voar pra fora daquela porta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Ah, entendi. Nesse caso, vou garantir que eles saibam que a Paimon é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510330,
					"content": "A melhor companheira de todas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Exatamente! Eles não podem simplesmente sair por aí pegando as companheiras de viagem dos outros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "A pequenina... parece estranhamente curiosa com a ideia de Paimon ser carregada por um íbis de penas longas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760510338,
					"content": "Nem pense em pintar uma cena dessas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "A maior guia de viagem de Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Ah... Paimon fica feliz que você pense assim, mas... Eles provavelmente nem sabem o que é uma \"guia de viagem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Uma fonte de alimento que só iria deixar o estômago deles embrulhado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "Não, nem coloque essa ideia na cabeça deles! E se eles tentarem a sorte!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "Só de olhar já me sinto feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
