			"dialogs": [
				{
					"id": 760780101,
					"content": "Normalmente, uma vez que todos os monstros que seguem a Caçada Feroz são derrotados, a contaminação corrompida deveria desaparecer junto com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Mas essa fissura persiste... Incomum, mas não sem precedentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Vamos vasculhar a área. Talvez ainda reste algo impuro por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
