						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Ah, é uma lanterna. Isso é algo que todos os Guardiões da Luz carregam consigo, e é uma ferramenta essencial para dispersar a Caçada Feroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "A lanterna permanece, e em sua tampa ainda paira o cheiro da contaminação da Caçada Feroz. No entanto, o portador está desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Entendo. Embora intrigante, não é difícil concluir o que aconteceu aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "Os sacrifícios de nossos irmãos Portadores da Lâmpada às vezes são silenciosos como um sussurro. Descobrir que meus colegas se foram dessa maneira é... sempre lamentável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "...Permita-me carregar a lanterna que você deixou para trás, ó sem nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Seu corpo será purificado, e sua luz, reacendida. Ela encontrará um novo lar nos braços de outro Portador da Lâmpada que jure proteger Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins limpa a lanterna e a guarda com cuidado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Essa lanterna deve ser o motivo pelo qual a Caçada Feroz não desapareceu completamente. Vou mantê-la comigo até que alguém da sede possa vir buscá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "...Espere, tem algo embaixo da lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Deve ser uma relíquia deixada pelo mesmo colega. Deve ser guardada junto com a lanterna dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
