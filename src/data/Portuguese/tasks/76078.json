			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Normalmente, quando os monstros das redondezas são derrotados, as fendas daqui deveriam desaparecer sozinhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Então por que a presença da Caçada Feroz ainda persiste...? Isso é muito estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Será que deixei passar algo? Algo mais que tenha sido corrompido pela Caçada Feroz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
