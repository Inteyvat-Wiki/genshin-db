			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Há uma Lanterna do Juramento aqui também. Deve ter pertencido a alguém que veio antes de nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "A lanterna ainda está manchada pela corrupção da Caçada Feroz. Não é difícil imaginar o que aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Desde o dia em que tomamos a Lanterna do Juramento, nossas vidas ficam ligadas à chama dentro dela, até o momento em que cumprimos nossa missão legítima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "A você, que lutou até o último suspiro pela paz e segurança de Nod-Krai, ofereço meu mais profundo respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Levarei sua lanterna por agora. Fique tranquilo, a coroa dos caídos honrados guardará seu legado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "Vou levá-la de volta para o Quartel-General, reacender sua chama e confiá-la a alguém digno de levar adiante sua vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga limpa a lanterna e a guarda com cuidado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Com isso, a Caçada Feroz foi erradicada deste lugar, e o espírito de nosso predecessor finalmente encontrou seu descanso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
