			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "Obrigado, Viajante. Essa foto é perfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "*Suspiro* Finalmente chegou a hora de partir. Quando eu ouço pessoas dizerem coisas como \"Um grande homem está pronto para alcançar suas aspirações em qualquer lugar\", ou \"É melhor viajar dez mil quilômetros do que ler dez mil livros\", eu sempre me sinto tão encorajado e inspirado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Mas quando sou eu quem está finalmente prestes a partir, eu não me sinto encorajado ou inspirado. Tudo que eu quero é ficar aqui mais um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "Viajante, você acha que eu posso encontrar o que busco nessa jornada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Eu não sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Hahaha... Digo, o que eu estou procurando? Será que eu sei mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "Certo, já era hora. Eu vou me encontrar com aquele comerciante. Por favor, Viajante, pegue isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Que'er... Ela não está aqui no fim das contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Cabe a você descobrir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Então... você está dizendo que tudo está nas mãos do destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
