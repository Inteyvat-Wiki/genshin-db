			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "Viajante, ainda bem que você está aqui. Eu quase achei que você não fosse voltar hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380102,
					"content": "Hoje é o dia que eu deixo o Porto de Liyue. Eu incomodei você tanto antes... Eu tenho que te agradecer adequadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380104,
					"content": "Ahem... Eu estava exatamente pensando no que dizer após te ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380105,
					"content": "Agora é hora de eu realmente falar, de alguma maneira eu nem lembro nenhuma das palavras... Olhe para mim, passando vergonha até agora, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380106,
					"content": "Não se preocupe com isso. Tenho certeza que vamos nos encontrar de novo em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Sério? Haha, que notícia maravilhosa! Eu te mostro o lugar quando eu chegar lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380109,
					"content": "Bem, na verdade, eu ainda tenho um último favor para pedir. Você tem um Aparelho Fotográfico, certo? Você se importa de tirar uma foto para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380110,
					"content": "Um marinheiro me contou que é melhor manter uma foto da sua cidade natal com você quando está viajando para o exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380111,
					"content": "Mas eu não tenho um Aparelho Fotográfico, então talvez você fosse gentil o bastante para me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380112,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Faça uma pose!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "P-Pose? É-É da paisagem atrás de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380107,
					"content": "Eu te visitarei em Fontaine em algum momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
