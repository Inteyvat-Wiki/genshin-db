			"dialogs": [
				{
					"id": 761500101,
					"content": "*Cof Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500102,
					"content": "Você está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "...Estou bem. Eu só tive um pesadelo muito, muito longo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500104,
					"content": "...Esqueça. Finja que eu não disse isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500105,
					"content": "Eu não aguento mais. Por que isso continua acontecendo comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500106,
					"content": "Por que sempre comigo... Primeiro mamãe e papai... e agora minha irmã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500107,
					"content": "Está tudo bem. Eu estou aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "...Sim. Eu não estou com raiva de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500110,
					"content": "O que Dex pegou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500111,
					"content": "Eu chamo de Fragmento do Pesar. Pode ser nosso caminho da morte para a vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500112,
					"content": "Vamos nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 761500114,
					"content": "Agora que Zeitlind foi encontrada, vamos tentar achar uma saída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500115,
					"content": "Tem certeza de que conseguimos sair daqui sozinhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761500116,
					"content": "Melanta e Nihilita podem se mover livremente neste espaço, e geralmente trazem pessoas junto. Nesse caso, Dex deve conseguir fazer o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500118,
					"content": "Três Fragmentos do Pesar coletados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500119,
					"content": "Ah, embora eu deva dizer que é um nome temporário, já que eu também não faço ideia do que Dex vai usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500120,
					"content": "E agora, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761500121,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761500122,
					"content": "Vamos seguir a direção indicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
