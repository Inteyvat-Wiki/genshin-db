			"dialogs": [
				{
					"id": 737130101,
					"content": "Tã-dã! Chegamos! Começando desse pedaço raso, vai parecer a paisagem tá se abrindo aos poucos, como se você estivesse caminhando em uma pintura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah... São vocês. E ainda trouxeram alguns companheiros novos? Eles são... cogumelos? Só ouvi falar neles em livros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Uau, tem até uma Melusine por aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "É bom te rever, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "Na verdade. Estou trabalhando. Estou pegando Maralga para a marinada desse ano. Muitos outros retornaram para a vila para ajudar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Enghiene e a pequena Roxane tiraram uma licença para voltar e ajudar. Elas estão trabalhando duro, e eu vou para a água daqui a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Sabe... Enghiene não tava errada. O cogumelo azul parece mesmo com Maralga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Não no sentido de comida! Quero só dizer que são fofinhos, nada de mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737130111,
					"content": "Hehe, você tem um bom olho para reconhecer fofuras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Esses cogumigos são muito fofos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Enfim, é um prazer conhecer vocês. Eu tenho que ir indo, aproveitem seu tempo aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Certo, vamos nessa também. Com nossos cogumigos, vamos tirar umas fotos submarinas iradas em Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Melusines são igualmente fofas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Olá! É um prazer lhe conhecer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
