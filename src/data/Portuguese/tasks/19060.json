			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "Viajante, tenho certeza de que você conseguirá descobrir a verdade. É o trabalho de Shikanoin, não há dúvida sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190602902,
					"content": "Hã... a diretora e Sr. Hiruzo são ambos boas pessoas. Como as coisas azedam quando eles estão juntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190602903,
					"content": "Ryuuji, por favor, cresça um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1906030,
