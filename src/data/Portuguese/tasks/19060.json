			"dialogs": [
				{
					"id": 190603101,
					"content": "Não leve muito a sério as palavras de Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603102,
					"content": "Conte-me sobre Takatsukasa e Ryuuji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "Quer saber mais sobre isso? Se eu puder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603104,
					"content": "Ryuuji considerava Takatsukasa seu pai adotivo, com certeza. Por outro lado, eu não diria que Takatsukasa ajudou Ryuuji sem esperar nada em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603105,
					"content": "Afinal, Takatsukasa não é apenas uma pessoa qualquer. Quando ele conheceu um cara simples e ingênuo como Ryuuji, ele não podia usá-lo como conselheiro. Por outro lado, este último era mais do que ideal para servir de confidente e cão de guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603106,
					"content": "Aliás, Takatsukasa mais tarde teve seu próprio filho. É uma pena que ele nunca o conheceu: ele foi assassinado antes de nascer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603107,
					"content": "*Suspiro* É melhor deixe de lado esse assunto. Vocês não têm um caso para investigar? Não perca tempo aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
