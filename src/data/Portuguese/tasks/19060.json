			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "#Ei, Viajante! A investigação lhe dá dores de cabeça, não é? Você está cert{M#o}{F#a} em fazer o que eu falo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Conte-me mais sobre a Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Ah lá! Esta Sango... O clã Takatsukasa contratou uma ótima detetive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "De tempos em tempos, ela vem apresentar um pedido para reconsiderar o caso Ryuuji. Mas todas as vezes, o Sr. Heizou se recusa. Eu não esperava que ela escrevesse uma carta de reclamação desta vez. Impressionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "Quanto ao motivo pelo qual o Sr. Heizou recusou seus pedidos, é provavelmente porque ele estava com medo de que Sango estivesse em perigo. Afinal, estamos falando do assassinato de uma pessoa importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Sango pode ser a diretora de uma agência de detetives, mas é apenas uma pessoa comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Eles são próximos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Infelizmente, não muito. Eles discutem toda vez que se encontram. Mas acho que o Sr. Heizou ainda se lembra dos bons tempos do passo, ouvi dizer que ele trabalhou com Sango antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "Ele às vezes me pedia para deixar a agência de detetives cuidar de casos pequenos, acho que a ideia era fornecer mais renda a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603010,
					"content": "É por isso que tenho certeza que o Sr. Heizou é uma pessoa muito legal.",
