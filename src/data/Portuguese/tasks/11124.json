			"dialogs": [
				{
					"id": 111240101,
					"content": "Esta placa foi erguida pelo Formatador de Montanha. Ela diz que Azhdaha é um dragão terrível e pede que as gerações posteriores fiquem longe deste lugar... Longe do selo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "É uma pena... Existe uma linha tênue entre o bem e o mal. Se o bem e o mal dentro dele também pudessem ser resumidos em uma única frase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(Olhar silenciosamente para Zhongli, que está parado sob a árvore...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(Em meio ao silêncio, se ouve apenas o som calmo do vento. O tempo parece se transformar em um rio que corre de forma invisível...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(Um momento fugaz, mil anos no mundo mortal. As rochas sentem isso, assim como a terra e os deuses.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
