				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "#Olá, olá, querid{M#os}{F#as} ajudantes. Chegaram na hora certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Unf, como se tivéssemos escolha. Apenas queremos nosso pagamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Então, Miko, o que podemos fazer para fazer acontecer essa Hyakkiyakou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "E para ser sincera, não fazemos ideia do que isso significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Pode soar assustador, mas Hyakkiyakou é basicamente uma reunião de youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Antigamente, nas reuniões dos youkai, quando já todos tinham bebido o suficiente, eles começavam voando pelo céu um por um, usando seus poderes youkai. Eles eram tantos que sua sombra acabava por cobrir toda a lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Mas agora, as memórias dos youkai que vazam das Linhas Ley são fracas. Eles não conseguem mais voar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Portanto, irei conduzir uma cerimônia de confraternização para eles, reunindo todas as memórias perdidas em um único lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Quando chegar a hora, eles se reunirão no céu acima do Grande Santuário Narukami. Então, quando seu poder se esgotar, eles regressarão ao lugar a que pertencem satisfeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Então é isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "Todas os preparativos para o ritual foram feitos com antecedência. Você lembra do encantamento e da menção da \"noite sem lua\" que coloquei em nosso livro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Ah sim, algo sobre recitar \"Os Feitiços Secretos da Madame Kitsune\" durante a noite sem lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Isso mesmo. Na verdade, ele não é um encantamento para realizar desejos, mas sim um feitiço para ajudar a acalmar as memórias das Linhas Ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Quando chegar a hora, vamos nos juntar e ajudar a enviá-los para o seu caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "O que eu posso fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Iniciarei os preparativos do ritual em breve. Nesse momento, espero que vocês possam me ajudar com duas coisas:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Primeiro, pedir para as sacerdotisas descerem a montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Durante a Hyakkiyakou, muitas memórias dos youkai estarão pairando acima do Grande Santuário Narukami. Se pedirmos para as sacerdotisas saírem, evitaremos o potencial problema de alguma delas ser possuída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Depois disso, irei começar o ritual, e as memórias começarão a se juntar. Isso levará algum tempo. Preciso que vocês estejam no sopé da Montanha Yougou durante essa fase do ritual para observar os movimentos dos monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "As memórias normalmente são dispersas e não representam nenhuma ameaça. Mas quando sua energia está concentrada, é possível que possam perturbar os monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Eles poderão ver isso como uma oportunidade para subir a montanha. Preciso que vocês possam pará-los se isso acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Paimon entendeu. E depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Hmmm... Bem, depois disso se vocês quiserem vir até o Grande Santuário Narukami dar uma olhada nos youkai, eu não vou lhes impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Muito bem, {NICKNAME}, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
