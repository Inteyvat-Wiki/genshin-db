				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "Srta. Quqing, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220302,
					"content": "Fizemos o pedido das suas bebidas. Será carregado nos barcos amanhã e transportado para o píer o mais rápido possível! Aqui está seu recibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220303,
					"content": "#Já? Uau, vocês são muito rápid{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220304,
					"content": "Eu... Eu... Eu vou preparar um chá para vocês com minha melhor água da nascente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220305,
					"content": "Não foi nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "Sim, sim. E temos o pedido de outras pessoas também. Você não precisa servir a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220308,
					"content": "#Paimon deseja que seus negócios deem certo! Na próxima vez, vamos vir aqui para tomar esse chá junt{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220309,
					"content": "Bem, então na próxima vez eu garanto que farei suas bebidas favoritas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220310,
					"content": "Voltem sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220306,
					"content": "Nós já conseguimos nosso pagamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
