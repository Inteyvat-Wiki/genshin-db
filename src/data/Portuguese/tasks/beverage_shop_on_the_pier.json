			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diane"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "#Bem-vind{F#as}{M#os} à Cauda do Gato! O que vocês gostariam de comprar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220202,
					"content": "Olá Srta. Diane! Trouxemos um grande negócio para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220203,
					"content": "Vocês explicam as condições do pedido de Quqing a Diane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "Oh? Vocês estão falando daquela nova loja de bebidas no píer de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220205,
					"content": "Alguns marinheiros que vieram do Porto Dornman mencionaram essa lojista. E parece que a Srta. Margaret também comprou ingredientes dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220206,
					"content": "E recentemente, quando Quqing estava vendendo bebidas para os marinheiros no cais, também pediu que eles promovessem a nascente d'água da Vila Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220207,
					"content": "Ela compra a água a um alto preço na Vila Qingce, e revende onde há demanda. Mas só ganha o custo básico de sua mão de obra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220208,
					"content": "Com a ajuda dela, as pessoas de outros locais podem fermentas vinhos usando as águas da Vila Qingce, e com isso os idosos da Vila Qingce conseguem uma fonte de renda. É como matar dois coelhos com uma cajadada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220209,
					"content": "Oh, então é assim que funciona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "Uau, Quqing é uma pessoa ótima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220211,
					"content": "Sim. E talvez a Cauda do Gato se torne uma parceira de longo prazo dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "Diane"
				},
				{
					"id": 705220212,
					"content": "Enfim, vamos ao que interessa. Quanto vocês vão pagar por essas Bagas de Menta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diane"
				}
			]
		},
		{
			"id": 7052203,
