			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "#Bem-vind{F#as}{M#os}! O que gostariam de beber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220102,
					"content": "Hmm, pelo seu vestuário, vocês não são daqui, né? Me pergunto se meu chá poderia se adequar ao seu paladar ou não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220103,
					"content": "Vou começar preparando uma chaleira com Folhas de Chá Branco Yunlai. Se vocês não gostarem, podem voltar depois. Acho que até lá conseguirei que alguém pegue as bebidas especiais do Festvinho de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220104,
					"content": "#Obrigad{F#a}{M#o}. Não somos clientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "Sim! Somos ajudantes de confiança! Paimon ouviu dizer que você publicou uma comissão no Festvinho solicitando que alguém ajudasse com pedidos de bebidas, por isso estamos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220107,
					"content": "Se você quer fazer algum pedido de bebidas, pode dizer para a gente que nos encarregamos dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220108,
					"content": "Vocês vieram para Liyue para ajudar com os pedidos de clientes? Uau, vocês são muito gentis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220109,
					"content": "Eu estava preocupada que ninguém aceitar uma comissão como essa... Sinto muito por incomodar vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220110,
					"content": "Ouvi de marinheiros que foram para Mondstadt que a especialidade da <color=#00E1FFFF>Cauda do Gato</color>, chamada de \"Baga de Menta\" é refrescante e relaxante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220111,
					"content": "Quero pedir <color=#00E1FFFF>65 caixas de \"Baga de Menta\"</color> para vender aos marinheiros junto com outras bebidas. Desta forma, eles podem manter o bom humor e eficiência no trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220112,
					"content": "No passado, os comerciantes de Mondstadt também preparavam os equivalentes designados de acordo com minhas necessidades. Desta vez, de acordo com as regras do Festvinho, consegui algumas \"Geleias de Vinho\" antecipadamente e darei todas para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220113,
					"content": "O dinheiro que deixei separado é de uma estimativa aproximada, podem ficar com o troco como recompensa por seu trabalho duro. Apesar disso não ser suficiente para expressar toda minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220114,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#Relaxa, 65 caixas de \"Baga de Menta\", né? Pode contar com Paimon e {NICKNAME}. Fazer comissões são nossa especialidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220117,
					"content": "Voltaremos em breve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705220115,
					"content": "Não foi nada demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "Nós estamos aqui para ajudar com pedidos de bebidas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
