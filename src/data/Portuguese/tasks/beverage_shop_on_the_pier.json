			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "Muito obrigada pelo pedido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220402,
					"content": "Com essas bebidas especiais, os marinheiros poderão saciar sua sede com sabores diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220403,
					"content": "Sabores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "Sim. Os marinheiros têm gostos diferentes. Alguns preferem chás leves, outros suco agridoce... Se você beber sempre a mesma coisa, acabará enjoando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220405,
					"content": "É por isso que eu sempre renovo o estoque da loja com bebidas de sabores diferentes e tento satisfazer as necessidades dos marinheiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220406,
					"content": "Sobre a loja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "Como os marinheiros me fizeram um grande serviço, eu abri minha loja nesse lado do píer para servir bebidas para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220408,
					"content": "Mas eu não tenho muita experiência, e os negócios estão avançando lentamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				},
				{
					"id": 705220409,
					"content": "Até a próxima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "Até a próxima! Tomem cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quqing"
				}
			]
		},
		{
			"id": 7052221,
