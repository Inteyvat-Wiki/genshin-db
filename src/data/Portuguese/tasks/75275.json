			"dialogs": [
				{
					"id": 752750201,
					"content": "(Uma antiga Placa de Pedra, com a maior parte de sua inscrição desgastada...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750202
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 752750202,
					"content": "...Kiongozi já se foi há mais de uma década...",
