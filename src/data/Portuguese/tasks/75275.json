						752750203
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 752750203,
					"content": "...grande vitória...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752750204
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 752750204,
					"content": "...construíram este santuário... para honrar os que se foram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Pedra"
				}
			]
		},
