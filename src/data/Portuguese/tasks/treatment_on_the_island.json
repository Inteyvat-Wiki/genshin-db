			"dialogs": [
				{
					"id": 721380201,
					"content": "Oh, você voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380202,
					"content": "Você trouxe os ingredientes medicinais que mencionei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
		{
			"id": 7213803,
			"completionStepIds": [
				7213807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213807",
							"2"
						],
						"stepId": 7213807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213802",
							"3"
						],
						"stepId": 7213802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380301,
					"content": "Ótimo, ótimo. O caule e as folhas estão intactos, e também frescos... Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380302,
					"content": "Isso é tudo, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "Muito bom, devem ser suficientes. Posso começar a pesquisa em novos remédios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380304,
					"content": "Obrigado novamente pelo seu trabalho. Aqui está a recompensa que lhe prometi, espero que lhe satisfaça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380305,
					"content": "#Falando nisso, forasteir{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380306,
					"content": "Ah, me desculpe. Eu já lhe incomodei muito, mas ainda não sei como lhe chamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380307,
					"content": "#Pode me chamar de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}, se você estiver interessad{F#a}{M#o} em me ajudar, volte aqui depois.",
					"roleType": "TALK_ROLE_NPC",
