					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Na sua futura jornada, {NICKNAME}, preste atenção às ervas medicinais que encontrar na ilha. Basta deixar na cesta de bambu na frente da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Darei sua recompensa, assim como prometido. Mas temo que você terá que esperar um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#Se você estiver ocupad{F#a}{M#o} com outras coisas, não tem problema, também posso encontrar outra pessoa que possa me ajudar.",
