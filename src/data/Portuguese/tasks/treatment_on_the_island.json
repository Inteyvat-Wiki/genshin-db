	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Ei! Eu não sou uma pessoa suspeita, sou apenas um médico local!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Se você não acredita em mim, posso lhe levar até minha casa. Se quiser algo, pode pegar, só me deixe ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Ou você pode me levar para o seu General Kuhou! Ele me conhece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Acho que você entendeu algo errado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "Hã? Você não parece alguém do Shogunato... Nem de Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "#Você é {F#uma forasteira}{M#um forasteiro}? Por que está aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Bem, de qualquer maneira, seria melhor se você saísse daqui o mais rápido possível. A Ilha Yashiori é muito perigosa agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Até agora, não há sinal que o Tatarigami desaparecerá, e a Comissão Tenryou não irá se retirar nem tão cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "A ilha já não é mais habitável, muito menos turística.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "#Se você é {F#uma forasteira}{M#um forasteiro} que fugiu para evitar a prisão pelo comissário, vá para o oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "A Comissão Tenryou não dá boas-vindas para fugitivos incomuns. Mas os piratas talvez possam lhe receber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "O que aconteceu na ilha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "#Hmm... Veja você mesm{F#a}{M#o}. Veja o que as pessoas da cidade e de Sangonomiya fizeram conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Primeiro, foi a explosão em Tatarasuna. O céu estava manchado de cores estranhas naquela noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Muitos parentes e amigos perderam seus empregos e vidas na pobreza. Muitos foram feridos gravemente e estavam péssimos quando retornaram para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "E muitos de meus amigos... Sequer conseguiram escapar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "E então, as pessoas de Sangonomiya destruíram os Amuletos que suprimiam os restos da Serpente. O Tatarigami subiu e todos na ilha fugiram apressadamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "As doenças estranhas trazidas pelo Tatarigami também estão se espalhando. A maior parte dos residentes daqui estão muito doentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Temo que seja apenas uma questão de tempo até se espalhar nos campos de ambos os exércitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "Onde é que estamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Aqui era o local original onde o cristal era utilizado para fazer Aço de Jade de Inazuma. Desde que o cristal não ficasse cheio de energia, nós poderíamos viver confortavelmente sem ser reprimidos pelo povo da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "E agora? Mal se consegue encontrar alguém vivo nessa ilha... Bem, quero dizer alguém como eu, um humano com quem possa falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Por que você não sai daqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Você acha que não quero sair? O filho do mestre da Comissão Tenryou me convidou antes... Ele ainda deve estar no exército comandando as batalhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "\"Você tem habilidades médicas, e é diferente das pessoas comuns. É perigoso para você ficar aqui na ilha. Por que não vem comigo, para ser meu médico? Posso lhe recomendar diretamente para meu pai\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "Foi isso que ele disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Antes da guerra, tratar o Comissário era uma honra que eu, como um médico do interior, sequer sonharia em ter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Mas agora... Pense, o Comissário tem muitos médicos a seu serviço, mas e a Ilha Yashiori? Os doentes daqui só podem contar comigo para lhes ajudar como médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "Por isso, eu não vou sair. Não vou tratar de nenhum exército. Meu único inimigo é o Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Posso lhe ajudar com algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Nada... Bem, na verdade, eu preciso de ajuda com algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Eu preciso de algumas plantas especiais para tratar as doenças estranhas causadas pelo Tatarigami. Não sei se funcionarão, mas não faz mal tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Mas, as plantas também foram contaminadas pelo Tatarigami, e elas estão localizadas em áreas perigosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Separação por rios e mares, perseguidos por monstros em todos os cantos, e o cerco do Tatarigami é especialmente intenso aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Com minha coragem e habilidade, seria difícil para lidar com elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "E como um médico, não me atrevo a correr tal risco para coletar essas plantas. Eu tive de usar tratamentos conservadores de ação lenta... E não pude testar novos remédios por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "#Forasteir{F#a}{M#o}, vejo que você tem um Planador consigo. Você deve ser {F#uma}{M#um} Viajante experiente, e será capaz de lidar com perigos como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "Por isso, espero que você possa me ajudar a coletar os ingredientes medicinais corretos nesses locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Venha me encontrar aqui quando você tiver pego os ingredientes. Não se preocupe quanto a sua recompensa, eu ainda tenho algum dinheiro guardado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Apesar de ser uma missão dada por um estranho, espero que você possa considerá-la. Agradeço-lhe muito se a fizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "Falando nisso, tenha cuidado em seu caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Você parece deprimido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "É uma longa história.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Que suspeito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
