					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "\"... Os céus e as águas fluíram pela superfície do cristal, e as manchas púrpuras e vermelhas desapareceram...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "#\"... A criatura antiga das ruínas rolou, golpeada pelo punho de ferro de {NICKNAME}, e foi nesse momento que a estrela do espetáculo chegou!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "#\"... O misterioso aliado que veio no auxílio {F#da}{M#do} Viajante desapareceu no ar, mas a gigante serpente já havia sido despedaçada pelo cristal...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
