				},
				{
					"id": 710800630,
					"content": "Você conta o que aconteceu para Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800631
					]
				},
				{
					"id": 710800631,
					"content": "#Isso é incrível! \"E então, {F#a}{M#o} destinad{F#a}{M#o} Viajante disse: Não venham contra mim um por um, pois posso lutar contra os nove de vocês de uma só vez!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800632,
					"content": "Hã, isso é um tanto exagerado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "Está tudo bem... Agora se você permitir, eu alterarei ligeiramente a história das vidas passadas desses nove cavaleiros com uma certa liberdade criativa...",
