						710800602,
						710800603
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800602,
					"content": "Bem, se você só quer que eu lhe conte minhas histórias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "Eu ficaria muito grato se você concordasse! Bem, pode falar! Sou todo ouvidos!",
