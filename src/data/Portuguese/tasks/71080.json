			},
			"dialogs": [
				{
					"id": 710800613,
					"content": "Vou te contar a história da escuridão e das criaturas do Abismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800614
					]
				},
				{
					"id": 710800614,
					"content": "Você conta o que aconteceu para Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800615
					]
				},
				{
					"id": 710800615,
					"content": "Oh, isso é ótimo! Perfeito! Espere um pouco, deixe-me escrever isso tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "\"... A neblina escura era como uma avalanche, e os dois emissários do Abismo, agora separados, desapareceram assim como apareceram, sem um vestígio sequer...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
