			"dialogs": [
				{
					"id": 710800634,
					"content": "#Uma história sobre a busca por {F#meu irmão}{M#minha irmã}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Você conta o que aconteceu para Taliesin...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "Muito interessante! Uma terra antiga esquecida, sacrifícios não reconhecidos, e uma punição injusta por causa da ignorância... Que grandes temas! Que magnífica história!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "E tais histórias foram o que você encontrou em suas jornadas, e elas estão muito próximas de seu objetivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Muito obrigado por me contar tudo isso. Eu anotarei tudo. Agora, eu não acredito que farei um poema sobre isso no momento... Acho que isso será apenas alguns fragmentos de sua saga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Eu não contarei sua história com as minhas habilidades limitadas... Só peço que você me conte ela quando terminar sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Minha intuição me diz que quando esse dia chegar, meus ouvidos serão abençoados com a história mais heroica deste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
