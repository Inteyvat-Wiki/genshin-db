			"dialogs": [
				{
					"id": 710800701,
					"content": "Obrigado por me ajudar a terminar este poema épico... Ah sim, por favor, fique com essa cópia de meu manuscrito como agradecimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800702,
					"content": "Ufa... Esse manuscrito épico tem tanto minhas emoções como minhas ambições. Fique com ele. É o que posso fazer para lhe compensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
