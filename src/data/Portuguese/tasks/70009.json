			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "Por que aquele titiu Fatoos naum vai celebrar o Festiual da Brisa Florescente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090202,
					"content": "Ele tem um trabalho muito importante para fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "Trabalhu importante? Uh... Mais, o Festivau da Briza Floresxente também naum é importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090207,
					"content": "Mas, mesmo que o titio ali tenha feito algo ruim, ele pode mudar. Ele também pode se tornar uma pessoa boa, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090208,
					"content": "Eu vou falar com aquele titiu. Se ele se tornar uma pessoa bua, vai poder participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090209,
					"content": "Aquele tio ali é muito ocupado, eu posso ir brincar com você. Que tal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "#Está bem... Então, {NICKNAME}, você pode mi levar para brincar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090211,
					"content": "Não tem problema, só não vá para muito longe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "Sim! Vamus brincar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090204,
					"content": "Os Fatui não devem participar do Festival da Brisa Floresta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "Pur quê? É por causa de os... Fatoi serem pessoas muito, muito ruins? Papai dize que eles naum escovaum os dentis antes de durmir e comem com as mauns...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090206,
					"content": "Então saum muito ruins... Se o titiu de meu papai ver, vai ficar com raiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "Viajante? Você precisa de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090303,
					"content": "Lily? Como você está aqui? Onde estão seus pais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090304,
					"content": "#Babai e mamaen tem algo muito importante para faser! Por isso, {NICKNAME} está brincando comigu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090305,
					"content": "Algo muito importante? O Sr. Rudolf e a Sra. Jilliana não deveriam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090306,
					"content": "Senhurita, onde está aquele cachorrinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090307,
					"content": "O cachorro de agora há pouco? Hum! Eu não faço menor ideia. Normalmente eles só ficam no seu canil, e só saem quando dou comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090308,
					"content": "Eles devem ter fugido, pois a cidade está muito barulhenta e animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090309,
					"content": "Você queria brincar com eles, Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090310,
					"content": "Sim! Eu queru brincar com eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090311,
					"content": "Ah! Ok, deixe-me pensar um pouco! Apenas procurar não nos leva a lugar nenhum, então é melhor colocarmos alguma comida para atraí-los a saírem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090312,
					"content": "Hmm, deixe-me pensar... O melhor de se colocar nos pratos dos cachorrinhos é Carne de Ave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090313,
					"content": "Mas... Onde que vamus encontrar issu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090314
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090314,
					"content": "Você pode contar comigo.",
