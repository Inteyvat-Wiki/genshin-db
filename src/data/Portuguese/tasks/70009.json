			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Titiu, vocês Fatoi naum vaum celebrar o Festival da Brisa Florescente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090102,
					"content": "Oh, eu creio que não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "Uh? Você? Ei, por que você está com essa expressão estranha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090105,
					"content": "Estou aqui apenas para falar com essa criança, não fiz nada de mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090106,
					"content": "Parece que os Fatui realmente não celebram o Festival da Brisa Florescente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#{NICKNAME}, você também não vai participar do Festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090108,
					"content": "#Sim, claro! {M#O Cavaleiro}{F#A Cavaleira} Honorável de Mondstadt não poderia perder o Festival da Brisa Florescente! Haha, você vai trabalhar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090109,
					"content": "Você realmente está com uma cara arrogante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "Cof... Cof... Bom, não vou dizer mais. Como você não está fazendo nada, que tal dar uma mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090111,
					"content": "Os pais dessa criança saíram a fazer compras por esse festival tão animado. Por isso, deixaram a sua filha aqui e pediram à Freira para cuidar dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090112,
					"content": "Mas você também sabe que, no Festival da Brisa Florescente, todo mundo na cidade está ocupado. E até mesmo as Freiras não têm tempo para brincar com a criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090113,
					"content": "Por isso, ela se grudou em mim e me pediu para brincar com ela, mas você também sabe que eu não posso sair da Catedral. Por isso, eu apenas pude ficar aqui conversando com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090114,
					"content": "Eu sou um Fatui, então mesmo só falando com essa garota, a Freira fica me olhando sem parar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090115,
					"content": "Ela deve estar pensando que eu, um Fatui, estou conspirando, pensando em fazer alguma coisa ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090116,
					"content": "Então, para que aquela Freira pare de me importunar, bem como pela saúde mental dessa criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090117,
					"content": "#Então eu gostaria de pedir a você, Cavaleir{M#o}{F#a} Honorável, que brincasse com essa garota. Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090118,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "#Oh! Tão direto. Dign{M#o}{F#a} de ser {M#o}{F#a} Cavaleir{M#o}{F#a} Honorável! Achei que você ainda queria discutir algo comigo. Que tipo de recompensa você quer então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090120,
					"content": "Leve logo essa criança para brincar. Eu vou continuar ficando aqui, com aquelas Freiras que ficam me encarando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090121,
					"content": "Ai ai... Quando será que esses dias por aqui finalmente acabarão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090122,
					"content": "Então você quer deixar Lily sair para brincar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "Esqueça... Eu sou um Fatui. Uma pessoa ruim, sabia disso? Como que poderia ter um bom coração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090124,
					"content": "Ah, está bem. Leve logo essa criança para brincar, ela vai acabar ficando impaciente se ficar na Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090125,
					"content": "Eu... Eu tenho que continuar ficando por aqui, com aquelas Freiras me encarando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090126,
					"content": "Ai ai... Quando será que esses dias por aqui finalmente acabarão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
