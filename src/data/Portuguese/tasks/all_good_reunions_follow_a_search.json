			"dialogs": [
				{
					"id": 752470301,
					"content": "*Suspira*... Conseguimos, finalmente! Foi um trabalhão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470303,
					"content": "Oh, você deve ser Cacasha! Você e Cacucu são realmente uma dupla incrível! E, como parte de uma dupla, Paimon sabe bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "Incrível, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "Viu o que eu quero dizer? Quando esses dois se juntam, é quase impossível derrotar eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, eu posso oficialmente dizer que você ganhou seu certificado na \"arte da ocultação\". De agora em diante, você pode se chamar de um mestre malandrão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
					"content": "Oh, uau! Você é o melhor, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470308
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470308,
					"content": "Ei, e quanto a mim? Fui eu quem mais brinquei com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470309
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470309,
					"content": "Você também é incrível, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470310
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470310,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470311
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470311,
					"content": "Uh... Acho que ele tem algo para nos dar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470312
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470312,
					"content": "Cacasha presenteia um Ovo de Presente Dourado para o grupo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						752470313
					]
				},
				{
					"id": 752470313,
					"content": "Oh! Mais um Ovo de Presente Dourado, e mais uma foto também. Acho que já vi esse símbolo pelo Mercado da Brisa Tranquila...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470314
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470314,
					"content": "Cara... Por que sinto que temos outro desafio a caminho...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470315
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470315,
					"content": "Isso é algum tipo de caça ao tesouro secreto, escondido pelo resort? Tenho que ir até o fim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470316
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470316,
					"content": "Ir até o fim, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470317
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470317,
					"content": "Parece que Cacucu está se divertindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470318,
					"content": "#Bem, você não pode ter uma aventura sem {NICKNAME} e Paimon! O que me diz, quer ir dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470319,
					"content": "Definitivamente! Vamos até o fim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470320
					]
				},
				{
					"id": 752470320,
					"content": "Certo, acho que então também irei junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				}
			]
		},
		{
			"id": 7524704,
