				"points": []
			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "Olá novamente, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Mais cedo, eu estava tentando contar para Ifa que ele errou a data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Mas, eu me segurei. Eu acho que parte de ser maduro é saber quando é melhor deixar as coisas para lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
