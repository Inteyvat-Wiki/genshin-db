					}
				]
			},
			"dialogs": [
				{
					"id": 752470401,
					"content": "Encontrei! Tínhamos razão quanto ao Mercado da Brisa Tranquila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470402
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470402,
					"content": "Mercado da Brisa Tranquila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Calma aí, mano. Sei que você tá animado, mas a gente tem que entender a situação primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470404,
					"content": "Ahem... Aproximem-se, queridos convidados! Escolham um ovo, qualquer ovo! Que hoje seja seu dia de sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470405
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470405,
					"content": "Experimente-os gratuitamente! O que me diz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470406
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470406,
					"content": "Oh, então foi aqui que a foto estava nos levando. Deve ser daqui que os Ovos de Presente Dourados vêm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470407,
					"content": "Bem, hehe... Vamos ver até onde essa maré de sorte vai nos levar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470408,
					"content": "V—Vamos lá! Os ovos de presente estão todos preparados para a colheita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470409
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470409,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470410
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470410,
					"content": "Você primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470411
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470411,
					"content": "Serio, mano? Não me diga que você realmente acreditou nessa história de \"azar de ser o primeiro\"? ...Tudo bem, tudo bem. Faça do seu jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470412
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470412,
					"content": "Pela sorte dos Asha, me dê algo bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470413
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470413,
					"content": "Uau, Bolachas Saurus! Boa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470414,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470415
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470415,
					"content": "Pff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470416
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470416,
					"content": "Você não gosta de Bolachas Saurus, Ifa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470417,
					"content": "Oh, não me entenda mal, nós dois amamos elas. Mas, quando se trata de Ovos de Presente Dourados, elas não são exatamente um dos melhores prêmios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470418
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470418,
					"content": "Tanto faz, qualquer coisa que seja gostoso serve para mim. Aqui, todo mundo pode experimentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470419
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470419,
					"content": "Pode rir de mim à vontade, mano. Só espere até você pegar um daqueles Ovos de Magma estranhos, e veja se eu te ajudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470420
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470420,
					"content": "Impossível. Você não consegue resistir a ajudar as pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470421
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470421,
					"content": "Agora... Há algum ritual especial que eu deveria fazer antes de abrir o ovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470422,
					"content": "Qualquer coisa que você ache que vai ter dar sorte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470423
					]
				},
				{
					"id": 752470423,
					"content": "Entendido. \"Time de Patrulha do Clã das Plumas de Flores — abra!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470424
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470424,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470425
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470425,
					"content": "Uau, é a especialidade do Clã das Plumas de Flores, \"Canto com Alegria\"... Acho que o ritual realmente funcionou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470426,
					"content": "Legal! Aceito qualquer coisa, menos a Sopa Fascinante, honestamente. Estou tão cansado dessa coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470427
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470427,
					"content": "Acho que dei sorte com esse tubo enorme de doces! Manda brasa, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470428
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470428,
					"content": "Você é o melhor, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470429,
						752470431
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470429,
					"content": "Após almoçar com os Biscoitos Sauros, Cacucu mastiga todos os docinhos.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470430
					]
				},
				{
					"id": 752470430,
					"content": "Todo esse açúcar dá uma animada a todos...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470431,
					"content": "É a vez de Paimon, é a vez de Paimon! Hmm, o que ela deveria dizer para dar boa sorte... Ah, já sei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470432,
					"content": "Ahem... \"Tem que ser o grandão! Vamos lá, gostosinho, gostosão!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470433,
					"content": "Hehe... Oh! É a sopa que Ororon não queria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470434,
					"content": "Boa, Paimon! Algo que você sozinha pode ficar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470435
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470435,
					"content": "Uh, bom ponto. Sobra mais para Paimon, então! Hehe, hora de comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470436,
					"content": "Ah, tão doce e refrescante! Perfeito para a estação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470437,
					"content": "Certo, faltam vocês dois... Quem quer ser o próximo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470438
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470438,
					"content": "Sem pressa, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470439,
						752470440
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470439,
					"content": "Eu vou primeiro, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				},
				{
					"id": 752470441,
					"content": "Vai nessa, Viajante! Ah, e não se esqueça de pensar em algo de sorte para dizer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470442,
					"content": "(Algo de sorte, hein...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470443
					]
				},
				{
					"id": 752470443,
					"content": "(Inspiração profunda...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470444
					]
				},
				{
					"id": 752470444,
					"content": "Equipe de Aventura de Benny, vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470445
					]
				},
				{
					"id": 752470445,
					"content": "Gemas Brilhantes... Uau, outra coisa doce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470446,
					"content": "Hehe, isso me lembra o dia em que aceitei meu discípulo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470447
					]
				},
				{
					"id": 752470447,
					"content": "#Parece que {M#o vovô}{F#a outra vovó} está perdid{M#o}{F#a} em algumas lembranças bonitas. Acho que isso foi um sorteio de sorte, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470448
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470448,
					"content": "Certo, Cacucu, é sua vez. Mostre para eles o que você pode fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470449
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470449,
					"content": "Vá em busca da vitória, mano! Ou só... seja melhor do que o Ifa, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470450
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470450,
					"content": "Como você quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470451
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470451,
					"content": "Vamos lá, mano! \"Prazer em te conhecer, mano!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Uau... O que é aquilo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "Ponto! Ponto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "Bem, olhe para isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "Ahem... Eeee temos um vencedor! Parabéns ao Sr. Cacucu por se tornar o terceiro cliente do dia a ganhar nosso grande prêmio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "Além desses Bolsinhos Asha — nosso prêmio mais exclusivo — nós estamos felizes de premiar o Sr. Cacucu com uma porção de cada prato disponível em nossos ovos de presente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Sério, mano?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Sim, sério, mano?! Quem diria que o Cacucu seria o sortudo daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Haha, parabéns, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Cacucu, meu bom mano... Ah, não, meu bom senhor, eu tenho um pedido humilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "Dizem que a sorte pode ser transmitida com um aperto de mão. Você se importaria se eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Haha! Sem problemas, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Todos seguem Ororon e sacodem a asa de Cacucu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "É uma sensação contagiante. Logo, todos estão acariciando a cabeça dele também.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "É tão perfeitamente redonda e macia. Você quase não quer que o momento acabe.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hehe, isso deve ser suficiente para dar sorte para a Paimon pelo resto do ano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "#Você pode contar com isso, Paimon. Porque você tem um{F#a} companheir{M#o}{F#a} muito especial ao seu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "P—Por que você está olhando para mim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Bem, esse foi o seu plano desde o começo, não foi? Hora de falar a verdade, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Uh, do que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Espera, então a sorte do Cacucu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Tá, tá. Não é nada de mais, tudo bem? É claro que o carinha é sortudo de ter um mano como eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Pare de se esquivar da pergunta e seja direto. Você montou tudo isso, não é? A pesca, o esconde-esconde, tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "Isso deve significar que você já conhecia aquele aventureiro de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "Não, na verdade, não. Só o conheci um dia antes de você, só isso, e pedi a ele para me apontar na direção certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "E, sim, eu organizei tudo com as fotos para que Cacucu pudesse brincar com o Asha e as Capivaras. E montei aquele negócio de Ovos de Presente Dourados, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Oh, uau, mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Haha... Mas, o Rei Capivara meio que levou para o lado errado. No fim do dia, um animal selvagem não vai entender tudo que você diz a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "Meu palpite é que ele pensou que nós estávamos tentando roubar as coisas que preparei para Cacucu, e é por isso que ele estava bravo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Oh, então ele é chamado de Rei Capivara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Claro que não. Só pensei que deveria usar o nome que você deu para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Oh, uau, mano! Tô emocionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "...Então, agora você sabe! Por acaso caiu próximo à data de aniversário de quando encontrei Cacucu, e eu quis fazer algo especial para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "Não sabemos exatamente quando é a data de aniversário de verdade de Cacucu, então apenas usamos o dia de encontro como uma desculpa para celebrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Cacucu pode até agir tipo um Sauriano mais velho e maduro. Mas, bem no fundo, ele é só um carinha que gosta de brincar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "Sei que você é só um carinha por dentro e por fora, amiguinho. Então, se divirta o quanto quiser, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Mano, mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Oh, você tem algo a dizer, Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Mano, não é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Você não tem que dizer isso. Eu entendo. Nós te amamos também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "É, não fique envergonhado, mano. Enquanto estivermos aqui no resort, você é tão livre quanto um Qucussauro selvagem. Tudo que você precisa fazer é se divertir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Feliz aniversário, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Mano! Mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Foi tudo por causa de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "Devemos guardar o melhor para o final.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
		{
			"id": 7524750,
