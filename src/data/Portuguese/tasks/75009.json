			"dialogs": [
				{
					"id": 750090101,
					"content": "Trezentos Mora por entrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090102,
					"content": "Rola um desconto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "O preço é definido pela Associação de Relíquias Saurianas e não pode ser negociado. Até onde sei, esse já é o local de escavação mais barato e está aberto há mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090106,
					"content": "#Mas atualmente, às vezes recebemos sonhador{M#es}{F#as} como vocês que querem tentar a sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090107,
					"content": "Afinal, talvez nenhuma das centenas ou milhares de pessoas que vieram antes tinham um bom olho para tesouro e deixaram passar uma relíquia inestimável que só parece ordinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090108,
					"content": "Há tanta gente disposta a pagar 300 Mora por um sonho tão belo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090109,
					"content": "Então, tá se sentindo com sorte? Acredita que você vai tirar a sorte grande e enriquecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090110,
					"content": "Rrrooo.... Rawr! Rwar! Rawrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "Minha sorte nunca me decepcionou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, tá a fim de testar sua sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090114,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "Ele parece interessado mesmo! Hehe, só 300 Mora, deixa com Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090116,
					"content": "Poder comprar três lampejos de esperança por apenas 300 Mora é uma bagatela, sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090117,
					"content": "Então desejo a vocês toda sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuipia"
				},
				{
					"id": 750090112,
					"content": "Não preciso disso, tenho um Sauriano de sorte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "É de graça se eu acabar com tua raça, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "Ei, não é assim que a gente faz as coisas normalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
