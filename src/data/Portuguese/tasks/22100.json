			"dialogs": [
				{
					"id": 221000201,
					"content": "Como está indo? Já eliminou todos os monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Tudo bem, bem, não há pressa. Eles tendem a manter distância, para não representar uma grande ameaça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Mas se um dos cegos acabar atrapalhando a paz e o sossego daquele jovem cavalheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "A Ilhota de Dihua vai ficar em caos completo, o meu albergue, tem que encerrar por alguns dias até quando tudo voltar à normalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
