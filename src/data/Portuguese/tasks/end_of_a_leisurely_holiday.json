			"dialogs": [
				{
					"id": 765100101,
					"content": "Isso deve ser suficiente para provar que isso não é algum tipo de arma secreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100102,
					"content": "Hmm... Sim, agora só precisa deixar mais resistente, e talvez assim seja uma ameaça para adultos também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100103,
					"content": "Uau! A atmosfera tá toda tensa de novo, você não acha que elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100104,
					"content": "Vão brigar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#Sim... Ei, {NICKNAME}, como você tá aqui, que tal nos ajudar sendo árbitro da luta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100106,
					"content": "*Suspiro* Não sei de onde essa obsessão com lutas saiu. É por que eu venci você tão facilmente na última vez? Se é sobre isso, então só supere isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}, fique com seus olhos abertos e veja quem pisca primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100108,
					"content": "Hunf! Todas essas palavras vazias não vão te salvar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100109,
					"content": "Edler parece mais forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100113,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "Uau! Elas não deviam estar só num amistoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100115,
					"content": "Não é tarde demais para admitir sua derrota! Eu te dou três segundos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100116,
					"content": "Três, dois, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100117,
					"content": "Uau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100118,
					"content": "Há um barulho metálico seguido por um silêncio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "Tá tudo bem, Paimon, você pode abrir seus olhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100120,
					"content": "Parece que a pessoa mais tensa aqui era você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100121,
					"content": "O— O quê? Wislawa, você não se machucou!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100122,
					"content": "Edler apenas disparou um tiro de aviso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "Claro, não quero ficar presa em alguma prisão desconhecida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100125,
					"content": "Eu tive que fazer um show. Mostrar a ela que não sou uma comerciante covarde que ela pode manipular facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100126,
					"content": "Assim, da próxima vez que nos encontrarmos, ela vai parar para pensar duas vezes antes de causar problemas para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100127,
					"content": "#Mas, {NICKNAME}, como você percebeu o que estava acontecendo? Você não parece nem um pouco nervos{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100128,
					"content": "A expressão de Edler estava muito relaxada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "Você é perspicaz. Uma ameaça bem colocada é o jeito mais rápido de fazer alguém se render. É uma pena que atalhos raramente são tão fáceis de pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100131,
					"content": "#Sem falar que {NICKNAME} está aqui... Enfim, ainda estou de pé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100132,
					"content": "Eu só espero que da próxima vez que nós nos encontrarmos, eu tenha a chance de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100133,
					"content": "Não comece com isso novamente. Quantas chances você acha que teremos de nos encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100134,
					"content": "Se da próxima vez que eu te encontrar, você estiver de serviço, serei obrigada a responder apropriadamente a quaisquer ações que você fizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100135,
					"content": "Mas se você estiver de férias novamente, vamos jogar mais um ou dois Jogos de Guerra — pelo bem dos meus negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100129,
					"content": "A própria Edler disse: \"Vamos ver quem pisca primeiro.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "Não havia balas no mosquete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "Wislawa parece maior...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}