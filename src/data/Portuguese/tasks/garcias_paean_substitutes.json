				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Senhor, eu sinceramente sugiro que encontremos uma maneira de pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Esses vendedores não passam de ladrões! Como eles podem vender apenas algumas insignias a esse preço tão alto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Talvez seja porque eles notaram que quando você viu as insignias, seus olhos brilharam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Para que você quer essas insignias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "Viajante! Você sempre chega na hora certa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Graças à sua ajuda da última vez, basicamente fiz um lubrificante funcional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Mas logo me deparei com outro problema, quando retrabalhei algumas peças, descobri que... Se fossem feitas de materiais muito rígidos, acabariam danificando outros componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "Além disso, essas partes excessivamente rígidas racharam, em diferentes graus, mesmo com o menor impacto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Assim, comecei a procurar um material que fosse, ao mesmo tempo, resistentes e flexíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Depois de uma pesquisa incansável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "... E depois de constantemente importunar o Sr. Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Pensei que encontraria o material que preciso nas insignias que os Ladrões de Tesouro forjam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Mas... Aqueles mercadores estavam me roubando assim como os Ladrões de Tesouros fazem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "Então é aqui que eu entro, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Eu deveria gravar seu nome no rolamento principal da Aritmeticadora! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Vou ajudar você a procurar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
