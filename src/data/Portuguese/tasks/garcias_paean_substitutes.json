			"dialogs": [
				{
					"id": 230145501,
					"content": "Hmm... Lutong, vou precisar de uma mão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Senhor, você deveria descansar um pouco mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "Viajante, chegou na hora certa! Venha aqui. Gostaria de lhe pedir um favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "O que há de errado com ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Pode-se dizer que o Sr. Garcia está bêbado de café. Além disso, ele não tem dormido muito ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Pelo menos ele decidiu beber café, não álcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, uh... Precisamos encontrar mais algumas insignias... Sabe, aquelas que os Ladrões de Tesouro possuem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "Viajante! Você está aqui. Desculpe, foi mal, não te vi chegando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Você me ajudaria a conseguir algumas insignias? Eu só preciso de algumas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "Você deve descansar um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Eu estou bem, sério. Minha mente está muito clara... , contudo minhas mãos estão tremendo um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145514,
					"content": "#De qualquer forma, por favor, traga algumas insignias, e você será pag{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Quando você conseguir, pode trazer para mim. Eu quero inspecioná-las. Eu tenho que criar o rolamento perfeito dessa vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145512,
					"content": "Nunca achei que café fosse tão eficaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "Bem, você não pode culpar o café. A culpa é do Sr. Garcia, que não dorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
		},
