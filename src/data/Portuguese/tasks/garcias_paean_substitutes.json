			"dialogs": [
				{
					"id": 230145001,
					"content": "Temos que encontrar uma maneira de ganhar Mora, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "Ouvi dizer que há um teatro na Cidade de Sumeru e que estão procurando alguém para fazer alguns cálculos para eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "E aqueles membros da trupe... Você sabe, eles ganham muito dinheiro e não sabem como gerenciar suas contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "E isso significa uma oportunidade para nós, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Você tem talento para cálculos e para negócios, meu caro Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Um momento, deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
