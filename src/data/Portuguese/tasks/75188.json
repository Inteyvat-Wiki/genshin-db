			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "Os três Saurianinhos voltaram, graças a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "Valente Viajante, agradeço muito por sua gentileza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "Minhas costas doem, mas pelo menos meus Saurianinhos estão aqui. Me sinto muito melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "Eu não sou rico, mas tenho uma recompensa. Fique com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}