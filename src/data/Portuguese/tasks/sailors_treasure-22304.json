			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040201,
					"content": "#Olá, amig{F#a}{M#o}! Você deseja comprar alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040202,
					"content": "Mapas do Tesouro",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040203
					]
				},
				{
					"id": 223040203,
					"content": "Mapas do Tesouro? Oh, você quer dizer os mapas de Zhangshun, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040204,
					"content": "Então, você realmente está à procura deste tesouro. Tenho que admitir, eu só guardava por guardar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040205,
					"content": "Você, no entanto, posso dizer com um olhar que você é do tipo aventureiro de verdade. O tipo cujos olhos brilham assim que alguém menciona a palavra \"tesouro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040206,
					"content": "De qualquer maneira, estes Mapas do Tesouro não têm muita utilidade para mim, então você pode ficar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040207,
					"content": "Dito isso, se você encontrar algum tesouro, vamos dividir em partes iguais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040208,
					"content": "Afinal de contas, eu tenho procurado por estes mapas há algum tempo. É justo contribuir com algo em termos de taxas de armazenamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 2230403,
