			"dialogs": [
				{
					"id": 762000201,
					"content": "Com licença, você por acaso viu um gato com listras de tigre por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Um gato com listras de tigre? Hum, não acho que vi... Lumi, você viu um?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Parece que Lumi também não viu ele. Você perdeu o seu gato? Eu posso te ajudar a procurar por ele. Eu conheço esse lugar muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "Ei, Jukka! Nós não temos dinheiro de sobra para contratar uma aventureira. Além disso, é só um gato bobo. Deixa ele ir para onde ele quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Não diga isso, Marja. Ele ficaria triste se ouvisse você falar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Como se ele pudesse entender a gente! Se ele conseguisse, ele não teria nos ignorado, por mais que tivéssemos chamado por ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Não precisa me pagar por isso. Eu ia dar uma olhada na área de qualquer forma, então considere isso um pequeno desvio. Vamos lá, Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Não tinha nada aqui recentemente, mas agora tem tantas Plantas Jarro de Folha Gêmea crescendo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Talvez algum animal tenha trazido as sementes até aqui, mas eu não posso só deixar elas se espalharem assim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
