			"dialogs": [
				{
					"id": 762000801,
					"content": "Gato bobo... onde você está— Hã? Você encontrou ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Ele ficou preso naquelas Plantas Jarro de Folha Gêmea ali. Elas são plantas, sim, mas são plantas carnívoras, e conseguem digerir Vaga-Lunares em apenas alguns dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "Que bom que o encontramos a tempo. Ele só está um pouquinho fraco agora, mas se chegassemos mais tarde... quem sabe o que poderia ter ocorrido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "U—Ufa... Isso é perigoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Hunf, você não pode culpar ninguém além de si mesmo por ter entrado nesse lugar, gato bobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Bem, não é exatamente culpa do gato. Essas Plantas Jarro de Folha Gêmea emitem um cheiro especial. Humanos não são afetados, mas insetos e outras pequenas creaturas podem ser atraídas por ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "É assim que as plantas capturam suas presas. Tem muito mais delas do que o normal por aqui, então até mesmo pequenos animais estão sendo atraídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Oh... Entendi. Enfim, ter tantas dessas plantas crescendo aqui com certeza não é um bom sinal, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Isso mesmo. Se deixarmos isso assim, elas podem causar sérios problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Tudo bem, então a gente vai cuidar da jardinagem. Jukka, venha ajudar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "E por fazer nosso gato bobo sofrer tanto, vamos garantir que essas plantas vão ter o que merecem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Com a ajuda dos dois caçadores de tesouros, as Plantas Jarro de Folha Gêmea, que cresceram de forma incomum nessa região, foram finalmente removidas...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Ufa... finalmente acabou. Hora de voltar para a Cidade de Nasha. Obrigada, senhorita, por nos ajudar a encontrar esse gato bobo. Se não fosse por sua ajuda, quem sabe por quanto tempo ele ficaria preso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Agora que paro para pensar, Marja, se você não tivesse gritado tão alto mais cedo, talvez tivéssemos encontrado ele ainda mais rápido...",
