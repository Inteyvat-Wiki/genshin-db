			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi, você acha que ele está aqui também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "O gato preso foi resgatado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Então é você quem eles estavam procurando, hein? Hum... não parece que você se feriu. Mas se nós tivéssemos demorado mais pra te encontrar... quem sabe o que poderia ter acontecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Enfim, vamos levar você de volta para seus amigos primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
