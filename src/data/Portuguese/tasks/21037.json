			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequena Que'er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Ele deve ter feito isso de propósito, Zhirou! Ele só... Ele só não quer estar comigo! Snif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 210370402,
					"content": "Que'er, você e ele passaram tanto tempo juntos, ele deve saber o que você está pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Dessa vez, ele está determinado a deixar Liyue e viajar para o exterior, ele deve ter suas razões. O que há de ruim em viajar com ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Eu só não quero ir embora daqui! O que há de errado em ficar aqui conosco para sempre? O Clã de Guhua... Eu não dou a mínima para o Clã de Guhua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 210370405,
					"content": "Então por que você não diz isso a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "Eu... *Suspiro*. Ele se interessou pela ideia de reviver o Clã. Se ele soubesse que disse isso, ele me odiaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 210370407,
					"content": "*Suspiro* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
