			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Obrigado, isso deve bastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Você não parece muito animado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Ahahaha... Desculpe, eu não queria te preocupar ou algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "É só que eu ainda me sinto um pouco relutante em sair de Liyue repentinamente, onde vivi por tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Quando você parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Quando os suprimentos estiverem prontos, nós partiremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Ah sim, a aventureira que me levou ao Despenhadeiro também viajará conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Ela ouviu que eu estava indo para Fontaine, disse que estava intrigada e decidiu vir conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "O comerciante está contente em ter outro aventureiro para protegê-lo. Mas para ser honesto, eu não sou muito bom em me comunicar com pessoas que são entusiasmadas... *suspiro*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Nunca pensei que viajaria tão longe um dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
