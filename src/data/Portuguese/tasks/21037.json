			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "Liyue... Quando será que voltarei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "Ah, Viajante! É você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370104,
					"content": "Bem, meu itinerário para Fontaine já foi decidido, e em alguns dias eu partirei com aquele comerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370105,
					"content": "Ele ainda tem alguns negócios para resolver e estou aproveitando esse tempo para garantir que arrumei tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370106,
					"content": "Você não vai visitar o Relevo de Jueyun uma última vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "Haha, eu poderia me arrepender da minha decisão se fizesse isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370109,
					"content": "Eu apenas darei uma olhada na cidade. Eu vivi aqui por tanto tempo, e dessa vez, eu nem sei quando vou poder retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370110,
					"content": "Ah, por sinal, Que'er... *Suspiro* Ela não concordou em ir comigo no fim das contas, mas eu já pedi a Zhiruo para cuidar dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370111,
					"content": "Eu também deixei algumas de minhas economias para ela. Ela é muito mais inteligente do que eu. Ela pode se cuidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370112,
					"content": "E talvez um dia ela entenderá minha decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370113,
					"content": "Certo, Viajante, posso te pedir um último favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370114,
					"content": "Você pode pegar um pouco de terra para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370115,
					"content": "Eu posso ajudar com isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "Alguém como eu que está prestes a deixar sua terra natal, levar algumas lembrancinhas é normal, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370118,
					"content": "Com a terra de Liyue sendo carregada por mim, eu posso pelo menos dizer que não me desconectei completamente desta terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370119,
					"content": "Por que você mesmo não vai pegar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "Hahaha... Como eu disse, se eu fosse sair andando por aqui, várias memórias tomariam conta de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370121,
					"content": "E então, tenho receio que o pouco de coragem que consegui reunir para partir desapareça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370122,
					"content": "Então, eu só posso confiar essa tarefa a você, Viajante. Eu vou marcar o local para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370123,
					"content": "O que é tão especial nesse lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "Ahem... Eu costumava praticar minha esgrima com Que'er lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370125,
					"content": "Enfim! Eu deixarei essa tarefa com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370116,
					"content": "Para quê você precisa disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "Você não vai andar por aqui uma última vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
		{
