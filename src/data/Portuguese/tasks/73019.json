			"dialogs": [
				{
					"id": 730190101,
					"content": "Você consome o orvalho e cresce rapidamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190102
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190102,
					"content": "Olá! Você é um Ara... Ara o quê mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190103,
						730190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190103,
					"content": "Você é o irmão mais velho de Arapacati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190104
					]
				},
				{
					"id": 730190104,
					"content": "Essa foi uma boa jogada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190107,
					"content": "Crescer, crescer, se torna prato delicioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190108
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190108,
					"content": "Ele não parece perceber a gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190105,
					"content": "Arasaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190106
					]
				},
				{
					"id": 730190106,
					"content": "Arasaka! Você é Arasaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301902,
			"completionStepIds": [
				7301902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301902",
							"2"
						],
						"stepId": 7301902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Aah! Nara... Tão grande, tão assustador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "Por favor, eu te imploro... Não arranque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Certo, não vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Excelente. Hehe... Eu cultivei esses Pêssegos Zaytun lentamente, desde que eram sementes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "N-Não! Nara malvados! Como puderam fazer isso com os Pêssegos Zaytun de outra pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "P-porque Nara tem um hábito tão terrível assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "Ainda não fizemos nada e nem arrancamos elas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "Já é assustador mesmo sem ter feito nada, se vocês tivessem realmente feito algo, acabariam me matando de medo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "Não, Arasaka... Pense bem. Você trabalhou tanto por esses Pêssegos Zaytun para o seu Treinamento Culinário... Você não pode desistir aqui. Você não está assustado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "Então, você é Arasaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Oh! C-como você sabe meu nome... De onde Nara saiu... p-para saber meu nome assim de primeira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "Você mesmo disse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Problemas causados por ter uma língua solta. Acabou! Meu nome será usado em uma terrível maldição... Por favor, por favor, me poupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Farei qualquer coisa, menos te dar Pêssegos Zaytun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Calma aí. Na verdade, estamos aqui a pedido de Arapacati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Ara—Arapacati? Ah, minha querida \"irmãzinha\", o sol da densa floresta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "Você conta a Arasaka o que aconteceu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "#Urg... Como que o Festival Utsava já estava chegando...? Oh, você é {M#o}{F#a} Nara que veio para participar do festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "Desculpe ter te chamado de Nara ruim. Você é Nara do bem, pois apenas Nara do bem pode entrar Vanarana e participar do Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "O Festival Utsava está chegando, e se eu voltar a Vanarana sem completar o meu Treinamento Culinário... Não posso... Mas não posso faltar ao festival também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Por que está ficando mais nervoso...? Você ainda não tem os Pêssegos Zaytun que plantou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "...M-Mas não há Pêssegos Zaytun suficientes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "Precisamos do Gosto da Felicidade. Sem o ele, Pêssegos Zaytun são apenas pêssegos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas, e Araphala não acreditam que o \"Gosto da Felicidade\" exista. Eu faço e mostro para eles. Quero que Nara experimente também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "Gosto da Felicidade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Hehe, \"Gosto da Felicidade\"... já provei uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "O \"Gosto da Felicidade\". É branco, se despedaça quando você esfrega... Se transforma em Valuka branco, mas não é duro e doloroso feito Valuka. Guardado em uma bolha dura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "Valuka branca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Valuka branca se refere a areia branca, não é? Mas, o que é uma bolha dura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Paimon não faz ideia. Onde podemos encontrar um \"Gosto da Felicidade\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "Por que está me perguntando isso? Quer roubar o \"Gosto da Felicidade\" antes de mim? Que medo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "Nós apenas queremos ajudar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Me ajudar? Me ajudar com o quê? E-eu posso pegar por conta própria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "É que há muitos Nara andando por aí. E um cheira como Nara Valuka. Urgh, estou com medo... Se houvesse menos Nara, eu poderia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "... Certo, eu não consigo... Não me atrevo a entrar na Vila Gandharva. Muitos Nara lá, e as árvores estão todas mortas. Estou com medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "Tenho um amigo Nara que vive lá. Mas já passou muito, muito tempo. Ele já mudou, não consegue mais escutar a minha voz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "Então o \"Gosto da Felicidade\" que você comentou, na verdade, pode ser encontrado na Vila Gandharva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "O \"Gosto da Felicidade\" não cresce da terra, é feito por Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "Eu realmente quero experimentar novamente, lembro como fiquei feliz quando provei aquele sabor pela primeira vez. Era um sabor tão incrível, tão incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "Estávamos juntos na floresta com o amigo de Nara, contando os números de pedaços do sol que passavam pelas folhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "Cantamos e provamos o \"Gosto da Felicidade\" juntos. Toda vez que vejo a luz do sol entre as folhas, penso nele. Toda vez que penso nele, penso no \"Gosto da Felicidade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "Por isso, quero dar a Arapacati uma prova desse sabor. E, quando o Festival Utsava começar, Nara poderá provar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Entendi, então deixe com {NICKNAME} e Paimon! Não é mesmo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "Eu também quero ser feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Sério? Vocês não estão mentindo para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "Mas tem tantas pessoas na Vila Gandharva! A quem deveríamos perguntar por pistas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "Já sei. Um tempo atrás, vi um Nara passando por aqui e que estava <color=#00E1FFFF>indo para a Vila Gandharva</color>. Ele estava levando isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "Ele tinha uma coisa grande nas costas. É o que Nara usa para carregar coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "Carregava algo nas costas... Hmm. <color=#00E1FFFF>Provavelmente era uma mochila ou uma cesta</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "Certo! Vamos te ajudar a encontrar o \"Gosto da Felicidade\" agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "Já que prometi para Arapacati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Aah! Paimon, você é assustadora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "Ei! Paimon só quer ajudar Arasaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "Bolha dura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "Esse \"Gosto da Felicidade\" que você fala é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "Já sabíamos desde o começo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "O quê!? Já sabia desde o começo? Então vocês já estavam me vigiando há muito tempo... o que vocês querem de mim afinal...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "Poderiam ser Pêssegos Zaytun? Não, sem chances, se quiser outra coisa eu dou... Mas Pêssegos Zaytun não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
