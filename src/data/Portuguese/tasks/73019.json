				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "Minha família sempre foi um grupo de comerciantes andarilhos, do Despenhadeiro a Sumeru. Importamos gemas raras de Liyue, então exportamos especiarias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Uma vez, devido algumas coisas... não me lembro bem, de qualquer forma, o pai me deixou na Vila Gandharva durante muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Me lembro de estar na floresta e fiz um amigo. Corremos juntos até um lugar, e depois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Não me lembro de nada que tenha acontecido depois disso. Qual era o seu nome, como ele era, eu não me lembro de absolutamente nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Me lembro apenas que me pareceu um momento feliz. Então o pai finalmente voltou e foi me buscar. Já pensei em voltar para procura-lo, mas nunca tive a oportunidade e depois até acabei esquecendo disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Se não fosse pelo fato de você ter me pedido por açúcar, eu teria esquecido todas essas coisas. Por que as coisas são assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
