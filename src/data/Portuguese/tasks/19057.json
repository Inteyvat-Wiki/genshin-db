				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "Não é fácil lidar com o Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Eh? Querem saber o que aconteceu o velhinho? Na verdade, não há muito a dizer, foi tudo muito simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Quando eu soube que era o Heizou que estava investigando, eu sabia que tinha acabado. Não foi preciso muito esforço para eu confessar tudo, afinal, é de \"A Tempestade\" que estamos falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "\"Tempestade\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Esse é o apelido do Heizou, você não ouviu falar? Era assim que os presos o chamavam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "Nenhum lugar para escapar, nenhum lugar para se esconder. Para os criminosos, Heizou é como uma tempestade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "Hã, se eu soubesse, não teria feito nada disso em primeiro lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
