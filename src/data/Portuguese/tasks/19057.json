			"dialogs": [
				{
					"id": 190570701,
					"content": "Me desculpe pelo que disse antes, não sei o que deu em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Ah, Sr. Heizou? Acho que ele odeia pessoas como eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Embora ele se contenha e use palavras educadas e amigáveis, consigo sentir que sua atitude em relação a trapaceiros e outros prisioneiros é um pouco diferente... Ele parece odiar muito os trapaceiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Ele também já foi enganado? É incrível, quem é tão esperto o suficiente para enganar o Sr. Heizou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
