			"dialogs": [
				{
					"id": 190570801,
					"content": "Viajante, Como você está? Meu irmão lhe causou muitos problemas, suponho? Esse menino tem um temperamento infernal, mas ele realmente não tem más intenções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Se alguma negligência te ofender, é só dar-lhe uma lição, e se ele resistir, você pode dizer que eu estou bem com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
