					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410702,
					"content": "Ore, venere, ouça a ele, e deixe-o ouvir você!",
