			"dialogs": [
				{
					"id": 721410101,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410102,
					"content": "Olá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410106,
					"content": "Você está me ouvindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410108,
					"content": "Oi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "...Por favor, não me perturbe mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410111,
					"content": "Ele está infeliz, com a perturbação causada pelas palavras da língua, abafando a sabedoria das Palavras do Coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410112,
					"content": "Palavras da língua...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "Palavras em línguas são como a chuva torrencial, que ressoa nos tímpanos e perturba o coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410114,
					"content": "E Palavras de Coração é como a névoa, penetra e envolve a mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410116,
					"content": "Shh! Ele está ouvindo, ele está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410117,
					"content": "Não use sua língua, não use seus ouvidos, ouça o seu coração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410118,
					"content": "Venha aqui, adore, ore e então ouça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410119,
					"content": "Lembre-se de venerar três vezes, três vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410120,
					"content": "(Tente uma vez.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "Passo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "Acene com a cabeça se você pode falar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
