					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410602,
					"content": "Não ouvi nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "Não importa, não importa. Ele está observando, ele está ouvindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410605,
					"content": "Ele está muito feliz e aqueles que se deleitam serão recompensados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410606,
					"content": "Se sua recompensa não estiver do outro lado, será amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410607,
					"content": "Você sabe do que você está falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "Da próxima ver que vier aqui, você verá por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
