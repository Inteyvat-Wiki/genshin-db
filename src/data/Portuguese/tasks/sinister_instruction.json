					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "Ele está carrancudo e vai ficar com raiva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411205,
					"content": "O quê...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "E por quê? Porque é uma mulher! Aquela que se recusa a pagar o tributo! Uma pessoa maldosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411208,
					"content": "Mulher...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "Ela está correndo mas ela não é capaz de escapar dele! São dezoito pares de olhos sangrentos! Milhares de dentes afiados! Sedentos por sangue, inúmeras bocas e línguas!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411211,
					"content": "Ela não pode se esconder, não pode se esconder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411212,
					"content": "Ah, o país do deserto, o mendigo humilde que busca a sabedoria na floresta, nenhum de vocês pode protegê-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411213,
					"content": "Por favor, se acalme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "Você pegou o tributo, vá fazer a oferenda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411214,
					"content": "Oh, isso é bom!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "Oh, droga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "Oh, ele vai ficar bravo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "Oh, ele está vindo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
