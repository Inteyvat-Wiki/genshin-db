						721410705,
						721410706
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410705,
					"content": "Hum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "#Lembre-se, se você venerar três vezes em um dia, você será recompensad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "Washizu"
				},
				{
