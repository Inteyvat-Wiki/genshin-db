						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "Ele é forte porque escuta, vê e ouve tudo porque é forte. E então ele vê tudo o que existe, ouve tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Nem os tolos de Sangonomiya ou os da Ilha Narukami têm qualquer compreensão ou sentimento sobre isso. Então, tudo que eles sabem é lutar uns contra os outros e deixar o sangue cegar seus olhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "Mas você precisa entender isso.",
					"roleType": "TALK_ROLE_NPC",
