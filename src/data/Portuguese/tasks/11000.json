			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "Shhh! Fale mais baixo, eu estou caçando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000302,
					"content": "Eu sempre ouvi falar da quantidade de ingredientes que você consegue encontrar em Mondstadt. Vamos ver se é verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000303,
					"content": "Você é uma caçadora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "Não - Eu sou uma chef! Uma chef em uma missão para encontrar ingredientes raros e exóticos em todos os cantos do mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000306,
					"content": "Meu nome é Xiangling. Eu sou do Porto de Liyue, e você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000307,
					"content": "#Eu me chamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "Olá, meu nome é Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000309,
					"content": "Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000310,
					"content": "Por que você está me olhando assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000311,
					"content": "Que criatura exótica! Ela é comestível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000312,
					"content": "Ela é minha amiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "Que pena, não tenho permissão para comer amigos de outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000316,
					"content": "#Vocês parecem ser {F#boas amigas}{M#bons amigos}. Eu também tenho um bom amigo chamado Guoba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000317,
					"content": "... Isso não é o nome de um salgado de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000318,
					"content": "Hehe... Ambos o salgado e o meu amigo estão em um lugar especial no meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000319,
					"content": "Enfim, você pode caçar algo para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000320,
					"content": "Há muitas coisas por aqui que podem ser usados para cozinhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000321,
					"content": "Eu não consigo capturar sozinha, mas também não queria perder a oportunidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000322,
					"content": "Parece muito complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000323,
					"content": "Não fique assim... Vamos lá, vou preparar algo gostoso para você mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000324,
					"content": "#Algo delicioso? Combinado! {NICKNAME} é muito {M#bom}{F#boa} nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000325,
					"content": "De qual lado você está!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "#Hehe, não se preocupe com isso, {F#sua amiga}{M#seu amigo} já me respondeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000328,
					"content": "Eu não me importo como seja feito, desde que você me traga um pouco de carne crua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000329,
					"content": "Ótimo, então eu vou deixar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000326,
					"content": "Você podia ter me perguntado primeiro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "Claro que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "Não, pela última vez! A Paimon não é uma comida de emergência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000304,
					"content": "Você é uma Aventureira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
