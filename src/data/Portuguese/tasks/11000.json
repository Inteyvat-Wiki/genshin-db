			"dialogs": [
				{
					"id": 110000401,
					"content": "Esses javalis parecem saudáveis e ativos também. Eu aposto que a carne é de boa qualidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
