					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Eu sou o Otto dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "O qu-O que foi que aconteceu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "Por favor, mostre a sua licença de planagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "Err... Hum... Minha licença...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "Voar sem uma licença é contra a lei! Estou prendendo você sob o Parágrafo 7, Artigo 12 do Código Penal de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "Você tem o direito de ficar em silêncio. Tudo o que você disser poderá ser usado contra você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "Espera... Eu sou uma instrutora de voo, nós apenas estamos fazendo um teste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "Oh... Então é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Bom, eles escolheram o pior momento para fazer suas provas de licença de planagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "Sério, por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "#Os Cavaleiros de Favonius receberam um relatório da Irmã na Catedral, mencionando que viu Raptor planando ao redor. Eu pensei que {M#o seu estudante}{F#a sua estudante} fosse {M#um}{F#uma} cúmplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "Raptor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "Um criminoso conhecido em Mondstadt. Ele sempre usa suas asas para planar e cometer seus crimes, então as pessoas começaram a chamá-lo de Raptor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "Ugh, ele voa rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "Até agora não conseguimos capturá-lo... Nosso plano desta vez era atrai-lo à Catedral com um artefato precioso para fazer uma emboscada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "Mas... Ele acabou fugindo com o artefato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Felizmente, a Irmã colocou algumas marcas secretas no artefato usando magia elemental!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "Contudo, ele era muito rápido e não conseguimos nem seguir os rastros que ele deixou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Bem, se você precisar de ajuda, eu estou disposta para este trabalho! Em qual direção ele foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "Até onde eu sei, o último local que ele foi visto foi no Vale Termal, mas isso já faz um certo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#Deixe isso comigo! Eu e {F#a}{M#o} {NICKNAME} vamos atrás dele juntos! Ele não terá chances!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Não se preocupe, assim que a gente pegar este cara nós podemos continuar onde paramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "Eu vou falar com a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "Então... Eu passei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "Foi devorada pelo Barão Coelho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
