			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "Seja bem-vindo a testar a Kaleidolanterna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580102,
					"content": "Hã? Essas lanternas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Ah, é você. Você veio em um bom momento. Eu mudei para um novo conjunto de lanternas desde a última vez que você esteve aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580104,
					"content": "Quer experimentar, ver se você consegue resolver este problema? Não vai ser tão fácil como da última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580105,
					"content": "Por que? A imagem é mais complexa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "Não, não. A imagem é fácil de identificar, e ainda há apenas três partes para combinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580107,
					"content": "A dificuldade desta vez tem a ver com a parte da rotação das lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580112,
					"content": "Ah! Ok, a imagem que deve ser feita hoje é a da <color=#00E1FFFF>Mora</color>. Lembre-se, primeiro você tem que conseguir a imagem certa antes de poder sair à procura do tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580108,
					"content": "A rotação das lanternas está mais difícil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Hehehe, desta vez as três lanternas estão <color=#00E1FFFF>ligadas entre si</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580110,
					"content": "Resumidamente, ao girar uma lanterna, existe a possibilidade de que uma das outras também gire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580111,
					"content": "Faça uma tentativa, você vai ver o que quero dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				}
			]
		},
