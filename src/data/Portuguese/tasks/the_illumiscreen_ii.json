						413580202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580202,
					"content": "Achei todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "#Todos eles? Você é realmente {F#uma caçadora}{M#um caçador} de tesouros muito experiente então... Muita gente desiste e vai embora logo após a primeira tentativa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580204,
					"content": "Já que você encontrou todos os tesouros... Por favor, aceite estes como seu prêmio. Feliz Ritual de Lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
