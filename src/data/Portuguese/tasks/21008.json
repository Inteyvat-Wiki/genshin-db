			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080000,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080001
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080001,
					"content": "Algo de errado com as tochas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080002
					]
				},
				{
					"id": 210080002,
					"content": "Ah, Viajante. Olhe à frente, você consegue ver três torres de vigia? Suas tochas devem ser acesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080003
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080003,
					"content": "Os caminhos ao longo das Planícies de Guili podem ser difíceis de atravessar nos melhores momentos, pior ainda quando há monstros escondidos por aí. As tochas não servem apenas para iluminar o caminho dos viajantes, mas também indicam que não há ameaça de monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080004
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080004,
					"content": "Mas eu estava muito ocupado lutando contra os monstros na área que acabei me esquecendo completamente a alimentar o fogo. Quando me dei conta, já era tarde, o fogo já havia se extinguido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100801,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210080101,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080102
					]
				},
				{
					"id": 210080102,
					"content": "Ah, é porque eles vêm checar o estado das tochas. Eu ainda posso dar uma enrolada por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080103
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080103,
					"content": "Não é bom você ficar parado aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080104
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080104,
					"content": "Então, por favor, Viajante, acenda a tocha para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100802,
			"completionStepIds": [
				2100801
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
