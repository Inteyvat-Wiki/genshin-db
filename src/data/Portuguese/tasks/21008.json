					"nextDialogs": [
						210080402
					]
				},
				{
					"id": 210080402,
					"content": "As Planícies de Guili ficam no topo de uma série de formações rochosas, então algumas áreas são um pouco mais acidentadas, como a encosta em direção à torre de vigia a oeste daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080403,
					"content": "Para o leste, em direção ao mar é bastante plana. Se você tiver tempo, siga esse caminho e confira a Encosta de Yaoguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
		{
			"id": 2100805,
			"completionStepIds": [],
