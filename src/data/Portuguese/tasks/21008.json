					"nextDialogs": [
						210080502
					]
				},
				{
					"id": 210080502,
					"content": "Então eles cuidam de alimentar o fogo, enquanto é minha responsabilidade acendê-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080503
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080503,
					"content": "Soa trivial, mas é importante que cada um de nós cumpra seu papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
