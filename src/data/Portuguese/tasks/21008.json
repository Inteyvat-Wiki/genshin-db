				"points": []
			},
			"dialogs": [
				{
					"id": 210080201,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210080202
					]
				},
				{
					"id": 210080202,
					"content": "Yay! Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080203
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080203,
					"content": "Ao longo desta estrada, há três torres de vigia, cada uma com sua própria tocha. Depois de acender todos eles, volte e me procure novamente, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080204
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080204,
					"content": "#No fim desse caminho, tem uma Estátua dos Sete. Talvez você possa ir e sacrificar, e será abençoad{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210080205
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 210080205,
					"content": "Talvez seja fácil, mas ainda precisa ser feita, portanto, muito obrigado e, por favor, não esqueça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinghuo"
				}
			]
		},
