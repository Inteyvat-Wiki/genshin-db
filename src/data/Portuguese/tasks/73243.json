	"talks": [
		{
			"id": 7324301,
			"completionStepIds": [
				7324301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324301",
							"2"
						],
						"stepId": 7324301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Os avisos pertinentes a Academia e os anúncios de leis internas e externas já foram totalmente transferidos para o Akasha. Este quadro de mensagens é reservado apenas para comunicação entre professores e alunos. Pessoas de fora não devem deixar mensagens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "\"Por um ambiente acadêmico mais descontraído, por trocas acadêmicas mais amigáveis e para que todos possam alegremente escrever suas teses!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430202,
					"content": "\"Apoiamos Vikram para ser o próximo Grão-Curador!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430203,
					"content": "\"Bem-vindo à Associação 'Amigos de Vikram', onde testemunharemos o nascimento de um novo Grão-Curador que é jovem, interessante e sensível às necessidades das pessoas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "\"Nunca se esqueça das três virtudes e dos seis pecados da Academia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430302,
					"content": "\"Admoestação, Criatividade e Práxis... São virtudes que todo pesquisador deve aspirar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430303,
					"content": "\"Rifaet, há décadas, vem praticando esses três pontos pessoalmente.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430304,
					"content": "#\"Bem-vind{M#os}{F#as} ao 'Clube de Leitura Fravashi' onde você andará ao lado do conhecimento e do futuro novo Grão-Curador.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "\"Admiro a busca pela excelência moral dos membros do 'Clube de Leitura Fravashi'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430402,
					"content": "\"No entanto, ouvi dizer que mais da metade dos papéis de Rifaet são escritos por escritores-fantasmas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430403,
					"content": "\"É por isso que apesar de suas conquistas acadêmicas ele mantém um perfil mais discreto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430404,
					"content": "\"Embora os quadros de mensagens não exijam argumentos tão abundantes quanto os artigos, eles não são feitos para atacar outros de forma maliciosa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430405,
					"content": "\"O que vejo nestes comentários são traços de inveja!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430406,
					"content": "\"Além disso, também ouvi dizer que Vikram conquistou o coração de muitas garotas através de sua eloquência.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430407,
					"content": "\"Estas meninas não sabem que ele é um homem casado. Então, você tem inveja da popularidade dele?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430408,
					"content": "\"Ataques injustificados e maliciosos aos estudiosos da Academia são proibidos e, se forem repetidos, a Matra investigará a fonte dos rumores.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "\"Este quadro de mensagens não foi incluído na jurisdição do acesso do Akasha e pode ser acessado sem o sistema.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430502,
					"content": "\"Esteja ciente de postagens fora dos domínios acadêmicos convencionais são estritamente proibidas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "\"Um lembrete caloroso, não deixe de cumprir com os protocolos e etiqueta fora do campus também.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430602,
					"content": "\"O gerenciamento unificado do conhecimento é o marco da existência da 'Terra da Sabedoria', portanto, não perca a oportunidade de estudar na Academia por causa de um erro involuntário!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "\"Recentemente, muitos casos de contrabando de Conhecimento Enlatado aconteceram. Os detalhes serão divulgados aos professores e alunos das escolas relevantes através do Akasha antes do próximo Dia Jnagarbha após a conclusão da investigação.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430702,
					"content": "\"Solicite também a seus orientadores que reforcem a comunicação com os alunos para evitar que eles assumam riscos devido à pressão causada pela tese.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "\"A Academia tem reforçado o uso do Akasha, não penso ser o suficiente. O trabalho de muitos Mahamata é redundante e ineficiente, e em alguns aspectos são piores que os do passado.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430802,
					"content": "\"Imagine se pudéssemos usar o Akasha para atribuir trabalhos diretamente para todos, e as negociações na Bolsa também fossem gerenciadas por ele.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430803,
					"content": "\"Se isso acontecer, no mínimo poderemos nos livrar de metade dos Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430804,
					"content": "\"Tudo o que você diz faz sentido, por isso penso que não conseguiremos o fazer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "\"Como todos sabemos, é trabalho dos pesquisadores buscar sabedoria profunda. Contudo, os assuntos que a Academia tem se envolvido primariamente são os administrativos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430902,
					"content": "\"Hoje em dia, muitos alunos têm que largar suas pesquisas atuais depois de concluir precipitadamente seus estudos e são designados para assumir o trabalho de Mahamata em vários lugares, isso se desviou do propósito original da Academia, não?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430903,
					"content": "\"Já não tivemos uma conclusão para esse problema há muito tempo no Akasha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732430904,
					"content": "\"Somos os únicos mais próximos da luz da verdade enquanto as pessoas ainda estão presas em superstições. Como podemos descarregar a pesada responsabilidade de iluminar o mundo em chamas? Se não nos preocuparmos, sabe se lá no que Sumeru vai se tornar!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "\"Como um estudante estrangeiro, todos os dias na Academia eu podia sentir a grandiosidade da Lorde Maior Rukkhadevata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431002,
					"content": "\"No ritmo de Mondstadt, seriam necessários mais de uma dúzia de livros para resolver as diferentes versões de uma simples pergunta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431003,
					"content": "\"No entanto, depois da existência do Terminal Akasha, contando que você pense em um conteúdo específico, poderá obter o conhecimento correto. Penso que nunca haverá nenhuma invenção maior no mundo do que o Akasha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "\"Depois do Pir Kavikavus, os fundos anuais alocados pela Academia para os Kshahrewar não aumentaram.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431102,
					"content": "\"As pessoas acima apenas dirão que, para uma vida estável e pacífica, devemos controlar rigorosamente a pesquisa, o desenvolvimento e a promoção da tecnologia mecânica. Se você realmente concorda, penso que é melhor fechar o Akasha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431103,
					"content": "\"Não fosse pelo investimento de longo prazo de uma empresária perspicaz como a Lorde Sangemah Bay, os Kshahrewar teria deixado de existir há um bom tempo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "\"Embora confie completamente nos julgamentos dos sábios e orientadores, contudo, o gerenciamento da atual Academia não está dependendo demasiadamente do Akasha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431202,
					"content": "\"Após se acostumar a obter conhecimento a partir do Akasha, o declínio da capacidade acadêmica de nossos acadêmicos expatriados se tornou evidente para todos. Acho que devemos restringir o acesso ao Akasha para novos estudantes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431203,
					"content": "\"Como você pode dizer isso? Você não sabia que aqueles cultos que se esconderam no deserto e não aceitaram os ensinamentos do Akasha já caíram na ignorância e na loucura? Até tentaram devorar cobras venenosas para se ganhar sabedoria!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431204,
					"content": "\"Fora a Lorde Maior Rukkhadevata, é justamente o Akasha que garante a pureza do nosso conhecimento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "Nesta semana, o seminário de botânica ministrado pelo Patrulheiro Florestal Tighnari será realizado no Pardis Dhyai, como de costume. Todos podem se inscrever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431302,
					"content": "Não importa quem seja, desde que gostem de plantas, todos poderão participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431303,
					"content": "Lamentamos informar, mas devido ao número esmagador de inscritos para esta palestra, e para facilitar o gerenciamento do conhecimento, foi discutido e decidido pela Academia que a presença será restrita aos estudantes do Amurta e ao pessoal da Guarda-Florestal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "\"Alguém já leu o último romance da Editora Yae? Tem um autor aqui de Sumeru, parece que se chama... Pursina, algo assim. É só dar uma lida para saber que é um Amurta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431402,
					"content": "\"Se eu tivesse sido admitido no Amurta naquela época... Não só poderia passear pelas regiões montanhosas e de lagos, mas também teria tempo para escrever romances. Eu tinha que ter entrado para o Haravatat, onde minha rotina diária é de ler documentos e escrever artigos, sem nem mesmo oportunidade de ver o mundo exterior.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431403,
					"content": "\"É sério que alguém publicou um romance na Editora Yae antes de mim? Agora meu status como autoridade em estudos de light novels será manchado...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "\"Livros de negócios de fato são completamente diferentes de comandar um empreendimento de verdade... Me arrependo de não ter optado por ficar no Grande Bazar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431502,
					"content": "\"Como resultado, além de não conseguir escrever meus artigos, também não tenho dinheiro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431503,
					"content": "\"Se realmente não der certo, pararei de estudar para me juntar aos Eremitas e já era.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "\"Não quero dizer que tenho qualquer problema com o pessoal do deserto, contudo, penso que o General Mahamatra devia ser um pesquisador renomado, especificamente para problemas acadêmicos que não podem ser resolvidos com algemas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431602,
					"content": "\"Hehe, ainda é bem melhor do que quando vocês do Rtawahist comandavam tudo, pelo menos não há parcialidade. Você acha que ninguém conhece a verdade sobre aqueles relatórios que vocês lançaram?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431603,
					"content": "\"Preste atenção, seu Kshahrewar! Mostre suas provas ao falar, caso contrário procurarei pela Matra para resolver as coisas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "\"Eu posso aguentar aceitar alunos estrangeiros, mas permiti-los que acessem o Akasha é completamente diferente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431702,
					"content": "\"Sem mencionar a má influência que os forasteiros teriam sobre o Akasha, a inevitável saída de conhecimento por si só teria um enorme impacto sobre a economia de comércio exterior de Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431703,
					"content": "\"Não é que existem pesquisadores preocupados com os problemas econômicos? Essa é novidade.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431704,
					"content": "\"Por isso que falam que vocês do Haravatat são um bando de esnobes. Se não fosse para aprender a sintetizar melhor tinta laca, eu não estaria aqui!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "\"Faz muito tempo que não vejo aquele nanico do deserto... Parece que finalmente posso relaxar por um tempo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431802,
					"content": "\"Não sei o que deu na equipe disciplinar que eu nem conseguisse passar no último exame deste semestre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431803,
					"content": "\"Eu lembro que para passar naquele exame somente a frequência não era o bastante. Não culpe outros se você não estudou. Embora tenha havido uma escassez de Matras recentemente, tenha cuidado com o que diz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431804,
					"content": "\"A Matra são nada mais do que uma hierarquia ostentando autoridade. Espera, acabei de receber uma mensagem do Akasha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431805,
					"content": "\"É melhor sermos prudentes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324319",
							"2"
						],
						"stepId": 7324319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "\"... os resultados da investigação sobre a pessoa e os acontecimentos de Zandik... Dastur... causa da morte... possível assassinato...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431902,
					"content": "\"... Zandik... após a exclusão... por Eleazar... contudo, faltam provas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431903,
					"content": "\"...Os registros desaparecem de repente... ano desconhecido... Eleazar começa a se espalhar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431904,
					"content": "\"...Antes de seu desaparecimento...'A Lenda de Varuna'... Obcecado com...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732431905,
					"content": "(O conteúdo a seguir é foi tão desfigurado que nenhum texto significativo é visível.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324320",
							"2"
						],
						"stepId": 7324320,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "\"Foi somente após ler as 'listas estelares' compiladas pelo grande Tabari que finalmente percebi que as guerras dos Arcontes e a destruição dos antigos reinos eram apenas projeções do movimento das estrelas sobre à terra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432002,
					"content": "\"A única coisa que dura para sempre é o céu estrelado acima de nós.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432003,
					"content": "\"Ah, deixando a sentimentalidade de lado, vocês Rtawahist vão resumir todos os eventos da antiguidade em uma amálgama de coisas?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432004,
					"content": "\"Queria que você examinasse isso de uma perspectiva histórica, não só contemplasse os astros.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432005,
					"content": "\"Do que você entende? Isso é o que chamam de exploração das leis do universo, não é toa que vocês Vahumana não conseguem tirar a cara dos livros.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
