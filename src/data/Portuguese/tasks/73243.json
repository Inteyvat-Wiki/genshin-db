				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432401,
					"content": "\"Este Quadro de Mensagens é para o uso interno da Academia. Não publiquem anúncios mentirosos ou ilegais aqui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432402,
					"content": "\"Os Matras continuam a lembrar a todos que prestem atenção ao código de conduta como estudiosos!\"",
