			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "\"Como um estudante estrangeiro, todos os dias na Academia eu podia sentir a grandiosidade da Arconte Dendro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432102,
					"content": "\"No ritmo de Mondstadt, seriam necessários mais de uma dúzia de livros para resolver as diferentes versões de uma simples pergunta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Quadro de Mensagens"
				},
				{
					"id": 732432103,
					"content": "\"No entanto, depois da existência do Terminal Akasha, contando que você pense em um conteúdo específico, poderá obter o conhecimento correto. Penso que nunca haverá nenhuma invenção maior no mundo do que o Akasha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Mensagens"
				}
			]
		},
		{
			"id": 7324322,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
