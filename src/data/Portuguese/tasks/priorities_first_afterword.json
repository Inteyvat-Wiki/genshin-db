			"dialogs": [
				{
					"id": 760580101,
					"content": "Paimon nunca viu um Furão Ladrão tão branco assim antes. E se ele tiver doente ou alguma coisa assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "Tava bem animado ainda agora, e até tentou tomar comida de Jurva. Não parece doente pra mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Talvez seja uma espécie rara? Linnea pode saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Eita! É o ladrão de Mora que esvaziou o cofre secreto de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "O Furão Ladrão tenta fugir, mas as três crianças são mais rápidas. Elas conseguem encurralar ele e, após uma briga rápida, ele desiste. Você aproveita a chance para explicar o que houve...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Então essa não é a primeira vez? Então precisamos dar uma lição nele! Fez algo errado, tem que ser punido. É justo, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Mas... mas ele é só um animal. Ele não entende essas coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Só devolve a Mora da Paimon, e tá tudo certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Enfim, vamos só devolver a Mora da Paimon primeiro. Não é como se o furão pudesse gastar, então deve estar tudo lá ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Eba! Hehe, os fundos secretos da Paimon estão de volta aos negócios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Queria que a gente pudesse ficar com ele. Assim, quando a Helka voltasse, a gente poderia mostrar o raro Furão Ladrão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Hã? Mas ele nem faz nada... Roubar não conta! Por que ele deveria ganhar comida de graça sem fazer nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Tá bom, tá bom, mas o que a gente faz com ele...? Enfim, vamos decidir isso com a Katya depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Até os animais têm que encarar o lado duro da vida algum dia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
