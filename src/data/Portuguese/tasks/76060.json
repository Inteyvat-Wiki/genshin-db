			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Hã? Aquela não é a Maalaus? Será que ela saiu de novo para buscar inspiração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Sim. Mas a pequenina tem estado assim desde que voltou... Como se estivesse perdida em pensamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600104,
					"content": "Hm, talvez o tema desta vez seja super profundo... Tipo quando uma grande artista percebe alguma verdade fundamental sobre o mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Pensando bem, a Maalaus já nos deu um monte de pinturas. A essa altura, já daria para montar uma exposição inteira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hehe, a Paimon mal pode esperar para contar para todo mundo sobre a ascensão da nossa pintora à fama artística! Ah, mas claro, precisaríamos da permissão da Columbina primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hm? Por que isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600108,
					"content": "Bom, é que quase todas são pinturas de você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Ah... Não tem problema, eu não me importo. Parece interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600110,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Ah, parece que a Maalaus decidiu o que vai desenhar! Rápido, vamos ver que tintas temos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Desta vez... Vamos escolher cores profundas e tranquilas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
