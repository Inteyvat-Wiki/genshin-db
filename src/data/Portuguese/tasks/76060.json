			"dialogs": [
				{
					"id": 760600301,
					"content": "Certo, essas devem servir. O que acha, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Sim, parece um kuuhenki feliz para a Paimon! Hehe, será que desta vez vamos ganhar que tipo de pintura...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Ah, já terminou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus parece um pouco triste. Será por causa da pintura? Vamos dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Certo, então... é a Columbina... caminhando sob o luar e olhando para o céu noturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Ah... devo estar olhando para a lua verdadeira além do céu falso. Eu costumava fazer caminhadas à meia-noite assim o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600310,
					"content": "Costumava...? Ah, é mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(A Columbina está praticamente confinada a este jardim agora... mesmo que Nod-Krai seja o lugar onde ela nasceu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Sim, eu olhava para o céu e me perguntava... O que será que realmente existe lá em cima, na verdadeira Lua Gelada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600313,
					"content": "Talvez seja como aqui, cheio de pequenos animais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600314,
					"content": "Ou talvez... não haja nada lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600315,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Você sempre poderia levar alguns com você, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ha... Um pensamento interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600318,
					"content": "Mas... como a lua fica além do céu falso, essa é uma aventura na qual eu preferiria não arriscar levá-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600322,
					"content": "(Um é um \"lar\" onde ela nem mesmo é livre para se movimentar... o outro é um \"lar\" sobre o qual ela nada sabe...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Maalaus e os outros kuuhenki vão sentir muito a sua falta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "E eu também sentirei falta deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600327,
					"content": "Mas, no fim, essa é uma jornada que só eu posso fazer... e a resposta no final dela cabe apenas a mim buscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600328,
					"content": "E quem sabe? Seja qual for essa resposta... talvez seja algo belo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600329,
					"content": "E-Então... vamos ter que ir visitar você! Com Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Certo. Talvez possamos realizar essa exposição de arte na lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600331,
					"content": "Sim, ótima ideia! Está prometido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600333,
					"content": "Espero que sim, de verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600319,
					"content": "Podem haver outras criaturinhas fofas lá em cima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Mm, espero que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760600321,
					"content": "E espero... que, se houver, as criaturinhas recebam bem o retorno súbito e inesperado de sua \"Deusa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Damselette"
				}
			]
		},
