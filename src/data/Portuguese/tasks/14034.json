			"dialogs": [
				{
					"id": 140340101,
					"content": "Finalmente, você chega até a igr{RUBY#[S]Porão}eja que Florian descreveu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340102,
					"content": "Você consegue sentir uma aura ominosa no ar. É como se o inimigo estivesse bem perto de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340103,
					"content": "(Que estranho... Eu realmente me sinto mal aqui. Como eles fizeram isso?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Agora... É a hora da batalha final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340105,
					"content": "Vamos pessoal. Hora de ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Caçador das Sombras"
				},
				{
					"id": 140340106,
					"content": "Florian, espere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Espere por nós do lado de fora. Você já foi corrompido pelo Devorador uma vez, então será fácil para ele entrar novamente na sua mente e tomar controle do seu corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "E iremos confrontá-lo de frente. Se você for controlado de novo, eu não sei dizer nem que tipo de forma seu corpo tomaria dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "Mas é exatamente por isso que eu tenho que ir. Eu preciso ir... antes de todos vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "...! Você quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Sim, eu pretendo atraí-lo para o meu corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "Mas isso é muito arriscado. No pior dos casos, eu teria que te matar. Você compreende o quão perigoso é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Eu entendo. Mas assim, você também terá um alvo claro e visível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Ele vai sofrer para desistir de um corpo que sabe como controlar. Dessa forma, você também não terá que se preocupar com seus amigos sendo controlados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Srta. Clorinde. Diferente de mim, você é uma Caçadora das Sombras justa e poderosa. Esse monstro se libertou por erro meu, então nada mais justo do que eu tomar seu pecado para mim para que ele seja derrotado pela espada de outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Isso é... algo que eu tenho que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Considere isso como um duelo que estou pedindo para defender minha honra. Por favor, não pegue leve comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "...Compreendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Como uma Duelista Representante, eu oficialmente aceito seu pedido de um duelo, e estendo meus mais sinceros respeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "...Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "Vamos lá. É hora de caçar. Aquele monstro irá mais uma vez tremer sob a lâmina de Caçadores das Sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
