					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Sim, te vejo depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Lyney"
				},
