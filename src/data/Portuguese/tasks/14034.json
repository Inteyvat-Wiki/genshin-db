			"dialogs": [
				{
					"id": 140340201,
					"content": "E assim, os monstros foram erradicados, e o feiticeiro foi derrotado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340202,
					"content": "A paz logo retornou para a capital. Aqueles da corte manipulados pelo feiticeiro também reconheceram os seus erros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340203,
					"content": "Alguns lembraram os nomes dos heróis que salvaram sua cidade, mas outros simplesmente continuaram suas vidas sem saber nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340204,
					"content": "Essa é a história dos Caçadores das Sombras. Eles perseguem fantasmas na escuridão, e expulsam ou matam todos que demonstrem ser uma ameaça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340205,
					"content": "Eles sempre protegerão a cidade e as pessoas que servem, mesmo se acabem não sendo lembrados pela história, ou aqueles que salvaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretação por Clorinde"
				},
				{
					"id": 140340206,
					"content": "Ufa... Imagino que finalmente chegamos no final do roteiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Sim. Você conseguiu um dos melhores finais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "É um roteiro muito bom de forma geral. No início achei que seria só uma história de aventura comum, mas quanto mais avançamos, mais impressionada fiquei com a produção da trama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Especialmente a batalha final! Todos os efeitos eram super realistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "Oh, sim, claro, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Ah... Esse é um bom ponto. Nunca esperei que as armas que pegamos naquela sala de tesouros tivessem aquele tipo de efeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "Sim, a minha quase me matou do coração quando começou a brilhar! Dei uma boa olhada depois que saímos, mas acho que nunca mais ela brilhou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "Oh, certo, elas eram adereços, então temos que devolver! Vou só deixar a minha aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "Vocês se divertiram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "É claro. Me avise se tiver outro roteiro como esse da próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Claro, sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "Então eu voltarei agora. Acho que tomarei um tempo para digerir completamente tudo que aconteceu enquanto eu volto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Uma vez que o Sr. Florian esteja acordado, por favor, passe meus cumprimentos a ele. Ele deve estar super exausto para ter desmaiado desse jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "Você tem razão. Ele teve que lidar com muita coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Muito bem, vejo vocês outro dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "...Certo, então, posso perguntar agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Acho que tudo bem, é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Então, o que porcarias estava acontecendo lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "...Ah, você percebeu tudo, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Ahahaha... Naquele momento na caverna, quando você disse para a gente fechar os olhos... Eu diria que teria sido mais estranho se não tivéssemos percebido nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Eu estava morrendo de curiosidade o tempo inteiro. Digo, você simplesmente ficou agindo como se estivesse tudo bem, e Furina realmente achou que tudo isso era planejado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Parecia que nenhum de nós queria ser o culpado por quebrar a ilusão da fantasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Hã? Do que vocês estão falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "O que significa isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "Hã!? Não me diga que você também...! Ah, desculpe, ainda não é tarde demais para cobrir seus ouvidos! Aqui, eu faço por você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Erm... Não é meio tarde para isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Hã? Espera, você quer dizer... Tudo que aconteceu lá atrás não era parte do roteiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Provavelmente é mais preciso dizer que isso nunca foi uma história de um roteiro desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "O quêêêêêê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "...Tanto barulho... Minha cabeça dói...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "Você! Se levante! Explique para Paimon exatamente o que está acontecendo! Agora!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Ahhhhh! Não, por favor, pare de me sacudir! Minha cabeça...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian explica a verdadeira história para todos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "P-Paimon ouviu tudo isso direito? Vocês inventaram toda a última parte na hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "É ruim mentir para as pessoas, mas Florian é um ótimo contador de histórias. Oh, e o improviso da Clorinde também foi de alto nível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "Me lembra daqueles mágicos que fazem um show de improviso impressionante após perceber que esqueceram algum adereço importante em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Se Paimon soubesse que tinha algo errado na sala de tesouros, Paimon teria provavelmente ficado muito assustada e saído voando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Tudo estava sob controle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Acho que nunca ouvi você descrever uma situação como \"fora de controle\". Tenho certeza que qualquer situação que você considere fácil de resolver assustaria qualquer pessoa sensata até a morte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "Acho que só estou acostumada com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Uh... Paimon realmente não quer saber o quão emocionante a sua vida pode ser longe da Trupe. Isso explicaria o motivo de você ser tão boa em inventar as coisas na hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "Quanto a você, Florian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "...Não vou me defender. Vou me entregar para os Gardes. Confessarei meus crimes e aceitarei minha punição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Mas, se você quer saber, eu acho que você já sofreu mais do que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "...O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Embora você tenha ficado cego pela fama e fortuna no início, suas ações durante a batalha final provaram que você é um verdadeiro Caçador das Sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "A cidade provavelmente se aproveitaria melhor de você aqui em cima, caso você continue seu trabalho como um Caçador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Claro, você ainda precisa pegar as chaves e fazer algumas visitas pessoais aos Caçadores que você roubou. E também esteja preparado para aceitar quaisquer termos que eles deem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "...Sim, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Mas fora isso... Acredito que você já provou sua honra naquele duelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "...! Tudo bem... eu vou... fazer como diz. Eu... vou devolver essas duas chaves agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Muito obrigado, pessoal. Farei meu melhor para honrar a segunda chance que acabaram de me dar. Juro pelo meu nome e honra como um Caçador das Sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "Até nos encontramos de novo, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "Haha, eu também só estava entrando na onda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Hã!? Não me diga que Paimon...! Ah, desculpe, ainda não é tarde demais para cobrir seus ouvidos! Aqui, Paimon, eu faço por você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 1403403,
			"completionStepIds": [
				1403403,
				1403404,
				1403405,
				1403406,
				1403407,
