				1403410,
				1403411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1403403",
							"2"
						],
						"stepId": 1403403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clorinde"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "Falando em Caçadores das Sombras... O que vamos fazer com o \"tesouro\" naquela caverna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340302,
					"content": "Deixe como está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340303,
					"content": "Tem certeza? Não quer que as pessoas desta era lembrem-se deles e prestem suas homenagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "Não. Eles conhecem a vida que escolheram — o caminho do Caçador das Sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Até eu gostaria de ser reconhecida apenas como uma Duelista Representante. Não quero que as pessoas me vejam como uma Caçadora das Sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "É definitivamente um caminho bem diferente do de um mágico. Mesmo assim, devo dizer que admiro sua decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Hã? Espera, Paimon acabou de lembrar uma coisa. Se nada que a gente viu foi efeito especial, então por que nossas armas começaram a brilhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "É porque os Caçadores das Sombras do passado frequentemente revestiam suas armas com encantamentos especiais para suprimir os monstros. Sempre que um mostro estivesse perto, a arma começaria a brilhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Aah! Então é por isso que elas fizeram efeito naquele cara perto do fim. Eu pensava mesmo que as invocações estavam fazendo todo o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Bem, tenho certeza de que as invocações também desempenharam seu papel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Oh? E o que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Esse Devorador em particular provavelmente vem da mesma era que os Caçadores que vimos naquela sala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "Os nomes que vocês recitaram todos pertencem aos Caçadores mais corajosos, que já abateram incontáveis monstros. O monstro visivelmente reagiu ao ouvir esses nomes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Hmm, então os nomes podiam carregar esse tipo de poder também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "Navia, quando você estava \"invocando\", você disse—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Hã? Ah-Ahhh! Eu, hmm, quis dizer o que disse, sabe, fazia parte do meu personagem! Digo, é bom que você ouviu eles, mas não me faça repetir. Dá vergonha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Eu realmente adorei aquelas palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "É, tudo bem, digo, você me conhece, é claro que eu diria isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "Uhh... Enfim, não vamos falar mais disso! Eu irei em frente. Não fique para trás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340321,
					"content": "Ah... Ela saiu correndo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Então também vou voltar agora. Pude experienciar uma história incrível hoje. Sinto como se pudesse divertir meus irmãos por uma noite inteira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340323,
					"content": "Adeus.",
