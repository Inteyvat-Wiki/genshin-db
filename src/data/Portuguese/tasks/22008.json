			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Boa Doudou. Você só vai melhorar depois de ter tomado remédio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "Não, não! Eu odeio, o remédio é muito amargo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "#Você é {F#a}{M#o} Viajante? A minha Doudou está sempre doente, e pedi ao Dr. Baizhu passar uma receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Mas a Doudou se recusa a tomar por causa do amargor. *Suspiro* Mas infelizmente a medicina de erva é amarga... É sempre assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Ele só toma remédio quando eu deixo ela comer Tofu de Amêndoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Viajante, se estiver disponível, pode, por favor, ir buscar um Tofu de Amêndoas por mim? Ainda estou tentando convencê-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Então, muito obrigada. Um prato chega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "Que doença ela tem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "*Suspiro* É difícil explicar. Mas o Dr. Baizhu diz que é quase impossível curá-la, e que só pode aliviar os sintomas com o medicamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Talvez a Doudou tenha que tomar remédio pela vida inteira. Ela ainda é muito pequena, não consigo imaginar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Se fosse eu com essa doença! Mas agora... desejo que a Doudou possa sofrer menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "Viajante, por favor, procure um Tofu de Amêndoas, um será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Oi, Doudou, você não gosta do remédio, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "Aquele remédio é bem amargo, muito mais amargo do que o da Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou... A Lulu e os amigos estão apenas brincando. Aquela coisa não é remédio de verdade, é água doce do Tofu de Amêndoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Mas... Tofu de Amêndoas não vai me fazer melhorar? Então... Acho que tenho que tomar aquela coisa amarga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Boa menina! Você pode comer qualquer coisa contanto que você melhore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Por que o remédio não pode ser doce como Tofu de Amêndoas? Injusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "*Suspiro*. Muito obrigada, Viajante. por favor, procure um Tofu de Amêndoas, um será suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
