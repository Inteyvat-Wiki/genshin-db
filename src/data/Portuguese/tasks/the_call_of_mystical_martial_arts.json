					}
				]
			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine pergunta sobre o cardápio ao responsável e pede vários pratos tão caros quanto são famosos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "Ouvi dizer que a cozinha de Liyue foca bastante na aparência e no cheiro, bem como no gosto! Realmente parece bem diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "E minha boca está enchendo d'água só de olhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "#Junt{M#os}{F#as}, vocês saboreiam as iguarias do Albergue Wangshu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Uau, uau, isso é delicioso também, e isso, e aquilo... Ahhh, estou muito estufada para comer mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Isso foi ótimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "#Estou totalmente recuperad{M#o}{F#a} da viagem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Muito obrigada por tudo que você fez! Se não fosse por você, não consigo imaginar o quão mais difícil teria sido para eu chegar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Um dos empregados daqui me disse que se eu ficar nessa estrada, o <color=#00E1FFFF>Porto de Liyue</color> estará logo à frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Planejo descansar aqui por alguns dias, e perguntar por aí onde posso encontrar especialistas lendários, então decidir para onde ir em seguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Embora eu tenha realmente gostado de viajar com vocês, não posso continuar tomando mais do seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "De agora em diante, dependerá de mim eu ficar mais forte, para eu me tornar uma aventureira tão confiável quanto você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "#Hehe, apesar da gente não passar tanto tempo junt{M#os}{F#as}, também nos divertimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "Paimon espera te encontrar de novo no futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Que nos encontremos de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "Espero que você encontre o que está procurando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "É! Você também, espero que suas viagens sejam boas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine dá adeus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Bem, já que estamos aqui, por que não damos uma olhada pela área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Talvez existam mais encontros inesperados nos aguardando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine disse que o <color=#00E1FFFF>Porto de Liyue</color> estava logo a frente. Deveríamos ir dar uma olhada quando tivermos um tempinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
