					"speakerTitle": "Paimon"
				},
				{
					"id": 706811213,
					"content": "Paimon espera te encontrar de novo no futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811214,
						706811215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811214,
					"content": "Que nos encontremos de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "Espero que você encontre o que está procurando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "É! Você também, espero que suas viagens sejam boas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811217,
					"content": "Gesine dá adeus.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "Bem, já que estamos aqui, por que não damos uma olhada pela área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811219,
					"content": "Talvez existam mais encontros inesperados nos aguardando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068131,
			"completionStepIds": [
				7068103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
