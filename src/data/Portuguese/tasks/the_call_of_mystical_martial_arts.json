					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Desculpa! Pode esperar aqui por mim um momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Esqueceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "Não, não esqueci. Mas olhando para o mapa, se continuarmos seguindo, vamos sair de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "E não tem como saber quando vou retornar... Quando meu professor vir minha mensagem, ele vai surtar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Você mencionou seu professor antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Sim... Quando ele virou aventureiro, ele encontrou alguns Mitachurls na natureza. Durante a briga, ele baixou a guarda e foi derrubado por um machado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "Ele teve sorte de um Cavaleiro passando por perto salvar ele e o levar de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Ele teve tanta vergonha que decidiu treinar suas habilidades de combate até o máximo antes de sair de novo. Já faz uma década que ele tá treinando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "Ele sempre diz que o básico é o mais importante, mas eu não posso ficar batendo em bonecos de madeira todos os dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "Então saí sozinha, sem contar a ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Volte quando estiver mais forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "É! Foi exatamente isso que pensei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Ah, entendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine pega algumas Sementes de Dandelion da bolsa e as coloca em sua mão. Ela fala suavemente com elas, então as espalha ao vento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Segundo nossos costumes, Dandelions podem carregar desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Só desejei que tudo vá bem em minha jornada, que eu atinja meus objetivos e que meu professor me entenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Tenho certeza que o Arconte Anemo ouviu seus desejos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "É! Hora de seguir em frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Faça algo de que ele se orgulhe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "Ele também é um aventureiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
