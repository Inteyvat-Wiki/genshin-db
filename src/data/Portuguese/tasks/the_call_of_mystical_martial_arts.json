		{
			"id": 7068107,
			"completionStepIds": [
				7068107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7068107",
							"2"
						],
						"stepId": 7068107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gesine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "#Vou cuidar muito bem da minha foto com um{F#a} aventureir{M#o}{F#a} veteran{M#o}{F#a} como você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Ah! Eu não tinha percebido como estava com fome até relaxar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Agora que você falou, a barriga de Paimon também tá começando a roncar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Vamos encontrar um lugar para descansar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Vamos dar uma olhada em volta e encontrar um lugar para conseguir comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "Não parece ter nenhum restaurante adequado por perto... Considerando o quanto você me ajudou e o quanto eu te admiro, me sentiria mal em comer em qualquer lugar assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "Falando em comida, será que aquele prédio no topo daquela pedra gigante é o famoso <color=#00E1FFFF>Albergue Wangshu</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "Soube de um comerciante de Liyue que faz negócios em Mondstadt que a comida lá é simplesmente incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "Me deixem pagar um banquete para vocês como agradecimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Ooobaaaaaaaaaaa! Bora encher a pança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Paimon, acenda uma fogueira e comece a cozinhar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Ei! Você não pode sair mandando em Paimon assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "Além disso, você sabe como é a comida que Paimon faz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068108,
