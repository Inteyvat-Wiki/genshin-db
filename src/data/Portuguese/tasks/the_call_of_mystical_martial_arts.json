					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Essa é a <color=#00E1FFFF>Ilhota de Dihua</color> aí na frente, né? É tão bela! Não dá para ver nada assim em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "Sabia que ir numa jornada era a decisão certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "#Ah, certo! Isso não acontece todo dia, então vamos tirar uma foto {M#juntos}{F#juntas} para ter de lembrança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
		{
			"id": 7068106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
