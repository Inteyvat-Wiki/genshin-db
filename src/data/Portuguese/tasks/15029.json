			"dialogs": [
				{
					"id": 150290501,
					"content": "Você contou tudo para ele, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290502,
					"content": "Sim! Nós deixamos de lado a parte sobre sua contribuição, mas meio que parece que o Chefe Biram percebeu tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290503,
					"content": "Vocês poderiam ter apenas dito que foi um \"presente dos espíritos\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290504,
					"content": "Sim, mas o Chefe Biram merecia algo em troca pelo seu trabalho duro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "...Acho que ele é diferente dos chefes anteriores. Mas, se ele descobrir que era eu todos esses anos, eu estou encrencada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290506,
					"content": "Aqui estão vocês! Estive procurando por vocês por todos os cantos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290507,
					"content": "Oh, é o outro pesquisador de Fontaine... ele não foi levado junto com seu chefe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290508,
					"content": "Por favor, me chame de Allier... depois de todo o questionamento, a tribo me absolveu de qualquer conduta errada, então aqui estou eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290509,
					"content": "Estarei voltando para Fontaine logo — nenhum empregador significa nenhuma fonte de financiamento, afinal. Mas eu queria terminar minha investigação primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290510,
					"content": "Eu gostaria de perguntar algumas coisas sobre Huitzilin. Eu quero que as pessoas fora de Natlan ouçam a sua história, mas meu entendimento ainda tem alguns buracos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290511,
					"content": "Perguntas? Hnf... Por que deveria deixar um forasteiro contar nossas histórias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290512,
					"content": "Não me entenda mal — eu não tenho intenção nenhuma de mudar a sua história ou de usar ela para ganhar lucro. É só curiosidade honesta, eu lhe garanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290513,
					"content": "Eu acredito que histórias incríveis merecem serem dividas com o mundo. A cultura vive através de diálogos e trocas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290514,
					"content": "Ele tem um ponto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "Certo, você pode perguntar, mas seja rápido. Eu tenho planos importantes depois disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290516,
					"content": "Planos importantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290517,
					"content": "Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290518,
					"content": "Allier conduz uma entrevista detalhada, apenas indo embora quando a paciência de Citlali finalmente acaba.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "Outro dia, outra bateria social acabada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290520,
					"content": "Nós provavelmente devemos ir embora, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "Uhum... Ah, espera aí — você me deve um par de livros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290522,
					"content": "Oh, isso... quando se trata de Light Novels, sua memória é tipo uma armadilha de aço, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290523,
					"content": "Livros tão raros assim vão levar tempo para serem encontrados...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "Você está me dizendo... Sim, não vai ser fácil — você talvez precise ir à Editora Yae em pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290525,
					"content": "Mas, eu não preciso deles imediatamente. Só não se esqueça, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290526,
					"content": "Claro! Vamos enviar eles assim que possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290527,
					"content": "Enviar para mim...? Não, eu não quero um estranho batendo na minha porta quando estou de ressaca. Aqui, apenas pegue isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290528,
					"content": "Espera, isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290529,
					"content": "A chave da minha casa. Não se importe em bater na porta na próxima vez — você vai incomodar meu sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
