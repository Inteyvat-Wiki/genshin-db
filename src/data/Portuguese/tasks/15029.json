			"dialogs": [
				{
					"id": 150295101,
					"content": "Ah, a vitória de Natlan contra o Abismo! Muito adequado para um pergaminho que nem esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150295102,
					"content": "Eu me pergunto quanto tempo vai demorar até que o Ancião Tlapo escolha seu próximo indicado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150295103,
					"content": "Falando do Ancião Tlapo, ouvi dizer que ele sumiu ontem! Você sabe o que ocorreu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
					"speakerTitle": "Besuci"
				},
				{
					"id": 150295104,
					"content": "As ações do Ancião Tlapo sempre têm um significado profundo. Nesse caso, o significado deve estar além do nosso entendimento.",
					"roleType": "TALK_ROLE_NPC",
