						],
						"pointId": 9679
					}
				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "Somos como aves voando pelos horizontes do tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290203,
					"content": "(Clipe)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "Sabia que entenderia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290205,
					"content": "Esse... Esse é o pergaminho especial! Como você sabia como tecê-lo, Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290206,
					"content": "Lembra da \"dádiva dos espíritos\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Espera, você viveu por mais de duzentos anos, você sabe como tecer o pergaminho especial — isso quer dizer que... Você que está por trás das \"dádivas dos espíritos\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290208,
					"content": "Bem, não é como se eu quisesse interagir com o nomeado, então sempre que eu entregava o pergaminho, eu usava ilusões para confundi-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290209,
					"content": "O fato de ter se tornado algum tipo de \"intervenção divina\" é porque ninguém era habilidoso suficiente para desvendar meus truques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290210,
					"content": "Por que você só não conta a eles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Você carregou esse dever sozinha esses anos todos? Mesmo que você não goste de interagir com gente, por que não ensina a outra pessoa como faz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290212,
					"content": "#...{NICKNAME}, você consegue ver a cor especial, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290213,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "A essência daquela cor é a memória. Isso significa que completar o pergaminho especial é um processo de procura pela cor em suas memórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290215,
					"content": "Transmitir a técnica para alguém significa compartilhar suas memórias com essa pessoa. Você precisa deixar rastros de sua cor na memória dela, e ela deve fazer o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290216,
					"content": "Embora eu apenas tenha confirmado isso hoje, já suspeitava há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290217,
					"content": "E, bem... desde que Huitzilin morreu, eu não quis formar esse tipo de conexão com pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290218,
					"content": "Ah, é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290219,
					"content": "Foi o desejo final dela, então eu meio que me resignei a carregar esse fardo eternamente. Afinal, eu tenho todo o tempo do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290221,
					"content": "Mas Garra nunca deixou de nomear novos candidatos para tecer o pergaminho — apesar de saber exatamente como eu me sentia sobre a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290222,
					"content": "Você quer dizer que ele nunca parou de tentar encontrar novos amigos para você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "...Eu sabia exatamente o que ele estava fazendo. E, sim, se eu um dia compartilhasse minhas memórias com alguém, acho que essa pessoa seria um amigo. Mas nunca chegou a esse ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290224,
					"content": "Mas dessa vez você venceu, Garra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290226,
					"content": "Pegue isso. Acho... que é minha resposta ao que você me contou na outra noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290227,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290228,
					"content": "Se eu tivesse que escolher minha cor, seria a cor desse lenço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290229,
					"content": "Incontáveis pessoas existem em minhas memórias e sei que, um dia, esse também será meu destino — uma memória na cabeça de outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290230,
					"content": "#Já que sua vida é muito longa, você é {M#o candidato perfeito}{F#a candidata perfeita} para carregar essa memória... e carregar minha cor em sua mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290231,
					"content": "#Isso quer dizer que sou oficialmente {M#seu amigo}{F#sua amiga}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "...Só deixe isso em segurança e é melhor não esquecer minha cor quando chegar minha hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290233,
					"content": "Opa, é meio cedo para falar de morte, não acha? Só faz alguns segundos desde que a gente oficializou a amizade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290234,
					"content": "Não é pra isso que servem os amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290235,
					"content": "#Ok, isso que é comprometimento... Bem, Citlali, se {NICKNAME} vai deixar a cor {M#dele}{F#dela} na sua mente também, provavelmente vai ser dourado, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290236,
					"content": "#Na verdade, a marca {M#dele}{F#dela} já está lá. Lembra do efeito de leitura de mentes que eu não conseguia consertar? Bem, finalmente entendi tudo daquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290237,
					"content": "Compartilhar sentidos permite que a comunicação ocorra entre a consciência de pessoas diferentes. Naturalmente, memórias também estão envolvidas naquele processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290238,
					"content": "#Embora eu não soubesse na época, nós {M#dois}{F#duas} temos a habilidade de ver a \"cor da memória\", o que significa que quando compartilhei meus sentidos com você, uma conexão foi criada entre nossas memórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290239,
					"content": "E foi essa conexão que fez o feitiço original entrar em curto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290240,
					"content": "#Então, você consegue ouvir os pensamentos {M#do}{F#da} Viajante porque vocês deixaram rastros das suas cores nas memórias {M#um do outro}{F#uma da outra}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290241,
					"content": "#E é por isso que {NICKNAME} conseguia ouvir seus pensamentos também! Por que funciona nas duas vias, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290242,
					"content": "Pensou rápido, mas apenas aqueles treinados nas artes místicas conseguem manter aquele nível de conexão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290243,
					"content": "#É por isso que eu ainda consigo ouvir os pensamentos de {NICKNAME}, mas o inverso não é verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290244,
					"content": "Mas não precisa se preocupar. Agora que já entendi como funciona, vou me livrar disso rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290245,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290246,
					"content": "#(Eu menti — ouvir os pensamentos {M#um do outro}{F#uma da outra}, na verdade, depende da força da conexão entre nossas memórias.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290247,
					"content": "#(Então, após tudo que passamos junt{M#os}{F#as}, aposto que você pode me ouvir de novo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "(Eu sabia...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290250,
					"content": "(Então, tem algum jeito de acabar com isso?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "(Já que a conexão entre nossas memórias já existe, a única maneira de se livrar do efeito é se a gente se esquecer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290252,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Hehe, tô tirando onda contigo... Sou uma xamã lendária da minha tribo, agora que conheço a causa, claro que posso descobrir como consertar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290254,
					"content": "(Mas ainda vai demorar um tempo, provavelmente. Então, me ature mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290255,
					"content": "(Além disso, sou um livro aberto. Não é como se você fosse ouvir nada vergonhoso... Oh, hmm, exceto caso eu tenha tomado umas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290256,
					"content": "(Oh, então você consegue desligar? Que pena...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(Pena? Digo, se você sentir saudade dessa bagunça telepática, eu sempre posso compartilhar meus sentidos contigo de novo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290258,
					"content": "(Mas sem promessas. É melhor alguns pensamentos ficarem só com você.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290261,
					"content": "Hmm... Hã...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290259,
					"content": "(Ah, então dá para desligar isso? Ainda bem.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(É, entendo você. Alguns pensamentos são melhores se ficarem só com você.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				}
			]
		},
