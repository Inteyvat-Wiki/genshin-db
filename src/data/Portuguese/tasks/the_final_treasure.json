			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Almondemaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "#Yarr, aí está você. Achei que você estaria ocupad{M#o}{F#a} voando pelas ilhas com essas suas asas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270102,
					"content": "Aposto que você se esqueceu de seu velho amigo \"Almondemaru\" mofando na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270103,
					"content": "Se estamos aqui não é porque pensamos em você?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270104,
					"content": "A propósito, você tinha dito que queria ajuda. O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270105,
					"content": "Não é tão importante assim... Você se lembra de como me ajudou a encontrar os fragmentos do meu corpo da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270106,
					"content": "Como posso dizer... Não tenho certeza se é porque realizei meus desejos... ou se esse mar está diminuindo lentamente minha capacidade de falar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270107,
					"content": "Recentemente, eu passo mais tempo dormindo ao invés de ficar consciente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270108,
					"content": "É por causa do dispositivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#Entendo... Então foi por conta de algum dispositivo que eu me tornei seu Quebra-mar e pude me comunicar contigo, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270111,
					"content": "Oh... Isso significa que uma vez que os efeitos do dispositivo passem, o Almondemaru não será mais capaz de falar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}, devemos fazer algo antes que seja tarde demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270113,
					"content": "Haha, não precisa, Paimon... Já estou muito satisfeito em ter podido falar com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270114,
					"content": "Ah... Agora que penso nisso, eu, um navio, poder falar com vocês nos últimos dias já é uma coisa incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270115,
					"content": "Mas ainda tenho mais um favor a pedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270116,
					"content": "Diga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "#Lembra que eu lhe disse que assim que encontrássemos meu corpo, poderia levá-l{M#os}{F#as} para um cruzeiro por aqui? Bem, parece que meu corpo está um desastre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270125,
					"content": "A maior parte dos tesouros foram levados, e nada de bom foi deixado para trás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270118,
					"content": "Mas desta vez, juro em nome de um grande navio pirata, haverá grandes tesouros! Se não, ficarei preso nas algas e virarei comida de peixe! Apenas confie em mim uma última vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}, já que Almondemaru pode parar de falar a qualquer momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270120,
					"content": "#E... já que realmente tem um tesouro dessa vez... Vamos {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270121,
					"content": "Paimon, você nunca muda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "Hora de zarpar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270124,
					"content": "Yaaar, então, subam a bordo imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270122,
					"content": "Bem, se você diz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "Ele foi desligado e você foi afetado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902706",
							"2"
						],
						"stepId": 7902706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Almondemaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "Ufa, essa foi por pouco. Paimon tinha certeza de que íamos afundar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270602,
					"content": "Kosekimaru, você é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270603,
					"content": "#Haha, um barco falante não é nada além de um barco, e as excelentes habilidades de pilotagem {M#do}{F#da} {NICKNAME} é o que realmente permitiu que a gente conseguisse atravessar a tempestade a salvos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270604,
					"content": "Você quer ir de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "Haha, eu prefiro não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270607,
					"content": "Eh, a tempestade de agora foi provavelmente por causa da minha influência. Parece que o ambiente nesta área do mar tornou-se menos estável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270608,
					"content": "#Mas, chegamos! {NICKNAME} e Paimon, o tesouro está lá em cima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270609,
					"content": "Este não é o lugar que visitamos da primeira vez que estávamos procurando tesouros? Não havia nada aqui além de metade do casco do Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270610,
					"content": "Desta vez tenho certeza de que há um tesouro nele... Como foi que eu disse mesmo? É a intuição de um grande navio pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270611,
					"content": "Sério?... A propósito, você disse que tem duas coisas para nos dizer. A primeira é que você finalmente se lembrou do seu nome. Qual é a outra coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790270612,
					"content": "Hahaha, achei que você tinha esquecido, te conto o resto quando voltar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790270605,
					"content": "Você é muito gentil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902710",
							"2"
						],
						"stepId": 7902710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Almondemaru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "Kosekimaru, Kosekimaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271002,
					"content": "Encontramos o tesouro, veja, é o modelo de um navio pirata! Desta vez, sua intuição finalmente estava certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271003,
					"content": "Então, qual é a outra coisa que você gostaria de nos dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271004,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790271005,
					"content": "Kosekimaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271006,
					"content": "(O navio chamado Kosekimaru não responde...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271007,
						790271008
					],
					"speakerTitle": "Almondemaru"
				},
				{
					"id": 790271007,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				},
				{
					"id": 790271009,
					"content": "...Hnf, mas ele prometeu nos contar quando voltássemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271010,
					"content": "Kosekimaru... você é um grande mentiroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790271008,
					"content": "Kosekimaru não pode mais falar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790271009
					]
				}
			]
		}
	]
}