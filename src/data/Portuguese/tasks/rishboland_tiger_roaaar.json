			},
			"dialogs": [
				{
					"id": 730420601,
					"content": "#Que legal! Arakanta está tão feliz por brincar com Nara dourad{F#a}{M#o}! E Nara é tão rápid{F#a}{M#o} e poderos{F#a}{M#o}, tal qual um Caracal de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "Também é divertido brincar com outros Aranaras e verdadeiros Caracais, mas é ainda mais divertido brincar com novos amigos, amigos Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Por que o Caracal persegue os Aranaras?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Os Caracais e Aranaras são amigos, e amigos brincam juntos. Mas Arakanta percebeu, Nara tem medo de Caracal. Então Arakanta veio com um novo jogo para o Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "#Obrigado, Nara. Esta florzinha Aranara é para Nara dourad{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
