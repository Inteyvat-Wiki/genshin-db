			"dialogs": [
				{
					"id": 730420101,
					"content": "#Nara dourad{F#a}{M#o}, Arakanta ouviu muito sobre você. Você é {F#uma boa Nara}{M#um bom Nara}, quer brincar com Arakanta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "O jogo de Arakanta é muito simples e divertido! Vou falar as Regras, preste atenção, Nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta conjurará muitas partículas de Dendro, que são \"Aranara\" escondidos no círculo. Nara é um grande e poderoso \"Caracal\". Venha e persiga os \"Aranara!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "Se em pouco tempo, o \"Caracal\" alcançar todos os Aranara, então Nara vence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "O que acha? Nara quer jogar o jogo de Arakanta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
