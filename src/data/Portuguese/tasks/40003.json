			"dialogs": [
				{
					"id": 400030901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030902,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030903,
					"content": "#{NICKNAME}, o que vamos fazer? Essa pessoa parece ser difícil de se comunicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030904,
					"content": "Ugh, acho... que também não e uma boa pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030905,
					"content": "Você não pode simplesmente sair julgando se uma pessoa é boa ou má.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030906,
					"content": "Contudo, você acertou. Eu sou um espírito malvado. Sou um Guardião Yaksha, assassino de monstros e conquistador de demônios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030908,
					"content": "Tenho certeza de que ouvi esse nome dias atrás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "Paimon, você sabe o que é um Yaksha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "Um Guardião Yaksha...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030910,
					"content": "Sim... Alguém que Liyue estava dizendo que os Yakshas também são um tipo de Adeptus. Seres sobrenaturais que protegem Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030911,
					"content": "Eles ficam de guarda no mundo humano em segredo, os protegendo de monstros e demônios, mas a maioria das pessoas desconhecem sua existência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030912,
					"content": "Em outras palavras, são pessoas boas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030913,
					"content": "Não, não confunda a proteção de Yaksha como algo bom para a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030914,
					"content": "Mas o Ritual de Lanternas é uma comemoração aos heróis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030915,
					"content": "Acontece que aqui temos um herói histórico, que milagrosamente sobreviveu até hoje... e, no entanto, ele nem aprecia o gesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030916,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030917,
					"content": "Sr. Xiao? O Adeptus? Por que você não desconfiou desta pessoa suspeita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030918,
					"content": "Senti uma influência maligna aqui. Vim para investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030919,
					"content": "Quando a corrente do mundo dos deuses e demônios é afrouxada, eu assumo toda a responsabilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030920,
					"content": "Mas a ameaça desta vez vem do mundo humano. O seu mundo, então, como um viajante humano, a responsabilidade é sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030921,
					"content": "Quando a hora chegar, espero que você aja da forma correta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030922,
					"content": "Não desejo que a borla da arma que matou inúmeros demônios fique manchada de sangue mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030923,
					"content": "Quer dizer que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030925,
					"content": "Paimon, você sabe o que é isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030926
					]
				},
				{
					"id": 400030924,
					"content": "É um símbolo deixado por aquela pessoa suspeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030925
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030926,
					"content": "Isso não me parece familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030927
					],
					"speakerTitle": "Paimon"
