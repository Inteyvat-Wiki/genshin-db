			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "#Er... Ah, sim, vocês {M#dois}{F#duas} estiveram ontem aqui para reportar uma atividade suspeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030202,
					"content": "Eu... *Suspiro* não vou mentir para vocês, o Ministério de Assuntos Civis está muito ocupado com o Ritual da Lanterna. Não temos pessoal suficiente para cobrir este caso nesse momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030203,
					"content": "O quê?! Você está falando sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030204,
					"content": "Eu odeio decepcioná-lo dessa maneira e agradeço que você tenha se dado ao trabalho de denunciar isso pela bondade de seus corações. Hmm, eu me pergunto se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030205,
					"content": "Acredito que temos um pequeno esquadrão que possa ajudar. Só resta uma tarefa para eles hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030206,
					"content": "Eles estão voltando de uma operação de limpeza nas Planícies de Guili. Se você puder entrar em contato com eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
