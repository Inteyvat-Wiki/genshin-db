			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "Muito bemo, terminmos de investigar os rastros dos monstros. Já terminamos por hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030402,
					"content": "Quem são vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030403,
					"content": "Foi o Jiayi que nos enviou, ele disse que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030404,
					"content": "Então é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030405,
					"content": "O Ministério de Assuntos Civis está muito grato pela sua juda. Seu caso foi anotado e será agendado para investigação o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030406,
					"content": "Que nossos caminhos voltem a se cruzar, caros Viajantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}, você não acha que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030408,
					"content": "O Ministério não está levando isso à sério...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "Exatamente, eu também acho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030410,
					"content": "As pessoas locais provavelmente estão acostumadas com essas delícias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030411,
					"content": "#Mas para {F#uma}{M#um} pobre viajante , sozinh{F#a}{M#o} no deserto, muitas vezes forçad{M#o}{F#a} a sobreviver com nada além do mais estranho dos cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030412,
					"content": "Para você, o Ritual de Lanternas é o mais importante dos festivais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030416,
					"content": "Vamos começar revistando o local de ontem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030417,
					"content": "Segundo o que disse um guarda, os criminosos gostam de voltar à cena do crime. Essa é a forma de pensar deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030418,
					"content": "Mas o crime ainda não aconteceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "É por isso que não temos tempo a perder! Quando há materiais altamente inflamáveis envolvidos, quando o crime acontecer, será tarde demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030413,
					"content": "Teremos que resolver esse assunto por conta própria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "Também acho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030415,
					"content": "Com nossa rica experiência de aventura, é melhor assumirmos esta causa até o fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
