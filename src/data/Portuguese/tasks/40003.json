			"dialogs": [
				{
					"id": 400030701,
					"content": "Ahá, eu sabia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030702,
						400030703
					],
					"speakerTitle": "Paimon"
				},
				{
