					"nextDialogs": [
						230240703
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240703,
					"content": "Os médicos do Bimarstan também ficarão admirados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240704
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240704,
					"content": "Não há tempo melhor que agora. Deixe-me mover esta flor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240705
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240705,
					"content": "Espere, que... que som foi esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240706
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240706,
					"content": "Algo está se mexendo no campo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240707
					]
				},
				{
					"id": 230240707,
					"content": "Opa! Uma Flor Gigante! Como que ela apareceu aqui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240708,
					"content": "Ah não ! O campo de flores! Ela vai destruí-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240709,
						230240710
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240709,
					"content": "Eu cuido disso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				},
				{
					"id": 230240711,
					"content": "Hein... hein? A Flor Gigante... Escapou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240712,
					"content": "Como pode... Como pode ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240713
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240713,
					"content": "Nossas rosas, mais importante de todas as ervas... Elas se transformaram em um monstro e fugiram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240714,
						230240715
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240714,
					"content": "Mas elas não se \"transformaram\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240716,
					"content": "Você quer dizer que... O lento crescimento das rosas se deve a essa tal de Flor Gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240717
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240717,
					"content": "É mesmo? Fertilizantes desperdiçados... O dobro da água para regar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240718
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240718,
					"content": "Nós, nós na verdade estivemos cuidando dessa Flor Gigante?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240719
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240719,
					"content": "Maldição... como ela foi se misturar com as flores? Nós nem percebemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240720
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240720,
					"content": "Bem, todos são enganados vez ou outra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240721
					]
				},
				{
					"id": 230240721,
					"content": "Que desastre. Nosso campo está totalmente destruído também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240722
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240722,
					"content": "Devemos explicar isso ao Bimarstan e depois plantar novas rosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240715,
					"content": "Talvez desde o início...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240716
					]
				},
				{
					"id": 230240710,
					"content": "Para trás, todos vocês!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240711
					]
				}
			]
		},
