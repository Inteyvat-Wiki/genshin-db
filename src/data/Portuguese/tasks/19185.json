					}
				]
			},
			"dialogs": [
				{
					"id": 191851001,
					"content": "...Quando o Marechalato Fantasma revistou a casa de Pierre, não havia nem sinal desses barris, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Ele deve ter movido eles. Mas carregar todos eles fora daqui chamaria muita atenção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Você tem razão. Isso não parece o jeito dele de fazer as coisas... então como ele colocou eles aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Examinar os barris...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Os barris demonstram sinais de dano por água. Manchas de água seca podem ser vistas em volta do barril...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 191851006,
					"content": "(Parece ter um padrão para o local das manchas de água. Por algum motivo, elas parecem estar limitadas a parte debaixo dos barris.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 191851007,
					"content": "(As tampas não parecem muito apertadas, deixando aberturas consideravelmente grandes em volta das bordas. Mas não parece haver nenhum traço de água nos barris.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 191851008,
					"content": "Apenas as partes debaixo dos barris parecem ter sido submersas em água...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
		{
			"id": 1918511,
			"completionStepIds": [
				1918511
			],
