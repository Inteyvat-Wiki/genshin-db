			},
			"dialogs": [
				{
					"id": 191851201,
					"content": "Aha, como imaginei — aqui é onde o Sinthe de Imitação estava sendo feito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "[Médico] (Ajude Chevreuse a identificar as drogas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Essas garrafas e jarros... são todos Sinthe de Imitação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "...Parece que ele tem mais do que Sinthe de Imitação escondido por aqui... Além da matéria-prima necessária para sintetizar a substância, há uma abundância de agentes de limpeza e algumas drogas que não consegui identificar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Os agentes de limpeza são provavelmente usados para limpar rastros da substância... tipo seu cheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "A Patrulha Especial fez uma análise no Sinthe de Imitação. Nossos registros indicam que é muito difícil para pessoas comuns detectarem os rastros deixados por essa coisa. Tenho certeza de que era o caso para Pierre também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Deve ter levado um bom tempo e habilidade para garantir que todos os rastros foram lavados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Mas para que são essas outras drogas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		},
