				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3926.022,
							443.657,
							4548.217
						],
						"pointId": 340100651
					}
				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "Os materiais que essas bolsas são feitas... são bem raros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "[Conhecimento] (Ajudar Lyney a avaliar o material...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "Não é parecido com os materiais usados em sua Bolsa Mágica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "...É o mesmo, na verdade — fibra de Flor Rociomarinha. Mas tem algo de especial sobre a composição dessas bolsas. Dei uma olhada mais de perto e parece que não apenas são resistentes a água, mas também resistentes a corrosão e vazamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Até mesmo as linhas parecem especialmente feitas para manter as bolsas bem fechadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Me deparei com algumas bolsas feitas do mesmo material agora há pouco, mas eram muito menores e mais finas. Ao olhar para elas, pareciam bem menos duráveis também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Então... tipo aquelas bolsas pequenas e seladas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "...Bem parecida, na verdade. Normalmente seria fácil para um Cão Guarda sentir o cheiro de Sinthe de Imitação, mas se fosse selado em uma bolsa assim, pode ser possível escapar de ser detectado por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
