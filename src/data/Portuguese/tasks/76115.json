				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "Como esperado — apenas mais uma alma patética que não consegue parar de repetir os mesmos erros. Tenho que dizer, estou um pouco desapontada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "Ele se conteve de fazer o mal por tantos anos, mas no fim... Isso significa que pessoas más não conseguem mudar seus caminhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "É mais difícil continuar fazendo o bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Cada decisão cabia a ele. Até agora há pouco, ele poderia ter escolhido admitir seus erros. Mas escolheu a violência em vez disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Cada movimento foi mal feito, e cada um o levou a este fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#Mas chega de falar dele. Um brinde a um trabalho bem-feito. {NICKNAME}, você pode levar a prova da recompensa para Leszek, como combinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "Foi ótimo ver vocês assumindo o controle! Eu podia jurar que hoje eu estava de férias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Hehe, e agora que acabou, acho que já está na hora de começar o próximo trabalho, não é, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150310,
					"content": "Hããã!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "Ele tomou algumas decisões ruins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
}