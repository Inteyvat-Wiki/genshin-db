	"talks": [
		{
			"id": 7601414,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608201",
							"2"
						],
						"stepId": 7608201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#Qual o problema, {M#irmão}{F#irmã}? Tem mais alguma coisa que você queira me perguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141402,
					"content": "Sobre o caranguejo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "*Suspiro* Ele parece assustador, mas sempre foi gentil. Agora que a pedra se foi, provavelmente vai voltar ao normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141404,
					"content": "Mas por ora, vamos deixá-lo refletir sobre as ações dele. Manipulado ou não, o que está feito, está feito, e ainda machucou todos aqueles caranguejos pequenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141405,
					"content": "Assim como aquele governador maligno sob o feitiço do espelho que Reed Miller lutou contra, desculpas não vão mudar que você tem erros a consertar, com ações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141406,
					"content": "Sobre aquela pedra estranha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "Hehe, essa é a Pedra da {RUBY#[S]Pedra Twardowska} Cobiça que manipula os outros... Hmm, ou pelo menos acho que era esse o nome que a Hidimbi mencionou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141408,
					"content": "*Ahem* D-de qualquer forma, parece que é igual àquela grande pedra da Lua Gelada, algo que caiu do céu. Já que voou para longe, provavelmente não vai representar nenhuma ameaça para nós, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141409,
					"content": "Sobre a Gangue da Concha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#Hmm? Quer saber sobre a Gangue da Concha, {M#irmão}{F#irmã}? Claro! Como você já é amig{M#o}{F#a} da gente, pode perguntar à vontade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141411,
					"content": "#A gente é tipo... hmm, uma organização de cooperação mútua pra pessoas da mesma idade e com os mesmos ideais. Que pena que você já tá velh{M#o}{F#a} demais pra entrar... mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141412,
					"content": "Mas se precisar de qualquer ajuda na Cidade de Nasha, pode me avisar que eu ajudo no que puder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141413,
					"content": "Sobre aquela pessoa estranha que vimos antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "Oh, você tá falando daquela sacerdotisa roxa? Ela não nos atacou ainda, o que significa que ela não é nossa inimiga no momento. Por isso não devemos nos preocupar com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141415,
					"content": "Curiosidade mata, viu? Até a Katya me avisou: \"Fica longe desses esquisitões da Lua Gelada!\" E olha que eu, que sou uma ladra profissional, quase virei sacrifício pra Deusa da Lua nas mãos deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141416,
					"content": "Sacrifício?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "É... aqueles caras são bizarrões mesmo. Dizem que até misturam sangue de gente diferente... Aff, só de pensar já dá arrepio. Melhor nem falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141418,
					"content": "Por sorte, quem me pegou foi uma garotinha sem malícia. Contei umas histórias e ela me soltou. Se fosse outro... ufa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141419,
					"content": "#Eu... hum... não tô com medo nenhum, tá? Uma ladra profissional não fica tremendo não! Mas olha, {M#irmão}{F#irmã}, é melhor não se meter com essa galera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141420,
					"content": "Ah, e quase esqueci! Aquela fonte de informações que eu comentei? Tudo sobre os Filhos da Lua Gelada foi a Hidimbi que me contou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141421,
					"content": "Se você quiser encontrá-la... hm, ela deve estar por perto da Cidade de Nasha, eu acho? Basta perguntar um pouco por aí, e você provavelmente a encontrará logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141422,
					"content": "Parece que ela vai dar uma pausa por um bom tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "#Hm? Então {M#irmão}{F#irmã}, já conheceu a irmã Hidimbi? Ela não me falou nada sobre se aposentar... Bem, vou tentar descobrir mais depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141424,
					"content": "#Isso não me deixa muito segur{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "Ah, relaxa! Ela é super confiável. Confia na Maite! Pode deixar as preocupações de lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141426,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "#Tudo bem, tenha uma boa jornada, amig{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
