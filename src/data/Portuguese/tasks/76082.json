			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "Nossa! Esse cara parece ainda maior que antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141702,
					"content": "Haha, mas é claro! Após consumir todas as Frutas de Espírito Branco que recuperei com tanto esforço, o Czar-Siri agora tá mais... arredondado do que a Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141703,
					"content": "Ei! Para com essas comparações esquisitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141704,
					"content": "#Opa! E aí? Parece que ficou todo animado quando viu {NICKNAME}, hein? Até assustou com o entusiasmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141705,
					"content": "#Parece que ele tá querendo uma revanche com {NICKNAME}, hein? Será que tá com o ego ferido depois daquela surra que levou da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141706,
					"content": "Bem, por mim tá sussa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#Tenha cuidado, {M#irmão}{F#irmã}! Esse cara tá ainda mais forte do que da última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141708,
					"content": "Hã? Agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "#Mas também não precisa ficar cedendo às vontades dele, não. Pode deixar para responder ao desafio só quando {NICKNAME} tiver a fim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141710,
					"content": "Esse aí agora tá sob minha proteção, ele obedece quando eu falo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141711,
					"content": "Venha, sente-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141712,
					"content": "É seu cachorro de estimação, é?! Ah não... espera aí, caranguejo não fica sentado o tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
