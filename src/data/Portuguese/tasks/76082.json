				{
					"id": 760820405,
					"content": "É... aqueles caras são bizarrões mesmo. Dizem que até misturam sangue de gente diferente... Aff, só de pensar já dá arrepio. Melhor nem falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820406
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820406,
					"content": "Por sorte, quem me pegou foi uma garotinha sem malícia. Contei umas histórias e ela me soltou. Se fosse outro... ufa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820407
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820407,
					"content": "#Eu... hum... não tô com medo nenhum, tá? Uma ladra profissional não fica tremendo não! Mas olha, {M#irmão}{F#irmã}, é melhor não se meter com essa galera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820408,
					"content": "Ah, e quase esqueci! Aquela fonte de informações que eu comentei? Tudo sobre os Filhos da Lua Gelada foi a Hidimbi que me contou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820409
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820409,
					"content": "Se você quiser encontrá-la... hm, ela deve estar por perto da Cidade de Nasha, eu acho? Basta perguntar um pouco por aí, e você provavelmente a encontrará logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
