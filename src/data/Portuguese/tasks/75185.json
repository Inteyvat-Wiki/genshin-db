			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "O que são esses ovos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Então, sobre eles — são um prato que apenas podem ser produzidos em nossa região vulcânica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Colocamos alguns ovos de pássaros nas fissuras, deixamos o Flogisto esquentá-los e quando estiver no tempo certinho, saem os Ovos de Magma perfeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Mas, fique sabendo — se deixar tempo demais, vai ficar com um gosto bem, uh, especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518504,
