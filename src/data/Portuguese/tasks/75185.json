			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "Vocês foram incríveis! Terminaram o desafio bem rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Agora, deixa eu ver — nossa essa cor e cheiro... Já estou ficando com fome! Vá em frente, experimente enquanto está quente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Oh, e aqui está a receita. Da próxima vez que você estiver com vontade de Ovos de Magma, bem, você saberá como fazê-los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
