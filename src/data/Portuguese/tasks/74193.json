			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#Paimon! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930102,
					"content": "Uau, é você, Pahsiv! Que bom te ver de novo! O que você está fazendo por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930103,
					"content": "Pahsiv... trabalhando! Pahsiv... cansada! Pahsiv... deitar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930104,
					"content": "Hã? Você está... trabalhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930105,
					"content": "Galho da Floresta Nevoenta... Galho da Floresta Nevoenta... Muito, perdida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930106,
					"content": "Hã? O que tem no Galho da Floresta Nevoenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930107,
					"content": "Galho da Floresta Nevoenta... Informação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930108,
					"content": "Salgueiro Chorão, coletar. Caminho da Névoa, resolver. Nascente, enviar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930109,
					"content": "Galho da Floresta Nevoenta... Informação na névoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930110,
					"content": "Então você quer dizer que é informação sobre o Caminho da Floresta Nevoenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930112,
					"content": "Galho da Floresta Nevoenta... Muito perdido! Muitos lugares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930113,
					"content": "Pahsiv... procurando! Pahsiv... cansada! Pahsiv... comer! Pahsiv... deitar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930114,
					"content": "Galho da Floresta Nevoenta... Muito poucos! Mas caixas, muitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930115,
					"content": "#Ah... Obrigada, Paimon. Obrigada, {NICKNAME}! Aqui está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930116,
					"content": "Você encontrou o baú de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "Pahsiv! Caixa, tesouro, flor, brilhante, doce, muitos muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930118,
					"content": "Uau, então tem outras coisas também? Sabe, Pahsiv, você é muito legal, mas seria ruim se continuássemos pegando suas coisas de graça. Que tal fazermos trocas em vez disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930119,
					"content": "T-Troca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930120,
					"content": "#Isso mesmo! Somos amig{M#o}{F#a}s, e amig{M#o}{F#a}s deveriam fazer trocas sinceras {M#uns}{F#umas} com {M#o}{F#a}s outr{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930121,
					"content": "Então, vamos te ajudar a encontrar seus Galhos da Floresta Nevoenta e trocá-los por suas coisas. O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930122,
					"content": "E podemos arranjar algo para você comer também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "Certo, podemos fazer isso! Você está tendo um momento difícil sozinha, afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930124,
					"content": "Comer! Maralga! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930125,
					"content": "Você gosta de Maralga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "Maralga! Maralga! Maralga Maralga Maralga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930127,
					"content": "Uh, isso significa que você come cinco refeições ou cinco Maralgas por dia? Hã... Hmm, você pode até superar a Paimon em apetite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930128,
					"content": "Bem, e quanto aos Galhos, então? Podemos encontrá-los seguindo o Caminho da Floresta Nevoenta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930129,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930130,
					"content": "Galho da Floresta Nevoenta... Muito perdida! Muitos lugares! Dezenas em Erinnyes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930131,
					"content": "Então, os Galhos estão espelhados por toda Erinnyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#{NICKNAME} espert{M#o}{F#a}! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930133,
					"content": "Caminho da Floresta Nevoenta tem muitas flores. Galhos, e flores também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930134,
					"content": "Galhos, galhos, galhos, galhos, galhos, galhos... Quantidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930135,
					"content": "Hmm. Ah! Paimon entendeu agora. Os Galhos podem ser encontrados em lugares com as mesmas flores que o Caminho da Floresta Nevoenta, e são seis locais, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930136,
					"content": "Paimon esperta! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930137,
					"content": "Hehe, acho que tudo está claro agora, né? Descanse bem, Pahsiv. Deixe isso conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930138,
					"content": "#Paimon, {NICKNAME}, coisa boa! Então, devagar, devagar! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pahsiv"
				}
			]
		},
