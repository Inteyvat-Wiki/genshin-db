			"dialogs": [
				{
					"id": 761800401,
					"content": "Nós sempre costumávamos nos reunir no seu jardim, Sandrone. Agora é você quem me visita para tomar chá. É uma sensação tão estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800402,
					"content": "Mas ainda sou eu quem prepara tudo — então não sinto tanta diferença assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800403,
					"content": "Ahã, e sua comida está tão deliciosa quanto eu me lembro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800404,
					"content": "#Hunf. Mas ouvi dizer que {NICKNAME} também vem te ver aqui com frequência. O que vocês fazem nesses momentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800405,
					"content": "#Hmm... Às vezes conversamos, às vezes jogamos com os kuuhenki, vemos os kuuhenki desenharem. Ah, e também jogo Xadrez Lunar com {M#ele}{F#ela}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800406,
					"content": "Xadrez Lunar? É aquele jogo em que você tenta colocar três peças em linha? Quem costuma ganhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800407,
					"content": "#Eu não contei, mas {NICKNAME} é bem habilidos{M#o}{F#a} no jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800408,
					"content": "Heh, vou te mostrar o que é habilidade de verdade. Que tal uma partida? Se empatar, considero uma vitória sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800409,
					"content": "Claro, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
