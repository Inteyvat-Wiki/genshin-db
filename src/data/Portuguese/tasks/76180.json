			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Damselette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "O... o quê? Isso é impossível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800602,
					"content": "Parece que você perdeu, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800603,
					"content": "E-eu deixei você vencer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800604,
					"content": "Sério? Então por que você parece tão agitada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800605,
					"content": "Droga... Quero uma revanche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800606,
					"content": "Hunf, mamão com açúcar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800607,
					"content": "Você venceu. Você é mesmo muito habilidosa, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800608,
					"content": "Vamos jogar algo mais desafiador da próxima vez. Conheço vários jogos matemáticos divertidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800609,
					"content": "Parece empolgante! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800610,
					"content": "Hã? O que é tão engraçado!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800611,
					"content": "Mal consigo me lembrar de te ver tão feliz assim antes. Você quase nunca me convidava para jogar jogos. Normalmente, você só me expulsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800612,
					"content": "Ei... Não me faça parecer algum tipo de valentona! Vou te convidar para mais festas do chá a partir de agora, tá bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800613,
					"content": "Eu gostaria disso. Aprecio esses encontros, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
