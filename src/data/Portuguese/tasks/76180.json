			"dialogs": [
				{
					"id": 761800801,
					"content": "É muito divertido jogar. Mal posso esperar para jogarmos mais vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800802,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800804,
					"content": "Já vai embora? Tudo bem, até a próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761800803,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
