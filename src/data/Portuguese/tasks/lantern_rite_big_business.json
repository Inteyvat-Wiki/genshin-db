						413342704
					]
				},
				{
					"id": 413342704,
					"content": "Obrigado, mas não podemos retornar para a cidade agora por causa de alguns... Assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342705
