					"nextDialogs": [
						413342605
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342605,
					"content": "Se tiver oportunidade, eu vou dar uma olhada. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342606
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342606,
					"content": "Mas... Por acaso, podemos comprar mais uma Lanterna Celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342607
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342607,
					"content": "Mesmo que não tenhamos uma oportunidade de ver a Lanterna Mingxiao na cidade, seria bom lançarmos uma Lanterna Celeste, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342608
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342608,
					"content": "Você tem razão. Claro que deve lançar uma Lanterna Celeste no Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342609
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342609,
					"content": "Bom, sem problema! Por acaso, tenho algumas Lanternas Celestes recém-feitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342610
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342610,
					"content": "Vou te dar de graça, visto que estamos no festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342611
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342611,
					"content": "Muito obrigado. Outra coisa, tem um lugar bom aqui perto para lançá-la?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342612
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342612,
					"content": "Um lugar alto deve ser bom para lançá-la. Então siga o caminho para a montanha, você irá encontrar um bom lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342613
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342613,
					"content": "Só que ouvi dizer que há muitos monstros lá na montanha. Fique atentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Zhu"
				}
			]
