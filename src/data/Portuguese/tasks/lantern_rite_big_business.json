			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "Devo pensar em uma maneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340102,
					"content": "Pensar em uma maneira de fazer o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "#Ah, é {F#a}{M#o} Viajante. Como agora estamos no Ritual de Lanternas, gostaria de atrair mais clientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340104,
					"content": "Veja, a localização daqui é boa, o ambiente também, e também tem muita comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340105,
					"content": "Creio que daria uma boa sensação sentar aqui com boa comida e boa vista quando a Lanterna Mingxiao for lançada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340106,
					"content": "Será que isso é um ótimo argumento de vendas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340107,
					"content": "É possível ver Lanternas Mingxiao daqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "Claro que você consegue vê-la daqui... A lanterna Mingxiao é tão grande que você certamente poderá ver parte dela, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340110,
					"content": "Hummm... Não faz mal... Vamos ver depois. Tenho que agora organizar tudo no restaurante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340111,
					"content": "Viajante, você pode me ajudar a coletar os materiais necessários para fazer uma Lanterna Celeste? Gostaria de pendurar uma em minha loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340112,
					"content": "#É melhor fazer eu mesm{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "Não tem problema. Só os materiais já serão o suficiente. Fazer uma Lanterna Celeste é muito trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340115,
					"content": "Assim que você coletar tudo, entregue diretamente para o Bobo. Ele fará a Lanterna Celeste, enquanto isso, tenho outros assuntos para resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340116,
					"content": "Claro, vou te pagar bem. Quando conseguir chamar mais clientes e tiver um bom negócio, eu irei te dar uma recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340117,
					"content": "Se não tiver muitos clientes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "#Errrr... Mesmo assim, irei te dar recompensa. Fique descansad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340119,
					"content": "Enfim, quando eu arrumar o restaurante, os clientes devem chegar também",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340120,
					"content": "*Cof* Apenas passe esses materiais para o Bobo. Finalizarei seu pagamento amanhã com base na situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413340113,
					"content": "Apenas vai precisar de materiais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "Creio que você não conseguirá ver Lanternas Mingxiao aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
