			"dialogs": [
				{
					"id": 413342501,
					"content": "Venham para cá! Já está tudo preparado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342502
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342502,
					"content": "Bom, quem são eles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342503
					]
				},
				{
					"id": 413342503,
					"content": "Oh. Eu saí para atrair mais clientes... Encontrei eles lá em baixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342504
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342504,
					"content": "Sim. Ela é a filha do diretor do Banco Minghua, e eu sou o empregado do Banco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342505
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342505,
					"content": "Eu e a senhorita estamos viajando... Só que agora chegou o Ritual de Lanternas, e a Senhorita está com saudades da terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342506
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342506,
					"content": "Então estamos procurando um bom lugar para ver as Lanternas Celestes. Por acaso, resolvemos encontrar esse senhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342507
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342507,
					"content": "Por acaso, também temos muitas Lanternas Celestes... Que coincidência... Só que... O Banco Minghua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342508
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342508,
					"content": "Ah! Não devia ter perguntado demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342509
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342509,
					"content": "#Vocês devem estar muito cansad{M#os}{F#as} visto que foi um longo caminho... Então descansem um pouco, vou preparar uma boa refeição para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342510
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342510,
					"content": "Viajante, posso pedir um favor? Como eles estão bastante cansados, não podemos demorar a servir a comoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342511
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342511,
					"content": "Por favor, prepare um Ensopado de Gemas delicioso. Vou te dar uma recompensa em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Zhu"
				}
			]
