					"nextDialogs": [
						413342203
					]
				},
				{
					"id": 413342203,
					"content": "Bom. Então agora já está tudo prato. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342204
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342204,
					"content": "Vocês já esperaram muito tempo. Hehehe, bom apetite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342205
					],
					"speakerTitle": "Sr. Zhu"
				},
				{
					"id": 413342205,
					"content": "#Muito obrigado. {M#Ele}{F#Ela} é {M#o}{F#a} Viajantes, que ajudou bastante... Venha sentar aqui com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342206
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342206,
					"content": "Obrigado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413342207
					]
				},
				{
					"id": 413342207,
					"content": "#Hehe, pela sua aparência, aposto que você também é {M#um}{F#uma} forasteir{M#o}{F#a}, não é? Agora estamos no festival, por que não sentamos juntos e comemos uma boa refeição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342208
					],
					"speakerTitle": "Jianqiu"
				},
				{
					"id": 413342208,
					"content": "Sim! Senhor, você também, venha comer com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413342209
					],
					"speakerTitle": "Huachu"
				},
				{
					"id": 413342209,
					"content": "Hehehe. Ok, não vou falar mais de cerimônia então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Zhu"
				}
			]
