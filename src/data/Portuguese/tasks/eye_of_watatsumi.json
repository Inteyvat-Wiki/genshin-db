			"dialogs": [
				{
					"id": 721450101,
					"content": "\"...Dizem que o enviado de Omikami tinha três olhos: um para a \"alma\", um para o \"espelho\" e o último para a \"verdade\"...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 721450102,
					"content": "\"... Das profundezas ele surgiu, do <color=#00E1FFFF>sul</color>, ao <color=#00E1FFFF>norte</color>, e ao redor do <color=#00E1FFFF>oeste</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 721450103,
					"content": "\"...Os três olhos brilharam impiedosamente para afastar o herdeiro do dragão...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 721450104,
					"content": "Hmmm... Paimon conhece todas essas letras... Mas juntando elas e formando palavras e frases, simplesmente nada faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Parece que não há pistas por aqui, e se a gente tentar usar a <color=#00E1FFFF>Visão Elemental</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
