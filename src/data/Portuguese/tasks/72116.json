			"dialogs": [
				{
					"id": 721160401,
					"content": "Obrigado, sério! Estes devem ser suficientes para formar a estrutura básica de nosso dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Agora, tudo o que precisamos fazer é esperar que nossos sinalizadores coletem dados suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Quando tivermos esses dados em mãos, farei alguns ajustes correspondentes de acordo com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Quando tudo estiver pronto, vamos pôr um fim decisivo a este incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
