			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Ainda vai demorar um pouco mais...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "Vocês já coletaram todos os dados necessários?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "Ah, é você! Maravilha. Ainda não coletamos todos os dados de que precisamos. Acredito que isso levará um pouco mais de tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Dito isso, aproveitei essa oportunidade para pensar sobre a estrutura do purificador de emergência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "E o que isso poderia ser?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "É apenas o meu truque para casos de emergência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "De acordo com nossas discussões anteriores, devemos lidar com um problema de dois lados: os Fatui e o Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Acredito que você será capaz de lidar com esses Fatui. E eu, portanto, cuidarei da parte do Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Este purificador de emergência é um dispositivo que eu fiz para essa tarefa. Entretanto, para conseguir criá-lo, ainda preciso da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "Em que posso ajudar então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Precisaremos de alguns materiais especiais para garantir o funcionamento tranquilo deste dispositivo dentro da Fornalha Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "A Medula de Cristal, que contém uma forma inerte destas energias corruptas, seria a mais adequada para esta tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "Na verdade, o segredo do famoso Aço de Jade é que este mesmo material é adicionado durante o processo de forjamento para aumentar a resistência dos metais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Claro, esse método especial deve continuar a ser um segredo comercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Se não me engano, estes minérios de cristal podem ser encontrados nas proximidades. Por favor, ajude-me a coletar três deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Bem, então, você tem meus agradecimentos. Lembre-se, são 3 Medulas de Cristal - traga-as de volta assim que as tiver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "Achei que ele tinha um nome mais oficial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "O nome oficial é \"purificador de emergência\" mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "A menos que... Você esteja falando de seu número oficial de produto, data de fabricação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Como este é um dispositivo puramente de emergência, não precisamos de tais coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "Isso também é considerado uma medida de emergência?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Suponho que sim, embora eu não fornecesse esse tipo de ajuda durante o atendimento normal ao cliente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
