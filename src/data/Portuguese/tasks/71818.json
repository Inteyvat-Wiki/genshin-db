				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180501,
					"content": "Estou muito grata pela sua ajuda. Se eu tivesse ido lá por conta própria, teria levado horas para fazer tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180502
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180502,
					"content": "Eu não quereria deixar o vovô Jiangcheng por conta própria antes do festival...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180503
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180503,
					"content": "E quanto a você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180504
					]
				},
				{
					"id": 718180504,
					"content": "Eu... Vou voltar para o moinho. Ainda há muito trabalho a ser feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180505
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180505,
					"content": "Eu herdei o moinho quando meu pai faleceu. Deixei meu trabalho no Porto de Liyue para continuar a tradição familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180506
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180506,
					"content": "Não sei se faz sentido, mas fazer as mesmas coisas que ele costumava fazer, estar no mesmo ambiente, me deixa muito nostálgica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180507
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180507,
					"content": "Em especial durante o Ritual de Lanternas, eu sempre lembro muitas palavras que meu pai falou para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180508
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180508,
					"content": "Oh, eu quase esqueci. Eu me concentrei tanto no vovô Jiangcheng que não fiz uma Lanterna Celeste para mim mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180509
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180509,
					"content": "O problema é que eu também não deixei nenhum material sobrando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180510
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180510,
					"content": "Receio não conseguir fazer tudo a tempo se eu for agora à procura de materiais... Viajante, você se importaria de coletar alguns para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180511
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180511,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180512
					]
				},
				{
					"id": 718180512,
					"content": "Obrigada.",
