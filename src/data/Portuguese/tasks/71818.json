			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "Oi, Viajante! Obrigada por me ajudar no passado. Há muito tempo que a Vila Qingce não ficava tão animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180102,
					"content": "De nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "No passado, era apenas eu e Zhi. O máximo que podíamos fazer era fazer Lanternas Celestes para as crianças e conversar com os adultos sobre a vida cotidiana e preparar uns petiscos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180104,
					"content": "Graças a você podemos passar um Ritual de Lanternas muito animado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180105,
					"content": "Entretanto, está cada vez mais animado... Eu ainda quero ir visitar os idosos da vila. Me preparei hoje para ver Jiangcheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180106,
					"content": "Se você quiser, pode vir também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180107,
					"content": "Então vamos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "Hum, está bem. Então primeiro vamos procurar o vovô Jiangcheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
