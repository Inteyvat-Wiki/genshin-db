			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180301,
					"content": "Querida, venha dar uma palavrinha à Sra. Bai... Seu pai é um artesão tão habilidoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180302
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180302,
					"content": "Eles vendem seu Tofu no Porto de Liyue, é de primeira qualidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180303
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180303,
					"content": "Xiaobai, o que você veio fazer aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180304
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180304,
					"content": "Nós trouxemos para você uma Lanterna Celeste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180305
					]
				},
				{
					"id": 718180305,
					"content": "Lanterna Celeste... Ah... Tão atenciosa. Você me traz elas todos os anos, Sra. Bai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180306
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180306,
					"content": "Você se lembra, querida? Eu costumava fazer incríveis Lanternas Celestes antigamente. Nossos vizinhos gostavam tanto deles que me pediram para fazer algumas para eles também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180307
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180307,
					"content": "Essas Lanternas Celestes são tão bonitas, elas realmente iluminam cada um dos Rituais das Lanternas. Espere, vou pendurá-las para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180308
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180308,
					"content": "Deixe-me pendurar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180309
					]
				},
				{
					"id": 718180309,
					"content": "Certo, apenas tome cuidado. Não vá se machucar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				}
			]
		},
