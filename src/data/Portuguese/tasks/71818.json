			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "É você, querida? Você está de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180202,
					"content": "Desculpe, você deve ter me confundido com outra pessoa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "Bobagem, eu não perdi o juízo... Como eu não reconheceria minha própria esposa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180204,
					"content": "Eu estava apenas te dizendo que, com uma festa tão grande chegando, talvez devêssemos comprar roupas novas para nossa filha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180205,
					"content": "Você está voltando com uma convidada... Oh, ela deve ser uma costureira. Você sempre lê minha mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180206,
					"content": "Vovô Jiangcheng, sou eu, a Sra. Bai. Eu lhe dei Tofu no outro dia. Você não me esqueceu tão rápido, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180207,
					"content": "Ah... Sra. Bai... Claro que eu me lembro de você, Sra. Bai! Seu pai estava me dizendo como está orgulhoso de você não faz nem muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180208,
					"content": "Ah... Quando é que foi isso mesmo? ...Querida, talvez você se lembre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180209,
					"content": "... Eu lembro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "Ha! Como eu disse, não há nada de errado com minha memória... E, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180212,
					"content": "Vovô Jiangcheng, por que você não descansa um pouco? Não há necessidade de se esforçar assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180213,
					"content": "Viajante, que tal você ajudar o vovô Jiangcheng a limpar a casa? Eu o farei companhia nesse meio tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180214,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180210,
					"content": "É claro que lembro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
