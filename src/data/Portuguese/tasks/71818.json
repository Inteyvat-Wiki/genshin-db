					"Jiangcheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "Você pendurou a Lanterna Celeste? Verdadeiramente de tirar o fôlego. O próximo ano será, com certeza, outro grande ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180402,
					"content": "Com certeza vai ser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "Vovô Jiangcheng, está na hora de nós irmos. Ainda temos alguns compromissos a cumprir. Visitarei você novamente em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718180405,
					"content": "Não se preocupe, mocinha. Há sempre mais trabalho a fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180406,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "Ah, claro. Querida... Não se esqueça de cuidar da nossa terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangcheng"
				},
				{
					"id": 718180403,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				}
			]
		},
		{
			"id": 7181805,
			"completionStepIds": [
				7181807
