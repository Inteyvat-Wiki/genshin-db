			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "Viajante, você precisa de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240202,
					"content": "Sobre a Pequena Ming...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "Ah, você está falando sobre ela. Desde o que aconteceu a última vez, ela não causou mais problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240204,
					"content": "Entretanto, eu tenho pena daquela criança. Antes, nos festivais, o albergue ficava muito animado, e ela se sentia muito desolada. Foi por isso que começou a assustar os clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240205,
					"content": "Mas ela apenas queria que alguém brincasse com ela. Afinal de contas, ela é apenas uma criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240206,
					"content": "Que tal você dar uma Lanterna Celeste para ela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "Dar uma Lanterna Celeste para ela? Hmm... Isso parece uma boa ideia, mas é muito difícil de encontrar ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240209,
					"content": "Se você quer encontrar ela, é melhor ir para a floresta de noite, e pendurar a Lanterna Celeste no topo de uma árvore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240210,
					"content": "Desta maneira, ela conseguirá ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240207,
					"content": "Talvez ela goste de Lanternas Celestes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
