						718240303
					]
				},
				{
					"id": 718240303,
					"content": "Ótimo. Desta maneira, ela ficará feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 718240304,
					"content": "Não sei se ela tem algum desejo...",
