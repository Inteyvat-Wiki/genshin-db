			"trigger": {
				"objectNames": [
					"Yanxiao Sorridente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "Devo ser mais rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718240102,
					"content": "Os negócios estão indo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "Não. Muitas pessoas do albergue foram embora para passar o feriado. Não há muitos por aqui trabalhando agora, quase tive que fazer tudo sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718240104,
					"content": "Bem, não temos muitos clientes, mas eu aguento ficar só por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718240105,
					"content": "Cof. Além disso, devo agradecer-lhe por me ajudar anteriormente. Se não tivesse sido por sua ajuda, acho que nunca teria podido voltar ao trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718240106,
					"content": "Ah. Recentemente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "Não! Com certeza não! Confie em mim! Não consigo suportar que aconteça mais uma vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718240109,
					"content": "Se você realmente quer perguntar sobre isso envolvendo ela... É melhor perguntar à chefe, eu realmente não sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718240107,
					"content": "Então, ela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
