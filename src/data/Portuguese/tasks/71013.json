			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131001,
					"content": "Estas três perguntas anteriores, eu me aproximei de meu querido discípulo e perguntei-as a ele. Mas ele me criticou, acusando-me de abandonar meu dever, e marchou furiosamente. Que as verdadeiras respostas a estas três perguntas tragam paz ao mundo. Em meu tempo, procurei a sabedoria de textos antigos em todos os cantos do mundo, me escondi aqui, em meditação silenciosa, e estudei a linguagem dos monstros; e tudo isso fiz na esperança de compreender sua verdadeira natureza. Ergui este monumento para ser minha testemunha quando vier quem possa resolver estas questões de uma vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131002
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710131002,
					"content": "Toque o monumento",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
