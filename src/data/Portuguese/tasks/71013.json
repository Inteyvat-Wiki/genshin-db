			},
			"dialogs": [
				{
					"id": 710130901,
					"content": "Os monstros causam estragos por todo o mundo, e nós que procuramos protegê-lo faríamos bem em lembrar: Os monstros não merecem nada além do que o massacre impiedoso que receberão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130902
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710130902,
					"content": "Toque o monumento",
