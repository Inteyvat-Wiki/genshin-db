			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Visão</color>... É realmente algo extraordinário, dizem que é concedida pelos deuses, mas ninguém sabe exatamente quem e por que podem receber essa coisa divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710131502,
					"content": "Nos clássicos sempre dizem que os deuses têm piedade para os mortais. A <color=#00E1FFFF>Visão</color> é concedida para os mais destacados do mundo, e serve para ajudá-los a erradicar os monstros e purificar o mundo. Mas eu, por minha vez... Agora já não tenho mais interesse em purificar os monstros, só quero me comunicar com eles, e descobrir a sua natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710131503,
					"content": "Esta <color=#00E1FFFF>Visão</color>... Não me importo se vou conseguir pegá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tesouro das Ruínas"
				}
			]
		},
