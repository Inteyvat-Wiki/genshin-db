			"dialogs": [
				{
					"id": 710131401,
					"content": "Futuro leitor, eu não sei se você tem as respostas para minhas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131402
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710131402,
					"content": "Qualquer pessoa que ler estas palavras deve certamente ser da mesma natureza que a minha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131403
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710131403,
					"content": "#<color=#00E1FFFF>Se você estiver interessad{M#o}{F#a}, você pode dar uma olhada na beira do lago, nela enterrei os poucos tesouros que possuo, te dou minha permissão para pegar se quiser.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Tesouro das Ruínas"
				},
				{
					"id": 710131404,
					"content": "Mas, por favor, nunca esqueça estas três perguntas. Rezo para que chegue um dia em que você esteja apto para respondê-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tesouro das Ruínas"
				}
			]
		},
		{
