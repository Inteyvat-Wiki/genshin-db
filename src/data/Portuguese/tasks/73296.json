			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960601,
					"content": "Ainda preciso me preparar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960602
					]
				},
				{
					"id": 732960602,
					"content": "#Certo. Vamos partir quando estivermos pront{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329608,
			"completionStepIds": [
				7329608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329608",
							"2"
						],
						"stepId": 7329608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "E aí? Nada mal, né? O Pimenta também me pareceu muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "Depois de ver isso, sinto que palavras seriam supérfluas. Caterpillar estava certo. Existe um mundo enorme fora da minha caixa de metal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Caixa de metal...? Você disse que vivia em um lugar muito pequeno em Fontaine, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "*Cof cof* Sumeru realmente tem muitos lugares para visitar, não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "... Ah, sim! Claro! Ele já decidiu ser um artista de verdade, então vamos mudar um pouco o cenário para... Como eles dizem mesmo...? Ampliar nossos horizontes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Ele pode ter dito que quer desistir, mas Paimon acha que ainda é muito cedo para isso! Ainda dá tempo de reconsiderar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "Pense bem, Julien! Pode haver vistas tão grandiosas quanto esta, ou talvez ainda maiores - coisas que você nunca viu antes! Talvez elas lhe concedam a inspiração que você precisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Quanto ao seu reconhecimento de cores, bem, você mesmo disse! Nós apenas \"vemos algo diferente\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "\"Mas a beleza é compartilhada.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "Sim... Suas palavras fazem sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Essas são as suas próprias palavras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Eu... Haha, eu sabia. Eu sabia de tudo isso, mas eu continuei trilhando o caminho errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "Nós só sabíamos desse lugar porque Pimenta trouxe você aqui. Então, realmente, podemos considerar este o \"caminho errado\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "Bem, é uma pena não podermos ajudá-lo a encontrar o caminho da peregrinação das Oceanids...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Será que isso realmente existe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Eu acreditei nisso até agora, mas... Acredito que minha capacidade ou a falta dela de encontrá-lo não é importante de toda forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Afinal, eu já encontrei a resposta que desejava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "#Obrigado, {M#meus amigos}{F#minhas amigas}. Como posso demonstrar a minha gratidão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "#Se eu tivesse comprado aqueles ovos de pássaros misteriosos... Um item místico como esse, que pode ajudar a afastar a má sorte, certamente seria mais útil para aventureir{M#o}{F#a}s como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "Isso é mesmo uma pena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#Espera, você realmente acredita em algo tão conveniente, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Vou continuar a ficar aqui por um tempo. Este lugar realmente acalma a alma. É muito bom para autorreflexão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Tenho a sensação de que posso desenhar algo um pouco diferente desta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "#Obrigado, {M#meus amigos}{F#minhas amigas}. Desejo a vocês uma ótima jornada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "Está tudo bem, isso não será necessário.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Por que não? Mesmo que não consiga realmente evitar a má sorte, talvez... talvez possa ter um gosto cem vezes melhor do que um ovo normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
