			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#Bem-vind{M#os}{F#as} à Metrópole da Constelação, {NICKNAME}, Srta. Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710102,
					"content": "Meus colegas me deixaram por dentro de seus nomes e atos, resumindo que vocês são realmente valentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710103,
					"content": "Se eu não estivesse responsável por treinar os guardas, gostaria de treinar com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710104,
					"content": "Então você é um guarda também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "Certamente. Por ordens de nosso mestre, devemos defender a Metrópole da Constelação e manter a paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710106,
					"content": "Meu trabalho, especificamente, é treinar os guardas para que suas habilidades correspondam ao dever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710107,
					"content": "Então a porta atrás de você leva ao campo de treinamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "#Muito observador{F#a}! Ela leva a um domínio que acabamos de reformar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710109,
					"content": "Nesse campo, aquele em treinamento deve balançar sua espada seguindo um ritmo específico, e a iluminação da arena mudará constantemente durante a batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710110,
					"content": "Parece bem rigoroso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "Parece mais é complicado... Você tem que seguir um ritmo específico enquanto luta também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790710112,
					"content": "Esse segmento é, na verdade, derivado de uma história intitulada \"Músico Coruja\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710113,
					"content": "Era popular entre os guardas há um tempo. Muitos gostaram ao ponto em que esqueceram de participar do treino e até faltavam as patrulhas diárias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710114,
					"content": "Mas como todos gostaram tanto, tive uma ideia de adicionar elementos da história em nosso treinamento para torná-lo mais divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710115,
					"content": "Isso teve efeito visível no treinamento... se nada mais, também não houve mais atrasos em patrulhas por motivos pessoais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710116,
					"content": "#Hehe... Estariam interessad{M#os}{F#as} nesse treinamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710117,
					"content": "Os desafios relevantes devem ser moleza para pessoas com coragem como a sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710118,
					"content": "Vou adorar experimentar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "Coragem digna de louvor! Excelente. Por favor, então, entre no Domínio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elof"
				},
				{
					"id": 790710120,
					"content": "Tenho outras coisas para fazer no momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "Tudo bem. Volte sempre que tiver um tempo — estarei aqui de guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elof"
				}
			]
		}
	]
}