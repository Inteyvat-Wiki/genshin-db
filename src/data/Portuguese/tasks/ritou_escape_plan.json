			},
			"dialogs": [
				{
					"id": 20131001,
					"content": "Ufa, podemos nos refugiar no vilarejo lá na frente. Como você está se sentindo, minha senhorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Eu estou perfeitamente bem. Você pode parar aqui. O caminho para a Ilha Narukami é logo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131003,
					"content": "Em minha carta, solicitei a Kamaji que lhe concedesse uma permissão especial de viagem da Comissão Tenryou. Considere-a uma demonstração do meu apreço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131004,
					"content": "#Obrigad{M#o}{F#a}, Chisato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "Minha senhorita...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131007,
					"content": "Hã! Então é isso. Eu tinha a sensação de que algo estava errado, mas Shinnojou, você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "Não, a Senhorita Hiiragi nunca teria qualquer má intenção, tenho certeza disso. Mas quem é esse \"Kamaji\" de que a senhorita fala, minha senhorita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131009,
					"content": "Não tenho medo de dizer que... É quem eu amo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131010,
					"content": "Aquele que... Você ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131011,
					"content": "Shinnojou... Você honestamente pensou que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131012,
					"content": "O quê!? N-Não, eu, er... Digo! Eu estava apenas esclarecendo, só isso. Eu jamais, nunca, nem mesmo em meus sonhos, er... Cof!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131013,
					"content": "Vocês dois não precisam se preocupar. Por favor, esqueçam que isto aconteceu. Se meu pai souber disso, só eu serei responsabilizada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131014,
					"content": "Sim, é claro. Como desejar, minha senhora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131015,
					"content": "Mas o que acontecerá se suas ações aqui forem descobertas, Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131016,
					"content": "Não se preocupe, meu pai sempre foi um dos que me mimaram. O pior que ele faria seria condenar-me a meio dia sem comida, ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131017,
					"content": "Hã, Paimon nunca suspeitou que um cara como ele pudesse ser sentimental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "Desejo-lhe uma viagem segura. Tenho certeza de que nos encontraremos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131019,
					"content": "Adeus, Chisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131020,
					"content": "Ei, qual é! Pare de me encarar e vamos logo. Temos mercadorias para transportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131021,
					"content": "Tu-Tudo bem... Snif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131005,
					"content": "Por favor, tenha cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
