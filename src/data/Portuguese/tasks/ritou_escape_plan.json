			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Espere um pouco, por favor... Estas mercadorias estão sendo enviadas para... A Ilha Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "Minha senhora! Esta é uma honra inesperada. Você está certa, estas mercadorias foram repetidamente solicitadas pelo Comissário da Comissão Kanjou. Devemos garantir que elas cheguem intactas à Ilha Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "Algo errado, Senhorita Hiiragi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "Não, como você disse. Meu pai simplesmente tem algumas preocupações com a segurança da remessa, e ordenou que eu mesma e uma escolta qualificada fossem despachadas para garantir o transporte seguro da mercadoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Minha senhora, você não está sugerindo que pretende acompanhar a remessa pessoalmente, está? Certamente não há necessidade de você se incomodar com tal assunto, e quanto a esta \"escolta qualificada\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "Estou ansiosa para trabalhar com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "Por favor, não nos causem mais atrasos. Se a memória não me falha, meu pai já declarou que esta remessa deve chegar a tempo. Estou certa de que a punição será devidamente aplicada se isso não ocorrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Sim, é claro, minha senhora. É-É só que... Bem, nós não sabemos quem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "Agora, preciso lembrá-lo da punição se algo acontecer comigo no caminho? Tenho certeza de que todos vocês conhecem bem o temperamento do meu pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "Você realmente presume que pode garantir totalmente minha segurança por conta própria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Caramba, Chisato sabe mesmo usar as palavras certas, eles não têm chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "A-Ah, sim, minha senhorita. Muito bem, então... É-É uma honra ter você nos acompanhando. Sua segurança é nossa maior prioridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "Shinnojou! Você não pode estar realmente concordando com isso!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "Bem, o pedido é da própria Senhorita Hiiragi. É nosso dever servi-la na mais alta capacidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Sim, mas... Esse não é o problema aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "Bem, então, se já terminamos aqui, sugiro que partamos imediatamente. A madrugada só dará mais tempo aos potenciais ladrões para se prepararem, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "S-Sim, minha senhora. Você ouviu ela, não há tempo a perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "Você ousa questionar minhas habilidades?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
		{
			"id": 201310,
			"completionStepIds": [
				201310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
