					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131104,
					"content": "Ah... Espere, espere, espere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131105,
					"content": "Oh! Comissário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131106,
					"content": "#Est{F#as}{M#es} {F#duas}{M#dois} são convidad{F#as}{M#os} de honra vind{F#as}{M#os} de longe, não há necessidade de fazer o lenga-lenga de sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131107,
					"content": "Entre, vamos ver o que podemos fazer por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131108,
					"content": "Hnf! Você entendeu tudinho direito, rapazinho!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Paimon"
				},
				{
