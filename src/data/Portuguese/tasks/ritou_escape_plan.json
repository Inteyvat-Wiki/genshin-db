			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Chisato",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "Ah, você finalmente chegou... Pe-Permita-me que me apresente, eu sou Hiiragi Chisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130702,
					"content": "#Esta é... Tecnicamente a segunda vez que nos encontramos. É um prazer vê-l{F#a}{M#o} novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130703,
					"content": "Uau, ela é a filha do Clã Hiiragi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130704,
					"content": "O prazer é meu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "N-Não é preciso ser tão formal - há muito tempo estou maravilhada com suas conquistas... E finalmente tivemos a chance de nos encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130707,
					"content": "É a Paimon, ou algo parece estar errado aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130708,
					"content": "#A razão pela qual eu queria encontrá-l{F#a}{M#o} secretamente aqui é... Temia que nunca mais tivesse outra oportunidade de discutir isso com você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130709,
					"content": "Di-Discutir o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130710,
					"content": "Ahem... Eu gostaria de pedir sua ajuda para... Entregar uma carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Urg, tal pai, tal filha! Você não poderia ser mais original?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130714,
					"content": "N-não! Você não me entendeu - por favor... Permita-me explicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130715,
					"content": "Eu esperava que você pudesse entregar uma carta para a Ilha Narukami em meu lugar. Ela deve ser entregue a Kujou Kamaji da Comissão Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130716,
					"content": "Meu pai sempre me proibiu de me comunicar com Kujou Kamaji. Ele sabe que há possibilidades para o meu casamento que o serviriam melhor politicamente. Mas meu coração está com Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130717,
					"content": "#Não há ninguém que ousaria desafiar a vontade do meu pai em Ritou, mas vocês são forasteir{F#as}{M#os}, forasteir{F#as}{M#os} que procuram chegar à Ilha Narukami. Seria lamentável deixar passar tal oportunidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130718,
					"content": "Ah, agora Paimon entendeu tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130719,
					"content": "#É claro que, ao fazê-lo, também farei tudo o que estiver ao meu alcance para ajudá-l{F#as}{M#os} a deixar Ritou. Essa é a minha promessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130720,
					"content": "Hmm, parece ser um acordo razoável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "#Para ser completamente honesta... Enquanto você permanecer em Inazuma, meu pai não terá nenhuma intenção de deixá-l{F#a}{M#o} sair de Ritou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130723,
					"content": "Pois é, já imaginávamos. Era bastante óbvio que ele estava apenas tentando nos segurar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130724,
					"content": "Ouvi secretamente uma conversa entre meu pai e uma mulher muito arrogante há poucos dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130725,
					"content": "#Eles pareciam estar discutindo como mantê-l{F#a}{M#o} aqui em Ritou. Na verdade, foi a primeira vez que ouvi meu pai falar tão respeitosamente com alguém que não era a Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130726,
					"content": "Uma mulher que parecia muito arrogante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "#Não temos muito tempo. Vou lhes contar meus planos para ajudá-l{F#as}{M#os} a sair da ilha. Acontece que um carregamento de mercadorias está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130729,
					"content": "#(Hiiragi Chisato conta {M#ao}{F#a} Viajante seus planos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130730,
					"content": "Muito bem, estarei esperando por você na fronteira. Conto com você para entregar minha carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130727,
					"content": "Parece que temos que sair de Ritou o mais rápido possível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "Já que não temos outras opções...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "Estou saindo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "É um prazer revê-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
