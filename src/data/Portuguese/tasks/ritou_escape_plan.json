			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shinnojou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130401,
					"content": "Parem aí mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130402,
						20130403
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130402,
					"content": "Como eu esperava.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				},
				{
					"id": 20130404,
					"content": "Hã? O que fizemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130405,
					"content": "A Senhorita Hiiragi tem uma carta para você. Ela insiste para que você a leia imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130406
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130406,
					"content": "Uma carta? Rápido, deixe Paimon ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130407,
					"content": "#Car{M#o}{F#a} Viajante, gostaria de transmitir esta mensagem pessoalmente a você. Peço desculpas pela pressa com que esta carta chegou até você e espero que ela não o tenha deixado perplexo ou perturbado de forma alguma. Esta é a primeira vez que faço um convite a um forasteiro desconhecido, afinal de contas. Não é mera coincidência que nossos caminhos se tenham cruzado. Portanto, espero que você seja tão cortês a ponto de me encontrar esta noite, sob o véu do luar resplandecente. Por favor, não se preocupe com seguranças e guarda-costas, eu vou garantir que sua atenção estará em outro lugar. Aguardo com expectativa a sua companhia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130408,
					"content": "Então isso significa... Que ela quer que você a encontre em segredo à noite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130409,
					"content": "#Mas você não pareceu nada surpres{F#a}{M#o} com isso... O que está acontecendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130410,
						20130412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130410,
					"content": "Trocamos olhares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130411
					]
				},
				{
					"id": 20130411,
					"content": "Hã? Você tem feito algo pelas costas da Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130414,
					"content": "Hmm... Vamos interrogá-la esta noite e ver o que ela tem a dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130412,
					"content": "Shinsuke não tem a intenção de nos deixar sair.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130413
					]
				},
				{
					"id": 20130413,
					"content": "Paimon sabia que algo não parecia certo sobre ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130403,
					"content": "Eu sabia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130404
					]
				}
			]
		},
		{
			"id": 201307,
