				},
				{
					"id": 20131102,
					"content": "Estamos aqui para ver, uh... Você sabe, hm... o Comissário da Comissão Kanjou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131103,
					"content": "#O Comissário de Kanjou não costuma ver {F#as forasteiras}{M#os forasteiros}. Saia, agora ou seremos forçados a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
