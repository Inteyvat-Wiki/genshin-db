				{
					"id": 730210301,
					"content": "Minha sopa... *Choro* Como isso é possível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210302
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210302,
					"content": "(Sair em silêncio...)",
