		},
		{
			"id": 7302104,
			"completionStepIds": [
				7302103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302103",
							"2"
						],
						"stepId": 7302103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "Hmm... De fato é água da nascente do rio. Fonte de Água Viva fria e limpa, assim como o luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210402,
					"content": "Se Arachatora, Arasaka e Araphala crescessem bebendo esse tipo de água, eles com certeza não seriam os idiotas que são agora. Só Arapacati, minha irmã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210403,
					"content": "Hm-hm, e agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210404,
					"content": "Hã? Sim, agora, você tem que cozinhar uma nova panela de sopa para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210405,
					"content": "Com a orientação de Arapas, você adiciona algumas frutas e legumes na água e começa a cozinhar.\\nUm aroma bastante agradável emerge lentamente da panela.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "Quando concluída, vocês provam a sopa fresca juntos.\\nEla correspondeu às expectativas. Ela realmente possui o aroma dos ingredientes...\\nMas a sopa sem condimentos é muito simples.\\nÉ completamente sem gosto.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "Mmm, é assim que a Iguaria Suprema deve cheirar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210408,
					"content": "#Hmm... O que você acha {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210409,
					"content": "Pode saciar a sede como qualquer sopa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "Paimon acha que ficaria melhor com um pouco de sal e pimenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210412,
					"content": "Qualquer coisa fica melhor com sal e pimenta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "Grande Aramuhukunda! Você quer adicionar sal? Que ideia horrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210414,
					"content": "Terra com sal é terra sem vida, e os Aranaras são forçados a encolher até virar sementes. Ainda assim, Nara quer adicionar sal!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210415,
					"content": "Sopas devem ser insossas! Como vocês Nara não entendem isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210416,
					"content": "Aquela Nara de antes nos contou uma história depois de tomar uma tigela de sopa:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210417,
					"content": "\"Quando as crianças Nara estão voltando para casa, o aroma da sopa é a primeira coisa que sentem. Assim, aroma é tudo que uma sopa precisa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210418,
					"content": "#Depois disso, {F#ele}{M#ela} elogiou o aroma da sopa que Arapas fez. Eu nunca esqueci isso. Por isso que não acredito em você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210419,
					"content": "Mas apenas o aroma não é suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210421,
					"content": "Hmph! Mas como vocês são os Nara deste Festival Utsava, tenho certeza de que receberam as aprovações de Araja e Arapacati. Não tenho escolha a não ser tentar fazer uma sopa com sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210422,
					"content": "Da próxima, vou procurar água ainda melhor para fazer uma sopa ainda melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210423
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210423,
					"content": "... Não acho que o problema seja a água.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210424
					]
				},
				{
					"id": 730210424,
					"content": "Sério? Mas meu \"Treinamento Culinário\" terminou. Tudo bem, vamos ver o que fazer depois do Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210425
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210425,
					"content": "Eu te ensinei a fazer a sopa. É uma sopa aprovada pelo Grande Nara, então experimente mais algumas vezes. Mas não se esqueça de usar água boa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210426
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210426,
					"content": "#({NICKNAME}, vamos adicionar um pouco de tempero da próxima vez. Deve ficar muito boa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210410,
					"content": "Saudável demais para mim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				}
			]
		},
