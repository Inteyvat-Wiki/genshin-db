			"dialogs": [
				{
					"id": 765010801,
					"content": "E então? Conseguiu encontrar o material fotográfico que tinha em mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010803,
						765010802
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010803,
					"content": "Estamos prontos. Que comece a sessão de fotos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010804
					]
				},
				{
					"id": 765010804,
					"content": "Uma proposta maravilhosa. Mas, ainda assim, não vejo sua Kamera com você. Sem ela, nem mesmo os cenários mais deslumbrantes podem ser transformados em fotos para serem lembradas, não é?",
					"roleType": "TALK_ROLE_NPC",
