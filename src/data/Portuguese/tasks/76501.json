			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Ah. {NICKNAME}, Paimon. São vocês. Os pássaros da floresta acabaram de anunciar sua chegada. Vieram tratar de algo importante ou... por acaso precisam da minha orientação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Este lugar é bem nutrido pelo brilho da lua. A flora e a fauna que habitam aqui são diferentes de qualquer outra parte do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "Então sim, eu diria que é um ótimo lugar para tirar fotos incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Sintam-se à vontade para explorar. Caso tenham alguma dúvida, não hesitem em me procurar. Responderei da melhor forma possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Esse lugar realmente transmite uma sensação de tranquilidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Sim. É aqui que medito, onde me comunico com todos os seres vivos em sussurros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Só de ficar aqui parada, meu coração já se acalma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "Hehe, você é uma verdadeira poeta, Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "Na verdade, eu tenho um pequeno pedido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "É! Você combina perfeitamente com o cenário, como o centro de uma pintura belíssima! Com certeza vai ficar incrível na foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "Vocês gostariam de... tirar uma foto minha? Seria uma experiência inédita. Se acreditam que a serenidade deste lugar e a minha presença merecem ser eternizadas através da lente, ficarei feliz em atender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "De fato, seria uma honra adicionar mais uma lembrança feliz à sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "Então, como posso ajudar? Quer que eu olhe para alguma direção específica, ou assim já está bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Seja você mesma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "Certo, deixarei tudo em suas mãos. Que a inspiração, por mais fugaz que seja, venha te agraciar com sua presença.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "Vou te capturar no seu momento mais inspirador, pode deixar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Gostaríamos de tirar uma foto sua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Você costuma passar bastante tempo por aqui, Lauma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "E procurando algum material para fotos enquanto estamos nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
