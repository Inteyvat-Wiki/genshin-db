			"dialogs": [
				{
					"id": 765010701,
					"content": "#Ah. {NICKNAME}, Paimon. São vocês. Os pássaros da floresta acabaram de anunciar sua chegada. Vieram tratar de algo importante ou... por acaso precisam da minha orientação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010702,
						765010703
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010702,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010704
					]
				},
				{
					"id": 765010704,
					"content": "Ah, entendi. Fique à vontade para admirar a paisagem e tirar fotos do que quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010705
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010705,
					"content": "Dito isso, não vejo sua Kamera com você. Sem ela, nem mesmo os cenários mais deslumbrantes podem ser transformados em memórias fotográficas, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010703,
					"content": "E procurando por alguns materiais de fotografia por enquanto isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010704
					]
				}
			]
