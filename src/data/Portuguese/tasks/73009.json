			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana vai cuidar dela. Porque ela é uma amiga muito importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Então {NICKNAME}, peço que vá à Vanarana, e cante a \"Melodia do Sonho\". Depois peça ajuda para preparar a Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Não entendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Do mesmo jeito que uma nuvem sabe quando vai chover, que a gota de chuva sabe como abraçar o solo; Que uma semente entende que precisa crescer e se tornar uma árvore, e que árvore deve produzir frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "Eu, eu já sei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Então, {NICKNAME}, parece que não entendeu, mas não importa. Na hora H, {NICKNAME} vai saber o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
