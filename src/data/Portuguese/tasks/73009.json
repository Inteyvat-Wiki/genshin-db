			"dialogs": [
				{
					"id": 730091001,
					"content": "Sobre a Fruta Vasoma",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091002
					]
				},
				{
					"id": 730091002,
					"content": "É uma fruta cheia de energia. Cresce nas memórias e sonhos na terra, e precisa da ajuda de Aranara e Nara para dar frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091003,
					"content": "Uma Bija pode ser formada alimentando uma Fruta Vasoma para a Árvore Ashvattha. É uma grande árvore plantada pela própria Lorde Maior Rukkhadevata, e é a origem dos Aranaras.",
