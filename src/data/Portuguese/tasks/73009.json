				"objectNames": [
					"Araja"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "#Graças à {NICKNAME} e Paimon, eu pude participar do Festival Utsava. Eu agradeço muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "É uma pena, não posso mais ajudar vocês como Arama, e já não consigo acompanhar vocês em suas aventuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "Mesmo assim, este sonho estará sempre de portas abertas para vocês. Se o mundo lá fora ficar muito cansativo, podem vir para Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
		{
			"id": 7300914,
