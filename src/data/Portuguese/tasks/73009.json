				{
					"id": 730091101,
					"content": "Sobre o Aranyaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091102
					]
				},
				{
					"id": 730091102,
					"content": "#Pertencia à Nara Varuna. {M#ela}{F#ele} era {M#uma}{F#um} Nara {M#dourada}{F#dourado} que era gentil, corajos{M#a}{F#o} e honest{M#a}{F#o}, assim como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091103
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091103,
					"content": "#Ainda me lembro como os Aranaras daquela época sentiam falta de {M#dela}{F#dele} e adoravam as histórias {M#dela}{F#dele}. Mas acredito que já que Nara {NICKNAME} está aqui agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
