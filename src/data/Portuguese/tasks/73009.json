					"nextDialogs": [
						730091502
					]
				},
				{
					"id": 730091502,
					"content": "É uma fruta cheia de energia. Cresce nas memórias e sonhos na terra, e precisa da ajuda de Aranara e Nara para dar frutos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091503
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091503,
					"content": "Uma Bija pode ser formada alimentando uma Fruta Vasoma para a Árvore Ashvattha. É uma grande árvore plantada pela própria deusa das plantas, e é a origem dos Aranaras.",
					"roleType": "TALK_ROLE_NPC",
