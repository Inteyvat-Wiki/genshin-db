			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "#Olá, {M#amigo} {F#amiga} Nara! Hmm... Eu deveria te contar uma coisa, mas não me lembro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "Tudo bem, vê-los novamente nos deixa muito felizes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Sim, obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "Sobre \"Mawtiyima\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "Ela não está mais falando, mas está indo bem. Recuperando também, a floresta... Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "Sobre esquecer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Esquecer...? Ah, porque a energia se esgotou, Kusava. É por isso que vai fluir também, memória. Gota a gota, como gotas de orvalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
