			},
			"dialogs": [
				{
					"id": 732150601,
					"content": "#Nara dourad{F#a}{M#o}, Coisa Branca Voadora, vocês vieram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Sim! Nós viemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Heh heh... Acho que esqueci muitas coisas, então preciso que você me lembre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "É por causa do Kusava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Sim... Aranaga deve ter lhe contado. O poder está na memória, e sem memória não há poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "Por isso... Devemos ter passado por algo, mas não nos lembramos mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150607,
					"content": "Ha ha, mas isso não é nada! Ainda podemos começar a fazer novas memórias, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150608
					],
					"speakerTitle": "Aragaru"
				},
				{
