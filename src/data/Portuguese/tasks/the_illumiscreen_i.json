						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "Uau, você pegou o jeito rapidinho. Ok, agora que você já tem a ideia básica, é hora de experimentar pra valer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570202,
					"content": "É difícil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "Não. Você já não descobriu como girar as lanternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570204,
					"content": "Quando você estiver jogando de verdade, tudo que você precisa fazer é girar as três lanternas para que as imagens que elas projetam na tela se alinhem para fazer a imagem completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570212,
					"content": "Posso falar antecipadamente as combinações de imagens, mas cabe a você descobrir como rodar as lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570205,
					"content": "O que acontece quando elas se sobrepõem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "Você pode ou não ter notado que essas telas têm o mapa de Liyue pintado nelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570207,
					"content": "Quando você alinha as imagens e as ilumina no mapa, você encontrará um tesouro especialmente preparado pela Guilda dos Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570208,
					"content": "A Guilda tinha muita gente trabalhando para montar todos os locais do tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570213,
					"content": "Os baús, no entanto... São como estes baús aqui. Uma vez que você conheça os locais, você será capaz de encontrar eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570209,
					"content": "Já ajustei a imagem de hoje. Ela é um <color=#00E1FFFF>Lírio de Vidro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570210,
					"content": "Uma outra coisa - as imagens na Kaleidolanterna só aparecem claramente à noite. É melhor voltar à noite para tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570211,
					"content": "Além disso, o Guilda dos Aventureiros encarregou um especialista de fazer estas lanternas. Elas são realmente muito bonitas, então, por favor, olhe bem de perto para elas ou tudo isso terá sido um desperdício...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
