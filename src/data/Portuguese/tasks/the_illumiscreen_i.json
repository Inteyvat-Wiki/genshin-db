			"dialogs": [
				{
					"id": 413570301,
					"content": "Como está indo a caça ao tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570302,
					"content": "Achei todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "Todos eles!? Você tem um dom para encontrar tesouros, então. Muita gente não consegue nem mesmo fazer as lanternas girarem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570304,
					"content": "Já que você encontrou todos os tesouros... Por favor, aceite estes como seu prêmio. Feliz Ritual de Lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
