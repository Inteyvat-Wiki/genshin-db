			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "Seja bem-vindo a testar a Kaleidolanterna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570102,
					"content": "...Kaleido o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "Kaleidolanterna. O que me diz? Vamos lá, é muito simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570104,
					"content": "Vê aquelas telas ali? E estas três lanternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570105,
					"content": "Mandei fazer estas lanternas sob encomenda. Quando você as acende, elas emitem todo tipo de imagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570106,
					"content": "E se você girar as três lanternas da maneira correta, as três imagens se combinarão para lhe dar a imagem completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413570107,
					"content": "Hmm, talvez eu não esteja explicando isso claramente... OK, que tal assim - primeiro faça girar as lanternas, e quando você se sentir confortável com a forma como funciona, eu lhe direi como funciona o jogo inteiro com mais detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
