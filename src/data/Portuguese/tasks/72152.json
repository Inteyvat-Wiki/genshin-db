			"dialogs": [
				{
					"id": 721520101,
					"content": "\"...Era aqui que o grande pirata Rinzou guardava seu tesouro. Os rapazes retiraram os últimos baús...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Notas de um Ladrão de Tesouros"
				},
				{
					"id": 721520102,
					"content": "\"...Mas Rinzou foi um homem astuto e deixou vários símbolos especiais na ilha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Notas de um Ladrão de Tesouros"
				},
				{
					"id": 721520103,
					"content": "\"...Pode ser uma cortina de fumaça, ou pode realmente haver um tesouro. Mas só descobriremos se formos lá e vermos por nós mesmos...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Notas de um Ladrão de Tesouros"
				},
				{
					"id": 721520104,
					"content": "\"...Encontramos alguns desses símbolos. Bem, o tempo não espera por ninguém. Melhor irmos desenterrar todo o tesouro de Rinzou!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Notas de um Ladrão de Tesouros"
				},
				{
					"id": 721520105,
					"content": "Uau, isso é... muito longo... Paimon não vai se dar ao trabalho de ler nada além da parte sobre o tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Espere... Tesouro!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "Vamos, Viajante, há um tesouro a ser encontrado! Não podemos deixar que os Ladrões de Tesouro cheguem na nossa frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
