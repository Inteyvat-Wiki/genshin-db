			"dialogs": [
				{
					"id": 761680101,
					"content": "Nada me dá tanta energia para patrulhar quanto um pão quentinho e delicioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "Estou pegando os suprimentos necessários para a patrulha, mas parece que estamos sem o meu favorito, o Pão de Cogumelo Fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "É um novo tipo de pão que a Srta. Beryna criou. Todo mundo gosta tanto que nunca fica disponível por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "*Suspiro*... Só de pensar em não conseguir nenhum Fungo Fantasma já me tira toda a motivação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "Eu sei como fazer isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "Sério? Que incrível, meu amigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "Nesse caso, será que eu poderia pedir para você preparar um pouco de Cogumelo Fantasma para mim? Não se preocupe, eu vou recompensá-lo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lantainen"
				}
			]
