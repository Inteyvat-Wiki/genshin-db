				{
					"id": 220450301,
					"content": "Mm? O que você está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Tirando fotos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "#...E o que são esses? Você é realmente estranh{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Eh, isso não importa. Continue como estava - basta não bagunçar o santuário.",
					"roleType": "TALK_ROLE_NPC",
