			"dialogs": [
				{
					"id": 220450401,
					"content": "Como foi? Conseguiu as fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450402,
					"content": "Não foi tão difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "Deixe-me ver... Ooh! Este ângulo... Esta pose... Bastante bom! Bastante bom mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450404,
					"content": "Bem... você parece animado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "Claro que serve! Elas são boas demais como material de referência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450407,
					"content": "Muito obrigado, Viajante. Por favor, tome estes. Começarei a praticar daqui a pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450408,
					"content": "Oh, isto é muito bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450405,
					"content": "Será que isso serve?",
					"roleType": "TALK_ROLE_PLAYER",
