			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "Hmm, isto ainda não parece muito certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "Ah, Viajante, você chegou em um bom momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450104,
					"content": "Recentemente, tive a sensação de que as esculturas em madeira que tenho feito... não têm... você sabe, a vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450105,
					"content": "Bem, elas são feitas de madeira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "Oh, não é isso que eu quero dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450108,
					"content": "Hmm. Como posso explicar isto? O que eu estou procurando é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450109,
					"content": "Sabe, nossa sacerdotisa chefe provisória está quase sempre dormindo, mas, às vezes, ela acorda e caminha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450110,
					"content": "Enquanto caminha, ela roda ou saltita, pula em algumas folhas caídas, ou se estica, e coisas assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450111,
					"content": "Quero captar isso em movimento. Quero fazer esculturas usando estas ações como base. Isso é o que quero dizer com \"vida\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450112,
					"content": "Vá ver por si mesmo, então...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "Bem, eu, uh... Estou com um pouco de vergonha de fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450115,
					"content": "Digamos o que dissermos, ela é minha chefe. Sinto que se eu me agachasse ao lado dela e observasse, talvez a fizesse infeliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450116,
					"content": "Seu relacionamento, por outro lado, deveria ser muito melhor. Então, você poderia me ajudar a tirar algumas fotos para usar como material de referência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450117,
					"content": "Tudo bem, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "Muito obrigado, Viajante. Apenas me traga essas fotos quando terminar de tirá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450118,
					"content": "Se não conseguir capturar as ações desejadas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "Não há problema. Você não tem que ir para esses grandes movimentos. Não acho que minha técnica de esculpir pudesse acompanhar isso no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450120,
					"content": "Basta capturar algumas poses. Acho que isso serve, por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450113,
					"content": "Bem, a Neko está ali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "Que tipo de \"vida\" você está procurando injetar em sua arte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
