			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "#Que tal? Está confortável sentad{M#o}{F#a} aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Você apareceu do nada, quer me matar de susto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Desculpe! Não era a minha intenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "O meu nome é Kabayama, e eu também sempre me sento no lugar onde você está agora. É um lugar muito adorável, tranquilo onde você pode pensar na vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Você quer que eu lhe devolva esse lugar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Não é preciso! A propósito, você não é daqui, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Não, não sou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "Então você deve ter muito conhecimento... Eu nunca saí daqui, apesar de já ter mudado de casa várias vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "Falando em mudar de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "Eu mudava de casa tão frequentemente quando era jovem, que nunca consegui fazer amigos próximos. Vi muitas paisagens lindíssimas, mas nunca tive ninguém com quem compartilhá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Sabe que mais? Eu poderia mostrar esses lugares para você. Se você passar por paisagens como essa, sente-se apreciando a vista. Depois volte para me dizer como se sentiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Um desses lugares fica abaixo de um Portal de Pedra no ponto mais alto do Estreito. Um se encontra em um espaço aberto cercado de corais perto do Templo da Noite Eterna, e o último está ao lado das torres das ruínas do Coração da Serpente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Marquei esses lugares no seu mapa e penduramos lá uma lâmpada para iluminar seu caminho. Deve ser fácil para você encontrá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223402,
