			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "Você está de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340202,
					"content": "Você ainda não conseguiu encontrar todos os lugares? Que pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340203,
					"content": "Então eu vou te dizer mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340204,
					"content": "Um desses lugares fica abaixo de um Portal de Pedra no ponto mais alto do Estreito. Um se encontra em um espaço aberto cercado de corais perto do Templo da Noite Eterna, e o último está ao lado das torres das ruínas do Coração da Serpente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340205,
					"content": "Marquei esses lugares no seu mapa e penduramos lá uma lâmpada para iluminar seu caminho. Deve ser fácil para você encontrá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
