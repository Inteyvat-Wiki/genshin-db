					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 718040402,
					"content": "Sobre a nova licença de negócios de Ivanovich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich... Oh, eu acho que ele veio já veio aqui várias vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 718040404,
					"content": "Ele está tratando da licença de negócios? Hahaha, ele deve ficar cansado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 718040405,
					"content": "Você veio como representante dele, não é? Trouxe a <color=#00E1FFFF>Resposta de Permissão</color>? Na outra vez eu falei com ele, a documentação estava incompleta, ele devia ir noutro lugar terminar de resolver ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An Nervoso"
				}
			]
		},
