				},
				{
					"id": 718040502,
					"content": "Sobre a nova licença de negócios de Ivanovich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "Ah? Você está tratando disso por outra pessoa? Por favor entregue a Premissas de Negócios... junto com Certificado de Segurança... Você trouxe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "Você é o responsável pela licença de negócios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "Não não. Eu vim para dar uma mão. A Escriturária Zhao estava muito ocupada e não conseguiu tratar sozinha, portanto, vim fazer o trabalho de documentação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "Ai! Estou com muita dor de cabeça com esse trabalho... Bom, você trouxe Premissas de Negócios e Certificado de Segurança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
