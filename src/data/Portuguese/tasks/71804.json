			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "Você achou algum anúncio relacionado a nova licença de negócios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040302,
					"content": "EU fiz uma cópia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Ótimo, deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040304,
					"content": "Resposta de Permissão, Premissas de Negócios e Certificado de Segurança... e a Licença de Negócios antiga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040305,
					"content": "Bom, bom, corri consegui a assinatura desses documentos alguns dias atrás, eles me deixaram realmente cansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040306,
					"content": "Viajante, você poderia me ajudar novamente entregando esses documentos separadamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040307,
					"content": "Talvez tenha que entregar para várias pessoas diferentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040308,
					"content": "Primeiro, entregue a <color=#00E1FFFF>Resposta de Permissão</color> para An Nervoso, depois entregue a <color=#00E1FFFF>Premissas de Negócios e o Certificado de Segurança</color> para o Millelith Jiayi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040309,
					"content": "Ainda tem uma <color=#00E1FFFF>Licença de Negócios antiga</color>, pode entregar para a Escriturária Zhao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040310,
					"content": "Viajante, obrigado pela sua ajuda, eu lhe darei uma ótima recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040311,
					"content": "Está bem, está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Espero que depois de resolver esses procedimentos, não precise ficar mais correndo de um canto para outro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040313,
					"content": "Espero isso também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Depois que resolver isso, você não precisa mais ficar correndo, mas eu... No mundo dos negócios, isso é inevitável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040315,
					"content": "Apesar da maneira com que lidamos com os negócios deixam as pessoas relaxadas, não haveria nenhum problema em simplificar o processo um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
