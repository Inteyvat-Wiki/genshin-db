			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "\"Este é o Quadro de Avisos da Encosta Feiyun. Você poderá encontrar notícias da comunidade e anúncios de lojas publicados aqui. Por favor, não publique assuntos sem importância.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 718040202,
					"content": "Explicação sobre a transferência de pessoal do Ministério dos Assuntos Civis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "\"A transferência de pessoal do Ministério dos Assuntos Civis tem os seguintes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 718040204,
					"content": "Espere um pouco, a transferência de pessoal do Ministério dos Assuntos Civis não tem relação com uma licença para fazer negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Informação sobre a situação da fonte poluída na Encosta de Feiyun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "\"Sobre a questão recente da fonte poluída da Encosta de Feiyun...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 718040207,
					"content": "O senhor Ivanovich está com muita pressa em gerir os seus assuntos, não tem tempo de sobra para poluição de água...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Sobre como se registrar para a nova licença de negócios...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "\"Se precisar se registrar para a nova licença de negócios, é necessário fazer o seguinte procedimento...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 718040210,
					"content": "Isso deve ser a licença que o Sr. Ivanovich quer se registrar, vamos copiá-la rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
