			"dialogs": [
				{
					"id": 230200501,
					"content": "Oh, obrigado, Viajante! Aqui está seu pagamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Mas este material é realmente inesperadamente pesado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Começarei a trabalhar nele o mais rápido possível. Isso não tomará muito tempo, o barco deve estar pronto para o mar em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "... Quando chegar a hora, é melhor você ter seu equipamento de resgate pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Ah, vai ficar tudo bem, com certeza! Tenha um pouco de fé em mim.",
