			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "...É por esse motivo que eu não acho que podemos economizar demais nos materiais nessa área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200102,
					"content": "Não se preocupe, a força é suficiente. Já fiz os cálculos necessários várias vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "Argh, eu já te disse, muitos problemas não podem ser simplesmente calculados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200104,
					"content": "Sobre o quê vocês estão brigando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Ah, é você. Estamos discutindo os problemas de design daquele meu navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Fiz muitos cálculos e posso garantir que cada área tem força suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Mas Qishan insiste em dizer que a resistência calculada não é necessariamente confiável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "A \"força\" de que você está falando só existe em teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200109,
					"content": "O navio terá que sustentar pressão enquanto estiver na água, e será bem mais do que os números que você tem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200110,
					"content": "Eu entendo a lógica, mas... mas minhas finanças são limitadas, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "Se eu comprar materiais mais caros, no máximo poderei terminar a quilha do navio... Ahem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "De qualquer forma, vamos construir este navio de acordo com o meu projeto por agora. Já comprei todos os materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "Viajante, se você não se importar, poderia me ajudar a buscar alguns materiais? Eu não consigo fazer tudo sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "Estou contando com você, tenho que fazer algumas contas. Pegarei o resto quando terminar por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "Qishan também entende de construção naval?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Oh, sim. Ela é ainda mais rápida do que eu em alguns cálculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "Eu não faço ideia por que quer ficar trabalhando como assistente aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
