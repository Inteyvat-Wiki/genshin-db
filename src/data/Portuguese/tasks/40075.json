					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400750801,
					"content": "Oh, estamos de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750802,
					"content": "Mona, esse aventureiro... Ele está morto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750803,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750804,
					"content": "Essa foi a única vez que eu o vi. E já passaram mais de três anos, isso quer dizer que... Ele já não está mais nesse mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750805,
					"content": "Mas não há chance que ele esteja vivo? Sabe, você pode ter errado e tal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400750806,
					"content": "Mas isso não é justo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750807
					]
				},
				{
					"id": 400750807,
					"content": "Você não pode chamar de \"adivinhação\" se rejeitar as coisas ruins e somente acreditar no que é bom. Isso é mentir para si mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750808
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750808,
					"content": "Claro, fazer adivinhações para se divertir é outra questão, mas na minha área, não há espaço para mentiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750809,
					"content": "Negar minhas próprias leituras seria uma blasfêmia contra a astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750810
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750810,
					"content": "Cruel, mas é a verdade. Assim é o destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750811
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750811,
					"content": "Eu geralmente não digo coisas assim, mas já que estamos no tópico, espero que vocês não confundam a astrologia com aqueles rolinhos da sorte que se oferecem nas ruas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750812
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750812,
					"content": "Astrologia não existe para satisfazer ninguém. Nós astrólogos estamos aqui para verificar e testemunhar as verdades desse mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750813,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750814
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750814,
					"content": "Ah! É justamente por isso que astrólogos são desprezados! É uma arte poderosa, e também é algo que incomoda as pessoas, mas isso não é uma contradição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750815
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750815,
					"content": "Por que protestas demasiado, Senhorita Megistus? Não pareces ser daqueles que desagradar-me-ia ter como associada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750816
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750816,
					"content": "O que a Princesa quer dizer é que ela está feliz de ter amigas como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750817
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750817,
					"content": "Não! Não foi isso que eu disse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750818
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750818,
					"content": "Oz, que está a acontecer contigo? Estás a interpretar erroneamente minhas proferições em um ritmo cada vez mais frequente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750819
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750819,
					"content": "Oh, por que seria? Talvez eu estivesse preocupado que minha Princesa poderia ofender seus amigos, e tentei aliviar suas palavras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750820
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750820,
					"content": "Apesar de você ser a única astróloga que conheço, você deixou uma impressão incrível em mim. Não me incomoda nem um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750821
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750821,
					"content": "As pessoas que gostam de bisbilhotar, mas que ignoram o que não querem ouvir é que precisam refletir. Saber seu destino tem seu preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750822
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750822,
					"content": "Se fosse possível evitar o destino com algumas palavras, ninguém teria de suportar a dor da separação. Mona, não leve tão a sério os comentários das outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750823
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750823,
					"content": "Siga seu coração e nunca esqueça o que é certo, isso é o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750824
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400750824,
					"content": "Ahem! Eu—Eu não preciso ser confortada, obrigada! Saiba que sou bem durona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750825
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750825,
					"content": "Então por que você está avermelhada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400750826
					]
				},
				{
					"id": 400750826,
					"content": "Hã, bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750827
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750827,
					"content": "Bem, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750828
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750828,
					"content": "Obrigada, pessoal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750829
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750829,
					"content": "O que dizes? Fale mais alto, demonstre teu respeito e bênçãos à sua Princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750830
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750830,
					"content": "Está bem, está bem. Princesa, ao invés de discutir, que tal ir coletar os outros fragmentos no novo local refletido pela piscina? Não podemos entrar na miragem sem eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750831
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750831,
					"content": "Minha Princesa, és a única com olhos aguçados para localizar os segredos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750832
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400750832,
					"content": "Tal sendo o caso, muito bem, partirei para a praia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750833
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400750833,
					"content": "Vamos, Mona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750834
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400750834,
					"content": "Oh, certo! Estou indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400750835
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400750835,
					"content": "...Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		}
	]
}