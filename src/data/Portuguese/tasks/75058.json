			"dialogs": [
				{
					"id": 750013301,
					"content": "Estranho... os padrões dourados saíram voando, igual antes, mas a Inscrição não apareceu debaixo desse pilar... Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013302,
					"content": "Isso indica que não só a Inscrição foi removida, como também ficou fragmentada... Isso é ruim. Precisamos encontrar as partes espalhadas, e rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013303,
					"content": "Então onde a gente encontra elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013304,
					"content": "...Eu também não sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013305,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013306,
					"content": "Elas estão espalhadas, mas também são restringidas pela energia, então ainda devem estar por perto. Talvez só precisemos dar uma olhada por aí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013307,
					"content": "Rawr, rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "Hã? Você quer ir lá? Estamos fazendo uma coisa bem importante agora — a gente brinca com você depois, beleza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013309,
					"content": "Hmm... Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "Você quer dizer que a Inscrição tá ali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "Hmm. Eu soube que mesmo agora, ainda há Saurianos que podem sentir o poder da Inscrição, mas eu sempre achei que fosse mito — será que é verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013313,
					"content": "#Acho que você não é mesmo um Tepetlissauro qualquer, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013314,
					"content": "Então você também pode fazer isso, hein?... Mesmo assim, ainda falta muito para você ser um guia tão bom quanto Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013315,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "Paimon tá com inveja de você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "Deixa de mentira! Paimon é super generosa! Esse é só o jeito dela de te elogiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013320,
					"content": "Hmm... Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "*Suspiro* Esse carinha não entendeu nada. Argh, se fosse um pouco mais inteligente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013322,
					"content": "Tenho certeza que vai entender um dia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "Precisamente. Aqueles encarregados dos cuidados dos Saurianos sempre dizem que precisa de tempo para estabelecer uma conexão emocional com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013324,
					"content": "O segredo é o seguinte — paciência e comunicação constante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013325,
					"content": "#Verdade. Paimon também não entendia o que {REALNAME[ID(2)|SHOWHOST(true)]} tava tentando dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013326,
					"content": "#Desculpa, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013327,
					"content": "Hmm, rawrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "Mas você responde rápido, isso Paimon sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013329,
					"content": "Tudo bem, vamos para o caminho que você indicou e ver se a gente consegue encontrar algum padrão dourado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013318,
					"content": "Viu, Paimon tá te elogiando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "Bem, isso é verdade, mas não deixa isso subir pra sua cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}