			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "Como posso ir entregar tudo isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "#Oh, é {F#a}{M#o} Viajante. Você chegou na hora certa para aproveitar o Ritual de Lanternas. Você é muito {F#sortuda}{M#sortudo}, mas não consigo ficar feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "Nós, de Liyue, temos a tradição de soltar Lanternas Celestes durante o Ritual de Lanternas. Portanto, todo ano, quando chega essa época, o transporte de materiais para fazer Lanternas Celestes se torna muito grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "Não sei se minha percepção está errada, mas creio que a quantidade de mercadorias desse ano está bem maior que a dos anos anteriores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "É um pouco demais para mim neste momento e, além disso, aquele comerciante continua a me apressar, sem qualquer consideração pelas condições da estrada aqui em Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "Estou disposta a pedir ajuda a alguém, mas não fui capaz de encontrar ninguém adequado. Você está querendo participar de um trabalho de escolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Ótimo! Gosto de pessoas diretas. Se ao menos a pessoa que estávamos acompanhando fosse mais como você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "Seu nome é Fran, uh... Francos. Ugh, nomes estrangeiros são tão difíceis de pronunciar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "Se você quiser ajudar, encontre comigo no local onde as mercadorias estão sendo armazenadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "Marquei o local específico no seu mapa. Vou para lá primeiro. Vamos nos encontrar daqui a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "Um comerciante de Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "É isso mesmo. Qual era o seu nome... Fran... Fran... Ugh, nomes estrangeiros são tão difíceis de pronunciar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "Também não sei o que ele quer com um lote tão grande de mercadorias, mas... Desde que ele pague.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "Não se preocupe, terá a sua parte assim que o trabalho estiver feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181603",
							"2"
						],
						"stepId": 7181603,
						"stateName": "QUEST_STATE_UNFINISHED"
