			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Aqui é o local em que armazenamos esses materiais. Se você puder nos ajudar, só precisa levá-los para o Balão de Transporte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "Entretanto, eu devo lhe lembrar que essas mercadorias são materiais para fazer Lanternas Celestes. São todas muito frágeis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "Se elas forem danificadas ou queimadas, não servirão. Você precisa tomar muito cuidado enquanto estiver no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "Às vezes há monstros e Ladrões de Tesouro neste caminho, você deve ter muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Bem, vou deixar esta para você. Assegurem-se apenas de que os bens cheguem a Francis sãos e salvos, e nos encontraremos depois na ponte a sudoeste do Penhasco Chihu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
