				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Oh céus, meu pedido finalmente chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "#Pelo seu estilo de vestir, amig{F#a}{M#o}, você também não deve ser {F#uma}{M#um} local de Liyue. Acertei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "#Ah, amig{M#o}{F#a}, não sei se teve o privilégio de provar as iguarias de Liyue, mas elas são encantadoras. Acredite em mim, elas valem absolutamente a pena experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "Muito bem, agora que a minha carga chegou, posso voltar a comer em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
