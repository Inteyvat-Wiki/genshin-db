			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Eu e Francis nos falamos. Foi graças a você que ele recebeu aquelas mercadorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "Quando vocês se falaram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Haha. Não leve a mal. Nossos guardas de aluguel são bem mais rápidos que uma pessoa comum, e fazem as coisas com rapidez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "Obrigada por sua ajuda. O mais justo é dar uma recompensa para você. Espera um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "Você não descansa nem durante o Ritual de Lanternas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "No nosso ramo de atividade, nunca se sabe quando haverá trabalho. Nem podemos estar em casa para celebrar o Ritual de Lanternas com a família. Não temos outra opção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "Se você estiver viajando pelo mundo, você deve ir a Liyue para experimentar o Ritual de Lanternas - todos soltam as lanternas celestes durante o Ritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "E você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Oh, trabalho fora da cidade ano após ano. Nunca tive tempo de soltar uma lanterna celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "Se eu tivesse uma lanterna já pronta, seria certamente bom soltar uma para boa sorte, mas eu própria não tenho tempo para fazer uma lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160513,
					"content": "Estou perdendo essa alegria festiva com certeza, mas acho que não importa tanto assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160514,
					"content": "Porque eu não faço uma para você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "Uh? Você me ajudará a preparar a Lanterna Celeste? Você é uma pessoa boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160515,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "Você já soltou uma lanterna celeste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "Ainda não. Viajantes como nós não têm tempo para este tipo de coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
