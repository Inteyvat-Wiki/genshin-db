			"dialogs": [
				{
					"id": 140030101,
					"content": "Mil desculpas, Srta. Charlotte, mas minha irmã e eu estamos muito ocupados hoje. Receio que terei que recusar esta entrevista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "Oh, por favor, Lyney? Só levará um momento! Se puder fazer esta gentileza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "Ué? O que está acontecendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "Eu passei a noite toda escrevendo meu artigo sobre a Doninha Fantasma, e ia ser impresso esta manhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "Mas assim que o sol nasceu, eu recebi notícias repentinas que a noiva de Cesar, Jemma, entrou em contato com os Gardes e confessou ser a verdadeira Doninha Fantasma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "Assim tão rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "Ahem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Tarde demais, irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Hahaha! \"Assim tão rápido?\", não é? Parece que alguém está sabendo das coisas! Por favor, me contem tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Aha! Meus instintos não se enganaram — vocês ESTÃO escondendo algo! A confissão de Jemma deve ter algo a ver com a apresentação de Lyney na noite passada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Talvez enquanto assistia o truque de fuga, ela lembrou dos tempos que passou com Cesar e ficou com a consciência pesada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Hmm, faz sentido... Espera! Não, não, não, tem que ter mais coisa! Se só precisou isso para ela mudar de ideia, como pôde demorar 10 anos inteiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "Bem, quanto a isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(O espírito jornalístico de Charlotte está tinindo — vamos ter que distraí-la de alguma maneira...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "Ah, eu lembro agora! Vocês e Jemma estavam desaparecidos logo depois do show... O que aconteceu entre vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "Pergunta rápida! Onde vocês todos foram depois do show?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "Bem, nós fomos ao cemitério... e Lyney mostrou um truque de mágica lá, só para gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "Falando nisso, parece que agora Lyney também usa Rosas Arco-Íris nos seus truques!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "*Cof cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "...Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "#Até onde me lembro, nunca recebi uma Rosa Arco-Íris de você, irmão. Quer dizer que el{M#es}{F#as} são mais importantes para você do que eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "Não! Eu... Isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "E-Espera um pouco. Que reação é essa? Paimon disse alguma coisa errada de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#Agora pintou um climão... O que a gente faz, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "*Suspiro* Parece que essa entrevista estava fadada a não acontecer. Bem, sem problemas — sempre haverá uma próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Perdoem minha persistência, mas com notícias explosivas assim, eu não consigo deixar de lado! As notícias de Jemma já causaram muita comoção, e eu não vou parar por nada até chegar ao fundo disso tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "Aparentemente, uma das coisas que ela disse aos Gardes foi que o seu desejo final era ver Lorenzo uma última vez. *Suspiro* Claramente tem uma rede de relacionamentos complicados aí... Não posso evitar ficar curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Enfim, vou deixar vocês conversarem em paz. Até a próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "Hmm, Lynette, na verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "Não se preocupe, não estou com raiva. Só estava tentando distraí-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "Oh, é mesmo? Ufa, você assustou a Paimon, viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Bem, até eu quase me enganei... Mas foi bom que nossa improvisação de última hora funcionou, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "...Por favor, cuidem bem daquela Rosa Arco-Íris.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Eu ficaria triste se perdessem ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}