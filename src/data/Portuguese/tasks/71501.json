			"dialogs": [
				{
					"id": 715010101,
					"content": "Hmm... A situação está cada vez pior nesses últimos dias, o movimento da Equipe de Exploração está limitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010102,
					"content": "Quem será que pode resolver uma missão dessas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010103,
						715010104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010103,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				},
				{
					"id": 715010105,
					"content": "#Olha, são {NICKNAME} e Paimon, chegaram na hora certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010106,
					"content": "Na hora certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010107,
					"content": "Pelo visto surgiu algum problema de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010108,
					"content": "Nesses últimos tempos, não sei porquê, uma grande quantidade de lama preta está sendo jorrada das minas e túneis do Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010109,
					"content": "Por se tratar de uma emergência, a Equipe de Exploração não pôde responder imediatamente e o progresso da investigação parou diversas vezes. Khedive também comissionou a Guilda de Aventureiros na busca de ajudantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010110,
					"content": "Quê? Lama preta, será aquela debaixo do Despenhadeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010111,
					"content": "Sim, é exatamente aquela Lama Preta, não sei como surgiu nas minas e túneis. Nem preciso dizer que o processo de investigação da Equipe de Exploração está sendo prejudicado, até as operações diárias foram afetadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010112,
					"content": "Afinal, muitos recursos e materiais dependem dos túneis nas minas para transporte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010113,
					"content": "Há quanto tempo está assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010114
					]
				},
				{
					"id": 715010114,
					"content": "Já faz um tempo, embora Khedive diga que encontrou o Estudioso de Sumeru, que está disposto a ajudar, mas esse estudioso também precisa de ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010115,
					"content": "Pensar em quem poderia solucionar esse problema já estava me dando dores de cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010116,
					"content": "Uma missão do Khedive, a recompensa deve ser grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010117,
					"content": "Ninguém quer ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010118,
					"content": "Afinal, aquela Lama Preta é muito perigosa... Ninguém está disposto a aceitar esta missão. Apesar de muitos terem vindo por causa da recompensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010119,
					"content": "Mas muitos aventureiros desistiram assim que descobriram que se trata do Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010120,
					"content": "Além disso, a maioria dos aventureiros não está familiarizada com o ambiente do Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010121,
					"content": "Aqueles que podem aceitar esta missão não devem ter medo do perigo, e também dever ter um bom conhecimento do ambiente do Despenhadeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010122,
					"content": "Eu estava preocupada em como encontrar alguém capaz dessa missão, aí vocês apareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010123
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010123,
					"content": "#Entendi. {NICKNAME}, parece que a situação é realmente crítica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010124,
						715010125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010124,
					"content": "Sim, temos que ir conferir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010126,
					"content": "Então vamos agora para o Despenhadeiro encontrar Khedive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010127,
					"content": "Ah, quanto a isso... Khedive disse que você deve ir diretamente ao encontro do Estudioso de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010128,
					"content": "Sua fala original foi: \"Se houver alguém disposto a vir, o encaminhe para o acampamento no Despenhadeiro. Aquele cara está lá ajustando o equipamento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010129
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010129,
					"content": "Está bem, iremos agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010130
					]
				},
				{
					"id": 715010130,
					"content": "A segurança do Despenhadeiro está em suas mãos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 715010125,
					"content": "Considere como uma ajuda ao Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010126
					]
				},
				{
					"id": 715010104,
					"content": "Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010105
					]
				}
			]
		},
		{
			"id": 7150102,
