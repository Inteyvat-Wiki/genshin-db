			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hosseini"
				],
				"points": [
					{
						"sceneId": 6,
						"position": [
							1007.447,
							1015.942,
							879.091
						],
						"pointId": 600100139
					},
					{
						"sceneId": 6,
						"position": [
							1006.518,
							1015.976,
							880.314
						],
						"pointId": 600100246
					}
				]
			},
			"dialogs": [
				{
					"id": 715010201,
					"content": "Não esperava que o ambiente aqui fosse tão especial... Neste caso, o sistema de energia da Ponta de Pursina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010202
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010202,
					"content": "#Hã? {NICKNAME} e Paimon, há quanto tempo, o que estão fazendo aqui no Despenhadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010203
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010203,
					"content": "Então, parece que ouvi Khedive dizer que você foi de grande ajuda à Equipe de Exploração no Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010204
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010204,
					"content": "No entanto, o ambiente atual do Despenhadeiro tornou-se mais severo e perigoso do que antes, por isso não é um lugar para passeios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010205
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010205,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010206
					]
				},
				{
					"id": 715010206,
					"content": "Não acabamos de nos encontrar há pouco tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010207
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010207,
					"content": "Embora pareça que toda vez que nos encontramos estou te incomodando com diversas coisas, não precisa fingir que não me conhece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010208
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010208,
					"content": "Esquece, então irei apresentar-me novamente. Eu sou Hosseini, um estudioso da Academia de Sumeru. Eu conduzi pesquisas sobre o Disco Transmissor, e também fui a Inazuma conduzir investigações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010209
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010209,
					"content": "Mas agora os fundos de pesquisa esgotaram, então tive que voltar para Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010210
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010210,
					"content": "Oh, acho que estou me lembrando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010211,
					"content": "Você se lembrou de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010212
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010212,
					"content": "Você é o Homem do Disco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010213,
					"content": "...Tenho certeza que não sou um \"Homem do Disco\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010214
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010214,
					"content": "Resumindo, no caminho de volta para Sumeru, recebi um pedido de um outro estudioso da Academia, Khedive. No passado, Khedive me ajudou algumas vezes, principalmente com verbas de pesquisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010215
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010215,
					"content": "Por isso, irei ao Despenhadeiro para ajudá-lo a resolver este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010216
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010216,
					"content": "Acho que fui bem claro agora, e você, por que veio para o Despenhadeiro neste momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010217,
						715010218
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010217,
					"content": "#Fomos comissionad{M#os}{F#as} pelo Khedive...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010219
					]
				},
				{
					"id": 715010219,
					"content": "Ah, então são vocês. Fiquei até preocupado quando Khedive disse que pensava em procurar a ajuda de alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010220
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010220,
					"content": "Mas já que são vocês, fico aliviado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010221
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010221,
					"content": "Se eu fosse o único cuidando do incidente da Lama Preta do Despenhadeiro, iria gastar muita energia. Com a sua ajuda, a probabilidade de sucesso... aumentou um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010222
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010222,
					"content": "O que precisamos fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010223
					]
				},
				{
					"id": 715010223,
					"content": "Você já ouviu falar na Ponta de Pursina? Um dispositivo capaz de liberar o poder que perturba a Linha de Ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010224
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010224,
					"content": "De acordo com minha teoria, contanto que a Ponta de Pursina seja colocada onde a Lama Preta está sendo jorrada, perturbando a Linha Ley, a Lama Preta pode ser limpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010225
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010225,
					"content": "Mas o que a Lama Preta tem a ver com a Linha Ley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715010226,
					"content": "Como essa Lama Preta apareceu aqui devido às mudanças da Linha Ley, há uma grande probabilidade de que estejam relacionadas... Este é o resultado da minha discussão com Khedive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010227
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010227,
					"content": "Então utilize a Ponta para perturbar, ou mesmo fechar a saída da Linha Ley para o lado de fora, assim poderá parar o jorro de Lama Preta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010228
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010228,
					"content": "Entendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715010229
					]
				},
				{
					"id": 715010229,
					"content": "Porém, antes a Ponta foi utilizada apenas para perturbar a Linha Ley, essa é a primeira tentativa de fechar por completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715010230
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715010230,
					"content": "Após algumas verificações, ajustei alguns parâmetros na Ponta, e teoricamente não terá erro.",
					"roleType": "TALK_ROLE_NPC",
