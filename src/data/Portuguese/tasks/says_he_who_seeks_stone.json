			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "Essas daqui realmente são Pedras Antigas. Estou muito grato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740402,
					"content": "Eu estava certo em vim falar com vocês. Acho que teria tomado muito tempo se tivesse sido o pessoal da Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740403,
					"content": "Hmm... Talvez, talvez a Guilda de Aventureiros pudesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740404,
					"content": "Deixar a Comissão conosco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "É verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740406,
					"content": "Aventureiros... Hmm... Antes eu tinha inveja deles, se aventurando em altas montanhas e Domínios profundos. Parece que não existe um lugar que eles não se atrevam a ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740407,
					"content": "Eu sou o oposto. Eu estive trabalhando aqui por vários anos, mas nunca fui no Precipício de Cinábrio no topo do Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740408,
					"content": "Você nunca foi lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740409,
					"content": "O Precipício de Cinábrio é um daqueles lugares turísticos famosos que os habitantes locais dificilmente costumam ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740410,
					"content": "Talvez seja porque está tão perto que posso visitar quando tenho tempo, mas eu nunca tenho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740411,
					"content": "Então por que não vamos agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740412,
					"content": "É importante agir espontaneamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740413,
					"content": "Eu acho que vou deixar passar dessa vez. Ainda tenho coisas para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740414,
					"content": "Além disso, esse tipo de correria para lá e para cá é melhor deixar com os aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740415,
					"content": "Eles sempre aventuram em lugares perigosos. Eu provavelmente ficaria ferido se fizesse o mesmo, e quero evitar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740416,
					"content": "Faz sentido. Se ferir é uma coisa muito séria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740417,
					"content": "Se eu estiver ferido, ninguém supervisionará a Equipe de Exploração lá embaixo e garantir a segurança dos mineradores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740418,
					"content": "Se algo acontecer, se tornará um problema muito sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740419,
					"content": "Então é isso que você está preocupado... Paimon pensou que você só estava com medo de se ferir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740420,
					"content": "Os precipícios formidáveis perto do Despenhadeiro, as cavernas sem fundo... E o antigo campo de batalha deixado por Rex Lapis... É um lugar repleto de perigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740421,
					"content": "Eu não tenho nenhum interesse de ir nesses locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740422,
					"content": "Aqui está a recompensa de vocês pelas três Pedras Antigas. O Salão Huishan quer muitas deles, por isso, traga mais para mim, caso as encontre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740423,
					"content": "Claro, haverão recompensas. Só se lembre de vir falar comigo quando você encontrar mais Pedras Antigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740424,
					"content": "Certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7107405,
