			"dialogs": [
				{
					"id": 710740101,
					"content": "Pedra Antiga... *Suspiro* Em todos os anos que eu trabalhei no Despenhadeiro, vi apenas uma. O que raios o pessoal no Salão Huishan está pensando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740102,
					"content": "Que eles venham aqui fazer o trabalho para ver que isso é impossível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740103,
					"content": "Muning!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740104,
					"content": "Oh, são vocês. Por que ainda estão aqui rondando pelo Despenhadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740105,
					"content": "Bem, não me entendam mal. Não quero dizer que não quero ver vocês por aqui. É só que... Vocês não têm nada mais importante para fazerem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740106,
					"content": "Hunf, nós só queríamos ver como você estava, já que você tem seus problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740107,
					"content": "O que foi que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "*Suspiro* Você já ouviu falar de Pedras Antigas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740110,
					"content": "É um minério raro. Tão raro que talvez você nem o encontre nas minas. Eu só vi duas ou três de tais pedras em todos esses anos no Despenhadeiro. É uma gema inimaginavelmente linda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740111,
					"content": "Dizem que se olhar para dentro de uma Pedra Antiga, você verá raios brilhantes finos como cabelo, e que a cor da pedra lembra do horizonte do mar durante o pôr do sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740112,
					"content": "Você está falando de uma pedra como essa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "Ah, é uma surpresa que você tenha uma! E é uma das de melhor qualidade que já vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740114,
					"content": "#{NICKNAME}, que tal você vender essa Pedra Antiga para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740115,
					"content": "De jeito nenhum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "Sim! Ela é um presente de um amigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740118,
					"content": "Além disso, Paimon duvida que você tenha Mora suficiente para pagar por ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740119,
					"content": "Bem, eu tenho um comprador interessado, por isso dinheiro não é o problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740120,
					"content": "Um comprador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740121,
					"content": "Sim. De alguma forma, os chefes no Salão Huishan se interessaram na pedra e queriam analisá-la, por isso me mandaram até o Despenhadeiro para procurar algumas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740122,
					"content": "Mas estou ocupado lidando com meu trabalho *COF*... Quero dizer, cumprindo meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740123,
					"content": "#Que tal fazermos o seguinte, {NICKNAME}: se você encontrar Pedras Antigas, traga elas para mim que eu lhe darei as recompensas do Salão Huishan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740124,
					"content": "Não é necessário que tenham a qualidade da sua, desde que sejam Pedras Antigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740125,
					"content": "Recompensas do Salão Huishan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740126,
					"content": "Normalmente eu faria o trabalho eu mesmo, mas estive muito ocupado aqui no Despenhadeiro ultimamente, por isso, peço sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740127,
					"content": "*Suspiro* Não sei quantas Pedras Antigas eles querem. Que tal vocês me trazerem três?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740128,
					"content": "Está bem, está bem, entendemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740116,
					"content": "Nem sonhando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "Tem algo lhe preocupando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
