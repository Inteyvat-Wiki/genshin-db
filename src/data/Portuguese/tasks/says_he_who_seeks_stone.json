			"dialogs": [
				{
					"id": 710740501,
					"content": "Vocês encontraram alguma Pedra Antiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740502
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740502,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107406,
			"completionStepIds": [
				7107405
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "Encontramos três a mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740602,
					"content": "#Eu aceitarei de bom grado a Pedra Antiga que vocês {F#duas}{M#dois} me trouxeram, cidad{F#ãs}{M#ãos} de espírito público.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740603,
					"content": "Eu não imaginei que vocês achariam duas delas tão rapidamente. E elas estão com qualidade muito melhor das que eu vi antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740604,
					"content": "*Suspiro*... Elas me lembram da que eu tinha antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740605,
					"content": "Sua Pedra Antiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740606,
					"content": "Então por que você nos pediu para procurar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "Eu disse que eu tinha ANTES.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740609,
					"content": "Meu pai lidava com os lotes de minérios no Salão Shenglu. Essa pedra era só uma sobra e sua qualidade era baixa, por isso ele me deu como um brinquedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740610,
					"content": "Na época nós discutíamos todo o dia. Eu nunca trabalhava, e para piorar, eu passava a maior parte do meu tempo na Casa de Chá Yanshang. Por isso acabei com grandes dívidas, e desesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740611,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740612,
					"content": "Parece que tem algo de errado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "Bem, quem não foi que fez algo estúpido quando era jovem? De qualquer forma, quando eu estava perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740614,
					"content": "Alguém reconheceu minha Pedra Antiga e me ofereceu uma boa quantia por ela. Para mim, não era nada demais. Era uma pedra em troca de Mora. Era uma troca justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740615,
					"content": "Entretanto, meu pai conversou sobre isso um dia e perguntou: \"Muning, onde você colocou aquela pedra que eu te dei?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740616,
					"content": "Tudo que eu podia dizer a ele era: \"Era só uma pedra. Eu a perdi há muito tempo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740617,
					"content": "Apesar de ter dito isso, eu continuei pensando se não tivesse vendido ela. Eu poderia ter mostrado para ele quando a mencionou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740618,
					"content": "... Bem, deixem para lá. Não tem porquê pensar nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740619,
					"content": "Pelo menos o filho pródigo retornou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740620,
					"content": "#Você está cert{F#a}{M#o}... É só que eu ainda tenho um longo caminho até pagar minha dívida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740621,
					"content": "Mas, acabei saindo do tópico. Se você encontrar mais Pedras Antigas, lembre-se de trazê-las para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740622,
					"content": "Essas daqui não são suficientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "Deixe-me pensar. Mais três. Três devem ser suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740625,
					"content": "Pedras Arcaicas são minérios raros. Se o Salão Huishan quiser mais, duvido que conseguirão encontrar aqui no Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740623,
					"content": "Quantas você precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "Vamos, diga logo o que você tem na manga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
