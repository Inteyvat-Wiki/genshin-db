			"dialogs": [
				{
					"id": 708020501,
					"content": "#{F#Irmãzona}{M#Irmãozão}, o que Cyrus lhe disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020502
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020502,
					"content": "É que... O tio Cyrus ainda não encontrou o meu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020503,
					"content": "Confie em Cyrus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				},
				{
					"id": 708020505,
					"content": "#Sim, eu entendo. Vou esperar o tio Cyrus vir, e vou perguntar a ele novamente. Obrigado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020506
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020506,
					"content": "Papai... Onde você está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020504,
					"content": "Eu já encontrei pistas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				}
			]
