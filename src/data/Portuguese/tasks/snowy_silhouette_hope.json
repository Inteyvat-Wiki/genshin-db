			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "Nessa área daqui.. Você tem certeza, Pallad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Estou muito certo, Sr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020203,
					"content": "Vocês estão falando sobre o pai de Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#Ah, é {F#a}{M#o} Viajante! Parece que Joel lhe pediu para vir aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Esse garoto pede todo dia que alguém venha nos perguntar por notícias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Entretanto, desta vez... Nós temos ótimas notícias, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Anteriormente, nós estávamos organizando um treinamento especial na Espinha do Dragão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Talvez seja melhor se eu explicasse o restante, Sr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020209,
					"content": "Enquanto estávamos realizando esse treinamento, eu acabei me desviando do caminho planejado devido a uma nevasca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020210,
					"content": "Enquanto eu estava tentando regressar a esse caminho, vi uma silhueta borrada em um precipício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020211,
					"content": "Eu pensei que, como eu, fosse um aventureiro perdido, por isso gritei para chamar sua atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020212,
					"content": "Infelizmente, antes que pudesse chamar sua atenção, meus gritos atraíram alguns monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020213,
					"content": "Não sei quanto a você, mas eu não estava confiante que conseguiria derrotá-los em um ambiente como esse daqui, por isso saí correndo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020214,
					"content": "Depois que retornei, falei isso tudo para o Sr. Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020215,
					"content": "Então a pessoa que você viu era o pai de Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Ainda não temos certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "De qualquer forma, pelo menos agora nós sabemos que há alguém preso aqui na Montanha Nevada. É nosso dever resgatá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Se essa pessoa é Joserf, pai de Joel, ou não, só nos resta contar com a sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Enfim, eu já enviei todos os capazes de explorar a Montanha Nevada para realizarem uma busca e resgate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Eu também me prepararei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020222,
					"content": "Eu vou com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Você quer ajudar? Ótimo! Vamos partir juntos então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 708020223,
					"content": "Eu irei derrotar os monstros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Ele também pode ser outro aventureiro perdido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
