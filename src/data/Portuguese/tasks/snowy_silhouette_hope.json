					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Deixe-me só organizar um pouco as pistas que a gente encontrou, e já vou me encontrar com o Joel na Montanha Nevada e contar tudo o que eu sei para ele.",
					"roleType": "TALK_ROLE_NPC",
