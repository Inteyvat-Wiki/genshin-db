			"dialogs": [
				{
					"id": 708020101,
					"content": "Será que realmente encontrarei meu pai desta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020102,
					"content": "Você tem notícias sobre seu pai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "Oh, é você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020104,
					"content": "Pallad me disse que o Tio Cyrus parece ter encontrado informações sobre meu pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020105,
					"content": "Mesmo não tendo a certeza absoluta, o Pallad disse que as pistas que eles tinham encontrados eram muito úteis, e talvez a gente consiga encontrar o pai desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020106,
					"content": "Eu gostaria de ir à Montanha Nevada com eles, mas o Cyrus me pediu para ficar no acampamento, dizendo que assim que eles conseguissem pistas, iriam me informar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020107,
					"content": "Você poderia me ajudar a procurar por ele e perguntar para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020108,
					"content": "Posso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "Eu... Eu tenho medo que as informações não sejam boas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020111,
					"content": "De qualquer forma, eu estou contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020109,
					"content": "Por você mesmo não vai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
