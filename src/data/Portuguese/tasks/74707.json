			"dialogs": [
				{
					"id": 747070101,
					"content": "...Tudo bem, ficou ótimo! Vamos fazer só mais uma tomada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Bom. Eeee... corta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Ah, Columbina e Chiori também! Vocês ainda estão aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Ahã! Acabamos de filmar nossas cenas extras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Oh! Você tá falando daquele negócio de fazer os peixinhos atuarem? Como foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Graças à ajuda de vocês, encontramos um ator adequado para o papel e as gravações correram perfeitamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "Vocês têm um talento real para esse negócio de aquário. Diretora Furina estava nos contando como vocês a inspiraram a querer filmar um documentário subaquático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Você é gentil demais!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Eu também gosto. Consigo sentir como os peixinhos estão contentes, nadando por aí. Vocês fizeram um ótimo trabalho cuidando deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 747070111,
					"content": "Eu só queria que esse aquário pudesse ficar aqui para sempre. Assim, eu poderia visitar quando eu quisesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Se você vai sentir tanta falta, por que não adiciona mais alguns panoramas ao filme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Você tem razão. Devíamos gravar mais algumas tomadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Mais uns peixes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 747070115,
					"content": "Mais algumas tomadas! Vamos lá, luzes, câmera... Cadê meu supervisor de roteiro? Pessoal, assumam suas posições!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Paimon tá pronta! Mas anunciar tomadas para atores peixes é... uma nova experiência, com certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Ficamos muito felizes que vocês tenham gostado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}