					}
				]
			},
			"dialogs": [
				{
					"id": 706800101,
					"content": "Olá, venham aqui, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800102
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800102,
					"content": "Tenho boas notícias. Tomou muito mais tempo do que deveria, mas, finalmente, o novo palco está pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800103
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800103,
					"content": "Faça um show espetacular, e você vai ganhar uma chave que abre portas para o Mundo Dentro da Pintura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800104
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800104,
					"content": "Ei, pera aí! Primeiro são livros de história, e agora um mundo dentro de uma pintura? Tá fazendo cada vez menos sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800105,
					"content": "Eu sei! Mas como quando li pela primeira vez, se um mágico revelar todos os seus truques para a audiência, ela não fica surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800106
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800106,
					"content": "É esperado que nada faça sentido. A magia da Bruxa é como amor, não é algo que faça sentido, mas algo que você sente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800107
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800107,
					"content": "Justo, a explicação funciona... mas esse novo mundo dentro da pintura, é diferente de algum outro palco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800108,
					"content": "O Mundo Dentro da Pintura é um mundo de muitas regras... esse novo palco testará amizade e confiança! É um clássico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800109
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800109,
					"content": "E todos aqueles que passarem ganharão uma bênção da Bruxa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800110
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800110,
					"content": "Oh, é um feitiço da sorte e tal? Tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800111,
						706800112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800111,
					"content": "Cuidado com o que você deseja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				},
				{
					"id": 706800113,
					"content": "Ah, sim, bom ponto. Temos que tomar cuidado com o que desejamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706800114,
					"content": "Eu garanto, não precisa ficar nervosa com nada. A pintura já tá na tela, e a bênção da bruxa não é mais um segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800115
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800115,
					"content": "#Se estiverem pront{F#as}{M#os}, podem entrar no palco do Mundo Dentro da Pintura e verem pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800116
					],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800116,
					"content": "E a medida que vocês embarcam numa nova aventura, faça como fazem nas histórias. Assobie sua música favorita, coloque suas preocupações de lado e continue com a coragem em seu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lobinho"
				},
				{
					"id": 706800112,
					"content": "Duvido, e além disso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				}
			]
		}
	]
}