			"dialogs": [
				{
					"id": 205200501,
					"content": "Você encontrou a Carne Fria Fresca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200502,
					"content": "Achei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Ótimo, então essa é a Carne Fria Fresca? Com exceção dela ser fria ao se tocar, não vejo diferença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200504,
					"content": "Mas isso não importa, só quero concluir essa missão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200505,
					"content": "Obrigado, Viajante. Se não fosse por você, eu estaria perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200506,
					"content": "Por favor, aceite isto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
