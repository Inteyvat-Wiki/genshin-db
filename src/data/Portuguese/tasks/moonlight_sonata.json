			"dialogs": [
				{
					"id": 760290401,
					"content": "(Hã? Música de uma lira? Parece que Columbina tá tocando para os kuuhenki.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "(Na última vez que aparecemos, a lira ainda não havia sido consertada. Isso foi bem antes de Columbina conhecer todos...)",
