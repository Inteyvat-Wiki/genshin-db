			"dialogs": [
				{
					"id": 760290101,
					"content": "Saudações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290102,
					"content": "Hã? Está indo embora, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Sim. Vou consertar minha lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290104,
					"content": "...Como é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "Uma das liras dos kuuhenki está quebrada. Ele gosta muito dela, por isso desejo consertá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290106,
					"content": "Uau, os kuuhenki são bem talentosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Sim. Costumam se apresentar aqui, e às vezes eu canto junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290108,
					"content": "Sabe, Paimon tava pensando nisso por um tempo. Você mima os kuuhenki bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Eles sempre me fizeram companhia, e sempre trazem coisas interessantes para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290110,
					"content": "(Lauma falou nisso, sobre o instinto natural dos kuuhenki de tentar fazerem uma Deusa da Lua feliz.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Mas, se não for um problema perguntar, como você planejar consertar essa lira? Você não disse que não queria ser vista por outros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hmm... eu costumava pedir para animaizinhos ou aos kuuhenki para colocarem os objetos que precisavam de reparos na porta de uma artesã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290113,
					"content": "Tudo que eu tinha que fazer era esperar a artesã encontrá-la. Claro que, às vezes, isso demorava alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290114,
					"content": "Parece um método meio ineficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Por que você não deixa isso com a gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290117,
					"content": "Não se preocupe. Quem sabe? Talvez possamos resolver isso hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "...Certo. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290119,
					"content": "O prazer é nosso! Falando nisso, para qual artesão você geralmente leva suas coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "Eu não sei seu nome. Há uma mão mecânica gigante na sua porta, e ela vive em uma casa redonda como uma concha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290121,
					"content": "(Espera, será que ela tá falando de...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "O cheiro dos rolinhos de ovo também exala lá de dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760290123,
					"content": "Paimon acha que sabe de quem você tá falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
