					"nextDialogs": [
						718140305
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140305,
					"content": "Ela está atualmente atendendo a alguns negócios no Pavilhão Yuehai. Talvez ela saiba o que é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kun"
