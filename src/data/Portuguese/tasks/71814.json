			"dialogs": [
				{
					"id": 718140401,
					"content": "Olá, como posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140402,
					"content": "Eu peguei isto do mar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Hmm? Permita-me dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Sim, de fato, isto vem da Câmara de Jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140405,
					"content": "Algo específico que você possa me dizer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "Bem, o conteúdo consiste em vários documentos e um anúncio que ainda não passou por uma revisão. Ainda estão tão bem preservados... Que inesperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140407,
					"content": "Mesmo assim, sua descoberta deve nos poupar algum trabalho. A limpeza depois desta bagunça realmente provou ser uma fonte interminável de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140408,
					"content": "Ainda assim, obrigada por trazê-los até nós. Tome isto como um sinal de nosso apreço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
