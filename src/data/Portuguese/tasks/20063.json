					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200631309,
					"content": "Hahaha... Bem, eu nunca. De certa forma, é uma coisa boa - se esses monstros aterrorizantes fossem fáceis de encontrar, eu nunca ousaria pisar fora da cidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631310
					],
					"speakerTitle": "Jack"
				},
