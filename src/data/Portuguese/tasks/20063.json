				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "*Suspiro* Queria tanto ver com meus próprios olhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "Está olhando o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Ugh, quando foi que você veio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "É assim, o senhor Stanley ficou bêbado e me contou a aventura que teve no <color=#00E1FFFF>Vale de Dadaupa</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "Ele disse: \"O monstro ardia ferozmente enquanto seu corpo amorfo se contorcia lentamente em minha direção... lutei e gritei, mas não parecia adiantar. O monstro apenas olhou para mim com desdém com aqueles olhos... Aqueles olhos terríveis...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Obviamente, eu não estava lá para vê-lo, mas... se até Stanley sentiu que havia encontrado sua batalha naquela época, deve ter sido uma aventura épica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "*Suspiro* Estou com muita vontade de tentar encontrar o monstro que até Stanley teve dificuldades para derrotar... Só para vê-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "Mas considerando a minha força, eu ia acabar levando uma surra e fugindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "#Ah, se você estiver interessad{F#a}{M#o}, poderia me ajudar a procurar este monstro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Excelente! Sabia que podia contar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Eu posso ir com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "Se for possível, eu também quero ir com você... mas ainda tenho milhares de coisas para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "Quando digo \"outras coisas\"... Infelizmente, apenas fazer aventuras na Guilda dos Aventureiros de Mondstadt não gera uma renda suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "Por isso, também ajudo os residentes a fazer todo tipo de coisa, como encontrar gatos, remover ervas daninhas etc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "Portanto, a aventura épica de proporções assustadoras de Stanley é toda sua. Conte-me tudo sobre o monstro quando voltar, quero ouvir tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
