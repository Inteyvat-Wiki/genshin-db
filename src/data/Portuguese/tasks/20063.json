					"nextDialogs": [
						200631002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631002,
					"content": "Essa é a descrição de Stanley, mas ele bebeu muito vinho e disse muitas coisas sem nexo. Quando ele recuperou a sobriedade, ele não se lembrava de nada.",
					"roleType": "TALK_ROLE_NPC",
