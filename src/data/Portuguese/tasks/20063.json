					"nextDialogs": [
						200631203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631203,
					"content": "Encontrar, encontrei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "Um Slime Pyro... É isso? Impossível. Não foi assim que Stanley descreveu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631205,
					"content": "Por acaso, o senhor Stanley também está aqui. Por favor, conte aquela história de aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631206,
					"content": "É aquele monstro que está queimando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631207,
					"content": "Ah, esse ... sim, sim ... eu estava realmente bêbado naquele dia e... você sabe, eu simplesmente não me lembro tão claramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631208
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631208,
					"content": "Não tem problema, meu amigo! Lembro-me de tudo o que você me disse, veja, eu tenho aqui escrito, palavra por palavra.",
