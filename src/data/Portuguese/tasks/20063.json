				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "Queria tanto sair me aventurando por aí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Ontem o senhor Stanley me contou outra história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Mas ele ficou meio bêbado, então a história é um pouco incoerente, mas pelo que percebi, aconteceu ao redor da <color=#00E1FFFF>Adega do Alvorecer</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "E ele disse algo assim: \"A desgraça se cristalizou no monstro, e o ódio fortaleceu o corpo, logo depois, o medo congelou as minhas pernas... eu agitava freneticamente a arma, mas os fragmentos do gelo atraíram o meu olhar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "Que tipo de monstro pode levar até Stanley para sentir como se ele finalmente encontrasse um rival verdadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Oh, eu realmente gostaria de vir para ver por mim mesmo... Mas se eu for, devo apenas fugir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "... Você ficaria bem, no entanto. Conhecendo você. Você estaria disposto a procurar por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Excelente! Quando você encontrar, volte e me fale tudo em detalhes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Vamos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "Eu adoraria ir, mas com tudo o que está acontecendo com a Guilda de Aventureiros... Você sabe como é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Parece que Cyrus está prestes a se aposentar, diz ele que quer ficar no Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Herman não deixou a cidade desde que sua filha nasceu. É uma pena. Ele era nosso aventureiro, sem dúvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "E o Stanley, já tem descansado por muito tempo, e também faz algum tempo que não vai à aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "A Guilda já começou a fazer bicos para pagar as despesas de funcionamento... Mas, mesmo assim, está a ser difícil arranjar funcionários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630317,
					"content": "Não podemos esperar que Bennett faça isso, ele também trabalha muito duro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
