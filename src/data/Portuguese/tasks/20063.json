					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631408,
					"content": "Eu garanto que você não conhece esta história! Isso foi há muito, muito tempo...",
