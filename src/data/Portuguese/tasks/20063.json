			"dialogs": [
				{
					"id": 200631201,
					"content": "Jack, me escute primeiro, não é o que você está pensando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631202
					],
					"speakerTitle": "Stanley"
				},
