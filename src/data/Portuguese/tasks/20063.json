				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "Quando eu posso me tornar num aventureiro grande?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Oh! É você! Ontem o senhor Cyrus me contou uma história de aventura, que aconteceu nas <color=#00E1FFFF>Montanhas do Precursor do Vento</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "Isso foi o que ele contou: \"Esse escudo enorme era como um pesadelo irresistível, mesmo que eu golpeie com muita força, ele simplesmente não se mexia... Enquanto isso, o monstro zombava de mim por trás do escudo, olhando com desprezo com aqueles olhos... aqueles olhos aterrorizantes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "Um Escudo de Madeira que resiste a qualquer ataque... Eu daria tudo para ver com os meus próprios olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Mas tenho um bilhão de outras coisas para fazer e simplesmente não consigo escapar... Não consigo imaginar que tipo de monstro aterrorizante teria um escudo como o que Stanley descreveu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Ei, então, se vocês aceitarem, podem me ajudar a encontrar o monstro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Fantástico! Muito obrigado. Quero ouvir tudo sobre isso quando voltar - todos os detalhes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Eu vou com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Você quer que eu venha? Desculpe, eu não posso. A Guilda de Aventureiros estão me esperando com muitas tarefas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "As aventuras não são tão lucrativas hoje em dia. Embora eu tenha conseguido esses trabalhos através da Associação de Aventureiros, na verdade, a maioria deles é apenas ajudar outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Preciso reunir alguns javalis para Draff, encontrar a gata de Margaret, pegar algumas flores frescas para Flora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "... Não é exatamente o tipo de aventura que eu estava imaginando quando me inscrevi na Guilda. Haha",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
