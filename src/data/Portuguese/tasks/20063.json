					"nextDialogs": [
						200631306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631306,
					"content": "Ainda bem que Cyrus está aqui, para que ele possa esclarecer tudo. Cyrus, o que você acha disso?",
