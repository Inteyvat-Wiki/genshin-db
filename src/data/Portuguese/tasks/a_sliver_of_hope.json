			},
			"dialogs": [
				{
					"id": 120120801,
					"content": "O Espetáculo de Fogos de Artifício de Naganohara deve estar chegando em breve, certo? Minha filha partiu há bastante tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120802,
					"content": "Heh, ela não conseguiu sair de casa rápido o suficiente. Ela está claramente muito ocupada com este rapaz na cidade, estava bem obvio pela cara dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120803,
					"content": "*Suspiro* Mas pelo menos ela está feliz, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Satoru"
				}
			]
		},
		{
