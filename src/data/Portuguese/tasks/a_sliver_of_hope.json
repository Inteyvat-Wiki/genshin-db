	"talks": [
		{
			"id": 1201201,
			"completionStepIds": [
				1201201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201201",
							"2"
						],
						"stepId": 1201201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Bem! Se não é a Yoimiya! Entre, querida, venha e sente-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "#Ess{F#as}{M#es} são {F#suas}{M#seus} amig{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "#Sim, é {F#uma}{M#um} Viajante que veio de longe. Não é fácil que forasteiros venham para Inazuma agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "#Hmm, a situação agora é problemática. Mas já que você veio, e que nós {M#os}{F#as} recebemos, seremos bons anfitriões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Uhum. Oh, antes que eu esqueça - trouxe os fogos de artifício que você pediu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Oh, obrigado. Todos os anos importuno vocês com isso. Antes importunava seu pai, e agora você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Será que eu ainda estarei vivo para ver o próximo herdeiro da Loja dos Fogos de Artifício Naganohara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Claro que sim, vocês dois estão cheios de saúde! Não diga coisas como essas, dá azar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "*Suspiro* Não somos mais tão jovens quanto éramos antes. O corpo sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Antes eu podia passar o dia todo trabalhando na terra, levando água pra lá e pra cá, mas agora, mesmo um minuto de trabalho leve me deixa com todo tipo de desconforto e dor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Ontem eu queria tirar algumas ervas daninhas, mas assim que me curvei para começar, de repente senti que se eu fosse mais longe, não seria capaz de voltar a me levantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "Não tem problema, deixe conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "Não, não, não, não podemos colocá-la para trabalhar quando você é uma convidada em nossa casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Pegarei alguns aperitivos e chá, podemos comer e conversar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "Está tudo bem, não é como se fosse a primeira vez que os ajudo nas tarefas. Não tenho tido muito tempo recentemente com o Espetáculo de Fogos de Artifício chegando - mas uma vez que isso esteja fora do caminho, com certeza passarei por aqui mais vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "Não é nada demais para nós, não precisa se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "*Suspiro* Vocês são uns anjos... Não como o meu. Ele já cresceu, ainda não encontrou ninguém, mas ainda assim nunca visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Se você tem certeza de que não é um problema, então... Tenho um pouco de rabanete em conserva aqui, você se importaria de entregá-lo a Satoru, do outro lado da aldeia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Claro, não vai levar nem um instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Os idosos não são muito móveis, então vamos lá, vamos ajudá-los. Primeiro nos <color=#00E1FFFF>livramos das ervas daninhas</color> e depois <color=#00E1FFFF>entregamos o rabanete em conserva</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Oi, tio Satoru. Como você tem estado ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Continuo parecendo um velho, não mudei nada. Você também parece estar bem animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "Graças ao apoio de todos, meus negócios estão indo cada vez melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "Vendemos alguns fogos de artifício para Liyue há algum tempo atrás, e a notícia é que eles foram muito bem vendidos. Por isso, parece que vamos conseguir mais negócios a partir daí no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Mas isso deve significar que vai ter muito mais trabalho para você? Tem certeza de que você e o Sr. Ryuunosuke vão conseguir fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Se for demais, não se esqueça que você pode sempre me pedir ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Não tem problema, posso resolver os problemas dos fogos de artifício sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Ah, sim, estes são Rabanetes em Conserva da Sra. Imatani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Uau, muito obrigado! Eu nunca fui fã de Rabanete em Conserva, vocês acreditam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Mas depois eu experimentei algumas das coisas caseiras da Sra. Imatani, e não consegui me fartar. Agora é um produto básico da família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Todos estão bem em casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Eles estão indo bem. Temos a discussão acalorada ocasional, mas... Isso é o que toda família faz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Poder ter sua família por perto é melhor do que nunca vê-los, mesmo que isso signifique aturar algum conflito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "O Sr. e a Sra. Imatani parecem ter um ótimo relacionamento - mas mesmo assim, eles devem se sentir solitários com seus filhos nunca os visitando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Hã, eles não me pareciam ser assim. Acho que eles estão acostumados a isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "No entanto, você faz uma boa observação. Eu deveria aparecer com mais frequência no futuro. Dessa forma, eles não ficarão tão entediados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Tenho certeza de que eles adorariam isso - como todos nós na Vila Konda. Você é sempre bem-vinda aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Hee hee, obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "#Isso foi rápido! Ah, {M#os}{F#as} jovens são tão habilidos{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Os mais jovens têm muita energia e os mais velhos têm uma riqueza de sabedoria. Cada um tem seus pontos fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Por falar em juventude... Quer saber? Já se passaram 50 anos este ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Oh, é mesmo! Minha nossa, como o tempo voa... Mal se percebe com o passar dos anos, mas de repente, já se passaram 50 anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "50 anos desde o quê? Um dia importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Haha, bem, se você quer saber, foi há 50 anos, quando esta jovem ainda estava tentando me conquistar, que-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "#Oh, pare de tentar impressioná-l{M#os}{F#as}. Ambos sabemos que você foi o único que estava desesperadamente apaixonado e tentando desesperadamente ganhar meu afeto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Bem, então vamos pular adiante. Há 50 anos, eu pedi minha esposa em casamento no Espetáculo de Fogos de Artifício de Naganohara. Estamos juntos desde então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Parabéns a ambos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "Para dizer a verdade, eu ainda estava um pouco incerto. Eu não tinha certeza do que estava fazendo quando entrei na loja de Naganohara e encomendei meu fogo de artifício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Mesmo quando estava subindo ao céu... Eu ainda não tinha ideia do que ia dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Mas depois que explodiu... O céu se iluminou... Olhei para ela e vi seus olhos, brilhando à luz dos fogos de artifício...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "...Antes de saber o que estava acontecendo, aparentemente, eu já havia dito e ela havia dito que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "50 anos... Em alguns aspectos, é muito tempo, em outros, não é tempo nenhum. Na verdade, é apenas um número.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Mas 50 anos de convivência... Agora, isso sim é algo que vale a pena comemorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "Eu não tinha ideia de que era seu 50º aniversário. Se eu soubesse, teria feito fogos de artifício extras, só para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Oh, não, está tudo bem. Todos os anos, lançamos sempre o mesmo fogo de artifício. Não seria a mesma coisa sem ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Ver o fogo de artifício explodir nos leva de volta àqueles dias. Mesmo com esta idade, ainda olhamos para trás sem um único arrependimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Aw, que belo relacionamento eles têm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Mas já chega de falar de nós. Yoimiya, você não está ocupada com o show de fogos de artifício que está por vir? Havia algo que você precisava discutir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Sim, hm... É uma coisa difícil de falar, mas lá vai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Sakujirou... Então, ele voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Hã? Você conhece ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Ele era o melhor amigo de nosso menino quando eles eram jovens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*Suspiro* Eles eram inseparáveis. Eles cresceram juntos, compartilhavam tudo um com o outro e iam juntos para todos os lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Mas um dia, eles tiveram uma discussão terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Sakujirou parecia sentir que Inazuma era muito pacífica, e queria ver como era o mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Mas nosso Keisuke puxou a seu pai e sua mãe. Ele sentiu que não havia nada de errado com a paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Você sabe como são as crianças, elas ficam terrivelmente irritadas com este tipo de coisas. No final, Sakujirou saiu bravo, e é isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Hã, que chato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Keisuke não disse nada a mim ou a minha esposa sobre a luta. Sentimos que ele ficou muito magoado com isso, mas ele não quis falar conosco sobre como estava realmente se sentindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Eventualmente, seja por raiva reprimida ou por algum outro motivo, ele entrou para a Comissão Tenryou. Ele raramente volta mais para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Se fosse qualquer outra coisa, eu poderia falar com o Keisuke, e tenho certeza de que ele estaria disposto a ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Mas como é o Sakujirou... Sinto que não há nenhuma maneira de nos envolvermos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Que estranha coincidência. Quem teria imaginado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Agora eu entendo. Quando perguntei ao Sakujirou por que ele voltou, ele apenas disse \"por causa dos erros do passado\" e não estava disposto a elaborar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Agora, finalmente entendo porque ele não consegue decidir o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Dois melhores amigos de infância... Um cresce para se juntar à Comissão Tenryou, o outro cresce para se juntar à lista dos mais procurados da Comissão Tenryou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "Acho que isso é o destino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Bem, não se preocupe, se for esse o caso, então não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "Podemos encontrar outra forma de ajudar o Sakujirou, não há necessidade de tornar as coisas difíceis para vocês. Isto parece algo para o Sakujirou e o Keisuke resolverem entre si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Sim, seria tão bom se eles pudessem voltar a ser como eram antigamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Acho que depois de todos esses anos, eles deveriam deixar de guardar rancor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "Eu jamais teria imaginado isso também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Você deve estar muito orgulhoso do que você tem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
