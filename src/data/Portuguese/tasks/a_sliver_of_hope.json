					"nextDialogs": [
						120120902
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120902,
					"content": "Um dia, porém, essa criança vai ter que enfrentar seus sentimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120903,
					"content": "Esta é uma lição de vida que não se pode aprender com seus pais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Kaori"
