			"dialogs": [
				{
					"id": 4890201,
					"content": "Você está de volta - você trouxe os ingredientes? Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890202,
					"content": "Pois é... Isso mesmo, está tudo preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890203,
					"content": "E agora... Pedido No°7: um <color=#00E1FFFF>Frango em Molho de Mel</color>, obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890204,
					"content": "Ela já nos considerou como cozinheiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890205,
					"content": "Você disse que ajudaria o Caçador de Cervos - não deixe de servi-lo enquanto estiver quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
