			"dialogs": [
				{
					"id": 4890301,
					"content": "Um Frango Assado com Mel, recebido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "Isso está cheirando... muito bem! Você tem dom para isso, é exatamente a pessoa que preciso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Já que você cozinha bem, você pode se encarregar desse pedido, o <color=#00E1FFFF>Carne Frita com Cenoura e Mel</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Carne Frita com Cenoura e Mel</color>! Eu comi com a Amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "Isso mesmo, esse é um dos pratos principais do Caçador de Cervos com muito orgulho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "Parece que os Cavaleiros sempre pedem isso quando vem pedir comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Deixe-me lhe ensinar a receita da <color=#00E1FFFF>Carne Frita com Cenoura e Mel</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Espere, pensei que você havia dito que é o seu orgulho e alegria. Vai nos ensinar como fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "Com seus dotes culinários, acho que você não vai queimar a imagem do Caçador de Cervos! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "Assim que a <color=#00E1FFFF>Carne Frita com Cenoura e Mel</color> estiver pronta, traga para cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
