			"dialogs": [
				{
					"id": 741910201,
					"content": "Vossa Majestade, Vossa Majestade, você está bem? Está sonhando de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910202,
					"content": "Urg, está tão barulhento. O que está acontecendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "As pessoas se reuniram em nosso salão. Acredito que eles tenham perguntas para você, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910204,
					"content": "Recentemente, a melodia de Phobos foi interrompida diversas vezes, então eles possuem muitas preocupações quanto a isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910205,
					"content": "Não tenho escolha senão fazer isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Eu naturalmente confio em seu sábio julgamento, e eu ouvi algo que aconteceu recentemente... tem algo errado com Phobos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910207,
					"content": "Phobos tem uma rota planejada para todos, de forma que toda a humanidade possa atingir a felicidade. Não deve haver problemas se a ajuda do poder quase ilimitado de cálculo de Sybilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910208,
					"content": "Mas eu ouvi lamentos dentro da música.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "Alguém alterou secretamente a partitura de Phobos? Não, ninguém pode fazer isso exceto eu e os Harmostas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910210,
					"content": "Será que a profeta esteve escondendo algo de nós? Impossível. Ela já não se sacrificou pela causa? A veracidade de suas profecias foram validadas pela Senhora das Águas, ela não teria desejos egoístas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910211,
					"content": "Talvez seja exatamente por ela não ter intenções egoístas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "Hoje em dia, todas as pessoas dependem de Phobos para fazer julgamentos e decisões para eles. Se algo desse errado com ele, os cidadãos temem que todo o mundo cairia em caos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910213,
					"content": "Preciso ir até onde aqueles que se agarram a uma fé cega estão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "Isso significa que você deseja separar minha melodia da Grande Sinfonia para evitar qualquer imprevisto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910216,
					"content": "Não, não, ainda é cedo demais. Receio que minha alma ainda não seja capaz de suportar um destino tão grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910217,
					"content": "Eu confio em você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "...Compreendo. Eu me decidi. Se esse é o seu desejo, senhor, farei o possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910220,
					"content": "Uranopolis, a cidade do futuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "Depois que ████ partiu, seu corpo passa por corredores dourados, e os sons das pessoas debatendo fica mais próximo.\\nA área fica silenciosa, mas apenas por pouco, quando você alcança o pódio central.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910223,
					"content": "Ó Grande Sebastos, por favor, nos dê suas instruções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910224,
					"content": "Recentemente, devido à incapacidade de ouvir a melodia de \"Phobos\", os cidadãos estão sentindo medo e incerteza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910225,
					"content": "Nosso grande plano estava progredindo normalmente. Os bárbaros se escondendo pelas sombras foram eliminados um por um, e as águas poluídas foram limpas por Ichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910226,
					"content": "Entretanto, meu lorde, você pretende interromper nossa guerra nobre. Por que você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910227,
					"content": "Exerci meu próprio julgamento sobre o assunto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Grande Sebastos, eu não pretendo desafiar sua autoridade, mas acredito que você já mostrou misericórdia suficiente a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910229,
					"content": "Trouxemos harmonia e glória para essa terra. Os portões de Remuria estão abertos para todos que desejam se juntar à nossa ordem dourada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910230,
					"content": "Mas o que eles fizeram? Eles destruíram nossas torres e mataram nossos músicos. Suas almas impuras não são merecedoras de nenhuma salvação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910231,
					"content": "Limpamos suas terras com sangue, e a ordem e civilização nasceram da destruição. Essa já é a maior misericórdia que aqueles selvagens ignorantes merecem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910232,
					"content": "Isso não é o que eu quero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "Mas não deve haver nenhuma sombra sob o sol. Esse também não é o seu grande ideal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910234,
					"content": "Se eu puder, senhor, acredito que esse é o desejo de todos os cidadãos de Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910235,
					"content": "Ó, Sebastos, dê as ordens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910221,
					"content": "Seremos reconhecidos por esse novo nome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "Mas, de agora em diante, você não será mais \"um de nós\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Por esse motivo, lhe dou o livre arbítrio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}