			"dialogs": [
				{
					"id": 411245201,
					"content": "Você ainda não partiu? Ah... Você ainda tem alguma pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245202,
					"content": "De qualquer forma, quem é esse \"cavalheiro\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "Um, você e \"aquele cavalheiro\" se conhecem, de acordo com ele, vocês lutaram lado a lado por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245204,
					"content": "Mas eu não posso dizer o nome dele a você, caso contrário, ele com certeza vai me culpar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245205,
					"content": "Por que não capturamos os Ladrões de Tesouro de uma vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Ainda que lidemos com Ladrões de Tesouro que atraímos com essas cartas, os que sobrarem fugirão depois de ouvirem as notícias, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245207,
					"content": "Huum... Correto, esse é o objetivo desse cavalheiro. Não é capturá-los de uma vez, mas sim intimidá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245208,
					"content": "E na situação de agora, os Cavaleiros de Favonius não tem pessoal o suficiente para persegui-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245209,
					"content": "No final das contas, o mais importante e urgente é lidar com aqueles meteoritos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245210,
					"content": "Quanto aos Ladrões de Tesouro... Desde que não criem confusão nesse momento, está tudo certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
