					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Ah, você finalmente veio, esperei um bom tempo por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240202,
					"content": "Você me esperou para fazer o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "Não precisa ser tão frio, eu tenho coisas muito importantes para pedir a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240204,
					"content": "Você já viu os meteoritos, né? Embora não tenham atingido dentro da cidade de Mondstadt, fora de Mondstadt está tudo cataclísmico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240205,
					"content": "Já que a cidade Mondstadt está totalmente cataclísmica, uns bandidos certamente irão aproveitar essa crise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240206,
					"content": "Você está falando dos... Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "Uau, você é realmente um aventureiro muito experiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240212,
					"content": "Apesar dos Cavaleiros de Favonius já estarem em alerta, Mondstadt ainda possui algumas lacunas na defesa de seus arredores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240213,
					"content": "Os Ladrões de Tesouro podem fazer tudo ao seu alcance por conta do dinheiro. Eles devem já ter um plano de fazer o seu ataque para ganhar um bom dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240214,
					"content": "Então o que eu posso fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "Ah, você respondeu tão diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240216,
					"content": "Parece que o plano de contingência que o \"cavalheiro\" me deu não era necessário, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240222,
					"content": "Bom. Em suma... os Ladrões de Tesouro que vieram para investigar já foram pegos por esse \"cavalheiro\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240223,
					"content": "De acordo com o que eles disseram, há 3 Ladrões de Tesouro que estão se aproveitando da situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240224,
					"content": "Então nós vamos vencer eles no próprio jogo, ajudando os Ladrões de Tesouro planejarem o ataque ao melhor local...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240225,
					"content": "Como você quer fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "O que você vai fazer é muito simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240232,
					"content": "Para garantir que nem todos fossem pegos de uma vez, os Ladrões de Tesouro que vieram para a inspeção não voltam para reportar. Eles deixam as informações recolhidas em um determinado lugar por meio de cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240233,
					"content": "Para evitar qualquer problema, eles até mandaram três pessoas para investigar, e marcaram três lugares diferentes para a troca das informações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240234,
					"content": "Eles nem imaginam que os 3 serão pegos por esse \"cavalheiro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240235,
					"content": "Depois de receberem o relatório, os outros membros dos Ladrões de Tesouro começarão a criar um plano, e escolherão o melhor local para invadir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240236,
					"content": "Mas desta vez vamos lhes poupar o trabalho, o \"cavalheiro\" já os ajudou a formular o plano nos menores detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240237,
					"content": "Pegue essas três cartas, você irá deixá-las nos pontos que os Ladrões de Tesouro usam para se comunicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240238,
					"content": "Depois de as colocar, volte para me dizer, quanto ao resto... Discutiremos quando você voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240226,
					"content": "Podemos confiar nas palavras dos Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "Hahaha, você pensa demais. Relaxe, os Ladrões de Tesouro não são tão fortes assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240228,
					"content": "Aqueles caras são apenas um bando de traidores que buscam dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240229,
					"content": "\"Há Mora nisso para você trabalhar conosco, mas se você quiser fazer umas armadilhas, você acabará por perder tudo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240230,
					"content": "Eles vão cooperar conosco se eles souberem essa importância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240217,
					"content": "Os Cavaleiros de Favonius podem lidar com isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Haha, eu imaginei que você diria isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240219,
					"content": "Relaxe, o \"cavalheiro\" me deu um bom dinheiro, sua recompensa também será igual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240220,
					"content": "Se você encontrar algo valioso, é seu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240221,
					"content": "Além disso, esse assunto depende de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240208,
					"content": "Você está falando dos... Hilichurls?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Hahaha claro que não. Os Hilichurls não são inteligentes o suficiente para fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240210,
					"content": "Se eles se aproximarem da cidade, os Cavaleiros de Favonius imediatamente os repelirão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240211,
					"content": "Eu disse que quem quer se aproveitar deste momento são os Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
