			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "Você colocou as cartas nos seus lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240602,
					"content": "Sim, coloquei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "Então assim está bom, aquele grupo de Ladrões de Tesouro certamente criará um plano de invasão de acordo com as informações daquelas três cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240604,
					"content": "E o momento perfeito para fazer esse plano será entre a noite e as primeiras horas da manhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240605,
					"content": "Quanto ao lugar perfeito para invadir... Claro, só há um. Me dê seu mapa para eu marcar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240606,
					"content": "Assim está bom, agora só precisamos esperar os Ladrões de Tesouro caírem na armadilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240607,
					"content": "Se os Cavaleiros de Favonius descobrirem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Sim... A sua preocupação faz sentido. Se o nosso método ilegal for descoberto pelos Cavaleiros de Favonius, ficaremos em apuros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240609,
					"content": "Mas, o \"cavalheiro\" me garantiu que esse problema é improvável de acontecer, nós podemos... Confiar nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240612,
					"content": "Vamos esperar a noite chegar, então você derrotará todos os Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240610,
					"content": "Se não acontecer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "Pode acontecer, mas relaxe. Esse é um plano que \"aquele cavalheiro\" fez pessoalmente, não tem como acontecer algo de errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112408,
			"completionStepIds": [
				4112408
			],
