					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240801,
					"content": "Você derrotou aqueles Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240802,
					"content": "Derrotei todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "Eu não esperaria menos de alguém que chamou atenção daquele cavalheiro, você é muito eficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240804,
					"content": "Foi um prazer trabalhar com você, aqui está sua recompensa.",
