			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#Ei, é você, {NICKNAME}! E Paimon também! E aí? Tudo bem? Precisam da minha genialidade para alguma super hiper mega comissão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Olha só, vou te dar um descontinho de amiga de vinte por cento pelos meus serviços! É só me trazer uns lanchinhos... Ah, e não conta isso pra Ineffa, tá bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Hehe, então você veio pro lugar mais certíssimo de todos! Minha oficina é cento e dez por cento brilhante-maravilhinda em massa. Duvido que ache outra melhor por aí, pode apostar sua última Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Só cuidado por onde pisa e tal, senão alguma peça ou outra pode te fazer dar de cara no chão, viu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Esse robô parece bem... único.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Hehe! Que achou? Marreco Marreta, é o nome dele. Criei ele pra separar lixo e sucata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Mas, ah, acabei fazendo ele resistente demais, e os braços de alavanca, mega ágeis. Aí pensei: \"Eh, por que não dar defesas ultra-mega-turbinadas também?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "Assim, qualquer malandrinho que tentar dar uma de espertinho na minha oficina vira lixo não reciclável, facinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Suas ideias continuam tão malucas quanto sempre, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Bem, já que a oportunidade apareceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "M-Minha? Com o Marreco Marreta? B—Bom, uh, o pessoal geralmente se interessa pelas minhas invenções. Não tiram muitas fotos minhas, na real...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Mas se quiser capturar essa jovem prodígio e sua melhor e imbatível robô de batalha em ação com seu Aparelho Fotográfico, pode... É, pode super fazer isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "É só que... eu não costumo tirar fotos de mim mesma, então não manjo muito dessas coisas de parecer estilosa e tal... Não sei se as fotos vão ficar boas, sabe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Apenas seja você mesma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "Ótimo! Então é contigo! Não esquece de pegar o Marreco Marreta no auge da sua imponência também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "Vou garantir apertar o botão na hora em que você estiver no seu melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Podemos tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "É um dos seus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "E procurando algum material para fotos enquanto estamos nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
