			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Bem, esse é o meu peso sob controle, mas... Hã? O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kuki"
				},
				{
					"id": 750470402,
					"content": "Posso perguntar seu nome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Ah, certo. Sou um dos sentinelas de serviço aqui, apesar de estar no modo folga agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kuki"
				},
				{
					"id": 750470404,
					"content": "Então tem algo errado, vá procurar aquele cara do meu lado, Yukam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki"
				},
				{
					"id": 750470405,
					"content": "Tá pensando em quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Bem, sabe, ganhei um pesinho nos últimos tempos, então adicionei um monte de frutas saudáveis à minha dieta normal de Frutogrão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kuki"
				},
				{
					"id": 750470407,
					"content": "Mas por algum motivo, meu amigo Ur aprendeu comigo comendo um monte de mato... Não é um desastre, já que Saurianos são onívoros, mas me preocupo se todo aquele mato é bom para a nutrição dele, exatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kuki"
				},
				{
					"id": 750470408,
					"content": "Acho que preciso ter uma conversa com ele depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki"
				},
				{
					"id": 750470409,
					"content": "Nada, sério.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "#Claro. Boa viagem, então, forasteir{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
