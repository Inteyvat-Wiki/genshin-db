					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570418
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570418,
					"content": "Se você quiser perguntar algo, terá que esperar que desçam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
