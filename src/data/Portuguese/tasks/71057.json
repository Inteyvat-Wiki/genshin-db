			"dialogs": [
				{
					"id": 710570133,
					"content": "Uma voz subitamente soa do fundo:\\n\"Hehehe... Carne de cogumelos... Hehehe...\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "Hehehe, o que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570102,
					"content": "Oh não! Ele está com uma aparência muito estranha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#E ele acabou de aparecer sem fazer nenhum som, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "Provavelmente não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Hehehe... O que vocês estão... fazendo aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570107,
					"content": "Você também já ficou sem comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570108,
					"content": "Você é o Tio He?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "Hã? O quê? Jovens, o que vocês disseram? Eu não entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570110,
					"content": "Paimon está perguntando se você é o Tio He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Oooh, sim. Hehehe, sou eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570112,
					"content": "#Vocês estão aqui pres{F#as}{M#os} que nem eu sem nada para comer? *Suspiro* Que azar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570113,
					"content": "Hehehe, mas não importa... Eu tenho o que comer aqui... Estou com fome há muito tempo, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570114,
					"content": "Na verdade, Paimon também está com um pouco de fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "Você não pode sair comendo carne de cogumelos à vontade!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Sim, sim. Ele parece que está em um transe, sua aparência também está muito estranha... Ele deve estar assim porque comeu essa carne de cogumelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Carne de cogumelos? Hehehe, carne de cogumelos é muito gostosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570119,
					"content": "Venham, vou lhes dar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570120,
					"content": "Hehehe, carne de cogumelos... O quê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570121,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "Eu não tenho mais carne de cogumelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570123,
					"content": "Esqueça essa carne de cogumelos! Vamos voltar para o acampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "Não! Eu não tenho carne de cogumelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570125,
					"content": "Se eu não tiver cogumelos, não tenho força para caminhar! Não tenho como ir para canto algum... Sem cogumelos... Não tem mais nada para comer nesses lugares daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570126,
					"content": "Onde quer que tenha cogumelos eu posso ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570127,
					"content": "Bem, onde há essa carne de cogumelos então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Carne de cogumelos... Hehehe... Eu sei onde tem... Vamos comer um pouco de carne de cogumelos, assim teremos forças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570129,
					"content": "É por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570130,
					"content": "#Não tem jeito. {NICKNAME}, vamos procurar essa carne de cogumelos para dar a ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "Parece que é a única alternativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Carne de cogumelos... Hehehe, Carne de cogumelos enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570116,
					"content": "Não saia comendo coisas perigosas à vontade!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
