					"nextDialogs": [
						710570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570203,
					"content": "Hehehe... Carne de cogumelos... Carne de cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570204,
					"content": "Desde que comi carne de cogumelos pela primeira vez, não sinto mais dor nas minhas costas, e minhas mãos estão mais ágeis... Hehehe... Eu me sinto muito mais jovem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570205,
					"content": "Monstros de carne de cogumelo são ainda mais gostosos que carne de cogumelo! Carne de cogumelos... Quanto maior, mais gostosa! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570206,
					"content": "Será que Tio He ficou forte assim depois ter comido a carne de cogumelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, se basta comer para ficar mais forte, vamos comer alguns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570208,
					"content": "Você só quer comer carne de cogumelo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "Paimon só está curiosa para saber como é o sabor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570212,
					"content": "Bem, Tio He, você não tem problema nenhum de retornar conosco agora, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570213,
					"content": "Carne de cogumelo... Hehe, delícia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570214,
					"content": "Tio He! Vamos voltar juntos para o acampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570215,
					"content": "Hã? Juntos? Está bem, mas venham aqui comer. Essa carne de cogumelo pode ser guardada por muito tempo depois que é desidratada, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570216,
					"content": "Paimon quer dizer para voltarmos juntos para o acampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570217,
					"content": "Acampamento? Que lugar é essa? Está bem... Hehehe, eu comi carne de cogumelos, posso ir para onde quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570218,
					"content": "Hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, vamos logo levar Tio He de volta para Jinwu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570210,
					"content": "Não pode sair comendo qualquer coisa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "Está bem... Está bem...",
