			},
			"dialogs": [
				{
					"id": 710570301,
					"content": "Carne de cogumelos... Hehehe, uma porção deliciosa de carne de cogumelos... Cogumelos pequenos, monstros de cogumelos, cogumelos gigantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570302
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570302,
					"content": "Tio He? Por que sua aparência está tão estranha?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570303
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570303,
					"content": "*Suspiro* Eu sabia que você estava vivo! Sua família até mesmo me convidou para seu funeral. Eu recusei e disse para eles que enquanto não visse seu cadáver, você estava vivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570304
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570304,
					"content": "Sua aparência não está boa. Deve ser porque você sofreu bastante lá nas minas. Mas você está vivo! Isso que importa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570305,
					"content": "Estou vivo! Cogumelos vivos deliciosos... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570306
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570306,
					"content": "Tio He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570307
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570307,
					"content": "Ele já estava assim quando o encontramos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570308,
					"content": "Ele está perturbado... E só fica gritando o tempo inteiro que quer comer cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570309,
					"content": "Cogumelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570310
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570310,
					"content": "O ambiente das profundezas do Despenhadeiro é muito perigoso para pessoas normais. Os fungos e plantas que crescem nelas também são prejudiciais às pessoas, por isso o Salão Huishan proibiu que os mineradores comessem essas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570311
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570311,
					"content": "Mas Tio He ficou todos esses anos dentro da mina, ele não tinha outra escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570312
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570312,
					"content": "O que eu direi para a sua família agora que ele está assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570313,
						710570314
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570313,
					"content": "Se forem os cogumelos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				},
				{
					"id": 710570315,
					"content": "Bem, já que você mencionou, Khedive disse que talvez exista alguma maneira, afinal, ele é um pesquisador de Sumeru, com certeza deve ter pesquisado cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570316
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570316,
					"content": "Esperem aqui um pouco. Eu irei chamar Khedive para vir aqui dar uma olhada na situação do Tio He.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570317
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570317,
					"content": "Carne de cogumelos... Carne de cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570318
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570318,
					"content": "*Suspiro* Não faço ideia se Tio He poderá se recuperar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570319,
					"content": "Se ele ficar assim para sempre, mesmo que retorne, sua família não ficará feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570320,
					"content": "Você não pode me tirar daqui quando eu estava escrevendo metade de meu relatório. Jinwu, mesmo que você seja a responsável pela segurança da Equipe de Exploração, não pode perturbar minha pesquisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570321
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570321,
					"content": "Eu seriamente considerarei a proposta de reduzir o orçamento de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570322
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570322,
					"content": "Não se importe com o orçamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570323
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570323,
					"content": "Por favor, dê uma olhada na condição deste homem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570324
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570324,
					"content": "Minhas orelhas coçam... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570325
					],
					"speakerTitle": "Tio He"
				},
				{
					"id": 710570325,
					"content": "Hã? Quem é ele? Por que ele está com essa cara tão estranha?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570326
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570326,
					"content": "#{NICKNAME}, você trouxe essa pessoa de volta? Por que você sempre se depará com situações inusitadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570327
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570327,
					"content": "Bem... Como ele estava quando você o descobriu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570328
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570328,
					"content": "Você explica a situação de Tio He para Khedive...\\nKhedive examinou Tio He minuciosamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570329
					]
				},
				{
					"id": 710570329,
					"content": "Ótimo, ótimo, não é nada demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570330
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570330,
					"content": "Vejam, ele não estava dizendo que a sua orelha estava coçando? Isso é porque os esporos desse tipo de fungo entram nela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570331
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570331,
					"content": "E o consumo de longo prazo desse tipo de fungo... Perdão, cogumelo, realmente impacta a sanidade, mas não é prejudicial para o corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570332
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570332,
					"content": "Você quer dizer então que ele pode se recuperar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570333
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570333,
					"content": "Eu limpei seu corpo do fungo, e fiz um remédio que pode trazer seu sistema nervoso de volta ao normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570334
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570334,
					"content": "Ele só precisa descansar. É muito provável que se recupere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570335
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570335,
					"content": "Bem, quanto ao pagamento do remédio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570336
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570336,
					"content": "Os materiais para o remédio são muito baratos, valem o mesmo que um mês no Quiosque de Xinyue, nada demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570337
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570337,
					"content": "Hã... Eu pensarei numa forma de lhe pagar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570338
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570338,
					"content": "Não precisa me pagar. Só precisa me trazer algo para eu escrever em meu relatório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570339
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570339,
					"content": "Quando vim para o Despenhadeiro, descobri sobre a existência de um cogumelo especial. Eu queria investigar os efeitos do seu consumo durante um longo período de tempo... Mas não encontrei nenhum assistente que desejasse me ajudar com meu experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570340,
						710570342
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570340,
					"content": "Assistente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570341
					]
				},
				{
					"id": 710570341,
					"content": "Bem, alguém teria que comer os cogumelos. Todos são cautelosos a respeito dele, apesar de saberem que não é muito prejudicial, não desejam prová-lo assim tão facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570344,
					"content": "Entretanto... O ambiente do Despenhadeiro é especial. Talvez também exista a influência dele. Enfim, basta usar esse remédio e depois descansar bastante que a chance de se recuperar é muito alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570345
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570345,
					"content": "Ótimo, ótimo... Eu levarei ele para cima mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570346
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570346,
					"content": "Levarei ele de volta para casa quando se recuperar. Também notificarei seus colegas que ele está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570347
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570347,
					"content": "Tio He é um minerador experiente e ágil. Ele cuidava bem dos novatos nas minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570348
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570348,
					"content": "Depois que ele desapareceu, todos pensaram que Rex Lapis esqueceu dele. Uma pessoa boa como ele não deveria ter acabado dessa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570349
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570349,
					"content": "Quando ele voltar, todos com certeza ficarão muito felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570342,
					"content": "Você está falando de uma cobaia, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570343
					]
				},
				{
					"id": 710570343,
					"content": "Pode-se dizer dessa forma. Entretanto, eu analisei esse tipo de cogumelo antes. Ele não causa nenhum dano irreversível para o corpo humano ou para seu espírito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570344
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570314,
					"content": "Tem algum pesquisador de cogumelos por aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570315
					]
				}
			]
		},
