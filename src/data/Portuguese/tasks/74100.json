			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Babe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "(Cheira)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003102,
					"content": "Au au! Boa pessoa. Faz cafuné?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003103,
					"content": "Claro que sim, Mori merece todos os cafunés do mundo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Você faz carinho em Mori.\\nComo Mori é (um cão) feito de água, ele é bem molhado.\\nMas Mori parece bem feliz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Au au! Obrigado, boa pessoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003106,
					"content": "Outra hora faço mais, tá bom, Mori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "Aaau... Mori mau, sem cafuné?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003108,
					"content": "O que isso tem a ver com ser bom ou mau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Au au! Cães bonzinhos ganham cafuné. Cães malvados são... castrados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003110,
					"content": "Ooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Babe"
				},
				{
					"id": 741003111,
					"content": "Vendo Mori triste, você estende a mão para fazer carinho nele.\\nComo Mori é (um cão) feito de água, ele é bem molhado.\\nOs olhos azuis de Mori começam a brilhar de novo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Au au! Muito obrigado pelo cafuné!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babe"
				}
			]
		}
	]
