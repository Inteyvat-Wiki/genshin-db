		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Al",
					"Petit Chou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "Se pudermos recuperar o tesouro da Princesa Lyris, as forças da justiça continuarão a crescer cada vez mais! O dia de nossa vitória sobre Narcissus se aproxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002502,
					"content": "...É por isso que não podemos esquecer o sacrifício heroico de Ney. Se ele não tivesse escondido o tesouro, Narcissus certamente já teria infiltrado a torre onde a princesa reside.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002503,
					"content": "É! Ney é super incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002504,
					"content": "#Não deixaremos os esforços de Ney serem em vão, nem falharemos em honrar as contribuições extraordinárias de {NICKNAME}! Desta vez, com ajuda de todos vocês, salvaremos a Princesa Lyris!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002505,
					"content": "É! Vamos salvar a Princesa Lyris, e então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002506,
					"content": "E então o Reino da Cruz de Narcissus será restaurado à sua antiga e radiante glória! A Princesa segurará vocês em seus braços, cuidará de suas penas e acariciará gentilmente sua pequena testa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002507,
					"content": "As memórias perdidas nas águas ressurgirão e nossos amigos poderão rir novamente juntos à princesa! Será uma cena repleta de uma bela alegria, e quaisquer conflitos jamais irão nublar nosso horizonte novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002508,
					"content": "Como nos velhos tempos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002509,
					"content": "...Isso mesmo, como nos velhos tempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Al"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
