			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jacques"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#{NICKNAME}, é você! Após recuperarmos o tesouro da Princesa Lyris, teremos a chave para a vitória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002602,
					"content": "Finalmente temos uma chance de derrotar os invasores e salvar a Princesa Lyris! Assim, a Orquestra de Jacques realizará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002603,
					"content": "O último movimento da abertura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002604,
					"content": "Sério? É só a abertura...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "Oh? Você achou mesmo que tudo chegaria ao fim após salvar a Senhorita Lyris e reconstruir o reino? HA! O mundo real não é um simples conto de fadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002607,
					"content": "É porque o mundo é cheio de gente simplória e ingênua como você, que a história sempre se repete! O próximo passo obviamente é derrubar a estrutura de classe e a desigualdade de distribuição de riqueza que estão enraizados na sociedade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002608,
					"content": "Apenas em um mundo que é razoavelmente igual, equitativo e justo que a paz poderá surgir - e é certamente isso o que a Senhorita Lyris almeja. O único motivo por termos deixado esses princípios de lado foi devido à nossa situação atual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002609,
					"content": "Vou pegar o meu banquinho e sair de mansinho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "Primeiro, com base na teoria de... é nosso dever... erguer uma... para reverter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jacques"
				},
				{
					"id": 741002605,
					"content": "Eu achava que já era o gran finale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
