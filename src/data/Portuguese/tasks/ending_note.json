				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960001,
					"content": "Então foram os Fatui que os atacaram? Incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960002,
					"content": "Jean acaba de voltar ao Quartel-General de Cavaleiros de Favonius. Ela disse que estava pensando em como obter evidências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960003,
					"content": "Ela também disse que, se não encontrasse vestígios, os Cavaleiros não seriam capazes de acusá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39602",
							"2"
						],
						"stepId": 39602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "Esta é a Barbara, a Diaconisa da Igreja. Ela está aqui para recuperar a Lira Sagrada der Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960202,
					"content": "Que o Arconte Anemo proteja você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960203,
					"content": "Eu não estou em posição de falar como a nossa Grande Mestre Intendente, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960204,
					"content": "Mas eu ainda quero agradecer você em nome de toda Mondstadt pela sua ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960205,
					"content": "Felizmente, as coisas foram resolvidas pacificamente... Não consigo imaginar como seria se a batalha tivesse sido entre os militares e o dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960206,
					"content": "Agora os Fatui não têm outra opção a não ser se calar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960207,
					"content": "Eles devem estar incomodados pelas coisas não terem ocorrido da maneira que planejaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960208,
					"content": "Desta vez, eles até mesmo perderam sua melhor chance para pressionar os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960209,
					"content": "Diplomaticamente falando, eles não ganharam nada e, pelo contrário, simplesmente provaram o quão vexatórios podem ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960210,
					"content": "Está bem, vamos voltar ao assunto. Vocês trouxeram de volta a Lira Sagrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960211,
					"content": "Não podemos pedir para você defender a Lira para sempre. O Seneschal tem me pressionado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960212,
					"content": "Bem... Trouxemos, só que... É um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960213,
					"content": "Não se preocupe! Não estou aqui para cobrar o aluguel! A Igreja sempre recebeu financiamentos especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39605",
							"2"
						],
						"stepId": 39605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "#Ah! Cavaleir{M#o}{F#a} Honorável, está acordad{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960502,
					"content": "Venti... Está tudo bem com ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "Hum... Eu não diria que ele esteja \"bem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960504,
					"content": "Encontrei vocês desmaiados fora da Catedral e usei meus poderes elementais para curá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960510,
					"content": "Aquele bardo recuperou a consciência antes de você, mas estranhamente meus poderes de cura não tiveram efeito sobre ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960511,
					"content": "É a minha primeira vez que encontro um paciente assim. Ele disse: \"É normal\" e insistiu em sair da Catedral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960512,
					"content": "Ele já foi? Para onde ele foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>Um Símbolo do Herói de Mondstadt</color>... Foi isso que ele disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960514,
					"content": "Eu queria detê-lo, mas Jean... Mestre Jean disse para deixá-lo ir. Foi muito estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960515,
					"content": "(Acho que entendi mais ou menos o porquê...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "Eu me lembro que Venti também foi a curar suas feridas sob <color=#00E1FFFF>aquela árvore</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960518,
					"content": "(Deve ser por causa da conexão entre Arconte Anemo e Origem do Vento. Parece que a Mestre Jean percebeu isso também, mas não pôde contar a Barbara...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960516,
					"content": "(Com certeza a Jean também sabe...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "Em que planeta... Estamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "Planeta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960507,
					"content": "Ah! Barbara, não ouça suas besteiras! É ilusório!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960508,
					"content": "Ah? Hum... Bom, enfim, encontrei vocês desmaiados fora da Catedral e usei meus poderes elementais para curá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960509,
					"content": "A Paimon acha que você ainda podia ter usado um balde de água fria na cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39604",
							"2"
						],
						"stepId": 39604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "O vento entre os ramos das árvores é bom, eu adoro o cheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960602,
					"content": "Haha! Eu disse a mesma coisa na última vez. *Suspiros* Por que eu digo isso quando as coisas não estão indo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960603,
					"content": "Então, o que é \"Gnosis\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "Ah, então você percebeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960605,
					"content": "*Suspiros* Eu não deveria falar com pessoas comum, mas acho que nada acontece se eu te contar em segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960606,
					"content": "Como você sabe, a Visão é um artefato mágico que poucas pessoas podem ter. Através dessa Visão, você pode atrair energia elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960607,
					"content": "Na verdade, todo portador de uma Visão pode alcançar a divindade e ascender a Celestia. Chamamos essas pessoas de Arcontes Primordiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960608,
					"content": "\"Arcontes Primordiais\"? Eu nunca tinha ouvido falar disso antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960609,
					"content": "Hehe, é porque é um segredo que apenas os deuses sabem. Enfim, não precisamos dos artefatos assim tão primitivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960610,
					"content": "Sendo um substituto, cada Arconte tem um foco mágico interno que ressoa diretamente com Celestia... Conhecida como \"Gnosis\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960611,
					"content": "Então, o que é isso pendurado na cintura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "Haha! É apenas uma bola de cristal, para evitar suspeitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960613,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "Então, quem foi a mulher que lançou a Paimon pelos ares e roubou a Gnosis de Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960616,
					"content": "Ela é Signora, a Oitava dos Onze Mensageiros dos Fatui",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960617,
					"content": "Ela, como todos os Mensageiros, receberam autoridade executiva divina dada pela Tsaritsa de Snezhnaya e, com isso, força superando a de outros mortais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960618,
					"content": "Tsaritsa de Snezhnaya? Não é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960619,
					"content": "Hm! De fato. ela é uma dos Sete, a Tsaritsa que reina em seu Palácio de Inverno, e a única pessoa a quem todos os Mensageiros de Fatui respondem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960620,
					"content": "A relação entre os Sete Arcontes não é perfeitamente boa, mas eu nunca pensei que ela planejaria roubar o Gnosis de outras Divindades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960621,
					"content": "Que tipo de Deusa é a Imperatriz do Gelo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "Hum... Como que posso dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960623,
					"content": "Me lembro dela de quinhentos anos atrás, mas desde então ela mudou, e não a reconheço mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960624,
					"content": "Após uma grande catástrofe cinco séculos atrás, perdemos o contato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960625,
					"content": "Enfim, podemos falar sobre a Arconte Cryo e dos Fatui em outra ocasião?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960626,
					"content": "#{NICKNAME} Sua jornada para encontrar todos os Sete Arcontes será cheia de dificuldades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960627,
					"content": "Você deve ir para a nação vizinha de Mondstadt, Liyue. O Arconte Geo que reina ali, ao contrário de mim, administra toda a sua região pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960628,
					"content": "Ele desce apenas uma vez por ano para dar suas previsões divinas e determinar as diretrizes de Liyue para o resto do ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960629,
					"content": "Mesmo assim, ele trabalha mais do que uma certa pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960630,
					"content": "Err...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960631,
					"content": "Enfim, parece que o Ritual de Descensão deste ano está prestes a começar. Se perder, você terá que esperar mais um ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960632,
					"content": "#Uau?! Por que você não disse isso antes? Adeus. {NICKNAME}, rápido, vamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960633,
					"content": "Espere, O Forasteiro que Voa a Favor do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960634,
					"content": "Você se refere a mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960638,
					"content": "Viajante, lembre-se do significado real da jornada da próxima vez que você partir para uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960639,
					"content": "Os pássaros, os cantos, as cidades; a Tsaritsa, os Fatui e os monstros fazem parte da sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960640,
					"content": "Seu destino não é tudo. Antes de alcançá-lo, use seus olhos para contemplar o mundo ao seu redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960641,
					"content": "Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "Bom! Agora termina a exortação do Arconte Anemo! Chegou a vez do Venti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960642,
					"content": "Entendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "Desculpe por pegar emprestado o poder Anemo da Estátua sem permissão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "Haha! Você pode usá-lo à vontade, só que tem que me convidar para um copo de Vinho de Dandelion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960614,
					"content": "#Você me enganou outra vez, mas eu já estou acostumad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "Se houver mais alguma coisa que você queira perguntar, agora é a hora. Os bardos não ficam muito tempo em um só lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960702,
					"content": "Sobre Dvalin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "Dvalin... Sempre se lembrou de seu dever como um dos Quatro Ventos, até o fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960704,
					"content": "Não vou descarregar a responsabilidade dele, nem o forçar aceitar a \"liberdade\" da minha compreensão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960705,
					"content": "Eu só desejo que ele possa decidir e entender por si mesmo o que isso significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960706,
					"content": "Antes de me tornar um Arconte, também fui exortado por um amigo sobre o significado de \"liberdade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960707,
					"content": "Sobre a Ordem do Abismo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "Hum? Quer dizer as informações do Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960709,
					"content": "#Entendo... Então tem {F#um Príncipe}{M#uma Princesa} da Ordem do Abismo que está por trás do plano de corromper Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960710,
					"content": "#Provavelmente eles estavam tentando transformar Dvalin em uma arma de guerra da Ordem do Abismo. Dito isso, nunca ouvi falar de {F#nenhum Príncipe}{M#nenhuma Princesa} na Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960711,
					"content": "Então, não é uma tradição da Ordem do Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "Eu também acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960714,
					"content": "Mas como alguém novo pode ser o chefe da Ordem do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960712,
					"content": "Parece ser algo recente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "Sobre a Signora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "Ela é a Mensageira dos Fatui, e ela roubou sua Gnosis e fugiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960717,
					"content": "Isso é para evitar testemunhas dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960718,
					"content": "Se alguém testemunhasse, seria uma afronta direta contra os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960719,
					"content": "Como eles pretendem continuar atuando como aliados de Mondstadt depois de fazer algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960720,
					"content": "*Suspiros* Os humanos das sete nações precisam se unir para enfrentar a ameaça da Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960721,
					"content": "Os Fatui têm o maior poder militar das sete nações, mas o usaram para roubar a Lira Sagrada der Himmel e arrebatar o poder dos deuses, e usaram Stormterror como desculpa para pressionar os Cavaleiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960722,
					"content": "Falando da Lira Sagrada der Himmel, Paimon acredita que já ouviu Diluc dizer algo semelhante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960723,
					"content": "Ele disse que os Fatui podem correr livremente pelas sete nações e ameaçar os Cavaleiros pela presença dos Onze Mensageiros",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960724,
					"content": "Sim, como eu disse, a Arconte Cryo lhes deu autoridade, e eles obtiveram a força além dos humanos comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960725,
					"content": "Não vejo a Imperatriz do Gelo em quinhentos anos... O que ela realmente está pensando e planejando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960726,
					"content": "As respostas a essas perguntas provavelmente terão efeitos desconhecidos em sua busca pelos Sete Arcontes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960727,
					"content": "Sobre os deuses...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "Como eu disse, os portadores de uma Visão são conhecidos como Arcontes Primordiais, e podem ascender à Celestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960729,
					"content": "Uma Gnosis está na categoria mais alta como um nexo de manipulação elemental e é um emblema de posição dos Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960730,
					"content": "#Desculpe, não sei quem dos Setes raptou {M#a sua irmã}{F#o seu irmão}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960731,
					"content": "Mas... sendo um dos Sete, não estou livre de suspeitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960732,
					"content": "Você é muito diferente daquele Arconte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "Mas o Bardo Desafinado é apenas uma das encarnações de Barbatos, você não pode julgar assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960734,
					"content": "Temos passado por tantas coisas juntos, que não tenho a menor dúvida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#Haha, realmente somos um grande time! Quando você encontrar {F#o seu irmão}{M#a sua irmã}, você não tem vontade de se tornar um dos Quatro Ventos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960736,
					"content": "Talvez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#Hum? {NICKNAME}, parece que você não está muito interessad{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960738,
					"content": "Então, Bardo Desafinado! Caso ser um dos Quatro Ventos signifique comida de graça, você não consideraria a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960739,
					"content": "Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960741,
					"content": "Era só isso mesmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "Então vá lá para <color=#00E1FFFF>Liyue</color>. Se perder o Ritual de Descensão deste ano, terá que esperar o do ano que vem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}