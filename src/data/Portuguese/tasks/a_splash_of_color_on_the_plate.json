			"dialogs": [
				{
					"id": 756730101,
					"content": "Parece que nossos Ashas Coloristas estão muito satisfeitos agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Outro desafio concluído pelos nossos maravilhosos Ashas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Incrível! Conseguimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Esse Asha aqui já tá inspirado a começar outra obra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "Bem, sabe como a inspiração pode vir e vir num piscar de olhos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Ah, olha só todo o tesouro deixado pra trás... {NICKNAME} e Paimon, vocês deviam ficar com ele! Por todo o esforço que dedicaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Talvez na próxima vez que a gente apareça aqui, vamos poder ver a obra-prima do Asha Colorista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Só imagine que tipo de obra seria! Especialmente quando até os Ashas normais já são capazes de elaborar cores tão lindas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "Paimon mal pode esperar pra ver o que os Ashas Coloristas vão criar! Talvez eles pensem em alguma coisa... que nem palavras conseguem descrever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Talvez eles nos deem... as cores do Flogisto, da lua, ou algo das profundezas do cosmo estrelado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "É, é exatamente assim que deveria ser! Se a gente encontrar uma criatura enfrentando algum tipo de dificuldade durante nossas aventuras, a gente devia fazer tudo que podemos pra ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Ahã! Quem sabe? Talvez um dia isso renda umas recompensas inesperadas pra gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Concordo com Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ah, mas... Não devíamos fazer isso só por causa de alguma recompensa. Isso seria além do motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Mesmo que não tenha nada para a gente ganhar, ajudar amigos necessitados e ver os sorrisos deles retornando enquanto as coisas melhoram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "Eu amo essa sensação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "E parece ser bem satisfatório também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Você tem que aproveitar a oportunidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}