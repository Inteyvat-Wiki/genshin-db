			},
			"dialogs": [
				{
					"id": 752460384,
					"content": "#Como {M#ancião}{F#anciã}, você deveria ir primeiro, {M#vovô}{F#outra vovó}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460385,
					"content": "Pode deixar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#Uau, a competição está realmente pegando fogo! Lá vem uma jogada profissional de {NICKNAME}... e o peixe mordeu! {NICKNAME} puxa e vem um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460302,
					"content": "Espera aí... isso é... um Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460303,
					"content": "Uau... Não é exatamente o tipo de pescaria que eu esperava! Tô por fora de como vou julgar isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460304,
					"content": "#Boa, {M#vovô}{F#outra vovó}! Teremos que ver se mais alguém consegue fisgar algo ainda mais especial. Caso contrário, isso deve ser suficiente para a vitória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460305,
					"content": "#Obrigad{M#o}{F#a}, pessoal! Estou contra oponentes bem determinados, mas acho que tenho uma chance. Tomara que meu netinho esteja certo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#Uma exibição impressionante de {NICKNAME}! Isso será algo bem difícil de ser superado pelos outros competidores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460307,
					"content": "Ifa, é com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460308,
					"content": "Você consegue, mano! Trabalho em equipe é tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460309,
					"content": "Desculpe, Cacucu. Mas não há espaço para trabalho em equipe aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460310,
					"content": "Eita, se liguem, manos... Peguei uma coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460311,
					"content": "Ifa puxa com toda sua força a vara de pesca. Parece que ele fisgou algo grande...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "Mas... é outra coisa inesperada.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "Uh... Parece que Ifa puxou um Koholassauro... carregando uma Capivara? Não tenho muita certeza do que está acontecendo ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460314,
					"content": "Incrível! Ifa sempre realmente teve jeito com animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460315,
					"content": "Espera, tem algo errado com a cauda do Koholassauro... Acho que ele a cortou em uma pedra, e imagino que essa Capivara estava tentando ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460316,
					"content": "Ou, a Capivara estava tentando comer a cauda dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460317,
					"content": "Sem chance, mano. Cacucu, você pode ir perguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460318,
					"content": "Sim, sim... Pode deixar, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460319,
					"content": "Viu? Sabia que eu estava certo... Espera, não. Isso não é o que importa no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460320,
					"content": "Ifa examina rapidamente a cauda do Koholassauro. Felizmente, era apenas um arranhão.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "Após uma simples triagem, o Koholassauro e sua companheira Capivara partem.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "Aw, uma nova amizade. Parece que hoje também é o dia de sorte deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460323,
					"content": "\"Também\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460324,
					"content": "Isso mesmo. É minha vez, e eu tenho a sensação de que vou ganhar isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460325,
					"content": "Trabalho em equipe é tudo, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460326,
					"content": "Acho que essa é sua forma de torcer por nós, né, amiguinho? De onde você aprendeu isso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460327,
					"content": "Cacucu, mestre torcedor de pesca!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "\"Torcedor de pesca\" é meio sem graça. Estamos lutando por algo importante. Precisa ser um pouco mais grand- Hã!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460329,
					"content": "O que é isso?! Rápido, saiam do caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460330,
					"content": "Tá, esse parece bem anormal... Mas, é outra Capivara! E ela avançou contra nós! Você não disse que eram criaturas gentis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460331,
					"content": "Ele também deve estar lutando por algo importante. Hm, consigo sentir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460332,
					"content": "...Ou, talvez não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460333,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "Capivara"
				},
				{
					"id": 752460334,
					"content": "Acho que somos só nós. Mas, ele está chateado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460335,
					"content": "Oh, ei, pequenino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460336,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "Capivara"
				},
				{
					"id": 752460337,
					"content": "Haha! Boa, mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460338,
					"content": "O-O quê? Cacucu está tentando... acalmar ele ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460339,
					"content": "Parece mais tentando confortá-lo. Ele pode não parecer, mas Cacucu tem um ótimo jeito de lidar com pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460340,
					"content": "Uh. Mesmo com seu... vocabulário limitado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460341,
					"content": "Quando se está falando com uma Capivara, não acho que o vocabulário humano importe muito, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460342,
					"content": "Oh... é verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460343,
					"content": "Temos apenas que confiar no maninho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460344,
					"content": "Além disso, quando você está tentando se comunicar, acho que o tom é bem mais importante do que palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460345,
					"content": "Por exemplo, \"olá\". Que significa \"estou feliz\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460346,
					"content": "Mas, \"olá\"... significa \"estou frustrado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460347,
					"content": "E \"olá!\"... Isso é raiva, um sinal de que é pra correr e se esconder, pois o perigo está por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460348,
					"content": "Tá, Paimon não entendeu completamente, mas ela vai só acreditar em você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460349,
					"content": "Aprendendo algo novo todos os dias, hein? Valeu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "Oh, foi um prazer! É o método que criei para me comunicar com os afídios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460351,
					"content": "FUNCIONÁRIOS afídios... lembra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460352,
					"content": "Não, não só os funcionários. Alguns afídios não quiseram se juntar, sabe. Compreendo o sentimento deles, é claro, e respeito a decisão deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460353,
					"content": "...Então, talvez você poderia jogar um pouco desse entendimento para mim, né, mano. Estou por um fio aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460354,
					"content": "Hã, sério? Achei que você estaria orgulhoso. Viu, olha lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460355,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "Capivara"
				},
				{
					"id": 752460356,
					"content": "Haha! Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460357,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "Capivara"
				},
				{
					"id": 752460358,
					"content": "Uau! Uau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460359,
					"content": "Uau, parece que eles realmente se deram bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460360,
					"content": "Certo, bem, estou um pouco orgulhoso, mas... Hã? Ororon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460361,
					"content": "Não se preocupe. Deixa comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460362,
					"content": "Olá, Rei Capivara. Você gostaria de algo para comer? Tenho uma fornada fresca dos biscoitos de Ifa bem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460363,
					"content": "Rrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "Capivara"
				},
				{
					"id": 752460364,
					"content": "Rei Capivara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460365,
					"content": "Ele comeu! Parece que isso animou bem ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460366,
					"content": "Oh nossa! Oh nossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460367,
					"content": "Espera aí... Como nossa competição de pesca virou um zoológico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460368,
					"content": "Ei, isso não é algo ruim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "Huh, verdade... Bem, acho que isso torna Ororon o vencedor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460371,
					"content": "Considerando que ele conseguiu pegar esse, uh... Rei Capivara ou sei lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460372,
					"content": "Um nome apropriado, eu diria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "Claro, Ororon ganhou. Nenhum de nós conseguiu pegar um peixe de verdade mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460374,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460375,
					"content": "Legal, então eu fico com a cervejafídio! Só que já era minha mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460376,
					"content": "Bem, você pode ficar! Isso é algo, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460377,
					"content": "Verdade, e o Rei Capivara nos deixou uma coisinha extra. Veja, acho que é um presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460378,
					"content": "Uma foto de \"Ovos de Presente Dourados\"? Uh, a localização nessa foto parece familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460379,
					"content": "Será que isso significa que o Rei Capivara quer que a gente vá lá? Meio que parece isso, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460380,
					"content": "Não faz mal ir dar uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "É definitivamente algo para dar uma olhada se tiver um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460382,
					"content": "Talvez terá algo incrível nos esperando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460383
					]
				},
				{
					"id": 752460383,
					"content": "É, quem sabe... Mas deveríamos ir preparados só por precaução.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460369,
					"content": "Bem divertido, não acha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				}
			]
		}
	]
}