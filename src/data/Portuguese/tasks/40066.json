			"dialogs": [
				{
					"id": 400660301,
					"content": "Uau, é um novo lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660302
					],
					"speakerTitle": "Paimon"
				},
				{
