			]
		},
		{
			"id": 4006606,
			"completionStepIds": [
				4006606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006606",
							"2"
						],
						"stepId": 4006606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kageharu",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400660601,
					"content": "... Isso servirá. Kazuha, você chegou na hora certa. O que você acha dessa rocha esculpida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660602
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660602,
					"content": "É bem intrincada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660603,
					"content": "Haha, é baseada na vista de uma montanha que vi em um livro. Há nações nesse mundo em que as montanhas chegam até as nuvens. Oh, se eu tivesse a chance de ter visto com meus próprios olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660604
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660604,
					"content": "Pai, você pode ir onde quiser quando quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660605,
					"content": "Não é verdade. Apesar do Clã Kaedehara não ser mais o que era, eu ainda sou responsável por ele, assim como os Chefes passados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660606
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660606,
					"content": "Mas... Continuar os costumes de nossos antepassados, sacrificando tudo por nosso clã decadente... Isso vale mesmo a pena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660607
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660607,
					"content": "Pai... Eu não entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660608
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400660608,
					"content": "Kazuha, há uma coisa que eu quero que você sempre se lembre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660609
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660609,
					"content": "A família é importante, mas você não deve deixar que ela lhe prenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660610
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660610,
					"content": "Uma família existe por causa das pessoas nela. Se estivermos infelizes, como poderíamos ter uma família feliz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660611
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660611,
					"content": "O que aconteceu no passado teve um impacto profundo em nossa família, mas não é um fardo que você deve carregar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660612
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660612,
					"content": "Se um dia você se cansar dessa vida entediante, abandone tudo e parta numa jornada, conheça o mundo. Lembre-se, Kazuha, não se deixe ficar preso a nada na vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400660613
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400660613,
					"content": "Sim, pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006611,
			"completionStepIds": [
				4006611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
