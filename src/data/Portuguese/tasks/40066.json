			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kaedehara Kageharu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400661101,
					"content": "Sinto muito, mas eu não entendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661102,
					"content": "Kazuha, você esqueceu de nossa promessa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661103
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661103,
					"content": "Você quer desistir de tudo? Mesmo se estivermos passando por um período ruim, eu estou ao seu lado! Não posso lhe ajudar em nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661104,
					"content": "Quando você tinha minha idade, sempre ajudava meu avô! Eu sou tão incompetente que desaponto você? Ou será que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661105,
					"content": "Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661106
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661106,
					"content": "*Suspiro*... O fato de você se culpar prova que eu fracassei como pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661107
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661107,
					"content": "O Clã Kaedehara está pagando o preço pelos erros passados, desde o seu bisavô. Até hoje, nunca nos recuperamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661108
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661108,
					"content": "Apesar de sermos uma família de ferreiros, você não precisa dedicar sua vida a esse negócio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661109
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661109,
					"content": "Se um animal ferido quer fugir de uma armadilha, ele tem que sacrificar a perna que foi pega. Você pode pensar nisso como uma perda, mas permanecer na armadilha possui consequências muito mais letais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661110
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661110,
					"content": "Chega, Kazuha. Como Chefe do Clã, eu fracassei em reerguê-lo. Você nunca me culpou por não lhe dar a vida merecida por nossa herança, e sou grato por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661111
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661111,
					"content": "Todas essas gerações de sofrimento... Vamos acabar com isso agora. De agora em diante, viva sua vida sem fardos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661112
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661112,
					"content": "Não se preocupe, eu assumirei a culpa por abandonar o negócio de nossa família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661113
					],
					"speakerTitle": "Kaedehara Kageharu"
				},
				{
					"id": 400661113,
					"content": "Pai, não... Você não deve ser o culpado por não estar a altura do nome de nossa família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661114,
					"content": "Se esse dia chegar, me deixe dividir o fardo com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400661115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400661115,
					"content": "Vamos esperar. Mais cedo ou mais tarde, eu terei que liderar o Clã Kaedehara. Quando esse momento chegar, eu lidarei com todos nossos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
