			"dialogs": [
				{
					"id": 736810101,
					"content": "Viajante, Paimon, aqui estão vocês. Ouvi dizer que vocês participaram da busca pelo Ceste Abundante, como foi, foi divertido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810102,
					"content": "Foi bem divertido! Paimon não tem certeza se é por causa desse mercado durante o Festvinho, mas conseguimos várias decorações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736810103,
					"content": "Haha, com certeza existem pessoas que preparariam essas coisas como presentes. Oh, sim. Agora que estamos gerindo uma loja de lanches, você quer colocar algumas dessas decorações aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810104
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810104,
					"content": "Melhorar a aparência da loja pode ajudar a atrair mais clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810105
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810105,
					"content": "Além disso, eu tenho certeza que as pessoas que deram presentes também ficariam felizes ao ver seus presentes sendo usados na loja, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736810106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 736810106,
					"content": "#Faz sentido! {NICKNAME}, vamos lá, temos que decorar nossa loja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
