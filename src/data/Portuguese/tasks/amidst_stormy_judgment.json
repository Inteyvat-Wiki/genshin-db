			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "Que estranho... Nunca é tão quieto por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080302,
					"content": "Au, au... Au!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080303,
					"content": "Thoma está jogando seu jogo de ventríloquo novamente, hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080304,
					"content": "Thoma... Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080305,
					"content": "Au! Au! ...Au!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080306,
					"content": "Ei, você pode sair agora... Paimon já te viu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080307,
					"content": "Hã, nem um pio... Urg, então onde diabos ele está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080308,
					"content": "Au, au, au! Au!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080309,
					"content": "Hã? O que deixou Taroumaru tão nervoso hoje? Ele é sempre um menino tão bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080310,
					"content": "Olá, alguém de vocês viram o Thoma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080311,
					"content": "Não, nós pensamos que ele estaria com você! Por quê...? Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080312,
					"content": "Então é como eu temia... No caminho para cá, ouvi dizer que Thoma havia sido levado pela Comissão Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080313,
					"content": "Eu não tinha certeza se era verdade, então vim direto para cá. O fato dele não ter chegado aqui como combinamos sugere que seja verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080314,
					"content": "A Shogun Raiden está realizando hoje uma Cerimônia de Caça à Visão na Estátua da Deusa Onipresente, para marcar a 100ª Visão apreendida sob o decreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080315,
					"content": "E o 100º portador da Visão em questão... Aquele que terá sua Visão apreendida, temo que... Seja o Thoma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080316,
					"content": "Espere um momento... Então a cerimônia que Thoma disse que a Comissão Tenryou estava ocupada preparando... Era para a Cerimônia de Caça à Visão? E ele era o alvo esse tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080317,
					"content": "...Acredito que sim. A Shogun e a Comissão Tenryou veem a cerimônia como um marco. Com a 100ª Visão, eles desejam marcar o sucesso do Decreto da Caça à Visão até o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080318,
					"content": "...Isso não pode acontecer. Eu preciso ir resgatá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080319,
					"content": "Au, au! Au!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080320,
					"content": "Fique calma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Mas você é a Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Sim! Goste ou não, você representa toda a Comissão Yashiro. Então, se você for e fizer uma proeza dessas, você está basicamente declarando que você e a Shogun Raiden são inimigas agora, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080323,
					"content": "E ao fazê-lo publicamente, você pode estar implicando muitas outras pessoas da Comissão Yashiro, também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080324,
					"content": "Não há outra opção... Devemos agir depressa - a cerimônia está prestes a começar. Não vou abandonar Thoma desta maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080325,
					"content": "Ele é meu amigo! Pensar que não faz nem muito tempo, estávamos todos comendo juntos em um shabu-shabu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080326,
					"content": "Ele também é meu amigo. Eu vou salvar ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080328,
					"content": "Você mesma disse. Não há tempo a perder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080330,
					"content": "...Está bem, eu... Esperarei aqui pelo seu retorno. Volte em segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080331,
					"content": "Não se preocupe, Ayaka. A vida de um amigo está em jogo - não vamos estragar tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
