			"dialogs": [
				{
					"id": 760090501,
					"content": "Voltamos! Kasha, você considera isso uma pedra bonita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090502,
					"content": "#Uau, que rápido! Vocês são mesmo aventureir{M#os}{F#as} profissionais, incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090503
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090503,
					"content": "Hehe, moleza! A não ser que você queria que a gente explore um labirinto subterrâneo maluco, ou tire fotos em lugares a milhares de quilômetros de distância...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090504,
					"content": "Err... Err?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090505
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090505,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090506,
					"content": "Hmm... Apesar de ser mesmo uma pedra bonita, sinto que parece ser atraída para essa pedrona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090507
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090507,
					"content": "Sério? Paimon não sente nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090508,
					"content": "Também não tenho certeza... É só uma premonição vaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090509
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090509,
					"content": "É tipo... como Mai mencionou, Reed Miller também encontrou a Princesa Fada pela orientação da Deusa da Lua. Minha premonição deve ser uma coisa parecida, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090510
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090510,
					"content": "Uau, isso é o que eles chamam de premonição? Mas espera, Paimon tem quase certeza que a Deusa da Lua não ia se preocupar com uma coisa dessas... ela provavelmente tá ocupada demais pra esse tipo de coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090511,
					"content": "Então... o que sua premonição te diz para fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090512,
					"content": "Hmm... por exemplo, colocar essa pedra de volta lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090513
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090513,
