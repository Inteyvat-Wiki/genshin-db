					}
				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "Hmm... Não parece ser esse também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090202,
					"content": "#Ah, olá, {M#moço}{F#moça} que eu nunca encontrei antes e... hmm, fadinha branca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090203,
					"content": "Boas-vindas a Oficina da Lua Gelada! Posso ajudar vocês com alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090204,
					"content": "#Não, só ficamos curios{M#os}{F#as} já que você tá aqui sozinha. Falando nisso, Paimon é Paimon e {M#esse}{F#essa} é {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090205,
					"content": "#Então é {M#Sr.}{F#Srta.} {NICKNAME} e Srta. Paimon! Vocês não parecem ser da Cidade de Nasha, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090206,
					"content": "#Somos aventureir{M#os}{F#as}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "#Sim, {NICKNAME} e Paimon são super aventureir{M#os}{F#as} incríveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090211,
					"content": "Mas deve ser legal viajar com sua melhor amiga, ver o mundo junto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090212,
					"content": "É mesmo! Já fomos pra tantos lugares! E você? O que tá fazendo aqui sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090213,
					"content": "Eu tava prourando pedras bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090214,
					"content": "Ah, Paimon entendeu! Você coleciona elas, né? Você não é a única, alguns adultos também gostam muito disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090215,
					"content": "Não! Vou usar as pedras bonitas para molhar a mão de Mai para ela me sequestrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090216,
					"content": "Ah, faz sentid— espera, como é?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090217,
					"content": "Eu... não tava esperando isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "Hã? Vocês nunca ouviram falar na história do ladrão lendário Reed Miller e a princesa fada? Mas Mai me disse que era super famosa no exterior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090221,
					"content": "\"Venha, senhorita com olhos brilhantes como o luar, deixe-me roubar seu coração com essa joia que combina com seu olhar e tirar você dessa gaiola dourada...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090222,
					"content": "Não tenho certeza do que isso significa, mas... se você der a alguém uma coisa que a pessoa gosta, quer dizer que você pode sair numa aventura com ela, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090223,
					"content": "Tá longe do que isso quer dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "É-É... na verdade significa... hmmm... enfim, não é uma história pra criança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090227,
					"content": "Falando nisso, quem é essa Mai que você tá falando? Contando histórias esquisitas pra crianças... Ela não parece muito confiável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090228,
					"content": "Ela não é má! E ela tem a mesma idade que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090229,
					"content": "Ela também é uma aventureira, como vocês! Eu peguei ela se escondendo perto do acampamento, aí eu fiz ela me contar uma história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090230,
					"content": "Por alguma razão, ela parecia achar que a gente era algum tipo de culto assustador que sacrifica crianças sequestradas para a Deusa da Lua. Ela tentou agir toda calma enquanto me implorava pra não matar ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090231,
					"content": "Que tipo de mal-entendido esquisito é esse...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090232,
					"content": "Né? Não faço ideia de onde ela ouviu isso. É tão estranho. Mas já que parecia divertido, eu não corrigi ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090233,
					"content": "É exatamente por isso que você deveria corrigir ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090234,
					"content": "Enfim, em troca, ela prometeu ser minha melhor amiga e me contou um monte de histórias do mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090235,
					"content": "Meu pai e minha mãe nunca me deixam ler histórias do mundo exterior, dizendo que só descrentes gostam dessas tolices... Mas as histórias de Mai eram bem interessantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090236,
					"content": "Como o pescador que se apaixonou por uma fada, o ladrão que morreu três vezes, mas escapou da Senhora do Submundo três vezes, e a criança trocada que queria virar humana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090237,
					"content": "Tinha gente do bem, gente não tão do bem, gente bem, bem do mal. Rico ou pobre, bom ou mal... no fim, todos morrem na miséria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090238,
					"content": "Ok, seus pais tão certos... essas aí são meio erradas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "É, definitivamente não é o tipo de história que se conta pra crianças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090243,
					"content": "Mas eu não sou mais criança. Mai também disse que o mundo exterior é perigoso demais para alguém como eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090244,
					"content": "Ela nem consegue usar a bên{RUBY#[S]Kuuvahki}ção da Deusa da Lua, e ela tem praticamente a minha idade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090245,
					"content": "Mas tá de boa! Sou super inteligente mesmo. Antes de pegar ela, ela ficou falando sobre \"pedras\"... Então isso quer dizer que ela deve tá procurando por pedras bonitas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090246,
					"content": "Se eu encontrar <color=#00E1FFFF>pedras bonitas</color>, aposto que posso subornar ela facinho! Igual como Reed Miller atraiu a fada pra longe, ela vai me levar daqui, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090247,
					"content": "Dá pra parar de falar \"subornar\" assim? Você só tá dando um presente legal à sua amiga, isso é normal! Não precisa ficar parecendo que é esquisito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090248,
					"content": "Bem, vamos procurar por essa área mesmo, então se a gente encontrar algum fragmento bonito, vamos trazer para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090249,
					"content": "Uau, sério? Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090240,
					"content": "Uau... Quero ouvir mais. Pode me contar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "Ok. Por exemplo, o companheiro de Reed Miller, o \"Furão das Sombras\" que jurou nunca pisar sob o luar de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090242,
					"content": "Hã?! Agora não é hora de histórias assim! Enfim... essas não são histórias exatamente para crianças!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090225,
					"content": "Isso mesmo, foi assim que eu fisguei Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "Ei, não ensine nada estranho pra crianças! Só porque Paimon ama sua comida não quer dizer que você pode dizer que Paimon foi \"sequestrada\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090218,
					"content": "Só mais um dia em Nod-Krai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "Isso não é normal nem em Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090208,
					"content": "Na verdade... eu mando na Cidade de Nasha toda por debaixo dos panos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#Uau, sério? Que irado! Posso ser sua seguidora, então, {NICKNAME}? Como naquelas histórias épicas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090210,
					"content": "#Ei, deixa de brincadeira! Somos só aventureir{M#os}{F#as} comuns de passagem, ok?! Nada de mandar na Cidade de Nasha por debaixo de nada... pelo menos, não que Paimon saiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
