			"dialogs": [
				{
					"id": 760090601,
					"content": "Uau, minha intuição tava certa! Assim que colocamos as duas pedras junto, algo incrível aconteceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090602
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090602,
					"content": "Hã, mas as pedras que encontramos há pouco tempo desapareceram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090603,
					"content": "Oh, tá tudo bem! Eu só estava tentando encontrar esses fragmentos, assim eu poderia subornar Mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090604
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090604,
					"content": "Agora que temos toda essa nova história sobre uma pedra voadora, a pedra por si só não importa mais. E como Mai adora contar histórias, tenho certeza que ela vai estar superanimada para contar uma história sobre umas pedras antigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
