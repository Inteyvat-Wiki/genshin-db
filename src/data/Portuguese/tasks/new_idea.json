			"dialogs": [
				{
					"id": 766562001,
					"content": "#Olá, {NICKNAME} e Paimon. Graças à ajuda de vocês, terminei de fazer os ajustes no robô que encontramos anteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562002
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562002,
					"content": "Ooh, a turma toda está aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562003,
					"content": "Até agora, não encontrei nenhum novo problema, mas o que eu encontrei foi uma nova ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}! Quando encontrar os outros robôs, pode prestar atenção em qualquer comportamento especial que eles apresentarem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562005,
					"content": "\"Comportamentos\", tipo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562006,
					"content": "Bem, isso seria... como eles interagem entre si, eu acho? Ah, vai ficar bem mais evidente depois que recuperarmos um número suficiente deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562007
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562007,
					"content": "Certo... Pode deixar com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562008,
					"content": "Muito obrigada a vocês dois! Vou marcar a próxima área no seu mapa...",
