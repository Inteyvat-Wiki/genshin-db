			"dialogs": [
				{
					"id": 3560101,
					"content": "Deixe-me apresentar oficialmente a Cidade do Vento, Dandelions e da Liberdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560102,
					"content": "#Viajantes sob a proteção dos Cavaleiros de Favonius - Sejam bem-vind{F#as}{M#os} a Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560103,
					"content": "Finalmente, não precisaremos mais acampar na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560104,
					"content": "Mas as pessoas da cidade não parecem muito felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560105,
					"content": "É porque o Stormterror tem rondado a cidade ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560106,
					"content": "Tudo ficará bem desde que a Jean esteja conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560107,
					"content": "Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560108,
					"content": "Jean, a Grande Mestre Intendente dos Cavaleiros de Favonius. Protetora de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560109,
					"content": "Com a Jean ao nosso lado, com certeza até mesmo o Stormterror não será um problema para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560110,
					"content": "(Alguém parece estar impressionado...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Antes de eu levar vocês ao quartel-general dos Cavaleiros de Favonius, eu tenho um presente para {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560113,
					"content": "É uma recompensa por me ajudar a limpar o acampamento de Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560114,
					"content": "Ei! Por que eu não tenho uma recompensa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560115,
					"content": "Ah... Porque esta recompensa é inútil para você, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560116,
					"content": "Mas... Vou dar um prato tradicional de Mondstadt para você - Carne Frita com Cenoura e Mel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560117,
					"content": "Carne Frita com Cenoura e Mel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560118,
					"content": "Vamos lá, vamos em direção à <color=#00E1FFFF>parte alta</color> da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560111,
					"content": "(Espero que ela saiba de algo sobre o Arconte Anemo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
