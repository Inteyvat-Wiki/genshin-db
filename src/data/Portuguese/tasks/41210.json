			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "Albedo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100302,
					"content": "Oi, somos nós!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "Hmm? Vocês de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100304,
					"content": "Vocês se perderam no caminho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100305,
					"content": "Não, não é isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100306,
					"content": "Aceitamos o pedido da Sucrose para investigar os seus segredos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "Segredos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100309,
					"content": "Ei!! O que você está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100310,
					"content": "É uma investigação secreta! Você não devia ter falado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100311,
					"content": "Mas de qualquer forma Albedo ia saber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "Uh... Mas... Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100313,
					"content": "Você chegou na hora certa, Viajante, preciso de sua ajuda com algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100314,
					"content": "Pegue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100315,
					"content": "Hum? O que é isto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100316,
					"content": "Como você vê, é uma espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100317,
					"content": "Você sabe forjar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "Não fui eu que fiz essa espada, mas apliquei alquimia nela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100320,
					"content": "Quer experimentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100321,
					"content": "Ah? Eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "Minha pesquisa indica que esta espada tem algumas... Propriedades únicas. Só você pode usá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100323,
					"content": "Mas preciso coletar dados com bastante urgência - então, poderia usá-la em uma batalha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100324,
					"content": "Espere um segundo. Por que apenas uma única pessoa pode usar essa espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100325,
					"content": "Será que tem alguns efeitos colaterais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "Boa observação! Essa espada é muito especial, pois é uma espada amaldiçoada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100327,
					"content": "Nenhum humano comum consegue usá-la, mas você é um caso excepcional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100328,
					"content": "Hmm...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100329,
					"content": "Digamos assim, apenas você é imune à maldição dessa espada. Portanto, só você pode me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100330,
					"content": "Sem mais delongas, procure uns monstros aqui perto. Algumas coisas se aprendem apenas com prática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100318,
					"content": "Um alquimista também faz trabalho de ferreiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "Sucrose diz que você tem grandes segredos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
		{
			"id": 4121004,
			"completionStepIds": [
				4121006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121006",
							"2"
						],
						"stepId": 4121006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Homem Feroz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "Por aqui! Está com aquele moleque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "Homem Feroz"
				},
				{
					"id": 412100402,
					"content": "Entregue, ladrão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "Homem Feroz"
				},
				{
					"id": 412100403,
					"content": "Ladrões de Tesouro? Também há Ladrões de Tesouro em um lugar frio assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100404,
					"content": "Cale-se! Devolva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "Homem Feroz"
				},
				{
					"id": 412100405,
					"content": "Cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
						],
						"stepId": 4121008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "#Os Ladrões nos chamaram de {M#ladrões}{F#ladronas}, eles é que são ladrões!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100502,
					"content": "Eles realmente chegaram muito rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100503,
					"content": "Albedo, espere um momento, você é ladrão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "Claro que não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100506,
					"content": "Parece que eles estavam falando sobre essa espada. Não faço ideia do que está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100507,
					"content": "Por que você me olha assim? Juro que não roubei a espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100508,
					"content": "Um tempinho atrás, uns Ladrões de Tesouro foram presos pelos Cavaleiros de Favonius fora de Mondstadt, e os objetos ilegais também foram apreendidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100509,
					"content": "Essa espada foi um desses objetos. Mas ninguém veio buscá-la, nem sabemos de onde ela vem. Como resultado, foi deixada no armazém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100510,
					"content": "Eu reparei nela quando fui buscar outra coisa no armazém. Mas para dizer a verdade, não vi utilidade para uma espada tão antiga como essa sem ser material de alquimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100511,
					"content": "Hmm? Então você começou a alegar que essa espada é sua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100512,
					"content": "E depois? Você pegou e foi embora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100513,
					"content": "Sim! No início, eu apenas queria fazer experimentos com essa espada, mas inesperadamente descobri a sua origem verdadeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100514,
					"content": "Essa arma antiga foi feita por um ferreiro já falecido e é uma espada mágica lendária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100515,
					"content": "Uma espada mágica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100516,
					"content": "Dizem que esse ferreiro desapareceu logo depois de terminar o forjamento, bem como a espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100517,
					"content": "Segundo o meu palpite, aposto que ela foi roubada pelos Ladrões de Tesouro e permaneceu na obscuridade até agora",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100518,
					"content": "Ah? Sério? Esse ferreiro desapareceu? Que horror!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100519,
					"content": "Claro que é amaldiçoada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100520,
					"content": "Exatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100521,
					"content": "Oh, um humano poderia ter forjado essa arma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "Você sabe sobre a relação entre <color=#00E1FFFF>Durin</color> e esta montanha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>Durin</color> foi o dragão maléfico que ameaçou Mondstadt há centenas de anos atrás e que foi derrotado por <color=#00E1FFFF>Barbatos</color> e <color=#00E1FFFF>Dvalin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100524,
					"content": "Após a batalha, o Durin derrotado caiu na densa neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100525,
					"content": "A neve desta montanha nunca se derrete. A queda do Durin foi uma coincidência ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100526,
					"content": "A Paimon não acha que foi algo intencional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100527,
					"content": "Talvez este local tenha sido escolhido precisamente para que os poderes da neve selassem as toxinas corrosivas que saíam do corpo de Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100528,
					"content": "Um arconte como Barbatos já devia pensar nisso também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100529,
					"content": "Uau... O arconte Barbatos era tão inteligente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100530,
					"content": "Todavia, esses são apenas meus palpites, não são fundamentados. Mas essa Montanha Nevada tem algo relacionado a Durin, sem dúvida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100531,
					"content": "E a espada em sua mão deve conter alguns restos de Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100532,
					"content": "Restos do Dragão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100533,
					"content": "Certo! Os olhos, unhas e escamas do Dragão foram triturados em pó antes de ser usados na espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100534,
					"content": "Assim, o mal e o veneno entraram na espada, o que deu origem ao seu poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100535,
					"content": "Foi uma obra avançada. Após ter forjado essa espada, o ferreiro deve ter ficado tão feliz que decidiu experimentá-la pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100536,
					"content": "O veneno entrou no seu corpo pelo punho dessa espada assim que ele a usou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100537,
					"content": "Um humano comum não poderia resistir a esse poder, e ele infelizmente enlouqueceu. E provavelmente acabou morto em algum lugar remoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100538,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100539,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "Você já purificou as lágrimas de Dvalin com o seu poder tão raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100541,
					"content": "E esse poder deixa você imune ao veneno e ajuda a eliminar esse perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100542,
					"content": "Só você pode usar essa espada devidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100543,
					"content": "Mesmo assim, essa espada realmente é muito... Grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100544,
					"content": "Ela está brilhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100545,
					"content": "Certo! É um sinal do começo do experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100546,
					"content": "A espada ainda está fraca no momento, mas ela pode absorver energias. Dessa forma, ela se fortalece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100547,
					"content": "Em certo sentido, ela está viva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100548,
					"content": "Viajante, aventure-se com essa espada. Eu preciso que você a ajude a crescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100549,
					"content": "Acredito que em breve teremos todas as provas que precisamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412100504,
					"content": "Você roubou as coisas deles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				}
			]
		}
	]
}