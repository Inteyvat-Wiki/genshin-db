			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "Ei! É você, Sucrose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100202,
					"content": "Você também veio para uma aventura na Montanha Nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100203,
					"content": "Uau! Que susto... Por favor, não me assuste quando estou pensando na minha pesquisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100204,
					"content": "Mas você parecia estar apenas distraída, sem fazer nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100205,
					"content": "Não! Mentira! Estava pensando em dar um nome para uma nova espécie de Flor Doce. As sementes dessa flor são 4 vezes maiores que as comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100206,
					"content": "4 vezes? Essa Flor Doce deve ser muito saborosa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "Oh? Você tem interesse? Ótimo! Na próxima vez irei te mostrar as novas espécies!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100209,
					"content": "É uma pena! Porque normalmente eu trago algumas amostras comigo, mas desta vez vim para a Montanha Nevada e não as trouxe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100210,
					"content": "Ah, você não estava fazendo pesquisas na cidade? O que faz aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100211,
					"content": "Eu e Timaeus estávamos ajudando Albedo a organizar os dados dos experimentos. Timaeus acabou de ir embora, vocês não o viram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100212,
					"content": "Não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100213,
					"content": "Ele diz que não é hábil com dados, muito menos quando comparado com Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100214,
					"content": "Há coisas que Albedo percebe imediatamente, enquanto para nós levaria uma eternidade. Essa deve ser a diferença entre nosso conhecimento e experiência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100215,
					"content": "Timaeus parecia um pouco triste e foi dar uma volta. Por isso, estou sozinha fazendo o restante do trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100216,
					"content": "(Me parece que Timaeus fez isso de propósito...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "Eu decidi dar uma volta também após acabar esses trabalhos, mas inesperadamente descobri alguns dados interessantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100218,
					"content": "*Suspiro* Parece que tenho que adiar a minha busca por segredos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100219,
					"content": "Segredos? Quais segredos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100220,
					"content": "Ahn? Hmmm, vocês têm tempo agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100221,
					"content": "Sim, não temos nada para fazer no momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100222,
					"content": "Posso pedir um favor então? Na verdade, eu sempre sinto que Albedo está escondendo algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100223,
					"content": "Ele é seu professor, né? O que poderia esconder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100224,
					"content": "Sim, é meu professor! Mas realmente sinto que ele está escondendo algo... Acredito que seja alguma coisa incrível relacionada à alquimia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100225,
					"content": "Bom, parece que você tem certeza absoluta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100226,
					"content": "Porque eu e Timaeus somos adeptos da alquimia. Se fossem outros assuntos, não haveria necessidade de escondê-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100227,
					"content": "Ah... Faz sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100228,
					"content": "Então vocês podem me fazer um favor? Investiguem o que Albedo está escondendo. Estou muito curiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100229,
					"content": "#Hmmm, o que você acha, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100230,
					"content": "Se a Sucrose realmente quiser saber, podemos investigar um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "Sim! Obrigada, obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412100233,
					"content": "Bom, então vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412100231,
					"content": "Eu também gostaria de saber os segredos de Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "É algo comestível?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
			"completionStepIds": [
				4121004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
