				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "Hã? Onde está a Columbina? A Paimon não a vê em lugar nenhum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Aqui em cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540103,
					"content": "Uau! O que você está fazendo aí em cima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Venham se juntar a mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540105,
					"content": "No que estamos nos metendo desta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Você se lembra daquelas pedras que fomos coletar da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540107,
					"content": "Da última vez? Ah, você quer dizer o minério que brilha depois de absorver Kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Correto. Bem, depois disso, os kuuhenki coletaram mais algumas, e eu as separei em dois tipos — as mais escuras e as mais claras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540109,
					"content": "Mais escuras e mais claras? Mas... Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Para jogar Xadrez da Lua, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540111,
					"content": "Uh... O que é \"Xadrez da Lua\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Ah, você nunca jogou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540113,
					"content": "...Não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Entendo... Desde que vi as grades que as crianças dos Filhos da Lua Gelada desenham no chão, sempre quis experimentar. Mas nunca tive ninguém com quem jogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540115,
					"content": "Bem, quais são as regras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hm... Vai ser mais fácil se eu apenas mostrar a vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540117,
					"content": "Uau! I–Incrível! Como você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hm? Com um pouco de Kuuvahki, é claro... Vocês não conseguem fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540119,
					"content": "Uh, talvez seja melhor abaixar suas expectativas. Nem todos nós somos deusas da lua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Como quiser. Agora, este é o tabuleiro — ele representa o \"céu noturno\". E as peças que cada jogador controla representam as \"luas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540121,
					"content": "Os dois jogadores se revezam colocando suas luas no céu, e o primeiro a conseguir três luas em linha vence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540122,
					"content": "Ahhh! Então é basicamente uma versão do jogo da velha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Então, aqui em Nod-Krai chamam de \"Xadrez da Lua\", hein... Dá até um toque local...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Entendi. Bem, nesta versão, as luas giram, o que significa que nunca pode haver mais de três luas no céu ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540125,
					"content": "Então, quando o céu noturno estiver cheio, a lua que surgiu primeiro desaparecerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540126,
					"content": "Isso... na verdade faz bastante sentido... e também deixa o jogo bem mais difícil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Então, querem tentar? Vai ser a minha primeira vez jogando também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540128,
					"content": "(Parece que ela está realmente ansiosa por isso...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Hehe, parece divertido! A Paimon vai ser a juíza! Mas {M#o}{F#a} Viajante é bem espert{M#o}{F#a}, então cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Certo então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
