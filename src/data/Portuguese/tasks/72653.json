			"dialogs": [
				{
					"id": 726530101,
					"content": "Viajante, você voltou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530102,
					"content": "Acabei a minha investigação dos fragmentos que você me trouxe... Ao que parece, eles são bastante \"jovens\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530103,
					"content": "Isso indica que eles são recém-formados... Como as pegadas recém-deixadas na neve... Que normalmente são mais profundas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530104,
					"content": "E agora... Posso ser ousada e pedir a você para investigar aquelas pegadas rasas, ou seja, pegadas deixadas há mais tempo... Dessa forma, aprofundaremos a investigação ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530105,
					"content": "Quando digo \"pegadas mais rasas\", quero dizer depósitos de elemento Electro que se condensou até certo ponto perto do solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530106,
					"content": "Se conseguirmos obter amostras suficientes para fazer uma comparação, devemos ser capazes de desenhar um mapa geral de rotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530107,
					"content": "Pegadas mais rasas e profundas... um mapa de rotas... Paimon não faz ideia do que você está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726530108,
					"content": "É bastante complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "Bem, talvez a minha analogia não tenha sido a melhor, mas acho que você vai entender isso assim que estiver lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726530110,
					"content": "Bem, chega de conversa fiada. Está na hora de começar a trabalhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				}
			]
		}
	]
