			"dialogs": [
				{
					"id": 210200001,
					"content": "\"... Isso é ganância. Quando você quer tudo e não sabe quando parar. Se eu tivesse parado de procurar o tesouro enterrado e não tivesse insistido em ir para a fogueira, nunca teria ativado o mecanismo e ficado preso aqui à mercê daquele monstro horrível. Agora não posso sair.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210200002
					],
					"speakerTitle": "Carta Desgastada"
				},
				{
					"id": 210200002,
					"content": "\"Quem tiver o que é preciso para se livrar dele, faça um pedido nessa fogueira. Desejo-lhe sorte... hehe.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Carta Desgastada"
