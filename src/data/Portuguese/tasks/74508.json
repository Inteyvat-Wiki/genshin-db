			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "Após um tempo, você e Paimon chegam ao estande da Festa Fúngica Fantástica...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "Hmm! Amo esses Cogumelos macios, suaves e saltitantes! Hehe, quero continuar brincando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "E você é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Sou Enghiene, eu era a instrutora de Turenna antes dela entrar na Patrulha de Segurança e Monitoramento Especial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "Não sou nada como ela, tá me ouvindo? Nada! Não vou te bajular só porque são Forças de Nível de Chefão Super Supremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "Hmm, essa Melusine super arrogante... era a instrutora de Turenna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "Não se preocupem, Cometa Dourado e Parceira de Prata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Srta. Turenna recebeu novas ordens há pouco tempo e retornou à base da Patrulha de Segurança e Monitoramento Especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Antes de partir, ela pediu para a Srta. Enghiene para cuidar da área do evento no lugar dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "Ela ama a Festa Fúngica Fantástica e estamos sempre jogando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "Isso mesmo! Eu amo tanto jogos de tabuleiro, quanto esses Cogumelos redondos na vida real!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "Eles são macios, fofinhos, suaves, saltitantes... assim como Maralga... Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "Por que você tá babando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "Eu não vou! Só queria segurar eles e esfregar a cara neles. Haniyyah não se importou quando belisquei Pyroalegria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "Isso... É o máximo que você pode fazer! Só a gente pode segurar Cabeça de Bongô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "Que miseráveis! Eu quero os dois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "Haniyyah disse que vocês são especialistas no jogo. Que tal uma rodada contra mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "Se eu vencer, vou segurar e beliscar Cabeça de Bongô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "Grr, ela tá subestimando a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#Bora, {NICKNAME}! A gente chegou aqui quando era tudo mato, precisamos mostrar a ela o que a gente sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "#Também somos {M#os primeiros campeões}{F#as primeiras campeãs} da Copa Nilotpala!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "Não ganhamos esses títulos só para ser derrotadas facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "E as Estrelas Gêmeas do Valor Brilhante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "Não pode comer eles! Não pode comer os Cogumelos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
