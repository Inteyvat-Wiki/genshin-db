					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550703,
					"content": "Ainda bem que você não arrancou os meu cabelos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "#O que foi aquilo? Eu pensei que iríamos ser {M#devorados}{F#devoradas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "Isso com certeza deve estar relacionado com aquele cara estranho que estava conversando com o dragão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "Eu não acredito que existam dragões neste mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "#Sim, a Paimon entende por que você está preocupad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "Hum? O que é aquilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "Tem alguma coisa vermelha brilhante em cima daquela pedra grande ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Vamos dar uma olhada mais de perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550709,
					"content": "É normal falar com os dragões?",
