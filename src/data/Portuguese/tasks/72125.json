			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Se ao menos eu pudesse plantar mais flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "Ah, olá! Muito prazer... Você voltou para viver aqui? Peço desculpa, acho que não vi você antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "Voltar para morar aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Hum, as pessoas que viviam em Tatarasuna foram evacuadas para outros locais devido ao incidente da Fornalha Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Há um tempo atrás, ouvi dizer que estava tudo bem com a Fornalha Mikage e que o Tatarasuna está bem, por isso fui perguntar se podia voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Depois de receber a aprovação, eu empacotei minhas coisas e voltei a viver aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Mas... não parece haver muitas pessoas que estão dispostas a voltar como eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Mas também não tem jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Afinal, quando algo tão terrível aconteceu com a Fornalha Mikage antes, todos estavam preocupados que isso acontecesse novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "Você não está preocupada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "É claro que também estou preocupada com isso... Mas eu fiquei com saudades de casa, e não consigo parar de me preocupar com minhas flores, hehe. É por isso que decidi voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Mas as flores que plantei aqui antes estão todas murchas. É uma pena que não consigo encontrar as sementes de flores agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Este local é muito adequado para o plantio de flores. Não importa quais sementes sejam plantadas, um mar de flores pode florescer rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Eu já plantei flores do estrangeiro. Já plantei Lâmpada de Grama, Margaridas Voadoras e Dandelion de Mondstadt, assim como Flor de Seda de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Lâmpadas de Grama são lindas à noite. Precisam ser plantadas na sombra e precisam de muita água. As pontas das folhas secas devem ser cortadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Eu ouvi dizer que as Margaridas Voadoras crescem melhor nos lugares com vento. Eu acho que o vento em Inazuma não é tão grande como em Mondstadt, portanto, eu fui balançar o leque para dar mais ventos, mas eu não faço ideia de que isso chegou a ajudar ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "Os Dandelions são a menor das suas preocupações, eles podem cuidar de si sozinhos, que podem até mesmo crescer em locais estranhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "Oh, ah... Isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "E as Flores de Seda de Liyue... Tratar das suas folhas é bem complicado. Uns insetos chamados Onikabutos sempre ficam nas suas pétalas e não saem, então preciso tirar eles um por um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Mas, eu tentei plantar Qingxin aqui e fracassei. As flores Qingxin que eu plantei cresceram bem mas elas murcharam rapidamente. *Suspiro* Parece que nesse mundo não existe ainda um local mágico onde todas as flores podem florescer de forma saudável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Eu... Eu sei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Ah sim, você sabia que em Liyue tem uma flor chamada Violeta? Essa flor é bem rara, eu pedi a muitas pessoas mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "Ah! Eu sinto muito! Eu fico assim quando falo sobre flores, desculpa mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Posso dizer que você realmente gosta de flores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Só um pouquinho de pesquisa hehehe... mas agora eu não tenho nem sementes de flores, então não consigo nem plantar flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Não sou um residente daqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Eh? É isso mesmo? Achei que haveria alguém como eu que gostaria de voltar e morar aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "As pessoas que viviam em Tatarasuna foram evacuadas para outros lugares por causa do incidente da Fornalha Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250112,
					"content": "Há um tempo atrás, ouvi dizer que estava tudo bem com a Fornalha Mikage e que o Tatarasuna está bem, por isso fui perguntar se podia voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250113,
					"content": "Depois de receber a aprovação, eu empacotei minhas coisas e voltei a viver aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
					"speakerTitle": "Hanayama Kaoru"
