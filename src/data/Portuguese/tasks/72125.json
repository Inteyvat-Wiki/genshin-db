					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "Voltei por conta própria depois de ouvir que o caso da Fornalha Mikage havia sido resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
