			"dialogs": [
				{
					"id": 721250501,
					"content": "Essas sementes de flores podem ser usadas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Estas são... Sim! Claro que podem! Com essas sementes, tenho certeza que poderei plantar muitas flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Uh, umm, desculpe, por favor espere... Eu tenho que te dar algo por seus esforços...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Estas são para você, obrigada pelas sementes de flores. Tenho certeza que você verá um lindo mar de flores quando voltar no futuro!",
					"roleType": "TALK_ROLE_NPC",
