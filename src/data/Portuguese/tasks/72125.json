						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Fiquei me perguntando onde poderia encontrar sementes de flores, para plantar flores por aqui novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "As pessoas que viviam nesta ilha foram evacuadas por causa do incidente da Fornalha Mikage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
