			"trigger": {
				"objectNames": [
					"Aranakin",
					"Aragaru",
					"Aranaga",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "Aranaga, ele veio, eles estão aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590202,
					"content": "Sim, aqui, aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590203,
					"content": "#Aqui está você, Nara {NICKNAME}, e Branca Voadora. Nós três lhes damos boas-vindas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590204,
					"content": "#A lua está a caminho. Aqui, é hora de plantar flores. Estão pront{F#as}{M#os}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590205,
					"content": "#Estou pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "Sim, Paimon também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590207,
					"content": "Então... Aranakin, Aragaru, vamos começar a cerimônia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590208,
					"content": "\"Volte, volte para casa, sonhos do jardim, memórias da floresta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590209,
					"content": "\"Abrace, deixe-nos:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590210,
					"content": "\"Sonhar profundamente, felicidade eterna.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590211,
					"content": "\"Celebrar, deixe-nos:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590212,
					"content": "\"As romãs cantam, as maçãs aplaudem!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590213,
					"content": "Os Aranaras plantam as flores secas. Com a música ecoando no vento, as flores magicamente ressuscitam...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "Uau! As três flores estão vivas de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590215,
					"content": "Sim... Porque Mawtiyima é benevolente. Ele dá as memórias uma chance de ressuscitarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590216,
					"content": "Sim! Mesmo que esqueçamos você, as memórias irão... Hmm, ser tecidas nos veios das folhas e raízes, transformadas em folhas, e então em anéis das árvores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590217,
					"content": "Ou tornarão-se em vermes gordos, comidos por outros vermes, criando coisas que nutrem as plantas e nos fazem crescer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590218,
					"content": "Mas... Você ainda assim não se lembra de nós, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590219,
					"content": "Sim... Porque as memórias não pertencem a mim ou a você... As histórias de antes, nós compartilhamos com todas as gramas e árvores da floresta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590220,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "Mas, está tudo bem, pois agora somos novos amigos, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590222,
					"content": "Sim! Novos amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
