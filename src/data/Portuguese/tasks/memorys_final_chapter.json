				"points": []
			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "\"A romã canta, e a maçã aplaude...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590102,
					"content": "Olá, Sr. Khayyam! O que o traz aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "#Oh, olá. Garotinha branca e... *Suspiro* Me desculpem, garotinh{F#as}{M#os}. Minha cabeça já não está mais tão boa... E os nomes com o tempo desaparecem dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590104,
					"content": "#Pode me chamar de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "#Haha, está bem... Então vocês são {F#as}{M#os} de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590106,
					"content": "#Sim! Somos {F#as}{M#os} Javans! {F#As}{M#Os} jovens corajos{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "Hmm... Então, digam-me... Os Aranaras ainda se lembram de mim? De todos nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590108,
					"content": "Hã... Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "Eles ainda se lembram de você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "Entendo... Mas eu não os vejo, nem escuto sem sentem minha falta... É uma pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590114,
					"content": "Haha... Eu não consigo vê-los. Já estou muito velho para os ver, ou escutar suas vozes... Tudo se foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590115,
					"content": "*Cof* *Cof* Me desculpem, eu tenho que ir. Talvez um milagre seja minha única esperança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590116,
					"content": "Milagres não são compreensíveis, nem é possível buscá-los, só é possível esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590117,
					"content": "Khayyam tropeça ao sair...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "Eles não se lembram de você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "Mas... Podemos nos tornar amigos deles de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
