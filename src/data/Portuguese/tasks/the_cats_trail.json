				"points": []
			},
			"dialogs": [
				{
					"id": 220410301,
					"content": "Como está indo a sua tarefa? Você já encontrou o Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410302,
					"content": "Já encontrei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "...Espera, o quê? Ele correu de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "Vou ir pegá-lo de novo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "Não, não precisa correr atrás dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410307,
					"content": "É comigo que aquela criança ainda está zangada... Então eu lhes darei uma lição pessoalmente mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410308,
					"content": "Ah, ele já é quase suficientemente velho para ser um gato adulto. Por que ele ainda é tão teimoso? O que faríamos se isso assustasse os humanos que vêm ao santuário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410309,
					"content": "Certo. Isto é para você como agradecimento por sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410310,
					"content": "*Suspiro* Por que esta criança não pode ser tão instruída como Meshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410305,
					"content": "Bem, eu jamais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				}
			]
		}
	]
