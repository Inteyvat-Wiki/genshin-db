			"dialogs": [
				{
					"id": 220410101,
					"content": "Você chegou bem na hora. Eu já estava me preocupando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "Você se lembra daquela criança, Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410104,
					"content": "Aquele pequeno malandro saiu para brincar por perto e não voltou. Eu estou muito preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410105,
					"content": "Por favor, ajude a procurar pelo Konbumaru e traga-o de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410106,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Maravilhoso. Lembre-se, você precisa encontrar o Konbumaru e trazê-lo de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410108,
					"content": "Ele é o único que sumiu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "De fato... Talvez tenha sido a reprimenda anterior que o desagradou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410110,
					"content": "Ah, por que esta criança não dá ouvidos às instruções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410111,
					"content": "De qualquer forma, por favor, encontre Konbumaru e traga-o de volta aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
