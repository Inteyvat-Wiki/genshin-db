			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "\"Condimento\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130102,
					"content": "Como está a estátua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Aquele humano de pedra é muito habilidoso, miau miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130104,
					"content": "Está pronta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "Não, mas antes que eu percebesse, ele trouxe uma pedra muito grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130106,
					"content": "Ele então começou a bater, donk-donk-donk, enquanto murmurava coisas sobre \"broa\" e \"condimento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130107,
					"content": "Por falar nisso, gostaria de perguntar: o que é \"broa\" e \"condimento\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130108,
					"content": "Acho que você quer dizer \"patroa\" e \"pagamento\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Basicamente, como você pediu a ele para fazer algo, ele deveria receber algo em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Ah, é esse o caso? Então os humanos são específicos sobre essas coisas... Tudo bem. Vou permitir que ele coce minhas orelhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130111,
					"content": "Uh, Paimon não acha que isso é o suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Não é? Hmm, então talvez eu deva dar-lhe algo para comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130113,
					"content": "Acho que o que ele quer é Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Mora? Essas coisas não são para colocar na Caixa de Oferendas? Que estranho. E pensar que os humanos estavam preocupados com essas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130115,
					"content": "Bem, um pagamento é muito importante, na verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Mmph. Vou confiar em suas palavras por conta da ajuda que você deu até agora. Quando voltar, eu falarei com o humano de pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130117,
					"content": "No entanto, o humano de pedra não está mais fazendo donk-donk-donk. Ele parece estar carregando uma haste curta de madeira, sabe-se lá para quê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130118,
					"content": "Uma haste de madeira? Para entalhar estátuas não são usados martelo, cinzel e coisas assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Suas ferramentas quebraram ou algo parecido...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#Pelos Arcontes... Vamos lá então, {NICKNAME}, vamos procurar o Sr. Ooshima. Parece que ele precisa de alguma ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221302,
