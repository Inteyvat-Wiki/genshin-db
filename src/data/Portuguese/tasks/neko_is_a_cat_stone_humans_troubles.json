				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Maravilhoso! Com estes pedaços de ferro, são suficientes, creio eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Vou procurar um lugar adequado lá fora para montar uma fornalha e depois começarei a fazer minhas ferramentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Apenas avise a Senhora Sacerdotisa, está bem? Estarei arrumando as coisas aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
							"2"
						],
						"stepId": 7221304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miau, miau, miau. Há algum problema? Não se preocupe, eu vou preparar algo com um \"condimento\" adequado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "É \"pagamento\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Uhh, não importa. Basicamente, o humano de pedra... As ferramentas do Sr. Ooshima estão quebradas, mas nós lhe demos os materiais que ele precisa para consertá-las, então não deve haver nenhum problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Hmm? Problemas, você disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Isso é bom. Eu estou ansiosa para ver aquela pedra, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Hibiki disse que uma vez que a pedra fosse feita à semelhança de mim, alguma coisa boa poderia acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "Ah, estou cheia de expectativa! Que tipo de coisa boa pode acontecer? Talvez a Hibiki possa até voltar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "Não, não tem nenhum problema. As coisas estão indo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "Quanto vai custar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130604
					]
				},
				{
					"id": 722130604,
					"content": "Hmm? O que significa \"quanto custa\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130605
					],
					"speakerTitle": "Neko"
				}
			]
		}
	]
