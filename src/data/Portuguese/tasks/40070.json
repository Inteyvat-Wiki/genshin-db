			"trigger": {
				"objectNames": [
					"Xinyan",
					"Coração Flamejante"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "Algumas montanhas da ilha perderam sua vegetação e suas correntes d'água. Você sabe se há alguma maneira de dragá-las?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700402,
					"content": "Conheço alguém que pode ajudar com isso. Falem com meu companheiro, Coração Gélido, ele mora lá em cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Coração Flamejante"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Coração Gélido",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "Quem são vocês? E o que fazem em minha morada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400700502,
					"content": "Olá. Nós gostaríamos de saber se podemos usar seu poder para dragar as montanhas da ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700503,
					"content": "Montanhas? Ah, entendi... Vocês querem virar grandes músicos também, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400700504,
					"content": "Hã? É sobre isso então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400700505,
					"content": "Exato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400700506,
					"content": "Nesse caso, buscamos o mesmo. Apesar de minha fragilidade, me sinto obrigada a compartilhar um pouco de meu poder com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400700507,
					"content": "Plante minha pétala no ponto final da intersecção das melodias, e o que antes afundou na terra reemergirá com a música. Enquanto houver música, a vida continuará a florescer nesse mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400700508,
					"content": "...Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701002,
					"content": "Finalmente, chegou a hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701003,
					"content": "Pessoal, eu uma vez fiz um desejo de tocar com uma pessoa inesperada. E hoje, nessa ilha, encontrei minha resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701004,
					"content": "Ninguém sabe o nome ou como a pessoa que transformou essa ilha num instrumento musical tantos anos atrás se parece, mas com certeza deve ser um dos maiores músicos de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701005,
					"content": "Nunca imaginei que veria um instrumento como esse, menos ainda que o tocaria durante a maré alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701006,
					"content": "Você vai tocar rock?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "Não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701008,
					"content": "A música é um presente que se dá a uma alma amiga... Por isso, eu tocarei algo que soa melhor para um dueto com esse músico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701009,
					"content": "Não vou tocar rock hoje, mas vou mostrar algo novo para vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701010,
					"content": "...Ufa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701011,
					"content": "Que tal? Nada mal, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701012,
					"content": "Impressionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701013,
					"content": "Nunca ouvi um dueto como esse, muito interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701014,
					"content": "E tão elegante! Paimon não sabe como dizer... Foi super único!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701015,
					"content": "Uma performance com muita personalidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "Hehe, obrigada, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701018,
					"content": "Com isso, acho que meu desejo está realizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701019,
					"content": "Há mais alguma coisa que você queira fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701020,
					"content": "Não. Acho que hoje dormirei como um bebê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701021,
					"content": "Isso quer dizer que todos nós estamos livres por enquanto? Se sim, tenho uma sugestão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701022,
					"content": "Eu gostaria de retornar ao acampamento dos Fatui e ver o que está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701023,
					"content": "Oh? Então vocês também descobriram o acampamento dos Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701024,
					"content": "Espere, você também sabia disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701025,
					"content": "Claro, eu sou uma astróloga genial. Não mencionei que meu Hydroprofetizador se recuperou um pouco? Sinto o que está acontecendo aqui através da adivinhação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701026,
					"content": "Hã? Os Fatui estão aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701027,
					"content": "Sim. Eu também informei isso a Fischl quando nos separamos hoje. Se ela os encontrar, ficará escondida para evitar o perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701028,
					"content": "Entendo, então talvez devêssemos contar a todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701029,
					"content": "Você conta aos outros sobre o acampamento dos Fatui e a máquina estranha que viram no dia em que desembarcaram na ilha...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "Uma máquina estranha, e os Fatui delirantes... Vocês querem dizer que isso está relacionado as miragens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701031,
					"content": "Não posso garantir, mas acredito que possuam alguma relação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701032,
					"content": "Faz sentido. Vamos checar o acampamento então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701016,
					"content": "Uma performance com muito charme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
		{
			"id": 4007016,
			"completionStepIds": [
				4007016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
