			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Coração Gélido"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701901,
					"content": "Nós plantamos a pétala, você está sentindo algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701902,
					"content": "Hmm, sim. O sol está brilhando, o mar reluz como uma gema, as ondas acariciam as praias brancas, e os grãos de areia são puxados para o mar, e então jogados na margem de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400701903,
					"content": "... As aves marinhas estão pousando nas rochas, bicando gentilmente e fazendo sons rítmicos. Dum... Dum... Dum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400701904,
					"content": "Isto é música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701905,
					"content": "Sim, é música. Na verdade, essa ilha inteira é um instrumento musical gigante. Como você é uma artista musical, deve entender o significado de sua criação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "Coração Gélido"
				},
				{
					"id": 400701906,
					"content": "Tocar música com a maré, as ondas e a brisa é a coisa mais romântica do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701907,
					"content": "Vamos lá pessoal, é hora de vocês ouvirem minha apresentação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		}
	]
