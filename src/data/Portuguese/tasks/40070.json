			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701601,
					"content": "É estranho que em nosso caminho até aqui só vimos monstros locais, mas nenhum Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701602,
					"content": "Que estranho... Ainda há sinais do acampamento, e a máquina ainda está aqui, mas todas as pessoas desapareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701603,
					"content": "(Essa máquina deve ter algo a ver com as miragens. Está quebrada, mas talvez seja a causa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701604
					]
				},
				{
					"id": 400701604,
					"content": "(... Se a máquina pode gerar alucinações, então por que as pessoas desapareceram? Ou há algo mais acontecendo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701605
					]
				},
				{
					"id": 400701605,
					"content": "(Será que desapareceram, ou estão se escondendo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701606
					]
				},
				{
					"id": 400701606,
					"content": "Eu desisto, vou fazer a adivinhação da resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701608
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701608,
					"content": "O que é isso? Algum tipo de fluxo de energia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701609,
					"content": "Pessoal, sinto muito, mas não consigo encontrar nem um rastro dos Fatui. Meu Hydroprofetizador está turvo de novo, mas dessa vez, sinto alguma energia convergindo e tomando forma física.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701610,
					"content": "O destino é... a ilha ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701611
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701611,
					"content": "De quem será a miragem dessa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701612
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701612,
					"content": "Hmm... Vamos lá, talvez encontremos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007017,
			"completionStepIds": [
				4007017
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
