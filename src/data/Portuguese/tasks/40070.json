				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701701,
					"content": "Chegamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701702,
					"content": "Hã? Fischl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701704,
					"content": "É ela mesmo! Ei, Fischl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701705,
					"content": "Hunf, meus imprudentes retentores, vossas mercês finalmente chegaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701706,
					"content": "Oh, há quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701707,
					"content": "Não se passou tanto tempo assim, passou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701708,
					"content": "Ahem... A princesa e eu sentimos uma aura peculiar, e viemos aqui de antemão para nos reencontrarmos com todos. Não estávamos esperando vocês... Bem, o que quero dizer é, vocês chegaram antes do esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701709,
					"content": "É só Paimon, ou Oz está nervoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701710,
					"content": "A chegada do Reino da Noite Eterna é iminente, eu ainda preciso preparar a cerimônia abençoadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701711,
					"content": "Minha princesa, você quer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701712,
					"content": "Eu posso fazer isso sozinha, Oz. Se te preocupas a escuridão que paira na noite, és bem-vindo a retornar para o brilho cegante do dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701713,
					"content": "Por favor, minha Princesa, não diga isso. Sou seu leal servo, seus olhos, e jamais me separarei de ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701714,
					"content": "... Pare de olhar para mim assim! De—De qualquer forma, o momento da explicação... Ainda não chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400701715,
					"content": "Oh, minha senhorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701716,
					"content": "Sinto muito. A princesa está tendo um dia ruim... Por favor, ignorem. Com sua licença, tenho que ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400701717,
					"content": "Hã, o humor dela ainda não melhorou, mesmo após todo esse tempo separada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701718,
					"content": "Quando vi Fischl, senti que a miragem que está se formando nessa área deve ter algo a ver com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701719,
					"content": "Sim. Eu senti algo familiar quando me aproximei de minha miragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701720,
					"content": "Eu também. Embora não faça sentido, apenas senti que algo interessante estava prestes a acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701721,
					"content": "Exato. Se Fischl e Oz podem sentir algo, então nossas suspeitas estão corretas... Fischl provavelmente está agitada porque ela não quer confrontar sua miragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701722,
					"content": "Mas por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701723,
					"content": "Talvez sua miragem contenha segredos que ela não quer que os outros saibam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701724,
					"content": "Vamos primeiro descansar aqui. Quando a miragem aparecer, chegaremos na resposta desse mistério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007018,
