				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701801,
					"content": "Fizemos tudo que podíamos, mas como vamos lidar com as últimas duas montanhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400701802,
					"content": "Vamos continuar pensando, deve haver uma maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400701803,
					"content": "Após olhar com cuidado, parece que a maioria das montanhas contêm correntes d'água e vegetação em seu interior. Essas formam um sistema que conecta umas montanhas as outras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701804,
					"content": "Mas agora, como a maioria da montanha colapsou, as conexões entre a vegetação e as correntes d'água está bloqueada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400701805,
					"content": "Se pudermos dragar essas obstruções, poderemos conectar as ilhas e formar o instrumento musical gigante descrito nas notas de Albedo, e tocar música usando as ilhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400701806,
					"content": "Sim, para que eu alcance meu objetivo, temos que fazer isso... Eu gostaria de consultar a flor, ela saberá o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
			"id": 4007019,
			"completionStepIds": [
				4007019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007019",
							"2"
						],
						"stepId": 4007019,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
