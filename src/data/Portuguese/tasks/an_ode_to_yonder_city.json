			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Tudo está bem, tudo está bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090202,
					"content": "O que está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "Oh, Viajante, é você. Não houve um grande incidente na cidade mais cedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090204,
					"content": "Bom, felizmente nada de ruim aconteceu depois... E o mais importante, todos os postos de comida da cidade ainda estão abertos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090205,
					"content": "O que seria de todas aquelas iguarias que tanto gosto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090206,
					"content": "Ah, está falando da comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "Ei, não ignore a comida. A melhor forma de saber se um lugar é bom ou não é conhecer sua culinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090208,
					"content": "Ah... falar sobre isso está me dando fome de novo. Acho que vou comer alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hao"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Er'ye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Quanto mais ouço essa ópera, menos a entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090302,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "Oh, olá, Viajante. Bem, eis o problema: a Casa de Chá Heyu promoveu umas novas óperas recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090304,
					"content": "Mas elas são... Bom, são animadas, com certeza. Mas não as entendo, nem sei o motivo de os jovens gostarem tanto delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090305,
					"content": "E qual a sua opinião sobre isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Essa é uma boa pergunta. Pessoalmente, gosto muito dos clássicos. Afinal, estou acostumado a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090307,
					"content": "Mas o Porto de Liyue está mudando, e as novas óperas parecem acompanhar essa situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090308,
					"content": "*Suspiro* Mesmo assim, essas mudanças estão muito rápidas. As óperas antigas não são apresentadas há muito tempo. Me pergunto o que Rex Lapis faria... Não, não vamos falar sobre isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Er'ye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
