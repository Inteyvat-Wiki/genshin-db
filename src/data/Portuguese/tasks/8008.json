			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Senhor Minerador, nós viemos reportar o resultado da Comissão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Oh! Vocês finalmente voltaram! Eu até comecei a ficar um pouco preocupado. Por um momento eu pensei em como tinha pago um bom preço, mas lembrei que vocês são profissionais... então fiquei bastante preocupado que algo ruim pudesse ter acontecido com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "Caso tivesse acontecido algo, eu ficaria culpado pelo resto da minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "#Não se preocupe, senhor! A Paimon e {M#o}{F#a} {NICKNAME} temos muitas habilidades! Voltamos {M#são e salvos}{F#sã e salvas}, com o caso esclarecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Foi incrível! Então, o que está acontecendo debaixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Hum... hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "É como um hospício de hilichurls.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Hã? ...Hospício?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Enfim, os Hilichurls que foram lá para baixo deixaram de ser agressivos. Só os deixe em paz e eles não irão causar nenhum problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "Certo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "A última coisa que queremos fazer é nos metermos em problemas, jamais fizemos questão de atacá-los. Apenas aquilo que é brilhante e dourado que chama a nossa atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Essa é uma filosofia que a Paimon pode concordar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "...Tenho que ser sincero, eu não entendi a situação que você descreveu, mas tendo sua garantia de que tudo vai ficar bem, é o que importa. Isso significa que podemos voltar ao trabalho imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "Muito obrigado por ter investigado. Tome isto como a recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "Você não tem nada com que se preocupar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "É como um país das maravilhas, só que para os hilichurls.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Desculpa, como assim um país das maravilhas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
}