			"dialogs": [
				{
					"id": 111010701,
					"content": "Como isso é possível... Um Selo de Permissão deveria ter funcionado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111010702,
					"content": "A força maléfica nesses Hilichurls ficou ainda mais forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111010703,
					"content": "Um Selo de Permissão... Sou só eu, ou isso soa um pouco familiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Aquele que pode entrar e sair do Relevo de Jueyun quando quiser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Sim, é ele! É um emblema dos Adepti, com certeza deve conter partes do poder deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "Não é de se admirar que ele tenha conseguido assustar aqueles monstros antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "O que... Vocês estão falando? Eu não dormi bem... Portanto não estou bem disposto. É só isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111010709,
					"content": "Se você me der mais uma chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111010710,
					"content": "Hilichurls malvados foram naquela direção, será que isso pode ser sua chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "Eu... Eu me senti indisposto de repente... Deve ser porque utilizei das minhas forças divinas demasiadamente... Caso contrário, eu ia derrotar todos esses espíritos malignos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111010712,
					"content": "*Suspiro* Você é realmente o rei da vanglória, não o culpamos em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "Viajante, vamos continuar olhando, use sua Visão Elemental para procurar por mais pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "Então ele estava usando isso para exorcizar os monstros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
		},
