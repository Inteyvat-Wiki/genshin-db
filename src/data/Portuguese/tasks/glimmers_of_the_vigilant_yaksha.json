				},
				{
					"id": 111010202,
					"content": "Aqui está, e fique com o troco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111010203,
					"content": "Você é generoso, muito generoso... Obrigada por sua doação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010204,
					"content": "Esse cara é aquele mentiroso! Não imaginei que ia encontrar ele de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010205,
					"content": "É o Ladrão de Estrelas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "Ouvi agora há pouco que ele comprou um livro chamado... \"Yaksha: Os Guardiões Adepti\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010208,
					"content": "Eu não me enganei, é um livro sobre o Adeptus. Mas por que um Adeptus compraria um livro sobre si mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010209,
					"content": "Sempre pensei que ele era um pouco suspeito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "Mesmo? Você acha ele suspeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010214,
					"content": "Para que um Adeptus iria querer tanto dinheiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "Ah... Você tem razão! Normalmente os Adepti não parecem precisar de algo de alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010220,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010221,
					"content": "Parece que é necessário confirmar o conteúdo do livro, talvez possamos encontrar umas pistas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010216,
					"content": "Acho que ele é um embusteiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "Você quer dizer que ele não tem a capacidade para realizar desejos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010218,
					"content": "A máscara dele é muito feia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "Ah! Realmente é muito feia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010211,
					"content": "Narcisista, não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "O que você falou tem sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010213,
					"content": "Entretanto, esse Adeptus parece um tanto estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010206,
					"content": "Será que isso é o destino divino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
