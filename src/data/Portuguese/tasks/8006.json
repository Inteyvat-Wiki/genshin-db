					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "A vontade de Vossa Alteza tem que ser implementada! Eliminaremos qualquer ameaça a todo custo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Apóstolo do Abismo"
				},
				{
					"id": 80060610,
					"content": "Todas as maldições que atormentam nosso povo têm de ser removidas de uma vez por todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Apóstolo do Abismo"
				},
				{
					"id": 80060611,
					"content": "Você é a causa do sofrimento deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "Além da maldição, não resta nada nos Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "Diga o que quiser. Não irei a lugar nenhum, Dainsleif.",
