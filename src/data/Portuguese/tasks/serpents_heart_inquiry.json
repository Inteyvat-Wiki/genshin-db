			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "Meu nome é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490302,
					"content": "Aberaku, criador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490303,
					"content": "Hã, o que é Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490304,
					"content": "É algo impressionante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490305,
					"content": "Claro que sim! Fui eu quem organizou a construção de Helios com a determinação de toda uma nação. Só assim poderíamos resistir ao Dragão Herdeiro das Profundezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490306,
					"content": "Esse feito insuperável não poderia ter sido feito por ninguém no Reino de Byakuya, somente eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490307,
					"content": "Hã. Paimon acha que isso é bem impressionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490308,
					"content": "Mas por que uma pessoa tão importante assim estaria trancada aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490309,
					"content": "Eu... eu fui traído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490310,
					"content": "Quando o reino dos céus caiu nas profundezas, o povo foi atacado por dragões. E assim, eu — sim, eu — iniciei a construção de Helios para nos salvar de nosso destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490311,
					"content": "Mas aqueles malditos gananciosos! No momento que suas vidas não estavam mais em perigo, começaram a enganar. Eles até mesmo defenderam colocar crianças no trono. Ridículos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490312,
					"content": "Até eu me tornei alvo de seus esquemas, e me puseram na cadeia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490313,
					"content": "Malditos! Desgraçados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490314,
					"content": "Sim, você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490315,
					"content": "Eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "É você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490320,
					"content": "Só pode ser você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490321,
					"content": "Minhas roupas sagradas foram antes colocadas, mas todas elas se deterioraram com o passar dos anos, e agora não podem mais ser usadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490322,
					"content": "Mas se você puder passar no teste, lhe entregarei as oferendas com meus pensamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490323,
					"content": "Espero que você tenha... Sucesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490324,
					"content": "#Este é um assunto perigoso. Viajante, diga-me quando estiver pront{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490317,
					"content": "Paimon, acho que ele está falando com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "Não, ele claramente está olhando para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490319,
					"content": "(E com uma olhada muito intimidante).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
