			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722490201,
					"content": "In—Incrível! Talvez você seja capaz de fazer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490202,
					"content": "Por favor, lhe imploro, leve essas oferendas... Essas oferendas... Certamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490203,
					"content": "Você deve levá-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490204,
					"content": "Levá-las para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490205,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490206,
					"content": "Oh, não! Suas palavras estão ficando cada vez menos claras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490207,
					"content": "Levem-nas para o local da oferenda... Ordenar as partes de minha alma para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490208,
					"content": "Olá? Senhor Espírito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490209,
					"content": "Para eu poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490210
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490210,
					"content": "Para fazer o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490211,
					"content": "Para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490212,
					"content": "Argh, não há como entendermos esse senhor! Mas parece que devemos levar essas oferendas para algum lugar — pelo menos foi isso que Paimon entendeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490213,
					"content": "Essas oferendas estiveram aqui por muito tempo. Quem sabe se há algo de comestível por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490214,
					"content": "Melhor não comê-las, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490215
					]
				},
				{
					"id": 722490215,
					"content": "Ei! Paimon não sai por aí comendo qualquer coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490216,
					"content": "#Bem, vamos levar essas oferendas conosco, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224903,
