			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "Isso é estranho... Deve estar por aqui. Por que não consigo encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090102,
					"content": "O que você está procurando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "#Você é... Oh você é {M#o Viajante}{F#a Viajante}, certo? Já ouvi falar de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090104,
					"content": "Eu me chamou Javi, um... Um comerciante comum. Estou procurando pela Caixa dos Sonhos que enterrei aqui antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090105,
					"content": "Que nome estranho.. O que tem dentro dessa caixa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090106,
					"content": "Hmm... Se eu tivesse como expressar, seriam \"os sonhos que ainda serão realizados\" da minha infância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090107,
					"content": "Por que você faria isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Hahaha, é um jogo que eu e meus amigos costumávamos jogar quando éramos crianças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090109,
					"content": "Nós escrevíamos o sonho mais precioso que tínhamos, e depois enterrávamos aqui. Então marcávamos algum tempo para voltarmos juntos e cavar essa Caixa dos Sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090110,
					"content": "E a data que marcamos é hoje! Mas aparentemente sou o único que se lembrou dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090111,
					"content": "*Suspiro* Tudo bem se eles esqueceram... O importante é que você não esqueça seus próprios sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090112,
					"content": "Enfim, eu vim para escavar a minha caixa e poder finalizar o que comecei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090113,
					"content": "Mas eu procurei por todo lado e não encontrei nada. Será que alguém a pegou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090114,
					"content": "Você deixou alguma marca na época?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "Lembro-me que na época a enterrei ao lado de uma árvore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090119,
					"content": "Ao lado de uma árvore? Mas há muitas árvores por aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090120,
					"content": "Eu não esperava por algo assim quando era criança. Nós só deixamos uma pequena placa para marcar o local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090121,
					"content": "Faz tanto tempo que a placa desapareceu e não reconheço as árvores da área...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090122,
					"content": "Só me lembro que a caixa deve estar por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090123,
					"content": "Viajante, você pode me ajudar a procurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090124,
					"content": "E onde eu procuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "Enterrei a caixa perto de uma árvore, então... Comece cavando perto delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090126,
					"content": "Me ajude, Viajante. Eu te recompensarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090130,
					"content": "Veja como é grande esta floresta, nunca a encontrarei sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090131,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Hehe, obrigado. Vamos dividir. Eu procuro nesse lado, você naquele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090127,
					"content": "Seu sonho já foi embora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "Sim, o meu sonho saiu voando, e é por isso que estou procurando por essa caixa. Gostaria de saber qual era o meu sonho na época.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090129,
					"content": "Por favor, Viajante, me ajude. Eu pagarei uma boa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090115,
					"content": "Seu sonho se foi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Hahaha... Talvez sim. Afinal, eu sequer lembro do que escrevi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090117,
					"content": "Mas mesmo que meu sonho possa sair voando por aí, a caixa não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Javi"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "Oh não. Essa não é a minha Caixa dos Sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "Nós desenterramos uma caixa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Haha, eu também desenterrei uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "Eu até mesmo abri a Caixa dos Sonhos e encontrei uma folha de papel com o nome de Ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "Eu me lembro dela. Era a filha de Jahangir, sempre estava perto de alguma loja de comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "Ela sonhava em se tornar uma florista, e que cuidaria de muitas flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "Que coisa inesperada. Sempre pensei que Jahangir passaria a loja para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "Vamos olhar para o seu sonho primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Oh! Sim, eu quase esqueci, tenho que dar uma olhada no meu sonho primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "Vamos ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "\"Espero virar um Vanara, e viver sempre na floresta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "Então esse era meu sonho de infância? Pelos arcontes, não consigo acreditar que era isso que eu queria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "*Suspiro* Idiota, virar um Vanara não dá muito dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "Eu não vejo nada de errado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "Isso é só uma ideia infantil. Para alguém da minha idade, sonhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "Vale mais a pena pensar em como ganhar mais Mora. Assim posso dormir bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "Bem, vamos esquecer esse sonho inútil, melhor falarmos sobre Ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "Eu abri a Caixa dos Sonhos dela, preciso compensá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "Hmm... Deixe-me pensar. Já que ela queria ser uma florista, a primeira coisa que se deve saber é como plantá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "Por acaso eu tenho um vaso sobrando que posso dar para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "Viajante, você sabe como conseguir sementes de flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "Estou contando com você para conseguir as sementes, Viajante. Vamos esperar do lado da loja de Jahangir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "Por que você está fazendo isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Hahaha... Pode-se dizer que estou sendo espontâneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "Eu não posso mais realizar o meu sonho por causa dos anos que já se passaram... E o fato que não me importo mais com meu sonho também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "Mas Ami ainda é jovem, e pode tentar realizar o seu sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "Como um adulto entediante, não posso fazer muito para ajudá-la, mas esse vaso pode mostrar meu apoio e a encorajar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "Não existem sonhos melhores ou piores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "Esta é a sua \"Caixa dos Sonhos\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "Você também desenterrou uma caixa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
