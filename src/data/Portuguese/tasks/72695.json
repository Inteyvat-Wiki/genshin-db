				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#Oh, é {NICKNAME} e Paimon, chegaram na hora certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "Minha querida Grande Máquina terminou de processar os materiais que vocês coletaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "E como o resultado saiu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Bem, no final das contas, esta é uma máquina que eu criei! Claro que não houve problema algum! Me formei em Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "E, claro, ninguém mais entende os processos de fabricação melhor do que nós que somos de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "Da última vez, o problema da explosão foi causado pela fabricação acelerada e falta de ajuda para reunir os materiais necessários. Mas as coisas serão diferentes desta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "Se você diz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "Se desta vez os brinquedos explodirem novamente, direi adeus ao resto de minhas economias e de minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "Então, mesmo que não acreditem, podem pelo menos confiar na minha decisão de colocar minha vida em risco por este projeto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "Paimon nunca imaginou que seria necessária tanta determinação para fabricar brinquedos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "Bem, agora é hora de passar para a próxima etapa do processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "Por questões de segurança, deixe-me fazer uma pergunta: dos três processos, o que concluímos foi a Coleta de Matéria-Prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "Então, o próximo processo será a Coleta de Núcleos ou a Coleta de Energia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "Coleta de Núcleos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "#Parabéns... pelo seu erro. Se você fosse fazer esse processo agora, seria {M#o}{F#a} responsável por meu infortúnio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "A resposta certa é Carga Elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "Resumidamente... Esta Carga Elemental é processada sendo afetada pelos elementos enquanto você carrega o Coletor de Materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "Por exemplo, se você quiser coletar Hydro, apenas tem de levar o Coletor de Materiais a algum rio ou outra corrente d'água. Se quiser coletar Electro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "Você precisa ser atingido por um raio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "#Bem, vocês são Aventureir{M#os}{F#as}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "Acredito que vocês tenham a resistência física de um aventureiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "Oh, então você acredita na nossa resistência física...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "Para falar a verdade, entrar em contato com formas de vida elementais deve ser uma de nossas melhores opções. Durante minhas viagens anteriores em Inazuma, marquei três locais diferentes no mapa que atraem formas de vida elementais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "Honestamente, eu estava pensando em sair daqui de barco em segredo para eu mesmo encontrar essas criaturas, caso ninguém viesse me ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "Isso é muito perigoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "Bem, mas agora que vocês estão aqui, por que não me ajudam e vão a esses lugares para ver se encontram algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "Eu confio a vocês a tarefa da Carga Elemental!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "Coleta de Energia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "Haha, embora esta pareça ser a resposta certa, a verdade é que o correto é Carga Elemental, e não Coleta de Energia. Vocês não esperavam que as duas opções que eu lhes dei estivessem incorretas, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "A risada desse cara é muito irritante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
