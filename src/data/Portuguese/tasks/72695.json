						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "E então? Tudo está indo bem com o Coletor de Materiais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950302,
					"content": "Está ótimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "O Coletor de Materiais é minha obra-prima. Seja coletando matérias-primas como fizemos antes, ou armazenando energia elemental, ele pode fazer de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950304,
					"content": "Para falar a verdade, eu estava pensando um pouco sobre mudar o nome do Coletor de Materiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950305,
					"content": "Paimon acha que o nome Coletor de Materiais está bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950306,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "Mesmo? Eu pensei que esse nome poderia não fazer jus às capacidades do dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950309,
					"content": "Bem, de qualquer forma, me dê o Coletor de Materiais. Assim como antes, o processo de produção de protótipos precisa de observação, especialmente envolvendo o uso de energia elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950310,
					"content": "Provavelmente só poderemos prosseguir quando as reações elementais na Grande Máquina se estabilizarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950311,
					"content": "Bem, nessa hora, contarei com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950307,
					"content": "É um bom nome mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}