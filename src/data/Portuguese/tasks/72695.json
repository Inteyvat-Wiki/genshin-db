			"dialogs": [
				{
					"id": 726950201,
					"content": "Hmm... Os elementos no Coletor de Materiais terão que ser transferidos para a máquina após cada coleta. Então, cada ciclo de produção precisará de três viagens de coleta... Talvez seja um pouco cansativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950202,
					"content": "Deixe-me ver se posso otimizar isso de alguma forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
