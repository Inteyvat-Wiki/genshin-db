				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#Araminali está cheio, mas os baús não. Ficar de estômago vazio não é bom. Nara {NICKNAME} e Paimon devem estar morrendo de fome depois de tanto andar. Comam cogumelos, isso lhes dará força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		}
	]
