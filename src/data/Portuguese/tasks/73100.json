						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali sabe que Nara dourad{F#a}{M#o} é {F#uma boa}{M#um bom} Nara que ajudou Aranara. Então o \"Baú do Tesouro\" de Araminali é para Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
