			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "Ah, vocês voltaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "O Tio He deixou algumas informações.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Oh? Ele deixou algo para trás? Vamos, me conte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "Vocês contam para Jinwu as informações que encontraram antes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Humm... Lava preta, Pedra Lúmen e cogumelos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Hmm, que estranho, e estranho de um jeito familiar. Vamos voltar para o acampamento, talvez não seja bom ficar aqui muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
