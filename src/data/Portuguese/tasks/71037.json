				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Ufa, esse ar com certeza é familiar! Já faz muito tempo desde a última vez que desci para estas minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Tome o máximo de cuidado, Zhiqiong! O cheiro não me parece familiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "Quer dizer, não podíamos pular direto para baixo. É muito fácil se distrair em um guindaste bambo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "É simplesmente porque você passou muito tempo acima do solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Paimon não sentiu cheiro de nada... Todos vocês mineradores têm narizes tão sensíveis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha! A falta de um bom olfato pode custar a sua vida! Mas, por enquanto está tudo bem. Os pássaros ainda estão bastante animados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Olha, o Espato Lúmen cresceu até mesmo aqui. Não foi o caso da última vez que viemos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "É verdade! Vamos dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Sabe, parece que alguém está roubando o protagonismo de Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Não pensei que o Espato Lúmen apareceria tão perto da superfície. Eu sempre achava que essas coisas não poderiam aparecer em locais estruturalmente mais vulneráveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "São fragmentos daquela \"coisa\" no solo, viajando pelas veias da rocha antes de finalmente chegarem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Ei! Pare de falar bobagem. Eles eram originalmente rochas deste lugar, e é por isso que ficaram assim. Eles apenas sofreram um tipo de conversão antes de finalmente se tornarem cristais. É só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "As análises que os Qixing nos encarregaram de realizar revelam que eles são em grande parte minérios da área local, mas acabaram se transformando em cristais estranhos devido a forças externas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Ei, olha aí! Esse cristal se parece com o Condutor que você tem, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#Por que você não pega a Pedra Lúmen e dá uma olhada, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "Isso mesmo. O Condutor é feito do mesmo material que esses cristais. Essas formações reagem naturalmente uma a outra por causa dessa similaridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "Que estranho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Ei! É só isso que você tem a dizer?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "Parem de brigar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "Não estamos brigando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "Não estamos brigando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "O que quero dizer é que não importa se você está brigando ou não, Zhiqiong e eu precisamos montar um acampamento temporário à frente, então não saia daqui enquanto estamos fazendo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "Os cristais que descobrimos serão muito úteis para nossa exploração futura. Se você encontrar alguma coisa depois disso, mantenha-me informada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "#Ainda não me esqueci das minhas habilidades, então posso ajudá-l{M#o}{F#as} a processar os minérios brutos. Acredito que será bastante útil para você em suas aventuras futuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "E mais uma coisa... não briguem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Claro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "#{M#Bons meninos}{F#Boas meninas}. Eu trarei alguns doces mais tarde para vocês. De qualquer forma, se vocês encontrarem algo estranho nas proximidades, informem-me logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Ah, você se lembra do que Jinwu disse da última vez sobre o Tio He...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Eu não esqueci. E já que você está aqui, {NICKNAME}, você poderia me ajudar mais uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "O Tio He era um veterano aqui nas minas. Vários anos atrás, ele foi um dos que desapareceu quando os mineradores do Despenhadeiro foram evacuados. Ele é uma pessoa com deficiência auditiva e pode não ter ouvido os alertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "As pensões do Salão Huishan e Shenglu são bastante generosas, e sua família já providenciou seu funeral há muito tempo... Mas mesmo assim, eu ainda acredito que ele continua vivo aqui embaixo em algum lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Ele realmente era um veterano. Seja como evitar desastres na mina, escapar, ou esperar pelo resgate... Ele sabia de tudo. Também me ensinou bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "É por isso que acredito que ele deve, mesmo agora, estar vivo aqui em algum lugar... Não vou desistir de procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Vou indicar alguns lugares onde ele foi avistado antes de termos evacuado... Quem sabe, você talvez possa encontrar algumas pistas por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Quanto a mim, estarei explorando as partes mais profundas das cavernas na mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Oh, sim, não esqueçam do doce de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Você não vai com a gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Ela ainda precisa nos ajudar a desenhar alguns mapas. Os caminhos das minas subterrâneas do Despenhadeiro são intrincados e complexos, e não chegaríamos muito longe sem esses mapas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Tenha cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Eu vou ficar bem. Não é como se eu fosse novata ou algo assim. Não se preocupe comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "Que incrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
