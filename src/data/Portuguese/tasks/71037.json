			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, é você, {NICKNAME}! Você está aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu pediu uma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "É todo aquele discurso sobre segurança de novo, não é? Já estou farta de ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "Eu cresci nas minas também. O que eu não saberia sobre os perigos aqui embaixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Quanto a quaisquer coisas desconhecidas... Err, os veteranos sempre usam sua experiência para julgar se elas são perigosas ou não. E, no final, eles usam os resultados para provar suas experiências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "#Estou farta da arrogância deles. Tenho certeza que você se sente da mesma forma como {M#um}{F#uma} aventureir{M#o}{F#a} experiente, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "Uma vez, a Iris tentou convencer você a deixar de escalar a Espinha do Dragão com a velha desculpa sobre segurança. Se você tivesse parado seus passos por causa desses discursos, você teria perdido muitas aventuras incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Tudo bem, pare de tentar me convencer. Eu não quero discutir com você sobre algo tão estúpido. Podemos apenas mudar de assunto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Veja, no momento estou estudando o terreno por aqui para desenhar melhor nossos mapas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "É só que... Enquanto eu explorava antes, descobri que o caminho em frente está bloqueado por algo estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Se você pudesse tirar algumas amostras ou fotos disso, tenho certeza que tanto o Ministério dos Assuntos Civis quanto a Guilda dos Aventureiros ficariam bastante satisfeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Estou com vergonha de dizer, mas... o meu Aparelho Fotográfico quebrou enquanto descia nas minas, então só posso contar com você agora, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Além disso, existem alguns outros lugares... Aqui, e aqui. Encontrei os rastros dos Ladrões de Tesouro nesses locais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "O quê? Onde? Paimon não está entendendo nada do que você está falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Você simplesmente desenhou um monte de Xs e linhas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Hahaha, desculpe... É apenas um hábito meu. Sempre esqueço que nem todos nascem com o instinto de um cartógrafo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "Mas não tem problema, eu irei com vocês e mostrarei o caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "Podemos começar por qualquer um desses poucos locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "Nesse caso, vamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Tenha cuidado, viu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Obrigada pela preocupação! Vou manter isso em mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370510,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Bem, eu não acabei de dizer isso? Estou estudando o terreno e desenhando um mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
