			"dialogs": [
				{
					"id": 710371101,
					"content": "Tudo isso graças a você. Por favor, pegue isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371102,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "#Ah, vamos lá, não há necessidade de ser tão educad{M#o}{F#a}. Quero dizer, é o Khedive que está nos patrocinando! Oh, esperem, shh... Melhor ficarmos quiet{M#os}{F#as}, para que aquele erudito mesquinho de Sumeru não nos ouça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371104,
					"content": "*Cof* Me desculpe... Vamos procurar por Jinwu? Podemos aproveitar a experiência dela para encontrar a resposta as perguntas que apareceram no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371105,
					"content": "#Sabe, Jinwu não gosta de falar sobre isso, mas assim como você é famos{M#o}{F#a} por suas façanhas na Espinha do Dragão, ela também era uma figura famosa nas minas quando era jovem... *Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371106,
					"content": "Ouvi dizer que ela ajudou a guiar os grupos de busca dos Millelith e que eles salvaram muitas pessoas. Ainda assim, essas coisas estão no passado agora, por isso não as mencionarei muito, ou então ela ficará irritada novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371107,
					"content": "Tudo bem, não lhe prenderei mais aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
