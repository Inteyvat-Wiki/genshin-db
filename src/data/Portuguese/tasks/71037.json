			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "É aqui...Que estranho, onde está Zhiqiong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Zhiqiong, Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "*Suspiro* Aposto que ela foi a algum outro canto deste lugar para desenhar seus mapas novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Ela desenhou isso logo depois que vocês saíram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "Ela provavelmente foi explorar nas profundezas. Por favor, diga para ela para não deixar todos para trás e sair correndo sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "Se algo de ruim acontecer, seremos todos punidos por causa dela. O punho de Jinwu não tem misericórdia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "Isso soa... assustador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Que assustador...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Bem, menos conversa fiada, mais ação. Vocês podem me ajudar a montar o acampamento aqui, ou irem explorar em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Me desculpe se não sou muito simpática. Só quero ser útil para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Ah, sim, a propósito, se vocês virem algum minério bruto de Pedra Lúmen ao longo do caminho, tragam-no para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Encontrarei uma maneira de transformá-los em Condutores mais eficazes. Até onde minha experiência pode me dizer, essas coisas serão muito úteis nas minas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Zhiqiong está em perigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Ainda não. Mas se ela continuar sair correndo por aí sem me informar, estará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
