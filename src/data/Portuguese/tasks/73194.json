					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941002,
					"content": "Este homem se disfarça de um Mahamata para cometer extorsão e roubo em torno do porto do Bazar. A Cidadela de Regzar está investigando ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941003,
					"content": "Segundo relatos, ele está escondido na selva. Por favor, denuncie se você vê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
