			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Como os Mahamata não usarão mais este quadro para postar anúncios, ele é perfeito como quadro de avisos para a Taverna de Lambad. Sinta-se à vontade para deixar uma mensagem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941102,
					"content": "\"As dez caixas de vinho que eu pedi estão lá? Cheguei ontem e soube que não chegaram.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941103,
					"content": "Não é verdade! Uma loira veio aqui mais cedo alegando ser sua colega de quarto e levou tudo. Eu até lembro que vocês dois vieram juntos outro dia. Você não cometeu algum erro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941104,
					"content": "\" ... Tudo bem, eu entendo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
