			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Por favor, não carregue muita Mora em áreas lotadas como precaução contra roubo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940802,
					"content": "Se você encontrar suas propriedades roubadas, por favor, não procure ajuda dos Eremitas que patrulham nas proximidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940803,
					"content": "Porque é muito provável que eles sejam os culpados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
