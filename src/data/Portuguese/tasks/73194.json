			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Este quadro de avisos é montado pelos Mahamata para divulgar os assuntos importantes da cidade de Sumeru. Perguntas ou dúvidas sobre anúncios no quadro de avisos também podem ser postadas aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"Você já ouviu falar? Os Guardas-Florestais encontraram um palácio magnífico que surgiu do nada no norte da floresta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940202,
					"content": "\"Mas todos que foram lá foram enganados e perderam todo o dinheiro que tinham. Tudo o que restava eram suas roupas íntimas quando os Patrulheiros Florestais os encontraram.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940203,
					"content": "\"Por mais que lhes perguntassem o que havia acontecido, eles nunca responderam a nenhuma pergunta, apenas choraram. Parece bem assustador.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940204,
					"content": "\"É melhor não vagar pela floresta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Anúncios de Sumeru e do exterior serão publicados através do Akasha. É por isso que é importante que todos mantenham seu Terminal Akasha à mão, para não perder nenhuma notícia importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940302,
					"content": "Este quadro de avisos será mantido temporariamente para conveniência de forasteiros e comerciantes, bem como crianças e idosos. Ele pode ser retirado a qualquer momento, então, por favor, não dependa muito dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "A distribuição da Bênção Anahitiana deste ano já começou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940402,
					"content": "A princípio, a distribuição será realizada de acordo com as políticas e requisitos do ano passado. Detalhes de informações relevantes foram postados no Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940403,
					"content": "No caso de qualquer alteração, entre em contato com o Mahamata mais próximo com antecedência e envie uma solicitação de alteração para a Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Nos últimos dias, os casos de pessoas infectadas com \"Eleazar\" na cidade vêm aumentando. Se você tem dormência na pele, sente falta de força nos membros, pode ver escamas cinzas e pretas formando na pele, vá ao Bimarstan para receber o tratamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940502,
					"content": "Se não for tratado no tempo recomendado permitindo que sua condição piore, você poderá enfrentar sérias consequências, incluindo incapacidade. Por favor, leve este aviso a sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Um lembrete especial: Toda a indústria mercenária em Sumeru é empreendida pelos Eremitas e ninguém mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940602,
					"content": "Por favor, não confie em estranhos facilmente, de modo a evitar ser enganado por golpistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940603,
					"content": "Caso necessite do serviço de escolta, guarda ou tenha qualquer outro tipo de serviço, entre em contato com Rukh Shah, Parchamdar da Tropa dos Trinta. Você também pode postar uma comissão com a ajuda de Effendi, Oficial de Ligação da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
