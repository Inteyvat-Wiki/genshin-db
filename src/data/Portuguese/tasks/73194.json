			"dialogs": [
				{
					"id": 731941201,
					"content": "Tenha cuidado se você estiver planejando uma viagem para a floresta tropical. Meu orientador me mandou lá para colher ervas outro dia, e quase perdi minha vida para um Caracal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941202,
					"content": "\"Tive a sorte de ser resgatado por uma Guarda-Florestal próxima. Ela se apresentou como Guarda-Florestal em Treinamento, mas parecia muito experiente. Mais importante, ela me deu comida deliciosa para aliviar meu choque.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731941203,
					"content": "\"Ouvi dizer que ela é aluna do Tighnari. É como dizem — tal professor, tal aluno!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
