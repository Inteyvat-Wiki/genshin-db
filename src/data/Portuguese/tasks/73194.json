			"dialogs": [
				{
					"id": 731940901,
					"content": "Procurado: Kasim. Recompensa oferecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940902,
					"content": "Ele se autodenomina um renomado bandido que viaja pelo mundo, mas na realidade não passa de uma fraude que não está nem no ranking de poder dos Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940903,
					"content": "Muitos casos de fraude ligados a ele foram relatados recentemente. Por favor, fique atento e evite cair em seus golpes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
