			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Bimarstan é uma instalação médica dependente do Amurta que oferece assistência médica gratuita para residentes de Sumeru e residentes externos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940702,
					"content": "Os médicos do Bimarstan são licenciados pelo Darshan Amurta, diagnósticos e planos de tratamento são revisados várias vezes pelo Akasha. Fornecemos os serviços médicos mais profissionais e de máxima segurança para os residentes de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731940703,
					"content": "Por favor, não confie em médicos não identificados ou não licenciados para evitar perdas financeiras e danos irreversíveis à sua saúde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
