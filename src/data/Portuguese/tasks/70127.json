			"dialogs": [
				{
					"id": 701270101,
					"content": "\"Se você leu até aqui, creio que você é a pessoa que eu espero encontrar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270102,
					"content": "\"Perdi a conta de qual carta é essa. Até onde ela irá ser levada, e em que costa irá parar?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270103,
					"content": "\"Se tivermos a chance de nos encontrarmos, conte-me sobre as montanhas do Porto de Pedra, sobre a neve do país do Norte, ou sobre Dandelions e vinho, o que acha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270104,
					"content": "\"Posso esperar sua carta, assim como esperei antes\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garrafa à Deriva"
				}
			]
		},
		{
