			"dialogs": [
				{
					"id": 701270201,
					"content": "\"Se você leu até aqui, creio que você é a pessoa que eu espero encontrar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270202,
					"content": "\"Nós acreditávamos que a guerra era apenas algo que acontecia nas lendas e histórias de criança. Mas hoje estamos vivendo sob um grande conflito.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270203,
					"content": "\"A praia que nós costumávamos ir foi selada, mas, ainda assim, eu gostaria de enviar essa mensagem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270204,
					"content": "\"Não se preocupe, para quem já se aventurava com você, isso é fácil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701270205,
					"content": "\"Posso esperar sua carta, ainda que ela seja apenas uma frase\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garrafa à Deriva"
				}
			]
		}
	]
