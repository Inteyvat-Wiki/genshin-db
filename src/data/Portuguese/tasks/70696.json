			"dialogs": [
				{
					"id": 706960101,
					"content": "Olá, pequenino. Que surpresa agradável. Aonde suas viagens tem levado você recentemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Você conta para Miko sua experiência na Espinha do Dragão.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Ahh. Todos parecem muito adoráveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Deve ter sido uma grande aventura para eles, vindos de longe, cruzando fronteiras nacionais para se encontrarem com pessoas com interesses similares... Ah, é uma história repleta do romantismo da juventude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "A Saga da Alma Flamejante parece ter muitos fãs. Talvez seja hora de fazer outra rodada de republicação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "Com uma base de fãs tão dedicada, é justo demonstrar nossa gratidão a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Que tão algumas revistas em quadrinho gratuitas? Hmm... Vocês são um grupo bem grande, precisarei garantir que haverá o suficiente para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Estas são as primeiras edições — você não as encontrará à venda em nenhum outro lugar. Agora, cuide bem delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Eu vou compartilhá-las com o grupo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
