			"dialogs": [
				{
					"id": 706960201,
					"content": "Miko nos deu uma coleção bem generosa de quadrinhos. Como o plano é compartilhá-los com o grupo, por que não colocamos eles em algum lugar onde todos consigam ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960202,
					"content": "Vamos colocar eles perto da estante de livros no acampamento da Legião das Almas Flamejantes. Assim, vai ser mais fácil para as pessoas folhearem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960203,
					"content": "Você pega uma estante emprestada e arruma os quadrinhos da Miko nas prateleiras.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "Ótimo, está ficando bom! Agora as pessoas podem vir e escolher alguns quando estiverem livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
