			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou dirige sua tripulação para descarregar a carga, e segue vocês para o local.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Então esse é o local? Nada mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Quando você tiver tempo, venha me ajudar a testar a orientação remota dessa coisa. É exultante, garanto que você vai adorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
