			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "Perfeito, parece que está tudo pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460102,
					"content": "Se esforce, Jala! Você vai capturar todos em alguns dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460103,
					"content": "C-Capturar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "Eita! O que uma caçadora ilegal tá fazendo em Fontaine...? O tráfico de animais está dando uma fortuna esses dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460106,
					"content": "Não se Paimon puder evitar! Vamos te arrastar até o Maison Gardiennage imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460107,
					"content": "...Oh, são vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460108,
					"content": "Claro, acabei de vir do Maison Gardiennage. Precisa que te mostre o caminho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460110,
					"content": "Ótimo. Eu gosto de pessoas diretas!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "Espera, isso não está certo... Você não está nem um pouco com medo de ser presa. Talvez você faça isso direto, ou talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460114,
					"content": "Eu esteja do lado certo da lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460115,
					"content": "Mais precisamente, fui contratada pelo Maison Gardiennage para proteger o meio ambiente — como uma \"Caçadora Indomável\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460116,
					"content": "E o que estou caçando é uma espécie invasiva de peixe que chegou até as águas de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460117,
					"content": "Espécie... invasiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460118,
					"content": "Isso parece familiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "Pois é! Paimon acha que já ouvimos algo assim em Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460122,
					"content": "Não vamos nos ater ao passado. O que importa é o aqui e o agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460123,
					"content": "Essas espécies invasivas foram soltas por comerciantes que possuíam crenças estranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460124,
					"content": "Alguns dos peixes são extremamente agressivos, outros se reproduzem incrivelmente rápido e outros foram criados com um alimento especial. É um grande problema para todas as criaturas aquáticas locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460125,
					"content": "Se esses peixes invadirem os ninhos das criaturas locais e bagunçarem o ecossistema, a qualidade das águas de Fontaine pode ser afetada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460126,
					"content": "O impacto na saúde dos habitantes de Fontaine pode ser algo que apenas sentiremos no futuro. Mas, no momento, o sabor de uma bebida como Fonta poderia mudar instantaneamente, e isso será uma enxurrada de problemas para a economia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460127,
					"content": "Fonta, você ainda não pode ser destruída!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "Quanto mais você desconsidera o problema, mais sério parece. Não podemos apenas ficar sentados e não fazer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460130,
					"content": "Somos bem experientes em pegar peixes, então por que não ajudamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460131,
					"content": "Sim! Eu estava esperando você dizer isso! Boa, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460132,
					"content": "Montei uma área de armadilha, onde podemos usar iscas para atrair todos aqueles peixes invasivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460133,
					"content": "#É hora de botar para quebrar, Cavaleir{F#a}{M#o} Honorável e Ajudante Branca! Estarei torcendo por vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460134,
					"content": "É só a Paimon... ou ela nos conhece muito bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460128,
					"content": "Eu nem bebo Fonta, mas compreendo a importância.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "Como é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "A memória de Paimon está meio bagunçada... já ouvimos algo assim em Mondstadt, um tempão atrás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460112,
					"content": "Talvez... houve um mal-entendido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "Verdade. Eu não estou nem um pouco com medo de ser preso. Talvez faça isso direto, ou talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460104,
					"content": "Uma c-caçadora ilegal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}