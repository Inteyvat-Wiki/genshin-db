	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "Ahh, ahh... Paimon está exausta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "Se por acaso não tivéssemos visto a Câmara de Jade sobrevoando assim que saímos da Casa Dourada, realmente não saberíamos para onde ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "Ufa, conseguimos chegar a tempo? O Deus do Vórtice ainda está no mar? Ele não destruiu Liyue, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "O qu-O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "Ei... Espera aí! É o Adeptus! O que você está fazendo na Câmara de Jade? Paimon pensou que você estava indo contra os Qixing... A luta acabou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Diante de uma calamidade de tal magnitude, os Adepti e Qixing concordaram em colocar suas diferenças de lado por enquanto e unirem-se contra o inimigo em comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "Hunf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Escultor da Lua"
				},
				{
					"id": 10240208,
					"content": "Oooh, entendi... Então como você pretende defender Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Uau... Só de ver o Deus do Vórtice causa borboletas na barriga de Paimon, mesmo daqui de longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "Não é apenas você, os novos recrutas dos Millelith não conseguem nem mesmo ficar parados sem tremer agora. A visão assustadora de um deus antigo parece ser demais para os mortais comuns lidarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "...Por conta disso que precisamos parar aquele monstro antes que ele se aproxime do Porto de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "Então a Guerra dos Arcontes foi travada há dois mil anos atrás contra inimigos como aquela coisa? Agora isso é bem assustador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Então, será que o poder dos Qixing, Millelith e dos Adepti juntos ser suficiente para deter aquele deus no mar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Já discutimos sobre isso juntos, e honestamente... É improvável que apenas nós possamos impedir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "O quê!? M-Mas todos vocês deveriam ser os guardiões de Liyue. Deve ter um jeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Só existe uma forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 10240218,
					"content": "Ei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "Os Qixing uma vez pesquisaram a Balista Guizhong quando este conhecimento os interessava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 10240220,
					"content": "E coincidentemente, o construtor desta Balista Guizhong está bem aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 10240221,
					"content": "O que vocês mortais sequer poderiam aprender sobre os mecanismos dos Adepti? Seria preciso apenas algumas modificações na torreta da balestra, por mim mesmo, que poderei transformá-la em uma arma além da sua imaginação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 10240222,
					"content": "Heh, acredito que essa seja uma das bençãos dos Adepti que deveríamos ser gratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "Seja como for, usaremos a Balista Guizhong atualizada para lutar contra esse deus. Todos os Adepti aqui devem emprestar sua força para manuseá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "Não temos um momento a perder, nossa batalha é agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 102408,
