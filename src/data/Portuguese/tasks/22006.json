			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "Muito obrigada, Viajante. Que susto! Os Ladrões de Tesouro estão cada vez mais selvagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "O meu nome é Soraya, sou uma acadêmica-visitante, estou aqui fazendo uma pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Alguns dias atrás, eu segui umas pistas para uma ruína, onde eu encontrei um prato de jade que contava a história da Guerra dos Arcontes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Os Ladrões de Tesouro me assaltaram assim que saí da ruína. Eu tentei escapar, mas não consegui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Eu e o prato de jade estaríamos em perigo sem a sua ajuda",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Você também é uma acadêmica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "\"Também\"? Quer dizer, tem outros acadêmicos que estão fazendo pesquisas aqui? Posso saber o nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er? ...Espere. Quando os Ladrões de Tesouro estavam me assaltando, ouvi alguém dizendo \"Não pode deixar a Bao'er ocupar tudo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "Que coincidência! Você pode me dizer mais sobre esta Bao'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Resumindo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "Os lugares que a Bao'er lhe indicou são os mesmos que eu estava procurando. Talvez esta coincidência não seja uma mera coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Se ela for uma dos Ladrões de Tesouro, supostamente já fui o alvo por muito tempo. Eles queriam obter o tesouro diretamente através de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Aquela Bao'er queria todo o tesouro, então foi adiante. Mas esta zona é tão grande para uma pessoa, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "Então parece que ela te usou, viajante. Talvez ela já estivesse de olho neste lugar há muito tempo, só que eu e os companheiros deles chegaram antes de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Não se preocupe. É apenas o meu palpite. Mas o nome de \"Bao'er\" me parece estranho, pode ser um nome falso ou um nome de código.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "Viajante, você pode entretê-la mais um pouco? De qualquer forma, o prato de jade não pode ficar nas mãos erradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Muito obrigada, mas talvez ela suspeite se você voltar com as mãos vazias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "Eu tenho uma coisinha, e você pode levar de volta para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Quase não dá para ela ter lucro. Mas espero que seja o suficiente para evitar suspeitas, por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Bom! Então. volte logo! Mesmo que você tenha vencido os companheiros dela, ela não deve saber desse assunto agora, já que ela trabalha sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Oh! Se ela pedir de novo para ajudar a procurar algo, e você o encontrar, pode levá-lo para mim. Eu costumo ficar no Albergue Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "Talvez eu não seja muito boa em muitas coisas, mas se eu puder proteger uma relíquia histórica, tentarei o meu melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Ela vai suspeitar se você voltar de mãos vazias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "Hum... Tem razão. Eu tenho uma coisinha, e você pode levar de volta para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Quase não dá para ela ter lucro. Mas espero que seja o suficiente para evitar suspeitas, por enquanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
