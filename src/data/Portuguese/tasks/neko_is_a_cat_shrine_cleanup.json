					"nextDialogs": [
						721640204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640204,
					"content": "Este santuário está cada vez melhor. A caixa foi reparada, e o próprio santuário está limpo. Sim, mais pessoas certamente virão para fazer orações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640205,
					"content": "Miau, miau... Devemos devolver este santuário à sua antiga glória, sim... Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640206,
					"content": "Vamos parar aqui. Obrigada por sua ajuda até agora... miau, miau...",
