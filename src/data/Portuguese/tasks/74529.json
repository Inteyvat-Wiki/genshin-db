			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#Oh, bom. Você está aqui, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Há quanto tempo, Citlali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Oh, por favor, eu saio para caminhar de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "E de qualquer forma, minhas adivinhações de ontem à noite previram que coisas boas aconteceriam comigo se eu saísse de casa hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "Se isso não bate com o que adivinhei, não sei o que mais seria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Vamos deixar essa sua adivinhação em dobro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Bem, não é que você não possa... é só que... eu virei a noite dois dias atrás para terminar o volume mais recente de uma Light Novel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "Então, olha aqui pra mim rapidinho. Eu tô com uma cara boa? As olheiras já devem ter desaparecido, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "Estão como sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Sério? Não tente me enganar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Só pra deixar claro, eu vou ficar com todas que não saírem boas. Você só vai ficar com o que presta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "Você está radiante como sempre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Posso tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "E que surpresa, você não está dormindo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
