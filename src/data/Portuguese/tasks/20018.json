			"dialogs": [
				{
					"id": 200180401,
					"content": "Pfff... Obrigado por estar por perto, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180402,
					"content": "Mas depois de tudo isto, já não sei como eu posso reparar o carrinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180403,
					"content": "Há danos por toda parte... Acho que vou ter que consertá-lo da melhor maneira possível, o que quer que faça, não será uma solução permanente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180404,
					"content": "Deixa para lá, temos que primeiro levar o carrinho para a cidade, e posso pensar o próximo passo quando estivermos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180405,
					"content": "Eu pensei que havia alguma corda no carrinho... Ah, eles devem ter fugido com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180406,
					"content": "Viajante, por que você não dá uma olhada na floresta ali? Se tiver uma <color=#00E1FFFF>corda</color> por ali seria perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar Aterrorizado"
				}
			]
		},
