				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "Muito obrigado, Viajante. Ugh, sabia que terminaria por arruinar tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180102,
					"content": "Se eu não consigo nem pegar um carrinho de vinho de A a B sem ter problemas... No que será que sou bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180103,
					"content": "Eu serei demitido do Vinhedo se eu não conseguir agir em conjunto... Ou seja, se o Sr. Connor já não estiver comigo. Ugh, aposto que o Sr. Elzer redigiu minha carta de demissão enquanto falava... Não tenho esperanças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180104,
					"content": "Ei... calma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "Ugh, estou ferrado, eu ainda preciso levar este carrinho ao destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Magar Aterrorizado"
				},
				{
					"id": 200180106,
					"content": "O carrinho também foi destruído... Viajante, posso pedir um favor de buscar alguns materiais? Basta uma <color=#00E1FFFF>Tábua Resistente</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magar Aterrorizado"
				}
			]
		},
