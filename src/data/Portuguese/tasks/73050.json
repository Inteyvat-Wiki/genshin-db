			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "#Festival Utsava... Sentimento de nostalgia... hein? É a Branca Voadora... e {M#o}{F#a} Nara dourad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "#É amig{M#o}{F#a} Nara, amig{M#o}{F#a} d{M#o}{F#a} amig{M#o}{F#a} Nara. Espero que vocês se divirtam no Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "#{M#O}{F#A} amig{M#o}{F#a} de {M#um}{F#uma} amig{M#o}{F#a} também é noss{M#o}{F#a} amig{M#o}{F#a}! Nara durad{M#o}{F#a} e Branca Voadora são amig{M#os}{F#as} de Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
