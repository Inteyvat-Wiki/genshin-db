			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} e Paimon! Não se preocupem. Os bandidos que deixam Vanarana doente se foram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Obrigado, Nara {NICKNAME} e Paimon por ajudar Ararycan a proteger Vanarana. Ararycan tem flores para Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "#Levem as flores, amig{M#os}{F#as} de Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
