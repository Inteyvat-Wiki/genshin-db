			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#Nara {NICKNAME} e Paimon! Graças à vossa ajuda, a Máquina Varuna agora está em boas condições, assim como o Reino Ashavan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500102,
					"content": "Todos os Aranaras voltaram a Vanarana para a celebração do Festival Utsava, como pássaros voltando para seus ninhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500103,
					"content": "A chuva furiosa torna-se suave novamente. E Aranakula finalmente consegue cuidar do jardim, cultivando Viparyas, Viparyas felizes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500104,
					"content": "Viparyas felizes fazem lanternas felizes, lanternas felizes iluminam um feliz Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500105,
					"content": "#Nara {NICKNAME} e Paimon, o jardim está ótimo agora, e o Festival Utsava foi uma explosão. Obrigado por vossa ajuda em curar a Máquina Varuna e trazer Aranakula de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500106,
					"content": "Isso é bom! Hi Hi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730500107,
					"content": "#Falando nisso... estou bastante curios{M#o}{F#a} sobre uma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "Por que Nara Varuna se chama Nara Varuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "#Bem, porque {M#aquele}{F#aquela} Nara nos ajudou a curar a Máquina Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500110,
					"content": "#Qual é o nome {M#dele}{F#dela}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "#Hmm... não sei, Nara Varuna, {M#ela}{F#ele} nunca disse o nome del{M#a}{F#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#Nara {NICKNAME} também ajudou muito, el{M#e}{F#a} é {M#um}{F#uma} Nara corajos{M#o}{F#a} que superou muitas dificuldades. Estamos juntos no Festival Utsava, e foi um prazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500115,
					"content": "#Temos algo para Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500116,
					"content": "É algo que expressa o agradecimento dos Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500117,
					"content": "#Nara {NICKNAME} vai adorar, assim como Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500118,
					"content": "#As flores de Aranara são para {M#os}{F#as} corajos{M#os}{F#as} Nara e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500119,
					"content": "#Arakara também tem uma flor. Não é Viparya, mas é para Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500120,
					"content": "#Nara {NICKNAME}, Paimon, obrigado por tudo que vocês fizeram por Vanarana. Aranara nunca esquecerá noss{M#os}{F#as} amig{M#os}{F#as}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500113,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
