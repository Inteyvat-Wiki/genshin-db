				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270201,
					"content": "#Eu quero crescer o mais rápido possível para então me tornar um aventureiro como você, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
		{
			"id": 7222703,
			"completionStepIds": [
				7222705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7222705",
							"2"
						],
						"stepId": 7222705,
						"stateName": "QUEST_STATE_UNFINISHED"
