					"Temach"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750875101,
					"content": "Temos alguns Desafios de Voo por aqui, os detalhes estão todos escritos no quadro de avisos. Se estiver interessado, sinta-se à vontade para tentar, claro, haverá recompensas correspondentes também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875102,
					"content": "Sobre a Escola de Voo Pakpaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "Na verdade, eu também não sei por que tem esse nome. Falando em Pakpaka... você já ouviu a história de Kuntur e do feiticeiro maléfico Rumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875106,
					"content": "Os guerreiros da tribo perderam para o feiticeiro maléfico Rumi e foram transformados em Pakpakas... Não parece algo muito bom, né? Talvez Pakpakas realmente voem muito rápido, quem sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875103,
					"content": "Sobre Lamizana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "Haha... Ele é habilidoso, mas não é muito bom em ensinar. Como adversário numa corrida de voo... até que dá pra aceitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875108,
					"content": "Quem viria aqui se não fosse porque não voa bem? Se for muito exigente agora... bom, já aconteceu antes, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875109,
					"content": "Então agora a abordagem mudou para focar mais em encorajamento. Acreditamos que elogiando mais, as pessoas também podem melhorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875104,
					"content": "Até mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "Até logo, e sinta-se à vontade para voltar sempre que quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
