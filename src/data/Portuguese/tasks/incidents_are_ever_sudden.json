			"dialogs": [
				{
					"id": 750790301,
					"content": "#Bem-vindos... Hmm, parece que uma de vocês já sabe voar. Então, é ess{F#a}{M#e} jovem que deseja aprender como voar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "Eu já tenho uma Licença de Planagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "Licença de Planagem? Bem, essa é nova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "Aqui, nosso objetivo é que os Saurianos e as pessoas melhorem juntos. O seu parceiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "Rrah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "... Hmm, lamento, pequenino, mas duvido que a Escola de Voo Pakpaka seja o lugar para você mostrar suas habilidades. A culpa não é sua, não leve isso pro lado pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ainda é jovem e tem muito potencial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "Não há como o potencial de voo de um Tepetlissauro ser igual ao de um Qucussauro ou Iktomissauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "Enfim, jovem, se tiver interesse no nosso treinamento de voo, posso recomendar nossa pista de treinamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Você precisará esquivar dos obstáculos e se mover rapidamente para montar num Qucussauro. Você vai saber quão bom é depois de tentar na pista de treinamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "Para falar a verdade, trabalhamos duro para promovê-la. Temos os prêmios prontos, as corridas organizadas. Se você passar, pode pegar seu prêmio com Lamizana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "O que você pode me ensinar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
