						],
						"pointId": 8791
					},
					{
						"sceneId": 3,
						"position": [
							-1789.631,
							134.809,
							9749.671
						],
						"pointId": 8792
					},
					{
						"sceneId": 3,
						"position": [
							-1789.85,
