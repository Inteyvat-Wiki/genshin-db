				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paran"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Desculpe, Srta. Quilla. Garef Uivo te machucou? Esse tipo de entusiasmo para com estranhos não é o comum vindo dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750791802,
					"content": "Haha, estou bem. Adoro interagir com animais. Na verdade, o afeto me deixa feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791803,
					"content": "A propósito, Hawka está com muitas saudades suas. Quando ele ouviu que eu viria para cá em breve, ele me pediu para perguntar como você estava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791804,
					"content": "...Tio Hawka? Por que ele se importaria comigo? Urg, desculpe, tivemos alguns desentendimentos, mas não valem a pena ser mencionados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paran"
				}
			]
		},
		{
			"id": 7507919,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_STATE_NOT_EQUAL",
						"rawParams": [
							"7507909",
							"3"
						],
						"stepId": 7507909,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lliwa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791901,
					"content": "Que chatice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "Bem, eu tenho um irmão mais novo que é bem mais novo do que eu. Talvez seja por estar na sua fase rebelde, mas ele não se dá bem com ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791904,
					"content": "Uh, eu só vou estar te dando mais problemas contando sobre isso. As coisas provavelmente vão ficar melhor quando ele crescer, é!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791905,
					"content": "Desculpe pelo incômodo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "Não foi nada, te vejo por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				}
			]
		},
		{
			"id": 7507920,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
