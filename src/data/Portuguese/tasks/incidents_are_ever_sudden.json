			"dialogs": [
				{
					"id": 750791501,
					"content": "Parabéns por concluir o desafio! Você pode obter seu prêmio com Lamizana. Ele está por perto em algum lugar visível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
