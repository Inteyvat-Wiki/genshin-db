			"dialogs": [
				{
					"id": 750790701,
					"content": "Como seu superior, seu irmão mais velho, deixe eu ensinar para você como se mesclar e se tornar popular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Obrigado, mas não é necessário. E você não é meu irmão mais velho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Falando nisso, você pode parar de dar bolachas para Oberon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Rawr... Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "Ei, escute aqui, peste, se não fosse pela sua irmã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Com licença, estou aqui para pegar meu prêmio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "Rawr! Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "Ah, um convidado raro. Não vemos Tepetlissauros pequenos todo dia aqui. E combinado a isso... Bem, você tem mesmo companheiros de raças diferentes, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#Raças...?! Paimon e {REALNAME[ID(2)|SHOWHOST(true)]} são completamente diferentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "Rrroo? Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Hã? Não, bem, nós dois somos companheiros de {NICKNAME}, claro, mas não somos exatamente iguais. Paimon não tá dizendo que um é melhor ou pior, então não fique triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "A verdade machuca mais quando é dita sem intenção...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#Ei, você sabe que não é isso que Paimon tá dizendo, então não tente deixar as coisas mais complicadas. {REALNAME[ID(2)|SHOWHOST(true)]} é um amigão nosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#Você é um grande companheiro nosso, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Rroo? Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Hehe, Paimon sabia que você ia entender, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "Esse é um entendimento tácito invejável. Suas roupas deixam bem claro que vocês não são daqui, mas a confiança e amizade entre vocês e esse Tepetlissauro são profundas. Qual é o segredo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Assim, não vou medir minhas palavras. Taruka e o Qucussauro dele são parceiros, mas eles não se dão muito bem. Se vocês realmente sabem algum segredo, eu adoraria que ele aprendesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Vamos voltar ao assunto... Onde estão os prêmios deles? Não me diga que não estão prontos ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Claro que estão prontos! Tão prontos quanto você está para mudar de assunto. Vamos falar sobre isso mais tarde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "#Faremos uma corrida no ar em breve. Se você estiver interessad{M#o}{F#a}, não perca essa chance de assistir à minha incrível apresentação! Mas agora tenho outros assuntos a resolver, então, estou de saída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
