			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "Não toque nisso. É um prêmio. Se tiver interesse neles, complete a pista de treino que Temach preparou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507907",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507907"
						],
						"stepId": 7507907
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamizana",
					"Taruka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Hehe, você realmente devia fazer algo sobre esse seu temperamento ruim. Estou dizendo isso pro seu bem. Você já tem a idade suficiente para aprender a ser mais sensível, pelo seu próprio bem, mesmo que não seja para o da sua irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791702,
					"content": "Rawr! Raawwrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750791703,
					"content": "Viu? Ele concorda comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791704,
					"content": "Mesmo se um de nós não tivesse noção, não seria eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750791705,
					"content": "Ei! Seu pirralho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507909"
						],
						"stepId": 7507909
