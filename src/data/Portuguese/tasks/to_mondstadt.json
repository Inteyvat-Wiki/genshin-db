			"dialogs": [
				{
					"id": 105010301,
					"content": "Não tem necessidade de investir todo esse esforço em mim, não estou com muita fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "Mona"
				},
				{
