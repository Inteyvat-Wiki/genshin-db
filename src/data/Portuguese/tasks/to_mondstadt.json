						105011102
					]
				},
				{
					"id": 105011102,
					"content": "Este é um dos favoritos de nossos clientes habituais. Brotos de bambu, carne e presunto são cozidos juntos, criando uma sopa com um sabor rico.",
					"roleType": "TALK_ROLE_NPC",
