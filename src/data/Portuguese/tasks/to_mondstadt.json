			"dialogs": [
				{
					"id": 105011501,
					"content": "E-Este aroma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011502,
						105011504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011502,
					"content": "Algo para acompanhar seu macarrão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011503
					]
				},
				{
					"id": 105011503,
					"content": "Nunca pensei que fosse ser tão luxuoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011506,
					"content": "#Muito bem. Como {M#meu}{F#minha} discípul{M#o}{F#a} investiu tanto tempo e esforço nisso, eu devo - com grande dificuldade - aceitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011507,
					"content": "... Ooh! é delicioso! É a coisa mais deliciosa que eu comi recentemente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "#Ah, uh... Digo... Não sabia que {M#o meu}{F#a minha} discípul{M#o}{F#a} era tão talentos{M#o}{F#a}. Como sua mestra, sinto-me muito confortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "Desde que você esteja comendo uma refeição completa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011511,
					"content": "Vejo que não é nenhuma vanglória chamá-los de iguarias de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Suponho que não foi demais gastar toda esta Mora neles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Ah, não é nada. Nada mesmo. Agora que já comemos e bebemos nossa parte, deveríamos ir embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Se continuarmos ao norte daqui, devemos chegar no <color=#00E1FFFF>Portal de Pedra</color>, e de lá, estaremos dentro dos perímetros de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011515,
					"content": "Quais são os mistérios profundos dos quais iremos adquirir conhecimento? Estou ansiosa por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011510,
					"content": "Você diz isso, mas está claramente apreciando a refeição.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011504,
					"content": "Seu pedido especial, madame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011505
					]
				},
				{
					"id": 105011505,
					"content": "U... Uau! É incrível...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				}
			]
