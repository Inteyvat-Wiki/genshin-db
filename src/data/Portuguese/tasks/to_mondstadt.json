			},
			"dialogs": [
				{
					"id": 105011201,
					"content": "Então vamos pedir isso tudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011202
					]
				},
				{
					"id": 105011202,
					"content": "T-Todos? Mas só temos três... Não, duas pessoas e meia. É muita comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011203,
					"content": "Não é assim que se conta! Além disso, Paimon ainda nem pediu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011204,
					"content": "Peixe Esquilo, Frango de Pimenta de Jueyun e Ensopado de Gemas, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011205,
					"content": "Claro. Mais alguma coisa que você gostaria de pedir, senhora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011206,
					"content": "E-Eu gostaria apenas de perguntar, quanto custam os pratos que já pedimos no total?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011207,
					"content": "Mais ou menos vinte mil Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011208,
					"content": "Então... Uh, e-eu quero apenas um macarrão vegetariano, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "Muito bem. Uma tigela de macarrão vegetariano, não é mesmo? Por favor, espere um momento, nós o serviremos em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011210,
					"content": "Paimon tem pensado em uma coisa desde que começamos a comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011211,
					"content": "Por que ela só pediu um macarrão vegetariano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "Será que é... Porque ela na verdade não tem dinheiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011213,
					"content": "Eu ouvi isso! Eu disse que era por minha conta. Como eu poderia ser abalada por algo tão mundano como Mora!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "A mente de um astrólogo está voltada para o estudo das estrelas. Ser tão facilmente perturbado por tais questões banais dificultaria meu julgamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Especialmente o ato de se gratificar demais usando Mora. É muito vulgar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "*Estômago roncando*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "...E perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "Então não comer os pratos que pedimos também faz parte do orgulho de um astrólogo? Paimon não entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "Mas é um pouco ruim que só nós tenhamos nos alimentado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
					"content": "Deixe-me preparar algo para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "Oh, sim! Podemos fazer isso! Apenas nos dê um minuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
