					}
				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "Ei, vocês viram aqui? Eu nem sei o que aconteceu, mas um segundo que olhei para outro lado, aquela rocha gigante saiu voando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pakani"
				},
				{
					"id": 760100602,
					"content": "Você explica o que aconteceu antes...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "#Minha nossa! Não faço ideia do que nada disso significa, mas se você consegue realizar algo incrível assim, você deve ser abençoad{M#o}{F#a} pela Dama da{RUBY#[S]Kuutar} Lua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pakani"
				},
				{
					"id": 760100604,
					"content": "Que a Deusa da Lua nos abençoe, que a Deusa da Lua nos abençoe! Agora posso pescar aqui quanto meu coração desejar, contanto que aquele bardo irritante não volte cantando com o bicho dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pakani"
				},
				{
					"id": 760100605,
					"content": "Como prometido, aqui está sua recompensa. Embora eu não tenha pegado nenhum peixe recentemente, fisguei todo tipo de coisa, algumas devem valer bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pakani"
				},
				{
					"id": 760100606,
					"content": "Não que Mora tenha muita utilidade pela Ilha Hiisi mesmo, então é tudo seu. Obrigado pela sua ajuda, agora me deixe pescar em paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pakani"
				}
			]
		}
	]
