			"dialogs": [
				{
					"id": 200340401,
					"content": "Viajante, por favor, cuide da Anna. Ela está eufórica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340402,
					"content": "Você não quer que ela seja uma aventureira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
				{
					"id": 200340403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340404,
					"content": "Eu respeito o sonho da minha irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340405,
					"content": "Ela conseguiu se recuperar de sua doença, e agora tem finalmente a oportunidade de perseguir seus sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340406,
					"content": "Como seu irmão, eu... vou apoiá-la incondicionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200340407,
					"content": "É isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
