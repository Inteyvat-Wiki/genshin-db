			"dialogs": [
				{
					"id": 200340301,
					"content": "Bennett continua sendo sempre muito confiável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340302,
					"content": "E Fischl... as palavras dela continuam incríveis como sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340303,
					"content": "Sobre Bennett...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "O que acho do Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340305,
					"content": "Quando entrei pela primeira vez na Guilda, ele me respondeu várias perguntas e me ajudou muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340306,
					"content": "Mas ouvi dizer que ele tem uma má sorte bem peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340307,
					"content": "Isso simplesmente não é justo. Ele é uma pessoa tão legal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340313,
					"content": "Bem, acho que terminamos a comissão de qualquer forma. Agradeço, Viajante. Voltaremos para reportar para a Guilda agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340314,
					"content": "Mesmo assim, por que eu peguei a escolta de balões de transporte vários dias seguidos? A Guilda não tem nenhuma outra comissão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340308,
					"content": "Sobre Fischl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Fischl? Bem, uhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340310,
					"content": "E-Ela também é muito legal! Seu uso do arco é incrível, e ela já completou várias comissões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340311,
					"content": "Eu só não entendo as coisas que ela fala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340312,
					"content": "Mas ela ainda é uma aventureira experiente. E-Espera, não, ela é uma investigadora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
