					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#Olá, {NICKNAME}! E olá amiga fadinha voadora {M#do}{F#da} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750602,
					"content": "Olá para você, Pessoa Esquecida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750603,
					"content": "Paimon! É! Paimon! Não esqueça disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750604,
					"content": "Eu sei, Paimonzinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750605,
					"content": "...Espere, você estava só brincando com Paimon!? Aonde foram seus modos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750606,
					"content": "#Sabe de uma coisa, {NICKNAME}? Só dê logo os cogumelos estranhos pra ele. Paimon não vai falar com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750607,
					"content": "Isso é suficiente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
