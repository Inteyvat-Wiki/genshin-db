			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#Nos encontramos de novo, {NICKNAME}, e sua, uh, erm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Gostaria de perguntar, por quanto você venderia essa coisinha voadora? Achei ela muito interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Você está bem...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "Ele claramente não está bem! Ele está tendo aquela tal de amnésia de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "O que você está falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "Pff, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahahahahaha, cof. Hahahahaha! Vocês... Vocês deveriam ter visto a cara de vocês! Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Estou morrendo... Estou sem ar... D-desculpa... Isso... Hahahaha, essa é minha \"piada\" favorita, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Não tem graça nenhuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Eu temo que você não vá entender a piada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "Cof, muito bem, muito bem, sem mais piadas. Desculpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "A Paimon achou que você era uma pessoa séria, já que é um Aventureiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Hehe. Não tenha um estereótipo desses. A Guilda de Aventureiros é um lugar que reúne pessoas peculiares, e eu, posso ser considerado uma pessoa mais comum entre elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "A Paimon não concorda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Muito obrigado pelos cogumelos, mas não parece que há algum efeito evidente deles ainda. Talvez seja necessário um uso de longo prazo para serem eficazes, ou talvez sequer tenham propriedades medicinais... De qualquer forma, seu gosto é ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Mas não posso comer todos eles, já que tenho que deixar alguns para meus amigos de Sumeru para eles estudarem um pouco sobre o seu valor medicinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "A Paimon acha que você vai se esquecer daqui a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "#Cof. Bom, voltando ao assunto, vocês {M#dois}{F#duas} já foram procurar os murais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Essas são as fotos que você queria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Não sei como expressar a minha gratidão! É assim que se expressa nesta nação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Sim... interessante, que interessante! Só que... vocês não encontraram mais murais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Aqui estão todos eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Então isso se tornou mais interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "O que você quis dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Os habitantes originais estabeleceram a sua própria civilização usando a Pássaro do Trovão como sua fé e a cerimônia de sacrifício como seu núcleo. Qualquer pessoa que conheça a história não vai se estranhar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Mas no mural que vocês me deram, não estou encontrando nenhuma marca da Pássaro do Trovão. Talvez seja uma outra coisa em que os habitantes acreditavam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "O sol, a lua, estrelas e ícones estranhos... Talvez os antecessores dos habitantes originais da Ilha Tsurumi já tenham tido uma civilização próspera antes da chegada da Pássaro do Trovão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Além disso... A névoa e lua, estrelas e trevas... Hum... mas parece que não é nada de lógico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "É melhor parar agora... A sua memória já piorou bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "Ah... peço desculpas. Eu estava muito concentrado, e acabei ignorando vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Muito obrigado pelo seu esforço. Agora já estou com os materiais o suficientes para o meu diário... Se eu tiver sorte, e for valorizado pelos estudiosos de história, vou deixar os seus nomes no meu diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Bom! Eu também preciso voltar à Guilda. Tomei muito tempo seu, peço desculpas e espero que a gente possa se encontrar no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Ele realmente tem estado muito ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Ah, aliás, eu tenho uma outra coisa, que não é muito importante, mas precisa da sua atenção... Qual é o nome daquela criança que você acabou de mencionar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "Ruu... Isso. É o nome dele. Eu trouxe alguma comida para ele, espero que ainda esteja fresquinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Desde da minha última visita, eu sempre tenho pensado muito nele... Não deve ser fácil para ele viver numa ilha tão perigosa quanto esta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Bom, não quero tomar seu tempo, {NICKNAME}, nos veremos na próxima parada. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "Só encontramos esses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Acho que é assim que pessoas esquecidas sobrevivem, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Os Fungos Florescentes de antes funcionaram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "Isso mesmo, mas como que ele está pior do que antes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}