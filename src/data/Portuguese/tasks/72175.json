			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Ah, então você ainda está nessa ilha também. Isso é ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Como vocês têm estado? Já fizeram muitas descobertas? Me contem sobre elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Não descobri nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Ah, mas isso é normal. Não se preocupe, eu diria: ilhas como esta nunca faltam em mistérios. Tenho total confiança de que você vai acabar tropeçando em algo eventualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "Na verdade, Paimon tem uma pergunta: o que você está fazendo aqui, Roald?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Eu? Oh, eu só estava arrumando minhas coisas e me preparando para sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "O nevoeiro aqui é muito estranho. Se você entra um pouco nele, você já perde o caminho... E antes que perceba, você já está de volta ao ponto de partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "Eu havia esquecido o caminho que Kama me mostrou antes... Por isso fui até os habitantes locais para lhes perguntar, mas não consegui encontrar caminho algum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "Minha bússola, as sombras no chão... Nada disso ajuda em dizer as direções por aqui... Eu até tentei usar meus sapatos, mas não! Não consegui dar um só passo adentro do nevoeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Sapatos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Ele quis dizer que usava isso para marcar o caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Hã—?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Haha! Como esperado de você, {NICKNAME}! Imagino que você sabe muito bem esses truquezinhos por se aventurar, não é? Você tem muito a aprender, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "A Paimon tem muito a aprender ainda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Ah, qual é, isso se chama tentar a sorte! Paimon não precisa aprender isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "De qualquer forma, meu progresso estagnou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "*Suspira* Se eu tivesse amarrado uma corda a uma árvore próxima e tentado avançar enquanto segurava firmemente a outra parte, eu provavelmente poderia ter feito mais algumas tentativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "Então, você não tentou de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "Eu até usei os sapatos de reserva que eu trouxe, para ajudar a dizer em qual direção eu estava indo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Então eles sumiram, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Bem, eles não teriam, mas eu, uh... Eu joguei vários deles e sempre esquecia de buscá-los, então... Acabei ficando sem com o tempo, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Espere. Isso mesmo! Finalmente lembrei! Tenho algo a lhe perguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Ei, não pule assim! Paimon achou que você ia morder ou algo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Desculpe, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Como você sabe, eu tenho o péssimo hábito de constantemente esquecer as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "Minha memória ruim já me colocou em sérios problemas mais do que algumas vezes, especialmente porque sou um aventureiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "E uma das minhas metas ao vir para a Ilha Tsurumi era de coletar algo chamado Fungo Fluorescente. De acordo com Sango, esses fungos podem ajudar a melhorar a memória e aliviar a tensão no cérebro. Dizem que ele até mesmo pode melhorar a visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "Da última vez que vim aqui com Kama, eu estava tão preocupado com \"conhecer os nativos\" que esqueci de coletar algum... *Suspira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "Eu também não esperava que iria encontrar tantos problemas depois de vir para a ilha por conta própria. É realmente uma pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Então, se você ainda tiver alguns planos por essas bandas, você poderia me ajudar a pegar alguns desses Fungos Fluorescentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Apenas não esqueça de mim quando chegar a hora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Haha! Não se preocupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "Sinto muito ouvir isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "*Suspiro* Era isso mesmo que estava dizendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "Ainda estamos explorando a ilha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Entendo, haha! Sendo assim, não os vou atrasar mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Hmm, isso deve ser suficiente, sim! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "A propósito, se você encontrar alguma coisa por perto do local de cerimônia da ilha, me dê um aviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Hmm. Ah, sim. Acredito que você tenha consigo um Aparelho Fotográfico de Fontaine, certo? Esse é um aparelho realmente muito caro... Eu realmente deveria tentar conseguir uma se meu orçamento permitir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Ouvi historiadores locais dizerem que os habitantes antigos usavam tintas para retratar a história antiga, agora esquecida, nas paredes rochosas das cavernas, e que esses murais duraram mais de mil anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Durante minha viagem anterior aqui, pude ver de passagem essas imagens por meio das luzes dos fogos da cerimônia... Elas ocuparam meus pensamentos durante várias noites inquietas, e foram de fato as mais difíceis de esquecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Não acredito que alguém já tenha testemunhado totalmente os murais, mas se você pudesse trazer de volta provas de sua existência, isso certamente constituirá em um grande avanço para a Guilda de Aventureiros no departamento histórico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "Se você encontrar esses murais lendários, tire o máximo de fotos claras que puder deles. Comprarei as fotos de você para uso em meu diário por um preço justo e te recompensarei pelo seu incômodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Vocês poderiam me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Desde que você não perca seu diário.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Vou... vou ver o que posso fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
		{
