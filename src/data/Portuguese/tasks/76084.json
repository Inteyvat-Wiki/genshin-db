			"dialogs": [
				{
					"id": 760840101,
					"content": "Ah, vocês vieram? Os kuuhenki estão tocando a lira de novo. Será que você poderia tocar uma música para eles como da última vez?",
					"roleType": "TALK_ROLE_NPC",
