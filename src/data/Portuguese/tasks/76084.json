						760840102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760840102,
					"content": "Eu também estou com vontade de ouvir alguma coisa diferente dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760840103,
					"content": "(Hmm, o que devo tocar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
