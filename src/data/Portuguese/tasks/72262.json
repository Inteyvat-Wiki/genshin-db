			},
			"dialogs": [
				{
					"id": 722620101,
					"content": "Ooh, o mar daqui é bonito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620102,
					"content": "Hã? A Ilhota Dihua não é o mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620103,
					"content": "Mas as águas daqui estão ligadas ao mar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620104
					]
				},
				{
					"id": 722620104,
					"content": "Hmm, é verdade... Mas dizer que a Ilhota de Dihua é o mar não parece certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620105,
					"content": "Hmm... Não entendo. \"Mar\" e \"não mar\", qual diferença?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620106,
						722620110,
						722620114
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620106,
					"content": "O gosto da água?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620107
					]
				},
				{
					"id": 722620107,
					"content": "Ooh! Água da floresta é doce, não é mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620108
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620108,
					"content": "Mas, se o Lago de Sidra estivesse cheio de sidra, o que ele seria...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620109,
					"content": "Algo que Venti ficaria feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620120
					]
				},
				{
					"id": 722620120,
					"content": "Mas, vamos deixar esse problema de lado por um momento. É só Paimon, ou Kichiboushi está falando melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620121,
						722620122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620121,
					"content": "Bem, de acordo com o que Ioroi disse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620123,
					"content": "O que foi que Ioroi disse mesmo? \"Eu sou o grande Bake-Danuki, Ioroi\"... Não, não foi isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620124,
					"content": "\"Ooh, eu quero coçar minha barriga\"... Também não foi isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620125,
					"content": "Mmhahaha! Paimon imita bem! Muito engraçada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620126
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620126,
					"content": "\"Quanto mais nos acostumarmos à aura de Kichiboushi...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620127
					]
				},
				{
					"id": 722620127,
					"content": "Ah, sim! Quanto mais nos acostumarmos à aura de Kichiboushi, melhor o entenderemos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620128,
					"content": "#E treinamento também! Kichiboushi aprendendo muitas coisas com {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620129,
						722620133
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620129,
					"content": "Paimon é uma boa guia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620130
					]
				},
				{
					"id": 722620130,
					"content": "Hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620131,
					"content": "#Você lembra tudo isso de antigamente, não é, {NICKNAME}? Paimon fica feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620132,
					"content": "#Hmm! Obrigado, Paimon e {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620136,
					"content": "Esse \"mar ou não mar\" é bonito. A casa ali atrás também muito bonita. Ajudar Kichiboushi tirar foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620137
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620137,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722620133,
					"content": "Companheiros que aventuram juntos crescem juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620134
					]
				},
				{
					"id": 722620134,
					"content": "Hmm! Companheiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620135
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620135,
					"content": "Melhores companheiros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620122,
					"content": "Antes de partirmos, Ioroi disse algo sobre isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620123
					]
				},
				{
					"id": 722620110,
					"content": "O mar é um corpo d'água enorme ao redor de um continente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620111
					]
				},
				{
					"id": 722620111,
					"content": "Uau, que definição tão séria! Mas isso nos leva de volta a pergunta sobre o que é uma fronteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620112,
					"content": "#{NICKNAME} disse há pouco que a Ilhota de Dihua é ligada ao mar. Por isso, a diferença entre continente e não-continente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620113
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620113,
					"content": "... Acho que sua definição restrita não está resolvendo nosso problema, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620114,
					"content": "Esses conceitos são criados pelas pessoas. Não possuem nenhum significado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620115
					]
				},
				{
					"id": 722620115,
					"content": "Se a Ilhota de Dihua crer que ela é o mar, então é o mar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620116
					]
				},
				{
					"id": 722620116,
					"content": "Kichiboushi pensa que é um Adeptus, então é um Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620117
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620117,
					"content": "#Ei! Kichiboushi, não dê ouvidos {F#a}{M#ao} {NICKNAME}! {NICKNAME}, o que você está falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620118,
					"content": "... Entretanto, apesar de ter sido meio bagunçado, você tinha um bom ponto. Você pode ser qualquer Bake-Danuki que quiser, Kichiboushi! E quem sabe um dia você se torne um Adeptus Tanuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620119,
					"content": "Tanuki adeptus! Uhul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620120
					],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
