					"nextDialogs": [
						722620323
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620323,
					"content": "Mas Kichiboushi sabe que vocês são boas pessoas. Por isso, Kichiboushi vai aprender.",
