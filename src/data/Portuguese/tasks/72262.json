					"content": "Pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620202,
					"content": "E agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620203,
					"content": "Que tal o seguinte? Kichiboushi, você já pescou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620204,
					"content": "Pescar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620205
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620205,
					"content": "Parece que não! Bem, vamos ali para a margem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620206,
					"content": "Ebaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
		{
			"id": 7226203,
			"completionStepIds": [
				7226207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226207",
							"2"
						],
						"stepId": 7226207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kichiboushi\"",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722620301,
					"content": "Ooh... Por quê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620302,
					"content": "Kichiboushi! Por que você diretamente para o acampamento dos Hilichurls?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620303,
					"content": "Pensei que podíamos brincar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620304
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620304,
					"content": "Hã? Por quê? Os Hilichurls são monstros perigosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620305,
						722620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620305,
					"content": "Bem, eu não diria que são tão perigosos assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620306
					]
				},
				{
					"id": 722620306,
					"content": "#Ei! Kichiboushi não é {F#uma}{M#um} Viajante experiente como você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620309,
					"content": "Hmm, quando nos conhecemos a primeira vez na Floresta Chinju...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620310
					]
				},
				{
					"id": 722620310,
					"content": "Isso mesmo! Os Hilichurls estavam lhe cercando, e você virou alguma outra coisa para se esconder, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620311,
					"content": "Quando nos conhecemos pela primeira vez... Primeira vez... Estou pensando... Lembrei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620312
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620312,
					"content": "Eu estava brincando de esconde-esconde com os Hilichurls. Hilichurls da floresta não atacam Bake-danuki. Brincam sempre conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620313
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620313,
					"content": "Hã? Então vocês têm uma boa relação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722620314,
					"content": "Não sei por qual motivo os Hilichurls daqui são assim. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620315
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722620315,
					"content": "Enfim, você precisa ter mais cuidado. Mesmo se tratando de Hilichurls... Bem, especialmente se tratando deles!",
