			"dialogs": [
				{
					"id": 701280101,
					"content": "Oh, essa garrafa parece pesada, o que será que tem dentro dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280102,
					"content": "\"Nosso velho amigo veio ontem trazer más notícias...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280103,
					"content": "\"Desde então, não tivemos mais respostas. Talvez ele esteja certo e nós devêssemos aceitar a realidade.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280104,
					"content": "\"Mas, independentemente disso, se você está ainda está andando por aí, e se você receber essa mensagem, espero que possa me responder\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280105,
					"content": "\"Esta carta contém seu emblema. Quando a hora chegar, usarei ele para reconhecê-lo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280106,
					"content": "\"Você se lembra do Restaurante Uyuu? Nós nos encontrávamos ali, também enviei o dinheiro da bebida junto com a carta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280107,
					"content": "\"Se você recebeu essa carta, mas não for a pessoa que estou esperando encontrar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Garrafa à Deriva"
				},
				{
					"id": 701280108,
					"content": "\"Também espero que fique com as lembranças que mandei. Talvez você possa me ajudar a encontrar o antigo dono delas. Fique com essas Mora como agradecimento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garrafa à Deriva"
				}
			]
		}
	]
