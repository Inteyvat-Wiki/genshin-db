			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Retentora de Nuvem"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705000101,
					"content": "No cenário nevado, as árvores azuis se erguem, então há uma atmosfera muito solitária e tranquila. Este terceiro prato combina muito para a ocasião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000102
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000102,
					"content": "Que tipo de prato você vai fazer desta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000103
					]
				},
				{
					"id": 705000103,
					"content": "Hmmm, você já ouviu falar da técnica de cozimento chamada \"refogar?\" Eu descobri essa técnica enquanto estudava esta receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000104
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000104,
					"content": "Achei particularmente interessante e escrevi uma nova receita chamada \"Carne Bestial Refogada\" com essa técnica de cozimento como técnica principal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000105
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000105,
					"content": "Embora este prato não seja problemático para minha Máquina de Culinária Suprema, o foco do prato é a carne, e a carne usada deve ser premium...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000106
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000106,
					"content": "Portanto, abri o mecanismo e vim até aqui para encontrar os ingredientes certos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000107
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000107,
					"content": "É difícil fazer as coisas aqui por causa do vento e da neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000108
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000108,
					"content": "Viajante, sei que você tem ampla experiência em aventura. Uma pequena montanha coberta de neve, para você, definitivamente não é um problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000109
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000109,
					"content": "Por favor, vá buscar os ingredientes e traga-os de volta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000110,
						705000116
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000110,
					"content": "Eu quero a receita para o terceiro prato também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000111
					]
				},
				{
					"id": 705000111,
					"content": "Naturalmente, não vou me esquecer de você. Então vou deixar isso com você, estarei esperando aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000112,
					"content": "Uh, por que o mecanismo parou de repente? É possível que a área ao redor esteja muito fria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000113
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000113,
					"content": "Vamos recomeçar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000114
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000114,
					"content": "Máquina de Culinária Suprema... Ativar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000115
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000115,
					"content": "Deve estar tudo bem agora... Viajante, siga a trilha e pegue os ingredientes que o imortal deseja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000116,
					"content": "Você está com muito frio para voar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000117
					]
				},
				{
					"id": 705000117,
					"content": "Ha! Boa piada! Como você ousa me subestimar! Eu só preciso... consertar essa máquina aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000118
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000118,
					"content": "Vá e volte logo, não me deixe esperando muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000112
					],
					"speakerTitle": "Retentora de Nuvem"
				}
			]
		},
