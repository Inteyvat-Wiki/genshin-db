			},
			"dialogs": [
				{
					"id": 705000701,
					"content": "Hummm.. O sabor está ótimo, graças a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000702,
						705000703
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000702,
					"content": "Você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000704
					]
				},
				{
					"id": 705000704,
					"content": "Claro! Com esses três pratos feitos, a sua confiabilidade já foi completamente comprovada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000705
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000705,
					"content": "Uma vez que resolvemos os problemas de controle de fogo e a coleta automática de ingredientes, o mecanismo estará pronto para a função \"Culinária Expressa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000706
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000706,
					"content": "Ah! Guarde a receita desse prato. Olhe bem, a carne na receita se refere à Carne Crua mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000707
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000707,
					"content": "Já que está extremamente frio aqui na Montanha Nevada, não posso simplesmente mandar você para cá para procurar ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000708
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000708,
					"content": "Então, as Carnes Cruas comuns já chegam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000709
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
