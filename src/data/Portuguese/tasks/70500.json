			"dialogs": [
				{
					"id": 705000501,
					"content": "Que tipo de carne？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000502,
					"content": "Carne Fresca Fria",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "Carne Fresca Fria... O nome com certeza é adequado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000504,
					"content": "Hum... não está mal, mas a carne poderia ter ficado mais tempo no fogo lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000505,
					"content": "Felizmente, minha Máquina de Culinária Suprema tem a capacidade de descongelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000506,
					"content": "Parece que não falta nenhuma função neste mecanismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "Como pode ser? Naturalmente faltariam funções. Por exemplo, recuperação automática de ingredientes, controle automático de calor... e assim por diante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000508,
					"content": "Esse mecanismo precisa de aprimoramentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000509,
					"content": "Bem, sem mais delongas, como já temos os materiais completos, ativarei agora mesmo o mecanismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000510,
					"content": "#Você ficará encarregad{F#a}{M#o} de cuidar do fogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000511,
					"content": "Avise-me quando tudo estiver pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 705000512,
					"content": "Os Adepti realmente são poderosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "Em vez de elogiar a minha Força Adepti, prefiro que você elogie o engenho da Máquina de Culinária Suprema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "Retentora de Nuvem"
				}
			]
		},
