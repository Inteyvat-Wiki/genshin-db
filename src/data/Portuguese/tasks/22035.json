				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Sim, fizemos mais do que o suficiente desta vez. Amano e o Sr. Andou nos ajudarão a fazer com que aquele ladrão saiba o que estamos fazendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "Quanto tempo mais isto vai demorar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Não falta muito. Assim que a Sango estiver pronta, podemos encerrar este caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "Aqui está o seu pagamento, Viajante. Obrigado pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "Este é o pagamento decidido pela própria Sango, então acredito que seja proporcional. Por favor, aceite. Podemos ter mais trabalhos para você no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
