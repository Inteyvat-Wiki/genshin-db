	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203501",
							"2"
						],
						"stepId": 2203501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "Viajante, nos encontramos novamente. Graças à sua ajuda da última vez, Sango agora tem certeza da identidade do culpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350102,
					"content": "Mas, se quisermos que o culpado seja mesmo derrotado, precisamos nos preparar ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350103,
					"content": "Enquanto ela está cuidando de outras coisas, vamos continuar o trabalho que iniciamos anteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350104,
					"content": "Quer ter problemas com os Ladrões de Tesouro de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Isso mesmo. Embora o culpado não tenha nada a ver com os Ladrões de Tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350106,
					"content": "Esses Ladrões de Tesouro não estão tramando nada de bom, então é melhor que eles nos \"ajudem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350112,
					"content": "Sango marcou sua localização específica. Não fica longe da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350113,
					"content": "Quanto aos assuntos dentro da cidade... Sango secretamente instruiu Amano e o Sr. Andou a nos ajudar nessa operação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350114,
					"content": "Ela também prometeu que o crédito por resolver esse caso será todo deles, então eles trabalharão conosco com prazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350115,
					"content": "Deixe os pensamentos e o planejamento com ela. Vamos apenas manter nossas comunicações com esses Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350116,
					"content": "Marquei a localização deles no seu mapa. Vamos indo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350107,
					"content": "Enganando o culpado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Isso mesmo. Devemos fazê-lo continuar a acreditar que nosso alvo são os Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350109,
					"content": "Dessa forma, Sango terá mais tempo para completar seu plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350110,
					"content": "Haha, não que aqueles Ladrões de Tesouro estivessem tramando algo de bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350111,
					"content": "Dessa forma, usaremos eles para nos ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
