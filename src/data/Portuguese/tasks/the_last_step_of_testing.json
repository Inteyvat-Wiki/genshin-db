			"dialogs": [
				{
					"id": 766580101,
					"content": "Ei, Ginette! Você pegou todos os robôs que encontramos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Consegui! Bom trabalho, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "Falando nisso, fizemos algumas descobertas novas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "Sério? Por favor, me conte tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Você e Paimon contam a Ginette tudo que presenciaram agora a pouco.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "Os comportamentos que você descreveu... Os robôs pareciam gostar muito de você, e assim te mandaram uma mensagem. Um convite para \"brincarem juntos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Sério? Uau, isso é tão legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Uhum... Eu sabia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Sabia do quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Agora eu tenho certeza — minha visão só pode se realizar por interações entre esses robôs. Quanto mais unidades recuperarmos, mais perto ficamos do meu plano original...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Agora, eles já podem se comunicar com os outros. Tudo que temos que fazer é encontrar o resto dos robôs, e... Isso! Consigo sentir minha criatividade dando frutos...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Alguém está animada, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah! Desculpe, estou ficando um pouco fora de mim... Ainda precisarei de sua ajuda para o resto. Aqui, marquei a próxima área no mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Então vamos indo! Paimon está tão curiosa quanto você para saber onde isso vai dar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
