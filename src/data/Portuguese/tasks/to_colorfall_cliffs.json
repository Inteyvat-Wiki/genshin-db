			"dialogs": [
				{
					"id": 150400601,
					"content": "#Hah, isso foi divertido demais! Obrigado, {M#caro}{F#cara} oponente, nos divertimos muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400602,
					"content": "Você foi um adversário formidável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "Ótimo trabalho, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#Parabéns a {NICKNAME} pela vitória, e um grande agradecimento ao nosso magnífico benfeitor e aos Asha pelo seu incrível trabalho em equipe também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Quando eu soube da sua interpretação das palavras do Asha mais cedo, eu não pude acreditar. Mas após essa partida, devo dizer, estou realmente impressionada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "Eu sinto exatamente o mesmo! Eu estava ansiosa por vocês dois, igual a assistir às finais da Peregrinação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Sei como é. Quando a luta chegou ao ápice, eu quase não conseguia resistir à vontade de voar até lá e fazer uns disparos eu mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Espera, suas balas também podem ser usadas para pintar as coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "Claro — mas quanto à cor, eu não saberia dizer. Mas tenho praticamente certeza que Asha não conseguiria ficar no ar por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "Haha! Enfim, estamos agora apenas a um passo de concluir a Patrulha Aérea Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "#{M#Nossos dois heróis}{F#Nossas duas heroínas}, por favor, acendam o pincel da Patrulha Aérea Asha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Iniciar linha de tempo dos marcos Asha)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Parece incrível, não é? Eu posso recomendar um mirante que seria perfeito para uma foto em grupo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "Você e Asha são uma equipe brilhante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Eu devia ter pedido a ajuda de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "Ah, então agora você lembra de Paimon? Um pouco tarde pra isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
