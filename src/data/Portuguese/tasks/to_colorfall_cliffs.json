			"dialogs": [
				{
					"id": 150400701,
					"content": "Tudo bem, estamos aqui. Essa, senhoras e senhores, é a Patrulha Aérea Asha",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400702
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400702,
					"content": "Uau, que maneiro! Eu não esperava que fosse tão grande de perto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400703
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400703,
					"content": "Quando estiver pintado, vamos conseguir ver de muito longe, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400704,
					"content": "Ah, claro! Contanto que você esteja numa área aberta e a vista não esteja bloqueada pelas montanhas, você vai conseguir ver de qualquer lugar por aqui — seja de um telhado na Colina Huha ou os fiordes na Ilha Tete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400705
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400705,
					"content": "Muito orgulho de vocês — vocês conseguem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400706,
					"content": "Cara, eu já tô ficando animado! Será que eu devia escolher minha cor da sorte? Ou talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400707
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400707,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400708
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400708,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400709
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400709,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400710
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400710,
					"content": "Uau, tem mesmo muito a dizer sobre isso, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400711,
					"content": "Chasca, você entendeu aquilo tudo? Se importa de traduzir pra gente de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400712,
					"content": "Hmm, isso foi muito para assimilar. Vou fazer uns cálculos e descobrir quantas possibilidades existem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400713
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400713,
					"content": "#Tudo bem, acho que entendi! Asha quer se juntar comigo e competir contra {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400714
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400714,
					"content": "Ele gosta de ajudar as pessoas trabalhando junto a seus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400715
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400715,
					"content": "Mas é o elemento da competição que torna atividades ordinárias em aventuras emocionantes, e isso é o que ele mais gosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400716,
					"content": "E-Ele disse isso tudo mesmo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400717,
					"content": "Haha, mais ou menos! Provavelmente com um pouco da minha interpretação também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400718
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400718,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400719
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400719,
					"content": "Pela reação dele, parece que você acertou em cheio. O laço entre vocês está mesmo ficando mais forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400720
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400720,
					"content": "#Tudo bem, Asha. Gosto da sua ideia, mas não deveríamos pressionar {NICKNAME} para fazer uma coisa que não queira, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400721
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400721,
					"content": "Temos que respeitar as opiniões e sentimentos dos nossos amigos também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400722
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400722,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400723,
						150400726,
						150400729
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400723,
					"content": "Uma chance de desafiar o líder — exatamente o que eu estava esperando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400724
					]
				},
				{
					"id": 150400724,
					"content": "\"Então aceito o seu desafio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400725
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400725,
					"content": "Haha... Com você olhando para mim assim, eu não conseguiria dizer isso com a cara séria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400732,
					"content": "Tudo bem, se ambas as equipes estão prontas, sigam-me! Serei a juíza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400726,
					"content": "Contanto que Bennett e Asha estejam felizes, é tudo que importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400727
					]
				},
				{
					"id": 150400727,
					"content": "#Ei, não podemos ser os únicos nos divertindo! Eu também quero aproveitar, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400728
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400728,
					"content": "Vem, vamos nessa! Sem pressão, só aproveite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400729,
					"content": "Mesmo contra vocês todos, eu ainda teria a vitória.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400730
					]
				},
				{
					"id": 150400730,
					"content": "Quanta confiança! Tudo bem, então vou dar o melhor de mim também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400731
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400731,
					"content": "Ei, Paimon sempre esteve ao seu lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400732
					],
					"speakerTitle": "Paimon"
				}
			]
