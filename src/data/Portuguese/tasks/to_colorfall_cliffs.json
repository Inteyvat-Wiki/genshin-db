			"dialogs": [
				{
					"id": 150400101,
					"content": "Aqui estamos! Então esses devem ser os Campos de Florespuma marcados no mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400102,
					"content": "Por que eles são tão... verdes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400103,
					"content": "Parece mais Campos de Gramaespuma pra mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "Haha, também não é exatamente o que eu imaginava... Mas isso acontece bastante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400105,
					"content": "Você quer dizer quando lugares são divulgados para parecerem melhor do que são de verdade? A meu ver, isso já tá num nível que eu consideraria fazer uma reclamação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400106,
					"content": "Além disso, se eu não fizesse, meus hóspedes fariam uma reclamação sobre mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400107,
					"content": "Não, não. Desculpa, eu não me expressei muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400108,
					"content": "Quis falar da diferença entre minha expectativa e a realidade. As coisas geralmente acabam parecendo diferente de como as imaginei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400109,
					"content": "Você quer dizer, tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400110,
					"content": "Tipo escalar o topo de uma montanha pela vista, só para uma névoa densa aparecer do nada, tão densa que você não consegue nem ver o caminho para baixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400111,
					"content": "Ou voltar para sua tenda e descobrir que um Slime Pyro se infiltrou e acendeu toda a lenha que você coletou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400112,
					"content": "Isso parece meio intenso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400113,
					"content": "Honestamente, eu já me acostumei a essa altura. Só as reviravoltas normais no caminho da aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400114,
					"content": "Então, quando você pensa nisso, só poder aproveitar essa paisagem vasta, ar fresco em todo lugar e nenhum monstro à vista... Diria que temos bastante sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400115,
					"content": "Eu diria que a coisa mais sortuda de todas é sua habilidade de se manter tão alegre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400117,
					"content": "Você acha que os Asha descobriram algo? Parecia ser isso que queria dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400118,
					"content": "Não demorou muito para vocês se conhecerem, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400119,
					"content": "(Você termina de ler.)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "Pense num par de arqui-inimigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400121,
					"content": "Se eles dois fossem pessoas, talvez desse para eles sentarem e conversarem... Mas um deles é um Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400122,
					"content": "Vem, vamos dar uma mãozinha! Tá pronto, Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400124,
					"content": "Hã? Paimon perdeu alguma coisa? Como a gente passou de repente direto para o modo ação? O que vocês vão fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400125,
					"content": "Não é difícil adivinhar o que o Asha mais adora fazer. Deve ser pintar as coisas de cores diferentes, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400126,
					"content": "Bem, você não está errado nessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400127,
					"content": "E eles são seres simples e de coração puro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400128,
					"content": "Duvido que esteja aqui para causar problemas de propósito. Provavelmente só não consegue aguentar como essa grama parece sem graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400129,
					"content": "Além disso, com o que aqueles dois estão fazendo... Bem, não é exatamente o que você chamaria de \"se comunicar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400130,
					"content": "Certo! Então se conseguirmos ajudar a tingir o campo com cores vibrantes, algo que atinja as expectativas de todos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400131,
					"content": "...Aí talvez a gente ganhe a aprovação desse Asha artístico ao mesmo tempo que ajudamos aquele funcionário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400132,
					"content": "Exatamente, é isso mesmo que eu estava pensando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400133,
					"content": "Não é uma má ideia. Você seria um pacificador promissor, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400134,
					"content": "Contem comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400136,
					"content": "Haha, isso faz cócegas... Para...! Espera uma segundo, aonde estamos indo? É longe? Eu tenho que avisar meus amigos primeiro—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400137,
					"content": "Olááá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400138,
					"content": "Ei, intérprete — entendeu isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400139,
					"content": "Talvez devêssemos mover alguma coisa? Ou tem mais alguém por perto que precisa da nossa ajuda ainda mais...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400140,
					"content": "Essas duas coisas parecem completamente diferentes! Além disso, como você descobriu aquilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400141,
					"content": "Sinceramente, quanto mais eu os observo, mais a linguagem corporal deles me lembra a dos Saurianos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400142,
					"content": "Você não tá tirando onda comigo, está? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400143,
					"content": "Quando minha \"mãe\" levantava as asas, podia significar duas coisas completamente diferentes — \"venha para casa cedo para jantar\" ou \"você está em apuros, mocinha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400144,
					"content": "Como você conseguia saber a diferença, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400145,
					"content": "Quando eu era pequena, não conseguia. Alguns dias, eu voltava rápido para casa, só para chegar direto para uma surra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400147,
					"content": "Super resistente e rápido... Então esse é um balão de ar quente de Natlan? É irado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400148,
					"content": "Oi, pessoal, estamos de volta! Rápido, olhem para o céu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
