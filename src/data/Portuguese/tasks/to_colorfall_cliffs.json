			},
			"dialogs": [
				{
					"id": 150400301,
					"content": "Uau, parece incrível! Os Campos de Florespuma estão finalmente fazendo jus ao nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "Bom trabalho, pessoal! Agora só precisamos avisar àquele funcionário, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "Por favor, pessoal, esperem... *Ofegante*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "Isso que é chegar no momento certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "Ei, sem pressa! Relaxa aí e recupera o fôlego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*Puf*... Ufa, tudo bem. Saudações, sou a funcionária encarregada do evento principal nos Penhascos Coloridos — o desafio Patrulha Aérea Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Ainda agora, observando do alto, vi o campo se transformar de repente em um mar de flores. E as cores eram tão artísticas, tão maravilhosas... que quase derrubei meus binóculos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "V-Vocês são mesmo os salvadores dos Penhascos Coloridos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "Não foi nada, hehe. Além do mais, foram esses dois que fizeram a maioria do trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "#{M#Aventureiros}{F#Aventureiras} gentis, vocês estariam dispost{M#os}{F#as} a participar de nosso desafio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "Na verdade... Vocês nos dariam a honra de trazer um pouco de cor aos nossos marcos também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Isso parece incrível... Mas você tem certeza que podemos fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Claro, claro! Na verdade, eu ficaria emocionada se vocês dissessem sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "Vocês fizeram um favor tão grande ao meu colega, é apenas certo que eu agradeça a vocês em nome dele. E eu acho que essa experiência seria ainda mais especial do que qualquer recompensa monetária!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Uhh, se quiser saber o que Paimon acha—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "O que ela quer dizer é que ficaríamos muito felizes em ajudar! Haha... Então, como chegamos lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Por favor, sigam-me. Vamos subir no balão de ar quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
