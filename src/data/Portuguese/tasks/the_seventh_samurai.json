			"dialogs": [
				{
					"id": 721540401,
					"content": "Um \"Filme de Espadas\"... O senhor Xavier certamente tem um gosto peculiar em nomes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "O que você acha desse filme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Nossos superiores acreditam que esses filmes ajudarão a aumentar o prestígio do Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Talvez eu seja apenas um pouco lento para entender isso, mas não compreendo essa opinião deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Esse roteiro está cheio de linhas pessimistas. Não há nada de dignidade Samurai aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "O que será que eles estavam pensando ao concordarem com isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Como está a situação da Fornalha Mikage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Desde a \"promoção\" do senhor Hanbei, Yousuke se tornou a pessoa responsável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Ele é um artesão por tradição familiar e ocupação, e também é pé-no-chão e confiável. Sabe lidar bem com os problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Com a Fornalha Mikage sob a sua direção, duvido que aconteçam mais problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
