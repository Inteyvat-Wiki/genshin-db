			},
			"dialogs": [
				{
					"id": 721540201,
					"content": "Oh não, esse filme parece não ter sido gravado corretamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540202
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540202,
					"content": "Por favor, prepare-se novamente e nós gravaremos de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7215403,
			"completionStepIds": [
				7215403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
