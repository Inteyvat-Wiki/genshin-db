				{
					"id": 721540801,
					"content": "O que você realmente quer capturar com esse filme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Ah! Ótima, excelente pergunta! Sendo honesto, ainda tenho que pensar sobre isso também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Acredito que filmes possam ser sobre qualquer coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "Romance, suspense, ação! Até mesmo todos os tipos de lendas infundadas podem ser o tema de um filme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Mas devo dizer que acho que os filmes possuem algum tipo de charme que ainda tenho de desenvolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Ainda assim, creio que encontrarei a resposta dessa questão somente se continuar fazendo eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
