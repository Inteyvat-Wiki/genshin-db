			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "Já já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Uhu! Estamos começando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020203,
					"content": "Você precisa começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020204,
					"content": "Ok, isso é um assalto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Hah! Assaltam durante o dia? Os Millelith estão vendo ao lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, venha cá! Temos que escapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220020207,
					"content": "Olá, você veio roubar alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020208,
					"content": "Err... Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Mas eu não tenho muito Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020213,
					"content": "O meu pai diz que as coisas mais valiosas no barco são os bens que os comerciantes transportam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020214,
					"content": "Hum, deixa assim então. Por que você não tenta procurar algumas coisas valiosas para usar no jogo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020215,
					"content": "Assim temos bens para você tentar e roubar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020216,
					"content": "Deixe-me pensar, então vá buscar algumas Cabeças de Lótus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020217,
					"content": "#Nós três adoramos comer Cabeças de Lótus. Se você está sendo {F#uma}{M#um} pirata malvad{F#a}{M#o}, roubar as Cabeças de Lótus é um bom começo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020209,
					"content": "A você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Ei, apesar de saber que é só um jogo, ainda assim, precisamos tomar cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020211,
					"content": "Viu? Os Millelith estão nos olhando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Pequena Lulu"
				}
			]
		},
