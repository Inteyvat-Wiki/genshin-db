				"points": []
			},
			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, por que eu sou o capitão de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220020102,
					"content": "Porque é mais divertido quando o Meng é o capitão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020103,
					"content": "Contanto que a Lulu esteja feliz, eu também não tenho problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220020104,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Vamos jogar um jogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng é o capitão, Fei é o marinheiro e eu sou uma comerciante rica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020107,
					"content": "Então só falta um pirata para nos roubar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020108,
					"content": "Você não quer brincar com a gente? Você pode ser o pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020109,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020113,
					"content": "#OK, venha e nos diga quando estiver pront{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020111,
					"content": "Eu quero ser uma pessoa boa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "É só um jogo, não se preocupe! Eu sei que você é uma boa pessoa na vida real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Pequena Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
