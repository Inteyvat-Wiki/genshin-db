					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Yay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng! Fei! Venha comer estas Cabeças de Lótus comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020305,
					"content": "Ei! Ei! Estamos assaltando, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Oh, verdade... Bem, aqui está, peguem estas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020307,
					"content": "#Você é {M#um}{F#uma} pirata nat{M#o}{F#a}. Não são todos que conseguem roubar todas essas coisas de uma criancinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220020308,
					"content": "Parece que tem outros significados atrás dessas palavras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Bom trabalho e foi muito divertido brincar com você. Volte sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Lulu"
				}
			]
		},
