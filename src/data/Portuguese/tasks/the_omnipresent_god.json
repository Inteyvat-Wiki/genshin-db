	"talks": [
		{
			"id": 202003,
			"completionStepIds": [
				202003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202003",
							"2"
						],
						"stepId": 202003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Sacie minha curiosidade. Qual é a razão de te encontrar aqui diante de mim mais uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200302,
					"content": "Você espera que sua imprudência abrigará essas pessoas? Ou... Foi simplesmente um meio de buscar uma audiência comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200303,
					"content": "Os Fatui lhe enganaram, Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Oh? Certamente você não me despertou do meu estado de meditação eterna apenas para me dizer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200306,
					"content": "Se é assim, então você me subestima. Estou muito bem informada sobre o Decreto de Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200307,
					"content": "Você sabe tudo o que está acontecendo lá fora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Não é bem assim. Apenas tudo o que diz respeito à eternidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200309,
					"content": "O Decreto de Caça à Visão tem minha aprovação implícita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200310,
					"content": "As ações dos Fatui até agora não constituem uma ameaça à eternidade, caso contrário... Eu já os teria expurgado há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200311,
					"content": "Mas o Decreto de Caça à Visão é prejudicial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "A ambição individual é intrinsecamente incompatível com a eternidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200314,
					"content": "O que você pode não perceber é que muitas vezes... As pessoas têm muito mais a perder ao perseguir seus sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200315,
					"content": "Considere assim - ninguém perderá a vida por ter sua Visão tirada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200316,
					"content": "Ao contrário, aqueles que perderam suas vidas são os que insistiram em perseguir suas próprias aspirações, não são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "Viajante, sua existência é única em meus olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200319,
					"content": "Parece haver uma incerteza ilimitada em você. Dito de outra forma, você é a coisa mais distante da eternidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200320,
					"content": "Portanto, não vou insistir que você compreenda o significado de minhas ações. O que importa é que eu trilhei o caminho da eternidade em nome do meu povo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200321,
					"content": "Este é o seu Plano da Eutimia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Ele foi criado pela sua consciência, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "É isso mesmo. Estou surpresa que você entenda tão bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200324,
					"content": "De qualquer forma. Você está procurando uma chance de abalar minha determinação... Não está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200325,
					"content": "Eu não estou aqui para debater suas opiniões.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Estou aqui para destruí-las.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200328,
					"content": "Que assim seja. Bem, então, você que desafia a eternidade... Hora de você me elucidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200312,
					"content": "Isso tem um grande custo para o povo de Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "O Decreto de Caça à Visão nunca deveria ter existido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
			"completionStepIds": [
				202005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"202005",
							"2"
						],
						"stepId": 202005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Você perdeu, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200503,
					"content": "...Sim, perdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200504,
					"content": "Por que você não pode confiar em seu povo, e no poder de suas ambições?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Essas ambições transcenderam o espaço-tempo. Elas são algo que ninguém pode apagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "Quando as pessoas avançam com todas as suas forças...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Esta é a lição que você aprendeu com sua viagem em Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "Existem nações onde os humanos colocam seu deus de lado e seguem adiante...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Então, devemos simplesmente abandonar a noção de progresso... Por uma questão de pensamento positivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "...Você e eu testemunhamos a grande perda que o progresso pode trazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200514,
					"content": "Eternidade... A eternidade é o único caminho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200515,
					"content": "Os Princípios Celestiais... Bobagens irrelevantes, no que me diz respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Quando tudo estiver dito e feito, tudo o que você realmente quer é proteger sua amada Inazuma, para todo o sempre. Não é verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Isso seria algo simplista demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200518,
					"content": "Mas será que esta nação vale a pena existir por toda a eternidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Desprovida de ambições, desprovida do potencial de mudança, ela não faz mais do que simplesmente existir... É uma casca oca de uma nação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Hã. Pergunto-me que perda seria realmente para alguém se tal nação fosse destruída?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, retire suas palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200522,
					"content": "A eternidade que nunca mudará é a promessa que eu fiz ao meu povo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200523,
					"content": "Mas o que seu povo precisa de você não é de suas promessas. Eles querem a sua atenção... O seu olhar divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "...Você está falando das Visões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200525,
					"content": "Os seres humanos têm uma vida útil de apenas uns cem anos. Eles não podem arcar com quaisquer perdas extras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200526,
					"content": "Mas eu já vivenciei tudo isso. É por isso que escolhi guiá-los pelo caminho correto em direção à eternidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200527,
					"content": "*Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Mas a eternidade é um destino cruel demais para você, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200530,
					"content": "Você não só deixou de prestar atenção ao mundo, como deixou de prestar atenção a si mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Deve ter sido terrivelmente solitário aqui, sozinha, durante séculos a fio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Mas é necessário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200533,
					"content": "Você perderá muito se recusar o progresso... Você procura evitar a perda, mas você já considerou tudo o que está perdendo ao permanecer aqui estática por toda a eternidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Você está obviamente solitária e, no entanto, pelo bem da eternidade você escolhe esticar sua solidão até o infinito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Diga-me. Por que o céu aqui que já foi tão escuro está brilhando novamente? Por que agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Este é o seu Plano da Eutimia. É o seu mundo interior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Portanto, isso só pode significar... Que você está feliz em me ver novamente. Há muito tempo você acha a solidão aqui insuportável, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Eu... Não tenho nada a dizer quanto a isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200539,
					"content": "Hehehe, oh, mas eu tenho muito a dizer a você. Deixe-me contar-lhe tudo o que aconteceu nos últimos séculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Quanto tempo isso vai levar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200541,
					"content": "Como uma Raposa Emissária, tenho uma excelente memória. Lembro-me de cada detalhe dos últimos séculos com perfeita clareza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Portanto, provavelmente levarei mais alguns séculos para repassá-las para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Heh... hehe... Miko, eu nunca pensei que teria a chance de me encontrar com você desta maneira novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200544,
					"content": "*Suspiro* Vê-la novamente é uma mudança para a eternidade... E uma surpresa muito agradável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200545,
					"content": "Hehe, já que você está disposta a admitir isso, suponho que isso significa que ainda podemos ser amigas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Que conversa infantil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200547,
					"content": "De qualquer forma. Agora que fui derrotada por você e seu plano, honrarei seu desejo de abolir o Decreto de Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200548,
					"content": "Mas em relação à eternidade e à questão de saber se esta nação deve avançar, preciso de tempo para pensar um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20200549,
					"content": "Hehe, você que tem agido como uma criança desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Elas podem superar as expectativas dos deuses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "E até mesmo assumir o trabalho dos deuses.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
