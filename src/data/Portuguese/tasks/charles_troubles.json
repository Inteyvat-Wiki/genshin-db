			"dialogs": [
				{
					"id": 4880001,
					"content": "Lisa? Você está aqui para fazer a declaração de impostos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Oh, querido. Você tem razão. Eu ouvi dizer que a Jean está doente, eu posso ajudar a fazer o trabalho de escrita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "Legal, bem, se você não precisa mais de nós, iremos nos retirar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Espere um momento... Na verdade, Charles estava pensando se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "Permita-me, senhorita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Acabei de receber alguns pedidos. Mas o estoque está insuficiente e a entrega do vinhedo está atrasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Se não for muito incômodo, vocês poderiam ir <color=#00E1FFFF>dar uma olhada na questão logística</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "O que tem de tão urgente neste pedido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "*Suspiros* Chegou no último minuto. Literalmente apenas alguns segundos atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Sim. É exatamente o que o Charles disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "Ok. Eu vou ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "Ok! Mas você tem que pagar uma bebida na próxima vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Hehe... eu tenho certeza de que da próxima vez que meu chefe Mestre Diluc estiver aqui, ele pagará a conta para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880014,
					"content": "Sim, mais ou menos isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
