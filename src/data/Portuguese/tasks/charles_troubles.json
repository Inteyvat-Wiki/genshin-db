			"dialogs": [
				{
					"id": 4880101,
					"content": "Então é aqui onde veio parar a entrega de Charles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880102,
					"content": "Você veio me resgatar? Estou esperando há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "Durante todo o tempo em que trabalhei no Vinhedo, é a primeira vez que os Hilichurls me assaltam... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Se você tivesse chegado mais tarde, eu não sei o que eu teria feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Não tenha medo, é só um Hilichurl, {NICKNAME} é um grande exterminador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880106,
					"content": "Muito obrigado. Então vou deixar o <color=#00E1FFFF>Balão de ar quente</color> para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880107,
					"content": "E tenha cuidado com isso. Não é preciso prestar muita atenção aos Hilichurls. <color=#00E1FFFF>A prioridade é garantir a segurança das mercadorias</color>. Porque eu e você não temos Mora para indenizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880108,
					"content": "Eu estarei esperando na frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "Ernest"
				}
			]
		},
