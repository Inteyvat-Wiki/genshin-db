				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520102,
					"content": "Columbina, você está bem? Você parece um pouco abatida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Ah, são vocês. Estou bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520104,
					"content": "(Será que ela está pensando na lua de novo...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Há algo que possamos fazer para ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520108,
					"content": "Está tudo bem! Só conta pra gente! Mesmo que seja algo pequeno, você vai se sentir muito melhor depois de colocar isso pra fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Eu... gostaria de experimentar uma bebida da taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520110,
					"content": "...O quê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "...*Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520112,
					"content": "Desculpa... A Paimon só ficou um pouco surpresa. Você nunca fala sobre querer algo para você, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "E, é só isso? Só... uma bebida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "O quê, você estava esperando que ela pensasse em algo maior?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "É, meio que sim. Pelo menos algo um pouco mais monumental... Tipo, \"Traga-me a lua.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Mas, pensando bem, até que faz sentido. A Columbina não pode ir aonde quiser agora, então uma ida à taverna pode muito bem ser como uma viagem até a lua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "Não é só por causa de como as coisas estão agora. Mesmo quando eu ainda estava com os Fatui, quando não havia nenhuma ordem para me capturar... todos ainda mantinham distância sempre que eu saía para dar uma volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520118,
					"content": "(Terceira dos Mensageiros Fatui... Esse título por si só já é suficiente para assustar quem não a conhece.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Espera aí, pensando bem... Talvez isso não seja tão difícil quanto a Paimon pensou no começo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Uma taverna está meio fora de questão, mas uma bebida... Isso sim dá pra arrumar! {NICKNAME} dá conta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "...Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520122,
					"content": "Uh, mas não crie expectativas muito altas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Alguma preferência de sabor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Sabor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520125,
					"content": "Não tenho muita experiência pedindo bebidas, então não sei bem por onde começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520126,
					"content": "Talvez algo que não seja muito... pesado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520127,
					"content": "Umm, o que você quer dizer com \"pesado\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Pesado tipo... um sobretudo dos Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520129,
					"content": "Essa comparação deixou tudo ainda mais confuso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Algo leve e delicado, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Certo. Seja o que você achar melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760520131,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
			"completionStepIds": [
				7605203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
