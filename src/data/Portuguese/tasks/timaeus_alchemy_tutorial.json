			"dialogs": [
				{
					"id": 200390401,
					"content": "Vamos começar fazendo um pouco de Óleo Essencial Chocante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "É um produto alquímico fundamental. O melhor lugar para iniciantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Para fazer o Óleo Essencial Chocante, você precisará de alguns cristais electro e um sapo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Ambos podem ser facilmente encontrados fora da cidade - O quê? Você não consegue ver uma conexão entre cristal e óleo essencial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "Hahaha, isso é porque não há! O Cristal Eletro é para o Choque. É o sapo que fornece o Óleo Essencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Depois de coletar, tente criar um pouco de Óleo Essencial Chocante. Sem meias medidas agora, dê tudo o que você tem! Eu assistirei daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "Entendi.",
