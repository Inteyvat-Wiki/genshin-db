				{
					"id": 220130602,
					"content": "... O que aconteceu? Você foi atingido por um raio? Enfim, o que vocês ouviram sobre o livro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "Hã... Junkichi, você acha que está pronto para ouvir o que os seus leitores estão dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "Como isso é possível... Eu não imaginaria que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Será que minha trama e minha forma de escrever realmente não são interessantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "Eu já lhe disse. Levar a história para frente dessa maneira é simplesmente muito arriscado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "Mesmo que se possa utilizar essas novas habilidades para obter maior popularidade com o livro, se elas forem muito exageradas, os leitores acabarão entediados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Depois de trabalhar muitos anos nessa área, essa é a minha experiência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "Eu... Eu sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Felizmente ainda temos tempo de fazer alterações... Apesar de não podermos mudar as avaliações sobre os últimos capítulos, pelo menos podemos fazer com que os próximos sejam melhores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "Obrigado, Viajante. No final das contas, Junkichi levar um choque de realidade foi uma coisa boa. Se ele continuasse escrevendo assim, com certeza acabaria com um problema ainda maior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130612,
					"content": "Obrigado, Viajante. Aqui está sua recompensa, fique com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				}
			]
		}
	]
