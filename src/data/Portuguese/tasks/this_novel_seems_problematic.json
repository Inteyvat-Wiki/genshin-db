			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Você já chegou a ver os feedbacks dos leitores? Seu romance tem perdido vários fãs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Calma, calma! Isso é o silêncio antes da tempestade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "Só com algumas reviravoltas, mudarei a situação, e meu público voltará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "Mas antes desse dia chegar, a editora já terá seu romance cancelado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "Viajante, você finalmente chegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Depois de buscar inspirações da última vez, o Junkichi tem adicionado várias habilidades extremamente exageradas ao protagonista do seu romance Espírito Marcial。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "E a Editora Yae tem recebido vários feedbacks negativos. Os leitores estão reclamando que não conseguem entender de onde vêm essas habilidades e dizendo que todo o romance está faltando lógica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "Ignore isso! Eles só precisam seguir meu ritmo e entenderão logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Por isso que falei que seu romance seria cancelado antes que seu público entendesse tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "Já chega! Se eu não me engano, aqui deve ter alguns leitores seus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Por que não dar uma perguntada a eles se você realmente está querendo saber se seus leitores gostam da sua ideia ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "Sem problema nenhum! Eles me entenderão. Viajante, posso ser ousado e pedir para você ir comigo como uma testemunha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "#Claro! Com {M#o}{F#a} Viajante, você não poderá negar a realidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Bom, então agora vamos indo! O meu público vai me entender bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Quantas coisas você adicionou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Só um pouquinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "Um pouquinho? Se continuar assim, a quantidade das habilidades do protagonista excederá o número dos personagens do romance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Cof... Vamos indo. O meu público vai me entender bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
