				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "Olá, em que posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Você já chegou a ler o Espírito Marcial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Hã? Sim, eu li ele. Antes eu gostava muito, mas, como posso dizer... Ultimamente acho que a história está um pouco estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Não importa que inimigo enfrente, o protagonista subitamente desperta e já pode lutar contra seus inimigos e em um instante derrotar eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "O porquê de eu gostar de Espírito Marcial antes era nas técnicas que o protagonista utilizava para derrotar seus inimigos, mas agora... Tenho uma sensação que o autor está com preguiça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Além disso, depois de despertar, o protagonista só utiliza a maior parte de suas habilidades uma vez. Não há muito sentido nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Não sei quais os planos que o autor tem para essa obra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "*Cof* *Cof* Bem... Vamos perguntar a outras pessoas. Isso daqui deve ser só um caso único, somente isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
