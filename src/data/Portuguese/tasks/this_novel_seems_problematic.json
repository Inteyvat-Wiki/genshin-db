					"Hasegawa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Olá. Vocês precisam de mim para alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Você já chegou a ler o Espírito Marcial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Sim. É uma ficção muito interessante. Não importa se é o protagonista, ou o desenrolar da trama, tudo é brilhante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Mas, recentemente, sinto que o autor está com um pouco de preguiça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Err... Err...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "Muitas vezes, o protagonista adquire poderes novos do nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Apesar dele ter despertado, essa forma de obter essas habilidades não deixa de ser muito sem graça, sem nenhum preço por detrás delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "Acho que uma trama preguiçosa como essa também deixa o protagonista desinteressante. Espero que o autor pense bem o que continuará fazendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "Viajante, vamos perguntar a outra pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
