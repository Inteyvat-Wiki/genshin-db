				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Um Fantasma Obcecado com Comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "#Ei, novat{M#o}{F#a}. Você não pode sair cozinhando assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330102,
					"content": "Estamos preparando rações para os Ratniki da ilha, então temos que cozinhar de acordo com o gosto deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330103,
					"content": "Esses pratos aí não servem. Primeiro, seu controle de temperatura tá péssimo, e segundo, essas coisas não combinam com a nossa dieta. Isso precisa mudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330104,
					"content": "Você ainda tem muito a aprender — sugiro começar pelos nossos pratos mais básicos, como os Cachorros-Quentes de Nod-Krai. Volte e me mostre quando terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603304",
							"2"
						],
						"stepId": 7603304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Um Fantasma Obcecado com Comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Mmm, a salsicha está bem grelhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330202,
					"content": "#Você daria um{F#a} chef auxiliar de cozinha até que razoável se estivesse trabalhando num restaurante fora daqui, eu diria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330203,
					"content": "Mas estamos preparando refeições para todos os Ratniki nesta ilha. Então não importa quão requintada a comida é, e sim se ela é farta suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330204,
					"content": "Faça o pão um pouco mais grosso. Atualmente há poucas variedades de vegetais — além da linguiça, dá pra colocar outros tipos de carne também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330205,
					"content": "Você ainda precisa de mais prática! Volte na próxima vez e prepare algumas Carnes Fritas com Frutas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603306",
							"2"
						],
						"stepId": 7603306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Um Fantasma Obcecado com Comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Hm. A carne foi cortada em pedaços generosos e depois frita no ponto certo. Nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330302,
					"content": "Mas deixa eu te lembrar: ao preparar carne frita, é preciso pensar nos acompanhamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330303,
					"content": "É fácil ficar empanturrado comendo carne demais. É pra isso que servem as frutas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330304,
					"content": "Aqui nesta ilha, somos responsáveis pela saúde alimentar de todos, então é preciso manter um equilíbrio entre vegetais e carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330305,
					"content": "Este prato não tem vegetais suficientes como acompanhamento. Isso não é aceitável por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330306,
					"content": "Você precisa praticar mais. Volte na próxima vez e faça um Frango Recheado com Lakkabaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				}
			]
		},
		{
			"id": 7603304,
			"completionStepIds": [
				7603308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7603308",
							"2"
						],
						"stepId": 7603308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Um Fantasma Obcecado com Comida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330401,
					"content": "O frango está saboroso, e há acompanhamentos suficientes. Tá tentando dificultar meu trabalho de criticar, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330402,
					"content": "#...Heh. Tanto faz. Não é como se eu estivesse procurando defeito especificamente em novat{M#os}{F#as} como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330403,
					"content": "Eu sou só um cozinheiro. Só faço meu trabalho, e quero fazê-lo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330404,
					"content": "E pra isso, me preparei de todas as formas possíveis pra chegada da Caçada Feroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				},
				{
					"id": 760330405,
					"content": "Mas é uma pena... Não consegui enviar os pratos prontos a tempo... A comida acabou derramada... derramada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Um Fantasma Obcecado com Comida"
				}
			]
		}
	]
}