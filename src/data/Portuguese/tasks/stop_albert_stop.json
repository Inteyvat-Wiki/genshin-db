				"points": []
			},
			"dialogs": [
				{
					"id": 200421001,
					"content": "O quê? Eu rondando por aí, agindo suspeitamente e tramando planos malvados? Está havendo algum mal entendimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421002
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421002,
					"content": "*Suspiro* Você conhece a Barbara? Ela é a anja de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421003,
					"content": "Muitas pessoas de Mondstadt a admiram, inclusive eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421004,
					"content": "De fato, eu sou o líder do Clube da Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421005,
					"content": "Os Cavaleiros de Favonius estarão chegando em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "D... deixe-me terminar! Eu realmente respeito a Barbara. Eu quero ser como ela, quero fazer algo por Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421007,
					"content": "Mas eu sou só uma pessoa comum, com habilidades comuns. O melhor que posso fazer é fazer uma limpeza ao redor da Catedral...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421008,
					"content": "Mas a Srta.Victoria nunca me ouve, ela sempre está me expulsando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421009
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421009,
					"content": "Recentemente, notei que ninguém varreu as folhas ao redor da Catedral por um tempo. Mas se eu tentasse explicar à Srta. Victoria, ela não entenderia ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421010
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421010,
					"content": "Você pode me ajudar a varrer as folhas? Por Mondstadt... E pela Barbara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
