					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420703,
					"content": "Sim, ele foi embora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "Finalmente acabou... O que você estava fazendo ao varrer as folhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "Não importa, suponho que sem folhas signifique uma desculpa a menos que Albert possa usar para se aproximar da catedral no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "Estes presentes são uma forma de agradecimento. Aceite-os, que o Arconte Anemo proteja você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "Se você não tiver mais nada, eu tenho que voltar ao trabalho. Você devia voltar ao seu também.",
