					"content": "O que você está procurando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "Eu? Oh, eu estou procurando por uma pessoa suspeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420104,
					"content": "O seu nome é Albert e está sempre andando ao redor da Catedral durante o dial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420105,
					"content": "Ele não parece ter boas intenções. Apenas estou preocupado de que ele esteja tramando algo ruim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420106,
					"content": "Você pode expulsá-lo para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
