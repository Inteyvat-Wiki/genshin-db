			"dialogs": [
				{
					"id": 200420601,
					"content": "Já terminou de varrer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420602
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420602,
					"content": "Sim, tudo limpo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420603
					]
				},
				{
					"id": 200420603,
					"content": "Muito obrigado. A Catedral agora está bem melhor! Eu tenho certeza de que a Barbara ficará bem mais tranquila...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420604
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420604,
					"content": "Mas, por favor, não conte a Barbara sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420605,
					"content": "O ponto aqui é para reduzir a tensão. Se contarmos a ela, só pioraria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420606,
					"content": "Como combinado, eu vou indo primeiro. Viu? Não há com o que se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420607,
					"content": "Vejo você em breve. Talvez? Quem sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
