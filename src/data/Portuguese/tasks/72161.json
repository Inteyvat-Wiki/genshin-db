					"Inaba Hisakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "#Forasteir{F#a}{M#o}, como você tem estado ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610602,
					"content": "Me desculpe, mas este lugar não é bom para hóspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610603,
					"content": "Mas... Estou feliz que você pôde vir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610604,
					"content": "Parece que você está bem melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Bem, eu lhe devo outro favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610606,
					"content": "Haha, é uma pena que eu tenha sobrevivido de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610607,
					"content": "É uma pena? E por que isso não seria bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "Quais os seus próximos planos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Ainda não pensei o que farei em seguida. Mas não creio que voltarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610611,
					"content": "Apesar do senhor Kujou Masahito não ser ruim, seu pai está pedindo que os desertores sejam capturados e punidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610612,
					"content": "Eu não posso encontrar-me acidentalmente com sua espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610613,
					"content": "Talvez eu deixe de usar esta armadura, viver sozinho assim não é nada mal também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610614,
					"content": "Mas até termos paz, não posso me enganar. Minha memória ainda me diz que sou o soldado ferido manchado de sangue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610615,
					"content": "Mas, quem sabe o que acontecerá no futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Noutras palavras, eu nunca duvidei das decisões de Sua Excelência, por isso, mesmo que eu saia, não terei nenhum arrependimento, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610619,
					"content": "Bem, a conversa subitamente se tornou pesada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "Ah, falando nisso, é hora de visitar meus antigos companheiros que ainda estão nesta ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610621,
					"content": "Na tradição de Inazuma, nós presenteamos um \"Dendróbio Sangrento\", uma flor delicada e charmosa... É um símbolo do destino dos Samurais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610622,
					"content": "Se você por acaso se encontrar com alguns de meus antigos companheiros em sua jornada, pare um pouco e conheça eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Você quer retornar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
