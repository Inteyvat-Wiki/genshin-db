					"nextDialogs": [
						721610702
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610702,
					"content": "#Ei, forasteir{F#a}{M#o}, tenha cuidado com piratas se você estiver andando por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610703
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610703,
					"content": "#Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610704
					]
				},
				{
					"id": 721610704,
					"content": "De nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610705,
					"content": "Eles não são rivais à minha altura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "#Haha, presunços{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610707,
					"content": "Quando se livrar deles é que você pode me dizer isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610708,
					"content": "Fechado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "Tudo bem, combinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Hisakura"
				}
			]
		},
