			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Hisakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610301,
					"content": "Você está de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610302,
					"content": "Resolvido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "Uh... A atmosfera ficou estranha do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610305,
					"content": "#Desculpe por pedir a {F#uma}{M#um} forasteir{F#a}{M#o} como você para fazer tal trabalho sujo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610306,
					"content": "Você com certeza não parecia tão educado assim quando nos conhecemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610309,
					"content": "Já utilizei todas as ervas medicinais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610310,
					"content": "Utilizei elas para aplicar no ferimento, mas ele ainda está inflamado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610311,
					"content": "Mas não precisa se preocupar comigo, posso continuar aguentando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610312,
					"content": "Cuide de seus próprios problemas, vá indo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610313,
					"content": "Você é igual a uma criança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610315,
					"content": "O que você disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610316,
					"content": "Estamos falando de você, e você é como uma criança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610317,
					"content": "Você claramente não está bem, parece que está quase para implorar por ajuda, mas ainda assim age como se fosse alguém durão... Você não é franco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610318,
					"content": "Apenas crianças fazem isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610319,
					"content": "E não se esqueça, Hisakura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610320,
					"content": "Você ainda nos deve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "#Hmph... Vocês {F#duas}{M#dois}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610323,
					"content": "Nesse caso, por favor, tragam-me Erva Naku. Pode ser encontrada em qualquer canto dessa ilha. Folhas completas são as melhores, pois sua polpa pode ser espremida antes de ser aplicada externamente para reduzir a inflamação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610324,
					"content": "Isso é tudo. Vou agora tirar uma soneca, por favor, me deixe descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610321,
					"content": "Nós viemos aqui para ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "Seu ferimento está melhor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Você agora deve ter um pouco de paz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
