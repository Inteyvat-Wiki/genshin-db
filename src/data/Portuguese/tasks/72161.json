				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611301,
					"content": "#{F#Uma forasteira}{M#Um forasteiro}? Interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611302
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611302,
					"content": "#Se você for apenas {F#uma}{M#um} turista, está no lugar errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611303,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "O quê? Você é do Shogunato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611305,
					"content": "Não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "Então cuide de sua própria vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611307,
					"content": "Que cara mal educado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611308,
					"content": "Sou do Shogunato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "#Bem, vocês forasteir{F#as}{M#os}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611310,
					"content": "Na frente do Comissário, imploram como cães abanando seus rabos, pedindo sobras para comer. E na frente dos Samurai de Inazuma, podem agir arrogantemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611311,
					"content": "Andando por aí, espionando todos, criando problemas... E agora vem aqui, até esse barco destruído, não se sabe por qual razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611312,
					"content": "É uma pena que eu sou um mero soldado ferido. Não há nada que possa fazer por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611313,
					"content": "Por isso, saia daqui com suas próprias pernas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611314,
					"content": "Será que esse cara não falar simpaticamente de maneira alguma?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611315,
					"content": "Ei! Vocês aí são muito barulhentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611316,
					"content": "Antes de partirem, deixem-me lhes dar um conselho: não fiquem na Ilha Yashiori por muito tempo. Essa ilha foi amaldiçoada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611317,
					"content": "Maldição...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "#Você é surd{F#a}{M#o}? Essa ilha é amaldiçoada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611319,
					"content": "A guerra estagnada, os desejos dos nobres, o desespero do povo comum, o ódio das vítimas inocentes, o cheiro de poções enchendo as salas dos idosos morrendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611320,
					"content": "Em uma palavra, amaldiçoada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611321,
					"content": "#É melhor você aproveitar sair enquanto ainda não é destruid{F#a}{M#o} por ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611322,
					"content": "Bem, Paimon não entende nada. Que pessoa estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7216114,
			"completionStepIds": [],
