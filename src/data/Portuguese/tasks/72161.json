			},
			"dialogs": [
				{
					"id": 721611401,
					"content": "Você de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611402,
					"content": "Eu já não te disse que... Ai, deixa para lá. Faça o que você quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611403,
					"content": "#Não bagunce as minhas coisas, ainda tenho uns suprimentos de bordo para compartilhar com você. Caia fora assim que estiver satisfeit{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611404,
					"content": "Precisa de alguma ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "Não preciso. Você não enxerga que eu estou muito bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611406,
					"content": "Mas a sua ferida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "É minha ferida e não sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611408,
					"content": "Ei, só estamos tentando ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Então deixo ajudar vocês com uma dica também: parem de encher a minha paciência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611410,
					"content": "Eu posso ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "Como? Me entregando para as tropas do Shogunato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611412,
					"content": "Haha, lhe aconselho a não ser estúpido... Eu serei tratado como um desertor. O senhor Kujou nunca mostrou misericórdia para com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611413,
					"content": "Se você quiser realmente me ajudar, me deixe em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721611414,
					"content": "Nossa, que cara teimoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
