					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610506,
					"content": "Não, não é que eu esteja lhe expulsando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610507,
