			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Inaba Hisakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Urgh, que humilhação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610102,
					"content": "Ei! Nós salvamos sua vida! O que você quer dizer com \"que humilhação\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "Ele está falando de si mesmo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "#E pensar que eu tinha de ser resgatado por forasteir{F#as}{M#os}, e até mesmo ser julgados por el{F#as}{M#es}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610106,
					"content": "Mas, voltando ao ponto, senhor Samurai, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610108,
					"content": "Ele parece estar bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "#Devo-lhe uma, forasteir{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610111,
					"content": "E você lutou bem agora há pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610112,
					"content": "#Me chamo {NICKNAME}, é um prazer lhe conhecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "#Não me subestime, forasteir{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610114,
					"content": "...Inaba Tousaburou Hisakura. Só me chame de Hisakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610115,
					"content": "Que pessoas são aquelas ali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "São piratas. A Praia Nazuchi possui muitas fortalezas deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610118,
					"content": "Os bandidos espalhados, mineradores e pescadores desempregados, fugitivos do Decreto de Caça à Visão, os guerreiros perdidos em lutas às vezes se reúnem e se tornam ladrões, tentando escapar dos castigos da poderosa Ogosho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610119,
					"content": "Não importa se você chama eles de Vagantes ou Kairagis, são todos bandidos... Nós estamos combatendo eles há um tempo, até que os rebeldes destruíram o Amuleto na ilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610120,
					"content": "Os refugiados de Tatarasuna e da mina fugiram rapidamente, e alguns desses ratos escaparam até aqui, juntando-se a esses piratas e os tornando ainda piores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610121,
					"content": "O grupo de piratas de antes veio do campo ao sul, e eles tinham seus olhos na carga do navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610122,
					"content": "É uma pena que arruinei os planos deles, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610123,
					"content": "Esse barco aqui não é seu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Esse barco? Era dos rebeldes de Sangonomiya. Não tenho tanta certeza assim... De qualquer maneira, quando eu vim, já estava abandonado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610125,
					"content": "Eu passei a viver nele como um caranguejo ermitão até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610126,
					"content": "Haha, já faz um bom tempo desde que falei tanto assim. Realmente é bem cansativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610127,
					"content": "Se você não se importar, precisarei de sua ajuda com algo. Quando meus ferimentos estiverem curados, certamente pagarei esse favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610128,
					"content": "Agora há pouco mencionei que há um acampamento de piratas nas proximidades. Gostaria que você se livrasse dele para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610129,
					"content": "Essa é a única maneira de impedi-los de retornar e me importunarem como se fossem uma matilha de cães de rua. Talvez isso até mostre para os outros acampamentos piratas que eles não devem ter a audácia de atacar este barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610130,
					"content": "E também me permitirá ver do que você é capaz, o que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610131,
					"content": "Sim, facílimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "#Haha, você é muito presunços{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610134,
					"content": "#Oh sim, forasteir{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610135,
					"content": "Não seja tão arrogante, tome cuidado para não quebrar sua perna quando chegar a hora de correr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Hisakura"
				},
				{
					"id": 721610132,
					"content": "Já volto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Por que você estava sendo atacado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Claramente sua autoconfiança foi ferida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "Isso é algo próprio dos Samurais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
		{
