			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "Oh não... Como isso foi acontecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "Viajante, eu estava justamente te procurando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "Você ainda se lembra de Konda Densuke? Ele veio à loja há vários dias, perguntando sobre os fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "Ele está satisfeito com os fertilizantes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "Eu não diria dessa forma. Francamente falando, eu acho que o Sr. Konda Densuke está se sentindo perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "Perplexo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Bem, é o seguinte. Após sua promoção anterior, o Sr. Densuke utilizou nossos fertilizantes de acordo com suas instruções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "No entanto, embora as plantações tenham crescido bem, ao mesmo tempo... Muitos cogumelos surgiram do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "Para ser honesto, depois que o Sr. Konda me falou sobre isso, também me sinto um pouco perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "Mas de qualquer forma, definitivamente tem algo a ver com os fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "Viajante, você poderia, por favor, ir até a Vila Konda e ajudar o Sr. Konda a retirar esses cogumelos de seus campos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "Certo. Estarei fazendo algumas pesquisas na loja para ver o que exatamente causou isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "*Suspiro* Se ao menos a Alrani estivesse aqui. Ela definitivamente já teria encontrado a causa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "Que tal pedirmos à Alrani que resolva esse problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "Se ela estivesse aqui, teríamos descoberto bem rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "Mas ela ainda não voltou, e não tenho ideia de para onde ela foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "Eu só posso contar com você, Viajante. Estarei fazendo algumas pesquisas na loja para ver o que exatamente causou isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203702,
