			},
			"dialogs": [
				{
					"id": 220370201,
					"content": "Qual é a desses cogumelos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "Estou aqui para limpar os cogumelos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "#Você foi enviad{M#o}{F#a} pelo Sr. Vahid para me ajudar a limpá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "Hmm, então fique a vontade. Tem muitos cogumelos no campo. Não é um trabalho para uns ossos velhos como eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "Como esses cogumelos podem ter crescido tão rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "Desculpe pelos cogumelos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Oh, os cogumelos? Bem, não há falta deles na minha mesa de jantar, isso é certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
		{
			"id": 2203703,
			"completionStepIds": [
				2203703
			],
