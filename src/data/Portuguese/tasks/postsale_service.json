			"dialogs": [
				{
					"id": 220370301,
					"content": "Você já colheu tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Todos os cogumelos estão aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "Só isso? Eu me lembro de que tinha bem mais que isso. Você realmente limpou todos eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "De qualquer forma, você tem meu agradecimento, jovem. Aceite isso como pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "Devo dizer que esses fertilizantes são incríveis. Os cogumelos cresceram rapidamente. Se ao menos eles pudessem ajudar as plantações a crescer tão rápido também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Quando eu tiver tempo, com certeza irei comprar mais um pouco e experimentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
