					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370406
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370406,
					"content": "Obrigado, jovem. Realmente não sei o que faria sem a sua ajuda. Tome isto como símbolo de minha gratidão.",
