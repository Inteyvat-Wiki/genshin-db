			"dialogs": [
				{
					"id": 747120101,
					"content": "#{NICKNAME}, Paimon, tenho ótimas notícias. Deu tudo certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120102,
					"content": "A Operação de Resgate dos Peixinhos foi um grande sucesso~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120103,
					"content": "Assim que os mergulhadores removerem todos os detritos subaquáticos e nossos pacientes ficarem mais calmos, poderemos devolvê-los à natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120104,
					"content": "#Muito obrigad{M#o}{F#a} por todo o seu trabalho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "Hehe, você também trabalhou tanto quanto nós, Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120106,
					"content": "Eu escrevi um relatório de incidente e o submeti ao Palais Mermonia. Um especialista nessa área deve estar elaborando as regulamentações pertinentes e notificará as agências apropriadas em breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120107,
					"content": "Também ouvi dizer que alguns repórteres e pelo menos um diretor demonstraram grande interesse neste assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120108,
					"content": "Quem sabe um dia não veremos até um filme sobre a importância de proteger os ambientes aquáticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120109,
					"content": "Seria incrível! Por mais que a gente tente conversar com as pessoas, sempre vai ter aqueles descuidados ou teimosos que simplesmente não vão ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120110,
					"content": "Eles precisam ver algo realmente assustador... Fazê-los pensar que se o ambiente for completamente arruinado... os peixes vão sofrer mutação e se tornar monstros gigantes super invencíveis e destruir tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120111,
					"content": "Dar os pesadelos mais assustadores e aterrorizantes para todo mundo que joga lixo no mar — assim eles vão aprender a respeitar a natureza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120112,
					"content": "Que ideia maravilhosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		}
	]
}