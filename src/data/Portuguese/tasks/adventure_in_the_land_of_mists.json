			"dialogs": [
				{
					"id": 751330301,
					"content": "#Está aberto! Você é incrível, {REALNAME[ID(2)|SHOWHOST(true)]}! Não teríamos encontrado o mecanismo sem você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#Eu sabia que você conseguiria, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Mas não se empolgue demais. Muitos desafios ainda nos aguardam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Agora que a entrada está aberta, não há motivo para desistir no meio do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Eu concordo, pequena Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Cheep... Cheep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330308,
					"content": "O que foi? Por que você não quer entrar? Está com medo? Já estamos no meio da nossa jornada, não dá para voltar atrás agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Coo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330310,
					"content": "Você não deveria forçar a situação, Bona. Ele realmente parece estar super assustado. Será que tem algo extremamente perigoso lá embaixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Assustador!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Agora, sério? Vamos lá, se controle como {REALNAME[ID(2)|SHOWHOST(true)]}, por que não faz o mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "Isso é meio empolgante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "Paimon não achava que você ficaria tão animada. Mas provavelmente você consegue enfrentar qualquer um que encontrarmos lá embaixo, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Não se preocupe, nosso pequeno Sauriano é uma alma corajosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Rawr... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Se Coco realmente está com medo, talvez deveríamos deixar ele para trás... Mas, não sozinho. Isso não seria bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Acho que não tem outro jeito. Ficarei com Coco aqui em cima. Você pode ficar com a Pyrofosforita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Mas, seja o que você encontrar lá embaixo, você tem que voltar e me encontrar, entendeu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330320,
					"content": "Não deixamos ninguém para trás.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
					"id": 751330321,
					"content": "Acredito em você. Esperaremos por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330322
					],
					"speakerTitle": "Bona"
				},
