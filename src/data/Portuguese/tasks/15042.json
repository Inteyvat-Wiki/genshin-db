			"dialogs": [
				{
					"id": 150420101,
					"content": "Uhuuul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "Luz do Sol, ondas, e Koholassauros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "Ela está tão animada, é quase se ela esqueceu totalmente que seu Nome Antigo é \"Umo{RUBY#[S]União}ja\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "Rápido, por aqui! Vamos lá, galera, mais rápido... Corram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "Estamos indo, estamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "Olha, o que você acha que isso é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Uma tábua de madeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "Leia as palavras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Ohhh, é um mapa turístico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "Exatamente, um mapa turístico! É como uma chave para um cofre de tesouros incalculáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Eu entendo você total! Mapas como esse marcam o começo de uma aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "Também é como uma brasa ardente de Flogisto, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "Flogisto? Uh... Isso é um tipo de energia, certo? Você quer dizer como se... Somente um olhar fosse o suficiente para te encher de motivação ilimitada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "Exatamente! E porque é muito importante, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Com um mapa em suas mãos, que pode ser consultado sempre que necessário, você está livre para traçar seu próprio caminho de aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Hehe, liberdade e aventura nos esperam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Espera um minuto, não concorde tão rápido assim come ela... Por que a Paimon sente que Mualani está escondendo alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "Está bem, todo mundo, sintam-se livres para explorar sozinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "Que tipo de guia turístico simplesmente encerra seu dia assim que ele chega a um ponto turístico?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Você acha que a Mualani só quer ir embora sozinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#Hehe, você é um{F#a} ótim{M#o}{F#a} amig{M#o}{F#a}. Eu não vou esquecer do seu apoio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Aqui, deem uma olhada nisso. Essas duas atrações principais foram marcadas com \"Sob Testes\". Minha suposição é que eles encontraram alguns problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "Por que não nos separamos e verificamos as atrações que mais nos animam? Nós vamos nos divertir enquanto ajudamos com os testes. Talvez até consigamos colocar a Baía das Ondas para funcionar antes do esperado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "E cá estava a Paimon, pensando que você iria abandonar a gente assim que você conseguisse sua dose de esportes aquáticos. Parece que você estava pensando pelo grupo todo, afinal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Hehe, por que não nos reagrupamos perto daquele estrutura giagnte de Koholassauro quando tivermos terminados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "Com base na intuição que adquiri em anos de experiência como guia, gostaria de apostar que a entrada para o desafio principal está por ali por perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "Beleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Certo então, vamos nos separar. Não se esqueçam de verificar o mapa constantemente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "Parece que nossa \"guia\" está de férias hoje também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
