			},
			"dialogs": [
				{
					"id": 752520701,
					"content": "Mais importante é se você viu um careca por aqui? Preciso falar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Essa é a pessoa que estou procurando também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Ah, ele estava aqui agora há pouco? Acho que deve ter me visto chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Tsc. Você vai me pagar por isso, Icahua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Como já nos encontramos antes e você parece uma boa pessoa, vou te avisar: mantenha distância daquele patife desprovido de cabelo — caso contrário, esse seu rostinho bonito pode acabar coberto de tinta vermelha e branca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Essas são as coisas que encontrei no acampamento dele. Acho que não teve tempo de levá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "É seu. Não se preocupe, ele não tem direito de dizer o contrário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Mais cedo ou mais tarde, a vida dele será minha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "Não vimos ele, desculpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Está me dizendo a verdade? Por enquanto, estou inclinada a confiar nesse seu rostinho honesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
