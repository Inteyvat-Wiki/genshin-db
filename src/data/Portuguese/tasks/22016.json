			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "Esses dois realmente são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "Você parece não confiar muito nele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "Hã? Você está falando de Kamei Munehisa? Claro que não confio tanto. Só nos vimos algumas vezes, como poderia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "Mas, apesar de não confiar nele, tenho confiança no julgamento de Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "Você é da Academia de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Bem, pode-se dizer que sim. Originalmente eu parti da Academia de Sumeru como uma estudante Viajante, e conheci Xudong em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "Ele queria viajar por todo o mundo para aprender novas receitas, e minha pesquisa estava relacionada a comida. Depois de discutirmos algumas vezes, decidimos viajar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "Fomos primeiro para Mondstadt e alguns monstros nos atacaram, mas Julie nos protegeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "Ela ouviu dizer que nós estávamos viajando pelo mundo em busca de novas comidas, e se juntou a nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "Apesar dela falar que originalmente planejava se aventurar pelo mundo, nós sempre pensamos que o que ela queria mesmo era comer coisas deliciosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "Nossa próxima parada deve ser Sumeru. Minha pesquisa está quase completa, então também tenho que retornar para a Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "Quando chegar em Sumeru, com certeza levarei eles para provarem as especialidades locais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
