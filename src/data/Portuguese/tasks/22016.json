					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "*Cof* *Cof* Fui derrotado por aqueles desgraçados. Agora todos vocês rirão de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160402,
					"content": "Senhor, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160403,
					"content": "Eu só perdi alguns movimentos, sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160404,
					"content": "Julie, agora você pode nos explicar exatamente o que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160405,
					"content": "Conte-me tudo, por favor, ou meus livros foram destruídos por nada... Ahh, as páginas estão todas amassadas agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160406,
					"content": "É muito simples... Eu só queria dar alguma comida para aquele Samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160407,
					"content": "Vocês só se viram uma vez, por que pensou em confiar nele?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160408,
					"content": "Ele é uma boa pessoa! Naquela hora, ele claramente estava com fome, e ainda assim estava disposto a compartilhar o pouco que tinha conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160409,
					"content": "Entenda, uma pessoa que está com fome e mesmo assim divide sua comida só pode ser uma pessoa boa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160410,
					"content": "Esse ponto de vista de bem e mal é muito simplista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160411,
					"content": "Você parece que não está vivendo em Teyvat, mas em algum mundo de contos de fada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160412,
					"content": "Hahaha, mas creio que Julie falou bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160413,
					"content": "Eu só penso que uma pessoa que está com fome e mantém sua atitude com certeza não é uma pessoa ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160414,
					"content": "Essa lógica é bem simples...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "Enfim, Julie, continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160416,
					"content": "Eu fiz um Espeto de Frango com Cogumelos, e pensei em ir ao primeiro lugar que nos encontramos para ver se tinha alguma sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160417,
					"content": "Depois, fui até ali e acabei encontrando com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160418,
					"content": "Mas quando pensei em chamar por ele, descobri que estava junto com alguns Kairagis, e pareciam estar falando alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160419,
					"content": "Imediatamente pensei em me afastar, mas fui descoberta por um Kairagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160420,
					"content": "Então deixe o resto comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160421,
					"content": "Dentre essas pessoas, algumas delas eram velhos amigos meus, quando trabalhávamos para a Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160422,
					"content": "Após as mudanças repentinas em Inazuma, nós saímos do Shogunato, cada um seguindo seu próprio caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160423,
					"content": "Então agora há pouco eles estavam fazendo seu ganha-pão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "Isso mesmo... Não sabemos fazer mais nada que não seja envolvendo uma espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160432,
					"content": "Depois disso, eles tornaram-se nos Kairagis que vocês conhecem hoje, e passaram a viver de saques e botins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160433,
					"content": "Eu não queria ter nenhuma relação com eles, por isso passei a vagrar pelo país, procurando por trabalho em meu caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160434,
					"content": "Mas depois de ouvirem que eu era um Samurai que havia saído do Shogunato, ninguém tinha a coragem de me empregar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160435,
					"content": "E depois disso, como vocês podem ver, só me restou ir para as florestas em busca do que comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160436,
					"content": "Nos últimos dias, parece que meus antigos colegas necessitavam de mais membros, e por isso vinham até mim diariamente pedir por minha ajuda, e todas as vezes eu recusava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160437,
					"content": "Mas hoje, depois que Julie apareceu, pensaram que eu entrei em algum clã, e que tinha ido até lá lutar contra eles. Por isso que me atacaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160438,
					"content": "Não faz sentido algum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "O que eles falaram nunca fez sentido algum, mas na situação que eles se encontravam, não havia sentido nenhum para falar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160444,
					"content": "E depois eu fiquei esperando aqui até ele lidar com aqueles bastardos e retornar, até que um grupo de monstros apareceu do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160445,
					"content": "Você não deveria conseguir lutar contra eles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "Geralmente sim. Mas não comi hoje cedo, e não tenho forças com uma barriga vazia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160447,
					"content": "E quando fui descoberta por aqueles Kairagis, acabei perdendo meus Espetos de Frango com Cogumelos... Ainda bem que esse Samurai me protegeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160448,
					"content": "É por isso que comer o café da manhã é importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "Existem muitos outros grupos de Kairagis em Inazuma que não querem dialogar. Se formos ficar em Inazuma por mais tempo, temo que sempre estaremos correndo perigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160451,
					"content": "E nós só podemos lidar com alguns monstros fracos, mas não somos hábeis o suficiente para lutar contra essas pessoas treinadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160452,
					"content": "Uh... Senhor Samurai, você falou agora há pouco que estava procurando por trabalho, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160453,
					"content": "Se estiver interessado, por que não se junta a nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160454,
					"content": "Que legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160455,
					"content": "Mas ele não é um Samurai que saiu do Shogunato? Com certeza acabará atraindo problemas em Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160456,
					"content": "... Isso é verdade. Com esse meu passado, se viajar junto com vocês, temo que possa acabar lhes machucando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160457,
					"content": "Hahaha, não tem problema. Nós só estamos viajando em busca de ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160458,
					"content": "Nosso trabalho não tem nenhuma relação com o Shogunato e os Samurais, será perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160459,
					"content": "Se você realmente viesse como nosso guarda-costas, ou ainda que apenas para nos ajudar, então sim chamaria atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160460,
					"content": "Além disso, não há porque ver uma pessoa boa passar fome. Isso é inaceitável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160461,
					"content": "Como um Chef, não posso ignorar isso. Apesar de não poder resolver muitos outros problemas, pelo menos posso garantir que você não tenha fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160462,
					"content": "Eu... Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160463,
					"content": "Hehe, o que acha? Quer vir junto conosco? Apesar desse trabalho não render muito dinheiro, você com certeza não passará fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160464,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160465,
					"content": "À suas ordens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160466,
					"content": "Que legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160467,
					"content": "Creio que isso seja uma boa ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160468,
					"content": "Ótimo! Todos já trabalharam muito, tenho certeza que estão com fome. Apesar de aqui não ser fácil de cozinhar, posso pensar em alguma maneira de fazê-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160469,
					"content": "Viajante, espere um pouco, prepararei sua refeição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160470,
					"content": "Bem, hora de começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160471,
					"content": "Assim está bom... Hahaha, usei o que estava fazendo para cozinhar esses Onigiris. Apesar de não estarem tão refinados, devem encher a barriga. Vamos comer, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160472,
					"content": "Oh, sim. Viajante. Muito obrigado pela sua ajuda. Fique com esta receita. Munehisa deu ela para mim, e fiz uma cópia para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160473,
					"content": "#Ele disse que é uma receita característica de quando estava no Shogunato. Se você estiver interessad{F#a}{M#o}, pode aprendê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160474,
					"content": "Está bem, chega de conversa fiada, vamos comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160449,
					"content": "Lembre-se de comer o café da manhã na próxima vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "Que sensíveis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "Na situação deles, estarem sensíveis é normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160442,
					"content": "Mas creio que eles na verdade só estavam procurando por um pretextos para acabarem comigo e mostrarem sua força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160443,
					"content": "Afinal de contas, eu recusei seus convites diversas vezes, e isso deve ter deixado-os muito irritados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160425,
					"content": "Será que todos aqueles Kairagis são...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "Também não. Mas todos são apenas covardes que brandem suas espadas contra pessoas fracas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160427,
					"content": "Por que você saiu do Shogunato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "Bem... Eu apenas não aprovava como os métodos do Shogunato em Inazuma, somente isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160429,
					"content": "Eu sou apenas um guerreiro, e não sei de fato qual a forma mais benéfica de se lidar com um país.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160430,
					"content": "Mas eu sei que o que o Shogunato estava fazendo não estava de acordo com o meu coração. Por isso, eu decidi sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160431,
					"content": "Haha, talvez eu seja muito antiquado, e não saiba mudar... Riam de mim se quiserem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
