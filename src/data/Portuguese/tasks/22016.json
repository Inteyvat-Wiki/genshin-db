			"dialogs": [
				{
					"id": 220160601,
					"content": "Hehe, isso aqui está delicioso, quero comer mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160602,
					"content": "Por que você quer dar comida para ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "Bem, eu só não quero ver ele com fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160604,
					"content": "Além disso, quando o vi pela última vez, estava com uma aparência muito triste. Pensei que talvez pudesse ser pela fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160605,
					"content": "Por isso que quero dar algo de comer para ele. Se estiver satisfeito, não ficará assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160606,
					"content": "Por que você confia nele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "É... É só uma intuição de uma Aventureira. Eu sei distinguir bem entre pessoas boas e ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160608,
					"content": "Eu também penso de verdade que se nas horas que se tem fome, e ainda assim se divide sua comida com outras pessoas... Somente uma pessoa boa faria isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160609,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "Adeus. Com certeza me lembrarei depois de comer o café da manhã, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
			"id": 2201607,
