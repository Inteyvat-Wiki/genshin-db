			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "Parvaneh? Viajante? O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160202,
					"content": "Eu vim ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "Mesmo? Muito obrigado. Parece que Julie foi para as profundezas da natureza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160204,
					"content": "Tem muitos monstros por ali. Se fossemos apenas nós dois, seria muito difícil lidar com esses monstros, mas com a sua ajuda, conseguiremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160210,
					"content": "Vamos indo. Julie deve estar dentro da floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160205,
					"content": "Vim atrás de você porque ainda me devem uma refeição.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "Não tem problema. Mas se depender somente de mim, não poderei preparar essa comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160207,
					"content": "Viajante, por favor nos ajude a encontrar Julie, o que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160208,
					"content": "Ela deve ter ido para algum local longe, e lá devem ter muitos monstros. Se fossemos apenas nós dois, seria muito difícil lidar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160209,
					"content": "Depois que trouxermos Julie de volte, lhe prepararei a refeição que lhe devo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh",
					"Xudong",
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "Seu maldito... Se você quebra a panela, como que nós poderemos cozinhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160302,
					"content": "Não subestime as técnicas de fundição de panelas de Liyue! Essa panela daqui foi feita utilizando um ferro especial, pode também ser utilizada como uma arma, com certeza não se quebrará tão facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160303,
					"content": "Entretanto, são apenas alguns monstros. Se ela não pudesse derrubá-los, ainda seria considerada uma panela de ferro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160304,
					"content": "Suas expectativas com essa panela de ferro são um pouco exageradas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160305,
					"content": "Xudong, você realmente é muito energético.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "Claro, isso é parte obrigatória do curso de se tornar um Chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160307,
					"content": "Por que Chefs precisam aprender a usar uma panela para derrotar monstros?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160315,
					"content": "Está bem. Julie, vamos sair logo daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160316,
					"content": "Espere um pouco, por favor ajude aquele senhor. Ele foi lutar sozinho contra os Kairagis dentro da floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160317,
					"content": "Kairagis? Não são monstros? Por que você se envolveu com esse cara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160318,
					"content": "Depois eu explico... Por favor ajude ele logo, ele está sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160319,
					"content": "Está bem. Viajante, por favor, nos acompanhe mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160320,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "Não há tempo a perder, vamos logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160321,
					"content": "Você quer lutar contra os Kairagis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "Claro que sim, quero testar usar essa panela contra ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160323,
					"content": "Além disso, um Chef não pode fugir de um desafio quando ele se aproxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160324,
					"content": "Dito isso, não tenha expectativas tão altas quando se trata de um Chef e de sua panela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160308,
					"content": "Bem, onde é possível comprar uma panela como essa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "Hahaha, boa pergunta. Ela foi feita especialmente por Hanfeng, do Ferro de Hanfeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160310,
					"content": "Ele disse que foi até as profundezas do Despenhadeiro procurar os materiais para fazer essa panela. Se você quer comprar uma, pode procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160311,
					"content": "Entretanto, ouvi dizer que o Despenhadeiro estava fechado há muito tempo. Mesmo que você encontrasse ele agora, não poderia fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160312,
					"content": "Parvaneh realmente é muito disposta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "Hã? Bem ... hahaha, eu apenas joguei alguns livros na cabeça do monstro. Você foi aquele que expulsou eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160314,
					"content": "Espere. Onde está o \"Juntamente com a Divindade - Volume 6\"? Você jogou também? Eu não terminei esse ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201604,
