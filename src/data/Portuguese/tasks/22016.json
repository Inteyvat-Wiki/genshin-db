				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160501,
					"content": "Oh... Eu estou cheio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160502,
						220160513
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160502,
					"content": "Por que você quer ajudar ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160503
					]
				},
				{
					"id": 220160503,
					"content": "Quem? Munehisa? Oh, isso é só parte da moral de um Chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160504
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160504,
					"content": "Vocês até podem rir de mim, mas eu realmente não desejo ver uma pessoa boa passando fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160505
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160505,
					"content": "Não... Eu deveria dizer que não quero ver qualquer pessoa passando fome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160506
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160506,
					"content": "Fome é uma sensação aterradora. Eu já senti isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160507
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160507,
					"content": "Sob a fome, as pessoas podem fazer coisas terríveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160508
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160508,
					"content": "Penso que se todas as pessoas nesse mundo pudessem comer, poderíamos evitar que muitas coisas más acontecessem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160509
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160509,
					"content": "Apesar de eu sozinho não ser capaz de fazer isso, pelo menos posso ser um Chef, e me esforçar para que as pessoas ao meu lado comam bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160510
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160510,
					"content": "Hahaha, francamente, só quero que todos comam até ficarem cheios. É um ideal muito sem graça, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160511
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160511,
					"content": "É um ideal gigantesco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160512
					]
				},
				{
					"id": 220160512,
					"content": "Hehe, muito obrigado. Uh, já estou falando demais, comam logo, não deixem nada sobrando, isso é um pecado enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160513,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160514
					]
				},
				{
					"id": 220160514,
					"content": "Você já está indo? Não vai comer mais um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
