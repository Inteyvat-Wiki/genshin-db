					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "Eu quero passear no Carrinho Piuí com a Srta. Grande Estrategista! Sobe, sobe, sobe e... URRUUUL! Mas uh, acho que o passeio deixa ela um pouco tonta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Ah, então você percebeu? Muito bem. Foram as estrelas girando nos olhos confusos dela que a entregaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Uhum, ontem ela tinha um monte de estrelinhas douradas flutuando ao redor dela. Mas tem muito menos hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Se minha mãe estivesse aqui, ela provavelmente diria que as estrelas são peixes que caíram nas nuvens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
