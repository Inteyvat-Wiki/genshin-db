			"dialogs": [
				{
					"id": 401181101,
					"content": "Esta é a primeira vez que tomei chá que tem esse gosto. Parece que o chá de Inazuma é bem diferente do que temos em Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah sim, parece que as pessoas em Sumeru gostam de colocar especiarias no chá, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Sim, isso mesmo! Mas eu ainda não consegui me acostumar... Se eu tivesse que escolher, eu beberia café, mesmo que ele me dê insônia às vezes.",
					"roleType": "TALK_ROLE_NPC",
