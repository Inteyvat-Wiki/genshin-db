				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Como um descendente do ilustre Clã Lawrence, aprendi muitas habilidades durante minha jornada, por exemplo... assar pães folha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Ótimo, essa deve a quantidade exata de calor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Eu não tinha ideia que você saberia cozinhar... Pensava que você seria o tipo que jamais se aproximasse da cozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Ah, eu queria te perguntar... Você tem tempo mais tarde? Poderia me ensinar a fazer aqueles seus deliciosos lanches?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Oh? Mas isso pode demorar um tempo. Além disso, não estamos aqui para estreitar laços familiares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Então você está preocupada de novo com nossos laços dentro da família Lawrence, tudo bem... Mas você mesma disse que somos apenas gente comum, então por que não aprendemos um com o outro como primos normais fariam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
