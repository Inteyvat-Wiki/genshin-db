			"trigger": {
				"objectNames": [
					"José dos Seis Dedos"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#Ei, olá {F#amiga}{M#amigo}! Deseja ouvir minha nova música?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100402,
					"content": "Sobre o recrutamento da Guilda de Aventureiros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "Recrutamento da Guilda de Aventureiros? Desculpe, eu não tenho interesse. Uma vida errante não ajuda em nada a minha criação de poemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100404,
					"content": "Ainda por cima, se for para compor uma epopeia... Os protagonistas devem ser os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100405,
					"content": "Desculpe, não tenho interesse em recrutamento da Guilda de Aventureiros. Não serve para nada ser um aventureiro que apenas ajuda a pegar os gatos perdidos, e também não vejo nenhum benefício para a minha composição de poemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100406,
					"content": "Isso é o material relacionado ao recrutamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "Aqui... É a vista na Montanha Nevada? Parece ótima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100408,
					"content": "Se eu puder visitar um lugar desses, poderia encontrar novas inspirações. E aqui perto, não me parece muito perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100409,
					"content": "Bom... Depois eu vou perguntar na Guilda de Aventureiros. Mesmo que não me junte à Guilda, posso contratar um aventureiro para me acompanhar para dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "José dos Seis Dedos"
				},
				{
					"id": 700100410,
					"content": "Visite a Montanha Nevada... Parece bem interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "José dos Seis Dedos"
				}
			]
		},
