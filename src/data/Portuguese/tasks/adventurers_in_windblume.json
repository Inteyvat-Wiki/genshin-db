				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "Uh? Você precisa de algo? Estou para começar a cantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100502,
					"content": "Sobre o recrutamento da Guilda de Aventureiros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Você está falando sobre aquilo? Na verdade eu já vi o anúncio, mas eu não tenho interesse nisso. Além disso, as minhas músicas já podem proteger Mondstadt, e eu não preciso me juntar à Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100504,
					"content": "Mesmo que me junte à Guilda de Aventureiros, passo a maior parte do meu tempo fazendo trabalhos triviais. Isso não serve para nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100505,
					"content": "Não tenho interesse na Guilda de Aventureiros. Desculpe, mas obrigada por vir perguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100506,
					"content": "Isso é o material relacionado ao recrutamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "Uh? Isso é a Montanha Nevada, não é? Essa Estátua dos Sete no meio da neve tem um certo toque... Artístico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100508,
					"content": "Ah! Aqui é muito alto, né? Os meus familiares dizem que a Montanha Nevada é muito alta. Então eu acho que a minha voz pode viajar muito mais longe se eu cantar no pico dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100509,
					"content": "Depois irei até a Guilda de Aventureiros fazer umas perguntas. Me lembro que lá é possível contratar alguns aventureiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100510,
					"content": "Porém, é interessante que os aventureiros conseguem ir até esse lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Helen"
				}
			]
		},
