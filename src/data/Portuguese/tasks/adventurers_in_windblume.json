					"speakerTitle": "Iris"
				},
				{
					"id": 700100703,
					"content": "Ajudei Cyrus a conseguir algumas informações...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "O que será que ele está fazendo... Uh? Que carta é essa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100705,
					"content": "Está escrito nessa carta a situação recente da Guilda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Entendi! Realmente a carta é muito longa! Parece que... Ele realmente já fez muita coisa, e não tirou um descanso nem no Festival da Brisa Florescente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100707,
					"content": "Mas, ele se esforçou muito. A Guilda de Aventureiros de Mondstadt com certeza recrutará muitas pessoas novas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100708,
					"content": "Quando tiver mais gente, esse garoto talvez possa se libertar das coisas triviais e ir se aventurar novamente comigo... Hum! Isso seria muito legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100709,
					"content": "#Eu vou ler a carta com muita atenção. Mas você foi mobilizad{M#o}{F#a} para fazer trabalhos extras, então eu tenho que dar mais recompensas a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100710,
					"content": "Aqui está a recompensa pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
