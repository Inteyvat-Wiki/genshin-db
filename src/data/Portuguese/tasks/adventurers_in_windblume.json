						],
						"stepId": 7001003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "Sobre a missão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "Você viu a minha missão e decidiu vir aqui? Ótimo, eu tenho algumas coisas que preciso de sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "Mais precisamente, eu queria que você fosse à Montanha Nevada e fotografar dois lugares. Eu vou marcar os dois lugares no seu mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "Quanto à recompensa, claramente lhe darei algo bom de acordo com as regras da Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "E então? O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "Por que devo tirar fotografias nesses dois lugares?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Uh... Como posso dizer... Isso está relacionado a Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "Ele me pediu para arranjar algumas especialidades da Montanha Nevada que servirão como materiais de propaganda de recrutamento da Guilda e serão usados durante o Festival da Brisa Florescente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "O Festival da Brisa Florescente já chegou! Mas o Cyrus ainda não entrou em contato comigo! Será que ele também está celebrando o festival?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Na verdade, ele agora já tem uma certa idade, com certeza deve estar ocupado com o Festival da Brisa Florescente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "Eu acho que ele já é muito velho para isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Mesmo? Não sei o que pensar... Sempre pensei que... Deixe para lá, não há porque falar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "Eu coletei alguns minérios e organizei alguns arquivos de topografia e registros de monstros. Eu também gostaria de tirar fotos das boas vistas na Montanha Nevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "Viajante, você poderia me ajudar indo até a Montanha Nevada e tirando fotografias nesses dois lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Muito obrigada. Eu já marquei esses dois lugares em seu mapa. Quando você terminar, venha me encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "Você não pode retornar e ver por si mesma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "A atmosfera da cidade está muito animada, não consigo suportar. Para mim, é mais confortável ficar aqui esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "Além disso, tenho muitas coisas para fazer por aqui, não posso retornar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "Eu já marquei os melhores lugar no seu mapa para você dar uma olhada. Vá logo, assim que tirar as fotos, traga-as de volta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
							"2"
						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "Sobre a missão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "E então? Você terminou de fazer o que lhe pedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Sim, tudo feito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Obrigada! Já embalei as coisas que quero dar a esse garoto. Você pode me ajudar a entregar isso de novo? Depois vou dar-lhe uma boa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "Não sei se essas coisas são suficientes ou não. Mas se for o caso de recrutar mais novatos, os registros e minérios talvez sejam mais atrativos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "Ai... Parece que essa estratégia de recrutamento não está surtindo efeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Sobre o que Iris enviou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Uh? O que ela lhe deu? Oh, sim... Na última vez, pedi para ela vir, mas eu me esqueci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "Você realmente está ocupado com o Festival da Brisa Florescente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "Festival da Brisa Florescente? Mas eu não tenho tempo! O método de recrutamento da última edição já está fora de uso, então estou trabalhando em fazer um novo plano de recrutamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Vou ver o que a Iris me enviou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "Minérios? Não servem! Agora os jovens não gostam disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Mapa topográfico? Hum... Até que dá para os Aventureiros da Guilda usarem. No entanto, para os novos recrutados, isso não serve para nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Diário das pesquisas de monstros... Podemos fazer mais cópias para os aventureiros da Guilda. Em relação aos recém recrutados, isso não serve para nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "Oh? Aqui também há duas fotos que parecem boas. A vista é boa, e esse lugar parece ser seguro, então, alguém com certeza vai se interessar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "Por que escolheu esse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Parece que as coisas relacionadas aos Aventureiros foram tiradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Você não sabe como a Guilda está atualmente? Os jovens de hoje em dia não têm mais interesse nenhum em mapas topográficos, caçar monstros ou minerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "Para atrair sua atenção precisaremos de algumas coisas mais... \"realistas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "Agora estamos no Festival da Brisa Florescente, todos os jovens querem mostrar o seu carisma de uma forma incomum, mas menos perigosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "Isso é a única meneira de explorar a Montanha Nevada. Se alguém tiver interesse, normalmente virá perguntar aqui na Guilda, e é muito possível acabar se juntando à Guilda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "Mesmo que eles não queiram se juntar à Guilda de Aventureiros nessa situação, se derem umas missões para nós também é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "Olha bem a localização desses dois desenhos, eles estão do lado da rua. Basta prestar mais atenção, e você não encontrará muito perigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "Você vai fazer isso dessa forma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Mas isso é a situação atual. Se não existisse alternativa, eu não teria pensado em algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "Bem, se você ainda não confia em mim, pegue essas duas fotografias e vá perguntar às pessoas que estão nos arredores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "Primeiro, você vai falar sobre o recrutamento da Guilda de Aventureiros. Depois, deve mostrar estas duas fotos e dizer que são materiais de recrutamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100324,
					"content": "E depois, você vai perceber porque tive essa ideia.",
					"roleType": "TALK_ROLE_NPC",
