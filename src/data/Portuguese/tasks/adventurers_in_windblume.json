			"dialogs": [
				{
					"id": 700100601,
					"content": "E então? Você perguntou sobre a opinião de todo mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100602,
					"content": "Já perguntei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Agora você sabe o que eu quis dizer... Enfim, a situação sempre foi assim, já me acostumei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100604,
					"content": "Independentemente de tudo isso, agradeço-lhe sinceramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100605,
					"content": "Se depois você for na direção da Montanha Nevada, poderia reportar a situação da missão para a Iris?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100606,
					"content": "Você pode entregar esta carta para ela? Ela certamente sabe a situação da Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100607,
					"content": "Espero que consiga recrutar mais pessoas... Mas duvido que as pessoas recrutadas dessa maneira possam virar aventureiros confiáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
