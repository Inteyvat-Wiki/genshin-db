				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grainville"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Oi, a gente encontrou um amplificador com defeito... ele tá ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630402,
					"content": "De novo? Que estranho... Clynes acabou de consertar. Parece que ele nem é tão bom assim em consertar as coisas como eu. Tudo que basta é dar umas porradas nas máquinas e pronto, problema resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630403,
					"content": "Obrigado, darei uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630404,
					"content": "Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
