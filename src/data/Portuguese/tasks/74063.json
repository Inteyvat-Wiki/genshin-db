					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Hã? O que um Aparelho Fotográfico tá fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "\"Onde há notícias, há Aparelhos Fotográficos\". Nunca ouviu essa antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "Acho que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Mas eu acabei de inventar isso, onde você ouviu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Bem, nada de novo sob o sol. Não importa o que eu diga ou escreva, sempre é apenas uma paródia dos outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "O Aparelho Fotográfico está aqui, então cadê as notícias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Notícias... São como pescaria. Requer paciência e fazer o julgamento certo na hora certa. É assim que você fisga o peixão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Oh! Digo... É assim que você fisga um furo. Hã? Espera, isso não parece certo! Ugh! Esqueça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "Pareceu um pouco amador. Você não é uma jornalista, é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Então você se enganou sobre mim, heh. Porque eu sou uma jornalista amadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Enfim, por que tem uma jornalista amadora aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Estou aqui para completar o projeto designado para mim: capturar os momentos mais vívidos dos guardas da Fortaleza Meropide com meu Aparelho Fotográfico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Mas perdi muito tempo preenchendo os documentos necessários... deem uma olhada, vocês vão ver na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "#Nelly tira uma pilha de documentos, todos cheios de várias cláusulas e assinaturas. Só de olhar, você já fica tont{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Quando terminei toda a papelada, perdi os guardas no turno deles! Ou, em termos de pesca, não há peixes para fisgar agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Hã? Mas têm guardas no turno agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Mas eu quero fisgar uma Coleção de Platina. Não acho que Função Básica ou Purificador Hydro são impactantes o suficiente... por isso, mesmo completando meu projeto, outros fotógrafos podem achar que ele não é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Pare de ser tão exigente, ou vai voltar de mãos abanando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Sim, tem razão. Preciso admitir minhas habilidades limitadas e tentar parar de pegar peixes que são areia demais pro meu caminhão... *Choro* Eu sou uma pescadora inútil... Oh, eu quis dizer, jornalista amadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Certo, chega de eu ficar me lamuriando, é hora de animação! Se vocês não se importarem... podiam me ajudar com um favorzinho? Por favor! Eu vou pagar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Uau! Que rápido! Depende do favor. Que tal dizer o que é primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Aquele guarda ali, Grainville. Segundo meu julgamento, o valor de uma notícia sua entre os guardas é o equivalente a um Controlador entre Mecautômatos de manutenção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Devo conseguir escrever um bom relatório com ele como sujeito, e isso deve impedir que eu seja criticada, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "Mas ele se recusa a vir aqui! Vocês podiam levar ele a um local adequado para eu dar um clique?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Por que você mesma não explica isso pra ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Eu tenho certeza que se ele souber sobre a câmera, vai focar nela e ficar rígido, isso é o mesmo que uma foto artificial, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Deixe-me pensar. Acho que é melhor desligarmos o amplificador, reportar isso para Grainville como um defeito e pedir para ele dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "Assim, eu com certeza vou poder capturar um momento vívido de um guarda da Fortaleza Meropide trabalhando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "Completar meu projeto depende disso! Estou contando com vocês! Por favor, me ajudem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Não parece tão difícil, {NICKNAME}. Que tal a gente ajudar ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Você não pode só levar a câmera até ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Bem... a vista é melhor daqui. E se ele vir a câmera, tenho certeza que vai focar nela e me deixar sem nada, só com um monte de poses rígidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Pode ir esperar sentada então, fui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Vocês vão embora? Mesmo? Não vão me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Bem... a gente não pode conjurar uma Coleção de Platina do nada para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Esqueça as notícias, também gosto de pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Sério? Isso é perfeito! Na verdade, eu sou apenas uma pescadora novata, e tenho um monte de perguntas, mas não sei a quem pedir conselhos. Por exemplo, se você fisgar um Mecaprotetor e ele morder... O que você faria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Só solte ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Entendi, entendi, então é assim que você resolveria. Hmm, é uma referência muito valiosa. Vou me lembrar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "#Hã? Por que vocês estão falando de pesca? Vocês são {F#boas}{M#bons} em guiar uma conversa! Parece que ainda tenho muito a aprender como jornalista amadora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "Mas foi você que falou de pesca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Dê uma lição nele e mostre quem manda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Cozinhe ele para Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Opa! Paimon acredita mesmo nas suas habilidades culinárias, {NICKNAME}. Mas não importa por onde olhe, aquilo lá não se come!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Oh! Bem, vocês ouviram agora! Não esqueçam que se acabarem usando isso em outro lugar, devem me citar como fonte! Eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
