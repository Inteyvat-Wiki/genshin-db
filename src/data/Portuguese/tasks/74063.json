			"dialogs": [
				{
					"id": 740630301,
					"content": "Eu tenho que tirar uma foto tão boa que os outros fotógrafos vão passar a me respeitar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630302
					],
