					}
				]
			},
			"dialogs": [
				{
					"id": 760690401,
					"content": "Hã, uma manifestação do Espírito do Lobo... Uma parte que eu não conhecia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690402,
					"content": "Quem deixou você aqui? E o que você está guardando? Responda... Me diga mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690404,
					"content": "...Quantas vezes eu tenho que dizer, este caminho manchado de sangue é só meu para trilhar. Ninguém precisa seguir meus passos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690405,
					"content": "Haha, então vamos chamar isso de \"destino\". Quem pode dizer que não acabamos simplesmente seguindo o mesmo caminho, de Mondstadt até Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "Um \"destino\" em que reverenciamos certo cavaleiro, que por acaso já nos salvou incontáveis vezes. Nessas circunstâncias, poderíamos ser culpados por trilhar um caminho parecido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "Mesmo que não entendêssemos por completo, ainda ficaríamos como testemunhas... Mesmo que, no fim, restássemos apenas nós poucos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "Auuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "Se é assim mesmo que você enxerga... eu não tenho o direito de impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690410,
					"content": "...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "Aqueles monstros amaldiçoados... estão todos mortos? E os moradores lá perto... estão seguros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "*Cof*... Que bom... Só é uma pena que não tenhamos força para ver você chegar ao fim... Ah, se não fosse assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "Daqui em diante, você terá que seguir esse caminho sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "...No fim das contas, minha espada não conseguiu proteger todos eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690415,
					"content": "...No fim, só restou um para trilhar o caminho... Talvez, como sempre deveria ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690416,
					"content": "Pelo menos, que estas espadas e o Espírito do Lobo neste lugar sirvam como seus guardiões, para impedir que as aberrações sombrias perturbem seu descanso eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690417,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690418,
					"content": "Então foi assim... Os registros dos Cavaleiros de Favonius dizem que, quando o Cavaleiro Sanguinário partiu, houve cavaleiros que escolheram segui-lo, mas nunca mais foram mencionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690419,
					"content": "E pensar que eles pereceram aqui lutando contra monstros... Um fim digno para verdadeiros Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690420,
					"content": "Mas será que era isso mesmo que eles desejavam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690421,
					"content": "A chama de batalha que nunca se apagou, a saudade que habita em suas espadas... Digam-me, Cavaleiros, sobre sua determinação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690422,
					"content": "Usarei o poder deixado aqui por Boreas para selar este campo de batalha... E aquele lobinho ficará de vigia por vocês lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690423,
					"content": "Nunca mais ser perturbado, desfrutar de paz eterna e, para sempre, ser poupado de testemunhar a injustiça deste mundo... Se alguém merece tamanha proteção, são vocês, meus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690424,
					"content": "Então é isso, adeus, meus últimos companheiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690425,
					"content": "...Não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "...Não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "...Vamos lutar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "...Mais uma vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "É isso! Claro que seus desejos e ambições não foram feitos para simplesmente definhar em um lugar como este, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690430,
					"content": "Juntem-se a mim! E retornem mais uma vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690431,
					"content": "Para a batalha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}