					}
				]
			},
			"dialogs": [
				{
					"id": 762010201,
					"content": "Você está sendo cruel, Metta! Eu só queria que você se divertisse em sua aventura... Por que você tem que dizer coisas assim, hunf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Se você não parar de agir por qualquer capricho, as pessoas vão ficar frustradas com você também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Não tem capricho nenhum! E-Eu também tenho meus próprios planos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Uau, planos, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Ugh... você está brincando comigo de novo. Eu não vou mais falar com você! Mesmo se você se arrepender depois, vai ser muito tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "...Ah, Linnea! Metta tava sendo—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Enquanto Vesa tenta contar a história do que aconteceu, fica claro que foi apenas uma briga típica entre crianças...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Não tem jeito de eu estar errada, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Então... Eu não estava errado também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Hmm... às vezes essas coisas acontecem. Ninguém realmente está errado, mas as coisas ainda assim não acabam do jeito que queremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Oh, é como a história das duas irmãs dos Filhos da Lua Gelada que as Flores Noturnas representam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Hã? A história de duas irmãs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Sim. Ouvi dizer que tinham duas irmãs entre os Filhos da Lua Gelada. Suas personalidades eram muito diferentes, que nem as Flores Noturnas — uma vermelha e uma azul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "As duas irmãs fizeram o que acharam certo, mas, graças a isso, elas seguiram caminhos diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "Dizem que a irmã mais nova nunca perdoou a irmã mais velha por ter deixado ela para trás, mesmo que a irmã mais velha tenha salvado inúmeras vidas... No final, as duas nunca se viram novamente antes de morrerem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Oh... Eu não sabia que os Filhos da Lua Gelada tinham histórias assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Nem eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Hum... ouvi isso de um Bardo viajante. Talvez haja algum exagero nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Ah, então é uma história inventada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Bem, mesmo que essa história não seja completamente verdadeira, a lição que ela carrega ainda faz sentido, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "Nenhuma delas achou que estava errada. As duas acreditavam que sua escolha era a certa, mas essas escolhas custaram a elas seu vínculo para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Se provar que você está certo significa perder um amigo... o que você escolheria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Ah... na verdade, alguns pesquenos desvios espontâneos em uma aventura não são tão maus assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "...É! Pensando melhor, o tempo que Metta passa se aventurando comigo é precioso. Se eu ficar mudando de ideia o tempo todo, talvez a gente não consiga aproveitar nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "Eu... Eu vou planejar as coisas melhor da próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Hehe, é ótimo que vocês dois possam se dar bem novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "E se encontrarmos alguma pedra incomum ao longo do caminho, vamos enviá-la ao Speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Parece bom! Já agradeço, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
