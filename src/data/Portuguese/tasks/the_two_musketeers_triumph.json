			"dialogs": [
				{
					"id": 401360101,
					"content": "Mais algum tempo passa depois disso...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier! Já faz um tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "Olá, vocês. Desculpe estar sumido, estive atolado de preparações de propaganda e preparando o filme para ser lançado desde que terminamos a pós-produção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "A cerimônia de premiação é hoje, não é? Paimon se pergunta se vamos ganhar o Prêmio Furina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Eu daria uma chance de noventa por cento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina! Paimon não sabia que você já estava aqui. Você chegou mais cedo que todo mundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Eu tenho certeza que os outros estarão aqui em pouco tempo. Hum... Xavier, se a gente for chamado no palco, você não deveria pensar em um nome para nosso elenco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Hã!? Mas nós nem sabemos se vamos ganhar. Eu não gostaria de acabar azarando nossa chance ao comemorar cedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Apenas abra seus olhos! Certamente você viu a reação da audiência ao nosso filme? A gente nada teve além de aprovação das críticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "Você também teve conversas com os operadores da casa de ópera, né? Eles não queriam aumentar o tamanho de apresentações nossas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Com a Mora que você fez na bilheteria, agora você pode abrir sua própria empresa de cinema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "M-Mas todo esse crédito vai para uma equipe incrível! Vocês todos ajudaram a tornar isso realidade, então não posso ser o único responsável por pensar em um nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Bem, pense sobre isso. Tenho certeza de que a equipe respeitará sua escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Tudo bem... Mas antes disso, {NICKNAME} e Paimon, posso incomodar vocês para fazerem uma visita rápida à Fortaleza Meropide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Hã? Mas a gente não devia ficar para a cerimônia de premiação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Eu queria pedir que vocês convidassem Chevreuse para se juntar a nós na cerimônia. Ela é uma das protagonistas, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Eu não pude encontrá-la recentemente, então não tive a chance de convidá-la pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Segundo o jornal, os culpados pelo caso do assassinato de mosquete serão pessoalmente escoltados pela Capitã da Patrulha de Segurança e Monitoramento Especial até a Fortaleza Meropide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Oh, Paimon entende agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Vai ser mamão com açúcar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Sim! Só espere aqui, Xavier, e talvez tente pensar em uns nomes melhorezinhos hein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "Tudo bem, vou liberar vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
