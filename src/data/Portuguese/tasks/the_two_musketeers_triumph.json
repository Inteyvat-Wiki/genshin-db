				{
					"id": 401360303,
					"content": "Vencemos! Vencemos mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360304,
					"content": "Parabéns, Sr. Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360305,
					"content": "Vencemos... Não consigo acreditar nisso, eu... eu... eu não posso agradecer o bastante a todos vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360306,
					"content": "Vê? Meus julgamentos sobre a indústria do entretenimento de Fontaine nunca estão errados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360307,
					"content": "Agora, por favor, deem boas-vindas para o produtor do \"Os Dois Mosqueteiros,\" Senhor Xavier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "Apresentadora do Festival de Cinema"
				},
				{
					"id": 401360308,
					"content": "Obrigado... Muito obrigado a todos pelo apoio e reconhecimento. Enquanto estou aqui, gostaria de dar meus agradecimentos especiais a—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360309,
					"content": "O tempo voa, ein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360310,
					"content": "Certamente parece assim. É como se fosse ontem que você estava me ensinando a segurar uma pistola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360311,
					"content": "Você voltará para Fontaine algum dia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360312,
					"content": "Claro! Eu gosto muito dessa cidade. Há tantas coisas novas e interessantes que foi difícil acompanhar tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360313,
					"content": "Mas que tal você? Tem interesse em visitar Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360314,
					"content": "Eu não posso dizer que esse pensamento se passou pela minha cabeça antes... mas acho que estou disposta a pensar sobre isso agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360315,
					"content": "Aguardarei ansiosamente sua visita. Seria maravilhoso se pudesse visitar minha casa e desfrutar do sabor de nosso chá e sobremesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360316,
					"content": "Sim, vamos continuar em contato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360317,
					"content": "Vocês realizaram tudo que vieram fazer aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360318,
					"content": "Sim. E você também deveria visitar Inazuma novamente algum dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360319,
					"content": "Como está Ogura e o negócio dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360320,
					"content": "Até onde sei, ela está muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360321,
					"content": "Dê um oi a ela por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360322,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360323,
					"content": "Eu soube que as tempestades pararam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360324,
					"content": "Sim, e a guerra também chegou a um fim. A paz e a prosperidade retornaram às ilhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360325,
					"content": "Eu gosto de como isso soa, perfeito para estender tecidos para secar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360326,
					"content": "—Gostaria de oferecer meus agradecimentos a todo o elenco e equipe. Sem vocês, eu jamais teria completado esse filme, muito menos teria a oportunidade de estar de pé neste palco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360327,
					"content": "Com o apoio de toda minha equipe, eu gostaria de anunciar oficialmente nossa produtora de cinema, \"Mosqueteiro Filmes\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360328,
					"content": "Ooh, parece um bom nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360329,
					"content": "Então, neste caso, por favor, vamos dar boas-vindas a todos os membros do Mosqueteiro Filmes ao palco para uma foto comemorativa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "Apresentadora do Festival de Cinema"
				},
				{
					"id": 401360330,
					"content": "Oh! Paimon não sabia que também tiraríamos fotos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360331,
					"content": "Diretora Furina, acredito que você é a maior merecedora de levar este troféu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360332,
					"content": "Hum? Não não não, não tem necessidade... é muito vergonhoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360333,
					"content": "É a honra que a diretora merece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360334,
					"content": "Sim, concordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360335,
					"content": "Não consigo pensar em ninguém melhor para esse honra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "Só aceite que você não vai se livrar dessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360337,
					"content": "Preparados? Três, dois, um—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "Apresentadora do Festival de Cinema"
				},
				{
					"id": 401360338,
					"content": "Mosqueteiro Filmes!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
