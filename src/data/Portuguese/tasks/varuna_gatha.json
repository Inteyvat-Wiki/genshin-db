				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#Obrigado, Nara {NICKNAME}. Agora pode deixar o resto com o Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141502,
					"content": "Mas já se passou muito tempo. Não sei se funcionará dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141503,
					"content": "O quê?! Isso tem chance de dar errado?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141504,
					"content": "Funcionou antes, mas dessa vez talvez funcione, talvez não. Assim como o sol nasceu na última vez, mas ninguém sabe se nascerá na próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141505,
					"content": "Só depois do sol subir na próxima vez que Paimon poderá dizer: \"Oh, o sol nasceu de novo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141506,
					"content": "Aaaaaah! Isso é assustador! E se o sol nunca nascer novamente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141507,
					"content": "#Paimon, não tenha medo. Nara {NICKNAME} é dourad{F#a}{M#o} como o sol, assim como Nara Varuna, e é Nara corajos{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141508,
					"content": "#Nara Varuna trouxe o sol e a lua de volta para nós. Nara {NICKNAME} também pode fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141509,
					"content": "#... Sim! Paimon também confia {F#na}{M#no} {NICKNAME}! {F#Ela}{M#Ele} pode superar qualquer coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141510,
					"content": "Pode deixar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Mas por enquanto, vamos deixar isso com Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141512,
					"content": "Oh, Paimon acha que... Funcionou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141513,
					"content": "Sim, os galhos e as folhas daqui estão curados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141514,
					"content": "Ótimo! E a dança dos Aranaras é fantástica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141515,
					"content": "Você podia aprender com os Aranaras, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "Parece uma boa ideia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141517,
					"content": "Paimon, você come tanto que devia se exercitar mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#Ei! Paimon fica correndo atrás de você o tempo todo, {NICKNAME}! Isso é exercício!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141519,
					"content": "Mas, isso ainda não é suficiente para curar a Máquina Varuna completamente, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141520,
					"content": "Há mais três locais em Vana. Arabalika é muito forte, talvez consiga... Mas Arapandu está muito preocupado com Aranakula e Arakunti. Vana ficou muito perigosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141521,
					"content": "#Que tal Paimon e {NICKNAME} irem ver como eles estão? Afinal, se não curarmos a Máquina Varuna, não poderemos preparar o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141522,
					"content": "#Com a ajuda de Paimon e {NICKNAME}, sem dúvida será possível curar a Máquina Varuna. A vida voltará a Vana, assim como antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141523,
					"content": "Aranakula foi para o <color=#00E1FFFF>Monumento Yasna</color>. Nas profundezas de Vana está o memorial Aranara para Nara Varuna, não vamos lá há muito tempo por causa dos fungos e esporos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141524,
					"content": "Aranakula está acostumado a ficar junto com a terra e sementes. Acostumado com tudo aquilo que nasce do solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141525,
					"content": "Encontrem-no. Digam-no o nome de Arapandu. Assim não terá medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141526,
					"content": "Oh? Parece que ele é um Aranara medroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141527,
					"content": "#A Ararakalari de Arabalika é muito forte! Mas... Por favor, Paimon e Nara {NICKNAME}, vejam como ele está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141528,
					"content": "#Arabalika está na <color=#00E1FFFF>Ruínas de Dahri</color>. O cheiro de ferro lá é forte... Paimon e Nara {NICKNAME} precisam tomar cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141529,
					"content": "Certo, tomaremos cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Arakunti está na <color=#00E1FFFF>Floresta Onírica</color>, onde há uma entrada para mundo dos sonhos. Ele tem uma relação distante com Nara. Se ele se esconder, toque nossa música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141531,
					"content": "Falando nisso, nós pegamos aquela partitura de música Aranara antes. Podemos tentar tocá-la se não encontrarmos Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141532,
					"content": "Arapandu esperará no Ponto de Descanso, e observará Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141533,
					"content": "Aranakula, Arabalika e Arakunti sabem que depois de curarem os galhos e folhas, devem se encontrar no Ponto de Descanso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141534,
					"content": "#Nara dourad{F#a}{M#o}, Nara corajos{F#a}{M#o}, que Aramuhukunda proteja Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141535,
					"content": "Sim! Pode contar conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "Uau! O que foi aquilo? Que incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141702,
					"content": "#Nara {NICKNAME} e Paimon agora sabem. Aquele é o Tesouro Varuna. Mas a Máquina Varuna está em um lugar ainda mais profundo, tão profundo quanto as raízes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141703,
					"content": "Acho que subestimamos Nara Varuna. Paimon não imaginava que teria esse tamanho todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141704,
					"content": "Esse poder não pode ser subestimado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Antes da chuva preta cair, Nara Varuna ainda não tinha vindo para Vana. Aramuhukunda e a Lorde das Árvores criaram a Máquina Varuna. A chuva trouxe vida para muita coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141706,
					"content": "A chuva escura, a lava preta, e muitas outras coisas deixaram Vana um caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141707,
					"content": "#Antes {F#dele}{M#dela} vir, Arapandu não havia visto {F#um}{M#uma} Nara tão corajos{F#o}{M#a}. {F#Ele}{M#Ela} consertou a máquina com os Aranaras, assim como o sol expulsa a neblina sonolenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141708,
					"content": "Nara Varuna não está mais em Vanarana. Aramuhukunda não está mais em Vanarana... Mas os Aranaras devem consertar a Máquina Varuna novamente pelo Festival Utsava, e por Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141709,
					"content": "Nós prometemos a Araja e Arama que ajudaríamos nos preparativos para o Festival Utsava. E como diz o ditado, quanto mais Nara pegando lenha, mais forte será o fogo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141710,
					"content": "Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141711,
					"content": "Ah! Não, não. Paimon quis dizer que tudo correrá bem com mais Nara ajudando! Não tenha medo! Não tem nada a ver com fogo! Nada a ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141712,
					"content": "Paimon, você se superou de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "*Choro* Já que Paimon veio para Sumeru, Paimon queria mostrar que também sabe muita coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141714,
					"content": "#Arapandu não tem medo. Paimon tem boas intenções, assim como Nara {NICKNAME} e Nara Varuna. Paimon é amiga dos Aranaras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141715,
					"content": "Aranakula, Arabalika, Arakunti e Arapandu querem curar a Máquina Varuna, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141716,
					"content": "Há muitos esporos e Cogumelos. Não podemos fazer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141717,
					"content": "Arapandu não tem um Ararakalari poderoso como o de Arabalika, e a chuva estranha deixou os Cogumelos mais fortes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141718,
					"content": "Espere, Ararakalari... Arana disse para Paimon que pode ser usado para repelir Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141719,
					"content": "Ararakalari poderoso, pode afugentar os Cogumelos. Ararakalari de Arapandu fraco. Não faz nada contra Cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141720,
					"content": "O quê? Ararakalari pode fazer algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141721,
					"content": "Ararakalari deve ser o nome genérico para algum tipo de habilidade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Nara {NICKNAME} é mais espert{M#o}{F#a} que Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141723,
					"content": "*Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141724,
					"content": "Aranaras diferentes possuem Ararakalari diferentes, mas todos os Aranaras têm o poder de utilizá-lo das plantas de Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141725,
					"content": "Ararakalari de Arabalika é forte. Não tem medo de Cogumelos grandes, e Nara grande de ferro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141726,
					"content": "Nara grande de ferro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141727,
					"content": "#Nara grande de ferro é enorme, como Nara {NICKNAME}. Ele tem duas mãos e duas pernas, mas um olho só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141728,
					"content": "Ah, você está falando dos Guardas das Ruínas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141729,
					"content": "Paimon é esperta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141731,
					"content": "Oh! Há Cogumelos naquelas árvores... Arabalika pode derrotá-los, mas Arapandu não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141732,
					"content": "#Nara {NICKNAME} não tem medo de Cogumelos. Apesar de você não usar Ararakalari, é forte. Destrua-os como um sopro forte de vento empurrando uma folha! Vuuush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141733,
					"content": "#Se não fizermos nada, os Esporos e Cogumelos irão se multiplicar mais e mais... Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141734,
					"content": "#Deixa com a gente! Com alguém capaz como Nara {NICKNAME}, tudo vai ser resolvido rapidinho, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}