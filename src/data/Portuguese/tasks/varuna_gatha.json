				},
				{
					"id": 730141202,
					"content": "Esperem, hã? Isso daqui são galhos e folhas? Parecem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141203,
					"content": "Parecem como pedras colocadas pelos Aranaras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141204
					]
				},
				{
					"id": 730141204,
					"content": "Folhas de pedra, galhos de pedra. Foram criadas por Aramuhukunda e pela Lorde das Árvores. Podem canalizar o poder de Vanarana na Máquina Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141205
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141205,
					"content": "A Máquina Varuna se parece com uma árvore grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141206
					]
				},
				{
					"id": 730141206,
					"content": "Oh, Paimon entendeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141207,
					"content": "Hmm... Três folhas precisam virar na mesma direção do galho, mas Arapandu não tem forças suficientes. Oh, não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141208
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141208,
					"content": "#Bem, os Aranaras são bem pequenos. Deixe algo assim para Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141209,
					"content": "Arabalika talvez consiga, mas Aranakula e Arakunti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141210
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141210,
					"content": "#Mas precisamos resolver esse problema primeiro. Nara {NICKNAME}, Arapandu está contando com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
