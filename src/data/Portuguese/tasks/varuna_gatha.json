			"dialogs": [
				{
					"id": 730141001,
					"content": "Então isso aqui é o Ponto de Descanso. Podemos ver sinais que os Aranaras ficaram por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141002,
					"content": "A Máquina Varuna parece ainda mais impressionante daqui... Urgh, a pressão é tão forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141003,
					"content": "Paimon, tenha cuidado para não ser puxada para dentro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "De jeito nenhum! Bem, Paimon acha que não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141005,
					"content": "Concordamos de nos encontrar no Ponto de Descanso após curar os galhos e folhas da Máquina Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141006,
					"content": "Então, baniríamos os insetos ruins comendo as raízes da Máquina Varuna para curá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141007,
					"content": "Falando nisso, o que são esses \"galhos\" e \"folhas\" da Máquina Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141008,
					"content": "As folhas e galhos da Máquina Varuna estão distribuídos em toda Vanarana. São eles que dão força à Máquina Varuna para transformar a chuva preta em chuva boa, chuva que traz vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141009,
					"content": "Assim como a água da chuva flui para virar um riacho e então um lago, os galhos e folhas reúnem pedaços que entram na Máquina Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141010,
					"content": "A Máquina Varuna não é mais a mesma. É como se galhos quebrados bloqueassem a água da chuva, assim riachos não se formam. Sem riachos, lagos secam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141011,
					"content": "Hã... Paimon não tem certeza se entendeu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141012,
					"content": "É como se Paimon ficasse com fome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "Oh! Paimon não terá forças se não comer! Isso quer dizer que a Máquina Varuna está irritada por que está com fome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141014,
					"content": "Eu acho que não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "Sim! Ela não teria forças para reclamar se estivesse com fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141021,
					"content": "Enfim, precisamos curar os galhos e folhas primeiro, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141022,
					"content": "#Sim. Arapandu levará Paimon e Nara {NICKNAME} até lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141016,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "É como quando uma rota segura de transporte está bloqueada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "É preciso remover todo o bloqueio para poder continuar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141019,
					"content": "Oh, nesse caso basta encontrar outro caminho! Quem foi que decidiu que esse caminho era necessário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141020,
					"content": "Sim! Quem foi que decidiu isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
