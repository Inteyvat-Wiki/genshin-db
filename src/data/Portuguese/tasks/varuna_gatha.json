						],
						"stepId": 7301401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "#Oh, é um Nara. {M#Um Nara dourado e corajoso}{F#Uma Nara dourada e corajosa}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140302,
					"content": "#Essa é Paimon e {M#esse é}{F#essa é} {NICKNAME}. Todos de Vanarana estão ocupados se preparando para o Festival Utsava. O que veio fazer aqui sozinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140303,
					"content": "Arapandu tem uma missão importante em prol do Festival Utsava em prol de Nara Varuna, e em prol da Floresta Apam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140304,
					"content": "Você deve ser Arapandu. Mas \"Nara Varuna\"? Esse nome soa familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140305,
					"content": "#Nara Varuna... {F#Ele}{M#Ela} é como Nara {NICKNAME}, Nara dourad{F#o}{M#a} e corajos{F#o}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140306,
					"content": "Quando a lua e sol não podiam ser vistos, quando as folhas nas grandes árvores de Vanarana foram arrancadas pelo vento, e seus galhos apodreceram por causa da chuva escura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140307,
					"content": "A dor de Vanarana pingava no solo. O cheiro de ferro e sal estava em todo local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140308,
					"content": "Uau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140309,
					"content": "#Não se sabe quantos crepúsculos depois, Nara Varuna apareceu. Nara dourad{F#o}{M#a} falou numa língua de ouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140310,
					"content": "#{F#Ele}{M#Ela} e os Aranaras trouxeram de volta o sol e a lua. A Máquina Varuna limpou a dor de Vanarana. A chuva escura desapareceu, e o cheiro de ferro e sal também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140311,
					"content": "Todos de Vanarana agradeceram e gostaram de Nara Varuna, que era como o sol, a terra e o orvalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140312,
					"content": "#Uau, que história legal! {F#Ele}{M#Ela} deve ter sido {F#um bom}{M#uma boa} Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140313,
					"content": "#Mas, hehe, Nara {NICKNAME} também ajudou muitas pessoas. Elas lhe são muito agradecidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140314,
					"content": "#Arapandu também vai gostar de Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#Depois que {F#ele}{M#ela} partiu de Vanarana, muitos nasceram do solo, e muitos retornaram para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "Os galhos e folhas da Máquina Varuna enfraqueceram. O Tesouro Varuna era como um pássaro assustado, e bateu suas asas freneticamente. Choveu muito. Muito estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Agora os cogumelos corredores estão em Vanarana. Há sementes nunca vistas em todos os lugares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "Você está falando dos Cogumelos e dos Esporos? Mas, o que essa Máquina Varuna e Tesouro Varuna são exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "Seria uma arma incrível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "É uma lâmina que pode cortar Valuka em dois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Não! Isso seria poderoso demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Hmm... Não. Nara {NICKNAME} e Paimon estão errad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Vamos para um local alto. Arapandu contará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Talvez não seja uma arma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Então o que seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Talvez seja um Aranara alado feito de água...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Um mímico Oceanid?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
