				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#{NICKNAME}, olá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Tsuyuko, como estão os preparativos para pegar o coral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Argh, nem me fale. Encontrei problemas de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Tsuyuko, você pode fazer uma cara triste o quanto quiser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Mas você não está convencendo ninguém se continuar nos encarando assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Ah, então vocês também entendem a gravidade de nossa situação. Bem, já que é assim, não esconderei mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Você não estava escondendo nada desde o começo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Nós obtivemos a Chave das Profundezas Banhadas pela Lua, e Enkanomiya está aos poucos despertando. Entretanto, não temos pessoas suficientes. Dessa forma, nossas investigações estão seguindo a um ritmo lento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "No final de tudo, essas são circunstâncias únicas. Não sabemos se as relações com a Ilha Narukami realmente melhorarão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Você sabe que eu sou apenas uma pessoa, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Ah, mas isso é uma questão diferente. A tradição diz que \"um herói\" é fundamental para obter o Coral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Nós devemos estabelecer uma base e ajudar nosso herói a refazer o caminho de nossos ancestrais antes de finalmente enfrentar o julgamento final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "Desta forma, teremos um caminho estável até a vitória...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Ou talvez, como não há pessoas suficientes ultimamente, você não pode seguir com seu plano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "É isso mesmo. E quando falamos de nosso herói, não vemos sequer sua sombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "#Mas, acho que agora vejo. Noss{F#a}{M#o} {F#heroína}{M#herói} tem cabelo louro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Urgh, isso parece muito trabalhoso. Paimon não acha que fazer esta jornada foi uma boa ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Ah, mas exploração geralmente leva até a descoberta de um tesouro raro. Geralmente coisas assim seriam dadas ao Santuário de Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Mas se fosse você que encontrasse algo, suponho que nós simplesmente poderíamos fazer vista grossa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Eu não me importaria se você fechasse seus dois olhos mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "#Ah, noss{F#a}{M#o} grande {F#heroína}{M#herói}, poderos{F#a}{M#o} paladin{F#a}{M#o}, destinad{F#a}{M#o} salvad{F#ora}{M#or}! Você está querendo dizer que concorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Como que nós poderemos ignorar os perigos de Sangonomiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Maravilhoso! Parece que os métodos recomendados pela Senhorita Kokomi são realmente persuasivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Ela até mesmo previu que você retornaria para procurar por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "O que você disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Oh, não é nada demais. Por favor, sigam-me. Eu tenho algo a lhes mostrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Vamos nos encontrar naquele altar em frente. Se você não puder vê-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Se não puder vê-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Então aperte seus olhos rumo ao sudeste que você verá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Eu tenho uma boa relação com Sangonomiya Kokomi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Chamamos isso de \"Padrão de Chave\". Esses símbolos costumavam ser usados em Enkanomiya. Eles só aparecem quando o caminho está para ser reaberto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Dizem que isso é um segundo conjunto de chaves que são enviadas para o povo da Ilha Watatsumi quando Enkanomiya desperta, e nossos registros mostram que ao todo existem cinco tipos de Padrões de Chave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Atualmente encontramos três dos cinco na Ilha Watatsumi. Nós podemos operá-los dessa maneira para os devolver aos seus locais originais e assim liberar o selo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Nós removemos os três que encontramos e os colocamos em outros locais pela ilha. Dessa forma, a barreira poderá ser restaurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "O propósito real de fazer isso é prevenir que crianças, espiões Fatui e pessoas da Ilha Narukami ou forasteiros se infiltrem na ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "#Oh, não se preocupe, você não está incluíd{F#a}{M#o} nessa categoria de forasteiros, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "No momento não temos como contatar a Guilda de Aventureiros, por isso, também não são permitidos aventureiros lá embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Mas você alguma vez deixou eles descerem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Historicamente, há registros disso. Nós estamos buscando por uma cooperação em que todos ganham. Sempre é bom ter pessoas que são boas exploradoras, e isso inclui você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Ooh, então isso quer dizer que ninguém roubou trabalho nosso, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Paimon, onde estão seus modos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Bem, como posso dizer... Duvido que a restauração temporária de nossa barreira está completamente a prova de falhas. Realmente se passou um tempo entre a investigação da localização dos Padrões de Chave e a remoção deles, por isso é possível que alguns ratinhos tenham passado nesse período.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Bem, nós realmente estamos com poucas pessoas. Enfim, se você encontrar algum Fatui, Ladrão de Tesouros, Kairagi, ou qualquer um dessa laia... Fique a vontade para lhes dar uma lição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Espere um pouco, se eles chegaram lá embaixo tão facilmente, qual foi o ponto de nós pegarmos aquela Chave-não-sei-o-quê da Lua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Enkanomiya só despertará se recuperarmos a Chave das Profundezas Banhadas pela Lua. Sendo assim, somente essa Chave pode ativar o sistema de julgamentos dentro dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "E se houver alguém que não entrou em Enkanomiya para realizar a Cerimônia de Oferendas de Watatsumi... Bem, podem ter usado alguma outra forma suspeita para entrar. Quem sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "De qualquer forma, por favor, recupere os Padrões de Chave ao redor da ilha o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Os Padrões de Chave estão na Barbatana e Coração de Watatsumi. E quanto aos seus dois altares, podem ser encontrados na intersecção da linha que liga o santuário Sangonomiya com a segunda cadeia de montanhas que rodeia as Profundezas Banhadas pela Lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Bem, esperarei por notícias suas no lugar de sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
