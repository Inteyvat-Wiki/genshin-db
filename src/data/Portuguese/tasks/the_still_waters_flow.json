				{
					"id": 722330401,
					"content": "#Você ainda tem alguma pergunta, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330402,
					"content": "Sobre os Padrões de Chave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "Nós os colocamos na Barbatana e Coração de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330404,
					"content": "Na verdade, nós tentamos encontrar um equilíbrio entre distância e cautela, e esses dois santuários estavam em locais razoavelmente escondidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330405,
					"content": "Nós demos nosso melhor. De verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330406,
					"content": "Sobre os altares...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "Você pode encontrá-los no norte e leste. Eles estão locais na segunda cadeia de montanhas que cerca as Profundezas Banhas pela Lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330408,
					"content": "Se você imaginar duas linhas entre o Santuário Sangonomiya e a Barbatana e Coração de Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330409,
					"content": "Conecte essas minhas com o arco da montanha. Dessa forma, você deverá obter duas posições. Os altares estão nelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
