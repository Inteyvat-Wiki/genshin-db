			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Agora é hora de remover o selo, segure por favor a Chave das Profundezas Banhadas pela Lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Você poderia repetir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "A Chave das Profundezas Banhadas pela Lua",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Você poderia repetir mais 3 vezes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "A Chave das Profundezas Banhadas pela Lua. A Chave das Profundezas Banhadas pela Lua. A Chave das Profundezas Banhadas pela Lua...Urgh... minha língua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "Então é problema do nome... Que tal arranjarmos um outro nome para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Hã? Mesmo que mudemos seu nome hoje, ele só será importante daqui a alguns séculos. Basta aturar isso mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "*Cof* Enfim, vou começar o ritual agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "#Infelizmente, não temos detalhes sobre o tipo de testes que você enfrentará em Enkanomiya. Por isso, lá você só poderá contar consigo mesm{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "Se devemos culpar algo por isso, que culpemos as péssimas tradições que deveriam supostamente \"preservar mistérios\". Desejo-lhe boa sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Além disso, não se force tanto. Sua segurança é mais importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
