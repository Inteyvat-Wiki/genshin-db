					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "Sobre o Reino de Byakuya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Antigamente o nome de Enkanomiya já foi Reino de Byakuya. Não havia nem sol nem lua naquele reino subterrâneo, e os dois únicos fenômenos astronômicos eram a Noite Branca e a Noite Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "Uma de minhas ancestrais era uma sacerdotisa chamada Eboshi. Ela era uma pessoa com uma certa influência na história do Reino de Byakuya, e é graças a ela que estou na liderança da Cerimônia de Oferendas de Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
