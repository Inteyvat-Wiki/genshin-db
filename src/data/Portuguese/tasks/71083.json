				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "Não imaginei que vocês realmente quebrariam o Selo dos Qixing. Parece que terei que escrever isso no meu relatório semanal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Faça com que soe incrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "#*Cof*... Sejam mais séri{F#as}{M#os}, essa é uma situação grave. É tão grave que os Qixing decidiram sobre sua gravidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "O que quer dizer que quando o relatório for enviado, talvez alguém dos Qixing velho aqui pessoalmente lhe impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "E nessa hora, nem mesmo eu poderei lhe salvar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(Suas advertências são óbvias demais...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "#Está assustad{F#a}{M#o}, não é? Está bem, ainda tem alguém lhe esperando, vá logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
