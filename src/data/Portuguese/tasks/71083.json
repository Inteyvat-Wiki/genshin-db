			"dialogs": [
				{
					"id": 710830201,
					"content": "Como está a situação lá embaixo? Algum perigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830202,
					"content": "(Você descreve a situação para Muning).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "Ah, sim. Parece ser perigoso. Acho que terei de pedir a você para proteger Jinwu e Zhiqiong, nesta situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830204,
					"content": "Você não deveria me parar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "É claro que essa é minha responsabilidade. Mas você corre tão rápido que eu simplesmente não consigo parar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830206,
					"content": "Eu não corro rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "Não, eu corro rápido mesmo. Foi isso que escreveram no relatório, e é um fato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830208,
					"content": "Sim, muito rápido mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "Sim, por isso, tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830210,
					"content": "Correu tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "Ainda bem, ainda bem. Se tudo correr bem, os \"Qixing\" não terão razões para nos culpar assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		}
