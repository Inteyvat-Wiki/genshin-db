					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "#Bem vind{F#a}{M#o} à <color=#00E1FFFF>Guilda de Aventureiros</color>. Na verdade, eu já estava de olho em você há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300102,
					"content": "#Você estava observando {NICKNAME}? {M#Ele}{F#Ela} causou algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300103,
					"content": "Oh, não foi isso que eu quis dizer. Estar à procura de grandes aventureiros faz parte do meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300104,
					"content": "Quando olho para você, vejo alguém com o potencial de rivalizar com os grandes aventureiros das lendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300105,
					"content": "Hehe, digo o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300106,
					"content": "#Sempre me sinto segura me aventurando com {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300107,
					"content": "Contudo, para um aventureiro, a experiência é muito mais importante que o potencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300108,
					"content": "Você precisa acumular <color=#00E1FFFF>\"EXP de Aventura\"</color> para aprimorar o seu <color=#00E1FFFF>\"Rank de Aventura\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300109,
					"content": "O tempo é essencial, me permita informar os Cavaleiros recém-recrutados que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300110,
					"content": "Espere! Eu já me tornei um dos aventureiros oficiais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300111,
					"content": "Não se preocupe, a Guilda dos Aventureiros não cobra nenhuma taxa de adesão, nem impõe nenhum tipo de obrigação aos seus membros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300112,
					"content": "Em outras palavras, não há nenhuma desvantagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300113,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "Basicamente, a Guilda dos Aventureiros lhe recompensa toda a vez que você aprimorar o seu Rank de Aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300117,
					"content": "Aqui está um presente para você. Você precisa voltar aqui para poder coletar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300118,
					"content": "Recompensas de Rank de Aventura",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "Eu quero os benefícios!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Haha, as pessoas de hoje em dia estão muito diretas ao ponto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
