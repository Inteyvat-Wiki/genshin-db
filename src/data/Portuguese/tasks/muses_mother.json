			"dialogs": [
				{
					"id": 740730101,
					"content": "A fogueira ainda está queimando. Espera, por que tem uma fogueira aqui? Isso é só uma ruína...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Deixe-me dar uma olhada no que está escrito nesta Placa de Pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "\"Contemplem, este lugar é o Quadrante da Memória, o Salão da Memória, a Sala da Memória.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "\"Nascido em um instante\"... \"Normalmente contraditório, sua companhia em descanso eterno, nunca separado\"... \"Fogo não consegue queimá-lo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Charadas, não é? As antigas civilizações de Fontaine adoravam elas, e a Ordem da Cruz de Narcissus também. Não tenho certeza se só gostam de coisas antigas, ou se genuinamente tinham interesse nelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "Eu já tentei procurar por palavras-chave de todas elas e não encontrei respostas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Mas essa charada já foi resolvida. Talvez a resposta tenha algo a ver com a fogueira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "Existe algum motivo para pensar em charadas que já foram resolvidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "Sim, existe. Assim como você e eu estamos assim agora, mas ainda precisamos descobrir o que aconteceu no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "Você tem um ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#Cavaleir{M#o}{F#a} {NICKNAME}, qual você acha que é a resposta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
