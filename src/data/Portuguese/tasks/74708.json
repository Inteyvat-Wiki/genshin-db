			"dialogs": [
				{
					"id": 747080101,
					"content": "#Olá, {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "A Srta. Guillotin mencionou que vocês estão administrando um aquário. Naturalmente, aceitei o convite dela para vir e servir como consultora marinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Estamos felizes em te ter conosco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Ótimo! Com a Enfermeira-Chefe por perto, não vamos ter que nos preocupar com os peixinhos ficando doentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Hehe, desde que vocês me pediram para cuidar dos animais no Mundo Fantástico Chevalmarin Filmes, aprendi alguns truques da área...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Na verdade, cuidar de animais não é tão diferente de cuidar de nossos pacientes. Bem, os bem-comportados, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "#Mas desta vez, além de mostrar peixes normais, também tenho alguns planos de reabilitação que gostaria de discutir com {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Por favor, continue, estou ouvindo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "A Oficial Ceasth disse que certos peixes selvagens se tornaram estranhamente agressivos recentemente. Aparentemente, eles estão atacando outras criaturas, assim como mergulhadores e até barcos pequenos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Estava me perguntando se podíamos convidar alguns deles para descansar no aquário? Pelo menos, vai impedi-los de causar mais problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Quando estiverem aqui, posso procurar um jeito de curar o mau temperamento deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "Assim, podemos ajudar os peixes e as águas a voltarem ao normal, e você pode adicionar alguns convidados únicos ao seu aquário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Que ideia maravilhosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Você tem todo o meu apoio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Tudo bem, vou passar todas as informações que tenho sobre onde encontrar esses peixes agressivos. O resto fica por conta de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Agradecemos muito a ajuda extra!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}