			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "Hã? O que você está olhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340202,
					"content": "Este caderno explica como cuidar de flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "Mesmo? Deixe Paimon dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340204,
					"content": "\"... Devem ser plantadas em um espaço aberto, e precisam de muita luz do sol...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340205,
					"content": "Collei não deve ter tido tempo para movê-las para fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340206,
					"content": "Hehe, então vamos cuidar dela por Collei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340207,
					"content": "Hmm... Enfim, vamos primeiro mover essa flor e colocá-la do lado da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340208,
					"content": "Mas também não vamos colocar muito longe, ou então quando Collei voltar e não encontrar, ficará nervosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "Hmm, essa carta parece ter sido escrita pela Collei. Vamos dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340602,
					"content": "Mas porque ela ainda não está aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Talvez ela tenha partido para fazer algum trabalho com Tighnari. Eles sempre estão muito ocupados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340604,
					"content": "Vamos ler a carta. Olha só para essa letra, Paimon acha que Collei estava se esforçando bastante quando a escreveu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340605,
					"content": "#\"{NICKNAME} e Paimon, muito obrigada por me ajudarem a cuidar de minha flor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340606,
					"content": "\"Estamos com tanta coisa para fazer na floresta que sempre esqueço de cuidar dela quando estou ocupada...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340607,
					"content": "\"Obrigada mais uma vez pela sua ajuda. Vamos comer Navio de Batata no restaurante do Sr. Jahangir quando eu tiver um tempo livre!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340608,
					"content": "Uau! Collei vai nos convidar para comer! Anote isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340609,
					"content": "Bem, Paimon não faz ideia com o que ela está ocupada. Mas ela com certeza parece estar sem tempo livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340610,
					"content": "Paimon espera que ela possa descansar bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}