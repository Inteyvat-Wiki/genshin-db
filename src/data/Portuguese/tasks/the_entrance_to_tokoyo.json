			"dialogs": [
				{
					"id": 722420401,
					"content": "Uau! Paimon nunca imaginou que existia um lugar tão grande sob a Ilha Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420402,
					"content": "Parece que nosso objetivo é aquele lugar no centro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420403,
					"content": "#Certo, {NICKNAME}. Vamos entrar, mas sem chamar atenção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Aquelas ruínas parecem estar mais perto de nós, vamos começar por elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Prédios significam que já houveram pessoas nele... Em algum momento, pelo menos. E onde há pessoas, há escrita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420406,
					"content": "E onde há escrita e papel, haverão... Pistas que nós sequer conseguimos ler.",
