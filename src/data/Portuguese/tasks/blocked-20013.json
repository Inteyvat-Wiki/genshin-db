			"dialogs": [
				{
					"id": 200130301,
					"content": "Muito obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Eu queria visitar os lugares onde o Stanley se aventurava, mas não imaginava que no meio do caminho encontraria esses caras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Eu não sou forte o suficiente... Com certeza Stanley não teria tido problemas para lidar com um grupo como aquele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Por que você não se junta a mim? Junte-se a mim! Ugh... deixa para lá, não posso ficar dependendo de outra pessoa durante minha aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Vou continuar seguindo em frente, isso é para você. Eu coletei bastante para os meus suprimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "Mas... isso não é bem uma ração... né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
