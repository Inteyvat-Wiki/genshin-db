			"dialogs": [
				{
					"id": 200130201,
					"content": "Afinal é você, muito obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130202,
					"content": "Posso pedir um favor para você...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130203,
					"content": "Este bloqueio aqui é a única coisa que está separando a aventura de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130204,
					"content": "Você pode tirar o bloqueio para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130205,
						200130206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130205,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130207
					]
				},
				{
					"id": 200130207,
					"content": "*Suspiro* Eu queria ser que nem você... Eu seria um Aventureiro veterano a essas alturas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130206,
					"content": "Ainda tenho outro assunto para tratar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200130208
					]
				},
				{
					"id": 200130208,
					"content": "Por favor, eu imploro... Não posso deixar que minha aventura termine aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
