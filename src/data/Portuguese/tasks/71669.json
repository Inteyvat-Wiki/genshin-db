			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}, soube da equipe que você encontrou todos os animais pequenos equipados com transmissores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690102,
					"content": "Isso é... bem surpreendente, sério. Alguns deles são naturalmente sensíveis e fugirão assim que notarem uma criatura desconhecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690103,
					"content": "Mas eles não te impediram de se aproximar. Muito curioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690104,
					"content": "#Bem, sou um{F#a} amig{M#o}{F#a} de todos os animais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "Haha! Realmente invejável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690107,
					"content": "Rugiram para mim ou me morderam nas últimas vezes que a equipe me acompanhou para alimentar os animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690112,
					"content": "Tenho cicatrizes no meu braço para mostrar... e também dói bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690113,
					"content": "Mas apesar dessas adoráveis criaturas não parecerem muito, fico feliz que todas estão vivendo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690114,
					"content": "É o mesmo para todos os nossos adotantes. Todos só querem proteger o habitat dos animais e deixá-los em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690115,
					"content": "Sei que para muitos aventureiros, animais selvagens são uma importante fonte de comida, e não estamos pedindo para os membros do Comboio Garra deixarem de caçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690116,
					"content": "Mas advocamos contra captura e abate desenfreado. Se todos pudessem fazer isso, o ambiente ao nosso redor com certeza seria enriquecido em variedade e beleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690117,
					"content": "#Como um{F#a} de nossos membros, seria incrível se você reconhecesse e aceitasse esse princípio também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690118,
					"content": "Eu concordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "Sabia que uma pessoa sensata como você aprovaria nossa abordagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690122,
					"content": "Só fazer as pessoas pensarem nisso é suficiente para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690123,
					"content": "Se tivermos chance, eu adoraria ver você no próximo evento do Comboio Garra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690124,
					"content": "Mas com sorte, eu não vou ter nenhuma cicatriz nova no meu braço quando chegar a hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690120,
					"content": "Minha opinião ficará reservada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "Tudo bem, não estamos forçando ninguém a aceitar isso, mas eu gostaria que todos pensassem bastante antes de tirar uma vida de um animal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690105,
					"content": "#É um dos meus dons como aventureir{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
