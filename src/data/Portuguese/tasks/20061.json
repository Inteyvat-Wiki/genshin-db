			"dialogs": [
				{
					"id": 200610101,
					"content": "Sobre os pombos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610102,
					"content": "Esses pombos seriam um bom aperitivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610103,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "Eu costumava criar alguns pombos-correios, para entregar as cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610105,
					"content": "Por alguma razão eles estão ficando cada vez menos confiáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610106,
					"content": "Ou perderam as cartas, ou ficaram parados no chão, esperando por alguém os apressar, e não entregaram as cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610111,
					"content": "Se você estiver com tempo, talvez você possa dar uma olhada naqueles pombos que acabei de soltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610107,
					"content": "Entendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "Ótimo, então se você encontrar alguns pombos, me ajuda a expulsá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610109,
					"content": "Os pombos vão me odiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "Não se preocupe. A memória dos pombos é muito curta, eles se esquecem de tudo depois de um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610112,
					"content": "Não sabia que você gostava tanto de pombos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
