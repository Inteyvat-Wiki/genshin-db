			"dialogs": [
				{
					"id": 200610501,
					"content": "Sobre os pombos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610502
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610502,
					"content": "Ei! O que está fazendo. Estes pombos são para entregar as cartas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610503,
					"content": "Sério, qual é o seu problema? Ainda tenho muitas cartas para enviar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610504,
					"content": "Desculpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "Isso é o melhor que você pode fazer? O Cavaleiro de Favonius e o melhor que você pode oferecer é uma desculpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610508,
					"content": "Você realmente se empolgou aqui e agora precisa fazer do jeito certo. Desde que você é tão bravo de qualquer maneira, eu acredito que você não terá nenhum problema em ser meu novo pombo-correio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610506,
					"content": "Às vezes eu não conheço a minha própria força...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "Apressar os pombos? Com frigideira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				}
			]
		},
