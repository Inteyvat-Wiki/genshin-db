						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Talvez assim eles vão entregar as cartas sem problemas no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "Mas não consigo seguir os seus passos... Enfim, acho que é o suficiente por agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Obrigado pelo seu esforço, aceite isso como agradecimento. E se você precisar enviar alguma mensagem, venha me procurar.",
