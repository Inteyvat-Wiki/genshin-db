				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "#Oh, olá, Cavaleir{F#a}{M#o} Honorável! Você está aqui para ver a Mestre Jean, ou posso ajudar você com outra coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Só estou perambulando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Estou fazendo uma faxina de rotina nos escritórios dos Cavaleiros de Favonius. Já varri a maior parte da poeira. Agora vou reorganizar nossos arquivos antigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Esses documentos estão se empilhando há um tempo. Todos terão mais facilidade em procurá-los se eu organizar em categorias diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Além disso, posso aprender mais sobre aqueles que vieram antes de mim. Isso não deixa de ser uma forma de treinamento, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Você continua levando seu trabalho muito a sério, Noelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "É o meu dever. Você e os outros Cavaleiros sempre estão dando seu melhor, por isso tenho que acompanhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Sua determinação é memorável...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Hã? Eu? Obrigada! Mas, é só que... eu acabei de limpar, vou estar coberta de poeira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Ah, mas esse é o ponto! Fotografar você dando seu melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "Hã, não é meio cedo para me chamar assim? Mas, se você quer tirar a foto... seria uma honra, mesmo eu estando coberta de poeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "Tenho certeza que você vai fotografar no momento perfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "Eu quero registrar a ruptura da Cavaleira Empregada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "... Deixe-me tirar uma foto sua!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Você está ocupada com o que, Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
