			"dialogs": [
				{
					"id": 3840401,
					"content": "Barbat... Venti, tenha cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840402,
					"content": "Haha... Você já descobriu a minha identidade faz um tempo, né, Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840403,
					"content": "Mas obrigado por continuar me chamando de Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840404,
					"content": "Como está a Lira Sagrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840405,
					"content": "Ela ainda pode ser tocada? Ou ela precisa de alguns reparos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840406,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840407,
					"content": "Infelizmente, acho que não é possível repará-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840408,
					"content": "Não podemos deixar este Feiticeiro do Abismo fugir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "Você está certo. Se não combatermos o mal na sua origem, não podemos salvar Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840413,
					"content": "Neste caso, pedirei a Aventureira Amber para rastrear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840414,
					"content": "Não precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840415,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840416,
					"content": "Erradiquei um pouco tempo atrás, em um dos templos dos Quatro Ventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840417,
					"content": "O quê!? Quando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840418,
					"content": "Se quiserem ir atrás desses monstros, podem fazer o uso dos meus contatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840419,
					"content": "Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840420,
					"content": "Embora ele não goste dos Cavaleiros de Favonius, ele protege Mondstadt à sua maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840421,
					"content": "Ooh? Por que nossa pequena Paimon parece tão fofinha de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840422,
					"content": "Hunf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840423,
					"content": "Aguardem minhas informações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840424,
					"content": "Com certeza deixarei a Ordem do Abismo perceber seu flagrante desrespeito por Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840425,
					"content": "Tem certas coisas em Mondstadt que não podem ser deixadas de lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840410,
					"content": "Dvalin está em grande perigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "Não, temos que fazer com que o Feiticeiro do Abismo pague pelo que fez primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840412,
					"content": "Se não combatermos o mal na sua origem, não podemos salvar Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
