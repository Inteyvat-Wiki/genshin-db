			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050201,
					"content": "#Vocês {F#duas}{M#dois} devem ser dos Ladrões de Tesouro? Eu pensei que fui claro na carta em que eu estaria usando uma fantasia e que vocês também deveriam fazer o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050202
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050202,
					"content": "#No entanto, {M#um}{F#uma} de vocês está vestid{M#o}{F#a} com roupas comuns, para todo o mundo ver. Devo dizer que admiro sua coragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050203
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050203,
					"content": "Hmph! Bem, adivinha só? Não precisamos nos esgueirar por toda parte usando disfarces ridículos! Porque, diferentemente de você, nunca faríamos algo tão desagradável e horrível que precisaríamos usar máscaras ao fazê-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050204,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050205,
						400050206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050205,
					"content": "Ele disse para usarmos máscaras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				},
				{
					"id": 400050207,
					"content": "Vocês... Vocês não são dos Ladrões de Tesouro! Quem são vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 400050206,
					"content": "Na verdade, acho que estou começando a gostar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050207
					]
				}
			]
		},
		{
			"id": 4000504,
			"completionStepIds": [
				4000504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000504",
							"2"
						],
						"stepId": 4000504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400050401,
					"content": "Nos conte o seu plano diabolico agora! Acabou, já chega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050402,
					"content": "Ok, eu desisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050403
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050403,
					"content": "Renda-se agora ou sinta a ira da Paimon... Hum? Tão rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050404,
					"content": "Eu, hum... Eu sou um ladrão aprendiz que realmente está à procura dos Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050405
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050405,
					"content": "Um aprendiz de ladrão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050406,
					"content": "Pois é... Para um completo novato como eu - especialmente trabalhando sozinho... Ladrões de Tesouro? Seria uma grande honra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050407
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050407,
					"content": "Espere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050408,
					"content": "Por isso eu pensei em uma solução lucrativa e prometer minha lealdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050409
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050409,
					"content": "A Paimon disse, espere um segundo! Nada disso faz sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050410,
					"content": "Não foi isso que imaginei quando pensei em um piromaníaco do mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050411,
					"content": "...Piromaníaco? O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050412
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050412,
					"content": "Não finja que não sabe do que estou falando! Eu vi você no lugar onde colocam os materiais inflamáveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050413,
					"content": "Ah, sim. Eu sei o que você quer dizer, mas eu apenas estava conferindo o local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050414
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050414,
					"content": "Meu plano na verdade não tem nada a ver com os materiais de construção da lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050415
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050415,
					"content": "... Você está brincando comigo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050416,
					"content": "Eu apenas queria roubar a maior Plaustrite em 20 anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050417
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050417,
					"content": "Meu plano era cortar as cordas durante a noite e deixar que flutuassem no mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050418
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050418,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050419,
					"content": "Então eu encontraria uma maneira de derrubar e esconder ela na água rasa da baía. Sob a cobertura do mar de nuvens. O crime perfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050420
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050420,
					"content": "Tem muitas partes que ainda não estão boas! Por exemplo, como você está planejando em trazer a Plaustrite quando ela estiver no ar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050421,
					"content": "Eu também estou pensando nesse problema, por isso ainda não agi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050422
					],
					"speakerTitle": "???"
				},
				{
					"id": 400050422,
					"content": "Este cara é um completo cretino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050423,
					"content": "#{NICKNAME} dê uma lição a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050424,
					"content": "Vamos encontrar o Yaksha e informá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
