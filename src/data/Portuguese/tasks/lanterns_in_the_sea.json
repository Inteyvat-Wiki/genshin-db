						400050502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050502,
					"content": "Enfim, eu estou aqui, no lugar que você insistiu. A Lanterna Mingxiao está à vista. Por que você me invocou aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050503,
						400050504
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050503,
					"content": "Para ver a Lanterna Mingxiao, é claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				},
				{
					"id": 400050505,
					"content": "Você obviamente é um dos heróis do festival... Por que você não quer participar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050506,
					"content": "Não posso ficar no meio de multidões. Os humanos vivem desocupados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050507,
					"content": "Passei muito tempo sofrendo e assassinando. É tudo o que sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050508,
					"content": "Vamos mudar de assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050509,
					"content": "Tchau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050510,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050511,
					"content": "Caso você encontre algo sobrenatural em Liyue, pode me chamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050512,
					"content": "Não importa se é você ou Liyue. Eu ouço todos os gritos de ajuda, e todos os desejos carregados pelas lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400050513
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400050513,
					"content": "#Obrigad{M#o}{F#a}... e Feliz Ano Novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050514
					]
				},
				{
					"id": 400050514,
					"content": "Feliz Ano Novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400050504,
					"content": "Para celebrar o Ritual de Lanternas é claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400050505
					]
				}
			]
