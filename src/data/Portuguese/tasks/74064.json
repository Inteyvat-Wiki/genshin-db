			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maupoil",
					"Galvaryet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "Capturar uma Foquinha Rotunda e fazer ela cuspir na marca funcionaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640202,
					"content": "Tá falando sério? Você tá muito estressado ultimamente? Você tá bem da cabeça? Te colocaram para trabalhar muitos turnos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640203,
					"content": "Estou absolutamente bem. Eu só quero ver uma Foquinha Rotunda cuspir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640204,
					"content": "Você precisa tirar um dia de folga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406403",
							"2"
						],
						"stepId": 7406403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clynes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "Hã? Aquele não é o Clynes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640302,
					"content": "Oi, Clynes. Nos encontramos de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "Hã? Se Clynes tá aqui, então aquela marca foi mesmo coisa dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640306,
					"content": "Hã? O que vocês estão fazendo aqui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640307,
					"content": "Do que vocês estão falando? Tô completamente perdido. Por que não pergunta a outra pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640308,
					"content": "Acho que pegamos o cara errado, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#Oh, a gente pegou o cara errado, né... Espera! Não deixa ele te enganar, {NICKNAME}! Não tem mais ninguém aqui! Tem que ser ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640312,
					"content": "Beleza, vocês venceram. Eu pichei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640313,
					"content": "*Suspiro* Eu queria usar isso para saber de uns conhecidos, mas não esperava que vocês que iam aparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640314,
					"content": "Saber de uns conhecidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640315,
					"content": "A Carta Cifrada é uma tecnologia desenvolvida pelo Sr. Butor, e poucos sabem como decodificá-la, mesmo no Instituto de Pesquisas de Fontaine. A única razão de eu saber dela é porque eu já fui um beneficiário dos cuidados dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640316,
					"content": "Infelizmente, ele nos deixou jovem demais, e a gestão não se importa com a tecnologia da Carta Cifrada. Então, eu pensei que se alguém por aí pudesse decifrá-la, teríamos algo para conversar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640317,
					"content": "Oh, eu não quero dizer que tenha nada para se conversar entre nós, mas há muitos assuntos que não temos em comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640318,
					"content": "Não precisa forçar, não há mesmo nada a dizer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "#Você é muito honest{M#o}{F#a}. Eu já tive um amigo franco como você e se meteu em muitos problemas por causa disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640320,
					"content": "Mas olhando para trás agora, aqueles eram tempos felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640325,
					"content": "Enfim, essa é a única razão por estarem aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640326,
					"content": "Paimon quase esqueceu! Galvaryet e Maupoil pediram para a gente investigar o culpado por trás da pichação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640327,
					"content": "Se entregue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "Se entregue! Não vamos ter misericórdia se você resistir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640329,
					"content": "*Suspiro*... A gente não pode só conversar sobre isso? Esqueça Maupoil, eu só não quero cair nas garras de Galvaryet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640330,
					"content": "Seria possível para você, sabe, só virar a cara para isso tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640331,
					"content": "Mas Maupoil disse que pichação é proibida na Fortaleza Meropide! Quebrar as regras é ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640332,
					"content": "#Se você for um pouco generos{M#o}{F#a} com definições, então as Cartas Cifradas na parede não são diferentes das outras escritas por lá. São só decorações, nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640333,
					"content": "#Que tal eu ir com vocês, mas {NICKNAME} pode decidir se me entrega ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640334,
					"content": "Claro, se você escolher me ajudar e me salvar das garras de Galvaryet, eu estaria disposto a compensar vocês de acordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640335,
					"content": "Estou colocando meu destino em suas mãos. Vamos sair agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640321,
					"content": "Me desculpe por isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "Hah! Quando você diz uma coisa dessas, como espera que eu responda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640323,
					"content": "Eu sei que em tempos assim, eu deveria ser educado e dizer algo tipo \"pode ser legal ouvir sobre suas aventuras\". Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640324,
					"content": "Pelo menos quando chegar a isso, decidi ser honesto comigo mesmo. Não quero ouvir novas histórias sobre o mundo externo, tudo que quero é saber como as pessoas estão. Então, devo me desculpar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640310,
					"content": "Dê uma olhada. Tá vendo mais alguém aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "É, isso mesmo! Pode parar de tentar enganar a gente com essa atuação mixuruca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640304,
					"content": "Confesse! Foi você, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
