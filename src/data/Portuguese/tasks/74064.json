			"dialogs": [
				{
					"id": 740640101,
					"content": "Eu disse, ou você encontra um jeito de tirar isso, ou de descobrir quem está por trás disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640102,
					"content": "Fácil para você falar... Tentei todos os tipos de limpadores e nenhum deles funcionou. Se precisar de algo mais poderoso... Só posso tentar o repelente de Fantasma Hydro Corrompido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640103,
					"content": "Repelente de Fantasma Hydro Corrompido? Vocês estão tentando fazer um buraco na parede?! Fazer todo mundo dormir com os peixes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640104,
					"content": "Vamos ter que encontrar o culpado. Mas não temos nenhuma pista a respeito de sua identidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640105,
					"content": "O que foi? Podemos ajudar com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640106,
					"content": "Bem... tá vendo aquela marca na parede? Pichações são proibidas na Fortaleza Meropide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640107,
					"content": "Tentamos de tudo, mas ainda não conseguimos remover, então se a gente pudesse pelo menos localizar o culpado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640108,
					"content": "Espera um pouco, agora pensando melhor, não estamos completamente perdidos. Me lembro de Clynes falar que o Instituto de Pesquisas de Fontaine tem uma marca que requer um método especial para decifrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640109,
					"content": "Você está tentando dizer que é o mesmo tipo de marca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640110,
					"content": "Na época eu não era nem um pouco interessada, então não me incomodei de pedir mais informações. Talvez ele pudesse nos dar uma resposta se estivesse aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640111,
					"content": "Talvez ele seja o culpado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "De fato, não podemos excluir a possibilidade. Mas se esse fosse o caso, hehe... Ele deve saber das regras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME} e Paimon, vocês são aventureir{M#os}{F#as} experientes com uma fortuna de conhecimento, têm alguma ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640116,
					"content": "Ajudem a gente a achar o culpado por trás do grafite e trazer Clynes aqui para dar uma olhada. Hmm... Considere uma comissão oficial, o pagamento vai ser em Cupons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640117,
					"content": "Tudo bem, se é uma comissão oficial, vamos dar um jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640118,
					"content": "Obrigada. Enquanto isso, vou tentar encontrar outras maneiras de removê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640113,
					"content": "Vamos procurar por ele então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "Não faço ideia de onde ele tá... Não o vi o dia inteiro. E a gente vai mesmo pedir a ajuda dele? Eu perco um pouco de autorrespeito toda vez que peço alguma coisa a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Maupoil"
				}
			]
		},
		{
			"id": 7406402,
