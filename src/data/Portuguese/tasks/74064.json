			"dialogs": [
				{
					"id": 740640401,
					"content": "Vejo que encontraram Clynes. Mas... Vocês acharam a pessoa responsável pela pichação? Ou pelo menos alguma pista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640402
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640402,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640403,
						740640413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640403,
					"content": "Foi Clynes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640404
					]
				},
				{
					"id": 740640404,
					"content": "Acho que você tem razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640405
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640405,
					"content": "Ugh, e do nada, todas as desculpas que inventei são inúteis. Acho que estou no corredor da morte agora, só esperando para ver como você vai me descartar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640406
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640406,
					"content": "Regras são regras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640407,
					"content": "Estou mais preocupado sobre como remover essa marca do que a punição que você vai receber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640408
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640408,
					"content": "Você tem interesse na tecnologia da Carta Cifrada? Vai levar um bom tempo para explicar, então por não se senta e escuta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640409
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640409,
					"content": "Não, não tenho interesse nos detalhes. Só me conte como remover...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640410
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640410,
					"content": "Até isso é uma longa história. Afinal, tinta e técnicas especiais foram usadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640411,
					"content": "Tenho outro trabalho para fazer, então seja breve. Hmm... Por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640412
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640412,
					"content": "#Vamos deixá-los. {NICKNAME} e Paimon, aqui está a recompensa que foram prometid{M#os}{F#as}. Agradeço a ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640413,
					"content": "Isso requer um profissional. Vamos pedir para Clynes dar uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640414
					]
				},
				{
					"id": 740640414,
					"content": "Clynes, essa é a marca especial que você mencionou antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640415
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640415,
					"content": "Deixe-me ver... Hmm... Oh... Não parece muito com uma engrenagem? De onde mais uma engrenagem tão grande poderia vir senão do Instituto de Pesquisas de Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640416
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640416,
					"content": "É do Instituto de Pesquisas de Fontaine, assim como você. Diria que a conexão entre vocês é bem óbvia. Só admita, você é o culpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640417
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640417,
					"content": "Você não pode dizer isso assim! Se um dia eu for sortudo suficiente para jantar com Galvana no Hotel Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640418
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640418,
					"content": "Se você ainda estiver na terra dos sonhos, posso te ajudar a acordar. E se você achar que meus socos não são fortes o bastante, tenho certeza que Roussimoff estaria disposto a dar uma mão também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640419
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640419,
					"content": "Calma, só estou te dando um exemplo! É só um exemplo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640420
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640420,
					"content": "Onde eu estava... Ahem, enfim, se Galvana e eu saíssemos, apesar de sermos da Fortaleza Meropide, poderia não ter nenhuma conexão entre nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640421,
					"content": "Viu? Não tem nenhuma conexão! Nenhuma ligação entre mim e esta marca, assim como não há relação entre mim e Galvana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640422
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640422,
					"content": "Certo, você me convenceu. Mas só sobre a relação entre você e minha irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640423
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640423,
					"content": "Isso não quer dizer que não te convenci nem um pouco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640424
					]
				},
				{
					"id": 740640424,
					"content": "N-Não temos mais nada a dizer sobre isso. É com vocês agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640425,
					"content": "Bem, de toda forma, devo meus agradecimentos a vocês. E a recompensa prometida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640426
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640426,
					"content": "#Certo! {NICKNAME} e Paimon! Quase esqueci a recompensa de vocês! Embora seja uma pena que não puderam localizar o culpado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640427
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640427,
					"content": "Mas tenho certeza que Clynes terá um jeito de remover a marca! Vou deixar o resto com Galvaryet e Clynes, tenho outros assuntos para resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		},
