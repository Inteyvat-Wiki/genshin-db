				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "Ah. Maravilhoso! Esses devem ser todos eles agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330302,
					"content": "...Espera. Por que \"não são\" todos eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330303,
					"content": "Urgg... Por que Paimon sente que isso está apenas se arrastando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330304,
					"content": "É verdade que resolver casos às vezes requer muita paciência. Seguir o caminho errado pode acabar a levar a encontrar absolutamente nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330305,
					"content": "Encontramos uma grande quantidade destes pequenos animais, por isso estamos pelo menos indo na direção certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330306,
					"content": "Talvez tenhamos perdido apenas algumas pistas pelo caminho ou deixado alguns locais por investigar, levando assim ao nosso atual impasse. Será temporário, creio eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330307,
					"content": "Ooh, Paimon entendeu! Você está dizendo que precisaremos de um pouco de pó de pirlimpimpim para finalmente resolver isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330308,
					"content": "Hmm, sim, acho que você poderia dizer que no momento estamos em falta de algum pirlimpimpim. Mas não por muito, devo dizer - temos feito um ótimo progresso graças a vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330309,
					"content": "(Ele... Realmente te entendeu, Paimon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "Isso faz muito sentido, Ryuuji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330312,
					"content": "Você me lisonjeia. Falo apenas por experiência própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330313,
					"content": "Quanto mais fundo a verdade está enterrada, mais valor há em desvendá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330314,
					"content": "É apenas uma pena que não tenhamos nenhuma informação adicional no momento. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330315,
					"content": "Suponho que vou simplesmente relatar nossa situação atual à Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330316,
					"content": "Ela deve ser capaz de considerar alguns ângulos que ainda não vieram à mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330317,
					"content": "Claro! Paimon confia no seu bom senso, afinal de contas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330318,
					"content": "Então está decidido. Vamos nos encontrar no lugar de sempre quando aparecerem mais pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330319,
					"content": "Se por acaso eu estiver ocupado no momento, você pode simplesmente procurar Sango diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330310,
					"content": "(Parece que ele está começando a te entender muito bem, Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
