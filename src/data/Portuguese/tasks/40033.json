			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "Oh, bem na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330102,
					"content": "Acabei de checar vários locais suspeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330103,
					"content": "Um desses acampamentos está sendo guardado pelo Cacho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330104,
					"content": "*Cof* Digo, por Sombra. Se você não tiver mais perguntas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330105,
					"content": "Quanto às investigações de ontem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "Quanto a isso, eu não sei sobre nada no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330107,
					"content": "Hã!? A Sango não te mandou ir investigar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330108,
					"content": "Ela mandou, sim, mas... Como posso dizer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330109,
					"content": "Por exemplo, \"alguns Melões de Lavanda excessivamente maduros\" e \"impressões de mãos lamacentas em uma porta\" não se conectam de forma significativa em minha mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330110,
					"content": "Mas para Sango, estes são os materiais que ela precisa para desvendar mistérios tão complexos como o \"yosegizaiku\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330111,
					"content": "\"Alguns Melões de Lavanda excessivamente maduros\" e \"impressões de mãos lamacentas em uma porta\"... Como estas coisas estão relacionadas, mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400330112,
					"content": "Estou apenas usando uma analogia. Sob sua orientação, investiguei alguns locais na Ilha Yashiori e na Floresta Chinju antes de relatar o que eu havia visto de volta para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330113,
					"content": "Quanto a quaisquer conclusões que ela possa ter tirado de meus relatórios, só ela sabe quais são.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330114,
					"content": "Para ser honesto, somente Shikanoin é capaz de acompanhar sua linha de pensamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330115,
					"content": "Shikanoin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "Alguém da Comissão Tenryou. Tivemos o privilégio de conhecê-lo em um caso anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330117,
					"content": "Ele é um sujeito bastante... Único. Você saberá o que quero dizer se alguma vez o conhecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330118,
					"content": "Muito bem, então. Os animais estão em suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 400330119,
					"content": "Paimon ainda está pensando naqueles \"melões de lavanda excessivamente maduros\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
