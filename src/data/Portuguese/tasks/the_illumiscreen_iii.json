				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "Seja bem-vindo a testar a Kaleidolanterna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590102,
					"content": "Você tem outra imagem para mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "Pode apostar! E como você resolveu as duas anteriores tão facilmente, troquei as lanternas pelas mais difíceis disponíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590104,
					"content": "O mesmo princípio se aplica - você combina três imagens para fazer um todo. A dificuldade está no fato de que elas estão <color=#00E1FFFF>ligadas entre si</color> desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590105,
					"content": "Hehe, você vai ver o que quero dizer quando tentar. Desta vez, você está procurando por uma <color=#00E1FFFF>Garça Divina</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590106,
					"content": "Uma vez que você consiga alinhar as imagens, você pode ir procurar o tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
