			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "Como está indo a caça ao tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590202,
					"content": "Achei todos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Uau, você conseguiu decifrar as três imagens... Isso é impressionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590204,
					"content": "Bem. A Guilda preparou um presente extra-especial para você, por ser um aventureiro tão talentoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590205,
					"content": "Está vendo esses baús? Vá em frente e abra-os. O conteúdo deles é todo seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590206,
					"content": "Depois de eu pegar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "Sim, não vai restar nada para mais ninguém. É assim que funciona a aventura! Achado não é roubado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590208,
					"content": "Muito bem, então, feliz Ritual de Lanternas. Até mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
