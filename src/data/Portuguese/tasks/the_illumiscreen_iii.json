					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590302,
					"content": "#Isso também não desanima você, né? Devo dizer que você é {M#um}{F#uma} grande aventureir{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590303,
					"content": "Vá dar uma olhada nas telas. Todas as pistas do tesouro estão escondidas lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
