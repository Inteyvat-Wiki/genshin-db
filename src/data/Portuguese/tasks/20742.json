				},
				{
					"id": 207420702,
					"content": "Ah, o que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420703
					]
				},
				{
					"id": 207420703,
					"content": "Você! Donna me falou que você soprou todos meus Dandelions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420704
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420704,
					"content": "Me desculpa, é que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420705
					]
				},
				{
					"id": 207420705,
					"content": "Donna me falou que foi você que soprou todos meus Dandelions?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420706
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420706,
					"content": "Se você precisa de sementes de Dandelion, por que não vai colher na área rural? Eu cuidei dessas flores por muito tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420707
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420707,
					"content": "E as sementes foi você que me ajudou a colher. E agora você faz isso?",
