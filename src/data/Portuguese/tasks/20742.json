					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420102
					]
				},
				{
					"id": 207420102,
					"content": "Ah! Dandelions! Voaram todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420103
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420103,
					"content": "O que você fez! Foi muito difícil plantar todos esses Dandelions!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420104,
					"content": "Eu estou ajudando eles a se espalharem até bem longe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420105
					]
				},
				{
					"id": 207420105,
					"content": "Aqui é a cidade! Não irão voar para longe pois tem o muro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420106,
					"content": "Assim, podem florescer mais Dandelions...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207420107
					]
				},
				{
					"id": 207420107,
					"content": "Então por que você não pega umas sementes de Dandelion e vai espalhar elas fora da cidade?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420108
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420108,
					"content": "*Choro* Meus Dandelions, foi tão difícil plantar eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420109,
					"content": "Você... A próxima vez que você precisar de Dandelions pode ir colher fora da cidade, está bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207420110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207420110,
					"content": "E as sementes desses Dandelions foi você que me ajudou a colher. Eu cuidei delas por muito tempo para que crescessem assim... E agora você faz isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
