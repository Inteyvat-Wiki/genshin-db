					"content": "Você... Não é... Bem-vindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Hehehe... O lobo com espírito miserável está criando filhotes agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Apóstolo do Abismo"
				},
				{
					"id": 80020303,
					"content": "E você se considera um guardião? Suas antes afiadas garras claramente não são mais como os seus dias de glória divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Apóstolo do Abismo"
				},
				{
					"id": 80020304,
					"content": "Renda-se a nós, e você voltará a ter o poder divino que tinha antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Apóstolo do Abismo"
				},
				{
					"id": 80020305,
					"content": "Mentira... Mentira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020306,
					"content": "Que cerimônia é essa? Parece que ele está sofrendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Ugh. Será que é a mesma coisa que eles usavam para corromper o espírito de Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "Nós lobos jamais nos renderemos! Porém, não poderemos continuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Deixe-me acabar com ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Não importa quantas vezes tentem, os seus esforços serão todos em vão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Apóstolo do Abismo"
				},
				{
					"id": 80020310,
					"content": "É apenas mais uma rodada de luta com o Apóstolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
