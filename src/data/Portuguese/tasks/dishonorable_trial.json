			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Estátua gigante e uma Catedral espetacular... O povo de Mondstadt deve ter colocado muitos recursos e esforços para construí-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020402,
					"content": "Mas até que ponto o Arconte Anemo estava ciente disso ao receber esse presente, e o quanto ele retribuiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020403,
					"content": "A fé não pede nada em troca, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Hmmm. Desde que os deuses tenham consciência sobre isso, não tenho nada para reclamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "Shhhh! Estamos prestes a entrar na Catedral! Qualquer desrespeito contra o Arconte Anemo não é bem-vindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "Mas... Na verdade o Arconte Anemo... Bah, esqueça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Eu não queria entrar na Catedral... Vocês sabem como lidar com as Freiras, vou deixar isso com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "Ei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Mas a gente sempre andou junto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "#Você é {M#o}{F#a} Cavaleir{M#o}{F#a} Honorável com maior confiança do povo de Mondstadt. Pode participar desse assunto sem problema nenhum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "E agora, se eu aparecer, elas ficarão de alerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "É porque você é um desconhecido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Sim. Como a amiguinha disse, eu poderia dizer algo inapropriado sobre a Catedral a qualquer momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "Quando um não crente pisa em um lugar sagrado, as coisas não terminam bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Eu nunca fui abençoado pelos Arcontes, e não vejo a necessidade disso agora e no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "Bom, chega de enrolar. Vocês sabem que a Ordem do Abismo não para de criar problemas enquanto nós estamos falando aqui, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Uh! Então... {NICKNAME}, nós {M#dois}{F#duas} vamos entrar e perguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Tenho que lembrar a vocês que convém não dizer nada sobre aquela Estátua Profanada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "A Igreja Favonius tem ficado afastada dos assuntos da Estátua. Mas se eles se intrometerem, temo que acabarão alertando o inimigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "Ainda por cima... Qualquer pessoa que se envolva com a Ordem do Abismo não sai com bom resultado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "Você acha que não ia ser bem-vindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Você não está curioso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
