			"dialogs": [
				{
					"id": 200500201,
					"content": "Como você está se saindo? Já encontrou uma boa solução?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500202,
					"content": "Ainda pensando nisso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500203
					]
				},
				{
					"id": 200500203,
					"content": "Hum... Eu encontrei alguns outros aventureiros antes. Eles estavam no mesmo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500204,
					"content": "Eles lutam com os monstros como profissionais, mas quando se trata de quebrar algumas barras de madeira são um caso perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500205,
					"content": "E eles reforçam a madeira como se fosse para construir um abrigo contra tempestades ou algo assim ... Superestimando sua própria força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500206,
					"content": "Se eles querem um desafio tão desesperadamente, por que eles simplesmente não vão para a natureza e brigam com o maior monstro que eles conseguirem encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
