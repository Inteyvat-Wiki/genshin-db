					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Ah! Vou te inscrever no próximo Campeonato de Voo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Eu voo tão rápida que ninguém consegue me alcançar. Sou apenas eu lá em cima, planando sozinha... É um pouco chato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
