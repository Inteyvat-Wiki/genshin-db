					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Oh! É uma declaração tão ambiciosa. Hehehe... Parece que ainda não faz mínima ideia de quão difícil é o Campeonato de Voo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Bem, antes de eu derrotar você no campeonato, desejo um voo feliz, libertador e acima de tudo, dentro da lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Assegure-se de seguir as regras. Não importa o que você faça, não tenha sua licença apreendida.",
