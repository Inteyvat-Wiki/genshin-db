			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "Parece que não há caminho à frente... Ele deve estar em algum lugar ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, ali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Se você insiste em me perseguir, então não posso fazer nada. Quem trouxe essa garotinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850304,
					"content": "Você! Você deve ser o Raptor! Agora não há escapatória!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Haha, eu não preciso fugir! Não há como você chegar até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850306,
					"content": "Oh... Isso é muito alto... E longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Garotinha, por que você não volta para casa e chama o seu líder? Não se preocupe, talvez assim eu me renda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850308,
					"content": "Me escute bem! Você está falando com a exploradora dos Cavaleiros de Favonius! Você se arrependerá quando eu prender você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Respire fundo, Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "... Você tem razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "Droga, ele está bem em frente de nós... Se nós pudéssemos voar até lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Então, como que ele conseguiu chegar lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Com algum tipo de mecanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "Olha que eu tenho uma boa visão, e não consigo ver nenhum mecanismo",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Além disso, não há nenhum lugar no penhasco onde possa ser construído um mecanismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Até mais, garota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850323,
					"content": "Ah, não, fugiu de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "Não podemos mais hesitar. A única maneira de atravessar é voando até lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Não se preocupe, eu sou a Campeã de Voo de Mondstadt, lembra? Se o Raptor consegue, eu também consigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "Ei, Aventureira! Você tem menos chance de sobreviver do que se você pulasse da Estátua do Arconte Anemo da Cidade de Mondstadt sem o seu planador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850328,
					"content": "Eu estou com a Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Entendo o seu ponto, {NICKNAME}... Se você descartar tudo que for impossível, voar seria a última opção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, lembra do livro que eu lhe emprestei? Que eu pensava ser o suposto Guia de Planagem, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "\"Os primeiros pássaros não conseguiram voar. A fuga foi a recompensa por terem a coragem de mergulhar no cânion\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Observe e aprenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Vamos, força!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Entendido! Vamos mostrar a este cara o que é uma verdadeira Aventureira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Espere... Pare! Você nunca vai conseguir! Vamos lá, desista, volte para casa e seja uma boa garota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850337,
					"content": "O Raptor, é isso que está pensando? Mas ouça com atenção, o barulho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "O vento disse vou conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Isso requer coragem, mas não é completamente impossível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Um tipo de magia elemental?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, você consegue ver algo com a sua Visão Elemental? Não? Então esquece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "Usou um gancho, grampo, ou algo assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "É muito longe para voar, definitivamente longe demais para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "Não há um único sinal de um ponto do Arconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Vamos examinar ao redor - assim como você me ensinou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Certo! Consegui pegá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Só reparei na corrente de vento quando estava no ar, e era a única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Seria um suicídio tentar fugir na direção que o Raptor estava indo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "Em outras palavras, a única forma que o Raptor poderia ter saído seria essa, passando por cima de nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "A-há! Então ele estava apenas tentando nos enganar com a esperança de que fôssemos desistir e ir embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "#Mas nós também não somos fáceis de ser enganad{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#Isso tudo foi graças ao pensamento aguçado d{M#o}{F#a} {NICKNAME}! Assim como um sábio disse uma vez: \"Uma vez eliminado o impossível, o que quer que reste, por mais improvável que seja, deve ser a verdade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Em resumo, a arte de voar está dividida em 7% de técnica, 3% de instinto e 90% de coragem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Para mim parece ser 99% de coragem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Ah, foi assim comigo na minha primeira prova de voo... Eu estava super nervosa, mas no final, não tinha nada o que temer e eu passei sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "Eu meio que senti saudades dessa ansiedade nos exames que fiz desde então... Simplesmente não foi a mesma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "Er, espere um pouco, eu pensei que você disse que passou sem problemas? O que você quer dizer com as provas desde então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Ah... Veja bem, a questão é que Mondstadt é uma cidade cheia de não se pode voar aqui, e não se pode pousar ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "Toda vez minha licença é apreendida, eu tive que fazer a prova umas 15 vezes no total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Mas eu sempre passei de primeira, acho que o meu pequeno Manual do Planador não é tão ruim assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#...{NICKNAME}, vamos pegar uma cópia verdadeira do Guia de Planagem com a Grande Mestre Intendente Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "Vou partir primeiro porque preciso escoltar o Raptor de volta à cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
