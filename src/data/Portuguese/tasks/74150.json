			},
			"dialogs": [
				{
					"id": 741500301,
					"content": "Vocês terminaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500302,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Sim, a limpeza está feita e Moli também já alimentou a gata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Além disso, Benoit, tem uma pilha de caixas super sujas perto da sua casa. Você quer que a gente limpe elas também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Ah, aquelas caixas? Eu só guardo umas velharias nelas... Fora isso, não servem de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500306,
					"content": "Algumas delas contêm mobília e outros itens menores da minha casa anterior, que eu não tive coragem de jogar fora... Mas, ao mesmo tempo, eles não se encaixam na minha casa atual, então, acabaram lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500307,
					"content": "Eu praticamente não toco nelas, mas todos aqui são decentes e ninguém nunca roubou nada — então elas podem ficar bem onde estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500308,
					"content": "Sr. Leroy, Sr. Leroy, eu ajudei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500309,
					"content": "Ora, claro que sim, Moli. Não esqueça de dizer \"olá\" para seus pais por mim. Eu ficaria duas vezes mais grato se puder fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500310,
					"content": "E eu estou com os lanches e os trocados bem aqui, crianças, então venham pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500311,
					"content": "Ah, não, não, eu não preciso de nenhum trocado. Eu só queria fazer carinho em Nana de novo. Posso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500312,
					"content": "Oh, claro, por favor, mas cuidado com as garras e lembre de voltar para comer quando terminar de brincar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500313,
					"content": "Hã? Por que você saiu, pai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500314,
					"content": "Bem, esse velho se sentiu solitário, sem as crianças dele para fazer companhia a ele e tudo mais — então ele decidiu sair para tomar um ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500315,
					"content": "Ah, Morticia, olha só isso — saímos alguns dias e ele já está com raiva da gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500316,
					"content": "Mas tenho certeza que ele ia perdoar a gente se soubesse qual presente trouxemos dessa vez, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Presente? Bem, o que você trouxe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500319,
					"content": "Algo maravilhoso, claro. Você vai saber quando vir. Morticia sabe como você gosta de coisas caras e bonitas. Ela escolheu para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500320,
					"content": "Obrigado, minha filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500321,
					"content": "Eu só fiz o que deveria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "#Ah, sim. {M#Esses dois adoráveis convidados}{F#Essas duas adoráveis convidadas} também são crianças que vieram brincar quando vocês estavam fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500323,
					"content": "Olá. Meu pai é um homem amigável e ama mesmo crianças, então obrigado por fazer companhia a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500324,
					"content": "Mesmo assim, já que minha esposa e eu voltamos, podem deixar com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500325,
					"content": "Ah, é bom mesmo que vocês voltaram. Vamos, deixe-me dar uma olhada naquele presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500326,
					"content": "Certo, pai. Vamos para casa, tá bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "#Claro, claro. Atos, lembre-se de dar a el{M#es}{F#as} os agradecimentos e uns lanches. El{M#es}{F#as} me ajudaram a varrer o lugar e alimentar Nana também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500328,
					"content": "Ah, e dê àquela jovem um pouco daqueles doces também, certo? Vou voltar para dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500329,
					"content": "Sr. Leroy, Nana me deixou alisar a barriga dela... Hã? Aonde ele foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500330,
					"content": "Você está procurando meu pai, mocinha? Sou o genro dele... Bem, só filho dele serve, para facilitar as coisas. Me chame de Atos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500331,
					"content": "Ah, eu sei o que um genro é. Isso significa que você é o marido da filha dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500332,
					"content": "Haha, você sabe muito mesmo, né? Obrigado por fazer companhia ao meu pai — ele foi para dentro de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500333,
					"content": "Esses lanches são para você. Você pode deixar o resto para mim e minha esposa — está tudo bem se você não vier mais aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500334,
					"content": "Enfim, você devia ir logo para casa. Sua família ficará preocupada se você ficar fora muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500335,
					"content": "Oh, não se preocupe, moço. Não foi problema nenhum, e enfim, Sr. Leroy e eu fizemos um acordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500336,
					"content": "Acho que ele pode precisar da minha ajuda daqui pra frente, mesmo — sabe, alimentando os gatos, aguando as árvores e tudo mais. Ajudar as pessoas também me deixa feliz, então vou voltar com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500338,
					"content": "Tsc. Isso dificulta as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500339,
					"content": "Hã? Algo errado, moço?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500340,
					"content": "Não, mocinha, não. Eu tenho algo importante para conversar com você... Hmm, não. Isso não é uma discussão. Preciso que faça uma coisa por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500341,
					"content": "Claro. O que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500342,
					"content": "Então, eu vou te dar esses lanches e esses trocados, então não volte de novo, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500343,
					"content": "Hã? Por quê? Eu fiz algo errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500344,
					"content": "Nem um pouco. É só que a saúde do meu pai está frágil e a insônia dele piorou recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500345,
					"content": "Minha esposa e eu gostaríamos que ele tivesse um ambiente adequado para descansar, pelo bem dele. Você entende, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500346,
					"content": "Oh, então o Sr. Leroy não está bem... entendo. Da próxima vez, vou trazer uma Fruta Bulle para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500347,
					"content": "Papai me ensinou que toda vez que eu como bolo demais e tenho dor de barriga, eu tenho que comer menos doces e mais frutas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500348,
					"content": "Contanto que o Sr. Leroy coma um pouco de fruta todo dia, ele vai ficar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500349,
					"content": "...*Suspiro* Certo. Acho que não tenho outra escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500350,
					"content": "Quanto a vocês, aqui estão seus lanches e recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500351,
					"content": "Agora, deixe-me ser franco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500352,
					"content": "Falo por toda a família Leroy, então espero que vocês não venham nos incomodar no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500353,
					"content": "Acredito que vocês vão entender o que quero dizer apesar de sua juventude, então, por favor, não se esforcem muito para voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500354,
					"content": "Só isso. Sairei agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741500355,
					"content": "Hmm. Por que a gente não pode voltar? Que esquisito! O Sr. Leroy foi tão legal, mas esse moço não deixa a gente voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500356,
					"content": "É! Esse cara até fala com educação, mas ele é mais frio que Flor da Neblina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Bem, não me importo com o que ele tem a dizer. Vou vir ver o Sr. Leroy amanhã. E vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500358,
					"content": "Vamos lá, só venham também. Nana é tão fofa e quero fazer mais carinho nela... e também... o Sr. Leroy vai me dar uns lanches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500359,
					"content": "A gente vem com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "Beleza, nada de voltar atrás, falou? A gente tem que fazer carinho na gata e brincar com o Sr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500361,
					"content": "Se eu tiver tempo sobrando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "Tudo bem. Te vejo na próxima então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moli"
				}
			]
		},
