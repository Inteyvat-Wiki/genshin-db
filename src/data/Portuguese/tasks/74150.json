			},
			"dialogs": [
				{
					"id": 741500101,
					"content": "Obrigado, Moli. Sua bondade brilha em seus adoráveis olhos de lavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500102,
					"content": "Hehe, brilham? Você gostou mesmo daquela boneca que eu trouxe da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500103,
					"content": "Oh, sim, muito. Era muito fofa. Eu até dei um lugar na mesa de jantar para ela, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500104,
					"content": "Sério? Oh, isso vai deixar ela tão feliz! E hoje? Você precisa se apoiar em mim durante sua caminhada? Ou eu vou buscar o jornal para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500105,
					"content": "Eu também posso ler para você, se você não conseguir enxergar as palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500106,
					"content": "Mamãe diz que eu tenho que fazer uma boa ação todo dia e a Srta. Tutor quer que eu entregue uma redação essa semana que é sobre pessoas boas e coisas boas que aconteceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500107,
					"content": "Oh, hmm... Não estou dizendo que faço isso porque preciso escrever uma redação, mas se não se importa, eu queria mesmo te ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500108,
					"content": "Haha. Ah, tudo bem. A melhor coisa que você poderia fazer para me ajudar mesmo é dizer aos seus pais que você vem brincar na minha casa sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500109,
					"content": "Entendo, Sr. Leroy, e eu disse a eles, mas eles não pareciam tão contentes com isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500110,
					"content": "Você vai voltar, nesse caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500111,
					"content": "Vou sim — mesmo que eles não deixem. Digo, a gente tem um acordo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500112,
					"content": "Haha, você é mesmo uma criança de palavra. Ótimo, ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500113,
					"content": "#Ah, são vocês. Bem-vind{M#os}{F#as}, almas caridosas, bem-vind{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500114,
					"content": "Ahem, hmm, a gente não queria se intrometer ou nada assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Atrapalhamos alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "Não, não, vocês não estão interrompendo nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500117,
					"content": "Minha jovem amiga Moli aqui está atualmente pelo mundo, ocupada com seu dever de casa. Ela só passou aqui por acaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500118,
					"content": "Ela queria fazer algo legal para mim, para poder ter material para a redação dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500119,
					"content": "Ei, não tô ajudando porque quero terminar meu dever de casa! Bem, não só por isso, pelo menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500120,
					"content": "Claro, claro. Você é uma boa menina, no fim das contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500121,
					"content": "#Como {M#esses dois convidados}{F#essas duas convidadas}, você não é só de ajudar porque precisa de alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Hmm, bem... nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Ora, era só uma brincadeirinha. Claro que vocês não terão tanto rancor de um velhote?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500125,
					"content": "#Jovens têm muito tempo que podem gastar livremente e vocês estão dispost{M#os}{F#as} a passar um tempo comigo, e eu gosto mesmo da companhia de jovens... Por que não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500126,
					"content": "Ou talvez eu só deva dar alguma coisa para vocês fazerem. As pessoas passam por essa área, então a poeira tende a se acumular rapidamente. então, se eu puder pedir, por favor, me ajudem a limpar essa área novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500127,
					"content": "Bem... tá certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Moli, pode fazer companhia para minha gata? Ah, e leve um pedaço de peixe, por favor — o nome dela é Nana, por sinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500129,
					"content": "Ela herdou esse nome de uma cachorra que eu tinha antes... É uma pena, mas minha filha levou ela quando saiu para se casar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500130,
					"content": "Tudo bem, então, Sr. Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741500131,
					"content": "Tudo certo, crianças, podem ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
