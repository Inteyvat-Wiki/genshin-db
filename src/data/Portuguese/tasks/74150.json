						],
						"stepId": 7415001,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415005",
							"2"
						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500801,
					"content": "Ah, não há razão para bater a essa hora. Morticia e Atos não estão em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500802
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500802,
					"content": "Eles disseram que iam volta hoje, mas parece que eles se atrasaram por algum motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500803,
					"content": "Ah, esse é o problema com crianças crescidas. Eles sempre têm suas próprias coisas para fazer e geralmente não estão por perto quando você precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		}
	]
