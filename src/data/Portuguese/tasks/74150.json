			"dialogs": [
				{
					"id": 741490601,
					"content": "Entrega de jornal? Pode deixar na porta, obrigado. Eu pego mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490602,
					"content": "(Vocês ajudaram Benoit hoje. Seria rude incomodar o descanso dele. Vocês concordaram em se encontrar amanhã, então seria melhor fazer isso.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bater uma vez"
				}
			]
		},
