			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(Caixas velhas e decrépitas cobertas em camadas de poeira. Sua presença aqui em uma rua limpa e iluminada da Corte de Fontaine é muito destoante.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Caixa Estranha"
				},
				{
					"id": 741500702,
					"content": "(As bases dessas caixas sofreram manchas pela água ao longo dos anos. Elas devem ter sido empilhadas em um lugar extremamente úmido.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Caixa Estranha"
				},
				{
					"id": 741500703,
					"content": "(Esqueça as manchas na porta — essas caixas parecem precisar de uma limpeza muito mais urgentemente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caixa Estranha"
				}
			]
		},
		{
			"id": 7415008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415001",
