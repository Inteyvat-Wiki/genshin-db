						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "O sabor é... difícil de descrever, mas está aprovado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#O quê? {NICKNAME} consegue fazer melhor! Não valeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Você tem grande potencial. Tudo o que você precisa é de mais prática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "Eu tenho alguns ingredientes crus em minha mochila. Vou lhe dar em agradecimento à refeição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "Podemos realmente pegar? Não vai fazer falta para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Tudo bem. Você conseguirá encontrar muitos ingredientes ao <color=#00E1FFFF>explorar a natureza</color>. Não se esqueça de olhar com atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "Além disso, o <color=#00E1FFFF>Caçador de Cervos</color> também vende comida e ingredientes. Vá dar uma conferida quando você tiver tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Ok, obrigada pela informação. Ei! Deixe alguns Espetos de Frango com Cogumelos para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
