			"dialogs": [
				{
					"id": 711280201,
					"content": "\"Quando essa árvore ficar maior, cortarei suas folhas e lhes farei um chá\".",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "\"Quando essa hora chegar, convidaremos Retentora de Nuvem e Formatador de Montanha para virem também...\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "\"Sério? Você planta árvores do jeito que quiser em meu território, e tem até a audácia de falar algo assim?\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "... O dia em que as promessas do passado podiam ser cumpridas não chegou, mas a velha árvore silenciosa ainda lembrava o rosto dos que juraram...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "... Hoje, o aroma do chá permeia o Vale Chenyu há muito tempo, e foi levado para terras distantes...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
