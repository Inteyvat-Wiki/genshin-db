			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Talvez... Assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540302,
					"content": "Hmm, deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540304,
					"content": "Luas... Luas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540305,
					"content": "Que tal aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540306,
					"content": "Parece que eu venci esta rodada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540307,
					"content": "Minhas três luas estão conectadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540308,
					"content": "Mm, isso deve garantir a vitória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540309,
					"content": "Mm... As luas crescem e minguam em um ciclo sem fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540310,
					"content": "Parece que ambos os conjuntos de luas se recusam a ser eclipsados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540311,
					"content": "Será que estamos... caminhando para um empate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540312,
					"content": "Ah, vejo que você pesa bem suas decisões antes de tomá-las. Leve o tempo que precisar. Afinal, temos de sobra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540313,
					"content": "Esqueceu como posicionar suas luas no céu noturno? Quer que eu ajude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540314,
					"content": "Você não gosta deste jogo? Hm... Eu o acho bem divertido, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540315,
					"content": "Mm? Você está me encarando? Seu olhar não é nada sutil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540316,
					"content": "Está me encarando... Será que a verdade das luas está escrita no meu rosto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540317,
					"content": "O tabuleiro está ali, a propósito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540318,
					"content": "Hm, suas luas estão alinhadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540319,
					"content": "O céu noturno é seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540320,
					"content": "Ah... Acho que eu devo ter... cometido um deslize em algum momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540321,
					"content": "Você se divertiu muito jogando com a Columbina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "As três luas, conectadas em uma linha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210203,
					"content": "Hmm? Ainda pensando em como foi a última partida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Ah, não. É só que... olhar para o jogo agora me dá uma sensação peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210205,
					"content": "Ah, é. Agora que você tem o poder das três luas, tornou-se mais do que algo que pode dominar o céu noturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Sim. E também acho... que o destino do mundo talvez tivesse sido diferente se não tivesse havido divisão entre as três Deusas da Lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210207,
					"content": "Como elas eram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "A primeira que vi foi Sonnet, deusa da Lua Iridescente. Ela era mais animada do que eu imaginava, mais como uma irmã caçula brincalhona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210209,
					"content": "Aria da Lua Eterna era a mais madura das três. Era uma líder nata e a mais gentil com os outros. Ah, na verdade, bem parecida com a Lauma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210210,
					"content": "Quanto à Canon da Lua Gelada... ela parecia sábia e de grande visão. E foi ela quem me deu a lua dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210211,
					"content": "Parece que todas eram divindades bondosas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Sim. Apesar de suas diferenças, elas amavam Teyvat, e amam este lar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210213,
					"content": "Quando lhes falei sobre o que estava por vir, todas pareceram aliviadas, felizes por este mundo ainda guardar um futuro tão próspero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210214,
					"content": "Foi também por isso que me deram o poder de voltar para \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210215,
					"content": "Hã... A Paimon adoraria vê-las e agradecer de verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "Eu também gostaria muito disso. Mas receio que isso já não seja possível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210217,
					"content": "Felizmente, este mundo segue adiante, e os humanos que elas protegeram sobreviveram e continuam transmitindo suas histórias até hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210218,
					"content": "Exatamente! Enquanto vivermos bem e não deixarmos os vilões destruírem o mundo, esse é o melhor agradecimento que podemos dar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Você se garante mesmo com as palavras, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Nesse caso, todo dia é um dia de agradecimento para você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Claro! Pode apostar que a Paimon está sempre tentando viver da melhor forma possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Você também, Columbina! Coma bem e durma bem todos os dias, e venha nos procurar se quiser jogar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210224,
					"content": "Acho que, de agora em diante, vou me lembrar das três gentis deusas sempre que jogar Xadrez Lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
