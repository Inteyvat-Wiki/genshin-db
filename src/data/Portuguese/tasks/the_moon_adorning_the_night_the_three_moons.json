			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210102,
					"content": "Ei, Columbina! Você parece estar de bom humor hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Hah... Venha aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210104,
					"content": "Quer jogar Xadrez Lunar de novo ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Sim. Faz um tempo, e eu sinto certa falta de jogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210106,
					"content": "As regras são as mesmas de antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Ou você pode mover várias peças por turno agora porque é a Deusa Trilunar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Isso seria trapaça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761210109,
					"content": "Hehe, é, a Paimon sabe disso! Paimon estava só brincando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "Então vamos começar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
		{
