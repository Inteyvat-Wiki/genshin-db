				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "Obrigada, estes devem ser suficientes. Por favor espere um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "Isto deve bastar. Por favor, dê este Bolinho de Batata de Mondstadt para Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "E por favor, não... Faça tais coisas no futuro. Não vale a pena o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Por favor, escute meu conselho. Não decepcione o Timmie... Nem a mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "Bem, se ao menos todos ouvissem conselhos. Se fosse assim, a Irmã Victoria não estaria tão ocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2006805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
