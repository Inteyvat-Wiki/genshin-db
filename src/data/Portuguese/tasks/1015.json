			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Essas peças sobressalentes parecem ser úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Aguardem por favor, deixe-me tentar consertar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Pronto. A estrutura da Balista Guizhong é muito mais complicada do que eu imaginava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Uau, e agora, como faz para usar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "É muito fácil. Nós simplesmente precisamos fazer isso... Olhe, ele até tem uma luneta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Aqui... não tem nada... Tampouco ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "Ei, o que vocês estão discutindo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150607,
					"content": "Então, você consertou a balista... O que exatamente você está planejando fazer!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150608,
					"content": "Não é uma torreta, é a Balista Guizhong. Além disso, é falta de educação não se apresentar antes de fazer qualquer pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Não entendeu? Eu sou dos Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150610,
					"content": "Esta área deve estar repleta de tesouros escondidos, mas você não pode chegar nem perto deles com essa coisa vigiando. Pode parecer com qualquer outro dispositivo mecânico, mas confie em mim, isso tem uma mente própria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150611,
					"content": "Na última vez que fomos para lá, um de nós quase foi espetado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150612,
					"content": "Alguns de nós arriscamos nossas vidas para desarmá-la, e surpreendentemente, conseguimos. Então viramos nossas costas por dois segundos e vocês foram lá e consertaram ela!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150613,
					"content": "Acho que hoje, vou ter que dar umas boas lições para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Huang Sardento"
				},
				{
					"id": 10150614,
					"content": "Hum... como se atrevem a manchar a sabedoria dos Adepti apenas por interesse próprio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Vocês precisam ter uma lição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Certo! Se prepara para lutar, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Desculpe, não conseguimos cumprir a nossa parte do contrato. Não encontramos nenhum rastro da Cococabra, a besta semi-iluminada lendária, da qual você falou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Ah! Que pena. Mas não se preocupe com isso. Mesmo assim, me sinto muito desapontada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Ah, coitadinha... Por que a Paimon se sente tão culpada de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi, você tem mais pistas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Ah... Leite de Cococabra é saboroso. Muito gostoso. Mais saboroso do que leite de cabra normal. Só uma besta semi-iluminada lendária consegue fazer um leite tão gostoso assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Desculpe. Eu tenho uma memória fraca. Não consigo me lembrar do nome deste leite. Por isso que deixei escrito. Onde é que eu coloquei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ah Aqui. Esse é o nome... \"Leite de coco.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "Devo a vocês um pedido de desculpas. Apressadamente concordei com o que parecia ser um acordo justo com esta criança zumbi, quando talvez eu devesse ter feito mais investigações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Não se preocupe, Zhongli, você não sabia. Como diz o provérbio de Liyue: \"Todas as coisas são aleatórias, então, não é possível prever tudo\". Então, literalmente ninguém poderia saber que este seria o resultado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Hum... Qiqi disse alguma coisa de errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#Oh... Desculpa {NICKNAME}, a Paimon vai deixar o trabalho de despedaçar os sonhos desta pobre criança para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "Chegou a hora de te dizer de onde vem o leite de coco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "A Qiqi parece estar ponderando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Não vamos incomodá-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Haha, alguém aprendeu uma lição de vida significante hoje, né? Obrigado por terem cuidado da minha pequena Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Posso perguntar, quem é você...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Ah, desculpe, me esqueci de me apresentar. Sou o Baizhu, dono do Chalé de Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Então, a Qiqi não é a chefe... o chefe verdadeiro é essa pessoa meia estranha que está com as ervas de medicina suspensas no pescoço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Que pena, Qiqi é uma garota muito inocente, mas esse animal de estimação que eles carregam é ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "Ah! O ingrediente de medicina... a cobra... es... está falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Uau, uma cobra falante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Eu não estava planejando falar, para dizer a verdade. Os antigos clientes se acostumaram, mas os novos clientes ficam sempre um pouco... Surpresos. Mas se você tivesse ficado calado, provavelmente não saberia a diferença em relação às cobras secas nas gavetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Hahaha, não ligue para a Changsheng, ela é uma boa garota, sério. Quanto a vocês três... O que os traz aqui, à parte de criar todo esse caos com a Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Desculpe, cavaleiro, você vende Incenso Eterno em sua tenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Incenso eterno? Claro que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Ufa, finalmente! As coisas estão finalmente começando a se encaixar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Três milhões de Mora, melhor qualidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "Três milhões?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "Você deveria logo roubar a Casa Dourada! Oh, mas agora está ocupada pelos Qixing... Agora a segurança estará mais rigorosa do que normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Hmm... Três milhões... Um número inócuo por si só, embora praticamente falando, poderia ser uma soma difícil de ser conseguida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "É um número insano! Nunca conseguiríamos fazer tanta Mora, e quanto ao Senhor Zhongli... Faltam cerca de três milhões para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "Realmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Quanta sinceridade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "O que podemos fazer agora? Temos que recorrer ao Childe de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150745,
					"content": "Cococabra! Cococa- Ahahahoho, meus lados... Meu senhor, não consigo ACREDITAR que você caiu nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150746,
					"content": "Ei, não ria de nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Estou quase em lágrimas aqui... Ah, obrigado, essa foi a melhor risada que já tive em muito tempo. Em troca, estou mais do que feliz em resolver esta confusão em que vocês conseguiram se meter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150748,
					"content": "Desculpe, senhor... Dr. Baizhu, não é? Verdadeiramente honrado, eu sou Childe, um dos Mensageiros dos Fatui. Perdoe meu atrevimento, mas vejo muitas oportunidades para colaborarmos no futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150749,
					"content": "Se o Chalé de Bubu precisar de um suprimento estável de leite de coco, os Fatui podem ajudar a estabelecer uma rede de distribuição reforçada e rápida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150750,
					"content": "Estranho... Eu sabia que os Fatui se infiltraram nos negócios dos outros com negócios sedutores, mas... Tanto alvoroço por causa de leite de coco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Leite de coco! Leite de coco! Baizhu. Rápido. Qiqi quer leite de coco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Ah... Sim, claro, Qiqi, o que você quiser... Obrigado, Childe. Espero uma colaboração de sucesso no futuro. Posso lhe dar um desconto nesse Incenso Eterno também, digamos... 2.990.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Será que realmente faz diferença entre esses dois valores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Hmm... 2.990.000... Também é um número inócuo por si só, embora praticamente falando, seja dez mil a menos do que a quantia original de três milhões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Bom, como já resolvemos tudo, devemos voltar ao Terraço de Yujing. Childe, Dr. Baizhu, e pequena Qiqi, até mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "São pessoas muito interessantes! Já faz muito tempo que não ri tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150757,
					"content": "Então, como você já estava escutando clandestinamente, ouviu alguma coisa importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150758,
					"content": "Sim! O senhor Childe, mencionou que... a Casa Dourada está ocupada pela Qixing para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Ora, ora, ora, ora. Ningguang e seus comparsas, os Qixing. O que mais estaria escondido na Casa Dourada... Se não a Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150760,
					"content": "#Peço desculpa, {NICKNAME}. Mas eu te avisei, não é? Como diz o provérbio de Liyue: \"as paredes têm ouvidos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10150737,
					"content": "É melhor ir roubar a Casa Dourada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Mas agora está ocupada pela Qixing... Agora os guardiões serão mais rigorosos que normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Nada em Liyue me surpreende mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Algum dia terão que crescer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Todos os leites de coco são dos coqueiros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "Mas para que você precisa dessa tal Cococabra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "Oh, aí está você! Mas você é tão baixinha que não consegue nem chegar ao balcão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "Ela é... uma zumbi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "É verdade! E tem uma espécie de talismã na frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Bem-vindos ao Chalé de Bubu, eu sou Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Uma vez, a Qiqi morreu. Mas logo depois foi salva por um Adeptus. Então, a Qiqi é zumbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Disse como se fosse a coisa mais normal do mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Isso seria impensável em Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Oi, menina... Você vende Incenso Eterno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Com licença, senhor... Você trouxe sua receita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Eu... Certamente nenhuma receita é necessária para comprar o Incenso Eterno, né? Não é uma substância controlada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Qiqi pode pegar seu remédio. Mas somente se você mostrar a Qiqi sua receita médica. Estas são as ordens que Qiqi, deu a Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "\"Ordens\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Os zumbis estão limitados a agir dentro dos limites de suas ordens. E, de alguma forma, neste caso, a zumbi dá suas próprias ordens, a ela mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Minha querida Qiqi, temo que não tenhamos trazido uma receita. Mas esperamos que você ainda possa nos ajudar a encontrar algum Incenso Eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "Pode ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "Hum? Por que funcionou de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Mas em troca, você terá que ajudar Qiqi. Justo, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Os vendedores ajudam os clientes, e isso é algo injusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Não importa, basta pensar nisso como uma transação de igual para igual. Assim, todos ganhamos. Às vezes, em Liyue, a arte do negócio é simplesmente ganhar pela enrolação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Vá ao Monte Tianheng. Encontre a Balista Guizhong. E cace uma Cococabra. Por favor e obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Eu não entendi muito bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "A Balista Guizhong... Já ouvi falar sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "A Balista Guizhong é uma torre de balestra instalada no Monte Tianheng por um Adeptus em um passado distante. Um dispositivo mecânico primitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Localizada na Passagem de Tianheng, foi projetada para disparar automaticamente contra grandes monstros, protegendo Liyue de ameaças externas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "O Sr. Zhongli conhece Liyue na palma da sua mão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Aparentemente, não é bem assim... Esta é a primeira vez que ouço falar de uma \"Cococabra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "A Cococabra é uma besta semi-iluminada lendária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "Hum? Isso é tudo?",
