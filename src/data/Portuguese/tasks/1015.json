					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "Mas que diabos é uma \"Cococabra\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "E agora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Ela está brincando com a gente...",
