					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "Não surpreende que é uma terra dos Arcontes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
