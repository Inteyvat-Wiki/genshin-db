						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Não me diga que se lembra de mais alguma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Deixa para lá... Vamos começar por investigar perto da <color=#00E1FFFF>Balista Guizhong</color>. Talvez lá tenha algumas pistas.",
