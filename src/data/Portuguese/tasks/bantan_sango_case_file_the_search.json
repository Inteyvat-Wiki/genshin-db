			"dialogs": [
				{
					"id": 220340203,
					"content": "Essas pessoas realmente fogem rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340204,
					"content": "Eles provavelmente voltaram para falar sobre nós. Neste caso, nosso objetivo foi alcançado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340205,
					"content": "Obrigado pelo seu trabalho árduo, Viajante. Por favor, pegue isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340206,
					"content": "Também retornarei e relatarei isso a Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340207,
					"content": "Eu me pergunto se ela já descobriu alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
