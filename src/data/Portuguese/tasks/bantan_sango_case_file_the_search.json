				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "Olá, Viajante! A diretora está precisando da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340102,
					"content": "Houve algum progresso com o caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Ela não me contou, apenas disse que ainda precisava fazer alguns preparativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340104,
					"content": "Ela me disse para esperar por você para que pudéssemos ir juntos ao campo para investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340105,
					"content": "O que ela quer fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Sinceramente, eu também não sei, mas se seguirmos suas instruções, provavelmente seremos capazes de resolver o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340112,
					"content": "Bem, vamos voltar ao que interessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340113,
					"content": "De acordo com Sango, a patrulha na cidade realmente foi reforçada desde que Amano e Andou relataram o incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340114,
					"content": "Mas, estranhamente, os comerciantes da cidade ainda estão sendo roubados. E a intenção dos criminosos é muito clara. Eles não estão interessados em nada além de alguns itens alvos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340115,
					"content": "A situação é esta: Sango acredita que a probabilidade de os Ladrões de Tesouro entrarem na cidade para realizar esses crimes é muito baixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340116,
					"content": "O suspeito... Ou suspeitos têm um objetivo muito claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340117,
					"content": "É muito provável que haja um espião dentro da cidade esse tempo todo, passando informações para pessoas que estão fora dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340118,
					"content": "Isso não significa que as ações dos Doushins foram em vão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "De jeito nenhum. É exatamente o que queremos. Como o criminoso parece ter percebido que ele ainda não é o alvo dos Doushins, ele continua cometendo crimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340120,
					"content": "Quanto mais crimes ele cometer, mais fácil será para ele se entregar e maior será a chance de Sango descobrir quem realmente é ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340121,
					"content": "Portanto, ainda precisamos manter as aparências para que o ladrão baixe sua guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340122,
					"content": "Viajante, é por isso que estou aqui pedindo que você venha comigo e procure alguns problemas com aqueles Ladrões de Tesouro na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340123,
					"content": "Claro, vou te pagar bem. Além disso... Quando este caso terminar, lhe darei uma recompensa adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340124,
					"content": "Também foi a Sango que te pediu para dizer isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "Hmm... Você sentiu isso? Você tem uma intuição bastante sensível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340126,
					"content": "#De fato, foi Sango quem me disse para persuadi-l{M#o}{F#a} com essas palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340127,
					"content": "Mas, por favor, acredite em mim quando digo que não estou mentindo. Na verdade, tenho seu pagamento aqui comigo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340128,
					"content": "Portanto, por favor, ajude-nos, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340129,
					"content": "Mas o que eu preciso fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "É fácil. Nós só precisamos... Causar alguns problemas àqueles Ladrões de Tesouro na natureza. Quanto maior a briga, melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340131,
					"content": "Sango já marcou os locais de alguns acampamentos dos Ladrões de Tesouro. Eu também os marquei no mapa para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340132,
					"content": "Bem, nos encontraremos nesse local depois, vamos logo então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340107,
					"content": "Por que ela não veio sozinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "É um hábito dela. Ela mesma disse que... \"Sou boa em pensar, mas não em fazer\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340109,
					"content": "Antes um romancista veio entrevistá-la, querendo escrever um romance com base na sua história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340110,
					"content": "Ele até se referiu a Sango como uma \"detetive de poltrona\". Ela parece ter gostado desse apelido e, desde então, está pensando em comprar uma poltrona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340111,
					"content": "Mas, por causa de problemas de financiamento, ainda não chegamos a comprar uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
