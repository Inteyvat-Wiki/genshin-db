	"talks": [
		{
			"id": 2203401,
			"completionStepIds": [
				2203401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203401",
							"2"
						],
						"stepId": 2203401,
