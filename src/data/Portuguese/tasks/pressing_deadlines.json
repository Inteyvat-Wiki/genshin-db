			"dialogs": [
				{
					"id": 710201001,
					"content": "Ai ai, estou com um problemão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201002
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 710201002,
					"content": "Escriturária Zhao pediu que lhe entregasse isto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710201003
					]
				},
				{
					"id": 710201003,
					"content": "Hã? Ela precisa de uma lista de todos os barcos no porto!?",
