						710201004
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 710201004,
					"content": "Isso... Eu na verdade tinha começado a anotar isso desde o começo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201005
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 710201005,
					"content": "Mas então também tem o relatório de mercadorias importadas, o relatório sobre as informações da tripulação e o relatório de entrada e saída de forasteiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201006
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 710201006,
					"content": "Simplesmente tem muuuita coisa para conseguir acompanhar - informe isto, registre aquilo, eu apenas não consigo acompanhar tudo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An Nervoso"
				}
			]
		},
