			"dialogs": [
				{
					"id": 706560101,
					"content": "Olá! Você veio desafiar esse Domínio daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560102,
					"content": "#Estou um pouco interessad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "Então deixe-me apresentar oficialmente. Eu sou Plauen, responsável por vigiar a entrada deste Domínio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560105,
					"content": "De acordo com os registros da Guilda de Aventureiros, esse Domínio parece surgir apenas por um período de tempo específico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560106,
					"content": "Agora estamos no Festival da Brisa Florescente. Fizemos umas alterações no interior, deixando o desafio muito especial e aberto para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560107,
					"content": "Não é perigoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "Não tem problema. Isso é um evento especial para celebrar o Festival. Se alguém que não tem experiência com aventuras participar, terá um Aventureiro veterano o acompanhando sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560109,
					"content": "#Vocês são {F#aventureiras}{M#aventureiros} experientes, não devem precisar de ajuda nenhuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560110,
					"content": "#Você pode explorar o domínio sozinh{M#o}{F#a} ou convidar seus amigos. Mas de qualquer forma, conclua o domínio para obter recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560111,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Não vou mais tomar do seu tempo. Espero que se divirtam aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560112,
					"content": "Se tem recompensas, vou tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Parece ser um domínio bem peculiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
}