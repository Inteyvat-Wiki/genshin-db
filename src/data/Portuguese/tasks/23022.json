			"dialogs": [
				{
					"id": 230220101,
					"content": "Se aumentarmos a resistência aqui, teremos que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Se você for com esse design, não será muito diferente do anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Você ainda está trabalhando no design do navio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "Ah! Viajante, aí está você. Sim, após o último teste, Qishan e eu discutimos alguns... hmm... Pontos-chave do design do navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Após nós... conversarmos o bastante, estamos tentando elaborar um novo design.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Ainda tivemos um pouco de divergência em relação ao uso de materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Mas dessa vez eu ouvi o conselho de Qishan e investi muito dinheiro para comprar um monte de materiais bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "Viajante, como pode ver, eu não poderia mover tudo isso sozinho. Qishan também não é forte o suficiente. Você poderia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Faremos isso juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Obrigado, sei que posso contar com você. Vamos nessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "A própria Qishan selecionou os materiais. Acho que dessa vez tudo vai funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "E eu tenho recompensas maiores para você desta vez. Obrigado pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Bem, vamos resolver isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
