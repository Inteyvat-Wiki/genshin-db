			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "*Cof* *Cof*... Espere, pare...! Quem é você? Por que você está aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "E por que está me atacando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "Nós é que temos que lhe perguntar! Por que você está vagando por aqui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "Você é uma pessoa má, fale primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "Eu sou Katarina... Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "O nome é a informação que menos merece ser protegida, só posso lhe revelar isso, me desculpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Hã... Nós só queríamos saber sobre a situação, não queremos fazer um interrogatório!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "Me desculpe, mas essa é toda informação que posso revelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "O que os Fatui estão fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "Segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "O quê?! Pessoas más sempre são suspeitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Haha, sim, nós somos maus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "#Bem, o tempo {F#das garotinhas}{M#dos garotinhos} curios{F#as}{M#os} acabou... Nós temos o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Obrigada... Eu estou muito feliz que você não aproveitou a chance para me esfaquear pelas minhas costas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Isso é algo que eu deveria dizer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Não sei que preconceito você possui com os Fatui, mas um lugar como esse não é nem um pouco romântico para se ter uma conversa... Se você tiver algo a dizer, venha até meu esconderijo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina partiu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "Hã? Ela é uma Fatuus! Nós vamos deixar ela ir embora assim? Não deveríamos entregá-la para os Millelith?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Hmm... Paimon entende, vamos deixar para lá. De qualquer forma, ela não nos feriu, por isso pode-se dizer que poupamos sua vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Os Fatui são assim suspeitos com todas as outras pessoas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "Oh, vocês vieram. Por favor, descansem um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Eu tenho um pouco de... Hã... Chá preto... Não, não tenho... Açúcar... Também não... Hmm, leite... Estragou... — Eu vou jogar fora depois, me desculpem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Mas tem Água de Fogo o suficiente, além de biscoito seco e geleia azeda — o suficiente para uma festinha do chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Eita...! Vocês realmente consideram que Água de Fogo é algo comum para festas do chá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Sim, é estranho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Uhh... Não parece ser uma boa ideia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "O quê? Hehe, ninguém vai te julgar por beber aqui. Apenas fique a vontade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "\"Compartilhar certas informações e comida pode silenciar a boca dos curiosos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "... É isso que nosso manual diz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Mas onde está a informação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Hã? Foi isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Hã? O que você disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "Anexo 4-4, artigo 32 do \"Manual de Treinamento da Equipe-Vanguarda Fatui\": \"Compartilhar certas informações e comida pode silenciar a boca dos curiosos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "Eu compartilhei com você o conteúdo secreto de nosso manual de treinamento como compensação por ter salvo minha vida! O que você acha dessa minha sinceridade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "E qual a utilidade de nos revelar isso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Haha, só estou brincando com vocês... Mas sendo franca, muito obrigada pela sua ajuda, não me entendam mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "*Suspiro* Tendo em vista todas as coisas ruins que vocês fizeram antes, é difícil acreditar que os Fatui possuem boas intenções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "O que você está tramando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Não me surpreende que os forasteiros não consigam entender a causa dos Fatui. Mas quando não estamos falando do que buscamos ou de que lado estamos, somos apenas um bando de pessoas comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "...Além disso, sejam quais forem os nossos propósitos, estamos apenas nos preparando para a batalha final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "Batalha final...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Sim. No fim, todos enfrentaremos um inimigo em comum e as inescapáveis longas noites... Todos em Snezhnaya foram avisados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Então, pelo bem deste mundo cruel, todas as gotas de lágrimas e sangue da humanidade... não serão derramadas em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Vamos brindar! Não? Hunf, como quiser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "É assim que você justifica o mal que você fez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Talvez você tenha razão... eu não sei, nem me importo em saber. Você quis uma explicação, eu te dei uma. Mas você pode não ter gostado. Só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Urg... Paimon não está acostumada a ter que pensar em coisas tão sérias e profundas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580535,
					"content": "A propósito, eu me apresentei, porém, ainda não sei o seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "Sou Paimon! Você deve ter ouvido falar deste nome também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580539,
					"content": "Oh! Seu nome...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580540,
					"content": "Hunf! Que tal? Deve ser muito bem conhecido por todo Teyvat, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580541,
					"content": "Me desculpe, nunca ouvi falar de vocês. Nem uma vez sequer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580542,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580543,
					"content": "Por favor, não leve para o lado pessoal — fui enviada para cá há muito tempo. Eu mal sei o que tem acontecido na superfície além do que é dito pelas notícias da linha de fornecimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580544,
					"content": "Hã... Isso não quer dizer que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580545,
					"content": "Que a linha de suprimentos de vocês já deixou de funcionar há muito tempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580546
					]
				},
				{
					"id": 710580546,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580547
					],
					"speakerTitle": "Katarina"
				},
				{
