			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cidadão Triste"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "Será que ainda há alguma chance...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "Cidadão Triste"
				},
				{
					"id": 700010502,
					"content": "Hum? O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "Cidadão Triste"
				},
				{
					"id": 700010503,
					"content": "As Flores do Vento sobem ao céu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "Sim, o que você está me falando é para eu desfrutar do Festival da Brisa Florescente, independentemente do que aconteça, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "Cidadão Triste"
				},
				{
					"id": 700010505,
					"content": "Você tem razão. Não posso ficar desanimado só porque me rejeitaram. O Festival ainda não terminou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "Cidadão Triste"
				},
				{
					"id": 700010506,
					"content": "Obrigado pelo seu encorajamento. Eu vou ficar mais animado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "Cidadão Triste"
				},
				{
					"id": 700010507,
					"content": "Acho que você nos entendeu mal. Mas alguém assim não deveria levantar suspeitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000111",
							"2"
						],
						"stepId": 7000111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010601,
					"content": "Como está o assunto dos Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010602,
					"content": "Já foi tudo resolvido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "#Hum! Não é à toa que você é {F#a Cavaleira}{M#o Cavaleiro} Honorável! Você fez um bom trabalho, e falou com os Ladrões de Tesouro de uma maneira muito hábil! Você realmente merece o reconhecimento \"daquele cavalheiro\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 700010604,
					"content": "Você ficou esse tempo todo vendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010605
					]
				},
				{
					"id": 700010605,
