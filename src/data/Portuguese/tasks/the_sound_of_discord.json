				"objectNames": [
					"Cidadão Suspeito"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "Que animação, isso é ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "Cidadão Suspeito"
				},
				{
					"id": 700010302,
					"content": "As Flores do Vento sobem ao céu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "Oh? E... E as pessoas no chão olham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "Cidadão Suspeito"
				},
				{
					"id": 700010304,
					"content": "Ah, colegas, vocês chegaram na hora certa. Estive olhando um casal descuidado, que tal irmos ganhar um pouco de Mora agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "Cidadão Suspeito"
				},
				{
					"id": 700010305,
					"content": "Você chama a atenção deles, enquanto isso, eu vou agir. Assim que conseguirmos, vamos até à Origem do Vento para encontrar outros colegas. Ugh... Não sei como está a situação deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "Cidadão Suspeito"
				},
				{
					"id": 700010306,
					"content": "Mas antes disso, ande comigo um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "Uh? Espere um pouco, você não é dos Ladrões de Tesouro. Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "Cidadão Suspeito"
				},
				{
					"id": 700010308,
					"content": "Sou dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "Ele já foi levado pelos Cavaleiros de Favonius. Mas como que eles chegaram tão rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010310,
					"content": "Ugh... Deixa para lá! Ele acabou de dizer que iria à Origem do Vento para encontrar os seus companheiros... Que tal darmos uma olhada lá também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
