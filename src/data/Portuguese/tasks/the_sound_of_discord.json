			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "Hmm? Você gostaria de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "Cidadão Inquieto"
				},
				{
					"id": 700010402,
					"content": "As Flores do Vento sobem ao céu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "Flores do Vento? Que flores do Vento? Você está falando dos Dandelions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "Cidadão Inquieto"
				},
				{
					"id": 700010404,
					"content": "O que tem demais nele? É muito comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "Cidadão Inquieto"
				},
				{
					"id": 700010405,
					"content": "Desculpe pelo incômodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700010406,
					"content": "Parece ser só uma pessoa comum da cidade. Vamos perguntar a alguma outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
