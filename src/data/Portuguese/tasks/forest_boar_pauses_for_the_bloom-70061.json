			"dialogs": [
				{
					"id": 700610701,
					"content": "Ah, você voltou? Como foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "Nós o enxotamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Ah, muito obrigada mesmo. Aqui, isto é para recompensar seu esforço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Afinal, trabalho merece pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Agora finalmente vou conseguir botar o campo de flores em ordem. Vamos só torcer para não aparecerem mais visitantes \"desumanos\" por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
