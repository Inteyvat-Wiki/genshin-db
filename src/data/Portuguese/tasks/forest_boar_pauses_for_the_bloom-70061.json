				]
			},
			"dialogs": [
				{
					"id": 700610101,
					"content": "*Suspiro* De novo não... Por que isso continua acontecendo? O campo está uma bagunça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "Nesse ritmo, eu não vou conseguir entregar as flores a tempo. O que eu vou dizer para os meus clientes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Olha só isso. O campo inteiro está destruído... Essas flores estavam vindo lindas, e agora estão arruinadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "Tudo por causa daquela praga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "Isso é desumano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Eu sei, né? ...Bom. Na verdade, nem é humano mesmo. É um Javali do Bosque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "Por algum motivo, ultimamente ele vive descendo aqui, beliscando as flores e depois se esparramando no meio do campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "E ele é escorregadio. No instante em que alguém ouve e vai ver o que é, ele sai disparado. Agora mesmo, quase atropelou um senhor de idade que estava passando por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "Isso é um absurdo. Nem... nem é um javali direito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "#Ah... espera... pera aí. Você não é {M#o}{F#a} Cavaleir{F#a}{M#o} Honorável? {M#O herói}{F#A heroína} que salvou Mondstadt? Então, por favor, eu realmente preciso da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Certo. Vou espantá-lo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "Que alívio... Acho que ele foi em direção ao vale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "É uma criaturinha esperta. Talvez você tenha que atraí-lo com flores... mas, bem, você pode ver o que sobrou das minhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "Talvez pegue algumas Flores do Sopro de Vento pelo caminho e use-as como isca. Bem feito, para aprender a ser enganado pelo menos uma vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
