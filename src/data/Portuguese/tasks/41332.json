				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "Quantos mais há...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320202,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "Haha, com o que mais eu poderia estar ocupado? Claro que com o Restaurante Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320204,
					"content": "Recentemente, muitas pessoas vieram ao Restaurante para comer por causa do Ritual de Lanternas. E ainda há muitos turistas vindos de fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320205,
					"content": "Apesar da minha filha Xiangling ter retornado para ajudar, ela também está muito ocupada entregando comida..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320206,
					"content": "As pessoas penduraram em suas casas Lanternas Celestes. Mas, aqui no Restaurante Wanmin, estive tão ocupado que não tive tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320207,
					"content": "Viajante, se você quiser, poderia me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320208,
					"content": "Você conhece Atsuko? Aquela moça das docas que veio de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320209,
					"content": "Ela fez um pedido aqui. Por favor, entregue a ela. Devido ao feriado, eu fiz uma porção enorme para ela de propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320210,
					"content": "E também tem os <color=#00E1FFFF>Wang, a Chave Inglesa, Hammer Li, Guanhai e Zhihua</color> que sempre estão ocupados nas docas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320211,
					"content": "Eles sempre foram bons clientes de nosso restaurante. Mas mesmo neste feriado, eles estão nas docas, devem estar trabalhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320212,
					"content": "Também quero dar para eles algo bem gostoso do festival. Mas ultimamente estou muito ocupado no Restaurante, não tenho tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320213,
					"content": "Viajante, você pode me ajudar a perguntar a eles o que querem comer? Vou preparar algo bem gostoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413320214,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "Muito obrigado. Assim que você perguntar, volte para me dizer o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
