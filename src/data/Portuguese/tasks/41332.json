			"dialogs": [
				{
					"id": 413320301,
					"content": "Como que a comida do Restaurante Wanmin ainda não chegou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320302,
					"content": "Sua comida chegou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "Ah! Obrigada. Eu acreditava que teria que esperar mais para que ela chegasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320304,
					"content": "A atmosfera de Liyue durante o Ritual de Lanternas me deixa com saudades de casa, mas não posso retornar à Inazuma por enquanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 413320305,
					"content": "Não sei como a situação de Inazuma está agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atsuko"
				}
			]
		},
