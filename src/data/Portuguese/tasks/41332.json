				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "Você entregou a comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321402,
					"content": "Entreguei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "Ótimo. Você ajudou bastante. Também perguntou quais as comidas que Wang, a Chave Inglesa, Guanhai e Zhihua querem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321404,
					"content": "Wang, a Chave Inglesa e Hammer Li querem Sopa de Bambu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "Oh? Estes dois têm gostos bastante semelhantes, embora a Sopa de Bambu demore algum tempo para fazer. Terei que começar a prepará-la cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321407,
					"content": "Guanhai quer comer Peixe Esquilo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "Sem problemas, prepararei esse prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321409,
					"content": "Zhihua quer comer Bolinho de Flor Lótus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "Não imaginava que Zhihua gostasse de um prato como esse. Não é difícil fazê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321411,
					"content": "Obrigado pela sua ajuda. Por favor, fique com isso. Agora eu tenho que preparar esses pratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321412,
					"content": "Você não pendurou Lanternas Celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321413
					]
				},
				{
					"id": 413321413,
					"content": "Ei! Não tenho tempo, estou cozinhando, Xiangling veio pegar pratos novos para entregar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321414
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321414,
					"content": "Nós dois sempre estamos ocupados, não temos tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321415,
						413321416
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 413321415,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321417
					]
				},
				{
					"id": 413321417,
					"content": "Você quer nos ajudar? Muito obrigado. Eu estava me preocupando que não havia nenhuma Lanterna Celeste no Restaurante, e sem ela, não há sensação de um feriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
