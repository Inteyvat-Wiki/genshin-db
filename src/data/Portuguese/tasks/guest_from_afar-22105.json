			"dialogs": [
				{
					"id": 221050101,
					"content": "Que estressante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Tem algo de estranho ao redor dessa pousada, mas não consigo explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Sem mencionar que todos os nossos hóspedes pareçam ser pessoas muito sensitivas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "Se houver a menor interferência acabamos com janelas e portas quebradas, às vezes também com tábuas quebradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Os hóspedes estão dispostos a pagar pelas peças, mas as peças estão por toda parte, é horrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Você poderia dar uma olhada do lado de fora do Albergue? Se você encontrar algo de esquisito, descubra o que é! Eu ainda preciso cuidar dos fregueses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Conto contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "Qual é o problema dessas pessoas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "Os clientes? Ah, não se preocupe, eles estão acostumados a estarem em modo de sobrevivência na natureza. Você não pode culpá-los por sempre estarem em alerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Por favor, só dá uma olhada lá fora, não deve acontecer nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
