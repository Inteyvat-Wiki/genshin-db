	"talks": [
		{
			"id": 2401504,
			"completionStepIds": [
				2401504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401504",
							"2"
						],
						"stepId": 2401504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "Não, não... se a gente remover as luzes e sombras aqui, o que isso vai fazer com as camadas na pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150402,
					"content": "O poder da expressão nessas cores é insuficiente... e o contraste não é tão bom assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150403,
					"content": "Ugh! Só alguns elementos removidos e tudo virou uma bagunça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150404,
					"content": "O que você pretende?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "Ah, é você. É bom te ver de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150407,
					"content": "Peço perdão pelo mal-entendido — eu estava meramente pensando sobre os problemas com essa pintura e não pude deixar de andar de um lado para o outro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150408,
					"content": "Você pode não conseguir entender, mas eu simplesmente não consigo ficar quieto ao refletir sobre problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150409,
					"content": "Quanto mais tempo eu fico em um lugar considerando problemas, mais frustrado eu fico. Por isso estou acostumado a pensar enquanto caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150410,
					"content": "Eu permito que minhas pernas me carreguem a qualquer lugar contanto que eu pense, contanto que elas não me deixem parado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150411,
					"content": "Então... Isso acontece frequentemente. Perdão por preocupar vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150412,
					"content": "Então, você chegou a uma conclusão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Sem progresso, eu receio... Eu só não sei onde começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150415,
					"content": "Se eu remover os efeitos de luzes, a imagem carece camadas, mas se eu reduzir o contorno e formas, os objetos dentro da pintura não podem sustentar sua estrutura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150416,
					"content": "A remoção de quaisquer poucos elementos farão o edifício inteiro desabar, o transformando em uma pilha de lixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150417,
					"content": "Eu só estou falando sozinho, por sinal, então não se preocupe tanto — eu só estou pensando em como resolver este problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150418,
					"content": "Eu devo voltar e procurar meu cavalete primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150413,
					"content": "E sobre a questão que você estava considerando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Eu quase pensei que estivesse em perigo ou algo assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "*Ofegando* Obrigado... Sério, obrigado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Sério, eu estava só pintando ali — mas antes que percebesse, eles tinham me cercado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Eles atacaram minha pintura tão vigorosamente, você pensaria que eles iriam querer comê-la ou algo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "Mas eu não podia deixar eles a levarem, claro, então eu peguei ela e saí correndo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Mas não cheguei longe antes que me alcançassem — graças aos Arcontes que vocês estavam lá para me resgatar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "Tem algo errado com essa pintura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Sabe-se lá os Arcontes! Eu sempre usei Néctar da Flor Gigante para fazer minhas pinturas — sabe, aquilo que vocês pegaram para mim antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "Espera... E se a pintura estava atraindo eles? Não, não pode ser — aquele néctar não tem cheiro nenhum depois que eu misturo na tinta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "Eu não me atrevo a mudar a fórmula da pintura na hora também. Acho que vamos ter que achar outra maneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "*Cof cof* E eu pensando que até as Flores Gigantes podiam sentir a beleza em minha pintura e queriam dar uma olhada nela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "O que você fez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}