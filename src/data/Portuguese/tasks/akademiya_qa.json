			"dialogs": [
				{
					"id": 230260301,
					"content": "Talvez você tenha encontrados muitos pesquisadores que se denominam Estudiosos Itinerantes \"Driyosh\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "Na verdade, há uma grande quantidade de \"Driyosh\" em um dos Darshans da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Esse Darshan tem como objeto teórico a Energia Elemental. Ele investiga tudo que está relacionado com Energia Elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Minha pergunta é, qual o nome desse Darshan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Isso mesmo, é o Darshan Spantamad, que concentra muitos membros do \"Grupo da Teoria Elemental\". Eles consideram os Sete Elementos como a essência de todos os objetos e da vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Hehe, resposta errada. Os pesquisadores do Darshan Haravatat estudam linguagens, semiótica e lógica... É bem complexo, acredite em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Rtawahist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Que pena, resposta errada. Rtawahist é a casa dos pesquisadores cujo objeto de estudo é o céu estrelado sobre nossas cabeças... Hehe, não parece interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
