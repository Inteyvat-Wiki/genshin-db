			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Será que essas perguntas são muito difíceis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "Viajante! Espere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "Você me chamou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Sim! Hehehe, eu gostaria de te pedir um pequeno favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Você perdeu alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "#Hã? Como você soa tão familiarizad{M#o}{F#a} com isso? Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Não é isso, eu não perdi nada, e também tenho muitos materiais de pesquisa. Quanto a inspiração... Na verdade eu já tenho de sobra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Hehe, na verdade eu estou compilando um folheto de perguntas e respostas para ajudar alguns estudantes novos a entender cada termo que está em uso em Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "Basicamente, ele é estruturado no formato de um quiz para explicar todo tipo de nome complexo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "Assim, o estudo é proveitoso, e o processo de aprendizado não é tão tedioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Mas, eu ainda não consegui determinar o nível de dificuldade das perguntas. Por isso quero pedir sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Eu não sei muito sobre a Academia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Hehehe, não faz mal, depois que você terminar de responder minhas perguntas, você vai saber um pouco mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Não se preocupe, as perguntas não são muito difíceis. São só... umas questões sobre o cotidiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Então vamos começar. Aqui vai a pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Por que sinto que eu já fiz isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Você está falando das perguntas que o Swan de Mondstadt fez para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Naquela vez o Swan deu as respostas antes! Paimon não acha que esse pesquisador vai deixar a gente consultar as respostas antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Você precisa de materiais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Você está em busca de inspiração?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
