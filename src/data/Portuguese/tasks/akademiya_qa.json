			"dialogs": [
				{
					"id": 230260201,
					"content": "Hehe... Talvez você já saiba, mas cada Darshan da Academia possui sua área de pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260202,
					"content": "Sendo assim, qual é o nome do Darshan que possui mais pesquisadores, aquele com o maior grupo de pesquisadores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260203,
					"content": "Amurta",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260205,
					"content": "Armuta",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "Hm, esta resposta está completamente equivocada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260207,
					"content": "Atamur",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "Hehe, que pena. Esta não é a resposta correta.",
