			"dialogs": [
				{
					"id": 230290101,
					"content": "Está quase na hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Você ainda está trabalhando nas raízes da Árvore Divina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "Viajante, você não poderia ter vindo em melhor hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Muito obrigado por toda sua ajuda. A Árvore Divina agora está em perfeitas condições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "Depois de discutir com Ladep, achamos que ela vai conseguir ficar assim por bastante tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "Finalmente teremos tempo para nos dedicar as nossas teses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Olha, eu peguei emprestado um Aparelho Fotográfico do Pharez, vou registrar o estado da Árvore Divina com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "Viajante, por favor me ajude a tirar uma foto panorâmica da Árvore Divina completa. Marquei o lugar no mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Por que você não faz isso sozinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Ehmmm, é... É... Muito alto para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "Morro de medo de ir a lugares altos sozinha... O sentimento de ser derrubada pelo vento... Ou perder meu manuscrito para uma rajada de vento não me deixa em paz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "#Normalmente, o Pharez é quem vai ao alto, mas parece que hoje está muito ocupado. Você é {F#a única}{M#o único} em quem posso confiar, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
