				{
					"id": 726770808,
					"content": "Hã? Espere, você quer dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770809,
						726770810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770809,
					"content": "Há um Regisvine Pyro perto daqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770811
					]
				},
				{
					"id": 726770811,
					"content": "Sim! Acho que hoje é um dia de treinamento para Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
