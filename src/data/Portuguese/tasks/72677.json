					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770402,
					"content": "Hehe, acho que você sabe agora, não é, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770403,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770404,
					"content": "Saber o quê, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770405
					]
				},
				{
					"id": 726770405,
					"content": "Você consegue imaginar quanto tempo teríamos tomado se quiséssemos lhe pintar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770406,
					"content": "É por isso que escolhemos tirar fotos! Não é que nos importamos. Na verdade, é porque nos importamos com você que decidimos poupar tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770407,
						726770408,
						726770409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770407,
					"content": "Oh, entendi o que você fez!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770410,
					"content": "Entendi. Foto, bom... Muito quente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770411
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770411,
					"content": "Vou logo apagar essa fonte de calor. Quanto mais rápido, melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770412
					]
				},
				{
					"id": 726770412,
					"content": "Ooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770408,
					"content": "Ridículo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770409,
					"content": "Você não está errada, mas ainda assim, aqui é muito quente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				}
			]
