			"dialogs": [
				{
					"id": 726770701,
					"content": "#{NICKNAME} muito forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770702,
						726770703
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770702,
					"content": "Mais ou menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME} e Paimon lutam muito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770705,
					"content": "#Hmm... Pensando bem, o objetivo de nossa jornada é encontrar {F#o seu irmão}{M#a sua irmã}, mas nós sempre acabamos envolvid{F#as}{M#os} em alguma luta no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770706,
					"content": "É bom. Eu gosto de lutar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770707
					]
				},
				{
					"id": 726770707,
					"content": "Bem... Apesar de ser legal, devem existir passatempos melhores, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770710,
					"content": "#Quando eu virar um grande Bake-Danuki, quero ser forte como {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770711
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770711,
					"content": "Você vai conseguir, Kichiboushi! Mas você tem que prometer para Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770712,
					"content": "O quê, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770713
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770713,
					"content": "Bem... *Cof*! Mesmo que você vire um Bake-Danuki poderoso como Ioroi, prometa para Paimon que não vai intimidar os mais fracos que você, ou que sairá por aí brigando à vontade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770714,
					"content": "#Não seja como aquela grande e feroz flor que começou a cuspir chamas no momento que viu {M#o}{F#a} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770715,
					"content": "Então, quando posso lutar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770716,
						726770717,
						726770718
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770716,
					"content": "Quando é para se proteger...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770719,
					"content": "Hmm... Não entendo. Mas prometo a Paimon. Sem intimidar, sem sair brigando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770720
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770720,
					"content": "Isso aí, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770721,
					"content": "Em seguida... Hã, essa deve ser a parada final das oito que Ioroi decidiu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770722,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770717,
					"content": "Quando é para proteger outras pessoas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770718,
					"content": "Quando você precisa lutar pelo que é certo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770719
					]
				},
				{
					"id": 726770708,
					"content": "Lutar é uma dor de cabeça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770709
					]
				},
				{
					"id": 726770709,
					"content": "Sim, mas às vezes nós não temos opções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770703,
					"content": "Já lutamos muito contra coisas como essa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770704
					]
				}
			]
		},
