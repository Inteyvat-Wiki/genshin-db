			"dialogs": [
				{
					"id": 726770301,
					"content": "Muito grande! Muito quente! Muito bom ter flor grande de fogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770302,
					"content": "Sim! Oh, além disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770303,
					"content": "Kichiboushi, espere um pouco, vamos tirar uma foto sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770304,
					"content": "Em um lugar quente como esse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "Mas é justamente por isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770306,
					"content": "Hmm... Certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
