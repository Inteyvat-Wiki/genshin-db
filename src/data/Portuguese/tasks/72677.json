			"dialogs": [
				{
					"id": 726770101,
					"content": "A vista da paisagem daqui é superespecial, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770102,
					"content": "Muita muita água. Cores especiais. Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770103,
					"content": "Vocês soam como se pudessem ser irmãos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#Mas é muito especial, não é? Como você descreveria, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770105,
					"content": "Como Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "O que foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770113,
					"content": "#Esse lugar daqui tem uma vista fantástica. {NICKNAME}, você ainda lembra do artista de antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770114,
					"content": "Vermeer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "Isso mesmo! É ele! Não o ajudamos a colocar aquelas pérolas brilhantes naquelas duas estátuas gigantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770118,
					"content": "Ele até mesmo nos deu uma pintura depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770119,
					"content": "É isso que você está procurando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "Deve ser esse! Venha dar uma olhada, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770121,
					"content": "Hmm! Muito parecido! É foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770122,
					"content": "Não, é uma pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770123,
					"content": "Hã? Mas por que pintar se pode fotografar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770124,
					"content": "#Uh... É verdade, {NICKNAME}, por que as pessoas fazem isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770125,
					"content": "Porque as pessoas querem criar algo que elas mesmas fizeram.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "Hã, isso parece razoável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770130,
					"content": "Além disso, algo que você pinta tem maior valor sentimental.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "Sim! Pintar algo pincelada por pincelada é muito difícil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770132,
					"content": "Hmm... Então tirar fotos de mim é fácil, não difícil, e sem sentimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770133,
					"content": "Hã?! Não! Não é isso, é que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770134,
					"content": "Pintar toma muito tempo. Kichiboushi pode ficar cansado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "Sim, sim! Se ficarmos muito tempo pintando, você ficará com as pernas muito cansadas de ficar na mesma pose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770136,
					"content": "Antes fui selado em pedra. Sempre em pé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770137,
					"content": "Por isso, muito tempo depois com selo quebrado, pernas doendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770138,
					"content": "Uau, isso parece realmente muito doloroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770139,
					"content": "Mas, Paimon pode voar, pernas não cansam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770140,
					"content": "Ei! Quando Paimon voa, é um exercício em todo o corpo, é muito cansativo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770141,
					"content": "Ooh, flor em chamas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770142,
					"content": "Ei, você está ouvindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770143,
					"content": "Você quer dizer Flor-Flamejante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "Oh, é mesmo. A Floresta Chinju não possui Flores Flamejantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770145,
					"content": "Você quer uma, Kichiboushi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770146,
					"content": "Quero! Parece quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770147,
					"content": "#Bem, peça uma para {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}, quero. Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770149,
					"content": "Será que todos os Bake-Danuki falam assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770127,
					"content": "Aparelhos Fotográficos são caros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "Hã?! São? Então isso quer dizer que quando estamos levando o nosso para batalhas, nadar, escalar ou pular de montanhas podemos quebrá-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770129,
					"content": "Hmm... Tenha mais cuidado de agora em diante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770116,
					"content": "Quem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "Vermeer! Você não se lembra quando o ajudamos a colocar as pérolas brilhantes nas estátuas gigantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770106,
					"content": "Como Anemo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "Ah, vocês dois possuem um vasto vocabulário...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "Hmm, tão bom como de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770110,
					"content": "#Uh, Paimon não acha que é isso que {NICKNAME} quer dizer... Mas, não importa! Kichiboushi é muito esperto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726770111,
					"content": "Uma vista super especial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "Hã? Não diga para Paimon que seu vocabulário também está pequeno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
