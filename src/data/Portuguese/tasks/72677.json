			"dialogs": [
				{
					"id": 726771001,
					"content": "A vista da paisagem daqui é superespecial, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771002,
					"content": "Muita muita água. Cores especiais. Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771003,
					"content": "Vocês soam como se pudessem ser irmãos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#Mas é muito especial, não é? Como você descreveria, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771005,
					"content": "Como Cryo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "O que foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771013,
					"content": "Esse lugar daqui tem uma vista fantástica. Paimon realmente quer pintar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771014,
					"content": "Você sabe pintar, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "Paimon pode aprender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771016,
					"content": "Desenhar... Mas desenhar muito difícil. Antes vi Utamarou desenhar. Muito tempo para um desenho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771017,
					"content": "Por que pessoas pintam se podem fotografar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771018,
					"content": "#Uh... É verdade, {NICKNAME}, por que as pessoas fazem isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771019,
					"content": "Porque as pessoas querem criar algo que elas mesmas fizeram.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "Hã, isso parece razoável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771024,
					"content": "Além disso, algo que você pinta tem maior valor sentimental.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "Sim! Pintar algo pincelada por pincelada é muito difícil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771026,
					"content": "Hmm... Então tirar fotos de mim é fácil, não difícil, e sem sentimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771027,
					"content": "Hã?! Não! Não é isso, é que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771028,
					"content": "Pintar toma muito tempo. Kichiboushi pode ficar cansado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "Sim, sim! Se ficarmos muito tempo pintando, você ficará com as pernas muito cansadas de ficar na mesma pose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726771030,
					"content": "Antes fui selado em pedra. Sempre em pé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726771031,
					"content": "Por isso, muito tempo depois com selo quebrado, pernas doendo.",
