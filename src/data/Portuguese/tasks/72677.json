					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770807
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726770807,
					"content": "Poderíamos levar Kichiboushi para ver uma \"Flor-Flamejante muito grande\".",
