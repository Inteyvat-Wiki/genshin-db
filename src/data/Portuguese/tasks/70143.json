			"dialogs": [
				{
					"id": 701430201,
					"content": "Olá, Viajante, suas aventuras estão indo bem ultimamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Pode-se dizer que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "#Ouvi falar bastante de seus feitos em suas aventuras. Se você continuar nesse ritmo, com certeza se tornará {F#uma aventureira}{M#um aventureiro} excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "Além disso... Sobre as operações de aventura, tenho aqui um Relatório de Aventura. Não sei se você tem interesse nele ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "Mais uma missão nova?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "Parece que você já está bem proficiente nestes assuntos da Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Mas desta vez não é uma missão, mas sim um Relatório de Aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "Esse Relatório de Aventura é sobre a Espinha do Dragão de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "A Guilda de Aventureiros já estabeleceu um acampamento nela, e muitos aventureiros estão montando guarda lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Marquei a localização no seu mapa. Depois de chegar no acampamento, procure uma Aventureira chamada Iris. Ela pode lhe falar melhor sobre a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Continue firme em suas aventuras, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
