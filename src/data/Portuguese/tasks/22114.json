				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"An Nervoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "*Suspiro* Realmente, isto é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140202,
					"content": "Sobre a Linling...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Hmm? Você está perguntando sobre a Linling? Bem... Como posso explicar? Ela simplesmente não é adequada para esse trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140204,
					"content": "Especificamente, os erros que ela cometeu nos dados são muito graves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140205,
					"content": "Para esta semana, apenas os dados de um ou dois dias estão corretos. Até mesmo uma olhada por cima seria mais precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140206,
					"content": "Como posso deixar esse trabalho para ela com essa atitude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140207,
					"content": "Bem, se são apenas os números...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "Não existe \"apenas\" quando se trata de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140209,
					"content": "Uma única tábua muito curta já é suficiente para diminuir o volume de um barril.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140210,
					"content": "E na minha opinião, é a mesma coisa no trabalho. Um pequeno erro pode atrasar o trabalho todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140211,
					"content": "Vamos tomar exemplo do cálculo de barcos. Se contar mal o número dos barcos, as medidas com base no número dos barcos serão imprecisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140212,
					"content": "A imprecisão pode sair caro e, mesmo que alguém resolva o problema, o tempo desnecessariamente perdido para corrigir o problema não pode ser recuperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140213,
					"content": "Você entendeu agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140214,
					"content": "Eu... Eu entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "Mesmo assim, está faltando mão de obra aqui no porto, então provavelmente não a demitirei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140216,
					"content": "Como devo dizer... \"Uma tábua mais curta\" é melhor do que \"falta uma tábua\", não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140217,
					"content": "A pessoa responsável pela inspeção de carga não está disponível no momento devido a uma emergência... Diga a Linling que sua ajuda será conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140218,
					"content": "Se ela não tiver problemas neste trabalho, poderá voltar ao seu trabalho de contar os barcos quando a pessoa encarregada voltar a trabalhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140224,
					"content": "Hmm... Acho que isso pode ser considerado um teste e uma segunda chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140225,
					"content": "Dê esse manifesto a Linling e diga-lhe para marcar todas as inspeções de carga que ela fez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140226,
					"content": "Além disso, por favor, diga a ela para que preste atenção. Se ela falhar aqui também, não existirão mais segundas chances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140219,
					"content": "Eu vou contar a ela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "O que vocês disseram a ela? Que ela foi demitida? Não, ela ainda não foi demitida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140221,
					"content": "Ainda está faltando pessoas... \"uma tábua mais curta\" é melhor do que \"falta uma tábua\", não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140222,
					"content": "A pessoa responsável pela inspeção de carga não está disponível no momento devido a uma emergência... Diga a Linling que sua ajuda será conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140223,
					"content": "Se ela não tiver problemas neste trabalho, poderá voltar ao seu trabalho de contar os barcos quando a pessoa encarregada voltar a trabalhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "An Nervoso"
				}
			]
		},
		{
			"id": 2211403,
			"completionStepIds": [
				2211403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211403",
							"2"
						],
						"stepId": 2211403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "Oh, o que devo fazer sobre o meu trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "An Nervoso disse que ia te dar outra chance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Ah, sério!? Maravilhoso! Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Eh? Inspeção de carga? Oh não... Eu nunca fiz isso antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Se eu cometer outro erro, definitivamente estarei ferrada. Não, eu tenho que fazer os preparativos primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Preciso ir procurar os padrões de inspeção anteriores e também os formatos padrão anteriores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "Você poderia me ajudar a confirmar a quantidade de carga primeiro? Você só precisa verificar os números de carga no documento e verificar se são precisos. Realizarei uma revisão mais detalhada depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Muito obrigada. Enquanto isso, vou fazer os preparativos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Não posso cometer mais erros dessa vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "Deixe para nós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "Não, não posso, não desta vez. A inspeção de carga é muito mais complicada do que contar os barcos. Eu tenho que fazer isso sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Então, basta confirmar a quantidade de carga. Eu farei uma inspeção mais específica depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211405,
			"completionStepIds": [
				2211405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211405",
							"2"
						],
						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Vocês já verificaram os números?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Já.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Ótimo. Os meus preparativos estão quase completos também. Vou revisar todos esses produtos mais uma vez daqui a pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Oh, certo! Por favor, aceite isso como agradecimento pela sua ajuda. Vou revisar a carga em um momento. Desta vez, nada pode dar errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "Por acaso, você não estava compondo um poema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Claro que não! Eu sei quais são prioridades. Não é hora de escrever poesia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "...Não posso mais escrever poesia no trabalho. Eu tenho que me concentrar no trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "O trabalho é a prioridade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Eu sei disso. Mas fazer a mesma coisa dia após dia, ano após ano... Você acaba ficando entediado, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "E, bem, é exatamente porque é esse tipo de trabalho secundário, sabe? Não é tão importante e ninguém liga para você, então você começa a adormecer depois de um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "An Nervoso sempre diz coisas como \"todo trabalho é importante\" e \"todo trabalho é decisivo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Mas se for esse o caso, por que todos ainda são tão exigentes quanto ao tipo de trabalho que desejam fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Você precisa assumir a responsabilidade pelo seu trabalho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Só peço sua ajuda de vez em quando Eu mesmo faço isso na maioria das vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "Eu sei que devo assumir a responsabilidade pelo meu trabalho. Mas quanto mais ocupada fico, mais sinto vontade de relaxar. É por isso que peço a sua ajuda às vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Se eu realmente estivesse ociosa, eu ia procurar coisas para fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Bem, você não trabalhou um dia em sua vida, trabalhou? Não adianta te dizer tudo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Por que você quer escrever poesia tanto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Por que você está me perguntando isso de repente? Deixe-me pensar... Bem, por que você acha que uma pessoa trabalha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "Pessoalmente, acredito que \"trabalhar para poder continuar trabalhando\" é chato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "Como eu digo isso? Todo mundo tem que ter seus sonhos, certo? Um sonho totalmente separado do trabalho dia a dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "Dessa forma, mesmo nos momentos em que você está tão cansado para continuar trabalhando, pode se refugiar nos seus sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "Mas esta é apenas a minha maneira de pensar, é claro. Não tenho ideia de como os aventureiros pensam sobre essa questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "Aventureiros vivem apenas para os seus sonhos. Pessoalmente, acredito que o trabalho regular me permita manter os pés no chão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Ainda assim... Hahaha, confie em mim: Sonhos são apenas sonhos. Quando você trabalha, você ainda precisa manter os pés no chão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
