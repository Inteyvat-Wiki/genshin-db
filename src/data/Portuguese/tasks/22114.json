					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Estou ferrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "*Choro* O An Nervoso disse que este tipo de trabalho não é adequado para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Ele não está apenas me demitindo? O que eu faço? Eu... Eu sempre me dedico de corpo e alma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Hã? Por que tão de repente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Bem... Eu não te pedi antes para me ajudar a contar os barcos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "Confiei em você, então não verifiquei os dados que você me forneceu e os entreguei diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "Muitos dos números estavam errados ... An Nervoso ficou bravo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Você pode me ajudar a falar com ele? Eu... Eu vou fazer o meu melhor no trabalho a partir de agora! E também não vou pedir para me ajudar novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "Mas não me atrevo a perguntar a ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "Os dados anteriores dos barcos estavam errados?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Estavam... Eu te pedi antes para me ajudar a contar os barcos, ainda lembra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "Confiei em você, então não verifiquei os dados que você me forneceu e os entreguei diretamente... E muitos deles se mostraram errados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "Mas só pedi a sua ajuda de vez em quando. Eu também fiz muito cálculos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "Com ambos os lados juntos, nem sei a origem dos erros. E o An Nervoso ficou muito furioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Você pode me ajudar a falar com ele? Eu... Eu vou fazer o meu melhor no trabalho a partir de agora! E também não vou pedir para me ajudar novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "Mas não me atrevo a perguntar a ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211402,
			"completionStepIds": [
				2211402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
