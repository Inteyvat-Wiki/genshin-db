			"trigger": {
				"objectNames": [
					"An Nervoso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "Eu sou um tanoeiro: Não sou particularmente bom com minhas mãos, nem mesmo tenho nenhum talento em específico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140702,
					"content": "Um tanoeiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Bem, isto é, sou como alguém que conserta barris e que precisa de uma única tábua de madeira para terminar meu barril de madeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140704,
					"content": "Mas a tábua que eu tenho em mãos, não é de boa qualidade. É um pouco curta, e se eu for usar para fazer meu barril com esta madeira, sua capacidade vai ser reduzida significativamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140705,
					"content": "Ainda assim, se eu quiser uma tábua nova, quem sabe quando que eu vou terminar este barril.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140706,
					"content": "E da forma em que o prazo de terminar o barril está se aproximando, tenho que escolher dos males o menor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140707,
					"content": "Quem sabe quantas pessoas estão por aí, debaixo do sol, que são tanoeiros como eu, que estão enfrentando um dilema parecido com o meu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140708,
					"content": "Podemos conversar sobre o trabalho da Linling?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "O trabalho dela? Ah, sim. Ela pediu que você a ajudasse a contabilizar o número de barcos no passado, não foi? Eu sei sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140710,
					"content": "Não pareça tão surpreso. Desde que eu obtenha resultados, eu realmente não sou tão exigente quanto a como ela faça o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140711,
					"content": "De qualquer forma, as recompensas que ela te dá, saem diretamente do bolso dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140712,
					"content": "Agora quanto a ela fazer relatórios sem revisá-los primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "An Nervoso"
				},
				{
					"id": 221140713,
					"content": "Esse tipo de atitude irresponsável é o que realmente me deixa irritado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An Nervoso"
				}
			]
		},
