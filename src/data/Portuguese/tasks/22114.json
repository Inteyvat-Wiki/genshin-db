					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140802
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140802,
					"content": "Dessa vez, eu tenho que ser muito cuidadoso. Não posso fazer nenhum erro...",
