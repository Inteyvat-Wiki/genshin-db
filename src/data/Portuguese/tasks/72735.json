				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Ei, quais de vocês é o líder? Apresente-se! É hora de lutar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Grande Torre Sennichi"
				},
				{
					"id": 727350102,
					"content": "Eu sou Grande Torre Sennichi, um gigante entre gigantes. Grande Mestre Hanakado pediu a cabeça do líder da Gangue Arataki... e eu estou aqui para coletá-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Grande Torre Sennichi"
				},
				{
					"id": 727350103,
					"content": "Eita, ele parece poderoso... E também soa poderoso! Parece que estamos contra um oponente bem poderoso desta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Qual é a sua, hein? E que ideia é essa de tentar roubar minha originalidade colocando \"Grande\" no seu nome? Está tentando roubar os holofotes de mim, seu grandalhão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Muito bem, \"gigante entre gigantes\", hora de te pôr no seu lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "T-tão alto! E você é... é um oni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Grande Torre Sennichi"
				},
				{
					"id": 727350107,
					"content": "V-você parece que poderia me comer no café da manhã! ...P-por que alguém como você participa de Batalhas de Besouros? É apenas uma brincadeira de criança... Arg, onde foi que eu me meti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Grande Torre Sennichi"
				},
				{
					"id": 727350108,
					"content": "Uh, como é que é? \"Brincadeira de criança\"? Oh, não, você NÃO disse isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Parece que você não sabe absolutamente nada sobre Batalha de Besouros. Seu equívoco implora por uma correção de um veterano, meu chapa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "Dá uma lição nele!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Isso aí! Vá dar um jeito nele! Você consegue, Joga-boi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Parece que não tem escapatória... Certo, manda ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grande Torre Sennichi"
				},
				{
					"id": 727350111,
					"content": "Esse cara já deveria ter feito um ajuste em sua atitude!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
