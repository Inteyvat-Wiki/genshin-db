				},
				{
					"id": 715360302,
					"content": "Agora só preciso fazer mais alguns para entregar com as lembrancinhas que comprei. Tenho certeza que as pessoas em casa vão adorá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360303
					],
					"speakerTitle": "Candace"
				},
				{
