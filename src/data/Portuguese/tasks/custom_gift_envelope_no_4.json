			"dialogs": [
				{
					"id": 715360101,
					"content": "#Feliz Ritual de Lanternas, {NICKNAME}. Eu soube como você ajudou Dehya com o envelope de presente. Era lindo, obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Tudo certo na vila, imagino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Sim, tudo graças a Dehya e aos outros. Posso descansar um pouco melhor sabendo que a vila continua protegida enquanto estou fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Aproveita esse tempo para dar uma boa descansada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Vou sim. Dehya quer visitar a Vila Qiaoying em alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Ela disse que a paisagem é linda e a vila é conhecida pelo chá. É um presente perfeito para as pessoas em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Eu estava planejando seguir a tradição daqui e fazer alguns envelopes de presente para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Mas Dehya encheu nosso cronograma até não poder mais e de tanto correr por aí, não tenho certeza que vou ter tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "#Dehya me disse que você é {M#bom}{F#boa} em fazer envelopes de presente. Poderia me mostrar como fazer um?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Claro, deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
