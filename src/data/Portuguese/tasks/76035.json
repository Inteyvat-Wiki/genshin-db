			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Será que Columbina não tá aqui...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Você está me procurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350103,
					"content": "Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Você quase me mata de susto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Ao sentir sua presença, queria ver quanto eu conseguiria me aproximar pelas suas costas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350107,
					"content": "Você parece ser bem desocupada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Hã... É isso que parece? As coisas eram meio diferentes quando eu estava com os Fatui. Nunca havia muita coisa para eu fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350109,
					"content": "A Tsaritsa apenas queria o poder das Deusas da Lua. Nunca fui enviada para pegar uma Gnosis, ou algo do tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350110,
					"content": "Então o que você costuma fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Caminhar, olhar a lua, e às vezes cantar, mas passei a cantar menos depois que Sandrone proibiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350112,
					"content": "Hã? Ela não gosta de você cantando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "Não, pelo contrário, ela elogiou. Mas eu tinha acabado de entrar nos Fatui, e ela disse que os outros ficariam nervosos ao me ouvirem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350114,
					"content": "E para aqueles que não me conhecem, pareceria que eu estaria prestes a usar algum tipo de poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350115,
					"content": "Ah, faz sentido, mais ou menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "Ah sim. Mas há outra razão. Ela disse que estaria pesquisando de noite, e que se eu cantasse de dia, estaria interrompendo o sono dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350117,
					"content": "(Tenho certeza que a razão foi essa!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Por isso, eu passei a cantar ao lado da porta dela de noite. E ela me expulsou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Você se dá bem com outras pessoas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "Me dar bem? Hmm, quando nos conhecemos, Arlecchino parecia querer se dar bem comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350122,
					"content": "Ela costumava aparecer atrás de mim, como eu fiz com você. Falava sobre me testar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350123,
					"content": "Eu tentei jogar o mesmo jogo com ela, mas ela sempre se virava quando eu ainda estava muito longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350124,
					"content": "Isso durou até um dia eu ter sido forçada a usar o kuuvahki. Consegui dar um susto enorme ela. Depois disso, nunca mais brincou comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350125,
					"content": "(A Serva provavelmente nunca achou que isso fosse uma brincadeira...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Dottore também me pedia para ajudá-lo na sua pesquisa relacionada ao Reino da Luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350127,
					"content": "Eu o ajudei algumas vezes, mas na maioria delas, era muito chato. Use o kuuvahki para atingir isso, use o kuuvahki para controlar aqui... Parei de ir depois de um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350128,
					"content": "Parece que você está de bom humor hoje...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Sim. Apesar de eu ter \"fugido de casa\", eu tenho algumas memórias preciosas dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350131,
					"content": "Arlecchino e Sandrone cuidaram bem de mim, junto com...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350133,
					"content": "(Essa expressão... Queria saber sobre quem ela tá pensando...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Me dê a sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350135,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Rosalyne me ensinou que... É importante sempre expressar gratidão aos outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350138,
					"content": "Obrigada por me ouvir hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350139,
					"content": "Não foi nada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Será que isso... é a Graça da Deusa da Lua?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Isso basta por hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760350142,
					"content": "Uau, que final repetino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Shh... Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Você tem razão. Não vamos mais incomodá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Ela lembrou de algumas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "...Por quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Você falou bastante sobre o seu passado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Você realmente tinha que vir assim pelas costas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}