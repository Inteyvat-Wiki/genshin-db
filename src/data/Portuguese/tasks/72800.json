				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "...O que eu tenho de fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Desculpe, mas você é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Eu sou Kamei Munehisa, só estou de passagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Uau... Esse cara se veste como um Samurai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "Samurai? Ele é um Samurai do Shogunato? Ouvi dizer que a atitude do Shogunato para com forasteiros é bem... Sutil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Não precisa se preocupar. Eu saí do Shogunato, não sou mais um Samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Normalmente venho aqui para procurar por comida, mas hoje reparei que havia monstros rondando na região.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Eles pegaram toda a comida dela por isso tive que me livrar deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Você vem por aqui sempre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Geralmente não há tantos monstros por aqui, costumo vir para pegar frutas ou caçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Bem, isso é o que eu tenho a dizer. Depois de derrotar esses monstros, os outros aqui não se atreverão a voltar por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Se vocês também estão procurando por comida, podem dar uma olhada. Só peguei o que precisava, e deve ter algo sobrando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Bem, adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Ele saiu assim, sem mais nem menos? Seu comportamento é exatamente como ouvi falar dos Samurais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "Mas o que ele quis dizer quando falou que saiu do Shogunato? Samurais que saem dele são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Eles são como os inimigos que encontramos antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Sim, eu também ouvi dizer que alguns Samurais saíram do Shogunato e vagam pela terra, roubando pessoas para sobreviverem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Apesar dele não parecer um cara mau, é melhor ficarmos alertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Está bem, está bem. Não estamos aqui para procurar por ingredientes? Mas ao julgar a situação atual, é melhor não seguirmos em frente, caso fique perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "#Ess{F#a}{M#e} Viajante esteve nos escoltando por tanto tempo. El{F#a}{M#e} deve estar cansad{F#a}{M#o}. Vamos cozinhar algo, descansar um pouco e retornar para a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "O Samurai disse que ainda há ingredientes deixados para trás, não é? Vamos dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Como os Kairagis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Você derrotou todos esses monstros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Sim. São apenas monstros comuns, fáceis de lidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Por que você está procurando por comida na natureza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "Tenho minhas razões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
		{
