	"talks": [
		{
			"id": 303201,
			"completionStepIds": [
				303201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303201",
							"2"
						],
						"stepId": 303201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Bem-vindos, {NICKNAME}, Paimon, Scaramouche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "Ufa! Sinto como se tivéssemos ido em uma longa jornada... Paimon está exausta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Você não gosta que te chamem por esse nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Tanto faz. Mas eu estive pensando, eu provavelmente deveria mudar meu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "Você não se chama mais de \"Scaramouche\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "Depois de tudo que aprendi sobre o que o Dottore fez, não tem como continuar usando um nome que tenha conexão a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Não estou planejando retornar aos Fatui, e eles não me aceitariam de volta de qualquer forma. Os eventos recentes afetaram várias pessoas, e eles podem nem mesmo lembrar de quem é o sexto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Então você está deixando os Fatui de vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Vamos chamar isso de uma retirada estratégica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "É como você disse, Lorde Menor Kusanali. Tudo pode parecer fútil, mas não foi completamente sem propósito. Pelo menos fiz com que um monte de pessoas se esquecessem de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Mas isso não significa que seu próprio passado desapareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Mas é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "E o seu principal propósito, pelo qual você deu tudo que tinha... você não conseguiu alcançá-lo. Espero que você consiga ver e entender isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Mudar o mundo, mudar o passado, mudar o destino de outras pessoas... Essas não são coisas simples de serem realizadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "O que você estava procurando era a aniquilação... mas isso é apenas uma fantasia. Mesmo que Scaramouche seja removido da existência, o mundo não se curvará à sua vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "... Sim. Haha, que ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Você se arrepende de fazer tudo aquilo, quando você teve tão pouco em retorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Mesmo que eu seja completamente indigno, não há nada no mundo que valha se arrepender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Lorde Menor Kusanali, você propositalmente deixou aquela informação na Irminsul, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Sim, e eu sofri para garantir que você adquiriria essa informação naturalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "Por que você iria tão longe? Você está tentando me conquistar também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "Honestamente, suas experiências passadas tornaram você um recurso útil para Sumeru e para mim. Conquistar você de fato fazia parte do meu plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Mas antes disso, eu queria te dizer a verdade sobre seu passado. Se tudo que eu quisesse fosse usar você, então eu não seria diferente de Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "... Muito inteligente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Eu acho que você poderia dizer que é uma das minhas virtudes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Utilidade a outros é o que me dá valor. Então se abraçar meus pecados é o que me torna útil novamente, que assim seja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Nahida não vê você assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "#Ah certo, eu quase esqueci... vocês são {M#os mocinhos}{F#as mocinhas}. Vocês gostam de justiça e tudo aquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Desculpe se eu tenho uma perspectiva ligeiramente diferente das coisas. Mas eu não sinto como se tivesse sido enganado. Os líderes mais sábios são destinados a acabar com os melhores ajudantes... Eu posso viver com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Estou feliz que você pensa assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, no futuro, eu continuarei procurando na Irminsul mais profundamente, e verei quais segredos posso descobrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "#Incluindo o início da jornada {M#da sua gêmea}{F#do seu gêmeo} registrado na Irminsul. O que aconteceu exatamente antes e depois desse ponto? Eu também quero saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "#Obrigad{M#o}{F#a}. Espero que você consiga encontrar algumas respostas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Pode deixar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Sim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "Após eu mergulhar nas correntes de informações da Irminsul, por que você foi até Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Porque eu queria saber o que você tinha mudado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "... Então foi assim que você descobriu de quem os destinos foram mudados, e como.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "Bem, quaisquer que sejam suas razões, você me fez um favor, e eu farei o que puder para retorná-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "... Eu não fiz isso por uma recompensa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "Pegar emprestado e devolver é o único relacionamento verdadeiro entre pessoas. Um dia estaremos quites, não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Isso não é verdade. O relacionamento entre duas pessoas não é como um registro que pode ser zerado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Acho que, bem no fundo, você sabe disso. As pessoas que aparecem em sua vida, não simplesmente evaporam como gotas de água e não deixam nada para trás. Não existe algo como \"ficar quite\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Algumas coisas nesse mundo jamais podem ser trazidas de volta, e não podem ser mudadas, e é por isso que existem emoções no mundo humano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Tudo que você sente como sendo verdadeiro e duradouro, e seja o que for que está faltando em você, não te fará completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "Ser humano, significa viver com imperfeições. Você pode escolher se quer ou não ser um humano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Mas não existe nenhum humano vivendo sem um coração, não é? Enfim, eu desisti de ser um humano há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Você entende o que é dor perfeitamente bem, mesmo sem um coração. Você está apenas enterrando seus sentimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "O passado está cravado em pedra, mas você pode continuar seguindo em frente. E quanto mais seu futuro durar, menor será o seu passado, até que um dia seja apenas uma minúscula fração da sua vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Parece que você já tem um futuro planejado para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Espero que você possa dar uma chance a Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Tudo acabou sendo bem complicado, Paimon nem sabe por onde começar... Mas a coisa mais importante no momento é que você precisa seguir a Nahida. Caso contrário, todos os nossos esforços serão em vão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "... Então acho que estarei te ajudando dos bastidores de agora em diante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Fico feliz que você tenha aceitado nossa proposta. Por que não escolhe um novo nome para celebrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "Rápido, rápido, rápido! Paimon quer escolher um apelido feio para você também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Pois... pois Paimon ainda não gosta tanto assim de você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Hmph. Então espero que não nos encontremos tanto no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "\"Um nome é o primeiro presente da vida\". Você não disse isso em voz alta, mas sei que é isso que você está pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#{NICKNAME} e Paimon te ajudaram bastante. Se você não consegue decidir um nome, então você poderia pedir a {M#eles}{F#elas} para te darem algumas ideias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "Hã? Você quer que a gente decida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "Nada disso, Paimon apenas dá apelidos! Se você está procurando um nome sério... é contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Por favor, não faça parecer que estou extorquindo você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
