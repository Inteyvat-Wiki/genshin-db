				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "Já sei! Posso terminar minha história com as palavras de Mikoshi Nagamasa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320302,
					"content": "Você quer dizer, por conta de que todos na história se foram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "Aqaba"
				},
				{
					"id": 30320303,
					"content": "É. Ouvi dizer que Mikoshi Nagamasa morreu em uma idade bem avançada. Ele é a escolha perfeita para ser o narrador do epílogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320304,
					"content": "\"As nuvens negras se dissiparam, mas elas continuaram a lançar sua sombra na mente de Mikoshi Nagamasa por décadas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320305,
					"content": "\"Então, em uma noite como um idoso, ele teve um sonho. Na noite em que foi forjada aquela incrível lâmina, o Grande Cortador Tatara, as pessoas se alegraram, houve pintura, dança e bebida.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320306,
					"content": "\"... Todas essas expressões de felicidade derreteram no fogo da fornalha e se tornaram nuvens vermelhas que se juntaram em torno do último nascer do sol que Mikoshi Nagamasa viu em sua vida\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320307,
					"content": "\"A vida é uma história muito grande para ser contada, uma jornada que você precisa caminhar para presenciar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320308,
					"content": "... Hmph.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
