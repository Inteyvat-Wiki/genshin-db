				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "Ufa! Já era hora de um intervalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Assim que você para, todo o cansaço e fome voltam rapidinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Descanse, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "Uau! Ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "... Hã? Olhe para aquela garrafa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "... O que tem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "Será que alguém quebrou enquanto estavam limpando a sala ou algo do gênero? Mas Paimon não se lembra de existir alguém da limpeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(Na noite que ficamos aqui, Paimon acabou se batendo contra a mesa depois de ter se assustado com algo relacionado ao Scaramouche e quebrou o vaso.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Mas Scaramouche apagou a sua existência. Ele mudou o mundo... então, por qual motivo esse vaso ainda está quebrado?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "#Você parece perdid{M#o}{F#a} e confus{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "... Quem é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "#Eu sei porque você está perturbad{M#o}{F#a}. Qualquer um que soubesse disso teria a mente sobrecarregada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "Hã? Tem alguém aqui falando com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Infelizmente, o destino de Teyvat não pode ser facilmente mudado. Talvez um deus tenha uma pequena chance, mas para qualquer outro... quem pode dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Quando um pequeno animal bate em um tronco de árvore, apesar de a árvore poder balançar, ela não é movida. O mesmo é verdade para o destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "Um vaso que se quebrou ao cair no chão. Tenha ele sido quebrado por um gato ou um pássaro, o resultado ainda é um vaso quebrado, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "Q—Quem é você?! Como você sabe de tudo isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "A história não muda facilmente, mas corações humanos podem. Acredite em seus próprios olhos. Apenas aquilo que você vê é verdade. O que não é visto não passa de ilusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "A voz desapareceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "Quem raios estava falando?! E o que estavam fazendo, falando todas aquelas coisas assustadoras do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(Acreditar em meus olhos? O que ela quer dizer... eu deveria confiar em minhas memórias?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
