					"content": "Para onde esse barco vai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "#Para uma terra dourada, uma terra dos sonhos. Um país que não tem neblina... Nós nos encontraremos em nossos sonhos, amig{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
