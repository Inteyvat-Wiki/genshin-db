				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Balões vermelhos românticos... Tenho certeza de que essa beleza vai mexer com o coração da minha amada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "#Não é mesmo, amig{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Eu... não sou a melhor pessoa para perguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "#Não importa o que aconteça, muito obrigado, amig{M#o}{F#a}. Fique por um tempo, eu gostaria de te apresentar a Yopoyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Dada a hora... Hmm, ela deve chegar a qualquer momento agora. Marcamos um horário e tudo mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Tenho certeza que ela ficará impressionada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
