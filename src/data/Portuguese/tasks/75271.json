			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi! Você chegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki? É você... Por que você está vestido assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "É seu Nanasian favorito. Aluguei a roupa para essa ocasião. Não é legal? Ah, e esses balões! Eu os preparei para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "Na verdade, tem uma coisa que quero te contar há muito tempo... Por favor, saia comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "...Você está falando sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Estou! Minha amada senhorita, Yopoyi, por favor, saia comigo para um encontro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Você bateu sua cabeça ao vestir essa fantasia ou algo assim? Esse é o nosso terceiro aniversário! Nós somos CASADOS!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Eu sei! Mas... você sempre me disse que eu não sou um cara romântico, e nós nem tivemos uma confissão adequada antes do nosso casamento... Então, embora seja tarde, essa é a minha confissão para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Haha... Então é isso? Certo então, vamos sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Sim, sério, seu bobo romântico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Uma rajada de vento sopra e os apaixonados se abraçam.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
