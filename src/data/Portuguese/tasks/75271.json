					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710502,
					"content": "Ziki deve ter te dado muito trabalho. O raciocínio dele pode ser um pouco nada convencional, mas é isso que eu gosto nele.",
