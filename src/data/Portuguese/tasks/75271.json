					"nextDialogs": [
						752710402
					]
				},
				{
					"id": 752710402,
					"content": "#Você vai!? Obrigado, obrigado! Você é um{F#a} amig{F#a}{M#o} tão gentil!",
					"roleType": "TALK_ROLE_NPC",
