			"dialogs": [
				{
					"id": 752710101,
					"content": "Por favor, não estoure esses balões! Se quiser brincar com eles, sempre posso te dar alguns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710102,
					"content": "Esses balões parecem bem especiais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "Dá um pouco de vergonha dizer, mas eles são muito importantes para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710104,
					"content": "A julgar pela aparência, você deve ser capaz de adivinhar sua intenção, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710105,
					"content": "...Uma proposta de casamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "Na verdade, é para uma confissão romântica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710109,
					"content": "Pretendo usar esses balões, cheios de meus sentimentos para minha amada, para confessar meu amor a Yopoyi! Bem? O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710110,
					"content": "Você deveria usar os vermelhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "Hmm, você tem razão. Puxa, será que meu espírito de romance ainda não está à altura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710112,
					"content": "Yopoyi vai chegar aqui a qualquer minuto! Onde vou encontrar balões vermelhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710107,
					"content": "Uma confissão romântica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "I—Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
