					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "Devemos levar apenas as Moras e devolver sua comida. Hmm, Paimon não consegue ficar tranquila assim.",
