			"dialogs": [
				{
					"id": 230230401,
					"content": "Deixando de lado a fertilidade do solo, talvez a \"água\" também seja um problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Talvez enterramos a rosa muito fundo, por isso não recebeu água suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "Viajante, você poderia regar a rosa para nós, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
