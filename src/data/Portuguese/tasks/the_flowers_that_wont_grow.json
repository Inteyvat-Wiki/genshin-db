				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "Estes devem ser suficientes. Muito obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Com esse fertilizante especial, a fertilidade do solo não deve ser mais um problema, e a rosa certamente crescerá bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Espero que este fertilizante funcione bem, diferentemente dos anteriores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Vocês já tentaram usar fertilizantes antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Aplicamos fertilizantes comuns, mas eles não foram muito eficazes... Bem, na verdade, não foram nem um pouco eficazes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Mas eles funcionaram muito bem nos outros campos. Honestamente, não sei o que há de errado com esse campo aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "Tudo bem, deixe isso para lá. Pronto, Viajante, aceite isto como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
