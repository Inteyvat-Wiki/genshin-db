			"dialogs": [
				{
					"id": 760300301,
					"content": "Isso deve bastar. Parece que conseguimos mais um monte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Vamos voltar. Não podemos deixar essa obra de arte incompleta pra sempre, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*Choro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aaaaah! Alguém tá vindo! Rápido, se esconda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*Choro* Onde eu estou... mamãe... eu quero ir pra casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Parece que ela é dos Filhos da Lua Gelada. Será que tá perdida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Eu preciso ajudá-la...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300309,
					"content": "O que você quer dizer? Ela parece precisar de ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Sim, mas eu lembro que os Filhos da Lua Gelada são bem receosos para com forasteiros. Sua cabeça não é coroada com chifres, e já é tarde. E se ela se assustar e fugir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300311,
					"content": "É uma possibilidade, mas não podemos deixar ela aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Hmm... Sigam-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300313,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
