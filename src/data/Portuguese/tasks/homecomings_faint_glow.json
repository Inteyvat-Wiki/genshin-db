			"dialogs": [
				{
					"id": 760300501,
					"content": "*Choro* Hã? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "Que lindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "Isso deve bastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300504,
					"content": "E lá vai ela. Essa trilha de pedras deve levar de volta a Oficina da Lua Gelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Columbina disse que ela não deseja ser tratada como uma deusa, mas ela ajuda quem está com dificuldades de todo jeito...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Ah, mas e a pintura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Está tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300508,
					"content": "Uma obra de arte incompleta sempre pode ser terminada depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300509,
					"content": "Eu gosto de observar as pessoas encontrarem seu caminho de volta para casa e o local que pertencem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
