			"dialogs": [
				{
					"id": 760300101,
					"content": "Oh, a atmosfera daqui tá meio estranha hoje. Você tá plantando flores por aqui, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Eu não, eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300103,
					"content": "Eles... os kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Essas pedras brilharão sutilmente ao absorverem o kuuvahki. Os kuuhenki gostam muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300105,
					"content": "Então... eles colocam as pedras no chão, e brincam com elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Não exatamente. Venham aqui e vejam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300107,
					"content": "Hã...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Oh, parece uma pintura quando se vê de cima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Mas parece que tá faltando um pedaço...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Isso mesmo. Preciso ir coletar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300111,
					"content": "Ah, então você vai sair?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Sim, eu conheço o lugar perfeito. Agraciado pela lua e repleto dessas pedras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300113,
					"content": "Quer que a gente vá também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760300115,
					"content": "Isso aí, vamos pegar mais umas pedrinhas. Queremos ver como a obra completa vai ficar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
