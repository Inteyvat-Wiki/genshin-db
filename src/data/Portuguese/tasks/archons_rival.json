			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "Albedo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110102,
					"content": "Vocês voltaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110103,
					"content": "Nós temos nos esforçado tanto, venha dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110104,
					"content": "Olha só.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "Hmm... De fato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110106,
					"content": "É exatamente o que eu pensava, essa espada cresce conforme você a usa na batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110107,
					"content": "Mas ela não é um ser humano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110108,
					"content": "É exatamente isso que a faz especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110109,
					"content": "Ah sim, antes de tudo, deixe-me dizer uma coisa muito importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110110,
					"content": "Eu já fiz umas investigações aqui perto da Montanha Nevada, e encontrei alguns sinais estranhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110111,
					"content": "Não são mais ladrões, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110112,
					"content": "#Mas ele não disse que nós somos {M#ladrões}{F#ladronas}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "É verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110115,
					"content": "Acredito que é necessário investigar mais esses traços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110116,
					"content": "Sejam ladrões ou outra coisa, saberemos o resultado após a investigação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110113,
					"content": "Não é o que os Ladrões de Tesouro pensariam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "Os Fatui? E eles escolheram nos atacar dentro do acampamento Ladrões de Tesouro... Eles nos seguiram até aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110202,
					"content": "Mas por que eles fariam isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110203,
					"content": "Você irritou eles enquanto nós não estávamos olhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110204,
					"content": "Você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110205,
					"content": "Mas o que, claro que não!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "Hm, talvez seja algo que todos nós fizemos então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110208,
					"content": "Eu acho que os Fatui estão procurando por esta espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110209,
					"content": "Hã!? Você não estava mantendo esta espada super escondida? Como eles souberam que ela existe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110210,
					"content": "Talvez eles tenham visto você usando ela na montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110211,
					"content": "Se os olhos deles forem bons, eles definitivamente viram como esta espada se destaca do resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110212,
					"content": "Eles realmente querem tudo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110213,
					"content": "Nem tudo, não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110214,
					"content": "#Eu mesm{M#o}{F#a} já ouvi algo semelhante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "Os Fatui estão coletando coisas relacionadas aos arcontes. Isto, creio eu, já é do seu conhecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110216,
					"content": "Agora que você comentou, já ouvimos o Mestre Diluc dizer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110217,
					"content": "Durin é o inimigo mortal do Arconte Anemo, e tinha um poder comparável ao dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110218,
					"content": "Dizer que poderia competir com os arcontes, ou que estava relacionado a eles... Nenhuma seria uma afirmação exagerada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110219,
					"content": "Não é à toa que eles estão de olho nesta espada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "Então é assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110221,
					"content": "Fiz uma nova descoberta enquanto rabiscava por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110222,
					"content": "Há uma área à frente que é bastante notável. Suas Linhas Ley fluem de forma diferente de qualquer outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110223,
					"content": "Monstros próximos foram atraídos por ela e sucumbiram à sua influência. Como resultado, suas constituições ultrapassaram em muito outras do mesmo tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110224,
					"content": "Isso parece conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110225,
					"content": "Bem, nós estamos aqui para ajudar esta espada a crescer, não é mesmo? Vale a pena ir experimentá-la nesses monstros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110226,
					"content": "Precisamente minha intenção. Oh, e lembre-se de observar como vários inimigos afetam esta espada de forma diferente enquanto estiver fazendo isso, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110206,
					"content": "Jamais faria algo assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "Então, qual foi a sensação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110302,
					"content": "O poder da espada aumentou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "Tenho uma hipótese sobre isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110305,
					"content": "Cada vez que esta espada absorver o poder do corpo de inimigos derrotados, ela ressoará com os restos mortais de Durin, escondidos em algum lugar desta montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110306,
					"content": "Minha nossa, isso soa incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110307,
					"content": "Se meu palpite estiver correto, isso pode significar que todos os monstros aqui podem estar ressoando com o corpo de Durin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110308,
					"content": "Mas por que eles fariam isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "Temo que isso tenha a ver com a origem dos poderes desses monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110310,
					"content": "Durin não é uma besta comum. Mesmo estando morto há muito tempo, toda a montanha ainda está presa ao poder de seu cadáver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110311,
					"content": "O poder misterioso do dragão... Pode ser por si só uma forma de maldição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110312,
					"content": "Ainda não temos informações suficientes. Se quisermos entender mais, mais dados são necessários. É aqui que você entra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110313
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110313,
					"content": "Acho que o período da história se tornou um período de trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110314,
