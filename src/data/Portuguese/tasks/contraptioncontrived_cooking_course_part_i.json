			},
			"dialogs": [
				{
					"id": 715000401,
					"content": "O fogo não parece estar sendo controlado devidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000402
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 715000402,
					"content": "Não importa. Sempre haverá ingredientes sobrando. Deixe-me tentar de novo",
					"roleType": "TALK_ROLE_NPC",
