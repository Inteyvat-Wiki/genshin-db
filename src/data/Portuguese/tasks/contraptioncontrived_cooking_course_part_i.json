			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Retentora de Nuvem"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000303,
					"content": "Então o resto pode ser deixado para esta máquina. No entanto, Viajante, você deve cuidar do controle do calor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000304
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 715000304,
					"content": "Esta máquina não pode fazer isso por si só?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000305
					]
				},
				{
					"id": 715000305,
					"content": "Bem... Tentei várias vezes usar uma chama interna na tentativa de conseguir um controle de calor autônomo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000306
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 715000306,
					"content": "Mas a chama no fogão da Máquina de Culinária Suprema está longe de ser normal. Preciso usar minha própria chama adeptal para operá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000307
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 715000307,
					"content": "Chamas adeptal de tal potência deformariam a forma dos componentes internos se fossem alimentadas diretamente no interior da máquina. Sacrificar a máquina inteira por um ganho pequeno é, portanto, insensato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000308
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 715000308,
					"content": "A melhor solução no momento é aplicar as chamas adeptal externamente. Como tal, é necessário um ajudante para controlar o calor das referidas chamas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000309
					],
					"speakerTitle": "Retentora de Nuvem"
				},
				{
					"id": 715000309,
					"content": "#As chamas mais importantes são suas para comandar, Viajante. Quando você estiver pront{M#o}{F#a}, me informe imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Retentora de Nuvem"
				}
			]
		},
		{
			"id": 7150004,
			"completionStepIds": [
				7150007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
