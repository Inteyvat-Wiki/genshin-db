						400390802
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390802,
					"content": "Ei, vocês não têm olhos? Não sabem que estão vendo a grande Capitã Beidou?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390803,
					"content": "Hehe... Beidou, há quanto tempo não nos encontramos. Vejo que suas habilidades continuam boas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390804,
					"content": "Carmen, quanto tempo. O que aconteceu? Você engordou bastante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390805,
					"content": "Se engordar mais, já não conseguirá mais se esconder dentro de um arbusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390806,
					"content": "Ah, Beidou, como você é engraçada, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390807,
					"content": "Vou ser direta: eu quero essas coisas. Solte elas agora, e não vou complicar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390808,
					"content": "Sim, sim, todos vocês ouviram... Soltem essas coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390809,
					"content": "Deixarei tudo aqui para você. E com isso, eu e meus companheiros vamos partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390810,
					"content": "Carmen saiu rápido com os Ladrões de Tesouro...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "Uau, Paimon está chocada que tudo se resolveu tão rápido...",
