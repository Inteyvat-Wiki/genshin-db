					"nextDialogs": [
						400390812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390812,
					"content": "Eles se renderam rápido demais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
