					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Essa placa de pedra possui as seguintes palavras entalhadas nela...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 710640202,
					"content": "...\"Perdi o movimento em todos os meus membros por causa da batalha no Despenhadeiro. Só posso falar, por isso pedi para que alguém registrasse isso\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 710640203,
					"content": "...\"Eu sobrevivi à batalha, mas toda noite que pensava em meus companheiros era uma sem dormir. E com meu corpo nesse estado, eu detestei o fato que não fui privilegiado de me juntar a eles\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 710640204,
					"content": "...\"Eu tentei me juntar a eles, mas Rex Lapis ouviu e me reprovou, me despertando de meu sono\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 710640205,
					"content": "...\"Eu não posso mais usar esta armadura e equipamento que foram me dados pelos Millelith. Só acumularão poeira caso fiquem comigo, por isso deixo tudo aqui para que alguém destinado a passar aqui os pegue\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Placa de Pedra"
				},
				{
					"id": 710640206,
					"content": "...\"A todos, apesar de não podermos mais fazer isso nessa vida, que sejamos companheiros na próxima. Que dividamos o vinho da lealdade jurada mais uma vez, e defendamos Liyue de seus inimigos!\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Pedra"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Uau, eu não imaginei que você realmente encontraria... Esse daqui é o \"Tesouro dos Millelith\" não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "Eu não sei o que está ali dentro, mas tenho certeza que o soldado que o deixou para trás ficaria satisfeito em saber que você tenha encontrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "Já se passaram quinhentos anos desde aquele desastre... Quando eu penso que esse lugar já foi palco de uma batalha tão feroz em que tantos de nossos antepassados se sacrificaram, fico me perguntando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "Será que algumas dessas pessoas que partiram para a batalha junto com Rex Lapis pensaram que seriam lembradas pelo povo no decorrer dos séculos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "Eles duvidaram de seus deveres? E quanto a aqueles que nunca ganharam uma Visão, como ficaram leais para um deus que nunca os favoreceu, mesmo na morte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Eles fizeram isso porque seu deus nunca os abandonou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "#Sim, você está cert{F#a}{M#o}. Aqueles com Visões e aqueles sem... Nós todos nos esforçamos para um futuro de potencial infinito. Bem, isso é o que chamam de motivação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "Nós somos iguais. Não estamos aqui por causa de lembranças de um passado melhor, ou para alguma realização no presente... O que nos move é nos ajudarmos para deixarmos algo de nós na época que vivemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Talvez daqui a muito tempo, o Despenhadeiro se torne em nosso monumento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Essa mina está cheia de poços e vales, e do suor de gerações de mineradores... Todos eles são testemunhas da jornada árdua que escolhemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Assim como esse Monumento de Pedra, esse lugar estará daqui a cem ou até mil anos no futuro, como uma prova que os sacrifícios feitos aqui não foram em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Hehe, eu não viverei para ver isso acontecer. Mas se alguém um dia vier aqui para celebrar nós, pobres mineradores, muito depois de termos partido, eu ficarei satisfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Eles foram leais às suas próprias decisões.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
