			"dialogs": [
				{
					"id": 740760501,
					"content": "Isso é o Bloco da Personalidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Não é possível analisar a densidade da substância à vista. Parece ter um peso... zero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "Parece que conquistamos o último bloco. Pelo menos agora podemos negociar com o outro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "Se olharmos pelo lado positivo, pelo menos podemos impedir que a Ordem da Cruz de Narcissus forje a Espada Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Não é isso, Paimon. Nosso objetivo final é forjar a Espada Sagrada e usá-la para impedir os planos deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Claro, Ann, eu não esqueci o significado dessa espada para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "A Espada Sagrada, que pode cortar a vontade, é a chave para desvendar o enigma para você. Na verdade, ela é igualmente importante para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "No entanto, temos questões mais importantes e urgentes para lidar. Podemos resolver os mistérios relacionados a nós mesmos mais tarde. Você concorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "Por mim, sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760510,
					"content": "#Nesse caso, {NICKNAME}, se você puder. Por favor, pegue a \"Personalidade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		}
