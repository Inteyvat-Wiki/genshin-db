						],
						"pointId": 7020
					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "Acho que tenho uma ideia sobre a \"primeira gota\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760402,
					"content": "Parece que está se referindo ao primeiro pingo de chuva após a criação do mundo. Acho que essa ideia era favorecida na Antiga Fontaine e na Ordem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760403,
					"content": "Mas como devemos conseguir encontrar algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Bem, essa primeira gota se tornou parte de toda água em Teyvat. Nesse sentido, toda gota de água é a \"primeira gota\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760405,
					"content": "É como o primeiro deus espalhando o potencial para grandeza. Um elemento de divindade está presente no corpo de cada pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760406,
					"content": "Mas se for simples assim, a pessoa que veio antes de nós não devia ter problemas em oferecer a resposta certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "De fato. Estou provavelmente enganado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760408,
					"content": "Bem, mesmo se fosse a resposta errada, foi uma boa. Eu posso apenas concluir que a pessoa que preparou essas charadas não tinha senso de romance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760409,
					"content": "E agora ele está rindo de você por não entender como funciona segurança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Sou incapaz de fornecer uma resposta. Minha busca pela \"primeira gota\" teve 1.200 resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "\"Lendas dizem que a primeira gota de vinho do mundo foi do Arconte Anemo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Ok, pode parar aí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "Sobre isso... Acho que tenho algo que posso compartilhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "Tem uma lenda que diz que Oceanids vieram da primeira lágrima derramada pela Arconte Hydro anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "Enquanto isso, a primeira lágrima na terra foi derramada pela primeira Oceanid após descobrir a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "A primeira lágrima no mundo não viria do primeiro bebê humano chorando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Lágrimas de animais são, na verdade, descargas de sal, e nesses tempos pacíficos, humanos nasciam sorrindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "Isso é o que as lendas dizem, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "Na verdade, acredito que os choros de bebês e descargas de sal de animais podem ser considerados similarmente como comportamentos sem emoção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "Bebês choram devido a estímulos externos e para preencher os pulmões de ar o mais rápido possível. Isso é que os textos acadêmicos do Amurta de Sumeru dizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Então a resposta é uma \"Oceanid\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Isso parece uma resposta que a pessoa antes de nós pode não ter fornecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Acho que você está chovendo no molhado aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Mas Paimon acha que esse é o caminho certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "Baseado em meu entendimento da Ordem da Cruz de Narcissus, isso é lógico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760431,
					"content": "A Imperatriz Vermelha que sonha em um lugar desconhecido, a sonhadora que jamais diz o que quer dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760432,
					"content": "Isso é ainda mais confuso que as charadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Ora, e isso importa? Já estamos na parte final. Seja qual for o caso, a resposta será revelada no final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760434,
					"content": "Agora, Ann, se não se importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Claro, vou tentar. Se eu falhar, é melhor vocês pensaram em outra resposta logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Abriu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Temos que conseguir a última parte. Caso contrário, a Espada Sagrada cairá nas mãos da Ordem da Cruz de Narcissus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760428,
					"content": "Acho que estamos no caminho certo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "É bem melhor do que tentar achar o vinho do Arconte Anemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Podemos tentar. Vamos para Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Se vocês vão insistir nisso, pelo menos vamos fazer direito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
