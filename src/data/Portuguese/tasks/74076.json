					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "\"Sempre unido\"... \"Nascido em um instante, frequentemente contraditório, acompanho você em sono eterno\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
