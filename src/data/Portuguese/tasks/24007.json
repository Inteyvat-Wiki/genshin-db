				]
			},
			"dialogs": [
				{
					"id": 240070501,
					"content": "Deixa eu ver... A gente pode usar esta engrenagem, e se a gente abrir esse rolamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Para que vocês estão procurando isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Estou tentando fazer minha própria marionete mecânica. Na verdade, eu tenho pesquisado conhecimento sobre o assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Quando eu entender tudo, vou fazer um mecautômato gigante — isso sim vai surpreender o papai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "Li vários livros nessa sala, e fiz alguns componentes básicos de acordo com as instruções neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Tenho quase certeza de que um Mecautômato está logo ao alcance, desde que eu continue trabalhando nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Mas eu não posso estudar essas coisas na cidade, ou ele vai descobrir — e isso acabaria com a surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "Foi assim que esse lugar se tornou a base secreta de pesquisa de mecanismos da Lovi. Quanto a mim... Bem, eu sou o assistente dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Bem, assistente, conversamos demais! Hora de dar partida em nossa pesquisa. Hoje, temos que fazer um braço mecânico que se mexe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Sim, senhora! Nossa pesquisa começa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		}
	]
