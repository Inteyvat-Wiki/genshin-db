			"dialogs": [
				{
					"id": 240070201,
					"content": "Só tem um pouco de papelão podre aqui... nenhum componente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070202
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070202,
					"content": "Isso é estranho. Eu pesquei umas engrenagens da água aqui ontem mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400703,
			"completionStepIds": [
				2400703
