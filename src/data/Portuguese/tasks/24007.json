			},
			"dialogs": [
				{
					"id": 240070401,
					"content": "Isso são... roupas rasgadas? As cores desbotaram completamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070402,
					"content": "Alguém já pescou por aqui? Não tem nenhum componente aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
