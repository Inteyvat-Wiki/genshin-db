					"Verut",
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "Lovi? Você encontrou algo bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "Nada, não tem nada aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "O que vocês estão fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#Estamos procurando por tesouro, {M#irmãozão}{F#irmãzona}! Hehe... Quer brincar também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Tesouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Não escute Verut se gabando. Só estamos querendo pescar uns componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Bem, os componentes são tesouros... Hã? Devia ter uns aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Parece que não vamos encontrar nada aqui. Vamos para outro lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "Claro! Vamos um pouco mais para frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "Eu vou com vocês.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Eita, tá começando a parecer meu irmão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Nesse caso, vamos andar mais um pouco. Tenho certeza que as águas por aqui estavam cheias de componentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "Não saiam correndo por aí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Onde está Aurele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "Ele foi procurar o Sr. Delerue com algumas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "Quanto a nós, tivemos que ser obedientes e nos comportar... e procurar pelo tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070111,
					"content": "Quer se juntar a nós, falando nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070112,
					"content": "Não escute Verut se gabando. Só estamos querendo pescar uns componentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070113,
					"content": "Bem, os componentes são tesouros... Hã? Devia ter uns aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				}
			]
		},
		{
