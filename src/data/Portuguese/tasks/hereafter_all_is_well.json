				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300601,
					"content": "Muito bem. Ficarei com estas <color=#00E1FFFF>Madeiras de Areia</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300602
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300602,
					"content": "O templo ainda vai demorar mais um tempo para ser reparado, então continuarei aqui por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300603,
					"content": "Se você tiver tempo, pode passar aqui para ver como andam as coisas.",
					"roleType": "TALK_ROLE_NPC",
