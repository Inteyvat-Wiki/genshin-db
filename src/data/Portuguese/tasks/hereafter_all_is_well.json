			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Isso vai ser um projeto e tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "Então você realmente está arrumando esse lugar, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Ah, é você. Digo, eu disse que era um cidadão de bem agora, não disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Eu só não esperava que este projeto seria tão extenso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "O projetista que eu trouxe para planejar o novo templo, ficou bem alvoroçado quando eu disse que era para um templo Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Ele não só ficou fazendo mais e mais diagramas, como ele ainda me arrastou para ir comprar materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "Se ele fosse algumas décadas mais novo, aposto que ele insistiria em trabalhar nisso ele mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "Você não se deparou com nenhum perigo, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Perigo? Oh, você quer dizer monstros e Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "Não precisa se preocupar. Depois que ficaram sabendo que eu estava reparando um templo Yaksha, o Ministério dos Assuntos Civis enviou alguns Milleliths para ficarem de escolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Eles mais ou menos afastaram os monstros próximos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "Quanto aos Ladrões de Tesouro... Eles parecem estar escondidos agora que os Millelith estão aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Porém, o trabalho necessário para arrumar este templo realmente excedeu minhas expectativas. Os materiais que separamos não são suficientes, então tivemos que pedir mais alguns da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "E ainda que os Ladrões de Tesouro não se atreveriam a fazer algo na área da construção em si, eles muito provavelmente devem estar de tocaia para fazer uma emboscada durante o caminho e roubar os materiais enquanto estão sendo entregues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "Os Millelith conseguem cuidar da área da construção sem problemas. Mas eles provavelmente vão ter problemas em ajudar aqueles entregando as mercadorias se forem atacados pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Posso pedir um favor seu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "#Sei o quão habilidos{M#o}{F#a} você é. Aqueles Ladrões de Tesouro não são páreos para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Você poderia ir lá e dar uma lição neles para impedir que acabem interrompendo nosso trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Obrigado. Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Por que você não pede aos Milleliths?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Eles já estão de guarda no local da construção, dia e noite. Eu não quero acabar cansando eles ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "Vou deixar isso com você então, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Eu lembro que esta área não era muito segura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Você quer dizer como a área é cheia de monstros e de Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
