			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chefe dos Ladrões de Tesouro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "P-Por favor, pare! Nós perdemos, nos poupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300402,
					"content": "Peguem suas coisas e saiam daqui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "S-Sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300405,
					"content": "Mas... Posso perguntar o que fizemos para te ofender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300406,
					"content": "Você por acaso encontrou algum tesouro nesta área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300407,
					"content": "Estamos reconstruindo um templo por perto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "R-Reconstruindo um templo? No meio dessas montanhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300409,
					"content": "...Existe um templo de adeptus aqui!? Espera aí. Será que é aquela casa velha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300410,
					"content": "Chefe, de fato vimos uma estátua de um pássaro enquanto estávamos descansando por lá. Aquele deve ter sido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Subordinado dos Ladrões de Tesouro"
				},
				{
					"id": 718300411,
					"content": "Aquele era o Pardal de Bronze, um dos Yakshas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Hã!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300413,
					"content": "C-Chefe! A-A gente realmente ofendeu um adeptus...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Subordinado dos Ladrões de Tesouro"
				},
				{
					"id": 718300414,
					"content": "P-Pare de falar bobagem! A gente não sabia, então isso não conta! Foi por pura ignorância! Eu não acho que o adeptus iria julgar a gente neste caso... Não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300415,
					"content": "Enfim! Obrigado por ter nos contado sobre o templo estar sendo reparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300416,
					"content": "Pedimos desculpas pela nossa ignorância e grosseria de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300417,
					"content": "Iremos voltar e dizer aos outros para dar mais espaço ao templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300418,
					"content": "Chefe, não deveríamos ir lá e acender alguns incensos para se desculpar com o adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Subordinado dos Ladrões de Tesouro"
				},
				{
					"id": 718300419,
					"content": "Ei, ei! Quando foi que você virou um falador? Vamos, vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chefe dos Ladrões de Tesouro"
				},
				{
					"id": 718300403,
					"content": "Não cheguem perto desde lugar no futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
		{
