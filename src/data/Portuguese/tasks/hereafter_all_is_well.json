			"dialogs": [
				{
					"id": 718300701,
					"content": "Olá. Haviam Ladrões de Tesouro por aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300702,
					"content": "Ah, então eles saíram. Isso é ótimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300703,
					"content": "Mais alguma coisa que eu possa te ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Hahaha. Obrigado pela sua gentileza. Mas você já me ajudou tanto. Não seria justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "#Mas se você estiver dispost{M#o}{F#a}, seria de grande ajuda se você puder encontrar algumas <color=#00E1FFFF>Madeiras de Areia</color>. Considere isso como sua contribuição oficial ao trabalho de reparo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "É uma boa ação, afinal de contas. Um pouco de participação individual pode lhe trazer uma boa sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300707,
					"content": "Irei pegar para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Haha, tudo bem. Apenas traga a <color=#00E1FFFF>Madeira de Areia</color> que você encontrar e traga direto para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "Mais algumas pessoas fizeram doações para o trabalho de reparo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Hmm, para ser sincero, não muitas pessoas. Este é um lugar bem deserto, então a maioria das pessoas não sabem que existe um templo aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300711,
					"content": "E também suspeito que poucas pessoas lembrem de um Yaksha chamado Pardal de Bronze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300712,
					"content": "Mas chega disso por agora. Apenas traga-me a <color=#00E1FFFF>Madeira de Areia</color> que você encontrar e traga direto para mim.",
					"roleType": "TALK_ROLE_NPC",
