			"dialogs": [
				{
					"id": 706580101,
					"content": "Olá! Você está aproveitando o Festival da Brisa Florescente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580102,
					"content": "#Obrigad{M#o}{F#a} pela sua recomendação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Haha. Tenho mais um evento. Esse é relaxado. O nome é \"Melodia da Paisagem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580105,
					"content": "Você deve ter visto os Bardos em Mondstadt, não é? Ao participar neste evento, você poderá tocar boa música como eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580106,
					"content": "Nas montanhas altas, à beira do lago, sentir o sopro do vento, tocar uma música com certeza fará com que você esqueça seus problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580107,
					"content": "Não tenho experiência com isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Não precisa se preocupar. Essa atividade foi feita para que pessoas sem experiência com Performances também possam aproveitar e se divertir com a música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580110,
					"content": "Só precisa seguir as dicas e o ritmo das notas que todo o resto deve ficar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580111,
					"content": "#Está bem, ficarei relaxad{F#a}{M#o} então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Espero que você tenha um Festival da Brisa Florescente muito feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 706580112,
					"content": "Vou tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "Minha música soará bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
