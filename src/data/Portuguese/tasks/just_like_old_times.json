			"dialogs": [
				{
					"id": 761840101,
					"content": "Bem, isso é uma surpresa e tanto. Nunca pensei que veria o dia em que você me convidaria para uma das suas festas do chá, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840102,
					"content": "Talvez se você trabalhasse para melhorar um pouco sua etiqueta, eu te teria convidado antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840103,
					"content": "Concordo. Também ajudaria seu caso se você parasse de desafiar as pessoas para duelos o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 761840104,
					"content": "Vocês estão falando igualzinho aos meus irmãos e irmãs mais velhos. Não consigo evitar. Quando minha mestre me treinava na natureza, etiqueta não era exatamente uma prioridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840105,
					"content": "Deixa pra lá. Não é sempre que conseguimos nos reunir assim. Vamos só relaxar e aproveitar o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840106,
					"content": "Hmm? Essa é sua criação mais recente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840107,
					"content": "O nome dela é Fagio. Ela é uma operária empresarial geral totalmente automatizada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840108,
					"content": "Isso significa que Pulonia está realmente irreparável...? Sinto muito por isso, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840109,
					"content": "Tudo bem, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840110,
					"content": "...Lamento saber que nunca terei a chance de lutar contra ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840111,
					"content": "Claro que lamenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840112,
					"content": "Pulonia parecia forte, mas essa tal de Fagio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840113,
					"content": "... Você ia dizer que ela parece fraca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840114,
					"content": "Hã, haha, não, não. É só que ela não parece tão forte como Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840115,
					"content": "Hunf, Pulonia foi construído para medidas e cálculos. Eu tomei cuidado para não comprometer seu poder de processamento ao lhe dar capacidade de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840116,
					"content": "Mas Fagio não precisa processar fórmulas complexas. Todo o seu poder de processamento pode ser dedicado ao módulo de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840117,
					"content": "Então... Isso significa que ela é realmente mais forte que Pulonia? Isso é possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840118,
					"content": "Você só vai ficar satisfeito se eu demonstrar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840119,
					"content": "Só pra ficar claro, não vou pagar nenhum reparo se eu acabar quebrando ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840120,
					"content": "E eu não vou pagar sua conta de hospital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840121,
					"content": "(*Suspiro*... Eu sabia que isso ia acontecer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 761840122,
					"content": "(*nhom nhom*...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
