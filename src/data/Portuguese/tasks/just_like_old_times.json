			"dialogs": [
				{
					"id": 761840301,
					"content": "Essas festas de chá até que são boas. Se eu soubesse disso, teria vindo para uma mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840302,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Tudo bem, até a próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 761840303,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
