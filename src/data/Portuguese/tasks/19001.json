			"dialogs": [
				{
					"id": 190010101,
					"content": "Espero que a Irmã Barbara esteja bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010102,
					"content": "O que aconteceu com Barbara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "A Irmã Barbara disse que ela estava indo colher algumas ervas, mas ela ainda não retornou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010104,
					"content": "*Suspiro* Talvez eu deva reportar isso para os Cavaleiros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010105,
					"content": "Eu procurarei por Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "#Você? Bem... Creio que {F#a Cavaleira}{M#o Cavaleiro} Honorável será adequad{F#a}{M#o} para essa tarefa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010107,
					"content": "Além disso, assim eu não precisaria incomodar os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010108,
					"content": "Tudo bem, vou deixar com você. Antes da Irmã Barbara partir, ela disse que ela estava indo para o Reino dos Lobos para pegar algumas ervas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190010109,
					"content": "Você deve começar procurando por ela lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
