			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "#Nara dourad{F#a}{M#o}, Branca Voadora! Nos encontramos de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Aaah! Diga um 'oi' antes de sair do nada na próxima vez! Você quase mata Paimon de susto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "Não somos bandidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "#Hmm... Sim, tem razão... Por isso, Nara dourad{F#a}{M#o} e Branca Voadora, que não parecem caras ruins, podem me ajudar de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Eu sou {NICKNAME}, sempre é um prazer ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Paimon é Paimon! Não se esqueça dessa vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "De novo...? Hmm... Ahem, eu me chamo Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Nós viemos aqui com você, mas você esqueceu... Argh, que difícil de explicar! {NICKNAME}, vamos explicar para ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Vocês descrevem sua aventura com Aragaru em detalhes.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Mesmo? Bem, eu não me lembro, mas por alguma razão, quero confiar em vocês... E vocês também têm a flor que lhes dei, posso senti-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "Ah, sim! Nara ruins montaram um acampamento, vamos para lá ver o que deixaram para trás. Talvez eles estejam pensando em alguma artimanha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Nós lhe ajudamos a derrotar os caras maus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
