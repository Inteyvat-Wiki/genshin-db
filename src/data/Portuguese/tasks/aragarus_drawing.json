				{
					"id": 730580401,
					"content": "Vamos conferir o esconderijo dos Nara vilões e descobrir o que eles estão fazendo aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Como você pode saber se alguém é vilão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Bem, eu realmente não sei explicar isso, mas Nara {NICKNAME} e Branca Voadora não são vilões com certeza! Eu acredito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
