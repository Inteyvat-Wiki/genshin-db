			"dialogs": [
				{
					"id": 750000601,
					"content": "Você está bem, pequenino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000602,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000603
					],
					"speakerTitle": "Pequenino?"
				},
				{
					"id": 750000603,
					"content": "O q-quê—O que há de errado? Você não parece bem. É sua cauda? Você a machucou quando caiu daquela barreira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000604,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000605
					],
					"speakerTitle": "Pequenino?"
				},
				{
					"id": 750000605,
					"content": "Se ao menos pudéssemos enfaixá-la...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000606
					]
				},
				{
					"id": 750000606,
					"content": "Hehe, é hora da Paimon brilhar! Sua mochila está sempre tão cheia que leva o dia todo para encontrar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000607,
					"content": "Vamos usar este lenço da Mochila de Emergência da Paimon em vez disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000608,
					"content": "Eu não faço ideia de onde essa sua mochila deveria estar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000609
					]
				},
				{
					"id": 750000609,
					"content": "Hunf! Um local secreto e impossível de descobrir, é claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000610,
					"content": "De qualquer forma, você quer usar o lenço ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000611,
					"content": "#Vamos usá-lo. Muito obrigad{M#o}{F#a}, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000612
					]
				},
				{
					"id": 750000612,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000613
					],
					"speakerTitle": "Pequenino?"
				},
				{
					"id": 750000613,
					"content": "Certo, pequenino, não se mexa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000614,
					"content": "#Hehe, é obediente, não é, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000615,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000616,
					"content": "Isso deve servir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000617
					]
				},
				{
					"id": 750000617,
					"content": "Certo. Está se sentindo melhor agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000618,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000619,
					"content": "Certo, parece muito melhor agora. Que alívio... Ainda assim, como você acabou naquela barreira? E aqueles Cães da Fenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000620,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000621,
					"content": "Então você também não sabe, né? Bem, nós realmente não entendemos o que você está dizendo... Mas agora que te resgatamos, você pode ir para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000622,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000623,
					"content": "Espera aí, você não sabe onde é sua casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000624,
					"content": "E quanto aos seus parentes? ... Ah, aquele grandalhão de antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000625,
					"content": "#O que faremos, {NICKNAME}? Não podemos simplesmente deixá-lo aqui, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000626,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000627
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000627,
					"content": "Talvez seja melhor se você vier com a gente por um tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000628
					]
				},
				{
					"id": 750000628,
					"content": "Sim, faz sentido. Talvez encontremos a família deste pequenino quando chegarmos a Natlan... Mas nunca vimos nada parecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000629,
					"content": "#Ah! \"Escolhid{M#o}{F#a} dos... Dragões...\" O que será que isso significa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000630
					]
				},
				{
					"id": 750000630,
					"content": "Hã? Você quer dizer que ouviu algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000631,
					"content": "Pensando bem, Natlan é a \"Dragãolândia\", então isso significa que este pequenino... também é um?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000632,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000633
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000633,
					"content": "Ele realmente se parece um pouco com um Dragarto. Sabe... Duas pernas, uma cauda e tudo mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000634,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000635,
					"content": "Ele vir com a gente é de boa por mim, claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000636
					]
				},
				{
					"id": 750000636,
					"content": "Mas a gente devia pedir pelo consentimento dele primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000637
					]
				},
				{
					"id": 750000637,
					"content": "Verdade, verdade. Oi, carinha. Quer viajar com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000638,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000639
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000639,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000640
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000640,
					"content": "#Hehe! Parece que concordamos. Enfim, Paimon é Paimon e {M#ele}{F#ela} é {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000641,
					"content": "Hmm? Rawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000642
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000642,
					"content": "Ah, é, você precisa de um nome também... Deixa Paimon pensar. Certo! Já que você é amarelo e preto, vamos te chamar de \"Bolinho de Batata\", certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000643
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000643,
					"content": "Rawr... Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000644,
						750000646
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000644,
					"content": "Acho que isso só vai ser popular no Caçador de Cervos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000645
					]
				},
				{
					"id": 750000645,
					"content": "Você quer dizer que as pessoas não iam gostar em outros lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000647,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000648
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000648,
					"content": "#Quer que {NICKNAME} te dê um nome, então? Bem... mas Paimon não pode garantir que o senso de nome {M#dele}{F#dela} é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000649,
						750000650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000649,
					"content": "Pois saiba que todos os nomes que inventei até agora eram perfeitamente normais, tá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000650,
					"content": "Pobre criança... Sofrer um destino tão calamitoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000646,
					"content": "Parece que não gostou desse nome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000647
					]
				}
			]
		},
