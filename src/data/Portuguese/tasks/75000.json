						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Parece que ele ama esse nome! Bem, com sorte, vamos resolver o mistério que rodeia você em Natlan... Ah, e talvez a gente consiga algumas pistas do motivo de {NICKNAME} poder entrar no corpo daquele dragão de repente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Ah, é, você tá bem, falando nisso, {NICKNAME}? Você virou um dragão preto do nada... Tá sentindo algum desconforto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Ah, só um pouco de Saurienjoo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "E o que isso quer dizer?! Isso não é hora de brincadeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Mesmo assim, {NICKNAME}, Paimon nunca soube de ninguém em Natlan que pudesse virar um dragão... Isso é meio esquisito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Sério, a gente acabou de chegar aqui e já parece que aconteceu tanta coisa... Enfim, como saímos daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hã? Você sabe onde fica a saída?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Virar um dragão foi de boa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "Bem, é melhor continuar assim! As coisas podem dar ruim rapidinho se você se transformasse num dragão e não conseguisse se transformar de volta um dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
