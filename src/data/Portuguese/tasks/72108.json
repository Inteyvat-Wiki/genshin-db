			"dialogs": [
				{
					"id": 721080101,
					"content": "Finalmente, aqui. Aqui deve ser a Floresta Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080102,
					"content": "A Sacerdotisa Mascarada disse que tem um velho amigo dentro da Floresta Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080103,
					"content": "Então, vamos indo agora mesmo Para o fundo da floresta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
