			},
			"dialogs": [
				{
					"id": 721080931,
					"content": "O quê? Eu não sabia que era tão importante. Você deveria ter dito isso antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Por causa disso, fui selado sem nenhuma explicação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Cem anos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Ugh! Pare de zombar de mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Deixa para lá! O passado é o passado! Também tenho alguma ideia sobre a barreira perto da floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Quando eu estava lutando contra aquela Kitsune sorrateira, uma vez a vi na costa leste do mar. Parece uma Sakura do Trovão com um portão torii, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Quando aquele homem estava lutando contra os demônios, eu estava preocupado que alguns demônios poderiam sair e nos machucar. Então eu usei magia para selar esse local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Deixe-me pensar. O selo está sob o precipício ao leste... Kichiboushi, vá até lá e ajude eles a liberarem o selo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "#Obrigad{M#o}{F#a}, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Certo, chega de papo. Vá rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "Se você se deparar com a Kitsune sorrateira, lembre-se de dar meus cumprimentos. Basta dizer... Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "\"Idiota, estou furioso. Volte aqui e venha lutar! Precisamos acertar as contas! E me ajude a quebrar o selo! Isso mesmo, não é por não conseguir fazer isso, mas você me deve um favor! Além disso, Gyoubu Koban disse que tem saudades de você!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "É muita coisa para se lembrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
					"content": "Mil anos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
					"content": "Um milhão de anos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				}
			]
		}
