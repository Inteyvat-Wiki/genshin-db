						721081106
					]
				},
				{
					"id": 721081106,
					"content": "Então esta é a magia do Bake-Danuki? Parece divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081107,
					"content": "Obrigada Kichiboushi! Vamos brincar de esconde-esconde na próxima vez!",
