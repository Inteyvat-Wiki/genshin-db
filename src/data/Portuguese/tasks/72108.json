			"dialogs": [
				{
					"id": 721081101,
					"content": "É isso? Um monte de pedras brutas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081102,
					"content": "Pois é? Ele parece estar usando algum tipo de magia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081103,
					"content": "Uau! As pedras desapareceram!",
