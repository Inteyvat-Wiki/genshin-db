					"content": "Ooh... Eu quero coçar a minha barriga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080802,
					"content": "Mm? Por que você voltou? Vá procurar os <color=#00E1FFFF>três pequenos</color> Tanuki Shousei, Gyobu Koban e Kichiboushi e brinque com eles, por favor.",
					"roleType": "TALK_ROLE_NPC",
