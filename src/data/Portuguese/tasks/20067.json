				{
					"id": 200670101,
					"content": "Onde será que está o problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "Viajante... Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670104,
					"content": "Estudei bastante depois que você me ensinou daquela vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670105,
					"content": "Depois dessa vez, pedi a Jack que me ajudasse a fazer um teste simulado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670106,
					"content": "Mas... mas eu reprovei no teste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670107,
					"content": "Não tenho certeza do motivo de ter dado errado. Viajante, você poderia me treinar de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670108,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "Obrigada pela sua ajuda, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670111,
					"content": "Então... Em primeiro lugar, quantas pessoas um planador consegue carregar no ar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670109,
					"content": "(Uh, talvez eu dei as respostas erradas da última vez...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
