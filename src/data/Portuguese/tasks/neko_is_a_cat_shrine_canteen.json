			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "Isto é... Realmente incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140102,
					"content": "A escultura de pedra foi terminada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "Quando começamos, aquela pedra não se parecia nada comigo. Mas a cada olhada, ela se torna cada vez parecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140104,
					"content": "Vocês, humanos, são realmente incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140105,
					"content": "É muito barulhento, sim, mas eu sou a Sacerdotisa Chefe Provisória. Tais assuntos triviais não merecem reclamações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140106,
					"content": "Tragam aqueles peixes para aquele humano alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140107,
					"content": "São coisas boas, e podem ser consideradas seus... \"Condimentos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140108,
					"content": "Apenas peixe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Miau, eu consegui que Konbumaru conduzisse aquelas crianças a tentarem pegar alguns passarinhos, mas não saiu muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140110,
					"content": "Para eles, capturar peixes ainda é mais simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140111,
					"content": "É \"pagamento\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Miau, miau, miau, como você é irritante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140113,
					"content": "É só dar a ele - são coisas boas, afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "Bem, certamente parece ótimo agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140202,
					"content": "Haha, é você. Você acha que agora se parece um pouco mais com a Senhora Sacerdotisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140203,
					"content": "Com certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "Certo? Ah, também passei alguns dias trabalhando a noite inteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140207,
					"content": "Ah, estou com muita fome, eu acho... Hora de ir procurar algo para comer novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140208,
					"content": "A Neko lhe enviou alguns peixes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "Hmm, bem, a Senhora Sacerdotisa tem meus agradecimentos, mas uh... Acho que vou procurar comida por conta própria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140210,
					"content": "Já como peixe há vários dias seguidos. Acho que não conseguiria mais comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140211,
					"content": "Tenho saído à procura de alimentos. Quando tenho sorte, consigo agarrar um passarinho ou um pombo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140212,
					"content": "*Suspira* Mas o que eu gostaria de comer é um pouco de carne crua, sabe? Um pouco de carne crua firme e suculenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140213,
					"content": "Então, uh, Viajante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140214,
					"content": "Se você não se importar, poderia me trazer três porções de Carne Crua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140215,
					"content": "Não sou muito bom em caçar, por isso não tenho conseguido arranjar carne nestes últimos dias... Então, por favor, me ajude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140216,
					"content": "Tudo bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "Por favor, me ajude. Apenas três porções servirão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140217,
					"content": "Você pensou em voltar à Ilha Narukami para ter uma refeição?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "Bem, primeiramente, é realmente muito longe. E, além disso... Eu já estava pegando o jeito desta escultura. Se eu sair neste ponto, a viagem poderá me privar daquele \"sentimento\", sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140219,
					"content": "Preferia comer uma refeição rápida aqui mesmo antes de continuar a esculpir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140205,
					"content": "É muito mais largo, isso é certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "Bem, é claro. A Senhora Sacerdotisa é um pouco maior que uma gata convencional, mas se você quer uma estátua mais majestosa, então ela tem que ser ainda mais larga. Esta é uma estátua de santuário, afinal de contas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
