		{
			"id": 7221404,
			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Oh... Muito obrigado pela qualidade dessa carne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Vou preparar alguns bons pratos em um instante. Com alguma sorte, posso até terminar mais rápido depois de comer, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "O que os dois têm em comum, mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Comer uma boa carne lhe dá forças para continuar! Não era a mesma coisa com aqueles peixes. Não pude deixar de sentir que minhas mãos estavam muito fracas para trabalhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Honestamente, eu estava começando a ficar preocupado com a possibilidade de demorar mais do que o esperado para terminar a estátua inteira. Bem, isso não é um problema agora, graças a você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Quero dizer, eu estou sendo empregado por uma... Gata, claro, mas deve-se sempre evitar pedir prolongamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "Seja qual for o caso, vou terminar assim que puder... Pensando bem, a Senhora Sacerdotisa diz que uma vez que a estátua esteja pronta, algo de bom acontecerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Não tenho certeza do que isso significa exatamente, mas bem... Na verdade, estou bastante ansioso por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Volte daqui a pouco e dê uma olhada no produto final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
