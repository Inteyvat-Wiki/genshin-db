				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "Você já está de volta? Nossa, você é tão eficiente! Acho que agora sei o porquê de aquele \"cavalheiro\" gostar tanto de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180202,
					"content": "O dinheiro. Me dê aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "Quanta frieza. Quero dizer, eu tenho a recompensa bem aqui, mas você poderia ter um pouco de consideração pelos sentimentos do mensageiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180204,
					"content": "Ora, é uma honra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "Oh não, a honra é toda minha. Por favor, aceite esta recompensa... Foi um prazer fazer negócios com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Continuem se escondendo, seus ladrões, e não me deixem nunca saber onde vocês estão... Afinal, onde vocês estão se escondendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "Eu sei onde eles estão se escondendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Você? Como você... Hã. As indicações neste mapa são realmente bem detalhadas... De quem você pegou isso? Vile? E pensar que ela seria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "... Aqui não é nem um pouco próximo do lugar que tínhamos estabelecido anteriormente. Qual é exatamente o objetivo destes Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Me desculpe, por favor deixe-me marcá-los... Certo, terminei. Eu irei conseguir pessoas para verificar essas localizações imediatamente, e assim que tiver sido verificada, poderemos ir expulsar esses Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "Novamente, você tem meus agradecimentos, pela sua contribuição em Mondstadt. Dessa vez, não deixaremos nenhum Ladrão de Tesouro escapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "Você já está de volta? Nossa, você é tão eficiente! Acho que agora sei o porquê de aquele \"cavalheiro\" gostar de deixar os problemas em suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Eu deixei com os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Você deixou com os Cavaleiros de Favonius... Ei, eu não disse a você que deixar isso com eles seria problemático?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "Bem, você sabe mesmo como se esquivar. Felizmente o \"cavalheiro\" esperava que você pudesse fazer algo assim, então eu tinha um plano reserva preparado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "Bem, não se preocupe com o resto. *Suspiro* Acho que é hora de fazer alguns compromissos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Mas, segundo o \"cavalheiro\", suas ações podem nos levar em direções interessantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Afinal, teria sido obvio demais se eu mesmo relatasse os movimentos dos Ladrões de Tesouro, e o \"cavalheiro\" também não pode exatamente se aproximar diretamente dos Cavaleiros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "Bem, isso é para você. Pode levá-los. Como o \"cavalheiro\" chamou mesmo? Uma pequena recompensa por \"mudar o curso dos ventos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051802",
							"2"
						],
						"stepId": 2051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051803",
							"2"
						],
						"stepId": 2051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "Ainda está se preparando? Tudo bem. Basta sair quando estiver terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180502,
					"content": "De qualquer forma, quem é esse \"cavalheiro\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "Eu não te direi, não importa o quanto perguntar. Isto faz parte da nossa profissão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180504,
					"content": "Mesmo quando revelamos alguma informação, fazemos isso porque precisamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180505,
					"content": "Bem, você pode pensar o seguinte: qual das coisas que acabei de dizer se enquadra em \"coisas das quais revelei por que precisei\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180506,
					"content": "Qual o seu objetivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "O objetivo do \"cavalheiro\"... Eu não conseguiria adivinhar. Mas eu acredito que ele também quer proteger Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180508
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180508,
					"content": "Ou eu deveria dizer que ele provavelmente não faria coisas assim apenas pela diversão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180509
					],
					"speakerTitle": "Vile"
				},
				{
