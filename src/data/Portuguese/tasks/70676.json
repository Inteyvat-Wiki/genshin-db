			"dialogs": [
				{
					"id": 706760101,
					"content": "Paimon não sabia que na biblioteca havia uma sala como esta. Será esta a seção restrita que a Lisa mencionou uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760102,
					"content": "Hmm, bem, na verdade, não parece ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760103,
					"content": "Talvez seja uma daquelas salas das histórias em que não deixam entrar porque nelas se esconde algum grande segredo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760104,
					"content": "Se não queriam que ninguém entrasse, deveriam ter fechado a porta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "Paimon concorda. Entramos aqui normalmente agora há pouco, não parece que a fechadura está quebrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760106,
					"content": "Hã? Espera aí, essa não parece ser a porta pela qual entramos! Uau, ainda estamos dentro da biblioteca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760107,
					"content": "Talvez no fundo do Lago de Sidra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "Então essa é a arquitetura aqui, impressionante... Espera, não, não importa como Paimon pense sobre isso, não pode ser possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760111,
					"content": "Hmm... Pena que a Lisa está de folga hoje, senão poderíamos perguntar a ela. Mas já que estamos aqui, parece que não tem nenhum perigo, que tal dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760112,
					"content": "Sempre que você chega a um novo lugar, explore livremente! Esse é o segredo para se tornar uma boa guia, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760113,
					"content": "#{NICKNAME}，Olha, olha! É um boneco de Lobinho adorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760114,
					"content": "Que fofinho, deve ser muito bom de tocar! Paimon não sabe quem deixou isso aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760115,
					"content": "Quem sabe ele é o verdadeiro dono deste quarto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "#\"Aaaaauuu! Viajante tol{M#o}{F#a}! Como ousa entrar nessa fortaleza da destruição sem convite?! Prepare-se para ser devorad{M#o vivo}{F#a viva}!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760120,
					"content": "...Melhor não mexer com ele por enquanto. Esse quarto é bem grande, que tal explorarmos outros lugares?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760117,
					"content": "Pode ser o guardião do quarto misterioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "Mesmo sendo o guardião, está aí dormindo e roncando no sofá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760119,
					"content": "\"Zzz... Se não vejo perigo, significa que não há perigo. Zzz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760109,
					"content": "Talvez tenhamos sido transportados para outro mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "Que mundo seria esse?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
