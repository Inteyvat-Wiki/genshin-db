			"dialogs": [
				{
					"id": 732562701,
					"content": "É bem como as anotações diziam... Hmm? Você já voltou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562702,
					"content": "Mas ao julgar pela sua aparência, você deve ter encontrado todos os Blocos de Energia que precisamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "Já verifiquei esses Núcleos Energéticos... Estão bem preservados, agora só precisamos instalar os Blocos de Energia neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Nasejuna"
				},
				{
