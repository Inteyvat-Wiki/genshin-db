					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562401,
					"content": "#Ah, como esperado da grande emissária e {M#seu}{F#sua} Yasnapati. Nem as máquinas Dahri ou as criaturas de Dev foram capazes de te parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562402,
					"content": "Hã? Quando você chegou aqui, Nasejuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "Oras, eu estava assistindo suas incríveis batalhas às escondidas, e oh, que belo! Então, quando vi que estavam com a Grande Canção em mãos, eu corri para me encontrar com vocês, é claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562404,
					"content": "Bom trabalho, todos vocês. E enquanto estamos nesse assunto, talvez você queira me dar a Grande Canção de Khvarena para que eu possa guardá-la? Digo, bem, pode ser... Como posso dizer isso... pode ser que me dê uma sensação de participação em nosso grande trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562405,
					"content": "Mas você não fez muito desde o início, e de qualquer forma, Zurvan disse que não deveríamos entregar a Grande Canção de Khvarena assim de qualquer jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Oh, não diga isso. Quero dizer, eu fiz tanta pesquisa sobre elas! Tenho certeza de que eu examinar um pouco será de grande ajuda mais tarde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562407,
					"content": "Por exemplo, podemos descobrir o motivo dessas Grandes Canções de Khvarena terem sido escondidas nessas ruínas, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562408,
					"content": "Não é hora de histórias, Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Isso mesmo! Precisamos ir para o próximo lugar onde podemos encontrar o Grande Khvarena, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Você pode contar suas histórias novamente depois que tivermos conseguido todas, Nasejuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Bem... tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
