			"dialogs": [
				{
					"id": 732560601,
					"content": "Parece que finalmente chegamos ao coração destas ruínas. Agora, como eu sou quem mais pesquisou sobre as ruínas de Dahri, permitam-me contar tudo sobre este lugar.",
					"roleType": "TALK_ROLE_NPC",
