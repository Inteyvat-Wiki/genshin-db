					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Hã? Eu não estava esperando por isso. Será que há um problema em algum outro lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "Parece que precisamos dar uma olhada no centro de controle onde estão os relés. O que é bom, é no caminho para a área de experimentos também.",
