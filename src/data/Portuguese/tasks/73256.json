			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "#Grande Emissária e {M#seu}{F#sua} honorável Yasnapati, temo que minha companhia termina aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "Qual é o problema dessa vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Segundo os textos, o caminho adiante é cheio de perigos que nenhum mortal comum poderia suportar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Quando entrarmos, estaremos na área de experimentos que o povo Dahri usava para testar suas máquinas. Existe até mesmo um protótipo não concluído de uma máquina gigante entre elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "Os registros Dahri das minhas anotações dizem que este lugar foi fortificado para suportar o ataque de monstros, mesmo que eu não veja muita utilidade para tal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Estranho, não é? Por que o povo Dahri, que ativou o desastre da Impureza, criou máquinas para combater monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Além disso, agora que ativamos os sistemas de controle destas ruínas, os mecanismos de defesa da área de experimentos também devem ter sido ativados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "A Grande Canção de Khvarena que estamos procurando deve estar dentro daquele Golem. Embora eu esteja frustrado, suspeito que isso seja fácil para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Por favor, permitam-me que eu aguarde pelo seu retorno aqui, espero que consigamos obter toda a Grande Canção de Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "Bem, você realmente é só um humano. Um pedido destes é, de fato, aceitável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Com sua permissão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Bem, acho que Nasejuna escorregou no último momento. Ainda assim, Paimon está mais feliz agora que vocês não vão ficar mais discutindo por um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7325624,
			"completionStepIds": [
				7325624
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
