				{
					"id": 732562005,
					"content": "Deve ser porque as modificações não incluíam desmontar os dispositivos originais. Esta descoberta nos ajudou e muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "#Neste caso, {M#meu}{F#minha} Yasnapati, a honra de operar este canhão deve ser sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
		{
			"id": 7325623,
			"completionStepIds": [
				7325623
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325623",
