			"dialogs": [
				{
					"id": 732561201,
					"content": "Como eu imaginava. O problema está nestes relés. A energia dos Núcleos Energéticos não está chegando até eles. Precisamos encontrar um modo de conectá-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "E estes relés foram todos selados em cristal... Já que estas ruínas não usam da Impureza como fonte de energia, não deveria ter chamado a atenção de Khvarena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "A única explicação é que isto foi selado intencionalmente por alguém com a habilidade de usar Khvarena. Mas por que fariam isso? O que estão tentando esconder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Bem, suponho que isso pode ser discutido depois. Agora precisamos usar o poder de Khvarena para remover estes Cristais Cinzas que formaram os selos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Deve haver um Pavio Farr contendo o poder de Khvarena. Poderosa Emissária, você pode sentir também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Hmmm... Hunf. Mas é claro! Você está duvidando dos meus poderes majestosos de Guardiã do Florescimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "De modo algum, eu jamais me atreveria! Por favor, grande Emissária, guie-nos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Só precisamos encontrar o Pavio Farr, remover o Cristal Cinza e usar o Misturador para conectar estes relés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
