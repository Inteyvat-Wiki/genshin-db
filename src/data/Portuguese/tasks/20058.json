				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "O que você quer fazer lá em cima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "A Tia Grace disse que se você quiser fazer algo secreto, você apenas precisa dizer a um dandelion e jogá-lo ao vento. O Arconte Anemo entregará as sementes de dandelion para a pessoa que você quer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "E quanto mais alto você jogasse ao vento, mais rapidamente a sua mensagem chegaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Naquela vez, a Glory se aventurou em escalar até o topo de uma estátua e jogou algumas sementes de Dandelion ao vento para ele. Apenas alguns dias depois, Godwin respondeu com uma carta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Eu tenho um segredo para contar ao papai, e já tenho uma Dandelion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Mas a Tia Grace não me deixa fazer isso. Ela disse que eu posso voltar e viver com o pai quando eu crescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "O que eu posso fazer para crescer mais rápido? Na verdade, estou me esforçando, mas ainda sou muito baixa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Hum... Eu vejo você sempre voando pela cidade. Você poderia me ensinar? Como você faz isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Hehe, eu vou ficar só olhando. Tenho certeza de que isso posso fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "Você quer voar comigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "De jeito nenhum! A Tia Grace ficaria furiosa se me vesse fazendo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
