					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Oh... Nora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Você está cuidando dela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Sim, por algumas razões sua mãe está... longe de casa. Ao mesmo tempo, eu estou cuidando dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Eu também cuido de outras crianças que precisam de cuidado. Faz parte do meu trabalho como freira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "Parece de repente ganhei vários filhos. Eles são boas crianças, e eles se dão bem com a Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Timmie, a pessoa da qual eu cuidei por mais tempo. Ele começou a me chamar de mamãe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Conte me sobre o pai da Glory.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Patton é seu pai. Seu vício pela bebida causou grandes problemas dentro de casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "A Igreja e os Cavaleiros de Favonius deram a ele diversas advertências, mas ele nunca mudou. No final, Diluc teve que intervir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
