			"dialogs": [
				{
					"id": 400740301,
					"content": "Que estrutura espetacular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740302,
					"content": "Uau, nunca vi um lugar assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740303,
					"content": "Ei, Mona, sua miragem é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740304,
					"content": "Embora não seja grandiosa como o Reino da Noite Eterna, devo admitir que é um reino impressionante, Senhorita Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740305,
					"content": "(Ufa, pelo menos não está mostrando eu levando um sermão da velhota. Ainda bem...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740306,
					"content": "Bem, o que mais vocês esperariam da miragem de uma astróloga genial como eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740307,
					"content": "Bem, vamos começar!",
					"roleType": "TALK_ROLE_NPC",
