			"dialogs": [
				{
					"id": 400740201,
					"content": "De acordo com meu Hydroprofetizador, chegamos na miragem. Bem, vamos procurar a entrada primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740202,
					"content": "Será aquilo ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740203,
					"content": "Hã, parece uma piscina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740204,
					"content": "Hã, não vamos ter que nadar para entrar, vamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740206,
					"content": "Esperem, alguém aqui não sabe nadar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740207,
					"content": "Não, não acho que esse é o verdadeiro problema aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740208,
					"content": "Ahaha, está com medo? Está bem, eu vou primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740209,
					"content": "E lá vai ela! Ela se exibir com suas habilidades de nado perfeitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740210,
					"content": "Ahem! Por favor, lembre-se de manter o decoro, minha Princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740211,
					"content": "Oh, certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740212,
					"content": "Até daqui a pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740213,
					"content": "Uau, Mona mergulhou na piscina e desapareceu! Vamos alcançá-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
