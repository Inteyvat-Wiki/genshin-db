					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Olá, todos. Sou Tian Língua de Ferro, aqui com um letreiro oficial para o Esplendoroso Acampamento de Batalha de Besouros do Arataki. Ele também serve como alvará para realizar seu evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662002,
					"content": "Eita! Isso é para ser... Joga-boi e Cajado Carmesim? Tá exagerado demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Oh, legal! Infelizmente, não é um trabalho original meu... mas olha esse design! Olha essas linhas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "É tão legal! É épico! Captura perfeitamente o quão incrível sou como um lutador de besouros profissional no calor da batalha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Cara! ...Espera, não, como que eles chamam os estranhos nessa parte do mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "Talvez... \"escudeiro\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716662007,
					"content": "Isso ai! Escudeiro Tian, sua arte é incrível! Palavras não descrevem a gratidão da Gangue Arataki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "Você pode deixar o \"escudeiro\" de lado, Don Arataki. E também, não sou um artista — apenas um contador de histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662009,
					"content": "Essa arte promocional foi feita pela jovem no Ministério dos Assuntos Civis. Yanfei cuida muito dela, então quando ela soube do seu evento, ela se ofereceu para contribuir com peças artísticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662010,
					"content": "Ohh, então isso foi tudo da parte da Yanfei! Cara, ela pensou em tudo mesmo hein... Isso é exatamente o que a gente precisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Jovem Grande Mestre Hanakado aqui me diz que seu acampamento é um programa de treinamento ambicioso que pode mudar o futuro da Batalha de Besouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662012,
					"content": "Eu não sou um lutador de besouros, porém ouvi muito sobre isso, e sempre quis tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662013,
					"content": "Quem sabe, isso pode me dar a inspiração para uma ótima nova história para contar lá na vizinhança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662014,
					"content": "A luta de besouros é algo para o qual você precisa ter uma afinidade natural. Pegue Melão de Lavanda Destruidora do Céu, por exemplo: Ela batalhou com grande destreza em sua primeira vez, após apenas uma breve demonstração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716662015,
					"content": "Assim que Tian Escudeiro tiver entendido o básico da Batalha de Besouros e o apelo dela, podemos conseguir muita publicidade grátis das histórias dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716662016,
					"content": "Cara! Isso seria incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Beleza, Escoveiro! Escoteiro! Escopeiro! ESCUDEIRO! Ahehehehehem... Hmm... q-que vença o melhor homem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 7166621,
