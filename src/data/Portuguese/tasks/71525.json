				]
			},
			"dialogs": [
				{
					"id": 716662101,
					"content": "Maravilhoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662102,
					"content": "Percebo que a Gangue Arataki transformou a Batalha de Besouros em um esporte ferozmente competitivo de alta adrenalina. Sim, há os rudimentos de uma bela história aqui, para ser contada repetidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662103,
					"content": "Ótimo duelar com você, Escudeiro Tian! Show de booooooooola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "A frase é \"O prazer é todo meu,\" Rei Oni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716662105,
					"content": "Ah, detalhes, detalhes! O meu ponto é... obrigado pelo apoio ao nosso acampamento de treinamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Também estendo minha gratidão a você, Don Arataki. Pretendo ficar aqui e assistir um pouco mais para enriquecer minha escrita. Por favor, não se incomode comigo — apenas finja que não estou aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Escute à Próxima Análise"
				},
				{
					"id": 716662107,
					"content": "Meu chegado, eu nunca lutei contra alguém tão... erudito antes! Minha mente tá zumbindo de tanta palavra difícil. Como é o nome desse sentimento mesmo? Ah, é — aprendizado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "Parece que o Esplendoroso Acampamento de Batalha de Besouros do Arataki está começando bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
