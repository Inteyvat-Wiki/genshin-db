					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "Obrigada. A Biblioteca Nanwen pode ficar aberta até agora graças ao constante apoio de nossos mais fiéis clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050605,
					"content": "Aliás, esses são clientes de costume que amam leitura do fundo do coração! Eles devem ficar muito felizes quando receberem os livros bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050606,
					"content": "Viajante, obrigada pela ajuda, por favor, aceite esta recompensa.",
