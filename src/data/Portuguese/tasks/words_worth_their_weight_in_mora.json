					"content": "Esse é o livro que Jifang lhe enviou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Esse livro é \"Rex Incógnito (IV)\"? Lembro de ter pedido ele há muito tempo, como demorou tanto assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Dean Burguês"
				},
				{
					"id": 718050404,
					"content": "Deixe-me dar uma olhada... Uh? É a edição mais recente, não é à toa que só chegou agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Dean Burguês"
				},
				{
					"id": 718050405,
					"content": "Creio que devido ao número de clientes, Jifang esqueceu de mandar esses livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Dean Burguês"
				},
				{
					"id": 718050406,
					"content": "Acho que vou ficar com esse livro. Obrigado, jovem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dean Burguês"
				}
			]
