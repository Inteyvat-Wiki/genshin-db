					"content": "Esse é o livro que Jifang lhe enviou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Eu me lembrei, anteriormente fui à Biblioteca Wanwen e pedi uma cópia do Versos de Equilíbrio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Tio Tian"
				},
				{
					"id": 718050504,
					"content": "Certo! Esse é o livro que eu quero! Hehe, pensava que a Jifang já havia se esquecido, uma vez que está bastante movimentado agora na livraria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Tio Tian"
				},
				{
					"id": 718050505,
					"content": "Ainda bem que você me entregou... Está com uma boa embalagem! Deve ser feita pela Jifang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Tio Tian"
				},
				{
					"id": 718050506,
					"content": "Obrigado, jovem, vou ficar com este livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tio Tian"
				}
			]
		},
