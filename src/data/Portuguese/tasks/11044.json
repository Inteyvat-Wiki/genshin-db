					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Hmm, um resultado médio para um prato fino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "Sobre a hipótese da propagação, nada mudou. Parece que a comida apresenta as mesmas características em seu mundo e no nosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "A menos que... Será que as leis naturais deste mundo estão limitando suas habilidades únicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Apenas não sabemos como canalizar a Energia Elemental para a comida. É um pouco mais complicado do que adicionar ervas e especiarias, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "Não se preocupe, pelo menos aproveitamos um pouco da comida, não precisa ficar desanimada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "E aqui está a sua porção, aproveite! Posso embalar se você quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Oba, obrigada! Que bom que você estava prestando atenção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Você é o novo favorito de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "#Percebo que vocês são {M#bons amigos}{F#boas amigas}. Paimon estava de olho em você e sua segurança durante todo o experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "Não que Paimon pudesse fazer muita coisa se algo desse errado, mas mesmo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "Ei! Você estava sendo legal um segundo atrás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Mas você tem receitas saborosas, então Paimon te perdoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "#E você está certo, somos {M#bons amigos}{F#boas amigas}. Você também tem bons amigos, certo? Bons alunos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "Err... Sim! Eu também tenho sorte, suponho. De qualquer forma, vamos para o próximo experimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Existem todos os tipos de itens alquímicos aqui, mantê-los em seu devido lugar é um desafio na melhor das hipóteses. Há algum tempo, tive a infelicidade de perder um lote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Consegui recuperar a maioria, mas dois frascos sumiram: extrato elemental de Borboleta de Cristal Anemo e pó de Hypostasis Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Paimon mal acabou de comer e você quer que a gente saia novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Não se preocupe se você não conseguir localizá-los. Pretendia substituí-los de qualquer forma, embora encontrá-los poupasse o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Se você tivesse, digamos, um \"superpoder\", como visão noturna ou detecção vibratória, os itens perdidos seriam desnecessários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Devo ter deixado cair em algum lugar na área onde você estava agora há pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "Então... Acho melhor darmos uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Deve haver alguns traços elementais nos itens perdidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Oh sim! Você pode usar a Visão Elemental!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Não é sempre que Paimon recebe tanta atenção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		},
