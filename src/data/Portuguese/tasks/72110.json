			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Por que deixei o dojo para me tornar um guia para a Madame Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100102,
					"content": "Yanagiha e Okazaki, assim como Mifune... Por que eles me deixaram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "...Agora, a lâmina de Iwakura Kouin é a única coisa que falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "A ancestral \"Hakuen Michimitsu Amenoma\" da família Iwakura? Você se lembra de quando foi adotado com Kunihiko? Enquanto o Mestre Eiin estava distraído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Nós já entramos. Não há necessidade de incomodar o mestre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Mas, Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "Quando se pesa o afeto contra a integridade em uma balança, um verdadeiro espadachim só pode percorrer o caminho da integridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Já que o Mestre disse, isso significa que ele não está disposto a nos expulsar, mas não tem outra escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "É claro que ele não está disposto, mas como já decidiu se tornar a espada da Shogun, de acordo com o Decreto de Caça à Visão, ele só pode...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Só podemos escolher nosso próprio caminho da integridade. Afinal de contas, um verdadeiro espadachim só pode percorrer o caminho da integridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Mas a própria integridade do Mestre foi derrotada no final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "É isso mesmo. Não só Kunihihiko, mas também os outros, inclusive Iwakura Kouin, devemos vingá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Tal é a integridade dos discípulos expulsos como nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Esse também deve ser a bênção do Mestre. O primeiro inimigo acaba de chegar até nós dessa maneira",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Você está certo. Você deve ser {M#o}{F#a} {NICKNAME}. Já ouvi falar de sua história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "#No mundo dos espadachins, somente o sangue pode purificar o sangue. Presumo que você deve estar preparad{M#o}{F#a} contra Menkyo Kaiden da Técnica Iwakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Kouzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Por que deixei o dojo para me tornar um guia para a Madame Kujou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100302,
					"content": "Yanagiha e Okazaki, assim como Mifune... Por que eles me deixaram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100303,
					"content": "Eu já fiz uma visita aos discípulos de Iwakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100305,
					"content": "Ainda há pessoas que afirmam ser da Iwakura? Afinal de contas, o mestre deles era tão incompetente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100306,
					"content": "Eu sou Iwakura Kouzou, o instrutor de espadas daqui. E você é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100307,
					"content": "#Meu nome é {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba... Vocês viram eles? E os irmãos Okazaki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100309,
					"content": "E também Katayama. Eles querem inventar um nome para este duelo antes dele começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100310,
					"content": "Porque \"Se eu me tornar um mestre espadachim no futuro, todos esses duelos poderão se tornar em histórias escritas\" Hahaha, que besteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100311,
					"content": "Certo, e também Shimada, que a partir da era Nagatane até a era Kouin ainda não podia ir além de Shoden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100312,
					"content": "Eles tiveram que fugir porque não conseguiam compreender o poder do Decreto de Caça à Visão da Toda-Poderosa Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100313,
					"content": "Sinto falta dos bons e velhos tempos de ensinar a empunhar uma espada. Por que eu fechei o dojo e me alistei no exército?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}, como estão suas habilidades?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100315,
					"content": "Me desculpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "É mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100318,
					"content": "#Então, {NICKNAME}, quem é seu mestre? É o Domon? Ou o Shousen? Ou talvez a própria Narukami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100319,
					"content": "Mais como por conta própria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Então é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100321,
					"content": "Parece que a Técnica Iwakura declinou em minhas mãos. Nenhum dos meus estudantes foi capaz de derrotar o espadachim autodidata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "É mesmo? Entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100324,
					"content": "Seja qual for sua escola de técnica de espada, isso não importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100325,
					"content": "Parece que a Técnica Iwakura declinou em minhas mãos. Nenhum dos meus estudantes foi capaz de derrotar aquela pessoa que não revela sua escola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100326,
					"content": "Sou apenas um incompetente mestre da Arte Iwakura. Como espadachim, eles me chamam de Iwakura Kouin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100327,
					"content": "Embora eu tenha memorizado a essência da técnica da lâmina secreta, e minha Visão tenha sido rendida à Toda-Poderosa Shogun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100328,
					"content": "...Mas, se tratando de vingança para meus discípulos que não suportaram ver minha degradação e acabaram trilhando o caminho de demônios ingratos,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100329,
					"content": "no entanto, foram incompetentes e perderam para você, então eu ainda tenho um pouco dessa paixão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100330,
					"content": "Este lugar é muito pequeno. Acho que você não será capaz de exibir suas habilidades com a espada. Siga-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Kouzou"
				},
				{
					"id": 721100316,
					"content": "Eu aprendi bastante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				}
			]
		}
	]
}