			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "Viajante, por favor espere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Err... desculpe, mas tenho que pedir um favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Como você sabe, eu ainda não melhorei no meu estudo de alquimia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "Se eu continuar da mesma maneira, não vou ter nenhum melhoramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Você está se mudando para bioalquimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Você está voltando para a origem desta arte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Então, eu decidi que ia encontrar um novo foco com um novo método, e experimentar algo que nunca foi feito antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "Bioalquimia? Não é nada de novo. Já tem algumas pessoas que estão investigando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "Alquimia antiga? Não, ainda não sou capaz para isto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Hmmm. Você sabe qual é a essência da alquimia? São os elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Por certas razões, normalmente se usa material infundido da energia elemental em vez de mera energia elemental mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Quando se usa este material, produz-se impurezas no processo de transmutação, que faz com que a reação elemental menos efetiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Para compensar, devemos usar quantidades maiores de materiais elementais. Mesmo assim, ainda precisamos de observar com muita atenção durante o processo de transmutação, pois as impurezas podem facilmente arruinar o resultado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Infelizmente, tudo isso produz custos extras para aqueles que estão sem Visões e que desejam realizar alquimia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "O maior problema é que os materiais infundidos com energia elemental são super caros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Normalmente no final do trabalho, o alquimista sempre percebe que a conta é mais surpreendente do que o resultado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "Também não tenho Visões.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "O que precisa de mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "*Suspiro* Talvez isso explique porquê não tenho muito progresso na alquimia. A barreira de entrada é mesmo muito alta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "Mas, eu ouvi dizer que você pode manipular a energia elemental, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Você não tem uma Visão, mas você pode manipular a energia elemental, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "Olhe, eu consegui inventar um novo forno de alquimia, que o chamo de <color=#00E1FFFF>Crisol Elemental</color>, e a ideia por trás é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Bom. Basicamente é um recipiente que pode conter energia elemental pura e gerar as reações elementais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Com sorte, talvez este Crisol Elemental possa aprimorar o meu nível de alquimia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "Agora tudo está pronto, só me falta uma pessoa com capacidade de manipular a energia elemental pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "Se você estiver disposta, por favor me encontre no <color=#00E1FFFF>Templo do Vento Milenar</color>, onde tudo já está instalado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "Espero que desta vez a minha alquimia possa progredir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
