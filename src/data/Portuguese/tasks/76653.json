			"dialogs": [
				{
					"id": 766530201,
					"content": "Onde foi que eu errei...? Se eu apenas tivesse mais conhecimento teórico.....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Certo, não precisa confirmar esse pedido... Ginette, uma engenheira fontainense, hein? De todos os pedidos que recebi, esse foi o mais interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Até que enfim vocês chegaram! Então ainda há esperança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "Oi, oi! Somos assistentes da Aino... Ou, bem, a Paimon acha que dá pra chamar a gente assim. Do que você precisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Ela criou um tipo de robô que consegue usar kuuvahki pra se comunicar a longas distâncias... o que parece super divertido! Mas ele tá dando um monte de defeitos, então ela quer que eu ajude a resolver os problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "Tenho vergonha de admitir, mas minha curiosidade não levou a lugar nenhum. No fim das contas, tudo se resume à prática...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Não parece tão difícil... Deixa com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Isso é meio constrangedor, mas... Eu gostaria de modificar meu pedido. Enquanto esperava sua resposta, eu... Bem, acabei causando outra confusão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "Fiquei curiosa pra saber se uma mudança de ambiente poderia resolver o problema. Então fiz mais testes em áreas com diferentes concentrações de kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "...Mas os defeitos continuaram acontecendo, e acabei perdendo aqueles robôs. Então... além da depuração combinada... Vocês poderiam me ajudar a recuperar os robôs também...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Você perdeu os robôs? Todos eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Se precisar que eu compense com um pagamento extra, vou dar um jeito, prometo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Hmm... Mas deve haver várias maneiras de rastreá-los. Como os robôs são todos alimentados por kuuvahki, eles devem deixar Resquícios de Kuuvahki enquanto se movem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Vou preparar um dispositivo especial para você. Depois que usá-lo para coletar Resquícios de Kuuvahki suficientes, será possível rastrear o robô que os deixou para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Hmm-hmm... Bem, isso parece divertido! E já que parece, não vou pedir pagamento extra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Sério mesmo! Muito obrigada, muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}