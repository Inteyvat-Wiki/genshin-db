			"dialogs": [
				{
					"id": 250220501,
					"content": "Essa aqui tem um cheiro muito bom. Um aroma bem refrescante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220504,
					"content": "Ha'ola? Você... Ora ora, olha só isso! Ele foi e comeu tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220505,
					"content": "(Ha'ola engole a Qingxin de uma vez, então pisca para você...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220506,
					"content": "Ha'ola de repente se vira e come metade da tigela de frutas perto dele, tudo de uma vez...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "O apetite de Ha'ola ter voltado de repente... Como isso aconteceu? Será que foi tudo graças a essa tal de Qingxin mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220508,
					"content": "Eu... Eu preciso ir conversar com o médico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				}
			]
