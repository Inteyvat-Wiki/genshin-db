				{
					"id": 250220301,
					"content": "Agora essa é uma bela flor. Com um nome legal também... Ha'ola, quer dar uma beliscada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220304,
					"content": "Rawr, rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220305,
					"content": "(Ha'ola mastiga cuidadosamente, como se estivesse saboreando o gosto das pétalas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220306,
					"content": "R-Rwarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220307,
					"content": "Ah! Pelo que parece, diria que ele gosta bastante. Mas apenas flores não são suficientes para encher essa barriga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220308,
					"content": "Além disso, essa flor não parece ser muito barata... Enfim, é melhor eu anotar isso primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220309,
					"content": "Como você transforma flores em comida? Ah, talvez a gente possa... misturá-las em algum tipo de bolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				}
			]
		},
