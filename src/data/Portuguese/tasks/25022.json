			"dialogs": [
				{
					"id": 250220101,
					"content": "Hum... Parece que vou ter que trocar a receita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220102,
					"content": "Rwar! Rawrrrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220103,
					"content": "Outra ideia brilhante? Pode falar, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "R-Rwarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220107,
					"content": "Normalmente, Ha'ola consegue terminar uma tigela inteira de fruta, e quando acaba, ele brinca o dia todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220108,
					"content": "Mas agora ele só come meia tigela e só fica sentado aí, sem mexer um músculo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220109,
					"content": "Eu estava preocupado de que ele pudesse tá doente, então fui encontrar o médico no meio da noite para pedir ajuda a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220110,
					"content": "Nós dois passamos a noite toda tentando descobrir o que tinha de errado com ele, só para perceber que ele não estava doente, só... é exigente com comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220111,
					"content": "O médico disse que a melhor solução seria encontrar uma nova receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220112,
					"content": "Ele também disse que eu poderia tentar tocar um pouco de música enquanto o Ha'ola come. Talvez isso ajude a aumentar o apetite de Ha'ola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220113,
					"content": "Parece uma ótima ideia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Hahaha... Pois é, na época eu realmente encontrei um disco, e o Ha'ola gostou bastante da música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220116,
					"content": "Mas fomos forçados a abandonar a ideia... Quando Ha'ola pulou e comeu metade do disco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220117,
					"content": "#Não pareça tão chocad{M#o}{F#a}. Do ponto de vista do Tepetlissauro, um disco feito de Obsidiana e Flogisto é um lanche delicioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220118,
					"content": "Agora, minha única opção é ir até os Descendentes das Copas e ver se alguém lá pode me ajudar a encontrar alguns novos ingredientes para experimentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220119,
					"content": "Vou encontrar alguns ingredientes para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Você me ajudaria mesmo? Seria incrível! Meus amigos dos Descendentes só podem procurar dentro de Natlan, mas você poderia conseguir ingredientes de todo lugar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220124,
					"content": "Espera, me deixa dar uma olhada na lista de ingredientes que o médico recomendou. Aquele cara sabe muito, até sobre coisas de fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220125,
					"content": "Uh... Diz que podemos tentar <color=#00E1FFFF>\"Rosas Arco-Íris\", \"Melões de Lavanda\"</color> e <color=#00E1FFFF>\"Qingxin\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220122,
					"content": "Muito obrigado por fazer isso. Se você encontrar alguns ingredientes únicos, pode trazer direto para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220123,
					"content": "Rrarr, rrarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220120,
					"content": "Ninguém melhor do que eu em achar ingredientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Não fazia ideia que existiam discos assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Fazer carinho em Ha'ola.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "R-Rwarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Ha'ola"
				}
			]
		},
