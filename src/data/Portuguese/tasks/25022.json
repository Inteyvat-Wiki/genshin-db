					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220405,
					"content": "(Ha'ola começa a mastigar e, de repente, já se foi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220406,
					"content": "Rwar! Rawrrrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220407,
					"content": "Hahaha, rápido como um relâmpago. Você deve ter gostado muito disso, hein, rapaz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250220408,
					"content": "Rwarr, rawrrr! Rwarrr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250220409,
					"content": "Certo! Daqui a pouco vou procurar alguém para perguntar onde encontrar comerciantes de Inazuma. Preciso comprar mais alguns Melões de Lavanda...",
					"roleType": "TALK_ROLE_NPC",
