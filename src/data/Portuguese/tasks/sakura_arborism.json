						],
						"stepId": 7212314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "Como está a situação com a Sakura do Trovão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230402,
					"content": "Os \"probleminhas\" foram resolvidos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Maravilhoso, isso irá pelo menos estabilizar a condição da Sakura do Trovão. Tenho certeza de que a Madame Miko também ficará aliviada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "Como esses vigaristas ousam roubar descaradamente o poder da Sakura do Trovão em seu próprio benefício? Suas ações são imperdoáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "Você também mencionou que encontrou um cristal de energia criado com o poder da Sakura do Trovão no acampamento dos Ladrões de Tesouro? Precisa ser resolvido o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "#Você já me ajudou bastante, então não poderia pedir que cuidasse disso sozinh{M#o}{F#a} de novo. Vou participar desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "Não há tempo a perder. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
