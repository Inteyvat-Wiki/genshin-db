			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Hmph, então é você, sua espertinha - se metendo no caminho da nossa fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "Fortuna! Seus malditos. Como ousam encostar na Sakura do Trovão. A senhora Miko não vai deixá-los sair tão facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Fala demais, mas você ainda pode fazer isso quando perceber quem você irritou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "#Mestre, aquel{M#e}{F#a} Viajante ali é quem tem se intrometido em seu caminho. O trato está cancelado se você não nos ajudar aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Hehe. Você vai agir feito durão na minha frente, seu fracote?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soldado Fatui"
				}
			]
		},
		{
