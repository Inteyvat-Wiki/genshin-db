			"dialogs": [
				{
					"id": 721230602,
					"content": "Urg! Que azar, esbarrar neste tipo de oposição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "Seus descarados. Conspirando com os Fatui... O Grande Narukami vai acabar com todos vocês, mais cedo ou mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "Não tente esse blefe comigo! De jeito nenhum vou deixar você se meter nos meus negócios e ainda quer me envolver nisso! Eu ainda tenho uma carta na manga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
