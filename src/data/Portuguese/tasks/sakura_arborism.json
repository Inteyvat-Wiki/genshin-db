			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "Pa-Pare de me perseguir, por favor... Já fizemos essa volta três vez, mal posso andar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "Seus infelizes, vocês se uniram aos forasteiros para lucrar! Não haverá misericórdia para vocês, mesmo se fizermos mais dez voltas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "Ufa... Por esse seu olhar tranquilo, Viajante, presumo então que você tenha lidado com nosso pequeno problema. Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "O poder da Sakura do Trovão não pode cair nas mãos desta escória, muito menos ser entregue aos Fatui às escondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "É difícil dizer o que os Fatui planejaram, mas já que capturamos este canalha fedorento, com certeza vou obter algumas respostas dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Deixe a limpeza por minha conta. As posições do Exército da Shogun são bem familiares para mim. Este cara não vai escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
