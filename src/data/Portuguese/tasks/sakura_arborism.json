				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "Por favor, não me mate! Eu não tenho nada a ver com os problemas da Sakura do Trovão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "Como que você sabe que nós viemos por causa da Sakura do Trovão? Você tem cara de que está com sua consciência pesando por algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Paimon aposta que você conseguiu essa coisinha estilo Hypostasis Electro por algum negócio sujo, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "O que... O que vocês tem a ver com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "#Fui enviad{F#a}{M#o} para cá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "#Sim, nós fomos enviad{F#as}{M#os} para fazer justiça aqui! Afinal de contas, o que é que os Ladrões de Tesouros estão fazendo com a Sakura do Trovão? De onde essa coisa daqui veio? Responda tudo logo, e honestamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "#Se você não responder, haha, a espada d{F#a}{M#o} Viajante é muito perigosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "Eu falo! Eu falo! Ninguém cuida dessas árvores daqui. Eu trouxe meus companheiros aqui para pegarmos um pouco do poder dela e ganharmos dinheiro com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "Eu tinha um ótimo comprador que estava interessado na Sakura do Trovão, e ele até mesmo forneceu as ferramentas para extrairmos o poder dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "Desde que tivéssemos feito como o comprador falou, abrindo um buraco na Sakura do Trovão e usando as ferramentas para extrair seu poder. Era para ser simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Depois colocaríamos o poder nesse cristal daqui, e o valor dele seria igual ao tesouro de três Comissões Tenryou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "O nosso comprador ofereceu uma recompensa enorme. Tão grande que uma pessoa comum como você não poderia sequer gastar durante toda sua vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "Se você me soltar, eu posso dividir ela com você. Uma parte para você, nove para mim, o que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Muito pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "O quê? Eu estou querendo lhes dar uma forma de ganhar a vida. Só espere meu comprador chegar, vocês chorarão e pedirão para mim, Hideaki, por perdão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "Sua atitude também é muito arrogante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Veja aqui, sua coisinha pequena, quem é arrogante? Meus companheiros virão me procurar logo para me salvar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "#Mesmo que vocês chamem cem pessoas, sequer tocarão em um fio de cabelo meu, {F#a}{M#o} Viajante aqui botará todos vocês para correr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Yamada, essa coisinha pequena está dizendo que vocês não podem feri-la, e você ainda assim não faz nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "Yamada? Quem é esse... Oh não, Viajante, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "Hã? Mas não tem ninguém aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Nos seus sonhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Você encontrou algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "Sobre Hideaki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Então é isso que está acontecendo... Mas os Ladrões de Tesouro são meros bandidos. Eles realmente poderiam causar tantos estragos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "Eu acho que a Sakura do Trovão está murchando por outros motivos... Tenho minhas suspeitas, mas não posso afirmar nada com certeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "O que você quer dizer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Aqui é Kannazuka, onde nem a fé de Inazuma e nem a de Sangonomiya têm qualquer influência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Desde quando o Decreto de Caça à Visão foi promulgado, batalhas comumente ocorrem aqui entre o exército da Shogun e os rebeldes. Acho que nenhum lado se importa se a Sakura do Trovão acabar sofrendo dano colateral da guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "Para citar a Madame Miko, \"Homenagens e elogios são tudo que estes tipos de militares se preocupam\". Eles não vão dar ouvidos à razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "Estávamos bem preparados para isso, mas não esperávamos que a Sakura do Trovão estivesse em uma condição tão terrível quanto essa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "De qualquer forma, aqui e agora, a questão mais urgente é expulsar aqueles Ladrões de Tesouro. Viajante, posso contar com você para fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "#Por favor, não seja descuidad{M#o}{F#a}. O fato de a Sakura do Trovão estar enfraquecida torna a situação muito perigosa. Afinal, essas árvores servem para reprimir aquilo que está abaixo delas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "Ah, eu falei demais... P-Por favor, esqueça o que eu disse. Resumindo, tenha muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "Também preciso de um tempo para analisar minhas descobertas. Uma das principais dúvidas é: quem está liderando os Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "Este caso está se tornando cada vez mais complicado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Entendo perfeitamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "Não é tão simples quanto você pensa. A Sakura do Trovão está enfraquecida e isso torna a situação muito perigosa. Afinal, essas árvores servem para reprimir aquilo que está abaixo delas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212314",
