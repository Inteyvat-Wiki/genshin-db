			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "Falando nisso, você sabe onde está a Sakura do Trovão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230902,
					"content": "#...A julgar pela sua reação, acho que você não está familiarizad{M#o}{F#a} com as posições da Sakura do Trovão. Bem, você é {M#um}{F#uma} Viajante de fora. Eu assumi demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230903,
					"content": "As cinco Sakuras do Trovão não são difíceis de encontrar. Você só precisa seguir <color=#00E1FFFF>a costa oeste</color> a partir do <color=#00E1FFFF>ponto mais ao norte</color> da ilha que o Quartel Kujou está rumo ao <color=#00E1FFFF>ponto mais ao norte de Tatarasuna</color>, dessa forma, você já pode encontrar três delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230904,
					"content": "Quanto as outras duas, uma cresce na montanha ao <color=#00E1FFFF>noroeste de Tatarasuna</color> e a segunda cresce na montanha ao <color=#00E1FFFF>sudoeste</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230905,
					"content": "As coisas devem ser mais fáceis, agora que eu lhe dei as instruções. Vou deixar a questão da Sakura do Trovão para você. Por favor, tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		}
