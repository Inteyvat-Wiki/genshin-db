				{
					"id": 726940501,
					"content": "Vendendo um, consigo juntar um pouco de Mora. E para pagar minha dívida basta vender 20 mil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940502
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940502,
					"content": "Não é difícil como parece... Hmm, você tem alguma pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940503,
						726940505
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940503,
					"content": "O que você está planejando vender?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940504
					]
				},
				{
					"id": 726940504,
					"content": "Quero vender brinquedos, mas... Infelizmente os brinquedos ainda não estão em produção. Você pode voltar para vê-los quando estiverem prontos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940505,
					"content": "Não tem problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940506
					]
				},
				{
					"id": 726940506,
					"content": "Se não tem problemas então não me incomode. Estou no meio do processo de fabricação de um lote de produtos importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
