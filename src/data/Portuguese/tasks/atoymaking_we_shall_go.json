	"talks": [
		{
			"id": 7269401,
			"completionStepIds": [
				7269401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
