				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940101,
					"content": "Viajante e Paimon! Vocês chegaram bem na hora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940102,
					"content": "Bem na hora de quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940103,
					"content": "#Tenho uma missão perfeita para vocês! E estava prestes a chamá-l{M#os}{F#as} para vir aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940104,
					"content": "Uma missão perfeita para nós...? Não me diga que você quer que peguemos algo para você ou que derrotemos Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940105,
						726940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940105,
					"content": "Ou pegar lixo do telhado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				},
				{
					"id": 726940107,
					"content": "Oh, nada disso. Esta missão é mesmo perfeita para vocês, e quando digo \"perfeita\" quero dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940108,
					"content": "Essa comissão é divertida, e também possui boas recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940109,
					"content": "Generosas recompensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940110,
					"content": "Paimon ignorou tudo sobre ser divertida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940111
					]
				},
				{
					"id": 726940111,
					"content": "A-Ahm... Ser divertida também é importante! Então, sobre o que é essa comissão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940112,
					"content": "O solicitante desta comissão é um vendedor de brinquedos de Fontaine. Seu nome é Bertrand. Ele veio para Inazuma para vender brinquedos, e no momento está procurando alguém para ser seu assistente na fabricação de alguns produtos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940113,
					"content": "Ele é um homem de negócios, por isso prometeu um pagamento generoso quando solicitou esta comissão na Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940114,
					"content": "Mas no momento ele não pode deixar Ritou. Por favor, vá até ele para perguntar sobre os detalhes da comissão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 726940115,
					"content": "Certo, vamos para Ritou agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940106,
					"content": "Ou transportar alguma mercadoria estranha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940107
					]
				}
			]
		},
		{
			"id": 7269402,
			"completionStepIds": [
				7269402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269402",
							"2"
						],
						"stepId": 7269402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940201,
					"content": "Hahaha! Já tenho tudo pronto! Venderei cada brinquedo por milhares de Mora, e então com milhares deles vendidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940202,
					"content": "Poderei ganhar milhões de Mora, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940203
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940203,
					"content": "Ei, você é Bertrand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940204,
					"content": "Hein? Sim, sou eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940205
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940205,
					"content": "#Vocês {M#dois}{F#duas} ouviram falar dos meus brinquedos e vieram comprar um também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940206
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940206,
					"content": "Lamento informar, mas ainda não poderei vender nenhum brinquedo para vocês, pois a produção em massa ainda não começou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940207
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940207,
					"content": "#Mas não se preocupem, estou preparando tudo para que a linha de produção seja concluída em breve. Vocês podem se registrar e deixar um depósito se estiverem interessad{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940208
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940208,
					"content": "Espere aí! Não estamos aqui para comprar seus brinquedos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940209,
					"content": "Ah, então... Se vocês têm algo a dizer, me digam rapidamente. Não tenho tempo a perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940210
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940210,
					"content": "E seja breve, meu tempo vale ouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940211
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940211,
					"content": "Uau... Que mudança extrema em sua atitude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940212,
						726940213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940212,
					"content": "Nós viemos aqui para ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				},
				{
					"id": 726940214,
					"content": "#Ah, então vocês são {M#os}{F#as} assistentes enviad{M#os}{F#as} pela Guilda de Aventureiros! Bem-vind{M#os}{F#as}! Deviam ter me avisado quem eram antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940215
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940215,
					"content": "Sim, fui eu que publiquei essa comissão. Como devo me dirigir a vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940216
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940216,
					"content": "(Sua atitude mudou novamente...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940217,
					"content": "Paimon se chama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940218,
					"content": "E você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940219
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940219,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940220
					]
				},
				{
					"id": 726940220,
					"content": "#{NICKNAME}? Penso que já ouvi esse nome em algum lugar... Você também costumava ser {M#um bandido procurado}{F#uma bandida procurada}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940221,
						726940223
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940221,
					"content": "Mais de uma vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940222
					]
				},
				{
					"id": 726940222,
					"content": "Hmm, talvez eu tenha ouvido seu nome quando fui preso... quer dizer, quando fui convocado pela Comissão Tenryou para responder algumas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940225,
					"content": "O que raios você fez para ser preso pela Comissão Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940226,
					"content": "*Suspiro* Não foi nada de especial. Só tive um pequeno problema com o último lote de brinquedos que fabriquei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940227
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940227,
					"content": "Nada de especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940228,
					"content": "Pequeno problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940229
					]
				},
				{
					"id": 726940229,
					"content": "Hehe, os brinquedos explodiam se você ativasse o dispositivo que tinham dentro. Apenas isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940230
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940230,
					"content": "Explodiam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940231,
					"content": "Ah, não é nada sério. Ninguém se machucou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940232
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940232,
					"content": "Mas ainda assim os Doushins da Comissão Tenryou confiscaram todos os brinquedos sem pensar duas vezes... Na minha opinião, eles ainda podiam ser vendidos como bombas bonitinhas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940233
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940233,
					"content": "*Suspiro* Quando cheguei aqui, peguei emprestado um pouco de Mora da Associação de Comércio Internacional para começar meu negócio. Quem diria que eu acabaria retido em Ritou, sem autorização para entrar em outras áreas de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940234
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940234,
					"content": "Paimon acha que foi você quem provocou a situação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940235,
					"content": "Ei, espere aí! Se você deve dinheiro à Associação de Comércio Internacional, como pensa nos pagar essa comissão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940236,
					"content": "#Podem ficar tranquil{M#os}{F#as}. Não gastei todo o dinheiro que peguei emprestado. Além disso, quando puder voltar a produzir e vender brinquedos, pagarei facilmente minha dívida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940237
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940237,
					"content": "Então poderei pagar o que prometi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940238
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940238,
					"content": "... Será que vai realmente funcionar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940239,
					"content": "Não subestime o mercado de brinquedos em Inazuma! Meus brinquedos eram muito populares antes que as pessoas descobrissem que podiam explodir... E quer saber mais? Meus brinquedos se tornaram ainda mais populares depois disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940240
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940240,
					"content": "Bem, se meu plano falhar no final, pagarei minha dívida oferecendo todos os brinquedos para Kurisu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940241
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940241,
					"content": "Por favor me ajudem, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940242
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940242,
					"content": "Mas como você quer que a gente te ajude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940243,
					"content": "Bem, todos os meus brinquedos são produzidos com esta máquina que construí. Ela se chama \"Máquina Infalível de Alto Nível de Engenharia Movida a Fornalha de Segunda Geração\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940244
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940244,
					"content": "Falando em minha \"Máquina Infalível de Alto Nível de Engenharia Movida a Fornalha de Segunda Geração\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940245
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940245,
					"content": "Esse nome é muito longo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940246
					]
				},
				{
					"id": 726940246,
					"content": "Sim, Paimon acha que devia se chamar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940247,
					"content": "A \"Grande Máquina\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940248,
					"content": "Espere, esse nome é muito curto! Não impressiona ninguém!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940249
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940249,
					"content": "Às vezes, quanto mais curto, mais fácil é de lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940250,
					"content": "A \"Grande Máquina\", Paimon acha que é um nome muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940251
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940251,
					"content": "*Suspiro* Bem, é verdade que me disseram antes que eu não tenho talento para escolher nomes. Então, desta vez, aceitarei sua sugestão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940252
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940252,
					"content": "O talento de Paimon para escolher nomes não é muito melhor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940253
					]
				},
				{
					"id": 726940253,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940254,
					"content": "Hahaha, de qualquer forma, minha \"Grande Máquina\" consegue analisar automaticamente todos os materiais introduzidos, e escolher o método mais adequado para montá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940255
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940255,
					"content": "Mas da última vez eu introduzi alguns mecanismos estranhos que fizeram os brinquedos explodirem. Então desta vez melhorei a máquina para que o erro não aconteça novamente... Teoricamente, não deve haver nenhum problema agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940256
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940256,
					"content": "Teoricamente...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726940257,
					"content": "É por isso que necessito de voluntários para testá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940258
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940258,
					"content": "Resumidamente, a fabricação de brinquedos consiste em um processo com três etapas: Coleta de Matéria-Prima, Carga Elemental e Ativação do Núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940259
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940259,
					"content": "Temos que coletar coisas como minérios, frutas, flores e assim por diante, para servir de matéria-prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940260
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940260,
					"content": "Em seguida, infundimos os materiais com energia elemental para permitir que o processo continue. E, finalmente, alimentamos os materiais com a energia que vem dos núcleos das formas de vida elementais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940261
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940261,
					"content": "Hoje vamos começar pela primeira etapa: coletar a matéria-prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940262
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940262,
					"content": "Aqui, pegue este Coletor de Materiais. Lembre-se de colocar todas as matérias-primas que coletar no nele. Isso evita que elas sejam contaminadas por outros elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940263
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940263,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940264
					]
				},
				{
					"id": 726940264,
					"content": "Obrigado. Deixe-me ajustar o dispositivo uma última vez. Conto com você para coletar os materiais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940223,
					"content": "O que quer dizer com \"também\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940224
					]
				},
				{
					"id": 726940224,
					"content": "Haha, é uma longa história. Certa vez fui preso pela Comissão Tenryou devido a um pequeno acidente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940225
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726940213,
					"content": "Você publicou uma comissão na Guilda de Aventureiros, não foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940214
					]
				}
			]
		},
