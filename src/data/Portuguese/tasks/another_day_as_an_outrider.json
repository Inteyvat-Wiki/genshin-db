				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520201,
					"content": "Olhe, lá na frente! Algo está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "Não é uma alcateia... Parece que são os Hilichurls que estão atacando as carroças no fim das contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520203,
					"content": "Hum... No fim das contas, não é nenhum mistério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "Chega de conversa fiada! Vamos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45203,
			"completionStepIds": [
