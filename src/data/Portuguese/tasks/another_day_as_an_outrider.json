			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Siegfria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "Obrigada, muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520302,
					"content": "Mamão com açúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520303,
					"content": "Então, os Hilichurls aproveitaram a oportunidade do pânico dos lobos para atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520304,
					"content": "Isso mesmo. Mas tenho que dizer, se você acha que os Hilichurls dão trabalho, os lobos são piores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520305,
					"content": "Eles... Atacaram o Vale Termal nesta manhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520306,
					"content": "Vale Termal? Isso é loucura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520307,
					"content": "É algo inédito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520308,
					"content": "Eu pensei em me arriscar na estrada depois que os lobos tivessem terminado de brincar... Eu nunca pensei que os Hilichurls apareceriam também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520309,
					"content": "Temos que avançar rápido para ver o quão ruim está a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520310,
					"content": "Mas primeiro, você precisa examinar os danos da sua carroça. Ela ainda está funcionando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520311,
					"content": "Darei uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
