			"trigger": {
				"objectNames": [
					"Kazga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Ha'ola relaxa gradualmente. Ele estica todo o corpo e estende suas garras. Parece que é hora de aparar elas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250212610,
					"content": "Sob a orientação de Kazga, você apara cuidadosamente as garras de Ha'ola.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "#Hahaha, não imaginei que você fosse tão {M#bom}{F#boa} em fazer isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212602,
					"content": "Rawr, rawrrr, rawrr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250212603,
					"content": "Ha'ola também tá te agradecendo. Você fez um trabalho tão cuidadoso, não tenho dúvidas que ele vai cavar ainda mais rápido que antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212604,
					"content": "Aqui, aceite isso como agradecimento. Ah, sim, eu provavelmente devia te avisar... Se você tiver que cuidar de outro Sauriano pequeno no futuro, não copie o método que acabei de te ensinar hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212605,
					"content": "Cada Sauriano tem seu temperamento único, então você tem que cuidar deles de maneiras diferentes. Até depois desse tempo todo, eu descobri só agora como cuidar de Ha'ola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212606,
					"content": "Mesmo assim, fico feliz que cheguei tão longe. Afinal, nós dois vamos ter que nos aturar por mais um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212607,
					"content": "Hã? Cadê Ha'ola? Não me diga que ele fugiu de novo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212608,
					"content": "Ha'ola! Ha'olaaaaaaaaa—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				}
			]
		},
