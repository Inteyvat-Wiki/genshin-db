			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Ha'ola não parece achar isso relaxante, e só te encara de volta em confusão.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212710,
					"content": "(Kazga assume antes que as coisas se percam ainda mais. Após mais um tempo de cuidados atenciosos, ele finalmente consegue terminar de cortar as garras de Ha'ola...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "#Está tudo bem, eu também interpreto ele mal às vezes. O importante é que tenho certeza que você é um{F#a} {M#bom amigo}{F#boa amiga} dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212702,
					"content": "Rawr, rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250212703,
					"content": "Hahaha! Viu, o que eu te disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212704,
					"content": "Agradeço muito a ajuda. Por favor, aceite isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212705,
					"content": "Saurianos pequenos são bem difíceis de decifrar. Demorou muito tempo conhecendo Ha'ola antes de eu conseguir entender a maioria do que se passa na cabeça dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212706,
					"content": "Só fico feliz por conseguir chegar tão longe. Afinal, nós dois vamos ter que nos aturar por mais um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212707,
					"content": "Hã? Cadê Ha'ola? Não me diga que ele fugiu de novo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250212708,
					"content": "Ha'ola! Ha'olaaaaaaaaa—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				}
			]
