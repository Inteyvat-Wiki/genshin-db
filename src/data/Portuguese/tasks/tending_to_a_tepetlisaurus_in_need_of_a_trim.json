			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kazga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Não saia fugindo dessa vez, certo, Ha'ola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210102,
					"content": "R-Rwarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250210103,
					"content": "Ha'ola tá tão bonzinho hoje!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Sim. Tudo graças àquela Derivabola que você me ajudou a fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210105,
					"content": "Vou conseguir fazer Ha'ola fazer todos os tipos de coisas com a bola, seja tomar banho, comer, dormir ou treinar... Tudo vai ser bem mais fácil a partir daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210106,
					"content": "Sem mencionar em cortar as garras dele! Antes, até correr atrás dele já me deixava exausto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210107,
					"content": "Agora, tudo que tenho que fazer é mostrar a ele essa bola, e ele vai sentar como se tivesse recebido treinamento completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210108,
					"content": "Rawwr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250210109,
					"content": "#Ha'ola, você lembre quem {M#ele}{F#ela} é? {M#Ele}{F#Ela} foi quem ajudou a fazer seu brinquedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210110,
					"content": "Rrarr, rrarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250210111,
					"content": "Quem é um bom garoto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "Ah, uau, Ha'ola lembra de você com certeza! E ele também tá feliz em te ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210114,
					"content": "Você quer tentar cortar as garras dele? Você pode limpar os chifres dele enquanto isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210115,
					"content": "Isso é bem importante para Tepetlissauros pequenos. Afinal, eles têm que conseguir cavar por rochas e terra, então as garras deles precisam ficar afiadas, qualquer uma que quebrar tem que ser cortada para ficar do jeito certo de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210116,
					"content": "É o único jeito de garantir que eles tenham um par de garras perfeitas quando virarem adultos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210117,
					"content": "Aqui, pegue isso! Se vamos cortar as garras, é melhor aproveitar logo essa chance para dar uma transformação completa para Ha'ola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210118,
					"content": "São muitos detalhes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Rawrr, rawrr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250210121,
					"content": "Ahem, bem, Ha'ola raramente se comporta tão bem. Só me ocorreu que não preciso correr atrás dele pela tribo inteira hoje, então não pude deixar de ficar contente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210122,
					"content": "...Parece um trabalho difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "Não é nada! Enfim, é melhor a gente começar. Vou ficar bem ao seu lado te dizendo o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210124,
					"content": "Para ajudar Ha'ola a relaxar, você vai precisar limpar gentilmente as costas dele com uma escova grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210130,
					"content": "Então troque para uma escova mais fina para limpar os chifres dele. Pode ir com força, senão você vai deixar passar um pouco de sujeira presa nas rachaduras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210125,
					"content": "Depois disso, você precisa usar uma toalha para enxugar o corpo dele todo... Assim, ele vai começar a relaxar gradualmente e estender as garras, aí você vai conseguir aparar elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210126,
					"content": "Essa é uma rotina bem específica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Claro que sim! Eu criei Ha'ola, afinal. Não tem ninguém em toda a tribo... na verdade, Natlan inteira, que conheça ele melhor do que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210129,
					"content": "Tudo bem, só siga as instruções que acabei de dar e ajude a aparar as garras de Ha'ola. Vou tá logo ao seu lado, então pode perguntar se tiver alguma dúvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250210127,
					"content": "Você conhece ele bem mesmo, né...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Por que tanta animação de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Fazer carinho em Ha'ola.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
