			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "Viajante, pare aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020202,
					"content": "Tem algo que eu possa fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Isso pode parecer um pouco inesperado, mas você possui interesse no Aparelho Fotográfico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020204,
					"content": "Um pouco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Esse Aparelho Fotográfico meu não é como qualquer um comum. É a mais nova tecnologia de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020207,
					"content": "As fotos reveladas por ele possuem cores que os outros Aparelhos Fotográficos comuns não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020208,
					"content": "Como isso é possível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "Ei! Que cara é essa de que não acredita em mim? Se não confia no que eu disse, vá até à Guilda de Aventureiros e pergunte por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020211,
					"content": "Antes eu também não acreditava. Fiquei mexendo nesse Aparelho Fotográfico um bom tempo, até que um Aventureiro na Guilda me ajudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020212,
					"content": "Esse Aparelho Fotográfico não é como os comuns. Dentro dele há uma pequena estrutura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020213,
					"content": "Essa estrutura pode ser preenchida com um composto químico especial que, ao revelar as fotos, fazem elas possuir um efeito especial. As fotos dele são mais bonitas que as de um Aparelho Fotográfico comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020214,
					"content": "#E então? Está interessad{F#a}{M#o} agora? Que tal pegar e tirar algumas fotos com ele? Apesar de não ter muito composto químico dentro dele, deve ser suficiente para você experimentar um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020215,
					"content": "#Depois eu retornarei para Fontaine para comprar remédios novos. Se você estiver interessad{F#a}{M#o}, pode vir até mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020216,
					"content": "#Uh... Obrigad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Pegue este Aparelho Fotográfico para se divertir um pouco. Se tiver interesse, lembre-se de passar aqui depois para comprar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020217,
					"content": "Quanto custam esses compostos químicos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "Ah, sobre isso... Não se preocupe. São baratos. Se você comprar muitos, quando eles chegarem poderei fazer um preço especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020209,
					"content": "Não acredito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Não tenho interesse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
