			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Oh, você veio. Tenho algo para falar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020102,
					"content": "Qual é o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Não, não. Eu já entendi o que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020105,
					"content": "Alguns dias atrás eu encontrei o comerciante que me vendeu o Aparelho Fotográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020106,
					"content": "Eu disse que o Aparelho Fotográfico tinha um problema, mas ele não acreditou em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020107,
					"content": "Mas ele acabou admitindo a verdade, graças a você que tirou tantas fotos para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020108,
					"content": "Depois que você me ajudou a tirar aquelas fotografias, ele concordou em olhar o Aparelho Fotográfico que me vendeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020109,
					"content": "Depois disso, ele me deu ontem uma garrafa com algum composto químico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020110,
					"content": "Ele disse que a estrutura desse Aparelho Fotográfico e a de outros comuns é diferente. Que é necessário adicionar alguns compostos químicos, e que depois disso, as fotos reveladas devem sair normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020111,
					"content": "Se não tivesse adicionado o composto, as fotos que tirei com você antes acabariam saindo iguais. Teriam cores, mas não seriam nítidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020112,
					"content": "Se não há nada de errado com ele, ótimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Sim, mas na verdade, agora eu estou mais interessado naquele composto químico do que no Aparelho Fotográfico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020115,
					"content": "Pense, a maioria das pessoas só pode comprar um Aparelho Fotográfico, não é? Compram, e podem usar o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020116,
					"content": "Mas um composto químico como esse é consumível. Depois que acabar, se quiser continuar usando, é necessário comprar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020117,
					"content": "Além disso, de acordo com o que o comerciante disse, diferentes compostos químicos terão um efeito diferente na revelação da foto. Ele disse que está pesquisando ainda mais compostos químicos para serem utilizados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020118,
					"content": "Talvez esse composto químico seja o verdadeiro grande negócio disso tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020119,
					"content": "Ah, me desculpe. Eu acabei falando sozinho sem parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020120,
					"content": "Obrigado pela sua ajuda. Me dê o Aparelho Fotográfico, e eu colocarei o composto químico nele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020113,
					"content": "Então não há problema nenhum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Tenho que fotografar algo com cores fortes hoje também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
			"completionStepIds": [
				4140202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
