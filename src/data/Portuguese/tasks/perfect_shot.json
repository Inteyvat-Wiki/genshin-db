							"4140203",
							"2"
						],
						"stepId": 4140203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jitong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Aqui está o Aparelho Fotográfico. Pegue-o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020302,
					"content": "Você vai dar esse Aparelho Fotográfico para mim...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "Esses compostos químicos que lhe dei devem durar um bom tempo. Quando acabarem, você vir comprar mais de mim, o que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020305,
					"content": "Agora, até mais. Eu preciso me preparar para encontrar aquela pessoa e comprar mais tipos de compostos químicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020306,
					"content": "#Depois, se você estiver interessad{F#a}{M#o}, é bem-vind{F#a}{M#o} para vir até mim comprar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020307,
					"content": "Não imaginei que ao se comprar esse Aparelho Fotográfico acabaria comprando um bom negócio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414020303,
					"content": "E se aqueles compostos químicos acabarem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}