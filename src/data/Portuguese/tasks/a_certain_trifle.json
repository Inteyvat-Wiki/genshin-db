					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "Ah, Viajante, que bom lhe ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350102,
					"content": "Como você está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "Você está com olheiras debaixo dos seus olhos, e mal consegue falar. Você deveria ir descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350105,
					"content": "Eu... eu não posso descansar. Eu passei a noite toda escrevendo rascunhos, mas não eram bons! É hora de reescrever de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350106,
					"content": "Se você tem algum negócio oficial que necessita de minha ajuda, por favor, espere um momento... Você pode pegar uma cadeira perto do Sr. Roialte, talvez ele até tenha café...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350107,
					"content": "Eu... eu tenho que voltar a escrever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350108,
					"content": "Argh! Não, usar \"Caros queridos colegas\" não é formal o suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350103,
					"content": "Sua cara já viu dias melhores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
