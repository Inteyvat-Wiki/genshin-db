			"dialogs": [
				{
					"id": 740350601,
					"content": "Iaune, o que houve? Você parece estar sem fôlego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "Estelle! Por favor, eu preciso de uma tecla para uma datilografadora! Você deve ter alguma coisa aqui, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Claro, mas datilografadoras têm tantas teclas diferentes! Dê uma olhada e veja qual você precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune começa a olhar, procurando a tecla que precisa na velocidade da luz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "Essa! Essa aqui! Aqui está o dinheiro, obrigado, Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "Da última vez, você disse que gostaria de sair para velejar comigo... Iaune! EI! Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
