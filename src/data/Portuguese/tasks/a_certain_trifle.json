			"dialogs": [
				{
					"id": 740350401,
					"content": "Olá, Sr. Iaune. Como posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "Olá para você também, Srta. Cornelia. Nós temos alguma tecla extra para uma datilografadora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "Minha datilografadora está com uma tecla faltando, então eu gostaria de solicitar uma substituição. Se não houver uma no estoque... Também serviria se você pudesse me reembolsar a compra de uma nova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Comprar uma tecla... isso não seria um problema, a princípio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Assine seu nome aqui, por favor. Só escreva \"Solicitando reembolso para substituição de tecla devido a problema em datilografadora\", então assine seu nome e escritório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Muito bem. Eu posso comprar a tecla hoje, certo? Eu preciso mesmo voltar ao trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Sr. Iaune, você já solicitou reembolso para compra de propriedade pública antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "Ser reembolsado por despesas de trabalho não é nada como você imagina... você não simplesmente compra algo e o reembolsa. Precisamos compilar todos os recibos de reembolsos e documentos mensalmente, criar relatórios de resumos e então submeter tudo ao Maison Cardinalice para aprovação no fim do mês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "Esse processo é relacionado à aprovação e pagamento de salários para o Maison Gestion inteiro. Se a quantia gasta a ser reembolsada for grande demais, então o Maison Cardinalice até precisará submetê-la ao próprio Monsieur Neuvillette para aprovação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "Pagamentos só podem ser oficialmente enviados após a revisão estar completa e tudo estar assinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "Se o próprio Monsieur Neuvillette tiver qualquer dúvida sobre algum relatório de despesa, o funcionário em questão deve submeter um relatório escrito... Nós estamos preparando agora mesmo o primeiro lote de relatórios a ser submetido para os próximos dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "Você quer dizer, se eu tiver azar suficiente, então o fato de eu desejar ser reembolsado por uma tecla poderia necessitar da aprovação do próprio Monsieur Neuvillette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Tais são as regras, Sr. Iaune. E as despesas totais para este mês estão mesmo bem grandes. Monsieur Neuvillette pode muito bem ser solicitado a fazer auditoria dos relatórios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "Monsieur Neuvillette... Espera, esse não é o Juiz Supremo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Mas é só uma tecla... e estamos fazendo ele assinar isso... não parece certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Tem algum outro jeito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Eu também acho, afinal, é apenas uma tecla e não precisamos incomodar o próprio Monsieur Neuvillette com isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Isso é verdade, há outras maneiras. Sim... Você poderia comprar uma tecla você mesmo, então eu posso fornecer um reconhecimento oficial de dívida em contas públicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "Após todos os reembolsos serem processados e o processo de pagamento ser concluído, a quantia devida será paga a você diretamente dos cofres públicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "Excelente! Então vamos fazer isso! Afinal, uma tecla não custa muto, eu posso pagar por ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "Então, por gentileza, assine aqui e você ainda deve escrever \"solicitando reembolso para substituição de tecla devido a problema com datilografadora\"... você vai comprar uma tecla substituta com a Senhorita Estelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Sim. Tem algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Então eu levarei a nota ao Sr. Roialte para ele assinar, então vou levar para a Senhorita Estelle verificar a quantia comprada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "Mas você não precisa se preocupar com isso. Pode comprar sua tecla, eu cuido do resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "Muito obrigado! Você é mesmo a melhor, Srta. Cornelia. Eu vou comprar agora mesmo... Vamos lá, Viajante, é hora de ir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Vamos tentar outra coisa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
