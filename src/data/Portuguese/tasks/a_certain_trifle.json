			"dialogs": [
				{
					"id": 740350301,
					"content": "Uma tecla para uma datilografadora... Ei, Semaine, você pode sequer pagar por coisas assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "Não tenho certeza. Mas se datilografadoras puderem ser reembolsadas... então teclas também podem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				}
			]
		},
		{
