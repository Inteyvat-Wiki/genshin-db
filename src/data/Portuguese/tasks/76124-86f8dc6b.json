					}
				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "Hã? Parece que tem outra pintura aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Aha, que olhos afiados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240403,
					"content": "Um grupo de jovens que se autodenomina herdeiros do Clã de Guhua certa vez encomendou ao Castiglione que a pintasse. Eles dizem que é o seu precioso \"campo de treino\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240404,
					"content": "Mas eles são orgulhosos demais. Já se acham mestres inigualáveis, muito acima de treinamentos tão básicos. Então me entregaram a pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240405,
					"content": "Ué... Você não é do Clã de Guhua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Bem, eu adoraria dizer que sim. Infelizmente, aquele rapaz, o Guhua, provavelmente não teria coragem de me aceitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240407,
					"content": "Na época em que estávamos expulsando bandidos nas Planícies de Guili, o garoto quase se matou por falta de treino adequado. Não tive escolha a não ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240408,
					"content": "Ah, deixa para lá. Coisa antiga e sem graça. Mas essa pintura... aí já é outra história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240409,
					"content": "#Se estiver curios{M#o}{F#a}, pode desenrolar. Se rasgar, não faz a menor diferença, o Castiglione fica à toa na maior parte do tempo mesmo. É só eu pedir para ele pintar outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jing-gui"
				}
			]
		}
	]
}