					}
				]
			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Tudo bem então, encerramos por aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240302,
					"content": "#Obrigada, foi um verdadeiro prazer. E você aí, jovem loir{M#o}{F#a}, suas habilidades são realmente impressionantes. Eu diria que você é bem mais forte do que aquele rapaz Guhua que eu conheço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240303,
					"content": "Arrasei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "#Graças a vocês d{M#oi}{F#ua}s, eu também tive um raro momento de inspiração. A pasta de peixe realmente precisa de um pouco de carne fresca picada para realçar o sabor. Se deixar por tempo demais, não tem como disfarçar o gosto de peixe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240307,
					"content": "Ah, faz sentido... Hm? Espera... isso não parece ter nada a ver, né!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "Haha, não liga para essas bobagens! Da próxima vez que eu pedir para Castiglione pintar mais alguns peixes, eu vou oferecer a vocês uma boa pasta de peixe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jing-gui"
				},
				{
					"id": 761240304,
					"content": "Não foi nada demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "#Não precisa ser modest{M#o}{F#a}. Seu manejo de espada é forte, isso eu consigo ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jing-gui"
				}
			]
		},
