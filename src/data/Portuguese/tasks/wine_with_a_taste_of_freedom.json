			"dialogs": [
				{
					"id": 223030301,
					"content": "Vou experimentar um pouco para começar, e ver se posso adicionar o Dandelion a um processo de fabricação de bebidas ao estilo de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Oh, isto é para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "Não estou esperando acertar de primeira. Provavelmente precisarei de mais tentativas. Se eu ficar sem Dandelions, talvez você tenha que ir buscar mais para mim.",
