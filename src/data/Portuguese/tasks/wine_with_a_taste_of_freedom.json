				"objectNames": [
					"Degui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "Está cada vez mais difícil fazer negócios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Er? Eu estava apenas dizendo, os negócios estão ficando cada vez mais difíceis nesta taverna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Para um negócio de comida e bebida, ter uma longa história tem vantagens e desvantagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "A parte boa é que uma longa história oferece uma reputação maior, o que ajuda a atrair negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "A parte ruim é que as pessoas ficam fartas com os mesmos pratos. Se for um grande restaurante com mais diversidade, não será um problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Mas a minha Taverna é apenas uma pequena Taverna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "Meus clientes de longa data estão finalmente começando a ficar enjoados com as bebidas, e já não estão mais vindo com tanta frequência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "Ouvi dizer que há uma grande indústria de vinho em Mondstadt. Eles têm um famoso vinho de Dandelion, supostamente feito com Dandelions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "Eu nem tenho certeza se é possível fazer cerveja com Dandelions... Mas eu gostaria de pelo menos tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Você pode buscar alguns Dandelions por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Ótimo. Você tem minha palavra de que lhe pagarei por seus problemas e, em Liyue, nossa palavra é nosso vínculo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Vinho de Dandelion...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Então? O sabor é estranho? Ouvi dizer que este vinho é muito procurado em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "Mas, não vá vender se eu apenas copiar exatamente a mesma receita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Você pode levar de volta os <color=#00E1FFFF>Dandelions</color>, vamos fazer vinho de maneira de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
