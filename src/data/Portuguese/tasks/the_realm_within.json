			"dialogs": [
				{
					"id": 10140401,
					"content": "Muito bem! Esse é o Sino Purificador... Está bem preservado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Vamos colocar dentro os perfumes que fizemos antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "Você conhece a Madame Ping?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Claro. Se não, como eu saberia que o sino estava com ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Isso é suspeito! Mas se você não quiser falar sobre isso, não vamos esforçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Ah! Aquela velhinha vovó nos pediu para contar a você uma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "\"Se vocês tiverem tempo, podem vir tomar um chá. Eu não tenho muito a oferecer, mas você pode sempre contar com essa senhora idosa para uma xícara de chá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Haha, esse tom não combina com você. Mesmo assim, seu bule é de fato muito bom. Não existe nenhum melhor para a fabricação de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Quando chegar a hora certa, vou visitá-la levando um chá muito bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Então, qual é o próximo passo para nossas preparações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Hm... Próximo, precisamos comprar <color=#00E1FFFF>pipas</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Pipas? O Zhongli vai nos levar para soltar pipa? Isto é... intervalo na preparação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Haha, não é bem assim. Apesar de pipas serem brinquedos de crianças, elas também possuem vários papeis simbólicos em rituais de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Eu vou explicar isso para vocês depois. Mas a próxima fase provavelmente deveria ser comprar as pipas primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Oh... a Paimon está muito confusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Você também é um Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "Um Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
