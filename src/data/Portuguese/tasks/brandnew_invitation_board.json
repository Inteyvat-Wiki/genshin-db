			"dialogs": [
				{
					"id": 706750101,
					"content": "Bem, agora que o Príncipe fez alguns ajustes ao Mural de Convites, todos com um convite podem entrar nessa sala especial e duelar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750102
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750102,
					"content": "Seus amigos não terão que viajar longas distâncias para chegarem aqui. Além disso, a sala deixa ainda mais conveniente para qualquer um ficar para um duelo, independente de quem seja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750103
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750103,
					"content": "Hã? O que você quer dizer com é impossível um gato fazer isso? Hunf, você ainda tem muito o que aprender sobre o Príncipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750104
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750104,
					"content": "Falando nisso, eu acho que você não sabe do que gatos são capazes! Enfim, fique à vontade para usar o novo Mural de Convites e convidar seus amigos para um duelo na sala especial!",
					"roleType": "TALK_ROLE_NPC",
