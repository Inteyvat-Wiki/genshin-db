					"nextDialogs": [
						741421402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421402,
					"content": "Paimon, eu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "Isso foi super rápido! Paimon nem teve tempo de piscar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421404,
					"content": "...Que alivio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#Muito bem! {M#Nosso pequeno problemático}{F#Nossa pequena problemática} está de volta! Canotila, você deixou {NICKNAME} muito preocupad{M#o}{F#a}, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421406,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421407,
					"content": "*Chora* Me desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421408,
					"content": "Hã? Paimon não está te culpando! Não chore, Canotila. Qual é, Paimon vai te dar algo gostoso para comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421409,
					"content": "(O que aconteceu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421410,
					"content": "(Encontramos algum perigo lá dentro.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(Oh...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421412,
					"content": "Não chore, Canotila, você é uma Melusine muito, muito corajosa! Aqui, esse é o Espeto de Frango com Cogumelos favorito de Paimon. Pegue, é todo seu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421413,
					"content": "*Chora* Muito obrigada, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421414,
					"content": "*Mastigando*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421415,
					"content": "Uau, que gosto estranho! Então isso é o que os humanos costumam comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421416,
					"content": "Ei! Se você não quer, você pode devolver a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421417,
					"content": "#Mas... Obrigada. E obrigada por me salvar, {M#Sr.}{F#Srta.} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421418,
					"content": "O que você planeja fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Eu não sei, mas eu não quero mais ler livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "...Canotila, isso não é meio extremo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "Mas o Livro da Revelação é muito assustador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(O que raios aconteceu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(É difícil de explicar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Você vai entender quando for.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(O quê?! Ah que raiva...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421427,
					"content": "... Enfim, não vou ficar parada aqui esperando. Vou com todo mundo pra Vila Marusea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421428,
					"content": "Isso! As outras Melusines vão cuidar de você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421429,
					"content": "Obrigada, Viajante, irmãzona Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
