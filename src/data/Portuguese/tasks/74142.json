			"dialogs": [
				{
					"id": 741421301,
					"content": "#Obrigada, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Não sei... eu só tinha pensado em ver o girassol, e também o cachorro fofinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Mas no caminho, um monstro terrível começou a me seguir. E o céu começou a ficar cada vez mais escuro... comecei a ouvir várias vozes, mas não entendi nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "Eu estava apavorada. Só segui a luz dourada e saí correndo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "Quanto mais os monstros se aproximavam, mais o mundo ficava escuro... eu não conseguia ver o jardim, o palácio, as árvores e as flores, tudo ficou tão escuro que só consegui ver ruínas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "E depois, o monstro me alcançou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Não precisa mais se preocupar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "Cachorrinho, leve ela daqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Senhorita, não volte aqui. Não há nada aqui, mas tem um mundo inteiro te esperando lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "Hã? Você é um filhotinho, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "...Eu te verei novamente? Esse mundo voltará a ser um lindo jardim mais uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "Não. Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "E você, deixe-me perguntar mais uma vez. O que eu sou aos seus olhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Um cachorro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "Isso foi ótimo. Você acabou de se livrar de alguém que não deveria estar aqui, e graças a você, o colapso deste mundo parou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Mas também não é inteligente você ficar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "Eu imaginei. Por favor, me mande de volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Uma escolha sábia. Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "O que está acontecendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Esse mundo ia se desintegrar, pois alguém que não deveria estar aqui chegou, abalando a fundação deste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "É por isso que eu vi o que eu vi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "Eu não sei o que você vivenciou. Eu não sou você, afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "E quem é você então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "...Isso não é importante. O que é importante é o mestre deste mundo imaginário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Eles acreditavam que poderiam salvar o mundo, mas eles não sabiam se esse mundo realmente precisava ser salvo. Talvez o mundo nas memórias deles era como uma tarde para sempre sem girassóis florescendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Mas essas são as memórias deles, não minhas. E apenas uma memória que eles têm de seu amigo. Eles acreditavam que poderiam me salvar, mas no fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "A borboleta se tornou um casulo e uma larva surgiu dele. Então, a larva retornou ao vazio que jamais nasceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Mas nada disso importa. Não tenho mais nada restando. Sou apenas uma sombra em suas memórias, deixados para trás por sua obsessão de me salvar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Mas eu não odeio eles. Mesmo que eles mudem depois de me perder, minha existência neste mundo da imaginação e memória é a prova da persistência deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "Como alguém que uma vez foi amigo deles, eu estava satisfeito. Não importa o que eu me torne, estou para sempre grato pela amizade que tivemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "Enfim, vamos terminar aqui. Você consegue sentir a influência que este lugar tem em você, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Adeus. Não nos veremos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
