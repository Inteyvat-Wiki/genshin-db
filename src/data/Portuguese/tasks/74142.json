			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#Hã, {NICKNAME}... a gente não acabou de se ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420402,
					"content": "Quando foi isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "Hã... não tenho certeza. Afinal, é difícil acompanhar o tempo em um lugar como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420404,
					"content": "Canotila, venha comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "Esse lugar não parece certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "Hmm, mas não é a gente que decide o que é certo ou não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420407,
					"content": "Hmm, eu não quis dar uma de profunda, mas eu gosto mesmo desse lugar. É cheio de vida e cores, coisas que nunca vi do outro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420408,
					"content": "Eu vi um girassol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "Sério?! Uau! Onde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420410,
					"content": "Naquele lugar que encontramos o cachorro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "Oh! Eu tô indo pra lá agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420412,
					"content": "Espere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
