			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#Ah! {NICKNAME}! Hã, cadê Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Aquela fenda... o que você tá vendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Hã? Fenda? Isso aqui não é um espelho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Hã, falando nisso, eu estou mesmo procurando por uma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Sempre estive procurando por pistas do espelho misterioso... algo tipo uma pintura, tipo o Livro da Revelação, que é capaz de fazer as pessoas entrarem na \"meditação\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "Sobre os quatro quadrantes e a pintura da torre de Gestalt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#...Sério? Então tá em um lugar como aquele? Ok! Obrigada, Sr{F#ta}. {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
