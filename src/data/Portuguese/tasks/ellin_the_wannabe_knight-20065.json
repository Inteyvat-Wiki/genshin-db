			"dialogs": [
				{
					"id": 200650101,
					"content": "Ugh! Que dor de cabeça! O que devo fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Estou praticando para as provas dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650104,
					"content": "*Suspiro* Mas eu não sou tão forte quanto a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650105,
					"content": "Creio que seja melhor me concentrar nas técnicas em vez da força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650106,
					"content": "Por exemplo, eu estava pensando como eu poderia quebrar todos estes manequins de madeira com um golpe só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650107,
					"content": "São muito mais robustos do que parecem, não é uma tarefa comum... Não sei onde foi que meu pai os arranjou, mas ele deve ter tido muito trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
