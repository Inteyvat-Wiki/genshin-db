				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "De volta tão cedo? Bem então, acredito que nada sério esteja acontecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Não, ainda tem muitas atividades de monstros por aí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "O quê? Ainda existem monstros andando por aí e em números ainda maior do que antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Isso é estranho. A maior força que atacou Mondstadt não foi derrotada anteriormente? Por que eles ainda estão se escondendo na região?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "É possível que eles tenham outros planos? ... Eu preciso reunir os aventureiros e redistribuir nossas missões. Não podemos encarar esses monstros na brincadeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Conduzir investigações cuidadosas sobre as atividades de monstros na natureza é de competência da Guilda dos Aventureiros. É hora de mostrar a todos do que somos capazes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Ah, sim. Por favor, pegue isto como forma de agradecimento pelos seus esforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
	]
