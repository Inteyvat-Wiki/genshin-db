					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Hã? Você encontrou todas as réplicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Maravilhoso! Você realmente tem jeito para isso, não tem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Bem, esse presente é para você. Agradeço pela sua participação no evento organizado por nosso Darshan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "Espero que você tenha conseguido sentir o gostinho divertido da experiência arqueológica, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Dito isso, a arqueologia de verdade tende a ser um trabalho intenso e difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Mas na hora que você encontra AQUELA relíquia inestimável, você sente que todo o trabalho árduo valeu a pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "E se você não encontrar nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Bem, se não encontrarmos nada... a viagem se torna, como dizem, \"trabalho jogado fora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "E, sinceramente, isso é o que mais acontece. Os momentos em que de fato encontramos algo importante são consideravelmente raros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Mas trabalhar com arqueologia é se acostumar com esse tipo de situação e continuar otimista mesmo assim. Se não, ninguém aguentaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Devem ter momentos em que você não encontra nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
