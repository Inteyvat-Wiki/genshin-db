					"nextDialogs": [
						737140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140102,
					"content": "Primeira parada, oásis do deserto! Então vamos para a Floresta Mawtiyima, e depois de volta para o Porto Bada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140103,
					"content": "Paimon tá pensando nisso há um tempo... O deserto, a floresta, e os vales em Sumeru parecem super diferentes! Mas quase nunca vemos tudo em uma jornada única, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140104,
					"content": "Ainda bem que temos tudo que precisamos, por isso Paimon tá dizendo que precisamos ir com calma para absorver tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140105,
						737140106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140105,
					"content": "Claro! Sem pressa, só aproveitando!",
					"roleType": "TALK_ROLE_PLAYER",
