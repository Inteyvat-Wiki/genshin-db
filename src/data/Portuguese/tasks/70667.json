				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "#Miau! (Incrível! Parabéns por passar no julgamento e avançar seu nível de jogador! Agora você se tornou {M#um jogador}{F#uma jogadora} especialista!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706670202,
					"content": "(Agora você pode desafiar mais oponentes... Aliás, apesar de você já poder antes, queria lembrar que você também pode lançar desafios no mural de convites...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706670203,
					"content": "#Miau... (Assim, os oponentes que quiserem desafiá-l{M#o}{F#a} podem indicar no seu anúncio. Às vezes, partidas com desconhecidos podem ser interessantes...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706670204,
					"content": "(Afinal, jogar cartas também é uma forma de conhecer pessoas.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680204,
					"content": "#Miau! \"Ah! Como privilégio de especialista, agora {NICKNAME} pode comprar cartas belíssimas!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706670205,
					"content": "#(É... {NICKNAME}, não se esqueça do espírito de jogo. Divirta-se com o Chamado Sagrado dos Sete!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"O Príncipe\""
				}
			]
		},
