					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#Miau... (Ei, veio para o julgamento de avanço de nível de jogador? Bem, {NICKNAME} realmente tem as qualificações necessárias para o desafio.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706660103,
					"content": "\"Então, vou pedir a Shuyun que prepare as cartas para o julgamento. Tenha cuidado...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"O Príncipe\""
				}
			]
		},
