				"points": []
			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "Excelente! Me dê um momento. Acho... acho que sei o que fazer agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110703,
					"content": "Pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110704,
					"content": "Ooh, o cheiro está muito bom! Paimon realmente quer experimentar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110705,
					"content": "Como vamos chamar isso? Hmm... Já que é para um gato falante, vamos chamar isso de \"Refeição Revigorante Miau\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110706,
					"content": "Muito bem! Aqui está seu prato para viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110707,
					"content": "Ah, sim, e deixe-me escrever a receita para você também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110708,
					"content": "#Uhuuuu! Acho que comidinhas para gatinhos, feitas {M#pelo}{F#pela} {NICKNAME}, estarão no cardápio no futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110709,
					"content": "O que você é, Paimon, uma gata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "Ei, isso é rude! Boa comida é algo universal, não sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110711,
					"content": "De qualquer forma, muito obrigada, Srta. Kiminami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110713,
					"content": "Está tudo bem, não se preocupe! Leve esta refeição e a receita de presente para Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110714,
					"content": "Com certeza irei até o Santuário Asase quando fizer uma visita a ela, assim que eu tiver tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110715,
					"content": "Tudo bem, pode ir agora. Não deixe Neko esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110712,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
		{
			"id": 7221108,
			"completionStepIds": [
				7221101
