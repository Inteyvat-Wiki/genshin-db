				"points": []
			},
			"dialogs": [
				{
					"id": 722111101,
					"content": "#Olá, bem-vind{M#o}{F#a} ao Restaurante Kiminami. Você gostaria de alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111102,
					"content": "#Olá— Oh, é você! Amig{F#a}{M#o} da senhorita Kamisato! Entre, entre! Com o que posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111103,
					"content": "Então, preciso fazer uma refeição para a Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "\"Neko\"?... Imagino que este seja o nome de um gato, talvez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111105,
					"content": "Você sabe quem é a Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111106,
					"content": "Não. Só tive um pressentimento do nada que este talvez seja um nome para um gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111107,
					"content": "Essa é uma intuição poderosa que você tem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "Mas isso não importa. Nosso problema é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111109,
					"content": "Então você está me dizendo que na Ilha Seirai há o Santuário Asase, e esse santuário é o lar de uma gata falante!? E essa gata lhe pediu para fazer uma refeição para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111110,
					"content": "Isso... Isso é realmente verdade? Eu nunca ouvi falar de tal coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111111,
					"content": "Sim, é a mais pura verdade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "Ilha Seirai, não é mesmo? Eu irei lá com certeza se tiver a chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111114,
					"content": "Uh, então, sobre a comida da Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "Ah, certo... Eu quase me esqueci disso. Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111116,
					"content": "Hmm, um prato que um gato desfrutaria, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111117,
					"content": "Vai ser difícil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111118,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111119,
					"content": "Vai ser difícil, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "Este é um desafio para o nome da família Kiminami! Eu vou superá-lo, não importa o que aconteça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111121,
					"content": "Agora, então. Acredito que Peixe, Carne Crua, Erva Marinha e Arroz farão um prato que até mesmo os gatos brigarão entre si para provar. Deixe isso comigo, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111122,
					"content": "Pa-Paimon quer um pouquinho também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111123,
					"content": "Na verdade, eu também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "Sem problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111126,
					"content": "Deixe-me pensar como vou estruturar esta receita. Enquanto isso, ajude-me a preparar três porções de Erva Marinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111127,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "Estou contando com vocês. Só preciso de três Ervas Marinhas, depois que as encontrar, traga-as logo para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111129,
					"content": "Você já sabe como fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "Tenho alguns pensamentos, mas ainda não tomaram completamente forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111131,
					"content": "Apenas me ajude a conseguir essas três porções de Erva Marinha primeiro. Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111124,
					"content": "Então vou deixar isso com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "Você mesma pode ir dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "Kiminami Anna"
				}
			]
		}
	]
