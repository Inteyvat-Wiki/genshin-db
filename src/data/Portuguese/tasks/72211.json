					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Senhorita Etsuko, aonde devemos ir em seguida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Ufa... Acho que vamos descansar por um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "Hã? Oh, são vocês. Precisam de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "Precisamos encontrar um chef confiável...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Você está procurando um chef? Na Ilha Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Bem, é o seguinte. A Neko gostaria que nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Hã. Então a Senhorita Neko quer que você prepare alguma comida, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah, droga! Se ao menos eu tivesse alguma habilidade na cozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "#Em outras palavras, você gostaria de um chef que pudesse ajudá-l{M#o}{F#a} a descobrir \"como fazer algo que um gato gostaria de fazer com esses ingredientes\", certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Deixe-me pensar... Um chef... Um chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "Bem, por que você não tenta ir à cidade de Inazuma e procurar Kiminami Anna no Restaurante Kiminami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "Ela é uma pessoa muito simpática e também é boa na cozinha. Ela deve ser capaz de te ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "#Obrigad{M#o}{F#a}, vamos procurá-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Não precisa nos agradecer. Então, vai lá, Taisuke e eu ainda precisamos estabelecer alguns planos para nossa futura exploração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Hehe, bem, espero que este santuário realmente prospere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "Caso contrário, o trabalho árduo que você e a Neko colocaram para consertá-lo poderá ser um desperdício...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
			"id": 7221102,
			"completionStepIds": [
				7221103
			],
