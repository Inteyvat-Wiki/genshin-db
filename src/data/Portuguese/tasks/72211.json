				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Você levou a refeição para os pequeninos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "Eles absolutamente adoraram.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "É mesmo? Maravilhoso, maravilhoso. Miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "Já se passou muito tempo desde que eu comi algo tão maravilhoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Miau miau, miau... Embora agora eu não precise de comida nem água, o sabor de uma refeição com arroz é sempre uma tentação muito grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "Aquele pequenino se chamava Meshi, justamente porque essa é a melhor coisa que eu poderia pensar em todo o mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "Então, qual era o nome do prato que a Hibiki faria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Um nome? Os pratos precisam de nomes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "Este é chamado de \"Refeição Revigorante Miau\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Que nome complicado. Ainda assim, eu gostei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "#...E você está cert{M#o}{F#a}. Refeições são coisas boas, e todas as coisas boas devem ter nomes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Miau, miau, eu vou perguntar à Hibiki quando ela voltar. Então você pode fazer para ela seu prato também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "E ela vai fazer o dela para você. Depois, poderá comer dois pratos diferentes, mas deliciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "De fato, essa é mais uma razão para que eu restaure este santuário. Quando a Hibiki voltar, comeremos todos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Obrigada. Isto está delicioso. Miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
