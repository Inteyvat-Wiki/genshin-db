			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "Ah, você está aqui. Bem na hora. Eu preciso de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110802,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Graças a você, o estado do santuário melhorou muito e podemos esperar que os adoradores voltem em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110804,
					"content": "Eu tenho instruído os pequeninos a manter uma postura digna e não se rebaixar diante dos humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110805,
					"content": "Mas eles já estão acostumados a fazer o que querem e não me ouvirão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110806,
					"content": "No entanto, eu tenho um plano astuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110807,
					"content": "Um plano astuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "Quando eu ainda era muito, muito jovem, eu também gostava de brincar em todos os lugares. Num esforço para me adaptar com os outros gatos, a Hibiki fazia um prato muito delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110809,
					"content": "Você disse d-delicioso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Sempre que a refeição era servida, os gatos vinham correndo das árvores e dos telhados. Não importa o quão quente estava, ou quão escaldadas nossas línguas ficavam, não podíamos resistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110811,
					"content": "Hibiki sempre fazia uma grande panela com ele, e humanos e gatos comeriam juntos. Mesmo aqueles que visitavam o santuário recebiam uma parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110812,
					"content": "Ah, mas Domeki... Tsc, aquele glutão. Ele sempre comia muito. Eu nunca vi algo mais indigno do que isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110813,
					"content": "Por isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Muito bom, sua compreensão é excelente. Sim, eu estou pedindo para você fazer um prato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110816,
					"content": "Não duvido da sua inteligência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "Mas você realmente sabe como esse prato deve ser feito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Miau... miau...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Eu... Deixar essas questões para você não é o ponto principal deste exercício? Tenho que fazer tudo sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110821,
					"content": "...Ah, mas aquele prato era realmente uma maravilha! Mesmo depois de vagar para longe, ou de ter passado anos e anos sem ele, esta ainda se lembra do seu sabor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110822,
					"content": "#Bem, {NICKNAME}, parece que isso é um trabalho para nós, não é? Afinal, é pelo santuário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "Qual é o prato do dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Claro que me lembro. Tinha carne de peixe, de animais, erva marinha e arroz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110827,
					"content": "Hum... Então, Peixe, Carne Crua, Ervas Marinhas e Arroz... Você se lembra como era feito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "Esta não se lembra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110829,
					"content": "...Parece que vamos ter que perguntar ao Chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Claro, mas... Onde encontramos um chef que saiba fazer comida de gato? Humm... Vamos perguntar a Taisuke e Etsuko, eles talvez saibam o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Vamos perguntar àqueles dois Aventureiros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Ah sim, isso mesmo! Taisuke e Etsuko são aventureiros, então eles devem saber de algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "Paimon não engana ninguém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Vamos lá, Paimon é amiga dos gatos! Agora, Neko, você ainda se lembra dos ingredientes que entraram naquele prato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "Você quer que eu lhe faça um pouco de comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
