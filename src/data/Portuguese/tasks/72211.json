			"dialogs": [
				{
					"id": 722110401,
					"content": "Este cheiro... Você já fez, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110402,
					"content": "Eu consegui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "Miau, miau! Maravilhoso! Permita que eu experimente um pouquinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110405,
					"content": "Mmm, é um pouco diferente de como Hibiki costumava fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110406,
					"content": "De-Deve ser muito bom. Vamos lá, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110407,
					"content": "Que delícia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110408,
					"content": "...Miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110409,
					"content": "(A Neko está infeliz por ter um gosto diferente de como essa tal de Hibiki costumava fazer?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110410,
					"content": "É muito bom. Você é de fato bem confiável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110411,
					"content": "Assim está bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "É bem diferente de como Hibiki costumava fazer, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110413,
					"content": "Mas, quando eu como com vocês, a sensação que deu a mim foi a mesma que a sensação de comer junto com a Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110414,
					"content": "Por que isto é assim, humano? Vocês, humanos, são capazes de fazer alguma magia estranha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110415,
					"content": "É só que já faz algum tempo que alguém não faz comida para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "...Ainda assim, você tem os agradecimentos desta. Fazer muito tempo que esta não come algo tão bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110418,
					"content": "Os pequeninos também vão adorar. Você poderia trazer esta refeição para eles também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110419,
					"content": "Já que eu gosto, eles também devem gostar. Talvez eles fiquem mais obedientes depois de comerem uma refeição tão maravilhosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110416,
					"content": "É provavelmente a paixão da pessoa que a fez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
		{
			"id": 7221105,
			"completionStepIds": [
				7221107
			],
