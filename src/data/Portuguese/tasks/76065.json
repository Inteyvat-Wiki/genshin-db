			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Você chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650102,
					"content": "Columbina... você está aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "#É, agora você também chegou, então... somos nós {F#duas}{M#dois} aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650104,
					"content": "Parece que você sabia que eu viria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "Eu não sabia quando, mas sabia que você viria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650106,
					"content": "Assim como a lua e Teyvat sempre foram ligados por uma força gravitacional... você sempre me encontra. Não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650107,
					"content": "Vem, senta aqui comigo — deixei um lugar para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650108,
					"content": "Da última vez, sentamos na sua nave espacial e observamos Teyvat. Desta vez, vamos observar o céu estrelado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650109,
					"content": "Ninnin e os que vieram antes dela foram atraídos por aquelas estrelas. Deve haver uma gravidade especial lá também. Eu consigo sentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650110,
					"content": "Ninnin e a mensagem que ela enviou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Não se preocupe, ela não está em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650112,
					"content": "Ela percorreu um caminho muito, muito longo em segurança — tão longo que já não consigo mais sentir o poder que usei para escoltá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650113,
					"content": "Mas... estou curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650114,
					"content": "Curiosa sobre o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Sobre tudo. Por exemplo, será que as mensagens do Observante da Lua podem ser recebidas por outras pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650116,
					"content": "Quem seriam essas pessoas, ou essas existências, que receberiam as mensagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650117,
					"content": "O que será que elas pensariam? Será que elas também conhecem amor e ódio, como nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650118,
					"content": "Será que elas, assim como nós, mesmo cercadas pelo Abismo, ainda se sentem atraídas por este céu estrelado tão belo e misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650119,
					"content": "Será que elas vão, assim como nós, querer encontrar as outras pessoas, acenar e dizer \"olá, muito prazer em te conhecer\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650121,
					"content": "Será que ainda existem civilizações nas profundezas desse céu estrelado que não foram engolidas pela escuridão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650122,
					"content": "Acredito que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650124,
					"content": "Nossa nave espacial recebeu uma mensagem uma vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Que tipo de mensagem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650126,
					"content": "O conteúdo útil já foi praticamente perdido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Mas com certeza veio de uma civilização inteligente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Perdido... Será que foi porque viajou para muito longe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650129,
					"content": "Mesmo assim, até isso já é suficiente para me deixar feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650130,
					"content": "#Por acaso, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650131,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "Seu lar também está lá no fundo, não está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650133,
					"content": "Mas, se um dia você quiser voltar para o lugar de onde partiu, para dar uma limpeza por lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650134,
					"content": "Eu ficaria feliz em dar uma mãozinha, assim como você me ajudou a limpar a lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650135,
					"content": "Então não vou esquecer de te convidar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "E outra festa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650137,
					"content": "E outra festa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650139,
					"content": "O nome vai ser \"Noite do Retorno\", o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650140,
					"content": "Talvez seja durante o dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "Então vamos comemorar o dia todo até anoitecer. Vamos chamar todos os nossos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650142,
					"content": "Parece bem divertido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Que aquela noite chegue em um dia agradável. Que chegue com a reunião dos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
}