			"dialogs": [
				{
					"id": 710970101,
					"content": "Vocês encontraram alguma Pedra Antiga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970102,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "Com essas três, no total são nove. Devem ser suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970202,
					"content": "Você conseguiu o que o Salão Huishan precisa tão rápido... Não surpreende eles falarem tão bem de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970203,
					"content": "Não foi nada demais! Limão com açúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970204,
					"content": "É \"mamão com açúcar\", Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "Hã? Mas limões com açúcar também são bons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970206,
					"content": "Oh, veja só, você está querendo forçar sua lógica em Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "Haha... Todos nós vimos seus feitos heroicos ao lutar contra o monstro marinho. Não acho que tenha sido desafio algum para você ter feito isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970208,
					"content": "Sim, entendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "Bem, eu não imaginei que entraria no Ministério dos Assuntos Civis. Eles até mesmo pedem para fazer coisas do tipo \"encontre uma Pedra Antiga no Despenhadeiro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970211,
					"content": "Falando nisso, você disse que antes sempre discutia com seu pai, e não tinha um trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970212,
					"content": "Como foi que você entrou no Ministério dos Assuntos Civis depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970213,
					"content": "Você quer saber como eu fiquei devendo tanto na época? Eu não tinha a quem recorrer, nem queria retornar para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970214,
					"content": "No final, os agentes de dívidas vieram procurar pelo meu pai no Salão Shenglu... Eu pensei que ele quebraria minhas pernas ao saber o que estava acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970215,
					"content": "Mas suas pernas parecem normais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970216,
					"content": "Sim... É uma vergonha dizer isso, mas ele pagou minha dívida e veio procurar por mim. Quando me encontrou, eu era quase como um cão que havia apanhado na rua. Ele disse: \"Eu tenho todos os registros de suas dívidas, por isso você agora deve para mim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970217,
					"content": "Com isso, ele me forçou a trabalhar... Para pagar minha dívida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970218,
					"content": "Então seu pai é seu credor agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970219,
					"content": "Oh, isso mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970220,
					"content": "Na época, com os agentes de dívidas atrás de mim, eu sequer conseguia adormecer. Por isso jurei que eu resolveria meus problemas caso tivesse uma segunda chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970221,
					"content": "Mas eu não imaginei que essa chance viria de meu pai, que sempre desaprovou meus comportamentos....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970222,
					"content": "Ele não brigou comigo. Ao invés disso, nós tivemos uma conversa sincera. E eu gostaria de ter tido ela muito antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970223,
					"content": "Mas mesmo que ele estivesse aberto para uma discussão antes, eu não queria ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970224,
					"content": "Parece que seu pai lhe trata bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970225,
					"content": "Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970226,
					"content": "Por isso, não importa o que aconteça, eu tenho que terminar meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970227,
					"content": "Não importa se é um incidente no Despenhadeiro ou procurar por Pedras Antigas para o Salão Huishan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970228,
					"content": "Creio que tenha sido eu que lhe ajudou desta vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "Encontrar alguém para terminar o trabalho também é uma forma de completá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970230,
					"content": "Entretanto, foi graças a vocês que conseguimos terminar tudo tão rápido. Vocês superaram minhas expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710970231,
					"content": "Paimon se sente reconhecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710970209,
					"content": "Foi um pouco difícil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}