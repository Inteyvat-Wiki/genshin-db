			"dialogs": [
				{
					"id": 150050201,
					"content": "Uau, que vista incrível! E até podemos ver alguns Koholassauros aqui e ali! Ei, por que não tentamos tirar uma foto com um ou dois deles na natureza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "Mas e se eles tentarem nos morder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Bem... eles são tão fofos, provavelmente eles não vão fazer isso, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "Hã? O que está acontecendo ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "Socorro! Alguém nos ajude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "Ah! Koholassauros selvagens estão realmente mordendo pessoas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "É hora da gente salvar o dia novamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#É, aqueles dois estão em apuros! {M#O lendário}{F#A lendária} {NICKNAME} e sua companheira confiável, Paimon, não ficarão de braços cruzados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Parece que aquelas fotos que a gente queria vão ter que esperar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "É, podemos deixar isso para depois! Não podemos apenas ficar olhando enquanto alguém está pedindo socorro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}