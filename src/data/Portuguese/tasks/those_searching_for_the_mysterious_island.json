			"dialogs": [
				{
					"id": 150050101,
					"content": "Os Koholassauros derrotados se espalham e fogem.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "Ao julgar pelas suas roupas, vocês devem ser estudiosos de Sumeru, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050103,
					"content": "Sim, sou Karya, e esse é meu sênior, Viramdra. Obrigada por nos salvar. Aquela foi por pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050104,
					"content": "#Não foi nada! Lidar com esse tipo de coisa é praticamente natural para a gente. Paimon é Paimon e {M#esse}{F#essa} é {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050105,
					"content": "*Suspira* Mesmo assim, parece que todos os Koholassauros apenas fugiram... Precisamos capturar pelo menos um vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050106,
					"content": "Hã? Capturar um vivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050107,
					"content": "#Correto. Diga-me, consigo ver que você é bem habilidos{M#o}{F#a} em lidar com eles. Você acha que poderia me usar como isca viva para nos ajudar a capturar um? Pagarei pelo seu tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050108,
					"content": "Hmm, bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050109,
					"content": "Desculpa. Viramdra anda super focado em sua pesquisa, então, por favor, não o julgue tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050110,
					"content": "Oh, sem problemas! Mas por qual motivo você se aproximou de um grupo de Koholassauros selvagens? E que papo é esse de \"capturá-los\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050111,
					"content": "Não me diga que você quer tirar uma foto com eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "Paimon tem certeza que não é isso que estão tentando fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050113,
					"content": "Imagino que devemos parecer bobos... A questão é que estamos procurando por uma ilha misteriosa de uma certa lenda. Dizem que uma pista muito importante sobre a ilha pode ser encontrada nos Koholassauros, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050114,
					"content": "Nos aproximarmos deles sem a ajuda de um guia do Povo das Termas certamente foi uma péssima escolha da nossa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050115,
					"content": "Uma ilha misteriosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050116,
					"content": "Sim. Existe uma lenda do Povo das Termas que menciona uma ilha misteriosa, e Viramdra acredita que a chave para sua pesquisa pode ser encontrada lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050117,
					"content": "Ahem... Vocês têm certeza que não vão considerar minha proposta de capturar um?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050118,
					"content": "#Que proposta, hein... De jeito nenhum estaríamos dispost{F#a}{M#o}s a usar uma pessoa como isca viva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050119,
					"content": "Então acho que continuar falando disso será uma perda de tempo. Preciso pensar em outra solução...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050120,
					"content": "Ahem... Viramdra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050121,
					"content": "Oh, tudo bem... Vocês realmente resgataram Karya agora há pouco e acho que eu deveria demonstrar um pouco de gratidão. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050122,
					"content": "Climão meio tenso, mas Paimon aceita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050123,
					"content": "Deveríamos ir embora, Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050124,
					"content": "Sim, obrigada novamente. Minhas desculpas... Viramdra realmente não é muito bom com pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050125,
					"content": "Está tudo bem, até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050126,
					"content": "Não se vê um par de aventureiros como aqueles dois todo dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050127,
					"content": "Mas, enfim, Paimon está bem curiosa sobre essa ilha misteriosa que aquela moça comentou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050128,
					"content": "Você também quer encontrar a ilha, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "Sim! Quem sabe, pode haver tesouros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050130,
					"content": "Depois de todos os lugares incríveis que exploramos durante nossas aventuras, encontrar uma ilha misteriosa deve ser algo simples para nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050131,
					"content": "Mas não temos nenhuma informação sobre essa ilha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "Ah, você tem razão... a moça mencionou que aquela ilha misteriosa está relacionada a uma lenda do Povo das Termas... Então talvez podemos começar perguntando a alguns deles sobre isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050133,
					"content": "O tempo está passando. Vamos começar nossa próxima aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050134,
					"content": "Planejamos perguntar por aí, mas a verdadeira questão é... a quem deveríamos perguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050135,
					"content": "Podemos apenas falar com o chefe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "Hmm... é uma ideia. Se a gente for atrás de alguém, a chefe da tribo deve saber dos detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
