			"dialogs": [
				{
					"id": 705340101,
					"content": "Por que é que eu tenho que fazer tantas variações para o mesmo jogo de tabuleiro...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "Viajante! Você quer me matar de susto?! Você também veio participar do Grande Torneio do Rei do Chamado Sagrado dos Sete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "O que você tá fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "Oh, este é um jogo criado por um aventureiro da Guilda. Dizem que é um... jogo de tabuleiro novo que combina o Chamado Sagrado dos Sete e combate. É chamado \"Dados Estratégicos\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Já que estamos envolvidos na organização do Grande Torneio do Rei do Chamado Sagrado dos Sete, a Guilda decidiu organizar um minijogo inspirado no design de um aventureiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Como você combina jogos de cartas e combate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Hahaha, para ser honesto, eu mesmo não entendo também. Mas há um livro de regras aqui... Olhe só para a grossura dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Se não me engano, o mecanismo de jogabilidade central dos Dados Estratégicos seria... usar seus dados estrategicamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "Enfim, se você quiser jogar, pode vir aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "Essa é uma combinação muito inesperada...",
					"roleType": "TALK_ROLE_PLAYER",
