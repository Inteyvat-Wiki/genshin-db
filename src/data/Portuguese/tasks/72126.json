					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260302,
					"content": "Eu já afugentei todos eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Obrigado, agora posso continuar a plantar flores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260304,
					"content": "Oh sim, por favor, pegue isso, desculpe, não tenho nada de bom para você... De qualquer forma, obrigado por me ajudar!",
