			"dialogs": [
				{
					"id": 402260101,
					"content": "O Navio-Chefe... Parece que esse participante decidiu resolver a hospedagem primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260102,
					"content": "#Parceir{F#a}{M#o}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260103,
					"content": "Navia! Há quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260104,
					"content": "Aposto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "Isso mesmo. E representando a Spina di Rosula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260107,
					"content": "Chefona do submundo... Sim, confere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260108,
					"content": "Chefona do submundo... Sim, confere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260109,
					"content": "Haha, esse é meu novo apelido? Gostei, soa legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260110,
					"content": "Foi ótimo encontrarmos você! Estamos numa comissão para registrar os participantes. Sabe, verificar as mercadorias, coisas desse tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260111,
					"content": "Oh, entendo. Bem, nesse caso, podem sentar. Pedi um monte de comida. Clorinde e Chevreuse foram desempacotar algumas coisas, mas devem voltar em breve... Haha, falando nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260112,
					"content": "Falando da gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260113,
					"content": "Clorinde! Chevreuse! Vocês também vieram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260114,
					"content": "Nod-Krai é um lugar caótico e perigoso. Considerando a importância da Spina di Rosula para Fontaine, a última coisa que precisamos é que algo aconteça com sua presidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260115,
					"content": "Eu acho prazeroso viajar com amigos, mas, qualé... Olha de quem você tá falando! O que é o pior que poderia acontecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260116,
					"content": "Com essa atitude, sabe-se lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260117,
					"content": "Justo. Pode marcar minha Duelista Representante aqui como minha guarda-costas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260118,
					"content": "Chefe de gangue e sua guarda-costas... Certo. Vamos registrar você também para a exposição, Chevreuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260119,
					"content": "Não. Estou aqui em assuntos oficiais. Muitos de nossos casos recentes têm algo a ver com Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260120,
					"content": "Certo, Paimon entendeu que é pra fechar o bico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260121,
					"content": "Oh, e mais uma coisa! O que a Spina di Rosula tá pensando em vender na exposição?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260122,
					"content": "Isso aqui! É uma das novas invenções do Instituto de Pesquisas de Fontaine. É um tipo de sistema de relé que permite que o usuário lance Pneuma e Ousia em batalha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260123,
					"content": "Então... é uma arma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260124,
					"content": "Claro! E como esse é um mercado que não é supervisionado, armas vão vender como água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260125,
					"content": "Paimon acha que sim... Ainda assim, se gabar disso na frente de Chevreuse é meio estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260126,
					"content": "Eu não me importo. Já li vários romances sobre territórios sem lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260127,
					"content": "Como detetive, eu sei que vou precisar deixar as regras de lado por enquanto se quiser fazer as coisas por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260128,
					"content": "E, com isso, vou voltar ao trabalho. Tenho membros de patrulha esperando por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260129,
					"content": "Bem, prontas para irem ao local? Basta nos seguir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260130,
					"content": "Certo, vamos nessa! Eu quero fazer umas comprinhas no caminho também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260105,
					"content": "... Que você tá aqui pela exposição?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
