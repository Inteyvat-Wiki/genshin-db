			"dialogs": [
				{
					"id": 402260201,
					"content": "Você leva Navia e Clorinde para o local.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Uau, é ainda maior do que eu esperava. Espero que mais pessoas compareçam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260203,
					"content": "Vai ficar mais animado quando as coisas começarem. Ainda assim, parece que Jahoda precisa de muita ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260204,
					"content": "Bem, eu e Clorinde estamos prontas. Passem na nossa loja quando tiverem a chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
