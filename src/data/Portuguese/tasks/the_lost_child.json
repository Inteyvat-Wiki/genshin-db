					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "Personificação de Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Sim. Ela faz coisas por Marana na terra... É uma coisa alta e escura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana... Que nome estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Uhum... Como eu saberia que Marana era o Definhamento? Que droga... Tudo está girando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Iotham, o que era aquela coisa verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "Era Ararakalari... Pode proteger as pessoas da corrosão de Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Estou entendendo cada vez menos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "É... É um tipo de magia da floresta... É também é um tipo de música... É um Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Não se preocupe com isso, Rana, você precisa descansar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Está na ponta da minha língua, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "Me desculpa Rana, me desculpa... Eu não vou mais sair por aí correndo, vou me comportar e ficar em casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Eu sei. Você se tornará inteligente, saudável, e saberá o que é certo e errado... Assim como quais cogumelos pode comer ou não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "Eu sei, eu sei, me desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Sabendo que \"Marana\" é ruim e que a floresta é boa... tornando pessoas fortes, decentes e ajudando os necessitados... como {NICKNAME} e Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "Não se esqueça... A floresta se lembra de tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Oh não, parece que Rana está piorando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Vamos procurar ajuda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Hã? Oh, eu estou bem... É sério, só preciso descansar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, por favor... Leve Iotham de volta por mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Sim, vamos Iotham. Rana, não saia correndo por aí! Nós retornaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, espere por nós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "Não pense nisso, descanse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
					"id": 730030823,
					"content": "Personificação de Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030824
					]
				},
				{
					"id": 730030824,
					"content": "Sim. Ela faz coisas por Marana na terra... É uma coisa alta e escura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030825
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030825,
					"content": "Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
