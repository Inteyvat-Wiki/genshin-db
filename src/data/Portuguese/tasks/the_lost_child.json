			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Me desculpem... {NICKNAME}, Paimon, eu preciso descansar... Iotham, espere por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030802,
					"content": "Rana, você realmente está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "Nós vamos procurar ajuda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "Está tudo bem, eu só preciso... Descansar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030805,
					"content": "Desculpe, Rana, desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "É sério... Eu já disse que estou bem! Só estou irritada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030807,
					"content": "Você prometeu... Que não ia para floresta. Espere eu descansar que vou lhe dar uma lição... Sobre quebrar promessas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030808,
					"content": "*Choro*... Eu ouvi Alphonso dizer que os cogumelos aqui são gigantes! Eu só queria trazer alguns cogumelos frescos para você comer... Para você ter mais força...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Oh, seu tonto... Você não precisava fazer isso. Só de pensar em vocês eu já fico com forças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030810,
					"content": "Ainda assim, hahaha... Os cogumelos daqui são enormes... Eles combinariam muito bem com curry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030811,
					"content": "Foi Alphonso que mandou você vir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "Não... Alphonso me disse que não devíamos sair correndo por aí. Mas eu queria dar a Rana algo gostoso para comer... Por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "Alphonso não faria algo assim, ele é o irmão de Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030814,
					"content": "Paimon entende... Mas, Iotham, como você ficou preso no Definhamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "Quando eu estava na floresta, senti que alguém estava me seguindo... Fiquei com muito medo, pensei que era a Personificação de Marana... Por isso eu corri... *Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "Eu acabei correndo para dentro da Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
