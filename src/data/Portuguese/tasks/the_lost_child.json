					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030607,
					"content": "Vamos segui-las... Talvez sejam pistas que Rana deixou para nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
