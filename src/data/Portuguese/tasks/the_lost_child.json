					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Sim. Nara inteligente. Ararakalari pode resistir Marana.",
