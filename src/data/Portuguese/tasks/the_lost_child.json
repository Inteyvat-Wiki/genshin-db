						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Rana... *Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... Está tudo bem, rapazinho, não há motivo para chorar. Olha... Se eu puder contar a eles sobre o que senti no Definhamento... para aqueles pesquisadores da Academia... eles poderão cuidar do Definhamento de uma vez por todas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#E... Você viu? Viu como eu luto? Não, viu como {NICKNAME} luta? Você deveria agradecê-l{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Não precisa falar mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rana, descanse um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Hahaha, tudo bem... Eu só estou me sentindo um pouco tonta e cansada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Rana, desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "Do que você está falando? Você é meu pequeno tigre, não chore! Você está bem, não está? Você está sentindo dor, Iotham? Se sentindo tonto, ou fraco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Eu estou bem, mas Rana, você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Não se preocupe, eu estou bem. Afinal, eu sou uma Patrulheira Florestal guerreira! Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
