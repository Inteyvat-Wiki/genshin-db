					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#Droga! {NICKNAME}, vamos fazer isso junt{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
