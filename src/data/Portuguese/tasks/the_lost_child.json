					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "O que foi isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Paimon ouviu eles dizerem que podia resistir a corrosão Marana ou algo assim... Tinha um nome estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "É Ararakalari. Pode lutar contra Marana. Não é um nome estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
