				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "Alguém me enviou para encontrar alguns livros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Você descreve os livros que Citlali quer para Kuroda.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "A primeira edição de \"Toda-Poderosa Shogun: Reencarnada como Raiden com Poderes Ilimitados\" e a edição limitada de luxo de \"Por Favor, Minha Kitsune Guuji?\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Devo dizer, seu amigo claramente entende do assunto. Em termos de valor de coleção, nada que a Editora Yae está publicando atualmente pode rivalizar com os livros que você está procurando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "#Pensar que não conheço um{F#a} leitor{F#a} tão perspicaz... É realmente lamentável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Ainda estão disponíveis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Você não encontrará nenhum dos dois no mercado aberto, e certamente não em estoque. Cada exemplar foi adquirido há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "No entanto, eu tenho uma cópia de cada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Posso pagar por elas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "Não, não. Esses livros ficariam muito melhor nas mãos do seu amigo, alguém que possa apreciar seu verdadeiro valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Sabendo disso, ficaria mais do que feliz em entregá-los a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
