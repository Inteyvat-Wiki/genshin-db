			"dialogs": [
				{
					"id": 790490101,
					"content": "Por que um diário está escondido em um canto como esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790490102,
					"content": "Então foi Idyia que deu aquela tabuleta de pedra gigante para esse pintor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790490103,
					"content": "Sim. Ao que parece, ele encontrou uma bela paisagem na Miragem Veluriyam, e se tornou amigo das Gotinhas, encontrando assim uma nova fonte de criatividade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790490104,
					"content": "Tivemos sorte de encontrarmos isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Sim! Se você não tivesse dito, eu não teria pensado nisso. Parece alguém forte, e que depois de ter sido golpeado, enlouqueceu. No final, a pessoa está irreconhecível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 790490107,
					"content": "Ótimo, ótimo... Graças aos instrumentos que Idyia deu, e com as Gotinhas acompanhando, ele não se perdeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ler"
				},
				{
					"id": 790490105,
					"content": "Foi melhor que praticar tanto até enlouquecer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
		},
