				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "Você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360302,
					"content": "Estava ventando muito lá em cima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Ótimo, é isso que queremos. É por isso que as sementes de dandelion podem voar tão longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360304,
					"content": "Talvez elas realmente cheguem até o Godwin e transmitir tudo o que queremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360305,
					"content": "Me dê a sua mão... Aqui, pegue isso como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360306,
					"content": "Ainda tem muita coisa que eu queria dizer ao Godwin. Talvez eu precise da sua ajuda novamente no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		}
	]
