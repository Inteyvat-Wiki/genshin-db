			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "...Vamos, Godwin... Por que você está demorando tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Olá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "Eu conheço essa voz... É a voz do Viajante de longe? Graças ao Arconte Anemo, com certeza o vento está aqui para guiá-lo neste lugar. Tenho um pedido para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Meu, erm... Namorado, Godwin, ele está nos Cavaleiros de Favonius. Ele deixou a cidade anos atrás e nunca retornou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "Eu nunca ouvi nenhuma palavra dele desde que ele foi embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Estou muito preocupada com ele. Pobre Godwin, e se ele se encontrar com aqueles Hilichurls malditos? Ou, se ele tiver se machucado na guerra com a Ordem do Abismo? E... E, agora que ele está longe por tanto tempo e acabar gostando de uma daquelas cavaleiras charmosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "Des... desculpe! Eu me deixei levar pelos meus sentimentos. Minha mãe sempre disse que os Dandelions podem carregar os desejos dos corações das pessoas para um lugar distante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Então, o meu pedido é... Você poderia coletar três sementes de dandelion na Origem do Vento para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Muito obrigada! Que o Arconte Anemo o proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "Ainda tenho outro assunto para tratar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "Espere! Por favor, me ajude! Isso certamente vai ser moleza para um Viajante como você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
