			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "Você voltou! Você trouxe minhas sementes de dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Sim. Sim, estou com elas bem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Obrigada! Você pode por favor colocar nas minhas mãos? Eu não consigo enxergar, eu iria acabar as perdendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "Isso é suficiente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Você poderia colocá-las nas minhas mãos? É a única maneira que posso saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Isso é o suficiente. Agora contarei a elas tudo que quero falar para Godwin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "Err... cubra seus ouvidos, por favor. Nada de espiar! Estas são palavras particulares compartilhadas entre amantes. Você sabe... *risadinha* Você deve ter tido uma experiência similar antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Está bem. Agora leve isso para o topo da estátua do Arconte Anemo e solte-as ao vento. O Grande Arconte se encarregará do resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Espero que Ele as guie até o Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
