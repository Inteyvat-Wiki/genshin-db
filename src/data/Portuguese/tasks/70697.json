			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Que surpresa, encontrar você em Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Nunca estive em nenhum lugar com um clima assim antes. É tão frio! Mas uau, que experiência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "Tive minha primeira luta de bolas de neve, construí meu primeiro boneco de neve... Oh, e os quadrinhos são uma boa surpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "A Saga da Alma Flamejante é super popular em Inazuma, mas eu não esperava encontrar tantas pessoas que leem ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "Tive uma boa conversa com alguns fãs de Natlan agora há pouco. Isso realmente me inspirou, então... eu acabei criando uma placa de personagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "...Desculpe, deixe-me voltar um pouco atrás. Você já ouviu falar sobre A Saga da Alma Flamejante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Discutiu com Yoimiya sobre o \"Legião das Almas Flamejantes\"...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Não acredito! Seus amigos também gostam dela? Que coincidência engraçada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Nesse caso, deixe-me te dar essa placa de personagem da Fietena. Ela vai se sentir em casa na Legião das Almas Flamejantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
