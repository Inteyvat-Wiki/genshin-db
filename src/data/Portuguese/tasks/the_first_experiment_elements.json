			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Paimon tem uma pergunta. Depois que a semente brotar, ela se transformará em alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Não sei, mas sinto que a importância estará no método, não no resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Usar a alquimia para despertar uma vida de outro mundo em Teyvat seria um grande salto na minha compreensão da essência da vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Após a despertar, até a criação pode ser possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Haha, ainda é um pouco difícil de entender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "N—Não! Paimon tem cérebro! Mas o que a semente vai se tornar? Não é mais interessante do que tudo o que você estava dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Não parece que você entendeu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Bem, se virar uma fruta deliciosa, o jantar é por minha conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Oba! Paimon ficará de olho em você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Você sabe mesmo como manter Paimon animada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Bem, digamos que eu... Ocasionalmente cuido de uma criança. Outra explicação longa, receio. Suponho que seja uma das poucas habilidades não relacionadas à alquimia em que sou bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "O assunto da minha primeira pesquisa foi os elementos. Neste mundo, manipular os elementos requer uma Visão, embora eu não consiga ver em você nada que me lembre uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "Gostaria de averiguar como você consegue manipular livremente a Energia Elemental. Tenho algumas perguntas a esse respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "Em primeiro lugar, você tem órgãos extras? Um segundo coração, um quarto estômago, você sabe... Coisas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "Não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Fascinante. E essa criança flutuante está... Conectada ao seu corpo de alguma forma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Que pergunta estúpida! Não consegue ver o espaço entre nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "E outra coisa, é PAIMON! E não criança flutuante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Eu estava apenas considerando a possibilidade de você ser um órgão externo. Talvez haja alguma força invisível conectando vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Conheci Paimon em minhas viagens.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Oh, isso descarta essa possibilidade. Eu me pergunto se Paimon envia Energia Elemental para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Mas isso significaria que a Energia Elemental de Paimon seria suficiente para romper rochas da montanha com pelo menos dez metros de espessura. Ou fazer com que a cachoeira ao sul do Vale Termal flua para cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Hmm. Não, definitivamente não pode ser isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Paimon não falou nada sobre isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "Nesse caso, parece que não há nenhuma diferença óbvia entre a composição do seu corpo e a dos humanos neste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Dado que há claramente uma discrepância na pesquisa, parece que apenas alguns experimentos produzirão as respostas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Em primeiro lugar, essa misteriosa Energia Elemental. Gostaria de examinar como ela se manifesta externamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Deixe-me atrair alguns slimes para a área. Talvez consiga derrotá-los usando qualquer método que seja mais natural para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Hum, não parece muito \"científico...\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Observação direta e clara é fundamental para um bom experimento. Esse é apenas um exercício simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Naturalmente, se você precisar de um desafio maior, poderíamos arranjar seis Oceanids.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Slimes! Prefiro Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Eu não entendo. Isso parece entediante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Bem, prepare-se. Os Slimes estarão aqui a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Contanto que eu não seja enganado por imitadores de Hydro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Peguei Paimon com uma vara de pescar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Não que eu saiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Descobriu os motivos particulares de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "É isso que eu quero saber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "Ótimo trabalho, você sentiu algo fora do comum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "#Se estiver ferid{F#a}{M#o}, tenho algumas poções de emergência prontas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Nem um arranhão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Excelente. De acordo com minhas observações, a manifestação do fluxo elemental externo era esperado, as reações elementais são normais. Não há nada fora do comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Agora que sabemos que o fluxo externo está se manifestando normalmente, vamos testar o fluxo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "Fluxo interno... Como você testa isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "É muito simples. Posso usar a alquimia para criar uma poção que extrairá a Energia Elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Se a Energia Elemental estiver armazenada ou acumulada fisicamente dentro de seu corpo, essa poção pode gerar uma reação elemental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Isso deixará meu estômago revirado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Parece assustador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Não se preocupe. No decorrer normal dos eventos você sentirá um mal-estar temporário, sem ferimentos corporais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "E no decorrer anormal dos eventos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Se acontecer algo inesperado, tenho os preparativos necessários. Não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Isso não é muito reconfortante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Bem, não é que não haja riscos envolvidos. Mas se houver algo bloqueando seu fluxo elemental, conseguiremos localizá-lo com esse teste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Apenas um aviso: se uma reação elemental interna ocorrer por qualquer outro motivo, isso é um mau sinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "É como um exame médico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Sim! Essa é uma excelente maneira de pensar sobre isso. Antes de começarmos, a poção que usaremos para o teste está sem um catalisador. Precisamos encontrá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "É um tipo de minério conhecido como Minério de Prata Estrelada, mas infelizmente nem todo ele é adequado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Eu levarei vocês até o meu acampamento, nós podemos pegar um pouco de Minério de Prata Estrelada no caminho. Eu apontarei quando encontrarmos um catalisador adequado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Se tudo ocorrer conforme o planejado, começaremos a preparar a poção quando chegarmos ao acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "Paimon ainda tem algumas preocupações sobre sua segurança, mas parece que há um lado positivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Vamos nos manter alerta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Vai se cristalizar no meu estômago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Só um pouco de frio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Este é meu acampamento. Eu adicionei os materiais que coletamos à mistura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Enquanto esperamos, dê uma olhada aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Meu assistente Timaeus está me ajudando com a pesquisa. Suponho que já se tenham conhecido em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Olá, acabei de obter os dados do seu experimento. O relatório já está lá no quadro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Uau! Veja todos os dados! Você conseguiu esses resultados após uma única luta com Slimes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Haha, eu não os chamaria de resultados. Inferências e algumas suposições ousadas, talvez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "#Acho que a direção mais racional seria expor a relação filogenética entre est{M#e}{F#a} Viajante e os Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "Racional?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Pense bem: você não tem uma Visão, mas pode manipular a Energia Elemental. Os Slimes também não têm Visões, mas também podem manipular os elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Seguindo essa linha de pensamento, tenho certeza de que conseguiremos estabelecer um fundamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "Nada mal para o início, mas estritamente falando, Slimes são formas de vida elementais. Em outras palavras, seres constituídos inteiramente de elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Um Regisvine Cryo, ou mesmo uma Flor Gigante, seria uma analogia melhor. Mas rastreando as relações filogenéticas entre plantas e animais... Pode-se até chegar às origens do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "Nesse caso, as coisas podem ficar difíceis, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Uh! Sim, senhor. Está correto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "#Afinal, já temos nossos dados primários. Est{M#e}{F#a} Viajante é {M#um}{F#uma} visitante de outro mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "#Se descobríssemos que {M#ele}{F#ela} tem uma relação filogenética com este mundo... Isso seria algo muito importante, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "Ahhhh, seria! Desculpe, eu estava muito animado para obter os dados. Ficarei um pouco mais tranquilo da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "Falando em dados - para concluir nossa pesquisa, precisaremos de mais alguns. Farei uma análise aqui por enquanto. Se estiver interessado em uma atualização, venha me encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Ótimo, vou deixar você cuidar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Parece que a poção está pronta, vou experimentar um pouco primeiro. Se tudo correr bem, darei para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "Pensei que Paimon era a mais próxima de mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
