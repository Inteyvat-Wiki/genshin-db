			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "Acabei de experimentar um pouco, está de acordo com as minhas expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420602,
					"content": "Lembre-se de manter a calma o tempo todo e respirar profundamente caso não se sinta bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420603,
					"content": "Vou anotar todos os resultados observáveis e pontos de dados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Que tal? {NICKNAME}, você está com uma expressão engraçada no rosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "Está... Queimando um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "Você disse que havia experimentado antes! Tem certeza de que estava pronta? O que aconteceu com ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Hmm? Ah, esse era o resultado que eu esperava, e muito positivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Esta poção canaliza a Energia Elemental para o corpo. Em circunstâncias normais, uma reação de repulsão é esperada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Mas se o fluxo elemental interno estiver desobstruído, você sentirá apenas um desconforto momentâneo. Depois que o fluxo for concluído, não haverá nenhum outro efeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Então você sabia que se sentiria mal e mesmo assim bebeu um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Hehe, é a minha própria invenção, nada mais lógico do que eu ser a cobaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Sem ao menos... Pensar no objeto do teste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "#De forma alguma! Você é {F#minha assistente}{M#meu assistente}. Com razão, seria errado da minha parte colocar você nesse risco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "Enfim, acho que temos nossa conclusão! Sobre a Energia Elemental, você não é diferente de ninguém neste mundo, nada em peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Paimon queria que algo mais legal acontecesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Então, novamente, é melhor um resultado comum do que um resultado peculiar. Os resultados peculiares tendem a ter uma... Variedade indesejável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Estranhamente específico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "O bom do \"comum\" é que tudo é um objeto de referência e todos te entendem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "As pessoas são iguais. Elas podem ser compreensivas, ter empatia, encorajar e apoiar umas às outras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Quando você está doente, um médico pode te diagnosticar porque ele é como você. Quando algo dá errado, você pode perguntar às pessoas que cometeram o mesmo erro sobre a experiência delas, porque você é como delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Mas uma pessoa peculiar... Ela não se parece com as coisas que consideramos normais. A essência de sua vida é fundamentalmente diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Por exemplo... Um humano não consegue entender a vida de um Regisvine Pyro ou de um Olho da Tempestade. Expliquei com clareza suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Acho que estou entendendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "Em suma, foi um resultado positivo. Daqui para frente, você pode usar sua Energia Elemental sem medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, os resultados do novo experimento foram divulgados. Se puder compará-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Um momento, senhor! Eu cuido disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Você me deu muito o que considerar, realmente ultrapassou meus limites. Estou pensando com muito mais clareza agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Ter achado que você era um animal não foi muito preciso da minha parte, mas começar com a premissa de uma forma de vida elemental!? Isso foi-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Nada mal. Acho que é uma linha de investigação interessante. Seja qual for a verdade, coloco a pesquisa em primeiro lugar em vez do meu julgamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Pode contar comigo, senhor! Alcançarei um resultado satisfatório a todos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Ele está tentando se juntar aos Cavaleiros? Com certeza parece estar animado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Err... O que Paimon quis dizer foi... Esse é o espírito! Sr. Albedo... Diga alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Hmm... Antes de prosseguirmos com nossa pesquisa, preciso... Preparar algo. Espere um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "#Se estiver interessad{M#o}{F#a}, por que não dá uma olhada? Pode ajudar a passar o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Ainda parece... Estranhamente específico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "E quanto ao seu risco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Talvez seja apenas autoconfiança acadêmica e certamente acelera as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Quero ver você beber um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
