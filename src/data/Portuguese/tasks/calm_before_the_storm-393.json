			"dialogs": [
				{
					"id": 3930101,
					"content": "Estou pensando em escrever essas aventuras em canções depois que terminarmos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930102,
					"content": "Bem... Nós certamente já passamos por muitas ultimamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "Felizmente, essa música será cantada nos próximos anos pelo povo de Mondstadt, assim como a Lenda de Vennessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930105,
					"content": "Sempre gostei desta canção desde quando era pequena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930106,
					"content": "#{NICKNAME}... Como você está se sentindo hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930107,
					"content": "Estou preparada e muito confiante de que vamos conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3930108,
					"content": "A Mestre Jean é tão confiável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "Até mesmo o Mestre Diluc nos acompanhou até o fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930111,
					"content": "Apesar de apenas estar envolvido acidentalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930112,
					"content": "Por acidente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930113,
					"content": "Você compartilhou seus segredos comigo e eu retribuirei com a minha confiança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3930114,
					"content": "Então, foi a \"confiança\" que trouxe Diluc até aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "E a para a Mestre Jean foi \"responsabilidade\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930116,
					"content": "E quanto ao Bardo Desafinado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930121,
					"content": "É a \"liberdade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930122,
					"content": "Liberdade...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930123,
					"content": "Quando você chegou a Mondstadt, ninguém lhe disse que Mondstadt é a Cidade da Liberdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930124,
					"content": "Amber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "Hahaha... Ela realmente é uma filha da liberdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930126,
					"content": "Mondstadt é uma cidade romântica sem o reino de um rei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930127,
					"content": "Seus cidadãos usufruem a liberdade entre os sete países.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930128,
					"content": "Espero que o dragão que protegeu Mondstadt também esteja livre em breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930129,
					"content": "Ninguém deveria tê-lo enganado, lhe dizendo que Mondstadt o traiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930130,
					"content": "E também ninguém devia ter dito que sua missão eterna era proteger a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930131,
					"content": "Ele tem o direito e a liberdade de escolher o que fazer da sua vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930132,
					"content": "Venti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930133,
					"content": "#Bem, {NICKNAME}, que o vento de Mondstadt que tem soprado por milênios esteja com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930134,
					"content": "Assim como aquela vez, eu vou canalizar o elemento Anemo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3930135,
					"content": "Você disse \"aquela época\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "#Então foi isso! Foi por isso que {NICKNAME} disse que sua voz era muito familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930136,
					"content": "Eu sabia! Foi a sua voz que ouvi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "Então, é a \"responsabilidade\" o que move a Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "Quanto à razão de Mestre Diluc, foi a \"confiança\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930119,
					"content": "E quanto ao Bardo Desafinado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3930120,
					"content": "E o Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "#Não se preocupe, eu também estou pront{M#o}{F#a}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "Somos praticamente velhos colegas agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
