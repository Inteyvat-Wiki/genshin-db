			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Itsaho",
					"Masose",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2893.348,
							257.691,
							9926.251
						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "Ei, você aí! Pa—Pare! Esse material é nosso! Tire as mãos! Estou te avisando...! E—Eu totalmente poderia me qualificar para a Guerra da Guarda Noturna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "Tente levar as nossas coisas, e eu vou... eu vou te ensinar uma lição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*Suspiro*... O que está acontecendo hoje? Primeiro a erupção vulcânica, então um Tepetlissauro roxo... e agora um monte de bandidos? Que má sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "#Masose, {M#ele}{F#ela} parece bem forte. Eu não acho que conseguimos derrotá-l{M#o}{F#a}. Além disso, estamos aqui apenas para assistir à competição, não para nos envolvermos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "C—Como você pode dizer isso, Itsaho? Essas são NOSSAS coisas! De qualquer forma, são dois contra um aqui. Podemos realmente ter uma chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "De onde você tirou esses \"dois\"? Se alguém vai ser derrubado, vai ser só você. Não me meta nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "#Uh, ei, {M#Senhor}{F#Senhorita}, nós não queremos mais essas coisas. Se você quiser elas, pode levar. Só não nos machuque, tá bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Deve ter algum mal-entendido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "Vocês entenderam errado! Na verdade, somos aventureiros que ajudam os outros, não uns vilões aleatórios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "E por que deveria acreditar em voc— Ai! Por que você me bateu, Itsaho!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "#Se {M#eles}{F#elas} estivessem tramando algo ruim, já teriam derrotado você. Por que perderiam tempo conversando com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "Para ser honesto com vocês, nossa caravana se dispersou recentemente. Se não for muito incômodo, vocês poderiam nos ajudar a passar uma mensagem para nossa chefe? Apenas diga a ela que estamos esperando por ela aqui — nós ficaríamos realmente muito gratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Você pode levar as coisas da caixa — considere isso como nosso agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "Oh, isso é fácil! Deixe isso conosco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Hum, você é muito inteligente, não é mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "Ei! Não faça parecer como se fossemos os caras malvados aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
