			},
			"dialogs": [
				{
					"id": 751790901,
					"content": "Oh não, Itsaho, ainda há tanta coisa faltando da lista... M-Me ajudaria a procurar por eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*Suspiro*... Não perca seu tempo. Já chequei. A maioria eram mercadorias frágeis. Você realmente acha que algum deles continuam intactos depois da erupção e da batida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Conserve sua energia e faça uma pausa. Ainda temos um caminho longo pela frente quando o chefe e os outros voltarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "D-De jeito nenhum! T-Tá, se você não vai, irei sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
			]
		},
