			"dialogs": [
				{
					"id": 751791301,
					"content": "Ei, gordinho! Garantir a segurança da caravana é o seu trabalho, não é? Então qual é a dessa de outra pessoa ter que limpar sua bagunça? O que você tem a dizer sobre si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791302
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791302,
					"content": "Eu-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791303
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791303,
					"content": "#Pare de gaguejar! Se você não tivesse entrado em pânico e abaixado a guarda, alguns monstros quaisquer não teriam sido problema para mim! Dessa vez, você vai dar parte do seu pagamento para noss{M#o salvador}{F#a salvadora}. Entendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791304
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791304,
					"content": "E-Eu... Farei o que você mandar, chefe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
