			},
			"dialogs": [
				{
					"id": 751791101,
					"content": "O que vou fazer... O que vou fazer? A chefe definitivamente vai me dar uma surra quando eu voltar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*Suspiro* É uma longa história... Nossa caravana estava indo bem, quando o vulcão entrou em erupção do nada. Então, aqueles Tepetlissauros gigantescos saíram do chão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Eu não estava prestando atenção, e meu companheiro Sauriano se assustou e me arrastou para longe do grupo. Até eu conseguir voltar, o caminho estava completamente bloqueado, e agora não consigo voltar para os outros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "Eu nem sei como estão os outros... e eu larguei o grupo sem permissão... A chefe vai acabar comigo. É o fim. É isso. Estou morto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Se fosse eu, apenas correria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Correr? Não, não, não, isso é impossível. A chefe é como o Reino da Noite — por toda parte, o tempo inteiro. Ela vai me caçar e me arrastar de volta não importa para onde eu vá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Tenho que voltar e me desculpar. Mas, como? A estrada está bloqueada... Urg, dessa vez estou morto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
		},
