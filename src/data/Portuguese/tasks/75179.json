					{
						"sceneId": 3,
						"position": [
							-2984.694,
							282.976,
							9964.69
						],
						"pointId": 10984
					}
				]
			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Claro, uma lembrança tão pequena como um presente por ter salvo a minha vida parece um pouco mesquinho, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "De fato, parece que falta algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Haha, muito bem dito! Gosto de pessoas como você — que dizem as coisas como elas são!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "Cof, enfim, isso é um presente pessoal meu para vocês. Aceite! Considere isso como uma coisinha extra para seu pequeno Tepetlissauro ganhar mais alguns petiscos. Não há necessidade de agradecimentos ou de formalidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Tá, ainda precisamos ir pegar todas as coisas que perdemos pelo caminho. Vamos andando! Espero que nos encontremos novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "Não, isso já é o suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "#Tsc, você não é mesmo muito honest{M#o}{F#a}, não é? Isso não é divertido. Apenas aceite isso logo! Caso contrário, se a notícia se espalhar, as pessoas vão me chamar de pão-duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
		{
			"id": 7517904,
