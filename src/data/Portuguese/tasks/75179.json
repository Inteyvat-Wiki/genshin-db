				]
			},
			"dialogs": [
				{
					"id": 751790601,
					"content": "Ufa... que bagunça lidar com eles. E pensar que quase fui derrotada por alguns Tepetlissauros... Isso me ferve o sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Vocês entenderam tudo errado — aqueles são monstros abissais! Eles são bem mais perigosos do que Tepetlissauros. Então vocês acharam que eles eram só comuns... Não é à toa que tiveram dificuldade!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Haha, então foi isso? Agora faz sentido. Eu realmente te devo uma. Se não fossem por vocês, eu estaria acabada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Espera um segundinho aí, preciso ir juntar aqueles idiotas inúteis primeiro. Te agradecerei melhor depois que eu garantir que estarão todos bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Com sua ajuda, as pessoas da caravana se reúnem gradualmente.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
