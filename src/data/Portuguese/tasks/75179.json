				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "Ei! Você, sim, estou falando com você! É perigoso aí fora, entre, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "Você não viu a bagunça pelo caminho? Teve uma erupção vulcânica, e há monstros bloqueando a estrada. Você não deveria ir mais longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Me escute. Fique aqui por um tempo e espere. Logo, você poderá sair com o resto da caravana. Dessa forma, podemos cuidar um do outro. Caso contrário, é bem perigoso ir sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Monstros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "É, tem um grupo inteiro de Tepetlissauro roxos! Eles foram claramente corrompidos pelo Abismo! Absurdamente destrutivos. Honestamente, nunca vi nenhum da raça deles sendo tão assustadores assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Estou falando sério, aquelas coisas casualmente balançaram seus rabos e destruíram nossas carroças. Eles são até mais fortes do que Tantakassauros — definitivamente não são o tipo de oponentes que qualquer um pode lidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Sério — não fique de cabeça quente e tente lutar contra eles. Se os vês, apenas se afaste, entendido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Sem problemas, vou ficar bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Você, *Suspiro*... Está bem, apenas tenha cuidado por aí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
