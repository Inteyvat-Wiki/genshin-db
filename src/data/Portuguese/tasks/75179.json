			"dialogs": [
				{
					"id": 751790701,
					"content": "Então, foi tudo graças a esses três que você conseguiu sair em segurança, chefe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, isso mesmo! Você devia ter os visto em ação — derrotou aqueles monstros em apenas alguns golpes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Você salvou a capitã. Essa é uma dívida que não tenho muito a oferecer como pagamento. Mas, por favor, aceite esse pequeno presente como uma demonstração de minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Sério, Tizlo? Você foi sempre mesquinho assim? Isso é tudo que você tem a oferecer para as pessoas que salvaram sua vida!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
		},
