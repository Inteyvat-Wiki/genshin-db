			"dialogs": [
				{
					"id": 718291401,
					"content": "Vou provar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291402,
					"content": "Hum, esse sabor... É muito delicioso! Mas parece tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291403,
					"content": "A aparência também é boa, foi feito de forma delicada, esse \"prato em que não se vê a carne\" realmente engana as pessoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291404,
					"content": "Ótimo! Ótimo! O lojista com certeza gostará dessa comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291405,
					"content": "Não imaginei que alguém como você, que gosta de comer de graça, se lembraria tão bem dessa receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291406,
					"content": "Haha, essa história é bem engraçada. Antes eu acreditava que existia uma técnica de esgrima escondida nessa receita, e por isso fiquei estudando ela dia e noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Hoje eu penso que quando estava treinando esgrima, na verdade eu era apenas um fanático por ela. Era só uma receita, nada mais. Onde será que poderia ter algo de esgrima nela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "E naquela época, você praticava esgrima para...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Encontrar uma pessoa e exigir justiça, somente isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "Claramente isso é algo importante, como você pode falar que não é nada demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291411,
					"content": "Haha, depois que consegui minha justiça, vim até aqui. Felizmente, o dono decidiu me ajudar, e me deixou ficar aqui como alguém ocioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Nesse momento, não tenho nenhum desejo, já não posso brandir minha espada, nem tenho outros talentos... Haha, gostaria de passar o resto da minha vida aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Então, vou dar a você uma cópia dessa receita. Se você tiver tempo, também pode fazer ela e comer. Apesar de ser exaustivo, o sabor é muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "#Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Uh.. Coloque essa comida ali no lado. Quando o dono vier, eu entregarei para ele dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291418,
					"content": "E depois... Ei, parasita, pare aí, você não vai embora, volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291419,
					"content": "O que você quer fazer? Eu não tenho outras receitas para lhe dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Você não disse que, com exceção de esgrima, não sabia fazer mais nada? Venha, pegue essa espada, eu lhe ensinarei como cortar carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291421,
					"content": "Cortar carne? Mas... Eu temo que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291422,
					"content": "Venha logo. Primeiro aprenda a cortar carne, depois a cozinhar. Depois que aprender a fazer alguns pratos, já pode dizer que possui uma habilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291423
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291423,
					"content": "Você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291424,
					"content": "Hmph! Eu vou te ensinar cozinhar o mais rápido possível para que você pare de vir comer de graça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291425
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291425,
					"content": "Rápido! Rápido! Se você continuar enrolando, nem pense que terá almôndegas para comer amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291426
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718291426,
					"content": "Ó chef! Você está me ameaçando? Está bem, eu corto! Assim você fica satisfeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291415,
					"content": "Você ainda estará esperando aqui?",
