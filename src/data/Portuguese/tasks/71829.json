			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "Ei? Que raridade! Normalmente só tem nós dois, eu e o chefe, como você também está por aqui, deve ficar mais animado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Mas eu estou vendo que o chef parece estar preocupado. Será que ele encontrou alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Yanxiao Sorridente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Essas almôndegas realmente são saborosas! A carne é bastante macia e a sopa é extraordinariamente aromática...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Uh? Você até colocou um caranguejo na carne? Não é de se admirar que a carne é bem saborosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "Viajante, venha provar! Olha, abra a almôndega com pauzinhos, coloque um pouco de molho, e coma junto com o arroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "#Obrigad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Bom apetite para vocês. Comam mais antes que eu seja despedido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290410,
					"content": "Você vai ser despedido? Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Será que é por causa de mim? Eu tenho comido sem pagar... E isso irritou o dono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "Não deve ser por causa disso, já que pesquei alguns peixes e entreguei diretamente para o restaurante. Isso deve ser o suficiente para pagar as minhas comidas aqui. E o dono, ao que parece, não é uma pessoa mesquinha assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Cale a sua boca, por favor. Os seus peixes sempre acabaram sendo a sua própria comida, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290414,
					"content": "Por que você será despedido, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "Ugh... Vou te contar tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290416,
					"content": "Um prato com bom sabor, boa aparência e bom estilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Hahaha... O dono está exigindo que você faça o prato mais extraordinário no mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "Pare! Quando eu for despedido, quem mais cozinharia para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290419,
					"content": "Está bem, hahaha... Então foi isso que te deixou tão nervoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "Sim... Não sei de onde veio essa ideia louca e irrealista, que deixou muito exausto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290421,
					"content": "Calma! Mesmo que não saiba cozinhar, por acaso, conheço uma receita bastante extraordinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "Eu comi esse prato em uma família ilustre durante a minha viagem, e o nome desse prato é \"Caldo de Tofu com Galinha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "Você está realmente a comer carne, mas sem vê-la, e a textura é tão macia como o tofu. O seu sabor é divinamente tenso e fresco e os vegetais salientam perfeitamente o sabor da carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "Depois de comer, eu fiquei muito curioso e perguntei pela receita, mas... Eu não sou bom a cozinhar, por isso essa receita ficou perdida no fundo das caixas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "Como você chegou a conseguir uma receita dessas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Um... Enfim, eu ajudei alguém, e então me convidaram para um banquete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "O chefe estava tão convencido que afirmou que ninguém poderia fazer essa comida tão bem como eu, mesmo com a receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Esse prato realmente é difícil de ser feito. De acordo com o que aquele chef falou, saber fazer ele significa que não apenas é um mestre das artes culinárias, mas também um mestre da esgrima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Tsc, esgrima necessária para cozinhar? Se o que você está tentando dizer é que se precisa cortar carne, minhas habilidades com uma faca já são mais que suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290431,
					"content": "Mas se você fazê-la com a sua técnica de corte, aposto que acabará cortando a tábua ao meio antes de cortar a carne bem moída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "De acordo com o que o chef disse, o esplendor desse prato está na carne picada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "Primeiro, você tem que usar a faca com a técnica de usar espadas para remover a sua gordura. A seguir, corte a carne bem moída e bata nela com a ponta plana da faca... E depois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Espere! Então basicamente você não está dizendo nada... Eu sou um chef que usa facas e você é aquele que nunca cozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290435,
					"content": "Onde posso arranjar uma pessoa que é hábil em tanto cozinhar como brandir a espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290436,
					"content": "Bom... Essa pessoa... Está na sua frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "Eu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Isso! Viajante, por acaso você sabe cozinhar e brandir a espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "#Que tal deixarmos {M#o}{F#a} Viajante tentar fazer aquele prato especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Mas... Foi ao Yanxiao que o dono pediu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Ugh... O que o dono pediu era fazer um novo prato... Basta inventarmos um prato novo, e ninguém se importa com o seu inventor. Discutiremos isso depois, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "Chef, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Certo! Você tem razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290446,
					"content": "Mas quais são os ingredientes para fazer esse Caldo de Tofu com Galinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290447,
					"content": "Nada de muito especial, apenas Carne de Ave, Presunto, Ovo de Pássaro e Flor Crânio de Dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "...Na cozinha tem Carne de Ave e Presunto, mas... não temos Ovos de Pássaro e Flor Crânio de Dragão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290449,
					"content": "Se eu soubesse antes, não teria feito esse caldo de Matsutake com ovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290450,
					"content": "Viajante, pode me trazer um de cada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290451,
					"content": "Depois de encontrar, vamos pensar juntos como fazer esse Caldo de Tofu com Galinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290452,
					"content": "Ah... Claro! Você receberá uma compensação... Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 718290439,
					"content": "Eu sei cozinhar sim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "#E você também é versad{M#o}{F#a} em brandir a espada, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Esse prato com certeza é muito difícil de fazer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Você parece ter muita experiência...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Haha... Como eu como sempre comidas boas, não é nada de surpreendente que acumulo algumas experiências... Agora eu vou te ensinar como saborear esse peixe...",
					"roleType": "TALK_ROLE_NPC",
