						111030920
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030920,
					"content": "Mas entre as heranças de bens do meu avô, encontrei \"Um Selo de Permissão\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030921,
					"content": "No início, eu gostava de imitar os Adepti, era só isso. Mas depois não tinha como parar... E fiquei cada vez mais longe do caminho certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030922,
					"content": "Você parece um fã do Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "Sim! Muito obrigado por me dar essa oportunidade de encontrar pessoalmente com o Conquistador de Demônios. Sempre foi meu sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030924,
					"content": "Na verdade, nós também não esperávamos por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Hoje eu tenho essa oportunidade, de ficar na frente do Conquistador de Demônios e jurar minha lealdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030926,
					"content": "De hoje em diante, eu vou tentar o meu melhor para sempre fazer o bem, e ajudar os outros. Nunca irei envergonhar os Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030927,
					"content": "Eu lembrarei de seu juramento... Agora vá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Muito obrigado... Pela sua compreensão, e por tudo o que fez por Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				},
				{
					"id": 111030929,
					"content": "O último juramento dele foi sincero. Ele deve desistir de enganar pessoas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Bom, ele ainda não devolveu \"Um Selo de Permissão\", não se preocupe, isso fica comigo! Amanhã de manhã, vamos para o Albergue Wangshu para encontrá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "Guardião Yaksha",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Você não vai mais se chamar de Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "Não, não terei coragem, vocês me convenceram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Ladrão de Estrelas, Senhor Celestial"
				}
			]
		},
