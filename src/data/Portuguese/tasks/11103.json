			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Conseguiu juntar os itens para o ritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Esse incensário e as Lanternas de Qixing são perfeitos, e parece que são feitos sob medida para esse ritual... Onde você encontrou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Nós pegamos isso de um Yaksha chamado Pardal de Bronze...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "Ele mandou lembranças para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Pardal de Bronze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "Isso é bem o estilo dele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Então o Pardal de Bronze foi incapaz de se separar de Liyue... Espero que a vista de Liyue hoje possa confortá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "Vamos começar a preparar a cerimônia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "O Incensário fica mesmo no centro, cercado pelas lanternas de Qixing, adornado pelos objetos extremamente frios. Continuaremos quando terminarmos de arrumar tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Sim, isso é suficiente. O passo seguinte é essencial para o Andador de Sonhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "O processo tem quatro partes: Oferecer Incensos, Meditar, Lançar Feitiços e Atirar Flechas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "Ai... É tão complicado assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Essa magia dos Adepti foi entendida por um Adeptus de Jueyun há milhares de anos e consistia em inúmeras sabedorias. De forma nenhuma podemos subestimá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Caso contrário, ela pode devorar seu corpo de dentro para fora, e será difícil trazer sua alma de volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Me desculpe, eu não deveria ter falado isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "\"Oferecer incensos\" é queimar um incenso com o máximo respeito ao Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "\"Meditar\" é limpar todas as impurezas na mente, e fixar a imagem do objeto a que você faz magia na cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "\"Lançar Feitiços\" é ler em voz alta o encantamento: \"Devayaksha, traga o pecado\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "Finalmente, nós vamos disparar uma flecha em direção a cada uma das estátuas Yaksha para solicitar sua autoridade para o nosso contrato",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Se tudo correr bem, a alma do Ladrão de Estrelas aparecerá aqui em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Se vocês não têm mais perguntas, vamos logo começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Em suma... Temos que primeiro queimar um incenso? Com o respeito ao Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
