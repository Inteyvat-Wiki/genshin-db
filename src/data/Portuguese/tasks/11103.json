					"nextDialogs": [
						111031106
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031106,
					"content": "Está bem, já está saindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031107,
					"content": "Hum? Esta vez não é Tofu de Amêndoas, que é muito raro para o Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031108,
					"content": "Essa era a comida que o Pardal de Bronze mais gostava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031109,
					"content": "Queria apenas provar o sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031110,
					"content": "Entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031111,
					"content": "Eu caço por ondas e tempestades por peixe, e pelo vento e neve derroto espíritos malignos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031113,
					"content": "Têm mais algo para falar? Gosto de comer sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031114,
					"content": "Então não incomodaremos mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "#Uh, Paimon e {F#a}{M#o} Viajante vão sair de fininho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031115,
					"content": "Então, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
