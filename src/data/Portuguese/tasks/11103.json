			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "O espírito paira sobre a água límpida e as montanhas verdejantes, abanando seu leque relaxadamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030102,
					"content": "Com licença, com licença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "Nós queremos usar um pouco o incensário e a lanterna daqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "Isso realmente é uma coisa rara nesse mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030105,
					"content": "Vieram ao templo, mas não é para fazerem oferendas aos arcontes e Adepti, mas para moverem todos os incensários, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030106,
					"content": "Nós sabemos que é um pedido muito rude, mas só estamos pedindo emprestado por um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "É a cerimônia do Andador de Sonhos, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030108,
					"content": "Como você pode saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "Eu estou neste templo há mais tempo do que vocês conseguem imaginar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030110,
					"content": "Talvez minha fé tenha sido recompensada com algum entendimento das artes dos Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030111,
					"content": "Quanto a isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Deixa para lá! Levem então! Quem tiver capacidade de ajudar outros é sortudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030113,
					"content": "De qualquer maneira, eles têm pouca serventia neste lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030114,
					"content": "Parece que você está preocupado com alguma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Não precisa se preocupar comigo, se quiser alguma coisa, pegue-a logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pardal de Bronze"
				},
				{
					"id": 111030116,
					"content": "#Bem... Muito obrigad{M#o}{F#a}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Não tem problema, se quiser algo, é só pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pardal de Bronze"
				}
			]
		},
		{
