				},
				{
					"id": 111031103,
					"content": "#Obrigado a vocês {F#duas}{M#dois}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031104,
					"content": "Você vai querer alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031105,
