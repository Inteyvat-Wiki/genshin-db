			"dialogs": [
				{
					"id": 111030201,
					"content": "Esse incensário... Ele parece estar em bom estado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "Pelo menos não está igual a esse templo em ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "Depois do incensário... Vamos coletar as Lanternas de Qixing que estão nas proximidades, acho que é melhor irmos logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Uh? Ele claramente estava aqui antes, mas não tem ninguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "Eu não esperava que vocês ainda estivessem se preocupando comigo... Pensei que apenas pegariam o que queriam e partiriam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Ah! É a voz daquele cavalheiro! Onde... Onde você está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Meu corpo já não está mais aqui há mais de mil anos. O que vocês encontraram agora há pouco foi uma miragem criada pelo Remanescente Mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Agora que vocês pegaram as Lanternas de Qixing e o incensário usado no ritual do Remanescente Mortal, vocês não poderão mais me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Você é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "Eu sou um dos Guardiões Yaksha, Rex Lapis me chamava de Pardal de Bronze. Mas minha força falhou, e fui morto em batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Hoje é o aniversário da minha morte, meu último desejo é ver Liyue hoje, então decidi fazer isso aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "Agora me digam... Vocês encontraram com o Conquistador de Demônios antes de vir aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Vocês se conheciam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Eu consigo sentir a aura dele em seus corpos... Como também o odor cada vez mais forte do seu pecado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "Ai... Milhares de anos, e ele ainda está sofrendo essa punição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "... Realmente me deixa envergonhado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Não diga isso. Senhor Pardal de Bronze, você também perdeu a sua vida por Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "A vida é preciosa sim... Mas em comparação com o sofrimento do Conquistador de Demônios, a morte já é nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Senhor Pardal de Bronze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Haha, não se preocupem. Aniversários devem ser um dia feliz, mas aniversários de morte não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "#O efeito do Remanescente Mortal se dissipará em breve, peço a vocês {F#duas}{M#dois} que por favor mandem lembranças ao Conquistador de Demônios por mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "Com certeza mandaremos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "Ai, que vontade de comer um verdadeiro Peixe Tigre Frito de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "Caço por ondas e tempestades por peixes, por ventos e neves derroto espíritos malignos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "Ele desapareceu... Espero que as pessoas se lembrem do Guardião Yaksha Pardal de Bronze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "Vamos indo? Quando tivermos algum tempo livre, podemos vir aqui novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030321,
					"content": "Se cuide também, Pardal de Bronze...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
