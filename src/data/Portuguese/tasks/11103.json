			"dialogs": [
				{
					"id": 111031001,
					"content": "Senhora, com licença, o Ladrão de Estrelas mora aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031002,
					"content": "Ladrão de Estrelas?... Você se refere àquele de máscara falsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031003,
					"content": "Ele assinou o nome dele aqui como Wang Ping'an",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031004,
					"content": "É realmente um nome comum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "Ele já saiu do quarto de hóspedes, disse que iria viajar para as montanhas sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031007,
					"content": "Ah, sim, ele também disse que se uma pessoa acompanhada de uma \"fada falante\" viesse procurá-lo, eu deveria lhe entregar essa carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031008,
					"content": "Quem é essa fada falante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031009,
					"content": "#Hum... {M#O}{F#A} viajante a que ele se referiu é você? Aqui está a sua carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031010,
					"content": "Ele deixou esta carta, será que não é um novo truque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031011,
					"content": "Abra logo a carta! Estou morrendo de curiosidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031019,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031012,
					"content": "Ah! Parece que ele realmente mandou mais alguma coisa anexada com a carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031013,
					"content": "Ele deixou Um Selo de Permissão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031014,
					"content": "Faz muito tempo que não vejo um bandido tão sensato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031015,
					"content": "Comovente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "Oh sim... Vamos entregar \"Um Selo de Permissão\" para o Xiao rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031016,
					"content": "Isso é graças ao Xiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "Soa como uma pessoa comum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
