			"dialogs": [
				{
					"id": 700110101,
					"content": "Yaya dala! Kundala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110102
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700110102,
					"content": "Mimi nye odomu! Kundala nye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110103,
					"content": "Nye Odomu? Yoyo mani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700110104,
					"content": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110105,
					"content": "Mani…? Zido mi, mi dada. Nye kundala? Mi plata yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700110106,
					"content": "Ah! O temperamento dele não é bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110107,
						700110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700110107,
					"content": "Ella Musk, tome cuidado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110109
					]
				},
				{
					"id": 700110109,
					"content": "Não seja impulsivo. Não tem problema, eu consigo entender ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110110,
					"content": "Uh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700110111,
					"content": "Ele só quer que nós o ajudemos a derrotar alguns inimigos. Eles estão nesta localização aqui no mapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110113,
					"content": "Entendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700110114
					]
				},
				{
					"id": 700110114,
					"content": "A localização já está marcada no mapa. Vou para lá agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700110115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700110115,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700110108,
					"content": "Precisa que nos livremos dele?",
