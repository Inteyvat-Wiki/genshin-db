			"dialogs": [
				{
					"id": 760440101,
					"content": "Tem uma recompensa particularmente complicada no Navio-Chefe sem praticamente nenhuma pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440102,
					"content": "O alvo estava atacando pessoas no norte da Ilha Lempo, mas agora desapareceu sem deixar rastro. Ninguém parece saber para onde ele foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440103,
					"content": "Todo contato deixa um rastro. Não importa o quão cuidadosamente alguém tente encobrir seus passos, ao fazer isso, sempre cria novos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440104,
					"content": "Além disso, só porque a recompensa não incluía informações extras, não significa que quem a publicou não as tenha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440105,
					"content": "Nunca pensei nisso... Vou falar com o Leszek — com toda a minha experiência, devo conseguir arrancar algo útil dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440106,
					"content": "Então vou deixar isso com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440107,
					"content": "Pode deixar comigo, chefe Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
