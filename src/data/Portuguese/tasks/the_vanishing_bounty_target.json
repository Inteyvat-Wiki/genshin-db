			"dialogs": [
				{
					"id": 760440301,
					"content": "Hmm... Parece que foi ontem que havia várias recompensas disponíveis no Navio-Chefe — agora só restou uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440302,
					"content": "#Aparentemente, isso é tudo graças a {NICKNAME}. Mas nem {M#ele}{F#ela} conseguiu resolver essa última.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440303,
					"content": "Bem, é que realmente não há pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440304,
					"content": "Ah, mas... Só porque algo não está escrito no quadro de recompensas, não quer dizer que não exista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440305,
					"content": "O que é isso — um súbito lampejo de inspiração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440306,
					"content": "Vou perguntar ao Leszek — com toda a minha experiência, devo conseguir arrancar algo útil dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440307,
					"content": "Então vou deixar isso com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440308,
					"content": "Pode deixar comigo, chefe Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
