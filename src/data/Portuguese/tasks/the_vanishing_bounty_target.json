						"pointId": 145
					},
					{
						"sceneId": 1204,
						"position": [
							18.758,
							1.291,
							10.74
						],
						"pointId": 146
					}
				]
			},
			"dialogs": [
				{
					"id": 760440201,
					"content": "Os detalhes dos alvos estão no quadro. Posso te atualizar se precisar, mas não adianta tentar pechinchar pelas recompensas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440202
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440202,
					"content": "Sobre os alvos de recompensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440203,
					"content": "Há quatro alvos no quadro, mas só temos pistas de três. O primeiro é procurado por fraude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440204
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440204,
					"content": "...Chega, chega, chega! Poupe esse discurso pros caçadores de tesouros novatos — eu poderia recitar tão bem quanto você. Você sabe de quem eu vim atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440205,
					"content": "A Curadoria quer se envolver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440206
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440206,
					"content": "Isso depende de como a Chefe estiver se sentindo. Hmm, como é que chegamos a você fazendo perguntas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440207,
					"content": "De qualquer forma, me parece que o verdadeiro motivo do Mandíbula Rachada não ter sido encontrado é a falta de pistas. Olhe para o quadro. Você nem ao menos disse como ele é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440208,
					"content": "Bem, se esses caçadores de tesouros saírem sem nem saber quem estão procurando, não têm a menor chance contra alguém como o Hark. Não quero que uns novatos desperdicem seu tempo, muito menos que joguem suas vidas fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440209
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440209,
					"content": "Justo. Além da cicatriz no queixo, o que mais você pode me contar sobre ele? De preferência, algo que ninguém mais saiba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440210,
					"content": "Algo que ninguém mais saiba... Você está procurando características físicas? Tipo, se ele tivesse alguma marca nas costas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440211
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440211,
					"content": "Exatamente isso que eu quero saber! Mas como você sabe tanto sobre ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440212
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440212,
					"content": "Eu não sei de nada. Nunca disse que ele realmente tem alguma marca... Além disso, mesmo que tenha, como você vai ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440213
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440213,
					"content": "B-Bom, é, meio que... *Suspiro* Então não tem nada que você possa me dizer? A gente sempre trabalhou bem junto — não pode me dar nenhuma pista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440214,
					"content": "Depois que Hark revelou sua verdadeira natureza aqui na Cidade de Nasha, ele fugiu para o norte da Ilha de Lempo e retomou sua antiga vida de crimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440215
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440215,
					"content": "Isso é notícia velha. Todo mundo e o cachorro deles já sabe disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440216,
					"content": "Ninguém relatou tê-lo visto recentemente. E se ele tiver ido mais ao norte? Talvez eu consiga rastreá-lo até Piramida, mas e se ele já tiver chegado a Snezhnograd?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440217,
					"content": "(Nada além de gelo e neve lá em cima. Não sei se meu braço funcionaria no frio...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440218,
					"content": "Ele não foi. Ainda está na Ilha de Lempo — só não sei onde. Pode considerar isso como \"algo que ninguém mais sabe\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440219
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440219,
					"content": "Hm, como você pode ter tanta certeza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440220
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440220,
					"content": "Isso é segredo de ofício — se quiser saber, vai ter que pagar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440221
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440221,
					"content": "Ha, que pão-duro! Ainda assim, um brutamontes com uma cicatriz no rosto... Mesmo na Ilha de Lempo, não é difícil de encontrar. Como vou saber qual deles é o Hark?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440222
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440222,
					"content": "Bem, já que a gente \"trabalha tão bem junto\", vou te dar um conselho de graça. Não se prenda tanto à cicatriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440223
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760440223,
					"content": "...Está dizendo que ele arrumou um jeito de esconder a cicatriz no queixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440224,
					"content": "Acho que faz sentido. Se todo mundo te conhece como Mandíbula Rachada, andar por aí sem nenhuma cicatriz visível no rosto seria um ótimo jeito de se esconder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440225,
					"content": "Nesse caso, só preciso encontrar alguém que esteja escondendo de propósito a linha do maxilar, certo? Já é uma pista, pelo menos... Certo, se eu descobrir algo novo, volto aqui para te contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440226
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440226,
					"content": "Estarei esperando ansiosamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
