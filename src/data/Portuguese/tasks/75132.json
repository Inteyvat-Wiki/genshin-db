			"dialogs": [
				{
					"id": 751320101,
					"content": "#...Ah... {M#Nossos heróis forasteiros}{F#Nossas heroínas forasteiras} de terras distantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320102,
					"content": "Por favor, escutem minhas palavras. Ah, sou o corvo guia, e também a tristeza da despedida do verdadeiro mestre da noite que reflete poesia... Ou então, sou apenas um em um bilhão de pensamentos perdidos nos raios da luz do luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320103,
					"content": "Por favor, escutem minhas palavras. Pois o rio espiritual subterrâneo foi quebrado, só posso falar com você através desta imagem e te pedir para ter cuidado com aqueles inimigos sinistros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320104,
					"content": "Aqui, aquele espelho quebrado uma vez brilhava com reflexos iluminados. Mas, agora, uma nuvem negra gradualmente se espalhou em três áreas. Lembre-se deles:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320105,
					"content": "Primeiro é o lado leste. Sombras escondidas em um afresco que retrata lendas passadas que gradualmente começaram a emergir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320106,
					"content": "Segundo é o lado oeste, no Mar Perdido, onde encarnações sinistras imitam a voz do Rei da Meia-Noite como um papagaio irritante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320107,
					"content": "Terceiro é debaixo dos penhascos, uma névoa espessa que já deveria ter se dissipado e que se espalhou após a Cidade Incandescente começar a causar problemas mais uma vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320108,
					"content": "#{M#Heróis}{F#Heroínas} de longe, por favor, tenham muito cuidado... Tenham cuidado com os inimigos sinistros vagando por aí, e tenham cuidado com todos os inimigos corroídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vontade do Grafite Misterioso"
				}
			]
		},
		{
