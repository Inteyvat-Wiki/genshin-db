			"dialogs": [
				{
					"id": 751320601,
					"content": "Ah, valentes de muito longe... consigo sentir... tudo que vocês fizeram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320602,
					"content": "Que incrível! O poder corroído retornou para Yohualtecuhtin, a Dama da Noite. Consigo sentir a felicidade dos Espíritos da Noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320603,
					"content": "Então... tome isto como recompensa, valente. Aqueles que alcançaram a grandeza devem ser recompensados — vá em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vontade do Grafite Misterioso"
				}
			]
		}
	]
