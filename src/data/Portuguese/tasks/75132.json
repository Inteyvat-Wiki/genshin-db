				]
			},
			"dialogs": [
				{
					"id": 751320501,
					"content": "Tenham cuidado com os inimigos sinistros vagando por aí, e tenham cuidado com todos os inimigos corroídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320502,
					"content": "#{M#Heróis}{F#Heroínas} de longe... Existe mais alguma coisa que vocês gostariam de saber...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320503,
					"content": "Sobre os heróis naquele afresco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "O lado leste, dentro de cavernas onde árvores brilhantes balançam e sacodem assim como o narrador segurando o pergaminho diz, lá também há horrores escondidos em histórias do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320505,
					"content": "Talvez aquela sombra está procurando fugir de tudo através das antigas histórias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320506,
					"content": "Sobre o Mar Perdido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "Uma ilha reside escondida em uma névoa no oeste. Originalmente era um santuário sagrado para assuntos cerimoniais e era povoado por aqueles que assinaram um pacto com os Iktomissauros a muito tempo atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320508,
					"content": "Mas a imundice escorregadia emergiu nela, e o local sagrado virou uma fossa sinistra que foi selada e esquecida... Ah, mas um inimigo traiçoeiro nunca desistirá tão facilmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320509,
					"content": "Sobre a névoa nebulosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "Essa névoa imunda foi criada originalmente quando a antiga cidade de Ochkanatlan foi destruída. Ela foi originalmente selada... Mas o tempo e a memória são inimigos há muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320511,
					"content": "Se ao menos... Ah... Se ao menos alguém pudesse dispersar essa névoa nebulosa novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Vontade do Grafite Misterioso"
				},
				{
					"id": 751320512,
					"content": "Não, nada que eu gostaria de saber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Ah... por favor se lembre de ter muito... muito cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vontade do Grafite Misterioso"
				}
			]
		},
