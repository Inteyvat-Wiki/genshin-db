			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Parem, humanos. O destino não lhes concedeu o direito de entrar neste lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Apóstolo do Destino"
				},
				{
					"id": 80110302,
					"content": "(Um Apóstolo do Abismo? Não, nunca vi alguém da Ordem do Abismo assim...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Hmm, vocês insistem em uma audiência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Apóstolo do Destino"
				},
				{
					"id": 80110304,
					"content": "... Muito bem, eu concederei-lhe um Julgamento do Destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Apóstolo do Destino"
				}
			]
		},
		{
