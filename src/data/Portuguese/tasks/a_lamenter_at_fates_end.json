			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "Que lugar medonho... Ele sempre existiu? Eu juro que nunca havia notado antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Olhe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Hã? Parece que eles estão... louvando. Às vezes andando, às vezes se ajoelhando em louvor... E parece ser de coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "Eu nunca vi algo assim na minha vida. O que raios esse lugar esconde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Só há um jeito de descobrir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(O ar aqui e esta cena arrepiante... é estranhamente familiar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "O que aqueles Hilichurls estão fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
