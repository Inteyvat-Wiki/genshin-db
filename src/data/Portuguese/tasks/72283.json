			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Urgh, acho que hoje não é meu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "Não importa o quanto eu pratique, meu disparo está cada vez pior. Juro que um dia desses vou acabar atirando em meu próprio joelho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "Por que você está praticando arquearia em um lugar como esse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "É tudo culpa daquele Jibashiri — ele sugeriu que eu fizesse isso! Quer saber? Me pergunto se todos eles são um monte de sádicos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "Falando nisso, você sabe algo sobre criar unagi? Sinto que minha arquearia não tem muito futuro, por isso, é melhor eu pensar em fazer outra coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "O que essas coisas têm em comum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Oh, sim, não importa. Parece que você não sabia nada sobre criar unagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Você primeiro precisa pegar algumas unagi. São tão pequenas que você mal consegue as ver a olho nu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Por isso eu pensei: já que arqueiros podem atingir seus alvos de muito longe, eles devem ter bons olhos. Por isso, perguntei a alguns Jibashiri experientes como treinar minha mira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "\"Akashi, você tem que treinar mais devagar. Você só fará progresso constante quando tiver uma boa fundação\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "\"Unagi são pequenas e se movem rapidamente, por isso você precisa começar com alvos parados. E também não pode disparar nos que estão muito próximos. Se quiser fazer algo certo, tem que levar as coisas a sério\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Eu segui as instruções dele, e treinei arquearia aqui. Mas eu sequer atingi um alvo desde então... Será que isso é até mesmo possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Na verdade, você quer tentar? Se ficar naquela plataforma, verá os alvos. Se você acertar todos eles, será considerado que teve êxito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Sim, pode deixar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Bem, deixe-me ver suas verdadeiras habilidades. Não esqueça de vir me procurar quando tiver terminado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228302",
							"2"
						],
						"stepId": 7228302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Ah, você também não conseguiu atingi-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "Acho que hoje não é meu dia. Algo deve estar atrapalhando o meu progresso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "Você gostaria de tentar mais algumas vezes? Não é como se os alvos fossem fugir como aqueles unagi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Uau! Você conseguiu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "#*Suspiro* Você parecia {F#uma}{M#um} profissional. Duvido que alguém sem treinamento como eu poderia ser tão bom com você, ainda que eu treinasse por mais alguns anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "E eu não vejo um unagi vivo e pulando há muito tempo, mesmo vindo aqui treinar todo dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "Você gosta de unagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Oh, mesmo? Eu adoro eles, ao ponto de um dia tentar cria-los. Você não acha que são adoráveis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Bem, os unagi são melhores em um prato. Adoráveis de olhar e provar. É uma combinação perfeita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "Falando nisso, você acha que estou confundindo minhas prioridades? Só estou praticando arquearia porque quero criar unagi, mas só quero fazer isso porque amo eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "No final, eu os amo quando estão vivendo livremente. Por isso não há motivo de cria-los, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "Bem, de qualquer forma, obrigado pela demonstração. Fique com isso. Boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "Não exatamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}