					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "Não... Esta sequência lógica não se alinha. Eu preciso abordar isso de outro jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060302,
					"content": "Que tal... Não, não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060303,
					"content": "Hã? Oh. Você me achou. Vou voltar para o ponto de encontro, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060304,
					"content": "Este ponto de vista está certo? Não, ele... Na verdade, é certo ou errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
		{
			"id": 2400604,
			"completionStepIds": [
				2400604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
