			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Lovi",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "É minha vez de pegar as pessoas... Eu vou te pegar com certeza, Lovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Eu não teria tanta certeza! Tem uns lugares que nem você consegue escalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Bem, hmm, é porque meus sapatos não são para escalar. Se eu trocar de sapato, certeza que te pego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "Então vamos nós dois tirar os sapatos. Isso vai deixar tudo justo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "Parem! Você não podem correr por aí descalços. Tem todo tipo de tralha pelo chão. E se vocês se cortarem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060106,
					"content": "Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Hmm, irmão, quando você estava tentando me pegar mais cedo, você estava meio distraído, não estava? Eu corri ao seu lado e você nem respondeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Hã? Isso aconteceu? Eu nem percebi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060110,
					"content": "Exatamente! Eu corri uma volta inteira mais cedo e você nem pareceu me ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "#Mas... Hã? {M#Irmãozão}{F#Irmãzona}? Por que você está aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060112,
					"content": "Por que Lovi está aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Meu pai disse que ele precisava sair para trabalhar. Minha mãe também tem que trabalhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Aurele encontrou um livro por acaso, então meu Pai pediu para ele cuidar de mim, aí vim aqui brincar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Esqueça isso, vamos continuar brincando. Quem vai capturar quem dessa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060119,
					"content": "Pensei que você não gostasse de esconde-esconde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Bem, hmm, cof, tenho tentando escrever minha primeira análise recentemente, e tive algumas questões para considerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060122,
					"content": "Eu descobri que, bem, minha mente é muito mais ágil quando estou me exercitando, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060123,
					"content": "Mas ele se distrai facilmente e às vezes ele só fica lá parado falando sozinho. Ele não reage a nada que você disser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "#Por que não brinca com a gente, {M#irmãozão}{F#irmãzona}? Você é bem melhor do que meu irmão em esconde-esconde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Hehe, a gente que fala isso. Lovi e eu somos mestres em esconde-esconde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "Então vamos começar. Vem, Lovi! A gente tem que achar esconderijos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi e Verut correm como o vento, enquanto Aurele sai lentamente, ponderando, como sempre faz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Eu não vou pegar leve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Por que o entusiasmo repentino por esconde-esconde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Esconde-esconde ainda, então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Sim. O Sr. Delerue precisou sair em uma viagem de negócios e a Tia Dumay também precisa trabalhar, então me pediram para cuidar de Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060117,
					"content": "Então eu a trouxe aqui para brincar com a gente... Espero que o vestido dela não fique sujo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurele"
				}
			]
		},
		{
			"id": 2400602,
			"completionStepIds": [
				2400602
			],
