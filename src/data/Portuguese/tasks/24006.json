			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "#Então você me achou mesmo, hein, {M#irmãozão}{F#irmãzona}? Acho que você é melhor mesmo nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Eu vou voltar ao ponto de encontro. Espero que meu irmão se saia melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Por que você espera isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "Ora, ele mesmo disse, não foi? O cérebro dele funciona melhor depois que brincamos de esconde-esconde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "Mas ele tem pensamentos demais, e precisa se agachar no chão e tentar lembrar deles por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi me contou que aquelas ideias dele são muito preciosas, e não é para a gente perturbar ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "É por isso que estamos brincando de esconde-esconde com ele. Se estamos prestes a pegar ele, a gente demora de propósito para ele organizar os pensamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "É só que se é a vez do meu irmão de pegar as pessoas, vamos ter que esperar por ele por muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
			"completionStepIds": [
				2400603
