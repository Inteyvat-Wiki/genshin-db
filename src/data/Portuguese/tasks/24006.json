			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240060401,
					"content": "Me pergunto se Aurele vai conseguir juntar seus pensamentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "Uh, o quê? Você achou mesmo esse lugar? Sério, quantas vezes você brincou de esconde-esconde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Vou voltar ao ponto de encontro. Vou me esconder melhor da próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
		{
			"id": 2400606,
