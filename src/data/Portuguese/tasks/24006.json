				]
			},
			"dialogs": [
				{
					"id": 240060601,
					"content": "Não, não... o argumento é insuficientemente rigoroso aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060602,
					"content": "#Ah, parece que Aurele está de volta no mundinho dele. Obrigado por brincar com a gente, {M#irmãozão}{F#irmãzona}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "Ele vai... ficar bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Contanto que ele não comece a beber café como água, igual meu pai, ele vai ficar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060606,
					"content": "Deixe comigo! Eu não vou deixar meu irmão beber café demais... se chegar a isso, eu escondo tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060607
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060607,
					"content": "*Suspiro* eu estava planejando esconder o café do meu pai aqui... Mas acho que não vai dar certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060608
					],
					"speakerTitle": "Lovi"
				},
