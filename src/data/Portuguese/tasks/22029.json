			"dialogs": [
				{
					"id": 220290201,
					"content": "Você não usou todas as suas forças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "Não é preciso de pensar em mim, senhor, pode usar toda a sua força, dessa forma, eu poderei me tornar cada vez mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
