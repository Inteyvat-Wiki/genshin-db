			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Eu terei que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Hum? Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "Eu recebi a sua missão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Oh! Você está se referindo àquela missão de treinamento? Exato, fui eu que publiquei, pois gostaria de encontrar uma pessoa para treinar artes marciais comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "Você pegou a missão? Mas não me parece que tinha te visto na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "#Peço desculpas, não estou questionando suas habilidades, mas tenho que reconhecer que eu realmente não faço ideia o quão habilidos{M#o}{F#a} você é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "Eu já derrotei um dragão uma vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Haha, ah, sério? Na verdade, eu tenho mais interesse é em saber onde foi que você encontrou um dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "#Eu sou muito {M#bom}{F#boa} em lutas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "De qualquer maneira, o que você diz não representa suas habilidades de verdade, que tal a gente iniciar uma luta e ver quem será o vencedor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "É exatamente o que eu estou pensando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Espere, por que você publicou uma missão anônima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Na verdade... Eu tenho um pouco de vergonha para te contar o motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "Mas agora que você aceitou a missão, eu vou te contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Uns dias atrás, quando eu e outros guardas estávamos de volta da patrulha, vimos alguns Kairagis que estavam planejando atacar caravanas de surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Eu e os outros Doushins fomos ajudar a caravana assim que entendemos a situação. No início, estávamos com vantagem, e eles também foram expulsos logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Quando no momento em que abaixamos a guarda para descansar um pouco, apareceram outros Kairagis, liderados por uma outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Antes que eu e outros colegas percebêssemos a situação, fomos pegos de surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Sem esperança de vitória, não pudemos fazer nada sem nos defender do ataque dos Kairagis enquanto escoltávamos os mercadores de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "E no momento em que eu e o líder dos Kairagis estávamos lutando ferozmente... A minha arma foi agarrada por ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Com a arma agarrada na mão, esse cara até virou para mim e riu de mim. Isso foi realmente a maior vergonha na minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "E os mercadores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Quando estávamos nos recuando, encontramos outros guardas de patrulha, e todos os Kairagis se retiraram ao nos ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Escoltamos aqueles comerciantes até entrarem na cidade, mas as mercadorias deles... *Suspiro* Parece que minhas habilidades não foram suficientes para salvá-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Depois de voltar para o escritório, o chefe nos distribuiu novas armas, mas não consigo simplesmente deixar isso passar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "Portanto, eu publiquei aquela missão, para refinar minhas habilidades de artes marciais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Quando eu for forte o suficiente, eu irei derrotar o Kairagi por conta própria, pegando de volta a minha arma e me vingando pela vergonha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Eu presenciei a queda de um Arconte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Hã? Do que você está falando? Você quer dizer que participou do Ritual de Descensão em Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Segundo o que você acabou de dizer, muitas pessoas de Liyue testemunharam a queda do arconte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
