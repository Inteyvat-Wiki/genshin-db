			"dialogs": [
				{
					"id": 220290301,
					"content": "Suas habilidades são realmente muito incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Eu... Eu aprendi bastante com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Você está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Tudo bem... Só preciso recuperar meu fôlego um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "Com essa força tão poderosa, claro que eu acredito que você já derrotou o dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "Na verdade, eu realmente derrotei um dragão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Haha... Claro que eu acredito. Muito obrigado por ter treinado comigo. Eu me lembrarei para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "Se vossa senhoria desejar, venha duelar comigo depois. Com alguém forte como você, tenho certeza que posso completar aquele assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "Aquele assunto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "*Cof*... Esse só é um pequeno sonho meu... Enfim, aqui está sua recompensa como agradecimento, por favor fique com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Agora descansarei um pouco. Aquilo que você fez mostra que sua força realmente é enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Peço desculpas, eu não consegui me conter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
