				"points": []
			},
			"dialogs": [
				{
					"id": 726890101,
					"content": "Ah, são vocês. Bem na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890102
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890102,
					"content": "Depois de umas duas rodadas de prática, seu entendimento sobre as artes florais melhoraram bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890103
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890103,
					"content": "Dessa forma, fiz algumas pequenas mudanças no Enigma Floral de hoje, para quem sabe ajudar em abrir uma nova linha de pensamento criativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890104
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890104,
					"content": "#Estamos pront{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890105
					]
				},
				{
					"id": 726890105,
					"content": "Uhh, você diz isso, mas Paimon está começando a ficar meio nervosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726890106,
					"content": "Hehe, não precisa se preocupar. Apenas relaxe. Mantenha a calma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890107
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890107,
					"content": "Considerando seu talento, acredito que tudo que você precisa fazer é pensar direitinho no Enigma Floral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890108,
						726890111
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890108,
					"content": "Você é muito gentil, mas vá em frente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890109
					]
				},
				{
					"id": 726890109,
					"content": "Neste caso, o Enigma Floral de hoje é: \"Folhas de jade em repouso, flores nascidas no vento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890110
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890110,
					"content": "Me pergunto qual será a resposta que vocês darão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890111,
					"content": "Ainda tenho outras coisas para fazer no momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726890112
					]
				},
				{
					"id": 726890112,
					"content": "Tudo bem. Afinal de contas, a Ikebana requer atenção total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726890113
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726890113,
					"content": "Uma vez que você tenha completado todos os seus assuntos, ficando livre de todos os problemas, tenho certeza de que seu Pátio Floral ficará ainda mais perfeito por conta disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		},
		{
			"id": 7268903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
