				"points": []
			},
			"dialogs": [
				{
					"id": 726870201,
					"content": "Nos próximos dias, eu continuarei aqui e guiarei aqueles que vierem para o Festival Irodori e os ajudarei a aproveitar a beleza do \"Pátio Floral\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870202
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870202,
					"content": "Não se esqueçam de revelar um \"Enigma Floral\" diariamente. Há um total de quatro \"Enigmas Florais\" para vocês acertarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870203
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870203,
					"content": "Claro, se vocês tiverem outras dúvidas, farei o meu melhor para explicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870204,
						726870210,
						726870222
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870204,
					"content": "Sobre essas flores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870205
					]
				},
				{
					"id": 726870205,
					"content": "As flores que eu uso são todas fornecidas pela Floricultura Sakuya. Suas flores são de qualidade e bom preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870206
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870206,
					"content": "Talvez vocês já tenham visto Sakuya. Nós estudamos juntos Ikebana com o mesmo mestre uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870207
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870207,
					"content": "A Sakuya tem grande conhecimento sobre a arte floral, mas quando ela soube que haveria muitas pessoas no Festival Irodori, parece que ficou um pouco nervosa. Ela disse que seria difícil se acalmar e se focar no trabalho em um ambiente assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870208
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870208,
					"content": "De qualquer forma, eu vou fazer a divulgação da Floricultura Sakuya para os outros clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870209
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870209,
					"content": "Se tivermos a oportunidade, também queremos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870219,
					"content": "Bem, vocês ainda têm alguma dúvida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870220
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870220,
					"content": "#Obrigad{F#a}{M#o}, Srta. Fushizome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870221
					]
				},
				{
					"id": 726870221,
					"content": "Disponha. Voltem a qualquer hora quando tiverem tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870210,
					"content": "Sobre o Comissário Yashiro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870211
					]
				},
				{
					"id": 726870211,
					"content": "A Comissão Yashiro tem sido sempre muito apoiadora nas artes florais de Inazuma. Para ser mais preciso, a pessoa que patrocinou esteve evento foi Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870212
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870212,
					"content": "Ela sempre foi muito talentosa nessas artes desde nova. Uma vez, vi ela fazendo uma apresentação de Ikebana e tive a honra de poder conversar com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870213
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870213,
					"content": "Apesar de ser mais velha que ela, meus conhecimentos de Ikebana não são de nada se comparados a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870214
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870214,
					"content": "Sempre quando possível, Shirasagi Himegimi nos concede financiamento todos os anos para a divulgação da Ikebana. Até ouvi falar que ela já usou de suas próprias economias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870215
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870215,
					"content": "Uma vez, Shirasagi Himegimi disse que desejava que mais pessoas pudessem entender mais sobre Ikebana, terem interesse com artes florais e terem vontade de praticar esta arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870216
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870216,
					"content": "Hum, então Ayaka fez tanta coisa pelas artes florais de Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726870217,
					"content": "Espero que o desejo dela possa se tornar realidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870218
					]
				},
				{
					"id": 726870218,
					"content": "#Obrigada a vocês {F#duas}{M#dois}. Vocês realmente são pessoas de bom coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726870219
					],
					"speakerTitle": "Fushizome"
				},
				{
					"id": 726870222,
					"content": "Não temos mais perguntas por enquanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726870223
					]
				},
				{
					"id": 726870223,
					"content": "Voltem a qualquer hora quando tiverem tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fushizome"
				}
			]
		}
	]
