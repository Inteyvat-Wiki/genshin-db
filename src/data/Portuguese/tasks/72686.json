			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "Posso perguntar seu nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860102,
					"content": "#Sou {M#o}{F#a} {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "#Ótimo, anotei aqui. Você teria coragem de colocar sua honra como {M#guerreiro}{F#guerreira} em jogo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860104,
					"content": "Espera, o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "#Hmm? Você não é {M#um guerreiro}{F#uma guerreira} que veio para participar do duelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860107,
					"content": "Nunca ouvi falar disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "Você nunca ouviu falar do \"Duelo das Lâminas Solitárias\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860109,
					"content": "Não pode ser, eu coloquei vários anúncios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860110,
					"content": "Onde você colocou eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860111,
					"content": "Aqui mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860112,
					"content": "Ai, qual é, assim não adianta nada! Ninguém vai ver isso, muito menos vir até aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860113,
					"content": "Hunf! Isso é tudo culpa da Comissão Yashiro, com toda essa bobagem de \"nada de armas ou lutas durante o Festival Irodori\". Tentei registrar para organizar duelos em Ritou, mas eles recusaram, e nem me deixaram colocar anúncios também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860114,
					"content": "Então apenas consegui organizar a arena aqui e colocar a placa por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860115,
					"content": "Dito isso, já temos 4 participantes. Se formos considerar você, seriam 5.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860116,
					"content": "#Hã, então as pessoas realmente vieram participar. Isso é estranho. Falando nisso, Paimon não consegue lembrar o motivo de você ter vindo até aqui, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860117,
					"content": "#Pelo que estou vendo, você conseguiu encontrar este lugar sem nenhuma dica. Isso significa que você é {M#um guerreiro}{F#uma guerreira} de espírito formidável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860118,
					"content": "Aqueles apaixonados pelas artes marciais sempre serão atraídos uns pelos outros. É como o mundo funciona — e não tem nada a se surpreender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860119,
					"content": "Paimon não faz ideia em que mundo você vive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726860120,
					"content": "Hehe. Mas enfim, você ainda gostaria de participar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860121,
					"content": "Se você conseguir derrotar os quatro desafiantes, irá receber uma premiação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860122,
					"content": "Irei pensar no caso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "Muito bem, então, tome o tempo que precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasuhiko Tarou"
				},
				{
					"id": 726860105,
					"content": "Oh, não, não, tenha um bom dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}