			},
			"dialogs": [
				{
					"id": 227010101,
					"content": "#Alto lá, amig{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010102,
					"content": "Eu consigo dizer pela confiança em sua postura e em seus passos ligeiros que nós três somos almas gêmeas, praticantes das artes marciais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "O que você quer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Ei! Demonstre um pouco mais de respeito quando você estiver falando com ele, entendeu!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010203,
					"content": "Por favor, não tem necessidade... Na verdade fui eu quem comecei a conversar com eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Hunf! Bem, desde que eles não sejam só mais uns caçadores de Adepti oportunistas inúteis tentando roubar nosso lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010205,
					"content": "#Sim, ótimo, obrigado pela sua preocupação... Acredito que ficarei bem... Agora, por que você não tira um descanso bem-merecido enquanto eu converso com noss{F#a}{M#o} nov{F#a}{M#o} amig{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Mas, certamente não têm nada que você poderia dizer para eles que não poderia dizer na minha frente, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010207,
					"content": "Só iria te entediar, realmente não é nada que você esteja interessado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Hunf, certo, entendi, você quer falar novamente sobre o Clã Guhua... Certo. Se você não quer que eu escute, deixarei vocês a sós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010209,
					"content": "#M{F#inha}{M#eu} amig{F#a}{M#o}, venha por aqui. Poderemos conversar mais profundamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
