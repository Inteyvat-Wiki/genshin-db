				"points": []
			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "Você voltou! Em relação ao assunto do qual confiei a seus cuidados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Eu tenho eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "#Estas devem ser mais que suficiente. Amig{M#o}{F#a}, você tem meus agradecimentos, por favor, aceite este pequeno presente em troca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "Hum? Para que são todas essas flores Qingxin? Ah não, você está com dor de cabeça novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Que'er"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Pequena Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "Sim, elas são para as dores de cabeça dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Mas eu teria ido de bom grado colher remédio para você... Por que você precisava pedir a um transeunte para fazê-lo em seu lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010603,
					"content": "Além disso, não sabemos nada sobre eles ou seus antecedentes, e se-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010604,
					"content": "... Chega, Que'er. Eles nos ajudaram, não foi? Não temos nenhuma desavença com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Obrigado novamente. Por favor, fique com isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Sim, pegue e siga seu caminho alegre e contente, não deixe ele esperando enquanto ele tem uma dor de cabeça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010607,
					"content": "Rápido, vamos tirar você do vento! Vou fazer um chá doce para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Que'er"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Pequena Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "Na verdade, eles são para sua garganta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "#Ahem! M{M#eu}{F#inha} b{M#om}{F#oa} amig{M#o}{F#a}, eu ouso dizer que-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "... Você está dizendo que sou fraca? Ah, então você sente a menor rajada de vento e já presume que eu tenha uma dor de garganta!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010704,
					"content": "Bem, felizmente as flores Qingxin não serão inúteis - pois, elas podem ajudar com as suas dores de cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 227010705,
					"content": "Que'er, escute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010706,
					"content": "Vamos lá, vamos tirar você do vento e ficar em algum lugar que você possa colocar seus pés para cima! Vou fazer um chá doce para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "Pequena Que'er"
				},
