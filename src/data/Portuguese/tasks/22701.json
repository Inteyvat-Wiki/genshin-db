		{
			"id": 2270104,
			"completionStepIds": [
				2270103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270103",
							"2"
						],
						"stepId": 2270103,
						"stateName": "QUEST_STATE_UNFINISHED"
