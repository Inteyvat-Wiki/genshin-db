			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Certo, aqui está ótimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Sobre o que é tudo isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*Suspiro* É sobre ela... A Pequena Que'er, minha júnior. Sempre fomos inseparáveis em nosso treinamento de artes marciais, como unha e carne. Suas habilidades não são nem um pouco inferiores às minhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Viemos aqui em busca da orientação dos Adepti, mas a viagem tem sido árdua e minha companheira é uma tremenda tagarela que não sabe quando parar. Alguns dias atrás ela adoeceu com o frio, e agora ela está acometida de uma dor de garganta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Vejo que você tem uma tremenda força, por isso suplico-lhe humildemente que me encontre três flores Qingxin no pico do penhasco, com as quais poderei misturar em água quente e trazer nem que seja algum pequeno alívio à garganta dolorida da Que'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "#Amig{M#o}{F#a} você tem meus sinceros agradecimentos. Que'er é uma alma vivaz, e não ouso deixá-la sozinha enquanto vou em busca de medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Mas por que você está fazendo isso pelas costas dela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Vejo que você se entreteve bastante. Que'er tem um espírito agitado e se recusa a aceitar que ela talvez possa estar em desvantagem em relação às pessoas ao seu redor, quaisquer que sejam as circunstâncias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Se eu levantasse sequer a possibilidade de ir colher medicamentos em seu benefício enquanto estivesse por perto, ela rejeitaria a proposta imediatamente, sem pensar duas vezes. Portanto, devo agir sem que ela saiba de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Além disso, não me atrevo a deixá-la sozinha aqui enquanto saio em busca de medicamentos. É por isso que devo pedir por sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
