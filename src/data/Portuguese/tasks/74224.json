				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Uh, parece que nos encontramos de novo, Tailleferre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "#Ah, são vocês! {M#O aventureiro}{F#A aventureira} e sua pequena assistente. Desculpe, esqueci seus nomes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#O nome de Paimon é Paimon, e {M#ele}{F#ela} é {NICKNAME}. A propósito, obrigada pela sua ajuda da última vez — graças a você, conseguimos usar a Concharpa para tocar a partitura antiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Mesmo assim, o que te traz até aqui em Petrichor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "É o que eu queria te perguntar — eu estava atrás de um rumor, mas acho que aventureiros como você já devem saber disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "Rumores? Do que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Hmm? Você não sabe sobre a maior notícia rondando por Petrichor ultimamente...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "Sobre como acidentalmente salvamos o mundo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "Hã? Não, não, estou falando sobre o redescobrimento do lendário Castelo Desvanecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "O último registro do local foi há várias centenas de anos. E cá estava eu pensando que você estava aqui para isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Bem, isso deve ter algo a ver com a gente, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "Nesse caso, tenho certeza que você sabe que esse castelo antes pertencia a Boethius, certo? O músico mais importante da história de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Sejam as óperas que ele escreveu, ou as partituras Remurianas antigas que ele compilou, seus trabalhos possuem um lugar especial na história da música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Claro, uma imensa quantidade de recursos pode ser encontrada no castelo em que ele viveu, cada uma sendo uma relíquia importante para nós, da Associação de Músicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "Dessa forma, corri até aqui o mais rápido que pude depois de ouvir as notícias, tentando chegar na frente dos aventureiros para pegar essas relíquias importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Mas imagino que você estava um passo a minha frente, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Err, o que deveríamos dizer a ela? Aquele Boethius é realmente bem do mal, que usou toda aquela música para fazer um monte de coisa ruim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Ela ficaria triste se soubesse a verdade...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "A \"Sinfonia\" não pode mais ser usada para o mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Hmm? Do que vocês estão falando? Vocês não já encontraram algumas partituras antigas, já?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Bem, uh, se... E Paimon está realmente dizendo \"se\" Boethius fosse um sujeito muito, muito horroroso, você ainda iria querer as partituras que ele deixou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Hmm... Para ser sincera, embora eu não tenha certeza do que você quer dizer exatamente, há pouco a se dizer sobre ele além de sua música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "Pela sua ópera romântica, \"O Forasteiro à Deriva\", podemos ver facilmente que ele nunca desistiu de reviver Remuria enquanto ele vivesse, e consequentemente, viu a recém-nascida Fontaine como uma inimiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "De acordo com historiadores, ele também esteve envolvido em guerras que aconteceram antes da fundação de Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Porém, suas conquistas musicais são uma história totalmente diferente. Pode haver erros históricos em sua música, mas elas mantêm seu valor como arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "E, da forma que eu vejo, essas coisas também são parte da história. Até mesmo artes puras podem ser usadas para fazer o mal, e todos os músicos devem se lembrar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Bem, tenho certeza de que você não usaria essas coisas para o mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Haha, sou só uma pesquisadora. Estou extremamente honrada só de poder ter ouvido essas melodias antigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "Falando nisso, já que o acaso nos fez nos encontrar aqui, eu poderia te pedir para me ajudar com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Você pode considerar como pagamento pelo favor da última vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Dá última vez você disse que não precisava de pagamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Hehe, nesse caso, isso é só uma \"ajuda\", certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "Enfim, como comentei mais cedo, estou aqui para procurar pela ópera perdida renomada \"O Forasteiro à Deriva\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "De acordo com registros deixados por alguém chamado Ruggiero várias centenas de anos atrás, deve estar em algum lugar dentro do Castelo Desvanecido. Você poderia me ajudar a procurar por ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "#Afinal de contas, imagino que você é melhor versad{M#o}{F#a} nesses assuntos do que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#Bem, já que ela pediu, {NICKNAME}, e todas essas partituras não possuem mais \"aquele poder\"... a gente muito bem que poderia, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Tudo bem, vou considerar que você consentiu. Hehe, esplêndido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Conto com vocês, então. Estarei na cidade aguardando enquanto isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Eu vou precisar de uma compensação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "#Não se preocupe, você será compensad{M#o}{F#a}. Saiba que a Associação de Músicos não é uma reunião de pobretões!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Eu imaginei que isso aconteceria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Convicções incríveis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Hehe, bem, é apenas a minha opinião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "Vai ser meio complicado de explicar tudo isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "Sobre a Grande Hipnose de Petrichor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
