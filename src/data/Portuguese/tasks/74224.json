			"dialogs": [
				{
					"id": 742240901,
					"content": "#Hmm, {M#esse}{F#essa}... de fato é \"O Forasteiro à Deriva\". E pensar que você realmente encontrou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "#Não deve ter sido fácil, mas eu tinha razão em confiar em vocês, excelentes aventureir{M#os}{F#as}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Hehe, obrigada! Mesmo assim, o que você vai fazer com a partitura? Vai apresentar ela na Ópera Epiclese, talvez faturar de montão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Hmm... Ganhar dinheiro é importante, mas não tenho intenção de ficar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Essas artes antigas são patrimônio da humanidade. Assim, lançarei \"O Forasteiro à Deriva\" ao domínio público assim que minha pesquisa estiver completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Afinal, recuperar esta peça antiga e preencher uma página da história perdida não é a melhor ação a se tomar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Vou torcer por você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Bem, então, acho que devo voltar logo. Pesquisa e estudo aguardam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Ah, sim, aqui está seu pagamento. Se o acaso permitir, que nos encontremos novamente!",
