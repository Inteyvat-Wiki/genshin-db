			"dialogs": [
				{
					"id": 740880601,
					"content": "É... eu ainda não consigo esquecer como Choiseul continuou se esquivando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "E aquele Raimondo... tão soberbo e arrogante. Você viu como ele estava olhando para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "Eu acho que você é muito melhor do que qualquer um desses dois. As coisas jamais teriam sido assim se você estivesse na posição deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chronie"
				}
			]
		}
