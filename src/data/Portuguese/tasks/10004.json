			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona! Temos uma coisa pra você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Ah, {NICKNAME}, Paimon! Vocês estão {M#cheios}{F#cheias} de energia hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "Vocês disseram que têm uma coisa pra mim?! É... um jeito de ganhar Mora rápido e fácil, por acaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "Bem, na verdade, é tipo uma \"tarefa\" da sua mestre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "É, isso aí eu dispenso enfaticamente! Ugh, mas acho que não tenho escolha, né... Um espírito empreendedor é importante e tudo mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "Eu só tenho certeza que vai ser uma tortura. Conheço aquela velhota bem demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Por que você só não dá uma olhada primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Hmm, esse livro... não me parece ser especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Eita! Cartas caíram dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Ah! Talvez ela esteja tentando... se reconciliar com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "Não faço ideia. De toda forma, parece que eu deveria abrir essas cartas em ordem. Bem, vamos começar com a primeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "Se essa é a \"tarefa\" dela, deve ficar tudo bem se lermos. Vamos ver sobre o que é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "Oh, há quanto tempo, minha aluna. Receio reportar que me levantar está ficando cada vez mais difícil recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Heh, a cartada da simpatia. Ela poderia pelo menos tentar ser mais genuína...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "Lembra quando eu perseguia você e você corria pela própria vida tentando usar aquele seu fantasma Hydro para me distrair? Ah, parece que foi ontem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "Agora, você está sozinha e eu deixo meus dias passarem na minha cadeira de balanço. Eu deveria me exercitar de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Bem, então faça de outro jeito, sua bruxa velha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Hmm, pensando melhor, isso parece meu particular...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "Agora, tenho certeza que você está curiosa sobre o assunto desta carta. E para isso, digo... Se quiser aprender a como prever o destino de um reino inteiro, ou até de todo o mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "Vá para Sumeru e procure pelo portão para um reino subterrâneo. Quando estiver lá, abra a segunda carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Hmm, ela sabe mesmo como fisgar as pessoas, é inegável. Ela tá falando sério sobre me ensinar a técnica secreta dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "Acho que tá mesmo ficando velha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "Vocês duas têm uma dinâmica tão esquisita. Quando vocês falam de coisas sentimentais... vocês brigam. Mas quando o assunto é coisa acadêmica seca, vocês se emocionam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Enfim, esse \"portão para um reino subterrâneo\" parece meio familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Espera, vocês já ouviram falar dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "É. Deve ser o mesmo que estamos pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Perfeito! Eu nem preciso investigar, então! Isso significa nada de guias contratados, nada de acomodação, nada de gastadeira de um lado para o outro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "Venham, não há tempo a perder. Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "E já que você não mencionou nenhuma tarifa de transporte agora, Paimon tá achando que isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Sim! O mesmo método de sempre! Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
