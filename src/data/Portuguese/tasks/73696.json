			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bahar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "Olá, Viajante! Pelo visto, você deve estar aqui para participar da Feira da Sabedoria, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960102,
					"content": "Se você tiver interesse, gostaria de participar do evento que nós, do Haravatat, estamos organizando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960103,
					"content": "Se me lembro bem, o Haravatat estuda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "\"Linguagem\". Mas esse seria um baita resumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960105,
					"content": "É isso que pesquisamos no Haravatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960106,
					"content": "Bem, o que você acha? Parece algo que combina com a atmosfera festiva e relaxada da Feira, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960107,
					"content": "Muitos dos meus colegas de Darshan acham isso. Todo mundo está se divertindo demais, então nós não deveríamos acabar com o clima pedindo para as pessoas solucionarem enigmas, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960108,
					"content": "Além disso, um joguinho de solucionar enigmas não deixaria as pessoas interessadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960109,
					"content": "Depois de muita... discussão amigável... decidimos usar um jogo conhecido como \"Sim, Não ou Irrelevante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960110,
					"content": "Para jogá-lo, não é necessária nenhuma ferramenta ou item. Só uma mente atenta e afiada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960111,
					"content": "Quando o jogo começar, vou te contar uma história. Essa história pode parecer sem fim e até meio sem lógica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960112,
					"content": "E então você poderá me fazer perguntas, e eu só poderei responder de três formas: <color=#00E1FFFF>\"Sim\"</color>, <color=#00E1FFFF>\"Não\"</color> ou <color=#00E1FFFF>\"Irrelevante\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960113,
					"content": "O que você vai ter que fazer é usar suas perguntas para descobrir a \"verdade\" por trás da história que contei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960114,
					"content": "#Mas não fique nervos{M#o}{F#a}. A resposta certa não é tão complicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960115,
					"content": "O que acha? Se você tiver interesse, podemos começar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960116,
					"content": "Bem, vamos começar então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "Ótimo! Nesse caso, escute com atenção o que vou dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960118,
					"content": "#Desculpe, estou um pouco ocupad{M#o}{F#a} no momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "Sem problemas. Estarei aqui, você pode voltar quando quiser jogar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				}
			]
		}
	]
}