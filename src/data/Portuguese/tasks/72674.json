			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740401,
					"content": "Pelo poder da comida Bake-Danuki que fiz, vocês poderão falar com o pequeno tanuki. Tentem ter uma conversa com Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740402
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740402,
					"content": "Faremos isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740403
					]
				},
				{
					"id": 726740403,
					"content": "Bem, vão logo então. Eu tenho todo o tempo do mundo, mas lugar nenhum para ir. Entretanto, isso não é verdade para meus pequenos Tanuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		}
	]
