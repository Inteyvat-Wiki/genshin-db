			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kichiboushi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740201,
					"content": "Kichiboushi, há quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740202,
					"content": "#Hmm! Pelo branco, pelo lour{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740203
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740203,
					"content": "#Acho que pelo lour{F#a}{M#o} sou eu...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740204
					]
				},
				{
					"id": 726740204,
					"content": "Ei! Quem você está chamando de pelo branco?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740205,
					"content": "Muito forte. Posso entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740206
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740206,
					"content": "#Eu sou {NICKNAME}, essa é Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740207
					]
				},
				{
					"id": 726740207,
					"content": "Lembre-se bem disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740208,
					"content": "Prac prec Melão de Lavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740209
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740209,
					"content": "Hã? Melão de Lavanda? E o que raios \"prac prec\" significa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740210,
					"content": "Bem, não importa, nós podemos nos comunicar mais ou menos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740211,
					"content": "Mais ou menos mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740212
					]
				},
				{
					"id": 726740212,
					"content": "#De qualquer forma, {NICKNAME}, vamos voltar e ver Ioroi de novo. Afinal de contas, estamos levando Kichiboushi numa jornada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740213,
					"content": "Ioroi! Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740214
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740214,
					"content": "Uhul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7267403,
			"completionStepIds": [
				7267403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267403",
							"2"
						],
						"stepId": 7267403,
						"stateName": "QUEST_STATE_UNFINISHED"
