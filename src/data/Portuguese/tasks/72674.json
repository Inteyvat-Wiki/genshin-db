				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740301,
					"content": "Hmm! Como você está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740302
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740302,
					"content": "#Hmm! Vi pelo branco e pelo lour{F#a}{M#o}. Gosto. Melão de Lavanda Caboom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740303,
					"content": "Melão de Lavanda caboom...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740304
					]
				},
				{
					"id": 726740304,
					"content": "Hmm, você está bem animado, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740305
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740305,
					"content": "Caboom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740306
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740306,
					"content": "Hã... O que Melão de Lavanda Caboom significa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740307
					]
				},
				{
					"id": 726740307,
					"content": "Caboom é caboom. Melão de Lavanda é Melão de Lavanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740308
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740308,
					"content": "Bem, parece que vocês estão conseguindo se comunicar sem problemas. Ah, minhas habilidades culinárias são realmente incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740309,
						726740311
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740309,
					"content": "... Creio que sim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740310
					]
				},
				{
					"id": 726740310,
					"content": "Não! Que \"sem problemas\"?! Não entendemos nada do que Kichiboushi fala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740312,
					"content": "Bem, é o seguinte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740313,
					"content": "Você conta para Ioroi como está a comunicação...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740314
					]
				},
				{
					"id": 726740314,
					"content": "#Hmm, então é isso... Não se preocupem. É porque vocês ainda não estão acostumad{F#as}{M#os} com a aura de Kichiboushi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740315
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740315,
					"content": "#Vão mais devagar! Quanto mais acostumad{F#as}{M#os} com a aura dele, melhor o entenderão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740316
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740316,
					"content": "Devagar significa quanto tempo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740317,
					"content": "Ah, hmm, deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740318
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740318,
					"content": "De qualquer forma, não tenham pressa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740319
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740319,
					"content": "Pressão não bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740320
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740320,
					"content": "Você também não sabe, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740321
					]
				},
				{
					"id": 726740321,
					"content": "Hmph! Deixe-me lhe dizer que eu vivi muito tempo! Sou Ioroi, o rei dos Bake-Danuki! O tempo para mim não é como para vocês humanos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740322
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740322,
					"content": "(Apesar dele ter passado a maioria de seu tempo selado nessa estátua de pedra...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740323,
					"content": "Entretanto, por que você consegue falar com os humanos normalmente, Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740324
					]
				},
				{
					"id": 726740324,
					"content": "Hmph! Que impertinência! Na verdade, a pergunta deve ser por que vocês, humanos, podem falar conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740325
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740325,
					"content": "Tendo vivido por tanto tempo e se tornado poderoso como eu sou, tive algumas interações com os humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740326
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740326,
					"content": "Muito, muito tempo atrás, eu sempre conversei com os tengu, kitsune, Oni, youkai e humanos. E apesar das histórias humanas geralmente só se preocuparem consigo mesmo, pelo menos metade delas envolvem Bake-Danuki que se transformaram em humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740327
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740327,
					"content": "A outra metade são somente sobre os humanos, e a outra metade são sobre os demais youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740328
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740328,
					"content": "Mas, mesmo nessa metade, a metade dela concerne a nós, tanuki, que nós disfarçamos de outros youkai. Por isso, metade dos contos tanuki são sobre mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740329
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740329,
					"content": "Hmm, dessa forma, você pode ver que eu sou o maior de todos. Naturalmente, falar com vocês jovens não é nada demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740330
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740330,
					"content": "Já entendo, cinco dezesseis avos para Ioroi, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740331
					]
				},
				{
					"id": 726740331,
					"content": "Hã? Cinco sobre dezesseis avos? Isso é algo gostoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740332
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740332,
					"content": "Parece delicioso. Quero comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740333
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740333,
					"content": "#{NICKNAME} está falando da porcentagem de histórias que você está envolvido, Ioroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740334,
					"content": "Ioroi. Poderoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740335
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740335,
					"content": "Haha, mas é claro! Você tem muito a aprender sobre meus poderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740336
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740336,
					"content": "Hã? Pensando bem, nós estamos começando a entender o que Kichiboushi está falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740337,
					"content": "Pelo Branco esperta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740338
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740338,
					"content": "Isso pode ter sido um elogio, mas Paimon não se sente bem com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740339,
					"content": "Ótimo. Bem, deixarei esse garoto com você. Leve-o para ver o mundo e treinar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740340
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740340,
					"content": "Quando eu era um jovem tanuki, parti em uma jornada para dezoito locais em Inazuma, seguindo o caminho do grande Bake-Danuki Tsukumo. Nunca desviei do caminho tanuki, foi só assim que alcancei minha grandeza atual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740341
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740341,
					"content": "Hã?! É por isso que você foi selado em pedra?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740342,
					"content": "Mmhaha! Pedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740343
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740343,
					"content": "Hã?! Até tu, Kichiboushi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740344
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740344,
					"content": "*Cof*! De volta ao tópico, para onde devemos ir primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740345,
						726740347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740345,
					"content": "Ioroi há pouco mencionou um lugar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740346
					]
				},
				{
					"id": 726740346,
					"content": "Sim! Vamos para a Espinha do Dragão então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740348,
					"content": "\"Se há uma montanha, nós a escalaremos\" — Ah, Paimon estava esperando uma chance de dizer algo legal assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740349,
					"content": "Ali está a montanha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740350
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740350,
					"content": "Ooh, soa frio... Kichiboushi, não deixe sua barriga ficar gelada, ou você ficará resfriado. E se ficar resfriado, não conseguirá fazer sua barriga tocar como um tambor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740351
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740351,
					"content": "#Lembre-se de comer bem e seguir {F#tia}{M#tio} Pelo Louro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740352
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740352,
					"content": "#Entendi! Seguir {F#tia}{M#tio} Pelo Louro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740353,
						726740354,
						726740355
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740353,
					"content": "Vamos cuidar bem de Kichiboushi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740356,
					"content": "É um prazer conhecer você, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740357,
					"content": "Hmm! Não preocupar! Kichiboushi cuidar vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740358
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726740358,
					"content": "Hmm, parece que não estamos nos entendendo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740354,
					"content": "Pode relaxar, deixe conosco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740355,
					"content": "#Não é {F#tia}{M#tio}! É {F#irmãzona}{M#irmãozão}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740356
					]
				},
				{
					"id": 726740347,
					"content": "Que tal Espinha do Dragão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740348
					]
				},
				{
					"id": 726740311,
					"content": "Que \"sem problemas\"?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740312
					]
				}
			]
		},
		{
			"id": 7267404,
