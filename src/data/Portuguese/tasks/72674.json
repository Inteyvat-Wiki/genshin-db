	"talks": [
		{
			"id": 7267401,
			"completionStepIds": [
				7267401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267401",
							"2"
						],
						"stepId": 7267401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726740101,
					"content": "Ioroi, oi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740102,
					"content": "Raios! Fui descoberto! Como vocês... Esperem, este cheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740103
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740103,
					"content": "Ah, são vocês. Há quanto tempo! Não consegui reconhecer seu cheiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740104
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740104,
					"content": "E você não mudou nada, Ioroi. Ainda tem medo de humanos, e também está selado em pedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740105,
					"content": "Hã?! O que você está insinuando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740106,
						726740107
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740106,
					"content": "Espero que seu selo possa ser quebrado logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				},
				{
					"id": 726740108,
					"content": "É só um selo humano! Se eu me esforçasse mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740109
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740109,
					"content": "Cof, cof.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740110
					]
				},
				{
					"id": 726740110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740111
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740111,
					"content": "#Bem, de qualquer forma, vejo que você cuidou bem de minhas crianças. Meus Tanukis dizem quem eles gostam de brincar com {F#a}{M#o} {F#tia}{M#tio} cheiros{F#a}{M#o} lour{F#a}{M#o} deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740112,
						726740113,
						726740114
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740112,
					"content": "#{F#Tia}{M#Tio} lour{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740115,
					"content": "E aqui estava eu pensando que os humanos eram todos iguais como aquele cara que nos selou: maléficos e assustadores. Mas parece que entre vocês ainda há algumas boas pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740116,
						726740117
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740116,
					"content": "A maioria das pessoas são boas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740118,
					"content": "Sim, é isso. A maioria das pessoas que conhecemos são boas pessoas! Você foi selado porque roubou aquele pente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740119,
					"content": "Hmph! E eu o devolvi! Se vocês conheceram aquele cara que aprendeu mágica com Reizenbou, digam a ele para me tirar dessa pedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740120
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740120,
					"content": "No fundo, tudo é culpa daquela kitsune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740121
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740121,
					"content": "(Ioroi reclama como se fosse um velho).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740122,
					"content": "(Bem, ele é muito velho).",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740123
					]
				},
				{
					"id": 726740123,
					"content": "Bem, nem suas mãos ou pernas são feitas de pedra, por isso já devem ter ido a muitos lugares, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740124
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740124,
					"content": "Sim! Nós viemos do outro lado do oceano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740125,
					"content": "Você conta para Ioroi suas aventuras em Mondstadt e Liyue.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740126
					]
				},
				{
					"id": 726740126,
					"content": "... Então existem tantas terras além daqui. Impressionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740127
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740127,
					"content": "Eu apenas fico sabendo do que ocorre devido aos relatórios de meus pequenos Tanuki por todo esse tempo, por isso não sei como é o mundo exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740128
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740128,
					"content": "Uma vez, eu fiquei no topo da Montanha Yougou e vi uma montanha muito alta do outro lado do oceano, talvez ela fosse até mesmo mais alta que a Montanha Yougou. Ainda me pergunto que lugar era esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740129,
						726740131
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740129,
					"content": "Do outro lado do oceano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740130
					]
				},
				{
					"id": 726740130,
					"content": "Deve ser a Espinha do Dragão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740132,
					"content": "Hmm, Espinha do Dragão? Só de ouvir esse nome, sinto um frio na minha barriga. Sabe-se lá porque aquele jovem que ir lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740133
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740134
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740134,
					"content": "Como eu disse antes, vocês são boas pessoas, não? Por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740135
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740135,
					"content": "Paimon já está sentindo de longe o cheiro de algum favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740136,
					"content": "Hmm! Eu sou o Protetor Oculto do Bosque, guardião da Floresta Chinju, apontado pela própria Toda-Poderosa Narukami Ogosho! Se não estivesse selado em pedra, eu certamente usaria um tatami octogonal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740137,
						726740138
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740137,
					"content": "Está bem, do que você precisa de ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740143
					]
				},
				{
					"id": 726740143,
					"content": "Apesar de eu não poder me mover com minhas próprias forças, minhas crianças podem. Dessa forma, gostaria de lhe pedir para levar os meus pequenos Tanukis para treinarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740144
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740144,
					"content": "Leve Kichiboushi com você. Ele ficou muito animado para lhe ver desde a última vez que vocês brincaram juntos — muito animado mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740145,
						726740146
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740145,
					"content": "Bem, podemos fazer isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740147,
					"content": "Sim. Não entendemos o que Kichiboushi fala, por isso não seria um pouco difícil viajar com ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740148,
					"content": "Impossível. Nós, Tanuki, entendemos a fala humana por natureza. São vocês humanos que não entendem a nossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740149
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740149,
					"content": "O quê?! É isso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740150,
					"content": "#Mas, como companheir{F#as}{M#os} de viagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740151
					]
				},
				{
					"id": 726740151,
					"content": "Nós gostamos de conversar enquanto viajamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740152
					]
				},
				{
					"id": 726740152,
					"content": "#Assim como Paimon faz com {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740153,
					"content": "Hmph, muito bem então. Agora que estou pensando, alguém numa certa ocasião não usou nossa mágica para fazer comida para vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740154
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740154,
					"content": "Eu posso parecer assim agora, mas fazer uma \"refeição\" para vocês que lhes permitam entender o que Kichiboushi fala não é um problema para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740155
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740155,
					"content": "Uhu! Comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740156,
					"content": "Não acho que ela será gostosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740157
					]
				},
				{
					"id": 726740157,
					"content": "Não subestimem minhas habilidades culinárias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740158
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740158,
					"content": "Apesar de não saber de onde Ioroi o pegou...\\nVocê e Paimon comem um banquete \"que parece delicioso\" que saiu da barriga de pedra de Ioroi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726740159
					]
				},
				{
					"id": 726740159,
					"content": "Que delícia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740160,
					"content": "Claro que sim. Eu sou Ioroi — o mesmo que fez pratos de Sashimi de bolas de lama e pelo Tanuki para enganar os Quatro Oni de Ogata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740161
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740161,
					"content": "Ioroi, isso é incrível! Mas, do que é feita essa refeição que nós comemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740162,
					"content": "Paimon, talvez seja melhor que algumas perguntas não sejam feitas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740163
					]
				},
				{
					"id": 726740163,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740164,
					"content": "Bem, não importa. Vamos procurar Kichiboushi para conversar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740146,
					"content": "Ainda tenho uma pergunta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740147
					]
				},
				{
					"id": 726740138,
					"content": "Bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740139
					]
				},
				{
					"id": 726740139,
					"content": "Ooh, Paimon entende o que você quer dizer! Envolve tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740140,
					"content": "Tesouro? Claro que sim! E eu sou o chefe de quinhentos e cinco bake-danuki! Nem sequer um tesouro de Inazuma escapou de minha vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740141
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 726740141,
					"content": "Nesse caso, no que você precisa de ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740142
					]
				},
				{
					"id": 726740142,
					"content": "#É isso mesmo, nós somos ótim{F#as}{M#os} em ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726740143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726740131,
					"content": "Da direção que você está falando, provavelmente é a Espinha do Dragão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740132
					]
				},
				{
					"id": 726740117,
					"content": "#Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740118
					]
				},
				{
					"id": 726740113,
					"content": "#Cheiros{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740114,
					"content": "#Não é {F#tia}{M#tio}, é {F#irmãzona}{M#irmãozão}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740115
					]
				},
				{
					"id": 726740107,
					"content": "Paimon quer dizer que esperamos que seu selo possa ser quebrado logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726740108
					]
				}
			]
		},
		{
			"id": 7267402,
			"completionStepIds": [
				7267402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
