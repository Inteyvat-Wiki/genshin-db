			"dialogs": [
				{
					"id": 150201001,
					"content": "Oh, e você está aqui para ajudar? Graças aos céus! De jeito nenhum eu conseguiria fazer isso tudo sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201002,
					"content": "O bloqueio daqui precisa ser removido usando uma bomba especial, mas carregar explosivos por essa ladeira ingrime é algo muito perigoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201003,
					"content": "Se eu derrubar, ou escorregar e cair, eu explodirei em mil pedacinhos em um instante. Então meu plano era de transportar a bomba para o outro lado, então mandar por um balão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201004,
					"content": "Tudo que preciso agora é que outra pessoa <color=#00E1FFFF>acerte o balão no momento certo, derrubando a carga bem em cima do bocal...</color> e problema resolvido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201005,
					"content": "O que acha? Bem simples, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201006,
					"content": "Acho que consigo lidar com isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Aquele balão lá em cima também é seu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "Hã? Oh, aquele... Não, não faço ideia de a quem ele pertence. Ou como subiu tão alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201009,
					"content": "Eu apenas gostaria de voar até lá e dar uma olhada em que tipo de tecnologia estão usando... Bem, enfim, consertar a arena do julgamento é mais importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201010,
					"content": "#Irei até lá montar as coisas. Me avise quando estiver pront{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigador Corajoso"
				}
			]
