			"dialogs": [
				{
					"id": 150201401,
					"content": "Isso é absurdo... Coloquei toda minha força nisso, mas apenas não quebra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201402
					],
					"speakerTitle": "Investigadora Curiosa"
				},
				{
					"id": 150201402,
					"content": "Talvez Inkanak estava certo no fim das contas... Se uma estrutura estável se formou dentro do Flogisto Sólido, precisarei acertar todos os pontos fracos ao mesmo tempo para quebrá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201403
					],
					"speakerTitle": "Investigadora Curiosa"
				},
				{
					"id": 150201403,
