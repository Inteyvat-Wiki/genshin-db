			"dialogs": [
				{
					"id": 150200501,
					"content": "#Está pront{M#o}{F#a}? Deve ser facílimo para Chasca, mesmo assim, tente ter cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "Tenho certeza que ela ficará bem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Muito bem, então, abra suas asas e voe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200504,
					"content": "Ainda não, preciso de um pouco mais de tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
