			"dialogs": [
				{
					"id": 150200101,
					"content": "Ah, olá, Chasca. Vovó Allpa te enviou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "É, ela tem outras coisas para resolver agora. Como estão as coisas aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hmm, bem, a inspeção revelou inúmeros bloqueios por toda a arena de julgamento. Parece serem o resultado de desordens das Linhas Ley causadas pelas repetidas invasões do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Teoricamente, só precisamos remover esses obstáculos e a arena se encherá com Flogisto Gasoso novamente. Mas tá sendo difícil conseguir isso na prática, por todo tipo de motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Por que vocês não vão dar uma conferida? Fiquem à vontade para perguntar mais detalhes aos funcionários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
			"id": 1502002,
