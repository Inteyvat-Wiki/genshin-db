			"dialogs": [
				{
					"id": 150200601,
					"content": "Isso foi incrível! Paimon não conseguiria tirar os olhos de você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "Então, algum problema com a área?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Hmm... Não, nada sério. Espere alguns dias, e poderemos fazer os julgamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "Socorro... Socorro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "...Você é do Clã das Plumas de Flores, não é? Por favor, venha rápido, você precisa nos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Respire primeiro. O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "N-Nós... fomos atacados, por um Qucussauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "Meus amigos ainda estão presos no meio da estrada com as mercadorias que estávamos transportando... Por favor, eu imploro, salve-os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Hã? Qucussauros são realmente assim tão agressivos? Eles normalmente atacam grupos de pessoas sem motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200610,
					"content": "Até onde eu saiba, não... mas sempre há exceções. Vamos ir dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
