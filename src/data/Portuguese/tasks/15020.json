					"content": "Hã? Por que vocês me seguiram até agora? Vocês não vão ter uma boa visão daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201102
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
					"id": 150201102,
					"content": "Você poderia revisar o plano comigo novamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201103
					]
				},
				{
					"id": 150201103,
					"content": "Oh, claro. Então, mandarei os explosivos para o bocal do outro lado em um balão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201104
					],
					"speakerTitle": "Investigador Corajoso"
				},
				{
