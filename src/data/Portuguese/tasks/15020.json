			"dialogs": [
				{
					"id": 150200701,
					"content": "Que estranho... por que tem tanto Flogisto Sólido por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Investigador Duvidoso"
				},
				{
					"id": 150200702,
					"content": "Poderia ser dos Filhos dos Ecos...? Talvez foi trazido até aqui por conta das perturbações das Linhas Ley. <color=#00E1FFFF>E eu vi aquelas marcas estranhas no penhasco...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200703
					],
					"speakerTitle": "Investigador Confuso"
				},
				{
					"id": 150200703,
					"content": "Urg, eu não consigo pensar em nenhuma forma de resolver isso... Talvez teremos que ir até lá nos Filhos dos Ecos para pegar um <color=#00E1FFFF>Tepetlissauro</color> emprestado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Investigador Duvidoso"
				}
			]
		},
