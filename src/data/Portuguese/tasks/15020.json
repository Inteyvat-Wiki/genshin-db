			},
			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hmm? Chasca, {NICKNAME}? Que surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Vovó Allpa? Hã? Então... onde está o tal Qucussauro agressivo que ouvimos falar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Já saiu voando. Parece que ele desistiu assim que percebeu que reforços estavam chegando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Então, por qual motivo você acha que ele atacou essas pessoas? Estava atrás de comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "Não, esses comerciantes sequer estão transportando comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Ah! Graças aos céus! As Asas de Flogisto estão intactas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Comerciante Jovem"
				},
				{
					"id": 150200807,
					"content": "...Asas de Flogisto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "Ahh, muito obrigado por ter vindo nos salvar. Essas Asas de Flogisto são nossas mercadorias mais importantes. Se algo tivesse acontecido com elas, teria acabado conosco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "...Espera um minutinho aí, vocês são os comerciantes que queriam fazer uma parceria conosco? Warmi me contou sobre vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Sim, somos nós! Então... Imagino que você seja a Vovó Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "Isso mesmo. Você deve estar exausto de sua jornada, sem falar o quão assustados com o ataque. Deixe-me trazer vocês de volta para nossa tribo para descansar — podemos falar sobre negócios depois que tiverem se recuperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Mas, Vovó Allpa, e quanto ao ataque do Qucussauro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Bem, nossos convidados não foram gravemente feridos, e suas mercadorias estão intactas... Talvez aquele Qucussauro só estava tendo um dia ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Há tantos deles por aqui, você esperaria que algo assim acontecesse de vez em quando. Não acho que precisamos ir muito mais a fundo nisso... Mais importante, como estão indo os preparativos para os julgamentos voadores? Está tudo bem na arena?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Está tudo indo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Hã? Você disse... julgamentos voadores? Uau, que coincidência! Parece a oportunidade perfeita para nossas Asas de Flogisto! Você ficará agradavelmente surpresa com o que elas podem fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Oh, sério? ...Agora estou intrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Hehe, bem, então vamos esquecer sobre todo esse assunto de ataque de Qucussauro por agora... Temos assuntos sérios a discutir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Então, é isso? Tudo saiu bem mais tranquilo do que o esperado... Bem, acho que é melhor irmos andando... Hã? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "O que você está olhando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Uma pena manchada de sangue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "O incidente é esquecido, e a paz retorna ao Clã das Plumas de Flores.\\nOs próximos dias são tranquilos — exceto pelos preparativos para o julgamento voador, que continua a passos largos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "Os julgamentos poderão começar em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
