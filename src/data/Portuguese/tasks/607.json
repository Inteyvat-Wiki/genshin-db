			"dialogs": [
				{
					"id": 6070101,
					"content": "Fiquem firmes! Arrastem outro armário para cá! Ugh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070102
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070102,
					"content": "Bestas vis! O Reino da Noite Eterna não tolera tais transgressões...",
