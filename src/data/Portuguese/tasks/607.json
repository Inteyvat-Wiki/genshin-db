			"dialogs": [
				{
					"id": 6070201,
					"content": "Não temam. As criaturas vis foram lançadas ao vazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "Minha princesa quer dizer que vocês devem evitar sair por enquanto. Continuaremos protegendo esta área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "Agradeço muito mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070204,
					"content": "Mas, hmm... Eu nunca vi um pássaro que pode, ahm... falar, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070205,
					"content": "Ah, não se preocupe. Sou o humilde servo de minha princesa. Não represento nenhum perigo para você, posso garantir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "Pode confiar neles. Prometo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Ah, não. Claro! Eu não quis dizer nesse sentido. Eu só, hmm, falei errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070208,
					"content": "Hunf, não foi nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "#{M#Meus vassalos}{F#Minhas vassalas} ainda têm deveres inacabados, sim? Então sigam e esmaguem essas bestas malditas. A bênção da Princesa iluminará o caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
			]
