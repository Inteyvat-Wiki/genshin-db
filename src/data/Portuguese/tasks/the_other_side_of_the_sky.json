					}
				]
			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "Uhul, conseguimos! Ainda assim, essa Inscrição Iridescente é familiar. Será que esse é o famoso Jade do Retorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Espera um segundo, isso não é o Prato Dourado do Ultimato? É o mesmo que pegamos na Placa de Pedra antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Rooo... Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Uau, realmente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "E sabe, um tesouro que pode suprimir a impureza do Abismo e um amuleto que pode remover maldições e desastres realmente soa bem parecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "Você só percebeu isso agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "Sério!? Por que você apenas não disse a Paimon se já sabia!? Espere um segundinho aí, como você sabia? Espera, isso é aquele papo de \"experiência de um aventureiro\" de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "E sabe, um tesouro que pode suprimir a impureza do Abismo e um amuleto que pode remover maldições e desastres realmente soa bem parecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Mas isso consegue realmente suprimir o Abismo em Ochkanatlan? Paimon nunca ouviu ninguém da Associação de Relíquias Saurianas mencionar isso antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Hmm, e desde que o Jade do Retorno é apenas um Prato Dourado do Ultimato, poderia ser esse o motivo do dragão maligno estar atrás da gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Ufa, então não era por estar de olho no Ensopado Flamejante de Paimon hoje de manhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Parece que as pistas estão se encaixando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "Parece que realmente era um presságio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
					"content": "Hmm, mas Bona provavelmente ainda não sabe sobre o Prato Dourado do Ultimato... Ei, Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360515,
					"content": "Algo não está certo... Tenho certeza que já estive aqui antes, o Tonatiuh e o Jade do Retorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360516
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360516,
					"content": "Sim, devemos destruí-lo... Não pode cair nas mãos daquela pessoa...",
					"roleType": "TALK_ROLE_NPC",
