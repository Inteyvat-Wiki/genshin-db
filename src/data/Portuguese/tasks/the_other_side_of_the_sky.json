			"dialogs": [
				{
					"id": 751360401,
					"content": "Urg, quem diria que estaríamos por toda parte procurando por pedras depois de finalmente chegar ao Tonatiuh? Achei que essa seria uma aventura bem mais emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "Enfim, estou contando com vocês para pegar as Pyrochas. Deem um oi se precisarem de algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
