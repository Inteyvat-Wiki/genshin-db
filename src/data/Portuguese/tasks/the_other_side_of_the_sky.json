						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Nós... Nós estamos vivos! É realmente ótimo pisar em terra firme de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "Mas você flutua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Ei, há uma enorme diferença entre flutuar perto do chão e ser jogada de um lado para o outro no céu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "O \"chão\" aqui também não parece muito resistente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Não assuste a Paimon desse jeito! Se cairmos, ela não vai conseguir puxar você e {REALNAME[ID(2)|SHOWHOST(true)]} de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "Cheep, ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751360107,
					"content": "Esse é o Tonatiuh? Conseguimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Parece mais uma enorme bola de lã do que um navio! Ou cobras, com todos aqueles emaranhados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Mas parece mais seguro, pelo menos, então vamos voar até lá... Hm, espera. Cadê a Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Ela disse que tem muita experiência em voar, mas a Paimon ainda está um pouco preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Desde que a direção do vento esteja correta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Você tem razão, ela provavelmente aterrissou em algum lugar por aqui, se for esse o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "De qualquer forma, não saberemos se apenas ficarmos aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "#Você está cert{M#o}{F#a}, precisamos seguir em frente. Talvez ela já esteja nos esperando a bordo do navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "Certo, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
