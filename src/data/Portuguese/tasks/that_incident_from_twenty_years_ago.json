				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kashmer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "\"Aquilo de vinte anos atrás\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "...Acho que eu não devia ter dito isso para ninguém. Bebi mais do que devia na última vez, meus lábios se abriram, e agora as pessoas ficam vindo atrás de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "#Como vocês estão curios{F#as}{M#os}, acho que vou contar para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Vinte anos atrás, eu era um garoto com seis anos de idade, e não consigo me lembrar bem o que aconteceu. Algum tempo atrás, eu li o diário que tinha quando era criança, e foi assim que lembrei vagamente do que aconteceu na época.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "O Campeonato Interdarshan também foi realizado naquele ano. Haviam três rodadas, com a última fora da cidade. Eu implorei para a minha mãe para levar para a cidade para ver, e quando ela não deixou, eu saí escondido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "E depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "Eu acabei perdido fora da cidade. No meio do nada, não havia ninguém. Eu fiquei cada vez mais assustado, e comecei a chorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "Foi quando vi umas criaturas estranhas... Não consigo me lembrar em como se pareciam. Apenas me lembro que, quando criança, me lembro de olhar para eles e rapidamente parar de chorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "Criaturas estranhas... deve ter sido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Os Aranaras.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Eles me levaram para a competição. Infelizmente, quando chegamos lá, era tarde demais. Já tinha acabado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "Bem quando eu estava completamente desanimado, de repente, vi uma dessas criaturas estranhas lentamente arrastando uma coroa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "Era uma bela coroa, brilhando na luz da lua, e eu não pude evitar de segui-la. Vi a pequena criatura esconder a coroa em um buraco na árvore antes de desaparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "Eu queria tocar aquela coroa. Mas naquele momento, eu conseguia ouvir os gritos distantes da minha mãe. No fim das contas, ela descobriu que eu estava perdido e pediu ajuda dos vizinhos para me procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Eu não toquei a coroa até estar mais velho e ver o \"Diadema do Conhecimento\" no Campeonato Interdarshan. Eu percebi que era a mesma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Certo... você lembra onde aquela coroa acabou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Está provavelmente na Floresta Avidya, mas eu voltei algumas vezes e não encontrei nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Ninguém acreditaria em mim, mesmo se eu contasse a eles. Bem, minha memória não está mais tão clara. Talvez fosse um sonho que tive quando criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Bem... vamos procurar por ela, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
