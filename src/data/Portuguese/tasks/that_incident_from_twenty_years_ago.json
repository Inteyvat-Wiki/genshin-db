			"dialogs": [
				{
					"id": 735200101,
					"content": "Você decidiu comprar informações de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Hmmm... Paimon está um pouco curiosa sobre suas informações exclusivas, mas precisamos saber o preço primeiro! Se for muito caro, esqueça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Vou vender pelo preço fixo de um milhão de Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "Isso é muito! Deixa pra lá, um milhão de Mora pode comprar muita, muita comida gostosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Esperem... Deixem-me ver... Hã? Paimon é a cliente Nº 1001 de hoje. O custo original da informação era 1 milhão de Mora, mas para você o preço é de graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Hã? Paimon nem sabia que uma sorte como essa existia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Espera, você não está enganando a gente para gastar mais, né? Talvez a primeira frase seja de graça, mas a seguinte não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "Se vocês não quiserem, ótimo! Próximo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Não, não, espera! Esqueça o que Paimon disse. Vamos escutar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Informação exclusiva da Dori número um! Vocês se lembram do Diadema do Conhecimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Sim, Paimon lembra que o campeão podia usar a coroa, e que ela parece muito valiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Exatamente. A coroa que Sachin deu para a Academia era uma antiguidade caríssima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Mas esse diadema, depois de ter sido doado para a Academia, foi perdido por eles uma vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Hã? Como nunca ouvimos isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Hehe, se todos soubessem disso, será que minha informação seria considerada \"exclusiva\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Claro, essa informação não saiu do nada. Eu tenho testemunhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "#Há um jovem chamado Kashmer, dos subúrbios. Se estiverem interessad{F#as}{M#os} em saber mais, podem ir falar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "A senha é... \"Aquilo de vinte anos atrás\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
		{
