				]
			},
			"dialogs": [
				{
					"id": 735200301,
					"content": "Tem um buraco naquela árvore. Parece completamente vazio, e não há nada nele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200302,
					"content": "Hã? Espera! Tem uma nota aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200303,
					"content": "\"O bom Arakasyapa ensinou os Aranara como ler. Os Aranara devem protegê-lo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200304,
					"content": "O que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7352022,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
