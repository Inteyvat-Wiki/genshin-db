					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Ah, é o jovem detetive, eu o conheço. Seu nome é Shikanoin Heizou, ele estava sempre por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "A Sangonomiya até me enviou para ficar de olho nele naquela época, para que ele não fizesse algo errado. Mas acontece que ele estava lá apenas para ficar longe de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Deixe-me ver, acredito que ele também foi visto recentemente na área leste de Sangonomiya. Você pode ir lá ver se quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
