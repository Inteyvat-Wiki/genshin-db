					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "Gostaria de saber qual é o mal-entendido entre vocês.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Se ele realmente desaparecer, eu vou celebrar esse grande dia do seu desaparecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Sorrir e assentir educadamente.)",
