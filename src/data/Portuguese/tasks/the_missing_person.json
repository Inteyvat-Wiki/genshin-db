			"dialogs": [
				{
					"id": 190361701,
					"content": "#Ah, você é... Você é {M#o capitão}{F#a capitã} do Peixe-Espada II! Eu sou Shibata, guardião deste lugar. Precisa de alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
