					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "De qualquer forma, é melhor você ir antes que Shikanoin cause sérios problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "Aliás, não se esqueça de me avisar se encontrar algum item dele. Vai me deixar muito feliz.",
