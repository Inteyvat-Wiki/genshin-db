			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040301,
					"content": "Esta aqui é uma cidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040302,
					"content": "Uma cidade que flutua no ar... E que fica de cabeça para baixo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040303,
						80040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040303,
					"content": "Que cenário impressionante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				},
				{
					"id": 80040402,
					"content": "#{NICKNAME}, olhando para este lugar, você está lembrando de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040403,
					"content": "Hum... O que era mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040404,
					"content": "\"Estátua Profanada\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "Isso! Isso mesmo! Bizarra, de cabeça para baixo e em certos aspectos, até mesmo impressionante! E essa mesma sensação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040406,
					"content": "Isso quer dizer que a parte debaixo do Despenhadeiro realmente tem a ver com a Ordem do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040407,
					"content": "Precisamos arranjar um jeito de investigar isso melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040408,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040409,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040410,
					"content": "Dainsleif?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "Também não achei que iria me encontrar com vocês por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040413,
					"content": "Quanto tempo! Dain... Não, espera aí... O que você está fazendo aqui no Despenhadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040414,
					"content": "Despenhadeiro... Ou seja, aqui é a parte debaixo do Despenhadeiro? Um lugar que nem mesmo eu já pisei? Então era isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040415,
					"content": "Tenho muitas coisas que preciso te perguntar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "Eu entendo como você deve estar se sentindo já que o nosso encontro e a nossa despedida aconteceram de forma muito repentina da última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040417,
					"content": "Por tal coincidência que acabou de acontecer, o destino realmente te deve uma resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040418,
					"content": "Me esclareça primeiro como você chegou até aqui do nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "Suponho que não deve ser muito difícil de perceber que eu detectei algumas ações de um Apóstolo do Abismo e então comecei a persegui-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040421,
					"content": "Mas infelizmente, aquele cara usou seu truque antigo de novo depois que eu deixei ele sem escolhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040422,
					"content": "Eu fui seguindo ele e acabei entrando no portal, e como você pode ver, fui teleportado para um lugar errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040423,
					"content": "Então, isso quer dizer que na última vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "Não. De acordo com as minhas experiências recentes, acredito que o Abismo tem o poder de manipular o teleporte... Ao invés de ser ponto a ponto, o teleporte deles tem uma rede integral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040426,
					"content": "Isso quer dizer então que o destino do teleporte pode ser qualquer ponto desta rede, e são eles que decidem isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040427,
					"content": "Isso soa parecido com os Ponto de Teleporte, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040428,
					"content": "#Enfim, mesmo que daquela vez eu tenha conseguido entrar no portal seguindo {M#a sua irmã}{F#o seu irmão}, no momento seguinte, quando me dei conta, eu já...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040429,
					"content": "Estava sozinho, na Toca do Stormterror.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040430,
					"content": "Ah, falando nisso, Paimon queria saber como está o olho do primeiro \"Cultivador da Terra\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040431,
					"content": "Está tudo sob controle... Pode ficar tranquila que antes de eu saber o real motivo do plano do \"Tear do Destino\", ele não cairá nas mãos do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040432,
					"content": "Por que você não refresca a minha memória?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "Ha, você memorizou este título, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040435,
					"content": "Não que eu esteja escondendo de propósito, mas ele uma vez testemunhou a glória de Khaenri'ah, e agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040436,
					"content": "Este título parece mais uma ironia, ou uma espécie de maldição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040437,
					"content": "Eu, como o capitão dos guardas reais que testemunhou a destruição da própria pátria, acredito que tenho um motivo muito bem justificado de não querer mais lembrar sobre este título.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040438,
					"content": "#Parece que {M#a sua irmã}{F#o seu irmão} estava {M#certa}{F#certo}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040439,
					"content": "#Então o que realmente aconteceu entre mim e {M#a minha irmã}{F#o meu irmão}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "Éramos companheiros de viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040442,
					"content": "Foi uma jornada dolorosa em busca do nosso destino, mas infelizmente... Não conseguimos chegar até o final da jornada juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040443,
					"content": "O final da jornada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "Antes de você continuar com as suas perguntas sem fim, tenho a obrigação de te dizer que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040445,
					"content": "Se meus palpites sobre a rede do teleporte estiverem certos, e pelo fato de eu ter sido teleportado de novo para cá, para a Ordem do Abismo, deve então existir um porquê deles terem estabelecido um ponto de teleporte por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040446,
					"content": "#Você quer dizer que a Ordem do Abismo está conspirando algo ruim por aqui? Isso coincide com o que eu e {NICKNAME} estávamos pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040447,
					"content": "Então, agora, neste momento, é muito possível que a gente esteja sendo vigiado pelo Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040448,
					"content": "Pare... Pare de dizer isso. Paimon está ficando arrepiada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040449,
					"content": "Vamos investigar primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "Hehe, escolha sensata. Parece haver um brilho lá no muro, vamos dar uma olhada lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80040450,
					"content": "Eu acredito em você, por enquanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "O que aconteceu entre vocês dois?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "\"Espada do Crepúsculo\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#Você não conseguiu alcançar {M#a minha irmã}{F#o meu irmão} com o portal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "E o que era aquele portal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "Que entrada impressionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040304,
					"content": "Isso realmente foi além da minha imaginação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040402
					]
				}
			]
		},
