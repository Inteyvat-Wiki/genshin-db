			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "Oh, Viajante, que coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040102,
					"content": "Katheryne, por que você está tão feliz em nos ver? Que Comissão tem para nós hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040103,
					"content": "Talvez porque hoje eu fui ao santuário tirar um Rolinho, e a Sacerdotisa me disse que terei \"um reencontro inesperado\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040104,
					"content": "Katheryne, você foi para o santuário tirar Rolinhos? Paimon está com uma sensação de que isso é algo muito, muito inusitado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040105,
					"content": "Espere um pouco... Você foi para Inazuma em um dia e voltou?! Nós estamos em Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040106,
					"content": "Hehe, até eu tenho uma vida privada, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040107,
					"content": "Então você quer dizer que \"um reencontro inesperado\", está falando de nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040108,
					"content": "Quem sabe? Pelo menos com essa expectativa, qualquer pessoa que eu encontrar ficarei feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040109,
					"content": "Bom.... O fato é que a gente se vê quase todos os dias... Mas enfim, contanto que você esteja feliz, é tudo o que importa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040110,
					"content": "Um reencontro inesperado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#Você quer dizer... Hum, eu entendo muito bem o que você está sentindo, {NICKNAME}. Espero que o que a Sacerdotisa disse seja verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040113,
					"content": "#{M#A sua irmã}{F#O seu irmão}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040114,
					"content": "#Vocês parecem estar um pouco decepcionad{M#os}{F#as}, será que eu disse algo inapropriado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040115,
					"content": "Tudo bem, Katheryne. É melhor a gente voltar ao assunto de comissões. Você tem alguma comissão com que a gente possa dar uma mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040116,
					"content": "Sim. Por acaso recebemos uma comissão de um minerador, é para investigar o Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040117,
					"content": "Hã? Isso quer dizer que o Despenhadeiro está acessível agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040118,
					"content": "Sobre os detalhes, é melhor vocês se comunicarem diretamente com o solicitante. O nome dele é Yuehui, e partindo agora acredito que vocês possam encontrar ele perto do Despenhadeiro mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040119,
					"content": "Entendido, Katheryne, estaremos partindo agora mesmo então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040120,
					"content": "Ótimo, ad astra abyssosque! Hum, parece que o destino de vocês desta vez será realmente o \"Abismo\"! Boa sorte para vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040111,
					"content": "Talvez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "Olá, você é... Yuehui? Estamos aqui sob a ordem da Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040202,
					"content": "Oh, muito prazer! Fui eu quem solicitei mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040203,
					"content": "#Hum? Você me parece um pouco familiar. Você não é aquel{M#e}{F#a} grande aventureir{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040204,
					"content": "Minha história é complicada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "Ah, ok, tudo bem. Vou me apresentar primeiro, então. Eu sou um minerador, e consegui há pouco tempo a licença de extração do Despenhadeiro, e tenho alguns homens que estão trabalhando comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040207,
					"content": "Uau, você conseguiu a licença de extração do Despenhadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040208,
					"content": "Sim. Os superiores do Terraço de Yujing finalmente deixaram de ser cabeças-duras e sob a proteção dos Millelith, a extração na superfície foi agora finalmente permitida. A propósito, a gente foi um dos primeiros a conseguir a licença.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040209,
					"content": "Mas o que aconteceu ultimamente tem nos deixados preocupados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040210,
					"content": "O que aconteceu? Não ouvimos falar de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040211,
					"content": "Então... É meio difícil de dizer exatamente o quão grave é o problema. Pode ser considerado algo preocupante ou não. A questão principal é que é bem... Estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040212,
					"content": "É que um parceiro nosso viu alguns Hilichurls passando bem cansados e distraídos enquanto estava descansando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040213,
					"content": "E esses Hilichurls caminharam diretamente para o fundo do Despenhadeiro sem olharem por 1 segundo para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040214,
					"content": "Então o meu parceiro passou a prestar mais atenção nisso, e percebeu que tal anormalidade ocorria de tempos em tempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040215,
					"content": "Será que os Hilichurls também são curiosos e vieram só para dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040216,
					"content": "Não. O bizarro é que os Hilichurls que entraram no Despenhadeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040217,
					"content": "Nunca mais saíram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040218,
					"content": "Esses Hilichurls andavam apenas em uma direção, e depois de entrarem, nunca mais saíram do Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040219,
					"content": "E tal anormalidade tem ocorrido de forma cada vez mais frequente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040220,
					"content": "\"Quais são os objetivos dos Hilichurls?\", \"Como eles estão agora?\", \"Será que eles estão tramando algo?\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040221,
					"content": "Esses pensamentos não param de circular pela cabeça dos meus homens, e muitos deles estão ficando quase loucos de medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040222,
					"content": "Hum, a Paimon compreende. Isso é algo que dá arrepios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040223,
					"content": "Não quero nem imaginar como que deve estar agora lá dentro do Despenhadeiro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "Exatamente. O que mais nos assusta é pelo fato do acontecimento ser de origem desconhecida, creio que só sabendo a verdade por trás disso é que poderemos trabalhar tranquilamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040226,
					"content": "Nós... Nós vamos aceitar essa comissão mesmo? Hum, senhor, acho que precisamos pensar mais um pouquinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040227,
					"content": "Deixa com a gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "Ei! Você ignorou a opinião da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040229,
					"content": "Uma situação tão peculiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "#Bem pensado. Hum... Talvez... talvez você possa encontrar algumas pistas sobre {M#a sua irmã}{F#o seu irmão} desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040232,
					"content": "Você irá se arrepender se não formos, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040233,
					"content": "Então vocês vão aceitar esta comissão? Não quero que a minha licença que não foi nada fácil de obter vire desperdício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040234,
					"content": "#Sim, até porque estamos {M#curiosos}{F#curiosas} também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040235,
					"content": "Obrigado pela ajuda! Deixa eu mostrar para vocês em que direção os Hilichurls foram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040230,
					"content": "Creio que tem algo a ver com a \"Ordem do Abismo\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "Essa é realmente uma situação bem bizarra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "Bem, vamos voltar ao que interessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
