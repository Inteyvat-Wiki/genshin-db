			"dialogs": [
				{
					"id": 741860301,
					"content": "Dominus Cassiodor! Dominus Cassiodor... é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "É você! Assim como imaginei! Você finalmente voltou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860304,
					"content": "Fui ordenado a guardar essa fortaleza, mas os Dragartos cruéis e os ataques dos bárbaros foram demais para mim, então fui forçado a recuar passo a passo até que cheguei aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860305,
					"content": "Não sei quantos anos se passaram desde então... como anda a situação lá fora? Ganhamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "...É mesmo? Então perdemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860308,
					"content": "Desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Não diga essas coisas, Dominus Honorável. Eu já imaginava que esse dia poderia chegar quando eu me juntei às legiões de Vossa Majestade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860310,
					"content": "O Sebastos não disse que queria nos liderar para quebrar as algemas da \"Fortuna\"? Mas fazer isso é realmente tão fácil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860311,
					"content": "Afinal de contas, estamos lutando contra o próprio destino, e desafiar o destino é um feito além até mesmo dos grandes deuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860312,
					"content": "No final, todos os nossos esforços foram em vão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Não, senhor. Erguemos nossa espada contra os céus. Nossas crianças desafiaram as leis celestiais. Resistimos bravamente àquela profecia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860314,
					"content": "Mesmo assim, fracassamos... Alguém nos traiu, nos fazendo seguir o caminho errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860315,
					"content": "Mas, isso não importa mais. No final, estamos entalhados na história desse mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "O Golem Sem Nome"
				},
				{
					"id": 741860316,
					"content": "Ei! Por que você caiu desse jeito? Pessoas de pedra também podem apenas desmaiar do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Eu ainda não sei seu nome... Parece que a \"história\" dele chegou à sua conclusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "Isso é tão triste! Ele esteve aqui lutando contra os Dragartos alguma coisa por milhares de anos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Mas agora, ele finalmente está em paz. Vamos continuar adiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}