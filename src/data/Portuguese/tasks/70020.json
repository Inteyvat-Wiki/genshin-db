					"nextDialogs": [
						700200114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200115,
					"content": "Certo, a localização dele está marcada no mapa. Deixarei o resto com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
