						700200108,
						700200109
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200108,
					"content": "Parece que tudo está correndo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "Estou perguntando se ele precisa de ajuda. Pela sua aparência, parece que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700200112,
					"content": "Oh... O que ele quer dizer é que precisa que nós o ajudemos a derrotar um inimigo... Muito forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
