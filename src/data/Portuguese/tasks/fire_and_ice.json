			"dialogs": [
				{
					"id": 761830201,
					"content": "É importante encontrar tempo para relaxar de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "Serva"
				},
				{
					"id": 761830202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761830204,
					"content": "Muito bem. Nos vemos em Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Serva"
				},
				{
					"id": 761830203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
