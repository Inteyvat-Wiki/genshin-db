			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Crianças? Por que vocês vieram me procurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830202,
					"content": "Sobre as sementes de Erva Naku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Sementes, você diz? Hum... Você quer plantar essa semente no Bule de Relachá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830204,
					"content": "Isso não é impossível, afinal de contas, o Bule tem o tamanho de um mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830205,
					"content": "Entretanto, vocês hoje só vieram com esse pacote de sementes daqui. Vocês só planejam plantar ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830206,
					"content": "Sim, sim! Nós não sabemos como coletar sementes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Onde será que encontraríamos mais sementes depois de plantar esse pacote?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "Está tudo bem, não se preocupem. Na verdade, tenho aqui comigo uma caixa que usei há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830209,
					"content": "Antes, quando eu transplantava flores e plantas, utilizava essa caixa para as guardar. As plantas guardadas dentro dela eram conservadas por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830210,
					"content": "Além disso, depois de guardar minhas flores dentro dessa caixa, ela também podia produzir várias sementes... Dessa maneira, plantar era muito conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830211,
					"content": "Apesar dessa caixa hoje não ser muito útil, ela ainda é capaz de sementificar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830212,
					"content": "De qualquer maneira, eu já não tenho mais no que usar uma caixa como essa... Vocês podem ficar com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830213,
					"content": "Não importa que flor ou planta vocês queiram plantar, essa caixa com certeza será útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830214,
					"content": "#Obrigad{M#o}{F#a}, Madame Ping!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "#Obrigad{M#o}{F#a}, Madame Ping!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "#Haha, não precisam me agradecer. Peguem logo ela e tentem utilizá-la. Mas prestem atenção, pois cuidar de plantas não é uma tarefa simples, vocês precisam estar bem preparad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 721830217,
					"content": "Madame Ping é muito forte... Mas antes de testarmos essa caixa, vamos primeiro retornar para o Bule e plantar essas sementes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "Paimon realmente espera que essas sementes possam crescer até se tornarem grandes plantas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}