	"talks": [
		{
			"id": 7350101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350101",
							"2"
						],
						"stepId": 7350101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qasit",
					"Alia",
					"Mamdouh",
					"Fayez",
					"Ruhi",
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010101,
					"content": "Ah... Peguei o mesmo de novo. Quando é que eu vou conseguir aquele redondinho e fofinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010102
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010102,
					"content": "Não importa. Acho que vou ter que economizar minha mesada um pouco. Eu tenho que pegar todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010103
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010103,
					"content": "Hã...? Achei que você vinha aqui todos os dias! Você ainda não pegou todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010104
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010104,
					"content": "Você deveria tê-los comprado como um conjunto. Dessa forma, você teria conseguido os sete diferentes ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010105
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010105,
					"content": "Mas então não seria uma surpresa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010106
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010106,
					"content": "Surpresas são chatas! Eu quero ter todos os modelos que existem! Isso é o que você faz quando realmente ama alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010107
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010107,
					"content": "Finalmente economizei o suficiente para comprar o conjunto hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010108
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010108,
					"content": "Sinto muito, mas o que Qasit comprou foi nossa última unidade. Hoje estamos sem estoque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010128
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010128,
					"content": "Estamos trabalhando para expandir nossa equipe, então volte amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010109
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010109,
					"content": "Bem... Volto amanhã. Espere! As esculturas de Aranara não são meros estoques!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010110
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 735010110,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010111
					],
					"speakerTitle": "Qasit"
				},
				{
					"id": 735010111,
					"content": "Tudo bem, tudo bem. Peço desculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010112
					],
					"speakerTitle": "Mamdouh"
				},
				{
					"id": 735010112,
					"content": "Sinto muito. Nossas esculturas de Aranara estão esgotadas por hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010113
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010113,
					"content": "Elas esgotaram? Ah não... Eu ia comprar para meu primo que vem visitar amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010114
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010114,
					"content": "Ei, que tal isso? Você mora perto da casa de Razi, certo? Nós entregaremos as novas esculturas para você amanhã cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010115
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010115,
					"content": "Uau, obrigado Sr. Fayez. Não se esqueça, tá bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010116
					],
					"speakerTitle": "Ruhi"
				},
				{
					"id": 735010116,
					"content": "É uma promessa. A Construções Acara jamais desapontariam uma criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010117
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010117,
					"content": "Ah, mais clientes. Perdão, as nossas esculturas Aranara já esgo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010118
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010118,
					"content": "Ah, são vocês! Obrigado pela sua ajuda. Estávamos pensando em visitar vocês para expressar nossa gratidão, mas como podem ver... Estivemos bem ocupados com a loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010119
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010119,
					"content": "Se não fosse por vocês, o aniversário da loja poderia ter tido uma história bem diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010120,
						735010121
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010120,
					"content": "Parece que os negócios estão indo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010121,
					"content": "Parece que os Aranaras são bem populares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010122
					]
				},
				{
					"id": 735010122,
					"content": "Tudo graças a Razi. Para alguém tão jovem, ele tem uma criatividade incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010123
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010123,
					"content": "Ah, gostaríamos que vocês ficassem com o Protótipo Aranara, como sinal do nosso agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010124
					],
					"speakerTitle": "Fayez"
				},
				{
					"id": 735010124,
					"content": "Uau, espere... Isso parece meio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010125
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010125,
					"content": "Inacreditável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010126
					]
				},
				{
					"id": 735010126,
					"content": "Isso, isso! Inacreditável! Ele parece muito... misterioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010127
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010127,
					"content": "Hmm... Agradecemos a sua oferta, mas por favor nos dê um tempinho para decidirmos se queremos ele ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010129,
					"content": "Os problemas da Construções Acara foram resolvidos, vocês vão visitar Razi e Tanger.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7350102,
			"completionStepIds": [
				7350101
			],
			"beginWay": "TALK_BEGIN_NONE",
