					"Ruhi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735010201,
					"content": "O papai Aranara reconheceu os seus erros, e foi perdoado pelo seu filho Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010202
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010202,
					"content": "Hmm... Acho que as pessoas vão gostar de como a história se desenrola, mas a razão pela qual o pai admitiu seu erro foi muito simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010203
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010203,
					"content": "Talvez pudéssemos fazê-los passar por algum tipo de dificuldade juntos. Tenho certeza que eles se tornarão mais compreensivos dessa forma. O pai Aranara se sentirá culpado depois de ver seu filho trabalhando duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010204
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010204,
					"content": "Quando o pai Aranara começa a sentir remorso, ele deveria falar mais devagar ou mais rápido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010205
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010205,
					"content": "Isso depende do filho Aranara. Seria interessante ouvir eles falarem em ritmos diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010206
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010206,
					"content": "Ei, Tanger, Razi, e aí? O que estão fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010207,
					"content": "Papai e eu estamos discutindo nossa última história. Eu que contarei ela dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010208
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010208,
					"content": "Mas estou um pouco nervoso em contar uma história na frente de tantas pessoas. É por isso que estou pedindo conselhos ao papai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010209
					],
					"speakerTitle": "Razi"
				},
				{
					"id": 735010209,
					"content": "Ah! Sumeru vai ter um novo contador de histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010210,
					"content": "Se não fosse por você, Razi certamente teria me deixado para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010211
					],
					"speakerTitle": "Tanger"
				},
				{
					"id": 735010211,
					"content": "Paimon está feliz que deu tudo certo no final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010212,
					"content": "Mas... ainda há algumas coisas suspeitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010213,
					"content": "Hã? O que seria? Precisam de ajuda para investigar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010214
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010214,
					"content": "Por que alguém de Mondstadt deixaria um bilhete em um buraco no tronco de uma árvore nas profundezas da Floresta Avidya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735010215,
					"content": "E-eu pensei que tivéssemos mudado de assunto! Hum... foi apenas uma coincidência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010216
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010216,
					"content": "Muitas pessoas escrevem seus segredos e os escondem nos troncos de árvores. Não é nada de outro mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010217,
						735010218
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010217,
					"content": "A Collei parece meio nervosa de repente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				},
				{
					"id": 735010219,
					"content": "Hmm... Hã... Tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010220
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010220,
					"content": "Eu também tenho meus segredos e problemas. E... conto essas coisas para os troncos das árvores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010221
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010221,
					"content": "Mas ver Razi e Tanger me deu uma ideia:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010222
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010222,
					"content": "#{NICKNAME}, você poderia ser o meu tronco de árvore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735010223,
						735010224
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 735010223,
					"content": "Com muito prazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010224,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 735010218,
					"content": "É mesmo comum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735010219
					]
				}
			]
		},
