					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "Paimon só está encontrando restos minerais.... Parece que alguém levou o resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610502,
					"content": "Hã? Esse cara... É dos Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610503,
					"content": "Será que foram eles que levaram o que estava aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610504,
					"content": "Rápido! Vamos segui-ló! Paimon tem certeza de que o acampamento deles deve estar aqui por perto também e, seja lá o que for que estava escondido entre aquelas rochas, certamente estará lá também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610505,
					"content": "Sim, vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "#Mas temos que tomar cuidado para não sermos peg{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
