			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "#Ei, jovem {F#pescadora}{M#pescador}, estou feliz em te ver. Que foi? Aconteceu algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Não se preocupe, esqueceu que eu sou o seu guia de pesca? Caso algo tenha acontecido com você, você pode contar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "Faz sentido que a Kujirai ainda esteja obcecada em encontrar o \"Leviatã Lunar\" já que o seu desejo era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "Infelizmente, se ela soubesse a verdade sobre o \"Leviatã Lunar\" ficaria arrasada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "A verdade sobre o \"Leviatã Lunar\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "Sendo sincero com vocês, depois de voltar da viagem, comecei a investigar loucamente sobre o \"Leviatã Lunar\" até que finalmente encontrei uma pista em um livro velho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Com base nessas pistas, voltei para o local e descobri algumas revelações chocantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "Publiquei minhas descobertas em um livro, e ouvi dizer que as vendas estão indo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Aqui, tenho uma cópia do livro deixado pelo editor. Nele você encontrará a verdade sobre o \"Leviatã Lunar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "Paimon também quer ver! Deixe Paimon dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "\"Sobre Como o Leviatã Lunar é na Verdade uma Tartaruga Marinha Gigante\"... Que título longo... Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "Uma tartaruga marinha gigante? O \"Leviatã Lunar\" é uma tartaruga marinha gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "Isso mesmo, o \"Leviatã Lunar\" é uma tartaruga marinha gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "Naquela noite, o que vimos foi uma tartaruga marinha gigante com longas plantas bioluminescentes crescendo em suas costas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "Era uma tartaruga marinha grávida que procurava terra para desovar, e foi assim que encontramos o caminho de volta para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "Então volte e por favor leve as minhas palavras para Kujirai. A verdade pode ser dura, mas também pode ser a cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "Mas, talvez isso possa ser explicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "Pelo jeito, você provavelmente não acredita em mim, né? Mas minha pesquisa tem evidências para comprovar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "Nos velhos registros, o \"Leviatã Lunar\" é citado como uma velha criatura que viveu na época em que muitos animais marinhos ainda viviam na terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Seus ancestrais moravam na Espinha do Dragão e você pode encontrar até hoje fósseis deles lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "Eu mesmo encontrei uns, no <color=#00E1FFFF>Vale do Dragão Adormecido</color>. Caso não acredite em mim, você pode ir lá para dar uma conferida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
