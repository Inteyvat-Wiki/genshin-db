			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "Vocês finalmente voltaram! Hã? O Jiawei não veio com vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "Ele ficou na vila.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "Oh, então ele já se casou? Haha, se bem que não estou surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "Afinal de contas, formar uma família sempre foi o sonho dele... Tá desculpado então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "E o Nantuk? Vocês encontraram ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "Ele se tornou autor de um best-seller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "Uau? Então ele realmente se tornou um autor? Nada mal! E sobre o que ele tem escrito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "Paimon sabe! Paimon sabe! O nome do livro dele é \"Sobre Como o Leviatã Lunar é na Verdade uma Tartaruga Marinha Gigante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Hum, é um nome super grande, né! É uma Light Novel? Nada mal, acho que vou comprar uma cópia também... Pera aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "O Leviatã Lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "É uma tartaruga marinha gigante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "O que esse cara está falando? Como assim o Leviatã Lunar é uma tartaruga marinha gigante? Ele se esqueceu do que a gente viu com os nossos próprios olhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "A princípio a gente também não quis acreditar! Mas fomos à Montanha Nevada e pegamos um fóssil do Leviatã Lunar de volta. Olha, aqui está o fóssil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "Não... Não acredito. Me diga que isso não é verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "Talvez vocês não saibam, mas sou de uma família de pesca de longa data, e o meu pai também é conhecido por ser um excelente pescador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "Ele passou décadas no oceano indo atrás do \"Leviatã Lunar\", e uma vez, ele quase conseguiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Apesar do Leviatã Lunar ter escapado no final, meu pai nunca desistiu, já que capturar o lendário Leviatã Lunar é um dos maiores sonhos de qualquer pescador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "Mas depois da sua última partida, eu nunca mais o vi de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "Por isso, eu me recuso a acreditar em tal afirmação assim sem provas. E por favor, se vocês puderem me ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "Do que você precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Vou voltar agora para dar uma olhada nas coisas deixadas pelo meu pai. Como ele passou a vida toda em busca do Leviatã Lunar, ele deixou várias anotações e registros, na qual eu tenho certeza que encontraremos alguma informação útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "Enquanto isso você pode ir para o treinamento de pesca que preparei para você, voltarei com boas notícias e até lá precisarei da sua ajuda novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
