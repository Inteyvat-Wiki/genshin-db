				"points": []
			},
			"dialogs": [
				{
					"id": 726610701,
					"content": "Ei, vocês acham que a gente consegue vender essa pedra? Como estava escondida entre os minérios, acho que deve valer alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Qi Brega"
				},
				{
					"id": 726610702,
					"content": "Pelo amor, o que você quer dizer com pedra? Você nunca leu um livro na sua vida antes? Isso é chamado de fóssil. Um fóssil, sacou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Lin Fugidor"
				},
				{
					"id": 726610703,
					"content": "Não é nem questão de valer alguma coisa, com isso daí podemos comprar metade de Liyue! Procure ler mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Lin Fugidor"
				},
				{
					"id": 726610704,
					"content": "Sério? Isso vale tanto assim? Então, com o que temos no acampamento, não teríamos uma ascensão meteorológica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Bazi Trapalhão"
				},
				{
					"id": 726610705,
					"content": "Meteórica! Você realmente deveria ler mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Lin Fugidor"
				},
				{
					"id": 726610706,
					"content": "Ei! Você aí, entregue o fóssil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610707,
					"content": "Ei! Quem são vocês? Droga... Fomos avistados... Ataquem, irmãos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lin Fugidor"
				}
			]
