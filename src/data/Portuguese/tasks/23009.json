						230091403
					]
				},
				{
					"id": 230091403,
					"content": "Ah! É você, Viajante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "Tem algo errado com o meu Barro Misto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Foi a proporção da mistura? Ou a falta de testes experimentais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Muitos clientes que construíram suas cozinhas usando o Barro Misto relataram rachaduras após apenas alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Talvez a temperatura tenha aumentado tanto que algumas partes do barro simplesmente não aguentaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "Bem, vou consertar as rachaduras primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Teve muita gente pedindo conserto, não tive tempo de pegar o Barro Misto que foi raspado, então pedi que o guardassem em jarros. *Suspira*... Eles encheram vários jarros mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "Viajante, poderia me ajudar a recolher o Barro Misto desta casa? Eu vou recolher das outras casas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "Onde será que está o problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
