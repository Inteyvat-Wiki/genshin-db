			"dialogs": [
				{
					"id": 230090201,
					"content": "Eu ainda preciso de mais materiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "Como está o seu Barro Misto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Ótimo! Ou deveria dizer, a gama de usos para este barro está simplesmente além da minha imaginação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "Ele pode ser usado para fazer jarros, e ainda pode ser usado para consertar os buracos nas casas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Com um pequeno ajuste na proporção da mistura, posso até construir casas com esse barro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "No entanto... Estou ficando sem materiais devido a um aumento no número de pedidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "#E o ingrediente principal, Condensado de Slime, também acabou. Viajante, você estaria dispost{M#o}{F#a} a trazer mais três Condensados de Slime para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "Por favor, Viajante, me traga mais três Condensados de Slime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "E os outros materiais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Já encomendei os outros materiais por meios variados, ou já pedi para outras pessoas irem buscar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Só não esperava que o Condensado de Slime pudesse acabar tão rápido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
