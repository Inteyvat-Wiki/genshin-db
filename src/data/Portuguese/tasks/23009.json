					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "Certo, pronto. Por favor, Viajante, leve este barro para Nima por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "Ele está esperando por este barro por muito tempo, deve estar bem ansioso.",
