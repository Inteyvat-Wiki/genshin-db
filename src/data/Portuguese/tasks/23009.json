					"nextDialogs": [
						230091809
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091809,
					"content": "#Eu ainda não decidi... Mas assim que eu decidir, você vai ser {M#o}{F#a} primeir{M#o}{F#a} a saber!",
