			"dialogs": [
				{
					"id": 230091101,
					"content": "Viajante! Você veio bem na hora, eu estava mesmo precisando de alguém para me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "Algum avanço nas suas pesquisas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Na verdade, não dá para dizer que foram \"avanços\"... Apenas recebi um conselho de um dos clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Ele disse que gosta de cultivar flores e o que mais o incomoda é encontrar o solo certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "O solo precisa ser permeável e ter nutrientes adequados. Além disso, deve conseguir reter a água, mas não ficar encharcado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Ele viu que o meu Barro Misto teve tantas melhoras, que me pediu para criar uma \"Terra Mista\" especialmente para cultivo de flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Eu achei isso bem interessante, então estou procurando outros materiais para fazer melhorias adicionais ao meu Barro Misto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Desta vez, você poderia fazer o favor de trazer um pouco de barro fértil para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Vou marcar a localização deste barro para você no mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "Por que está tão longe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "Saí perguntando, claro. É um pouco longe, mas me disseram que o barro lá é muito fértil.",
