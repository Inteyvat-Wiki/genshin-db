					"nextDialogs": [
						230091806
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091806,
					"content": "Estou fazendo \"Barromens\", o \"Adri\" é o primeiro e o mais forte deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091807
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091807,
					"content": "Ele tem um ótimo temperamento, e é muito bondoso. Quando ele despertou como um \"Barromem\", a primeira coisa que ele fez foi pedir desculpas à grama esmagada sob o seu corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091808
					],
					"speakerTitle": "Nima"
