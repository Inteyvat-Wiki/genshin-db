					"speakerTitle": "Puca"
				},
				{
					"id": 740450604,
					"content": "Sobre gemas preciosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Há muitas pedras lindas e brilhantes nos veios de minério próximos, mas elas não são nem um pouco tão boas quanto gemas reais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "Se eu fosse melhor em encontrar gemas reais, talvez eu pudesse abrir minha própria oficina de gemas, exatamente como Sluasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450607,
					"content": "Para que você usa os minérios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "Hã? Eu nunca pensei nisso antes... Eu só coleto pedras porque são bonitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450609,
					"content": "Eu não tenho mais perguntas.",
