					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450602,
					"content": "Tem algo que gostariam de saber sobre o minério? Podem me perguntar o que quiserem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
