				]
			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "#Bem-vind{M#o}{F#a}s, bem-vind{M#o}{F#a}s. Nossa loja oferece a maior seleção de gemas preciosas em toda Corte de Fontaine. Também possuímos uma grande variedade de produtos artesanais em promoção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450402,
					"content": "Algo do seu interesse? Se você precisarem de outra coisa, eu adoraria ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450403,
					"content": "Encontramos um minério misterioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "É! Já que você possui uma coleção tão vasta, você deve saber o quanto ele vale, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450405,
					"content": "Oh? Então vocês vieram vender minério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450406,
					"content": "Estão falando com a pessoa certa! Oferecemos os melhores e mais justos preços em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450407,
					"content": "Deixe-me ver o que você tem aí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450408,
					"content": "Você mostra a Chesil o minério estranho que você encontrou mais cedo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "Uau... nem mesmo eu jamais vi algo parecido com isso antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450410,
					"content": "O brilho único e a textura suave... Ohh, esse é sem dúvida um minério raro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450411,
					"content": "Perdoe-me a pergunta, mas o que exatamente é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450412,
					"content": "Não faço ideia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "É por isso que você veio para uma avaliação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450419,
					"content": "É uma pena que vocês trouxeram apenas um pedaço desse minério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450420,
					"content": "Se apenas tivéssemos um fornecimento estável... Poderíamos forjar acessórios que arrebatariam Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450421,
					"content": "(Puca mencionou que essas pedras estavam em todo lugar perto dos veios de minério. Talvez devêssemos perguntar a ela...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450422,
					"content": "Na verdade, nós temos muito mais desse minério.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "Sério? Isso é maravilhoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450430,
					"content": "Enfim, além dos minérios que vocês trouxeram, estou disposto a comprar mais minério de vocês para fazer um lote de novos produtos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450431,
					"content": "Estou disposto a fazer um pagamento adiantado para mostrar minha sinceridade — contanto que me tragam mais minério da próxima vez que vierem visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450432,
					"content": "O que acham? Eu diria que é um acordo bem justo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450433,
					"content": "Hehe, Paimon também acha! Fechado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450434,
					"content": "Perfeito! Aqui está o seu pagamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450435,
					"content": "Me pergunto como os acessórios feitos deste minério vão ficar... Haha, não posso dizer que não estou ansioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450436,
					"content": "Estarei aqui, esperando boas notícias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450424,
					"content": "Mas a fonte é um segredo comercial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Oh, naturalmente, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450426,
					"content": "Mas contanto que vocês tenham um jeito confiável de conseguir a mercadoria, está tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450427,
					"content": "Você pode encontrá-lo em Elynas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "Ei! Por que você contou a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450429,
					"content": "Você conseguiu em Elynas? É, as pessoas normalmente não vão muito para lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450414,
					"content": "É... um Paimonlito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "Ei! Que tal parar com os nomes esquisitos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450416,
					"content": "É um Ouro Cristalino Deslumbrante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "Você acabou de inventar isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450418,
					"content": "Que nome impressionante! Não me admira parecer tão único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				}
			]
		},
