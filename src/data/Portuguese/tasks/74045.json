			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, voltamos! Encontramos seu amuleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Vocês entregam o amuleto a Puca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Ohhh isso, é esse mesmo! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Também encontramos outra coisa enquanto estávamos procurando pelo seu amuleto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "É um minério que nunca vimos antes. Achamos que poderia ser valioso e trouxemos de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Se Paimon se lembra bem, você costuma pegar pedras bonitas por aquela área, não é? Você já viu alguma pedra como essa antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Deixe-me ver... é realmente bonita! Mas não é nem um pouco preciosa... é apenas uma pedra comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "É verdade que você não encontrará nada assim em outros lugares, mas elas estão por toda parte perto dos veios de minério daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Ah, então é apenas uma pedra comum! Paimon achou que parecia super valiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Parece que não podemos usar para mais nada. Vamos apenas achar um lugar para nos livrarmos dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Mas se esse minério não existe em nenhum outro lugar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Oh, você quer dizer que talvez possamos fazer uma fortuna se a levarmos para fora e vendê-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Faz sentido! As pessoas normalmente não sairiam minerando em uma vila Melusine, o que significa que eles provavelmente nunca viram algo assim... bem pensado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Vamos lá, vamos levar essa pedra para a Corte de Fontaine e mostrar aos comerciantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Se existir mais algo que queiram saber sobre minérios, podem vir me procurar a qualquer momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Mas eu não tenho uma oficina de gemas como minha irmã e também não sei muito sobre avaliação ou processamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Ao invés de gemas preciosas, eu prefiro coletar todos os tipos de pedras únicas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Acho que dá para dizer que conheço muito bem os veios de minério locais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Hehe, pode deixar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Se só pode ser encontrado aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
