			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca, por que você está aqui de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Não deve haver mais nenhum monstro por perto, mas quem sabe que outros perigos podem existir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Enfim, você não deveria sair correndo sozinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Eu não saí correndo, Paimon e {NICKNAME}... eu só estou procurando pelo meu amuleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Hã? Você perdeu seu amuleto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Sim... deve estar em algum lugar onde normalmente pego pedras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Hmm, talvez você tenha perdido quando ficou presa por lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*Snif* Sim, você deve ter razão... eu estava assustada demais para ligar para qualquer coisa naquele momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "Ainda é meio assustador pensar nisso, mas meu amuleto é muito importante... preciso encontrá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Hmmm... Paimon acha que seria perigoso demais se a Puca fosse lá por conta própria. Nesse caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, por que não damos uma passadinha lá de novo e ajudamos a Puca a encontrar seu amuleto? Puca, nos espere em casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "Deixa com a gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Obrigada, {NICKNAME} e Paimon! Serei boazinha e esperarei por vocês em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "Eu já queria explorar aquele lugar de qualquer forma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
