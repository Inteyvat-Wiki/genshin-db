			"dialogs": [
				{
					"id": 726750801,
					"content": "Veja! A vista é bonita, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750802,
					"content": "Hmm, muito boa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750803
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750803,
					"content": "Muitas montanhas ali. Que lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750804
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750804,
					"content": "Hmm? Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750805,
						726750806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750805,
					"content": "É Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				},
				{
					"id": 726750807,
					"content": "Isso mesmo! Ali é a Montanha Yougou, e debaixo dela está a Floresta Chinju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750808,
					"content": "Muito longe. Ioroi do outro lado do mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750809
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750809,
					"content": "Isso mesmo. Mas nós acompanharemos você o caminho inteiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750810,
					"content": "Isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750811
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750811,
					"content": "Bem, para onde vamos em seguida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750812,
					"content": "Há algum lugar familiar que possamos encontrar comida gostosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750813,
						726750817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750813,
					"content": "Paimon, você só pensa em comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750814
					]
				},
				{
					"id": 726750814,
					"content": "Comida gostosa! Legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750815
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750815,
					"content": "#Veja, {NICKNAME}, Kichiboushi sabe das coisas. Experimentar as iguarias do mundo também é um tipo de treinamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750816,
					"content": "Kichiboushi vai superar você rapidamente se não tomar cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750818,
					"content": "Ufa, escalar esse mastro foi muito cansativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750819,
					"content": "Pelo Branco escalar? Mas pode voar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750820
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750820,
					"content": "Ei, isso são só detalhes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750821,
					"content": "Enfim, vamos parar por aqui hoje. Paimon tem que pensar para onde vamos a seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750822,
					"content": "Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750817,
					"content": "Já que estamos falando nisso, também estou com fome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750818
					]
				},
				{
					"id": 726750806,
					"content": "É de onde você é.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750807
					]
				}
			]
		}
	]
