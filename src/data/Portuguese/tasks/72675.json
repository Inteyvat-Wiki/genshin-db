					"content": "Incrível! Muita água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750403
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750403,
					"content": "E muito grande! Muito grande na água!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750404,
					"content": "Muito grande, deve ser pesado. Por que não afundar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750405
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750405,
					"content": "Porque o Alcor é um navio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750406,
					"content": "Mas, navio de barro afundar. Iorou contou. História de coelho, Bake-Danuki e navio de barro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750407,
					"content": "Hmm, bem, o Alcor não é feito de barro, é por isso que não afunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750408,
					"content": "Por que navios que não são de barro não afundar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750409,
					"content": "Hã, você está ficando mais fluente, Kichiboushi. Mas ao mesmo tempo, não sabemos como responder isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750410,
					"content": "#Sim! Hehe, {NICKNAME}, por que navios flutuam na água?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750411,
						726750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750411,
					"content": "Navios são feitos de madeira, e Dendro é incrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750412
					]
				},
				{
					"id": 726750412,
					"content": "Hã? Dendro pode fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750413,
					"content": "Hmm... Então por que Hilichurls com escudos de madeira não flutuam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750416,
					"content": "Hmm, não entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750417
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750417,
					"content": "Não se preocupe, Kichiboushi. Um dia, quando você crescer, será esperto como Paimon! Então você entenderá todas essas coisas: por que navios flutuam, por que neva na Espinha do Dragão... Você entenderá tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750418,
						726750420,
						726750421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750418,
					"content": "Eu não tenho tanta certeza se você sabe isso tudo também, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750419
					]
				},
				{
					"id": 726750419,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750422,
					"content": "Sim! De qualquer forma, podemos ver o Alcor daqui. Vamos tirar uma foto de Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750423,
					"content": "Foto! Desenho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750424
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750424,
					"content": "Sim, isso mesmo! Fique parado um pouco, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750420,
					"content": "Não tem problema se você não souber tudo ainda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750421,
					"content": "Você pode viver sem saber tudo isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750422
					]
				},
				{
					"id": 726750414,
					"content": "Navios podem flutuar desde que seu empuxo seja maior que a força da gravidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750415
					]
				},
				{
					"id": 726750415,
					"content": "Oh, é isso? Paimon entendeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
