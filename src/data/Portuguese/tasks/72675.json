				},
				{
					"id": 726750302,
					"content": "Não é dourada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750303
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750303,
					"content": "Hã? O Núcleo de Cristal não é dourado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750304,
						726750305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750304,
					"content": "Bem, vocês dois dizem isso, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				},
				{
					"id": 726750306,
					"content": "Pensando bem, Paimon nunca reparou nisso, mesmo você tendo pego muitas Borboletas de Cristal antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750307,
					"content": "... É isso que se chama \"desilusão\"? Aquele sentimento que você tem quando cresce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750308,
					"content": "Parece que você também precisa treinar, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750309
					]
				},
				{
					"id": 726750309,
					"content": "Pelo Branco, força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750310
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750310,
					"content": "Não venha com \"força\" para Paimon! Você é quem está treinando, Kichiboushi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750311,
					"content": "Ainda assim, é um pouco decepcionante. Por que os Núcleos de Cristal das Borboletas de Cristal Geo não são dourados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750312,
					"content": "Sim. Borboleta de Cristal é dourada. Por que não é dourado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750313,
						726750314
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750313,
					"content": "É possível que o organismo das Borboletas de Cristal seja assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750315,
					"content": "Oh, bem... De qualquer forma, vamos continuar como planejamos. É hora de levar Kichiboushi para ver o Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750314,
					"content": "Eu honestamente não sei a resposta para essa questão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750315
					]
				},
				{
					"id": 726750305,
					"content": "Não posso fazer nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750306
					]
				}
			]
		},
