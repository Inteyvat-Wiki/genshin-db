			"dialogs": [
				{
					"id": 726750601,
					"content": "Agora vamos levar Kichiboushi para a bordo do Alcor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750602,
					"content": "Não bom. Se navio afundar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750603
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750603,
					"content": "Esse navio não afundará.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750604
					]
				},
				{
					"id": 726750604,
					"content": "Esse navio nos levou até Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750605
					]
				},
				{
					"id": 726750605,
					"content": "Exatamente! E foi assim que nós conhecemos você e Ioroi. Não se preocupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750606,
					"content": "Hmm! Entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750607
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750607,
					"content": "E a Capitã Beidou é confiável, assim como sua tripulação. Esse navio é o lugar mais seguro quando você estiver em alto-mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750608,
					"content": "Hmm! Sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
