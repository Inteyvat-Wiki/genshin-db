			"dialogs": [
				{
					"id": 722641401,
					"content": "Hmm! Treinar divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641402,
					"content": "Se você está feliz, ótimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "#Pelo Lour{F#a}{M#o} muito forte — Caboom! Coisa redonda sumiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641404,
					"content": "Porque eu treino muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "#Hmm! Kichiboushi quer virar forte como Pelo Lour{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641406,
					"content": "Treinar, treinar, treinar. Forte, forte e forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641407,
					"content": "Kichiboushi, o que você quer fazer depois que ficar forte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "Me vingar de Gyoubu Koban, mmhahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641409,
					"content": "E fazer Ioroi não ser mais pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641410,
					"content": "Boa sorte. Deixe a trajetória do treinamento conosco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "Hmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 722641412,
					"content": "Vamos nos divertir. Até mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "Uhul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				}
			]
		},
