			"dialogs": [
				{
					"id": 726750101,
					"content": "Diferente de montanha com neve. Não frio. Sem neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750102,
					"content": "Isso daqui é a Floresta de Pedra Guyun! Lendas dizem que Rex Lapis derrotou aqui aquela... Hã... Serpente aquática cheia de cabeças... Qual era o nome dela mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750103,
					"content": "Osial, o Deus do Vórtice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "Oh, sim! Osial, Deus do Vórtice! Ele foi derrotado aqui pelas lanças de pedra de Rex Lapis, e também foi selado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750106,
					"content": "Uau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750107,
					"content": "Hehe, legal, não é? Mas nós também lutamos contra ele! Junto com Ningguang na Câmara de Jade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750108,
					"content": "Borboleta de Cristal dourada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750109,
					"content": "Espere, então era isso que você estava falando?! Escute quando alguém estiver contando uma história!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750110,
					"content": "Bem, ela realmente parece diferente das de Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "Ele nunca deve ter visto uma que não fosse roxa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#Bem, sim... Mas Kichiboushi não tem como pegá-la. {NICKNAME}, pegue-a para ele dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750113,
					"content": "Por que você não pega?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "Bem, você tem mais experiência nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750118,
					"content": "É possível, mas só se pode pegar seu Núcleo de Cristal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "Ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 726750115,
					"content": "Mas você pode voar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "Sim, mas você ainda assim tem mais experiência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726750117,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "Osial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
