			"dialogs": [
				{
					"id": 722070101,
					"content": "Não é suficiente, ainda não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "O tesouro que meu irmão me deixou está nas conchas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Conchas, conchas, espalhadas por toda parte... por toda parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "É o tesouro do meu irmão... Não posso partir ainda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "Tesouro...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Meu irmão foi para um lugar além da névoa. O sacerdote ficou furioso e disse que a alma do meu irmão nunca mais voltaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Mas meu irmão disse: \"Tem flores muito bonitas e um mar de pérolas... Papai também está lá, remando e acenando, e nossa irmãzinha está com ele\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Meu irmão deixou o tesouro e nunca mais voltou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Sobre seu irmão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
