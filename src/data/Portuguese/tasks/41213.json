			},
			"dialogs": [
				{
					"id": 412130501,
					"content": "Ouvi um barulho. No final de contas, eram vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130502,
					"content": "O que houve? Vocês lutaram com eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130503,
					"content": "Sr. Albedo... Não foi por querer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130504,
					"content": "Sucrose, você não estava organizando os arquivos? Como você veio para um lugar como esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130505,
					"content": "E ainda ficou aqui lutando contra esses inimigos bem perigosos na neve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130506,
					"content": "E-Eu também estava lutando, me desculpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "Bom, agora até Paimon está se sentindo culpada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130508,
					"content": "Hmm... Ah... Eu estava apenas... Me desculpe, desculpe... Eu estava apenas caminhando por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130509,
					"content": "*Suspiro* Eu imaginei. Tinha que ter aparecido algo do seu interesse aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130510,
					"content": "Eu contei a história da espada para Sucrose. Me desculpe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "Você contou para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130512,
					"content": "Eu falei apenas da origem e das propriedades da espada, não deixei que ela tocasse na espada! Paimon não é uma idiota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130513,
					"content": "Deixa para lá. Não poderíamos esconder isso dela por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130514,
					"content": "Sucrose tem uma curiosidade natural pelo conhecimento e segredos. Ela de fato é uma ótima alquimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130515,
					"content": "Ah... Uh... Eu prometo não causar mais problemas. Juro pelas sementes da Flor Doce de tamanho quádruplo que acabei de propagar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130516,
					"content": "Eu não temo os problemas, eu apenas estou preocupado com sua segurança. Tenha mais cuidado da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130517,
					"content": "Ah, o que houve com aquele Aventureiro agachado ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130518,
					"content": "Ele estava protegendo o Sr. Pallad durante a luta, eu penso que ele não esteja ferido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130519,
					"content": "Que frio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 412130520,
					"content": "Ele deve ter se resfriado durante a luta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130521,
					"content": "Ah, eu não pensei... Eu não vi, me desculpe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130522,
					"content": "Sr. Albedo, vou ver como ele está!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130523,
					"content": "Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130524,
					"content": "A Sucrose parece um pouco inflexível, mas ela é uma menina com bom coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130525,
					"content": "Você é mais nova que ela e está chamando ela de menina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "É verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130527,
					"content": "Sucrose... Ela sempre acaba chegando em lugares bem estranhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130528,
					"content": "Os jovens são assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "Verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130530,
					"content": "Sucrose não fez por querer. Não fique chateado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "Não se preocupe. Não estou chateado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130532,
					"content": "Ah? Parece que tem algo brilhando na espada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130533,
					"content": "Hmm? Parece haver uma mudança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130534,
					"content": "O poder da espada é muito mais forte que antes. O que houve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130535,
					"content": "Nós lutamos contra os Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "Entre os soldados dos Fatui há alguns personagens bem ferozes que nunca vimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130537,
					"content": "É uma força nunca antes vista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412130538,
					"content": "Por isso, a espada cresceu tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 4121306,
			"completionStepIds": [
				4121314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
