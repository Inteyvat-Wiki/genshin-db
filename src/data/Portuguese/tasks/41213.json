			"dialogs": [
				{
					"id": 412130301,
					"content": "Uh... Ah, uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 412130302,
					"content": "Sr. Pallad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130303,
					"content": "Você ainda não voltou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130304,
					"content": "Esse não é aquele Aventureiro imprudente de Mondstadt? Ele também veio explorar a Montanha Nevada com Cyrus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130305,
					"content": "Que frio! Atchim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 412130306,
					"content": "Depois de eu te salvar do poço de neve, você ficou sempre aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130307,
					"content": "Eu não queria, mas eu me perdi! Desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 412130308,
					"content": "Uh... Estou com muito frio, não consigo nem me mexer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "Pallad Imprudente"
				},
				{
					"id": 412130309,
					"content": "Ei, Sr. Pallad, você devia ter se preparado melhor para a viagem na Montanha Nevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130310,
					"content": "Vamos levar ele de volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "Pode ser? Ele está assim... Temo que precisemos segurar ele para caminhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130312,
					"content": "Mesmo que não possamos ajudar, não podemos deixar ele aqui, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130313,
					"content": "É verdade... Me desculpe, Viajante, e-eu peço desculpa em nome dele para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130314,
					"content": "Você ainda tem tempo para se preocupar com os outros? Se preocupe primeiro com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "Ah! São os Fatui de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130316,
					"content": "Penso que vocês já sabem o motivo da nossa vinda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130317,
					"content": "Nos entregue essa espada, caso contrário, ninguém sairá daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130318,
					"content": "Não, não entregue a espada para eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130319,
					"content": "Claro que não vou entregar a espada para eles!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "Quanta imponência! Vamos aproveitar esse momento e derrotar eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130322,
					"content": "Sr. Pallad, eu vou levar o senhor para um lugar mais seguro! Venha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130323,
					"content": "Quanta ingenuidade. Ninguém sai daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130324,
					"content": "Essa espada será um bonito presente para Sua Excelência, a Mensageira Signora",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vadim"
				},
				{
					"id": 412130320,
					"content": "Não pensem em roubar nada daqui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
