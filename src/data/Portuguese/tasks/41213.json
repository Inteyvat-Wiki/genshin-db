			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "Albedo! Estamos de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130102,
					"content": "Hã? Parece que ele não está aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130103,
					"content": "Ele está investigando algo? Ou talvez tenha ido fazer alguns desenhos misteriosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130104,
					"content": "Ah! É você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130105,
					"content": "Se não é a Sucrose! O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130106,
					"content": "Minha pesquisa acabou de chegar ao fim. Tenho cinco horas e vinte e seis minutos de lazer hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130107,
					"content": "Por isso, vim falar com você sobre assuntos discutidos anteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130108,
					"content": "Você conta o tempo com muita precisão! É um relógio humano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130109,
					"content": "N-N-Não, não precisa elogiar. Você é muito gentil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130110,
					"content": "Isso não foi um elogio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130111,
					"content": "P-Posso fazer uma pergunta, Viajante? Pedi que investigasse o segredo do Sr. Albedo. Você fez algum progresso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130112,
					"content": "Corrija-me se eu estiver errada, mas já se passou mais de uma semana desde que falamos sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130113,
					"content": "Achei que você tivesse esquecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "O quê!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130115,
					"content": "M-mais de uma semana? Eu claramente... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130116,
					"content": "Uh, ando tão envolvida em minha pesquisa. Esqueci completamente desse nosso assunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130117,
					"content": "Como seu senso de tempo pode ser tão bom e tão ruim ao mesmo tempo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130118,
					"content": "E-então! Conseguiu descobrir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130119,
					"content": "Pode-se dizer que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "Isso é ótimo. Poderia me contar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130122,
					"content": "O que você acha, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "Hmm.... Não faria mal contar para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130124,
					"content": "Ela pode dar uma olhada também. Só não pode tocar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130125,
					"content": "Espere. Do que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130126,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130127,
					"content": "Este é o segredo de Albedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "É uma espada superpoderosa. Não a toque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130130,
					"content": "Hmm... Isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130131,
					"content": "Ah! I-Isso é... Eu nunca vi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130132,
					"content": "Ho-ho, olhe o quanto quiser! Paimon não sabe o motivo, mas até ela sente uma estranha sensação de realização.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130133,
					"content": "Surpreendente! É a primeira vez que ouço falar de uma arma tão misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130134,
					"content": "Posso sentir vagamente o poder percorrendo a espada... Parece uma criatura viva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130135,
					"content": "É uma sensação única?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130136,
					"content": "Pode ser devido ao meu treinamento como alquimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130137,
					"content": "Não me atrevo a dizer nada com certeza, mas o \"fluxo\" de poder é muito perceptível. Embora essa descrição não seja a mais precisa... N— Normalmente, eu não definiria as coisas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130138,
					"content": "Por favor acredite em mim! Normalmente não uso esses termos ambíguos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130139,
					"content": "Ok, ok, nós entendemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130140,
					"content": "Viajante, conseguiria usar esta espada em uma batalha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130141,
					"content": "Gostaria de aprender mais sobre ela, mas não consigo usar por conta própria. Peço apenas sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130142,
					"content": "Vamos manter a discrição. Não podemos deixar Albedo saber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "Vamos procurar o lugar certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130143,
					"content": "Precisamos encontrar um lugar escondido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "Esta é a resposta que você procura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "Minha investigação foi bem-sucedida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121305",
							"2"
						],
						"stepId": 4121305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "Notável! Esta arma é como nenhuma outra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130202,
					"content": "Você também é fora do comum. Sua postura na luta e o ímpeto dos seus movimentos são perfeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130203,
					"content": "#Estou lisonjead{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "Esta espada é especial. Eu não queria me aprofundar muito na pesquisa, mas não conseguia tirar os olhos dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130205,
					"content": "Bem, Paimon acha que essa é uma de suas qualidades especiais, e não da espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130206,
					"content": "Espada de uma mão perigosa, tentadora e misteriosa... Hmm, deve ser isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130207,
					"content": "O Sr. Albedo deve confiar muito em você para deixar um item tão importante aos seus cuidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130208,
					"content": "#Estou tão surpres{F#a}{M#o} quanto você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "Hehe, você conquistou a confiança dele com suas habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130211,
					"content": "Concordo com Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130212,
					"content": "No entanto, a espada não havia absorvido muita energia antes de ser entregue a você... Como o Sr. Albedo reconheceu sua singularidade entre uma pilha de outros itens guardados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130213,
					"content": "Nunca julgue um livro pela capa. Por exemplo, o apetite de Paimon por Carne Frita com Cenoura e Mel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130214,
					"content": "Ah... O que me lembra que não comi muito hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130215,
					"content": "Procurei você logo após concluir meu experimento. Então, no caminho, encontrei um aventureiro preso na neve. Passei um bom tempo salvando ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130216,
					"content": "*ronco*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130217,
					"content": "O seu estômago acabou de roncar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "Ah... Ahhhh! N—Não, não é isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130219,
					"content": "Não tenha vergonha, fale abertamente de seu pensamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130220,
					"content": "Err, err...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130221,
					"content": "Então, eu vou falar primeiro: Tenho fome! Quero comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130222,
					"content": "Tenho fome!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "Tenho... Tenho fome, quero comer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130225,
					"content": "Uh, ainda me sinto com vergonha de falar isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130226,
					"content": "Não tem nada para ter vergonha! Se você admitir que tem fome, os alimentos serão ainda mais deliciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130227,
					"content": "Ah, é sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 412130228,
					"content": "Claro! Vamos, deve ter algum alimento no lugar de descanso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130229,
					"content": "Se possível seria maravilhoso comer um prato delicioso de Carne Frita com Cenoura e Mel aqui na neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412130223,
					"content": "Quero comer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "#Fico grat{F#a}{M#o} pela confiança que ele deposita em mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
