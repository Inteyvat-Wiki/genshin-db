			"dialogs": [
				{
					"id": 207000304,
					"content": "Tudo feito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Enrolando, igual aos Cavaleiros de Favonius. Eu te dei um minuto! Você esqueceu ou nem sequer ouviu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "Não prestou atenção alguma, ainda mais para algo tão simples... Então serão 1000 Mora. Faça o que quiser com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "1000 Mora? Tão pouco!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "O que você esperava por um trabalho feito desta forma? Esse é o pagamento que você merece - agora pegue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
