			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Que terrível má sorte. Esses Cavaleiros de Favonius são realmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Hunf! Esses Cavaleiros de Favonius não têm a menor noção de eficiência. Eles falaram que havia monstros à frente, e não me deixariam passar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Mas até hoje, eu ainda não recebi nada concreto deles. Que pessoal incompetente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Eu ainda tenho tantos assuntos a tratar. Eles têm alguma ideia de quanto dinheiro estão me custando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "#Bom! Parece que você é {M#um aventureiro}{F#uma aventureira}... Que tal me ajudar a fazer uma coisa, e eu te pago? O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Maravilha. Eu amo pessoas diretas. Você será bem recompensado quando estiver terminado. Eu te garanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Talvez meus olhos estejam me enganando, mas os Hilichurls em volta de Mondstadt parecem ter aumentado em número. Quem sabe o que esses tão chamados Cavaleiros ficam fazendo o dia todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "Já que você concordou em me ajudar, então você pode cuidar disso por mim. No entanto, você é apenas uma pessoa. Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Esqueça. Escolha uma dessas áreas para eliminá-los você mesmo: o pico, lado ou o pé da montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Só tem Hilichurls para onde você for, então não faz diferença. Agora vá, e não desperdice meu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "Quanto você está oferecendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Hah, isso dependerá de como você se sair. Se você se sair bem, você será bem recompensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
