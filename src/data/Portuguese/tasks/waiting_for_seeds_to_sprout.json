			"dialogs": [
				{
					"id": 750360201,
					"content": "#E aí, {REALNAME[ID(2)|SHOWHOST(true)]}? Você estava cavando por ali. Você desenterrou algo incrível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360202,
					"content": "Era algum tipo de tesouro valioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360203,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360204,
					"content": "Hmm, deixa Paimon ver... Isso se parece com algum tipo de semente... Hã? Não imaginei que a gente encontraria algo assim em um chão tão árido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360205,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360206,
					"content": "Dito isso, não parece tão valioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360207,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360208,
						750360209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360208,
					"content": "Sementes contém infinitas possibilidades...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				},
				{
					"id": 750360210,
					"content": "Mesmo assim, esse lugar deve ter sido abandonado há muito tempo, e o chão parece tão duro... Será que essa semente realmente continua viva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360211,
					"content": "Rawr...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360212,
					"content": "Você está chateado? ...Bem, às vezes é difícil de dizer — algumas sementes simplesmente não florescem naturalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360213,
					"content": "Mas poderíamos replantar e ver o que acontece. Talvez ainda só não tenha florescido. Talvez o buraco não foi bem cavado, ou não conseguiu nutrientes o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360214,
					"content": "Então talvez cresça se plantarmos direito! Hehe, o que deve florescer? Um Frutogrão gigante, talvez? Ou... Sabe, um Cacahuatl com um aroma super forte pode ser incrível também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360215,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360216
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360216,
					"content": "Ou talvez uma Flor Gigante saia dela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360217
					]
				},
				{
					"id": 750360217,
					"content": "Ei, qual é! Pare de ser estraga prazeres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360218,
					"content": "Dito isso, que tipo de nutrientes as plantas de Natlan precisam? ...Enfim, vamos plantar isso primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360209,
					"content": "Ela pode acabar crescendo em algo incrível!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360210
					]
				}
			]
		},
