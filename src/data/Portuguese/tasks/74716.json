					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Fantástico... Isso é praticamente todo o lixo grande recuperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160102,
					"content": "#Vocês se esforçaram muito, {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160103,
					"content": "Não se sinta obrigado a se desculpar, Freminet! Do jeito que a Paimon vê, a gente não esteve \"trabalhando\" — a gente esteve pescando coisas boas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Ajudamos a restaurar o meio ambiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Obrigado... Eu tive um tempo tão feliz e gratificante, e tudo isso graças a vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160107,
					"content": "De nada! Além disso, foi um trabalho em equipe! E a Paimon acha que você fez um progresso real, Freminet. Você ajudou muito, tanto debaixo d'água quanto em terra firme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Não precisa ficar vermelho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160111,
					"content": "Me desculpe, fora \"obrigado\", eu realmente não sei o que mais dizer em momentos como esses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160112,
					"content": "Talvez... Talvez eu ainda precise praticar um pouco mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160113,
					"content": "Sem pressa, vá no seu próprio ritmo. Continue praticando tranquilamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Se tivermos outra chance, vamos trabalhar juntos de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Certo, combinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160117,
					"content": "...Agora que a limpeza acabou, eu tinha planejado voltar para debaixo d'água e passar um tempo sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160118,
					"content": "Mas, depois de conversar com vocês... até o céu parece mais calmo. Eu só queria compartilhar esse sentimento com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160119,
					"content": "Enfim... é melhor eu voltar e me encontrar com Lyney e os outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160120,
					"content": "Vou deixar o resto dos dados da pesquisa submarina com você. Espero que encontre o que está procurando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160121,
					"content": "Ei, eu pude ouvir vocês celebrando do convés. Aconteceu algo de bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160122,
					"content": "Sim! Todo aquele lixo que estava incomodando os peixinhos foi removido. Também encontramos o resto das peças do piano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Mesmo? Deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160124,
					"content": "...Olha só, com essas peças, posso consertar o piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160125,
					"content": "Talvez não fique como era antes, mas deve conseguir tocar uma bela música.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160126,
					"content": "Você parece muito feliz, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "Mesmo? Não importa, vou consertar agora. Não deve tomar muito tempo. Enquanto isso, vocês podem arrumar um pouco esse lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160128,
					"content": "Um instrumento maravilhoso como esse merece um palco que faça jus a sua altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160129,
					"content": "Ela parece tão feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Uau! Que piano lindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "É muito elegante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hunf, mas é claro! Eu que o consertei! Também reforcei as conexões mecânicas, e dei uns retoques no exterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160134,
					"content": "Vocês também fizeram um bom trabalho. O palco está digno para esse piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160135,
					"content": "Hehe, não foi nada! Enfim, já chega de conversa fiada. Você não vai tocar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "Hã? Agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160137,
					"content": "E qual hora seria melhor? Por que consertar o piano se você não vai tocá-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Que tal deixarmos a apresentação para outro dia? Haverá bastante tempo para eu tocar para vocês depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160139,
					"content": "Esqueceu sua partitura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hunf... Que ultraje! Eu só queria sentar em silêncio um pouco e me lembrar do passado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160142,
					"content": "E não pense que essa provocação barata vai me convencer a tocar. Praticar primeiro, apresentar depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160140,
					"content": "Está com vergonha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "É magnífico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "E se precisar de ajuda, pode sempre contar conosco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "E encontramos um monte de tesouros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}