				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Uau, hoje está tão animado por aqui! Todos aqueles kuuhenki estão dançando ao redor da Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Ah, espera aí... Isso não parece dança. Mais parece que estão tentando... enterrá-la viva em uma pilha de fofura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "S-Socorro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500106,
					"content": "Me dê a sua mão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Ufa... Obrigada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500108,
					"content": "Por que os kuuhenki estavam agindo daquele jeito agora há pouco...? Eles não costumam ser tão energéticos assim, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500111,
					"content": "Decidi brincar com os pequeninos, e parece que eles ficaram bem envolvidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500112,
					"content": "Se amontoando em volta de você depois da brincadeira... É meio como filhotes, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Talvez esse seja o seu jeito de demonstrar gratidão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Mmm... Só que desta vez, a gratidão deles pareceu mais com ser pega de surpresa por uma nevasca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500115,
					"content": "Você diz isso, mas a Paimon aposta que você nunca perde a chance de mimá-los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "De qualquer forma, vocês gostariam de tentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500117,
					"content": "#Você quer dizer... ser cercad{M#o}{F#a} daquele jeito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Hm... Isso pode ser arranjado. Você só precisa dar a resposta certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500121,
					"content": "Ah, claro. Vai ser legal ver que tipo de jogo deixou os kuuhenki tão obcecados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Vão lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760500123,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
