			"dialogs": [
				{
					"id": 790290101,
					"content": "Tem uma estátua aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290102,
					"content": "*Suspiro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290103,
					"content": "Olá, porque você está suspirando à entrada dessa caverna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290112,
					"content": "Tenho vivido dentro dessa caverna recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290113,
					"content": "Não acredito que você vive numa caverna dessas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290114,
					"content": "Eu não tive escolha! Um monte de atores vieram para a ilha e começaram a fazer uma bagunça durante todo o dia e noite. Eu nem conseguia dormir por causa deles... Então encontrei um lugar mais tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290104,
					"content": "Mas, do nada, um bando de Hilichurls tomou conta do meu lugar de descanso e eu fui deixado lá fora ao frio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290105,
					"content": "Suspiro... Jurei a mim mesmo que se alguém pudesse me ajudar, eu lhes diria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290106,
					"content": "Diria o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290107,
					"content": "Diga à pessoa que me ajudou a encontrar a pista para o lendário tesouro secreto do pirata! Embora só conheça 25%...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290108,
					"content": "Um quarto da pista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790290109,
					"content": "Parece que vocês também são caçadores de tesouros secretos. Que tal ajudar-me com os Hilichurls lá dentro e eu lhes direi a localização da pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290110,
					"content": "Dizem que se você conseguir quatro pistas, você encontrará o tesouro deixado pelos piratas que o enterraram aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "Capitão dos Corvos Noturnos"
				},
				{
					"id": 790290111,
					"content": "Combinado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
