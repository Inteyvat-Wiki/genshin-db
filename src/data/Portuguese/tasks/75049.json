			"dialogs": [
				{
					"id": 750490401,
					"content": "Espera, oh... E pensar que você conseguiu achar essa entrada. Faz muito tempo desde que alguém veio aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Espírito da Noite"
				},
				{
					"id": 750490402,
					"content": "Isso... Hmm, sim, é aqui que as almas da noite vagam, embora eu tema que agora ninguém vivendo na terra beijada pelo sol consiga relembrar seus nomes ou atos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Espírito da Noite"
				},
				{
					"id": 750490403,
					"content": "Ah, as almas da noite... Enquanto nossa senhora dorme, somos seus sonhos. Quando nossa deusa despertar novamente, não seremos nada além de parcelas de sua mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Espírito da Noite"
				},
				{
					"id": 750490404,
					"content": "#Que uma pessoa viva pisasse aqui... Haha, aqueles tomados pelo anseio à batalha não podem mais se conter... guerreir{M#o}{F#a} forasteir{M#o}{F#a}... você que tão amad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Espírito da Noite"
				},
				{
					"id": 750490405,
					"content": "#Acalma essas almas inquietas para dormir com o ardor da batalha e do triunfo, e seja recompensad{M#o}{F#a}... O que diz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Espírito da Noite"
				}
			]
		},
