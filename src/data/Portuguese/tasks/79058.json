			"dialogs": [
				{
					"id": 790580101,
					"content": "Este é um cenário abandonado da peça teatral \"Voo Desesperado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790580102,
					"content": "Originalmente, a história falava sobre um Eidolon Hydro que ficou preso em uma caverna misteriosa com algumas ferramentas de escavação, elas estavam escondidas dentro de um livro, e ele escapou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790580103,
					"content": "Mas essa ideia foi recusada por Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790580104,
					"content": "Tem razão. Os Eidolons Hydro não precisam de ferramentas para sair de uma caverna. Nem seria possível explicar porque elas tinham que estar escondidas num livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790580105,
					"content": "Mas estou certo que essa ideia vai dar certo. Seria ótimo se eu pudesse apresentar ela para Idyia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790580106,
					"content": "Mas, a princípio, eu teria que pegar <color=#00E1FFFF>o livro de volta dos Hilichulrs</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790580107,
					"content": "— O diretor",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nota do estúdio"
				}
			]
		},
