			"dialogs": [
				{
					"id": 2005910001,
					"content": "O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Caro cliente, você tem bom gosto, meu amigo, você se concentrou no item mais valioso que temos na loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "Este é um troféu de batalha confiscado das mãos de um chefe Hilichurl há pouco tempo, por ninguém menos que este viajante aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Aquele Hilichurl assustador, não sabemos por quanto tempo ele tem ameaçado Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "E não pense que, apenas porque este viajante é um guerreiro experiente, na verdade foi uma batalha feroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "Ah, sério? Parece que este Hilichurl é terrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "...Talvez eu devesse pegar isso e mostrar ao Cyrus ou Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Talvez assim eles me veem com outros olhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "Oh! Fique descansado! Sabemos como se mantem em segredo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Não hesite, caro cliente, de certeza alguém vai pegar em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "Eu preciso pensar um pouco... Viajante, é verdade o que ela está dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
