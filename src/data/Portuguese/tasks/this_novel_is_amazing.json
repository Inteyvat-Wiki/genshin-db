						223020402
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020402,
					"content": "Se eu conseguir, então meu livro será vendido em todo o mundo... E então ela o lerá... Ela com certeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020403,
					"content": "... O que você ainda está fazendo aqui? Entregue o meu livro à <color=#00E1FFFF>Guilda de Comerciantes de Feiyun</color> agora!",
					"roleType": "TALK_ROLE_NPC",
