			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "Desta vez eu vou ganhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020102,
					"content": "Ganhar o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Não sei se você sabe, mas tem uma competição literária em Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020104,
					"content": "Eu acho que o nome é... \"Este romance é incrível!\" Mais importante, a competição é organizada pela famosa editora Yae, um gigante da indústria editorial de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020105,
					"content": "Para esta competição, já me preparei por muito tempo, mergulhando em alguns contos populares de Inazuma para ter uma ideia do que eles gostam por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020106,
					"content": "Claro, eu também tenho uma coleção de livros e já li todos em algum momento da minha vida. Então, para minha inscrição, escrevi um romance que integra o melhor da cultura Liyue e Inazuma. Tenho certeza de que ganharei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020107,
					"content": "Falei com a Guilda de Comerciantes de Feiyun. Eles me ajudaram a enviar meu romance para a competição, mas a pessoa que levou o livro nunca apareceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020108,
					"content": "Eu preciso de você para entregar o manuscrito para a <color=#00E1FFFF>Guilda de Comerciantes de Feiyun</color> para mim. Você teria tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020109,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Esse é o espírito, deste vez dará certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020111,
					"content": "O teu conto é sobre o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Desculpe, não posso dizer. É a minha obra para a competição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 223020113,
					"content": "Tudo vai melhorar se correr bem esta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
