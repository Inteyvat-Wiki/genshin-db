					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Talvez seja melhor nos apressarmos para entregar o livro para a <color=#00E1FFFF>Guilda de Comerciantes de Feiyun</color>.",
