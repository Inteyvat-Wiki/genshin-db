			"dialogs": [
				{
					"id": 223020201,
					"content": "Ali na frente parece que é a <color=#00E1FFFF>Guilda de Comerciantes de Feiyun</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Entregue o livro para aquela <color=#00E1FFFF>pessoa da entrada</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Mas a Paimon está muito curiosa sobre o conteúdo deste conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "O que você acha? Vamos dar uma espiada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
