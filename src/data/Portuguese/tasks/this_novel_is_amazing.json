			"dialogs": [
				{
					"id": 223020301,
					"content": "Onde está o mestre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Eu tenho um livro do Chang, o Nono...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Hã? Ele... Ele ainda escreve contos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Oh. Me lembrei! Ele disse que ia participar de uma competição literária em Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "O que ele escreveu desta vez então? Da última vez, ele escreveu um livro sobre os Qixing e continuou insistindo que o publicássemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Este livro ainda não foi publicado, mas eu já estava quase chamando Millelith para o caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "#Mas pelo menos desta vez esta competição terá lugar em Inazuma. Eles provavelmente não seriam capazes de rastreá-l{M#o}{F#a} de volta até mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Dê aqui. Vou levar um dos marinheiros para Inazuma levar com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Parece que a sorte não está do lado de Chang dessa vez. Ouvi falar de algumas pessoas sobre um livro muito popular em Inazuma chamado \"A Lenda da Espada\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "O autor também é de Liyue, mas não sei exatamente quem é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Obrigado por trazer o livro. Chang, o Nono, havia originalmente nos pedido para recolhê-lo, e até tinha pagado adiantado. Por favor, aceite isso como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
