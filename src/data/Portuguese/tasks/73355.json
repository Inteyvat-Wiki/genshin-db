			"dialogs": [
				{
					"id": 733550201,
					"content": "Hmm? Parece que não preciso deixar uma mensagem na Guilda de Aventureiros. O destino sempre nos reunirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Finalmente, nos encontramos novamente, Cometa Dourado, Parceira de Prata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "#Ver vocês radiantes e chei{F#as}{M#os} de energia me dá uma ótima sensação de que o tempo parou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "Há quanto tempo, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "Haniyyah, Cabeça de Bongô, são vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "Não foi à toa que Paimon achou que isso era familiar... isso quer dizer que o laço entre Paimon e Cabeça de Bongô ainda existe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 733550212,
					"content": "Imaginei muitos jeitos que poderíamos nos reencontrar. Um grande banquete, uma festa de boas-vindas criativa, ou algo que realmente surpreendesse vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "#Mas, no final, tudo parecia meio formal. Vocês estavam ocupad{F#as}{M#os}, e eu fiquei preocupada que poderia tomar muito de seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Além disso, nossos cogumigos gostam de ambientes calmos. Por isso, vamos nos reencontrar de um jeito relaxado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "Isso mesmo! A prosa de Haniyyah finalmente valeu a pena. Uma calma mental é ótimo para a vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "Jogar conversa fora é o melhor jeito de ir levando a vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Pyroalegria"
				},
				{
					"id": 733550218,
					"content": "Souka está aqui também, e Pyroalegria... e quem é esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Esse aqui é o meu cogumigo Dançarino da Brisa. Vocês e o Cabeça de Bongô nos derrotaram nas classificatórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Hehehe, você lembra bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Parece cada vez mais familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "Enfim, como vocês podem ver, não tivemos tempo de organizar o espaço para nosso próximo encontro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "Eu e Haniyyah compramos esse distrito comercial e o transformamos no Parque de Diversões dos Cogumigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Espera, então você tá dizendo que essas instalações daqui não são alugadas para o novo jogo de mesa, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Isso mesmo. De agora em diante, vamos viver no Porto Bada, e vamos promover o jogo de mesa dos cogumelos, bem como compartilhar nossa teoria de como se comunicar com animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "Fique à vontade para aparecer por aqui e brincar com os Cogumigos quando estiver livre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 733550229,
					"content": "Uhul! Cogumigos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "Isso é uma das melhores coisas que Paimon ouviu hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "Depois do primeiro Torneio de Cogumelos, Paimon pensou em tantas ideias para se divertir com o Cabeça de Bongô. Agora vamos poder realizar todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "É só uma pena que não trouxemos nenhum lanche para os Cogumigos... Seria tão legal se pudéssemos sentar na mesa com eles para comer um monte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "Não precisa se preocupar com isso. No meu estudo \"Sobre Comunidades de Cogumelos\", pesquisei até os fundamentos de que tipos de comidas os cogumelos gostam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Meu objetivo é identificar ingredientes que tanto humanos como cogumelos possam comer, assim nossos cogumigos não vão precisar passar o ano inteiro comendo só Geleia Maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "Um dia, descobrirei os ingredientes que satisfazem tanto os gostos humanos e de cogumelos, e farei pratos deliciosos que todos nós podemos aproveitar juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "E quanto se trata de colocar a teoria na prática, eu posso lidar com a comida sozinho. Só em caso de Haniyyah acabar destruindo nossa décima primeira panela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "Parece que o dia que sentaremos num círculo e comeremos com nossos cogumigos não está tão longe assim, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "Vamos esperar notícias suas, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "Nesse caso, lembrem-se de voltar e visitar o Parque de Diversões dos Cogumigos quando tiverem tempo! Nós e os cogumigos vamos estar sempre aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "E quem sabe, talvez a surpresa chegue mais cedo do que vocês imaginam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 733550240,
					"content": "Mal posso esperar pelo banquete de Souka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "Agora podemos nos ver sempre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "Essa atmosfera calorosa e de boas-vindas tá me relaxando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "Eu não me lembro bem, mas... olá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "São Haniyyah e Cabeça de Bongô! Nos conhecemos na Copa Nilotpala de Domadores de Feras! São nossos amigos de longa data!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550210,
					"content": "Depois disso, Paimon se lembra que nos encontramos de novo no Porto Ormos, e na Corte de Fontaine. Já faz tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Cabeça de Bongô"
				}
			]
		}
	]
}