			"dialogs": [
				{
					"id": 10280701,
					"content": "Agora a situação é terrível, e não há saída por enquanto. Devemos estar mentalmente preparados para ficar por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Felizmente, parece não haver escassez de suprimentos. Apesar de nossa equipe ser feita como uma colcha de retalhos, ela também tem pessoas que sabem ficar de cabeça fria nos momentos críticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Se cuidem. Podem deixar o resto comigo, eu vou pensar em algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
