				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Não imaginei que ficaríamos presos neste lugar. Estamos em um verdadeiro dilema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Mas, apesar de todo estudo que eu fiz em minha vida, eu apenas sei meter as pessoas na prisão... Não sei nada sobre como sair de uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Eu até mesmo fiz um contrato com meu pai para \"viver uma vida feliz\"... Não posso perder a esperança agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "Pelo lado positivo... Pude explorar um novo lugar, conhecer mais do mundo enquanto estava junto com alguns amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Hmm, sim... Isso é algo bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
