			"dialogs": [
				{
					"id": 728060501,
					"content": "Oh, você finalmente voltou! E então? Encontrou aqueles dois autores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "Entreguei as cartas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "Ótimo! Obrigada, Viajante. E os dois autores? O que eles disseram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "Eles disseram que dariam uma boa olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Bom, bom... É uma pena que esses dois autores estejam tão longe, em Liyue... Não é tão simples assim ir visitá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Especialmente o do senhor Zhenyu. O livro dele, A Lenda da Espada, sequer foi submetido por ele, mas por um comerciante viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Depois, um editor da nossa Editora Yae leu esse livro e reconheceu seu valor. Ele decidiu ir até Liyue conhecer o Prof. Zhenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Quem imaginaria que com essas mudanças em nossa situação, nenhuma de nossas cartas que pedimos para levarem à Liyue sequer retornou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Só nos restou publicar o livro primeiro e manter um registro dos direitos autorais devidos ao senhor Zhenyu. Quando tivéssemos contato com ele, os enviaríamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Mas já se passou muito tempo, e A Lenda da Espada continua sendo um sucesso comercial. Os direitos autorais já estão se acumulando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "*Suspiro* Como eu gostaria que o senhor Zhenyu pudesse participar dessa competição. Esses direitos autorais não podem ficar acumulando por muito mais tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
