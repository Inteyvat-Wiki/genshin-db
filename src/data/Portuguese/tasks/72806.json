			"dialogs": [
				{
					"id": 728060201,
					"content": "Hã? Viajante, por que você veio aqui hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 728060202,
					"content": "Sobre a carta e o presente da Editora Yae...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Uma carta da Editora Yae? Eles não estão pedindo para que eu mude meu pseudônimo de novo, estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 728060204,
					"content": "Eu já disse a eles que escreverei sob meu nome real...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 728060205,
					"content": "*Suspiro* Oh, esquece. Deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 728060206,
					"content": "Queriam que eu julgasse uma competição de Light Novels... Hmm, eu não acho que tenho o tempo, mas ainda assim acho que devo agradecê-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 728060207,
					"content": "Hã? O que é isso tudo no verso? ...Isso são sugestões criativas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 728060208,
					"content": "Eu... Eu darei uma boa olhada nelas. Obrigado, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
		{
