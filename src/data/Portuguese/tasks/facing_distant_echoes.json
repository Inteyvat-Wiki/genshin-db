			"dialogs": [
				{
					"id": 726550301,
					"content": "Hmm? Você precisa fazer alguns preparativos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550302,
					"content": "Sobre as ruínas",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "Bem, eu sou uma oficial técnica, portanto não estou muito familiarizada com a história do continente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550305,
					"content": "No entanto, acredito que estas ruínas estejam relacionadas ao grande desastre que ocorreu há quinhentos anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550306,
					"content": "Eu cresci ouvindo velhos marinheiros contarem essa história, sabe? Eles diziam que nem a terra nem o mar podiam escapar do alcance do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550307,
					"content": "Mas para mim, essas não eram diferentes das histórias de fantasmas que eles contam para assustar as crianças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550308,
					"content": "Afinal de contas, só o terror que você pode ver é verdadeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550303,
					"content": "Sobre o mecanismo misterioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
			]
		}
	]
