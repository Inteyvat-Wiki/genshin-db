			"dialogs": [
				{
					"id": 726550101,
					"content": "Bem, parece que finalmente localizamos nossos alvos! Ótimo! Acho que já posso voltar ao navio para dormir, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550102
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550102,
					"content": "O quêêê? Está deixando todo o resto para a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550103,
					"content": "Bem, ah... Quero dizer, já que estamos quase na linha de chegada, vamos agora mesmo e capturar as máquina de ruínas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550104
					],
					"speakerTitle": "Muzhen"
				},
				{
					"id": 726550104,
					"content": "Hum, a Paimon achou que você ia voltar para o navio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726550105,
					"content": "*Suspiro* Bem, não importa. Vamos segui-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7265502,
			"completionStepIds": [
				7265503
			],
