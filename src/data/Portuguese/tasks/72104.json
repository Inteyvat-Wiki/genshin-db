				{
					"id": 721043801,
					"content": "Senhorita Gendou, você parece estar de bom humor hoje.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043802
					]
				},
				{
					"id": 721043802,
					"content": "Hmm? O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043803
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043803,
					"content": "Você não parece consigo mesma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043804
					]
				},
				{
					"id": 721043804,
					"content": "Oh? Você acha? Vou lembrar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043805
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043805,
					"content": "Talvez eu só esteja de bom humor hoje... Quero dizer, eu acabei de tirar uma \"Sorte Grande\" e tudo! Só queria compartilhar ela com você, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043806
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043806,
					"content": "Mesmo assim, o que alguns chamam de \"Sorte Grande\" pode ser \"Grande Azar\" para outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043807
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043807,
					"content": "Para aqueles que receberam \"grande azar\"... Me pergunto o que será que os espera no Pendurador de Rolinhos da Sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043808
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721043808,
					"content": "Que sorte interessante! Até mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
