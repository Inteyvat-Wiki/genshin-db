			"dialogs": [
				{
					"id": 110240301,
					"content": "Vou ficar aqui por um tempo. Temo que momentos de reminiscência como este só possam diminuir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "Me sinto um pouco mal pela Deusa do Sal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Não medimos o certo e o errado durante os dias da Guerra dos Arcontes da mesma forma que medimos hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "É claro, como estou agora... Só gostaria que ela tivesse podido viver em um tempo mais gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Essas relíquias não farão com que o Osial fique mais forte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Embora o cálice e o medidor de sal tenham poder por direito próprio, eles não são nada diante do Osial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Se chegar um dia em que ele deva recuperar suas forças e voltar... Ha, eu acredito que mesmo assim, ele será derrotado mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "O que você vai fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Essa é uma boa pergunta. No passado, eu poderia ter lhe dado uma resposta mais específica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Mas agora... Sim, suponho que continuarei em meu papel de consultor na Funerária de Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Mas se esta viagem foi do seu agrado, por que você não vem junto para minha próxima \"recordação\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
