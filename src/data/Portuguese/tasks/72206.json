			"dialogs": [
				{
					"id": 722060401,
					"content": "Como está indo? Estou pronto e esperando para ter meus horizontes expandidos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060402,
					"content": "Esses são os cogumelos que você queria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
			"completionStepIds": [
				7220607
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220607",
							"2"
						],
						"stepId": 7220607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "Ooh! Haha... Uau, eles têm uma forma tão estranha! Será que eles também têm alma? Eles contêm as memórias das pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "E essas coisinhas macias que parecem asas... Eles conseguem voar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "Ah, eu e minha infinita curiosidade! O barqueiro está ficando irritado, creio eu. Sinto muito, mas acho que devo ir. Sim, eu devo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		}
	]
