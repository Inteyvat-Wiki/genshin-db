			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Ei! Eu ainda estou aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "Esses jovens de hoje em dia não possuem educação alguma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "D-desculpe!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Hnf! Assim é melhor. Quanto àqueles cogumelos, vamos chamar isso de um presente meu... Mas não toquem no resto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "Esses são os seus cogumelos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "Não é da sua conta! Pare de sair pegando eles a vontade e saia daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220602",
