					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "Tsumi, nós conseguimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510102,
					"content": "Vejo que vocês tiveram sucesso. As três torres foram lidadas com sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510103,
					"content": "A evacuação está indo muito mais rápido agora graças as condições ambientais melhores. Bem, a maioria dos soldados já foi embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510104,
					"content": "Mas parece que aconteceu algo que eu não previ. Por favor, sigam-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "A Escuridão apareceu dentro do Dainichi Mikoshi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510202,
					"content": "Seguindo a lógica, toda Enkanomiya deveria ter retornado ao normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510203,
					"content": "Infelizmente, esse lugar agora é o mais perigoso de todos. Não sei por que isso está acontecendo, ou o que deveria fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510204,
					"content": "Mas o que posso dizer é onde a pessoa responsável por tudo isso está. Tenho que lhe pedir para confrontá-lo e revelar todo seu plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510205,
					"content": "Como isso aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510206,
					"content": "Eu estive observando o fluxo da Escuridão e reparei em algo peculiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510207,
					"content": "Havia um vórtice fraco continuamente absorvendo a Escuridão. Penso que o fluxo deve ser desencadeado por sua necessidade de Energia Abissal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510208,
					"content": "Ele é extremamente perigoso. Até mesmo a maioria dos Dragartos não seriam capazes de lutar contra ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510209,
					"content": "Não se preocupe. Estive esperando uma chance para dar o que ele merece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "Música para meus ouvidos. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510212,
					"content": "Se eu deduzi corretamente, ele deve estar por volta da <color=#00E1FFFF>Biblioteca</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400510210,
					"content": "Não se preocupe, ele está desejando muito que lhe deem uma lição.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005103",
							"2"
						],
						"stepId": 4005103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"A coisa se intitulando \"Enjou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "#Oh, olá. Eu diria que isso é uma surpresa, mas, para falar a verdade, não é. Olhe para si mesm{F#a}{M#o}, se aventurando na Escuridão, esforçando-se para chegar até aqui e me encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510302,
					"content": "Você é a única pessoa que penso ser capaz de fazer isso. Entretanto, por que você se aliou a eles? Não esperava por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510303,
					"content": "Você só está tentando ganhar tempo com essa conversa fiada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510304,
					"content": "... Hmm, acho que você realmente não sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510305,
					"content": "#Olhe, eu entendo que me ver lhe deixou agitad{F#a}{M#o}, mas o fato de que você está tão ansios{F#a}{M#o} e dispost{F#a}{M#o} a vir até aqui é um problema para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510306,
					"content": "Por isso, vamos queimar esse excesso de energia com um exercício! Só para lhe acalmar e você me ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				}
			]
		},
		{
			"id": 4005105,
			"completionStepIds": [
				4005105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005105",
							"2"
						],
						"stepId": 4005105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"A coisa se intitulando \"Enjou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510501,
					"content": "Pare, pare! Minha vida está passando na frente de meus olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510502
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510502,
					"content": "Oh, eu ainda não acabei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510503
					]
				},
				{
					"id": 400510503,
					"content": "Essa mulher com as pupilas finas, como ela chama a si mesma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510504
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510504,
					"content": "Hã? Como você sabe sobre ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510505,
					"content": "Qual é o nome dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510506
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510506,
					"content": "Ela se chama Tsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510507,
					"content": "Hmph, aquela reptiliana parece estar fazendo um bom trabalho em imitar os humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510508
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510508,
					"content": "Reptiliana...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510509
					]
				},
				{
					"id": 400510509,
					"content": "Faz sentido, não é? Os Dragartos das Profundezas são uma espécie muito inteligente e de rápida evolução. Há lendas sobre isso há mais de mil anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510510
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510510,
					"content": "Sobre os Humanos-Dragartos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510511
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510511,
					"content": "Humanos-Dragartos? Parece com um apelido que Paimon daria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510512,
					"content": "Bem, isso vem de uma lenda antiga de Enkanomiya. Quando os Dragartos das Profundezas foram derrotados, começaram a evoluir para sobreviver. E para isso, imitaram quem os venceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510513
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510513,
					"content": "No final, isso resultou em uma linhagem de Dragartos indistinguíveis dos humanos, exceto por suas pupilas — os Humanos-Dragartos — a história diz que eles gradualmente se infiltraram em Enkanomiya e passaram a controlar muitas posições de alto escalão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510514
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510514,
					"content": "Isso lembra a você de alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510515
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510515,
					"content": "Nos realmente ouvimos dizer que as pupilas de Tsumi são verticais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510516,
					"content": "Sim, se a luz for suficiente, você pode ver que as pupilas dos reptilianos são linhas finas e verticais. Isso é evidência que ela lhe traiu ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510517
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510517,
					"content": "Mas ela está nos ajudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510518,
					"content": "Ela só está usando vocês para se vingar de mim. Bem, eu que os traí primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510519
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510519,
					"content": "Formei uma aliança com os Dragartos. Eu disse que envolveria toda Enkanomiya na Escuridão para que eles enviassem seus elites para dentro do Dainichi Mikoshi e resgatassem os seus que foram aprisionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510520
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510520,
					"content": "Em troca, eles permitiriam que a Ordem do Abismo passasse pelo seu território e me ajudariam a reconstruir as três torres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510521
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510521,
					"content": "Mas eles não sabiam que a Escuridão do Abismo era um veneno terrível para seres elementais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510522
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510522,
					"content": "Então os Dragartos pensaram que você os traiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510523,
					"content": "Eu os traí. Afinal de contas, se eu tivesse liberado o poder do Abismo neles, e eles continuassem andando como se nada houvesse acontecido, seria patético.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510524
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510524,
					"content": "Você é maldade pura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510525,
					"content": "Bem, é por isso que estamos aqui agora: quando ela tiver terminado com você, usará o poder do Dainichi Mikoshi para suprimir os Pólipos Sango e criar uma Escuridão que proteja os Dragartos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510526
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510526,
					"content": "Eles provavelmente estão mergulhando nas profundezas para resgatar seus companheiros enquanto conversamos. Não tomará muito tempo até que a fonte do Coral Sangrento seja cortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510527
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510527,
					"content": "Paimon tem pena dos Dragartos das Profundezas, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510528,
					"content": "Se vocês querem salvar a Ilha Watatsumi, precisam se apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510529
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510529,
					"content": "Vocês podem usar o mecanismo que deixei para trás para guiar a luz e dispersar a Escuridão no Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510530
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510530,
					"content": "Não acreditamos em uma palavra sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510531,
					"content": "#Urgh, sério, garot{F#as}{M#os}, vocês têm alguma outra escolha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510532
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510532,
					"content": "De qualquer forma, para mim, essa é mais uma jornada inútil para Enkanomiya. Mas isso não é nada, eu sou um secundário na Ordem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510533
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510533,
					"content": "Diferente daqueles que se entregam para servir a Sua Alteza, estou interessado em coisas mais inconsequentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510534
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510534,
					"content": "Oh, acho que já passei muito tempo por aqui, é melhor eu ir. Eu diria \"até mais\", mas não. Aqui está, é o meu presente de despedida. É algo que peguei no Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510535
					],
					"speakerTitle": "A coisa se intitulando \"Enjou\""
				},
				{
					"id": 400510535,
					"content": "Isso parece parte do mesmo conjunto que Kokomi nos deu... Espere, não é o momento disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510536,
					"content": "Argh, Paimon está furiosa! Ele fugiu de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400510537,
					"content": "Não podemos confiar naquele cara, mesmo que pareça que ele está fazendo sentido! Vamos voltar para Tsumi e perguntar a ela sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005111,
			"completionStepIds": [
				4005111
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005111",
							"2"
						],
						"stepId": 4005111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511101,
					"content": "Paimon está chocada. Funcionou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511102,
					"content": "Ele não mentiu para nós dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511103,
					"content": "Na verdade, ele nunca realmente mentiu para nós.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "Bem, com o jeito estranho que ele estava explicando, não era necessário! Por que Paimon está com a sensação que vocês alcançaram algum entendimento mútuo? Isso não é aceitável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511105,
					"content": "O Dainichi Mikoshi deve estar acessível de novo. Vamos descer e dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4005115,
			"completionStepIds": [
				4005115
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005115",
							"2"
						],
						"stepId": 4005115,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsumi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "É Tsumi! O que ela está fazendo na frente do Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511502,
					"content": "Já que você voltou, estou curiosa. Nossa operação de resgate foi bem-sucedida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511503,
					"content": "Alguns Dragartos pequenos foram resgatados antes de chegarmos lá. Mas os Dragartos velhos e fracos mergulharam na água para se esconder após termos derrotado os elites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511504,
					"content": "Tsumi... Você é realmente uma Dragarta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511505,
					"content": "Eu não tenho que explicar nada para você. Apesar de poder me comunicar, sei que interagir com humanos só acaba em traição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511506,
					"content": "O conflito entre nossas espécies é eterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511507,
					"content": "Antes de partir, eu destruirei essa luz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511508,
					"content": "Você acha que conseguirá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "Não se aproxime. E nem pense em me atacar de surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511510,
					"content": "Essa torre... Ela parece ouvir meus desejos. Eu só preciso pensar, e ela poderá mudar seu brilho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511511,
					"content": "Sendo assim, se eu desejar, ela colapsará perante mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511512,
					"content": "Basta eu ter a ideia de um estalar de dedos, posso destruir essa fonte de dor para os Dragartos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511513,
					"content": "Mas... Por quê... Não consigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511514,
					"content": "#Oh não, isso é mais sério do que perder o Coral Sangrento! O que faremos, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511515,
					"content": "Tsumi, você reconhece isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "Isso... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511518,
					"content": "Tsumi lembra de seu pingente. Ela combina com o outro fragmento.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "É um pingente na forma de... Três cobras enroladas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511520,
					"content": "Eu me lembro de sempre ter tido esse pingente. Por que ele combina com seus dois fragmentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511521,
					"content": "Acho que, no fundo, você sabe a resposta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "#Não seja ridícul{F#a}{M#o}... Você está tentando dizer que eu... Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511523,
					"content": "Paimon não entende... Esse daqui é de Kokomi, e esse é do Dainichi Mikoshi. E o seu, Tsumi, sempre esteve com você desde pequena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511524,
					"content": "Você é da Ilha Watatsumi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511526,
					"content": "Eu cresci com os Dragartos. Meus únicos pertences eram esse pingente e algumas caixas de livros. Eu aprendi a língua humana e a escrita humana com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511527,
					"content": "Mas, pouco depois disso, Enkanomiya ficou sem uma pessoa sequer. Estava completamente vazia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511528,
					"content": "Só recentemente finalmente tive a chance de entrar em contato com os humanos e aprender o que as coisas que li nos livros realmente significa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511529,
					"content": "Tsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511530,
					"content": "Há um ditado nos seus livros humanos que eu nunca entendi. Mas agora entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511531,
					"content": "\"Pessoas pertencem ao local que nascem, mas criaturas pertencem ao local que comem\". Eu sou uma Dragarta, não humana. Por isso, retornarei para onde pertenço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511532,
					"content": "O Dainichi Mikoshi não é minha preocupação. Mas nós retornaremos um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "Tsumi"
				},
				{
					"id": 400511534,
					"content": "Tsumi foi embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511535,
					"content": "Por que ela mudou de opinião do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511536,
					"content": "Talvez Kokomi saiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "Sim, isso mesmo. Kokomi com certeza terá pensado nessa possibilidade. Deve ser por isso que ela nos deu esse fragmento do pingente em primeiro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511538,
					"content": "Tudo está resolvido aqui. Vamos voltar e contar para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511516,
					"content": "Tsumi, isso é para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
