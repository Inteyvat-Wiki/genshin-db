			"dialogs": [
				{
					"id": 400511701,
					"content": "Oh não, Tsumi desapareceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511702,
					"content": "Nós viemos por esse caminho, não devemos ter deixado ela passar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511703,
					"content": "... Por que sempre acabamos assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511704
					]
				},
				{
					"id": 400511704,
					"content": "Oh, vamos, está tudo bem, não fique triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511705,
					"content": "Pelo lado bom, a maioria dos soldados já foram evacuados com sucesso. Se algum Dragarto passou por aqui, pelo menos ninguém se machucou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511706,
					"content": "Apesar que só pensar naquele cara deixa Paimon furiosa. Parece que não temos alternativa a não ser tentar o que ele disse. Vamos iluminar um pouco esse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
