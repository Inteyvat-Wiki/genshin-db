				"points": []
			},
			"dialogs": [
				{
					"id": 400511901,
					"content": "Depois de uma contagem detalhada, parece que os bebês Dragartos não estão mais aqui. Será que foram resgatados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511902,
					"content": "Se os Dragartos Primordiais realmente vieram aqui, isso significa que aquele cara estava dizendo a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511903,
					"content": "Então Tsumi realmente é uma Humana-Dragarta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511904,
					"content": "Mas nós não a vimos em canto algum. Onde raios ela está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400511905,
					"content": "*Suspiro* Não importa. Vamos voltar lá para cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
