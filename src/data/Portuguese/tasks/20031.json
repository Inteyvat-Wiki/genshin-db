			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "#Nos encontramos novamente, ávid{F#a}{M#o} Aventureir{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "Como vão as suas aventuras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Estão indo muito bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Esse é o espírito! Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "#Parece que você tem grande conhecimento agora. Está na hora de apresentá-l{F#a}{M#o} o trabalho formal da Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "A Guilda recebe solicitações de diversos lugares e designa as <color=#00E1FFFF>missões</color> de acordo com os aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Essas missões comissionadas são a principal forma de compensar nossos Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "Que tipo de missões são?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Há de tudo que é tipo. Desde ajudar os habitantes até eliminar monstros. Algumas são fáceis, outras são extremamente perigosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "Uma imagem vale mais do que mil palavras, é mais fácil entender fazendo você mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Aqui você poderá encontrar os detalhes das missões diárias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Quando você terminar, me avise por favor. Haverá uma recompensa generosa aguardando por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Excelente. Eu sabia que poderia contar com você, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Então, ficarei à espera de notícias suas, {NICKNAME}! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "O quão generoso estamos falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "A paciência é uma virtude! Você descobrirá em breve. Tenho certeza de que você não vai se desapontar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "Na verdade, é um pouco desgastante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "É sempre assim no início. Prepare-se adequadamente antes de uma aventura que as coisas ficarão mais fáceis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
