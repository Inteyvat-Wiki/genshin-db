					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#Bom trabalho, {NICKNAME}! Excelente desempenho, considerando que essa é a sua primeira vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "#O solicitante até me pediu para agradecê-l{F#a}{M#o} em seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "E como prometido, aqui está sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003103,
