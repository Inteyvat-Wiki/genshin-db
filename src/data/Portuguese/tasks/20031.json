				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "Haha, não precisava... Exceto que precisava sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310502,
					"content": "Aceite isto como um sinal de agradecimento da Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310503,
					"content": "Nós recebemos muitos pedidos todos os dias e sem os esforços de cada aventureiro, não há como atendermos todos os pedidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310504,
					"content": "Se você concluir missões suficientes diariamente, você poderá coletar uma recompensa especial de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310505,
					"content": "A sua Licença de Aventureiro mantém um registro de quantas missões você concluiu cada dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310506,
					"content": "Certifique-se de coletar seus bônus diários no dia que você conclui missões suficientes. Há uma quantidade limitada, então, se você perder, não poderá mais coletar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310507,
					"content": "Está certo, agradeço a explicação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "De nada, afinal de contas, você é um dos que estão me ajudando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310512,
					"content": "Tenha em mente que se você ajudar um Aventureiro companheiro, também ajudará na elegibilidade para um bônus diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310513,
					"content": "Nós encorajamos o trabalho em equipe com seus companheiros de aventura! Rumo às estrelas e ao abismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310509,
					"content": "Só um bônus por dia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "Por enquanto sim, desculpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310511,
					"content": "Por favor, assegure-se de que estamos constantemente de olho no Quartel-General para assegurar que nossos Aventureiros recebam suas compensações justas e adequadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
