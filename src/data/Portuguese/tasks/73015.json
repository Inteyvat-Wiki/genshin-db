			"dialogs": [
				{
					"id": 730150901,
					"content": "#Nara {NICKNAME}, essas são as Memórias de Pedra que os Aranaras deixaram para Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150902
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150902,
					"content": "Chegamos... Paimon estava muito nervosa, não queria ser descoberta pelos Cogumelos no caminho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150903,
						730150905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150903,
					"content": "É bom evitar lutar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150904
					]
				},
				{
					"id": 730150904,
					"content": "Paimon acha que sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Hmm... Então essa é a Memória de Pedra? Parece com aquelas placas de pedra dos Aranaras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150908,
					"content": "#Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Estou aqui para eliminar as sementes do mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Aranakula, não se preocupe. Pode deixar com Nara {NICKNAME}. Será mamão com açúcar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150905,
					"content": "Pense nisto como um armazenamento de comida de emergência na floresta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150906
					]
