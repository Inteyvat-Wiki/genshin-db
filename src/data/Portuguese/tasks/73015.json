				},
				{
					"id": 730151304,
					"content": "Hmm... aqui é seguro. Os Cogumelos não vão nos encontrar aqui. Aranakula, você pode esperar por nós aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
