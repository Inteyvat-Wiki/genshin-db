					"Aranakula",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Oh! Obrigado, Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Vana se lembra de tudo que aconteceu antes de Nara Varuna chegar. Árvores grandes lembram, sementes também, mas não sabem se Nara Varuna entende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "É por isso que deixamos memórias visíveis. Assim, quando Nara Varuna retornar, Nara Varuna saberá que Vana nunca esquece, que os Aranaras nunca esquecem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Oh, Paimon entendeu agora... As Memórias de Pedra são monumentos memoriais. Falando nisso, humanos também erguem monumentos para se lembrarem de algumas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Porque Nara são criaturas com memória ruim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "... Comparado as florestas, Nara são como plantas pequenas que não se tornarão árvores grandes, e não terão anéis em seus troncos para lembrar de tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Os Aranaras não deixarão Vana. Os Aranaras sempre estarão com Vana. Mas os Nara vêm e vão, assim como Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Existem muitos Aranaras, assim como Vana tem muitas grandes árvores, e muitos Aranaras têm muitos nomes, assim como as grandes árvores têm muitos galhos e folhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "#{M#A}{F#O} Nara {M#dourada}{F#dourado} lembra de muitos nomes de muitos Aranaras, lembra que eu sou Aranakula. É como pegar uma folha que caiu, mas sabendo de qual árvore grande veio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "#Para os Aranaras, Nara Varuna é {M#uma}{F#um} Nara especial! É por isso que fizeram um monumento dedicado à {M#ela}{F#ele}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Mesmo que não seja a mesma coisa, mas já vimos estátuas com faces específicas esculpidas antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "...Estátuas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Sim! Depois de escutar a história de Nara Varuna, {NICKNAME} não ficou com vontade de saber como {M#ela}{F#ele} se parece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Já que os Aranaras têm música, talvez sejam bons com outras coisas também! Talvez sejam capazes de esculpir estátuas de pedra realistas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Eu adoraria vê-las se você tiver alguma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "#Paimon sabe! Hehe, Nara Varuna, {M#uma}{F#um} Nara dourad{M#a}{F#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Ah! Agora podemos ir curar os galhos e folhas da Máquina Varuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Aranakula vai levar Nara {NICKNAME} e Paimon lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "A arte dos Aranaras é tão simples, é difícil de imaginar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#Hmmm.... talvez esse tipo de arte seja muito avançado para {M#o}{F#a} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
