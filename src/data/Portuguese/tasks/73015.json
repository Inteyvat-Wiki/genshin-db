				},
				{
					"id": 730151305,
					"content": "Arapandu disse que tudo o que precisamos fazer é que as três folhas das pedras virem na mesma direção dos galhos, é isso, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
