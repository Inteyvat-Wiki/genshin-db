			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, estamos de volta! Você vai ter que lidar com as coisas agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Graças a Paimon e graças a Nara {NICKNAME}, Aranakula sabe o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Oh! Parece que está tudo bem por aqui também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "Espero que a floresta volte ao normal em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Curar a Máquina Varuna com certeza é possível. Mas Marana... precisa ser eliminada, por Sarva, por Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Até parece que o \"Monumento\" construído para Nara Varuna está coberto de sementes do mal. Por causa da Marana, o \"Pavilhão Ashvattha\" também foi afetado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "Foi em um momento antes de Nara Varuna vir para Vanarana. Nara e os Aranaras fizeram um jardim juntos. Mas agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Apenas as crianças da Vila Vimara podem vê-los, e para os adultos, os Aranaras só existem em histórias... O jardim original uma vez se tornou um terreno baldio por causa de Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula queria encher o jardim com flores, e Nara esqueceu-se dos Aranaras, mas tudo bem, Nara irá ver flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Nara {NICKNAME}, Paimon, obrigado, Aranakula não se esquecerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Agora, Aranakula vai voltar ao Ponto de Descanso, e Arapandu ficará feliz por saber que o Monumento foi limpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Então, Nara {NICKNAME} e Paimon gostariam de voltar para o Ponto de Descanso com Aranakula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "#Me sinto tão seguro de viajar com {M#o}{F#a} Nara dourad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "Ainda tenho outras coisas para fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Que Aramuhukunda proteja Nara {NICKNAME} e Paimon. Tomem cuidado para não serem engolidos pelos bandidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
