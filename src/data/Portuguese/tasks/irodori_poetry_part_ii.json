			"dialogs": [
				{
					"id": 726920501,
					"content": "#Amig{M#o}{F#a}, já que você e Ootomo adoraram esta frase, então vamos usá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920502,
					"content": "Os poemas e fotos do Lenne se complementam perfeitamente. Honestamente, o poema só fica mais e mais emocionante conforme você lê e vê as imagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920503,
					"content": "Para ser sincero, eu também estou escrevendo um poema e talvez precisarei de sua ajuda amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920504,
					"content": "Você também precisa que eu tire algumas fotos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "Hehe, vamos falar disso em mais detalhes amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
