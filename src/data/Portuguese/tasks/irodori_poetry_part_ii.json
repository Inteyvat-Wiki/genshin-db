				"points": []
			},
			"dialogs": [
				{
					"id": 726920201,
					"content": "#Você tem algumas fotos, amig{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920202,
					"content": "Aqui estão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "Deixe-me ver... Oh, são incríveis! Acho que sei o que vou escrever agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920204,
					"content": "Eu escrevi mais alguns versos baseados nas fotos que você trouxe. Que tal você escolher o que usaremos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
