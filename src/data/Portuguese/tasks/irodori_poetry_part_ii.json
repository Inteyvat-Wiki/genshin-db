					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726920101,
					"content": "#{M#Senhor}{F#Senhorita}, você chegou bem na hora! Eu e Lenne estávamos trabalhando em um novo poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920102,
					"content": "Precisa da minha ajuda para conseguir inspiração novamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920103
					]
				},
				{
					"id": 726920103,
					"content": "Haha, isso mesmo. Seguindo as instruções do Ootomo, eu tenho escrito outro poema com o estilo de Inazuma, embora sendo bem honesto, eu ainda seja bem amador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920104,
					"content": "O tema deste poema é \"amizade\", e nós dois só conseguimos lamentar o fato de não termos nos conhecido antes. Em um dos versos, eu gostaria de descrever sobre animais vagando pelas paisagens na companhia um do outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920105
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920105,
					"content": "Já que é um poema de Inazuma, precisamos fazer referência a <color=#00E1FFFF>criaturas únicas desta terra</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920106
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726920106,
					"content": "Realmente vemos com frequência animais únicos de Inazuma — seja aqueles que andam ou voam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920107,
					"content": "#Mas já que todos eles estão pela natureza, vamos lá procurar por eles, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726920108,
					"content": "Serei eternamente grato! Por favor, tire <color=#00E1FFFF>4</color> fotos de diferentes animais de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
