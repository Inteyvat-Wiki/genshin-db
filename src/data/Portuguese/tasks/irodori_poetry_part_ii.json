			"dialogs": [
				{
					"id": 726920601,
					"content": "Ouvi dizer que voar livre feito o vento é o sonho das pessoas de Mondstadt. Honestamente, eu diria que esta frase combina muito bem com o Lenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920602
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726920602,
					"content": "É uma pena que eu não gostava de sair muito quando criança. Se eu tivesse uma companhia feito você naquela época, quem sabe eu até teria uma licença de planagem.",
					"roleType": "TALK_ROLE_NPC",
