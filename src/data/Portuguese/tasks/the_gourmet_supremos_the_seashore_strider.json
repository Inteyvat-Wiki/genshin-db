				"points": []
			},
			"dialogs": [
				{
					"id": 721690201,
					"content": "Ah, Viajante! Como está a coleta de caranguejos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "#Uhul! Esse caranguejo daqui parece ótimo. Você é muito {F#boa}{M#bom} com isso daqui, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Bem, já que temos nossos ingredientes, vamos começar imediatamente a cozinhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "Viajante, deixe-me me preparar um momento, espere um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216903,
