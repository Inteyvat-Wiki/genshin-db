			},
			"dialogs": [
				{
					"id": 721690301,
					"content": "Ovas assadas... Ovas assadas... Por que será que tem esse nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690302,
					"content": "Bem, creio que teremos que fazer primeiro e perguntar depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690303,
					"content": "Terminei! Aqui estão as Ovas de Caranguejo Assadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690304,
					"content": "Eu quero uma! Essa daqui está com cara ótima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690305,
					"content": "Me dê uma dessas menores daqui. Duvido ser capaz de comer uma que é muito grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690306,
					"content": "Essa porção daqui é para você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690307,
					"content": "Aqui, pegue essa cópia da receita também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690308,
					"content": "#Esse prato não deveria ser tão difícil de fazer, se quiser, pode tentar você mesm{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690311,
					"content": "Em seguida, nos prepararemos para ir para a <color=#00E1FFFF>Ilha Yashiori</color>, se você for para lá, procure por nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690309,
					"content": "Bem, agora é a hora de pegar a minha mordida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690310,
					"content": "Ei! Julie! Deixe um pouco para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
