			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Esse prato definitivamente tem um estilo de Julie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "Na verdade, a primeira vez que o vi, pensei que era de Mondstadt, mas na verdade é uma especialidade local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "Aposto que seu gosto é tão bom quanto seu nome, Xudong! Vamos, faça um pouco dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "Nos encontramos de novo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "Oh, Viajante, é você! Haha, lembra-se que falei que nos encontraríamos novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong pegou uma nova receita na cidade! Se chama Ovas de Caranguejo Assadas. Ótimo nome, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "E também não é difícil de fazer. Mas realmente precisa um bom número de caranguejos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "Preparei alguns caranguejos normais, e agora estou procurando por alguns... Especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Caranguejos especiais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "Isso mesmo. Na verdade, estamos procurando pelos que estão sob a Sakura do Trovão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "Você pode chamá-los de... Caranguejos Relampejados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Hahaha, enfim, só estou curioso. Me pergunto qual o gosto de caranguejos que vivem em ambientes como esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Entretanto, com todos aqueles relâmpagos ao redor daquela árvore, não me atrevo a me aproximar dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "Meu livro diz que é como antes. Basta você tocar um Galho da Sakura do Trovão para que um Electrogrão se prenda a você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "#E dessa forma, você não será atingid{F#a}{M#o} pelos raios da Sakura do Trovão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Mas, bem, você já viu a aparência da árvore. Não vou correr esse risco baseado em um sumário simples de uma solução como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Não funcionaria se nós corrêssemos rápido suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Você acha que consegue correr mais rápido do que um raio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Bem, então por que não utilizamos um galho para puxar esses caranguejos para fora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "Para mim, basta cavar algum buraco aqui próximo. Assim tiraremos tanto a água como os caranguejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Hahaha, todos possuem sua própria opinião. Isso é ótimo, muito bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "Viajante, se você não se importa, poderia pegar alguns caranguejos que vivem embaixo da Sakura do Trovão para nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Se você conseguir, farei uma deliciosa comida para você como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Ah, sim, espere um pouco... Pegue essas iscas daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Se você for capturar caranguejos lá, use isso para os atrair primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Salvaria algum tempo e esforço seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Caranguejos que vivem próximo a uma Sakura do Trovão... Qual será o seu gosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Estamos falando de comida deliciosa de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
