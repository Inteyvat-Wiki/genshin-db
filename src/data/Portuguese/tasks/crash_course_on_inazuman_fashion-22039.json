				"points": []
			},
			"dialogs": [
				{
					"id": 220390101,
					"content": "Isso não é jeito de continuar fazendo negócios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Ah, desculpe. Eu me perdi um pouco em meus próprios pensamentos. Quer comprar algumas roupas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "As sedas de alta qualidade de Liyue permanecem fora de estoque, mas ainda temos os quimonos mais recentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Você costumava importar materiais de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Sim. Antes, muitas vezes conseguíamos obter seda de alta qualidade de Liyue, como aquelas que a Guilda de Comerciantes de Feiyun faz a partir de Flores de Seda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Mas, com a situação atual aqui, não conseguimos importar esse tipo de seda há algum tempo. Temos que contar com nosso estoque existente para continuar as operações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Cada pedaço de seda que usamos aqui é um que não vamos receber de volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Originalmente, planejei criar alguns novos modelos de quimonos, ou usar algumas novas tinturas para fazer novos tecidos e atrair clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Mas não tenho sido capaz de inventar nada que possa ser considerado como \"novos\" corantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "Considerando suas muitas viagens, Viajante, tenho certeza de que você já viu muitas coisas. Você já encontrou alguma tintura que você possa considerar \"inovador\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Oh, encontrei algumas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "S-Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "Se você puder, por favor, ajude-me a ampliar meus horizontes. Encontre-me alguns materiais básicos a partir dos quais eu possa fazer novos tipos de tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Eu me encarregarei do pagamento. Mais uma vez, muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Você só precisa de tintas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Nessas circunstâncias, acho que é a única coisa que posso fazer no momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "Se você souber de algum material base que possa ser usado para fazer tinturas \"novas\", por favor, traga-o até mim. Eu providenciarei o pagamento necessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
