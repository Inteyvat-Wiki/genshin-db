					}
				]
			},
			"dialogs": [
				{
					"id": 750670301,
					"content": "Por que você ainda permanece aqui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670302,
					"content": "O líder da nossa equipe de aventura, o herói que usava uma máscara de falcão, já está... Nós não conseguimos mais resistir contra eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750670303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750670303,
					"content": "#Você deve partir o mais rápido possível. Este lugar é amaldiçoado, {M#bravo guerreiro}{F#brava guerreira}. Não é um lugar onde as pessoas devam ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
