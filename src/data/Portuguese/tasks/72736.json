			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grande Mestre Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Esplêndido, esplêndido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 727360102,
					"content": "Eu não esperava que a Gangue Arataki derrotasse tantos oponentes na Batalha de Besouros. Parece que vocês são experientes nessa arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 727360103,
					"content": "Retiro o que eu tinha dito. Vocês são oponentes respeitáveis e merecedores, e eu devo encarar vocês dessa forma — com toda a minha força!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 727360104,
					"content": "Muito bem, Joga-boi, você é nosso líder! É a sua vez de brilhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "E, uh, não leve o que Paimon disse mais cedo tão a sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "É sua vez, \"Verdadeiro Rei das Batalhas de Besouros\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Hahahahahaha! Oh, vamos lá! O confronto final, e a minha próxima vitória!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Não sei como você está liderando a sua equipe, mas os resultados falam por si próprios: A Gangue Arataki é a melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Grande Mestre Hanakado, se prepare para a batalha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "O Rei contra o Grande Mestre! Isso será lendário!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grande Mestre Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Entendo. Entendo... Vamos lutar mais uma vez. Dessa vez, verei através de todos os seus métodos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 727360202,
					"content": "Vitória ou derrota não parece mais tão importante... Vamos batalhar apenas por diversão, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 727360203,
					"content": "É raro eu encontrar um oponente tão incrível assim. Seria uma pena terminar nossa batalha tão cedo, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 727360204,
					"content": "Claro! Manda ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360205,
					"content": "Mas ver por detrás das minhas técnicas de Batalha de Besouros? Não mesmo, pode parar, isso não vai acontecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360206,
					"content": "Se você admitir que eu sou o lutador mais forte das Batalhas de Besouros, lutarei contigo quantas rodadas quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360207,
					"content": "Hã, parece que o Joga-boi e o Grande Mestre Hanakado ainda estão ansiosos... Bem, vamos deixar eles em paz! Eles podem ficar lutando com besouros até que a luta tenha acabado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}