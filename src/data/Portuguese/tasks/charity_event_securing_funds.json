					"nextDialogs": [
						705182602
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705182602,
					"content": "Você não terá que se preocupar com nada, apenas certifique-se de guardar o recibo.",
					"roleType": "TALK_ROLE_NPC",
