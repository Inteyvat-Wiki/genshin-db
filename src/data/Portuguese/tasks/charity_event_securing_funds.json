					"nextDialogs": [
						705182605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705182605,
					"content": "Vamos receber uma comissão ao fechar os pedidos dos clientes estrangeiros. Isso significa que talvez não valha a pena vender muitos ingredientes para os comerciantes de vinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
