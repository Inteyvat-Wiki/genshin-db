	"talks": [
		{
			"id": 7051801,
			"completionStepIds": [
				7051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051804",
							"2"
						],
						"stepId": 7051804,
						"stateName": "QUEST_STATE_UNFINISHED"
