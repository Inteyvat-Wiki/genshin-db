				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Bernhard"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180101,
					"content": "#Por favor, espere um momento, ilustre Cavaleir{F#a}{M#o} Honorável e {F#sua}{M#seu} companheira Paimon, \"a melhor guia de Teyvat\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180102
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180102,
					"content": "Por favor, eu imploro por sua ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180103
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180103,
					"content": "Uau! Paimon não imaginava que alguém a chamaria assim! Será que o nome da Paimon finalmente está ficando famoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180140,
					"content": "Espere, nós já não nos conhecemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180104,
					"content": "Nos encontramos antes no Quartel-General dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180105
					]
				},
				{
					"id": 705180105,
					"content": "Isso mesmo, eu sou o Bernhard, responsável pela Logística, e estou sob o comando da capitã Hertha dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180106
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180106,
					"content": "Normalmente, eu deveria ter etiqueta e cultivar uma relação amigável o suficiente para pedir-lhe um favor... Mas não tenho muito tempo, não tenho escolha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180107
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180107,
					"content": "Por favor, me ajude a salvar as vendas do evento beneficente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180108
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180108,
					"content": "Salvar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180109
					]
				},
				{
					"id": 705180109,
					"content": "Evento beneficente?... Oh, Paimon ouviu a Mestre Jean falar sobre isso. Você está com algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180110,
					"content": "É o seguinte: os Cavaleiros de Favonius planejaram operar uma loja durante o Festvinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180111
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180111,
					"content": "O dinheiro arrecadado com a loja será usado para caridade, especialmente para crianças e idosos em condições de vida difíceis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180112
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180112,
					"content": "A pessoa que administraria a loja foi decidida por um sorteio... E eu fui sorteado. Para que o evento beneficente seja um sucesso, eu pedi conselhos a muitas pessoas, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180113
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180113,
					"content": "Eu geralmente sou o responsável por realizar inventários e transporte. Eu pensei por muito tempo como vender numa loja, e até mesmo como trabalhar em uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180114
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180114,
					"content": "Por isso preciso da sua ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180115,
						705180116
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180115,
					"content": "Entendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				},
				{
					"id": 705180117,
					"content": "Sim, e você não precisa ser tão formal para falar com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180118,
					"content": "De acordo com o que você disse, o evento beneficente é para o bem das crianças e idosos. Isso significa que é algo muito importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180119,
					"content": "#{NICKNAME} é {F#a Cavaleira}{M#o Cavaleiro} Honorável e Paimon é uma velha companheira dos Cavaleiros de Favonius. Ficaríamos felizes em ajudar a compartilhar um pouco da responsabilidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180120,
						705180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180120,
					"content": "Ajudaremos da melhor maneira possível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180122,
					"content": "Oh, muito obrigado! Deixe eu ser direto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180123
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180123,
					"content": "Antes do evento começar, primeiro precisamos coletar <color=#00E1FFFF>Geleias de Vinho</color>. Elas são uma moeda básica necessária para gerir uma loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180124
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180124,
					"content": "Os fornecedores na região estão precisando de matéria-prima para fabricarem vinho. Vender essa matéria-prima para eles deve render muitas Geleias de Vinho para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180125
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180125,
					"content": "Além disso, alguns clientes estrangeiros querem comprar bebidas típicas do Festvinho em grandes quantidades. Eles estão à procura de um representante para ajudar nos pedidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180126
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180126,
					"content": "Para fins de cooperação de longo prazo, os valores que eles oferecem geralmente são muito generosos, e permitem mais espaço para negociação com os distribuidores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180127
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180127,
					"content": "A diferença entre os preços será nossa para gastarmos como quisermos. Ou podemos trocar por \"Geleia de Vinho\" de valor equivalente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180128
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180128,
					"content": "Nossa tarefa é fornecer os ingredientes para os fornecedores fazer pedidos de compra e negociar preços em nome dos clientes estrangeiros, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180129,
					"content": "Não é tão difícil quanto Paimon pensava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180130,
					"content": "#Somos ótim{F#as}{M#os} nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180131
					]
				},
				{
					"id": 705180131,
					"content": "Sério? Isso é fantástico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180132
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180132,
					"content": "Eu já tenho um pedido aqui — Sr. Shevirme de Sumeru quer comprar <color=#00E1FFFF>50 caixas de Frutas do Festival</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180133
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180133,
					"content": "Esse tipo de bebida pode ser comprado no <color=#00E1FFFF>estande Presentes dos Anjos</color>. O dono dele é <color=#00E1FFFF>Georg</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180134
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180134,
					"content": "O Sr. Georg é uma boa pessoa, mas também não é ingênuo, não pense que é possível tirar vantagem dele. Por favor, tome o tempo que precisar para avaliar sua oferta e fechar um negócio com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180135
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180135,
					"content": "Eu vou continuar montando a loja. Volte quando você tiver conseguido Geleias de Vinho suficientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180136
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180136,
					"content": "Vocês não precisam se preocupar com os suprimentos necessários para a loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180137
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180137,
					"content": "Já contatei os fornecedores. Eles enviarão os suprimentos assim que receberem os fundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180138
					],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180138,
					"content": "Muito bem, vamos dividir o trabalho! Nós vamos arrecadar os fundos, e você cuida da loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180139,
					"content": "Muito obrigado! Vocês me salvaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bernhard"
				},
				{
					"id": 705180121,
					"content": "O que precisamos fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180122
					]
				},
				{
					"id": 705180116,
					"content": "Bem, não é possível ser bom em tudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180117
					]
				}
			]
		},
		{
			"id": 7051802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051802",
							"2"
						],
						"stepId": 7051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Georg"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180201,
					"content": "Olá, Sr. Georg. Estamos representando o Sr. Shevirme. Ele nos pediu para encomendar 50 caixas de \"Frutas do Festival\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180202,
					"content": "Hã? Você disse Sr. Shevirme? Ele é um cliente antigo e geralmente pede a mesma quantidade toda vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180203
					],
					"speakerTitle": "Georg"
				},
				{
					"id": 705180203,
					"content": "Enfim, qual é a oferta de vocês neste ano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Georg"
				}
			]
		},
		{
			"id": 7051803,
			"completionStepIds": [
				7051803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051803",
							"2"
						],
						"stepId": 7051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705180301,
					"content": "#{NICKNAME} e Paimon, vocês estão aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180302,
					"content": "Oh! É a Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180303,
						705180304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180303,
					"content": "Olá, Barbara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				},
				{
					"id": 705180305,
					"content": "Oh! Feliz Festvinho para vocês também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180306,
					"content": "O Festvinho é um dos feriados mais populares de Mondstadt. Estou tão feliz de ver vocês aqui. Espero que estejam gostando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180307
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180307,
					"content": "Por falar nisso, eu ouvi do Sr. Georg que vocês estão coletando Geleia de Vinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180308
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180308,
					"content": "Estou curiosa, vocês estão ajudando a Loja Beneficente dos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180309
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180309,
					"content": "Sim! Afinal nós também somos parte dos Cavaleiros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180310,
					"content": "A loja ainda não está aberta. Nós temos que arrecadar mais fundos para abri-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180311,
					"content": "Não sabemos que tipo de problemas encontraremos para gerenciar uma loja, mas Paimon tem certeza que vamos encontrar uma maneira de cuidar deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180312,
					"content": "Haha, vocês são de muita confiança! Com a ajuda de vocês, eu tenho certeza que vamos alcançar um sucesso sem precedentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180313
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180313,
					"content": "#Obrigad{F#a}{M#o} pelo seu encorajamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180314
					]
				},
				{
					"id": 705180314,
					"content": "Eu também ajudei em pequenos eventos beneficentes que os Cavaleiros de Favonius organizaram antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180315
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180315,
					"content": "... Mas, tudo que eu fiz foi ficar na frente e cantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180316
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180316,
					"content": "Oh! Eu encontrei com aquele Bardo, Venti! Ele me convidou para colaborar com ele numa música!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180317
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180317,
					"content": "A performance dele foi elegante e cheia de classe. Eu estava com medo de atrapalhar o clima e só me atrevi a cantar de leve no início...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180318
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180318,
					"content": "Felizmente ele me guiou com a harmonia de uma melodia, e rapidamente encontramos nossa sinergia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180319
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180319,
					"content": "No final, a audiência adorou a música e comprou muitas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180320
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180320,
					"content": "Oh, então você já trabalhou junto com o Bardo Desafinado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180321,
					"content": "Hehe, eu gostaria de ter ouvido essa canção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180322
					]
				},
				{
					"id": 705180322,
					"content": "Sim, é uma pena que dessa vez tivemos um choque com nossos horários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180323
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180323,
					"content": "Durante o Festvinho, a Igreja Favonius está organizando um coro especial com belos cenários, o que significa que terei que participar do ensaio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180324,
						705180325
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180324,
					"content": "Faça o que você tem que fazer, não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180326,
					"content": "Sim, nós todos estamos fazendo coisas importantes. Paimon tem certeza que faremos um ótimo trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180327,
					"content": "Obrigada! Embora eu não possa ficar e cantar, gostaria de ajudar de alguma forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180328
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180328,
					"content": "Eu... Eu posso ajudar a promover a loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180329
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180329,
					"content": "Hmm... Será que eu devia fazer pôsteres grandes, ou panfletos para serem distribuídos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180330
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180330,
					"content": "Hmm, também é necessário pensar em um slogan para a promoção! Será que incluir uma assinatura seria algo mais personalizado...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180331
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180331,
					"content": "Hmm, ou seria melhor fazer uma divulgação boca a boca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180332
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180332,
					"content": "Uau, com a Barbara nos ajudando com a divulgação, a loja vai ganhar uma popularidade tremenda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180333,
						705180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180333,
					"content": "#Muito {F#obrigada}{M#obrigado} pela ajuda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180335,
					"content": "Oh, não é nada, é o mínimo que eu poderia fazer. Vocês estão me deixando com vergonha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180336
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180336,
					"content": "#Bem, vou pensar um pouco mais e perguntar a outras pessoas com mais experiência em publicidade! {NICKNAME}, Paimon, vejo vocês depois!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180337
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180337,
					"content": "Os Cavaleiros de Favonius e a igreja ficarão muito orgulhosos de vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180338
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 705180338,
					"content": "Sim! Daremos o nosso melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705180339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180339,
					"content": "#Paimon se sente mais motivada ainda! {NICKNAME}, vamos fazer um bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705180334,
					"content": "Qualquer ajuda será bem-vinda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180335
					]
				},
				{
					"id": 705180325,
					"content": "Nós cuidaremos da loja beneficente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180326
					]
				},
				{
					"id": 705180304,
					"content": "Feliz Festvinho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705180305
					]
				}
			]
		},
