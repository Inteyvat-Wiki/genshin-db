					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Fala sério! Sou tão vulgar ao ponto de te humilhar com simples Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Isso não seria um insulto para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "Aqui, fique com essa carta. Se você tiver algum problema ou precisar de ajuda em sua jornada futura à Sumeru, leve-a até a Casa de Purbiruni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "Não pouparemos esforços em te ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
