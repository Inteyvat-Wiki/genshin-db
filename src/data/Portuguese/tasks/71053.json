				{
					"id": 710501401,
					"content": "Vamos falar do assunto sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "Você realmente me ajudou muito estes últimos dias. Eu realmente não sei como poderei te recompensar por tudo isso.",
