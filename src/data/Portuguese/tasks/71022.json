				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "Desta vez aconteceu no Vale Tianqiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Ah, é {NICKNAME}. Muito prazer. Não esperava encontrar você hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "Uh, agora que falei... Você esteve recentemente na região do Vale Tianqiu e Monte Nantianmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "Recentemente a Guilda de Aventureiros recebeu relatos de terremotos na região do Monte Nantianmen e do Vale Tianqiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "No começo, eram apenas alguns tremores pequenos. Mas agora parecem estar cada vez piores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Recentemente, a Guilda recebeu outro relatório, após um terremoto especialmente forte, algumas montanhas e ruínas colapsaram e surgiu uma caverna enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "Os relatórios também descrevem alguns monstros desconhecidos que foram encontrados. De acordo com as descrições, podem ser os Dragartos e Dragartos Primordiais Geo do passado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "O que você precisa que eu faça?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Gostaria que você explorasse as cavernas do Vale Tianqiu. Veja o que está causando os tremores naquela região.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "E quanto a situação dos monstros, se eles realmente aparecerem em larga escala, não podemos deixar isso de lado. Teremos que pensar num plano rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Claro, isso é trabalho oficial da Guilda de Aventureiros. Depois de completar, você receberá recompensas correspondentes. O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Muito obrigado. Por favor, quando for explorar naquela direção, tome muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
