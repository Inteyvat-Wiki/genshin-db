			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Certo, deixe-me ver sua mão direita... Hmm, nada mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "Ainda assim, lembre-se de tomar cuidado, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "Sim, eu sei. Mestre, falando nisso, eu ainda não recebi a rota de patrulha de hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "A rota de patrulha de hoje é muito longa, você não virá. Além disso, há chance de encontrarmos... bem, você sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "Eu também tenho uma Visão! Por acaso sou inútil para todo mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "Ei, Collei, não fale assim. Isso não é algo que você precisa se preocupar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "Ah, vocês chegaram. Está se sentindo melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "Posso ajudar com algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Sim, já que vamos ficar por aqui, poderíamos ajudar um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "Hehe, parece que vocês não são do tipo de pessoa que gostam de ficar paradas. Nesse caso, talvez Collei possa levar vocês para uma patrulha ao sul da Vila Gandharva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "Se vocês estiverem se sentindo melhor, também podem limpar a Estátua dos Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "Tighnari, estamos prontos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "Entendido. Estou indo! Bem, vamos para a floresta. Deixarei o resto para Collei falar para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "Sim, pode deixar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Collei, o que vamos fazer hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Tighnari falou para limparmos a Estátua dos Sete, mas, uh... Isso não parece o trabalho de um Guarda-Florestal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Bem, os Guardas-Florestais são responsáveis por muitas tarefas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "Lidamos com coisas como inspeção das condições das estradas, manutenção das instalações nas florestas, garantir que os padrões de prevenção de incêndios estão sendo cumpridos, e também em ajudar viajantes e habitantes locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "Quanto ao mestre, bem, ele tem que lidar com áreas mais perigosas da floresta tropical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Hoje podemos realizar inspeções de rotina nas lanternas do caminho enquanto vamos para a Estátua dos Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "A Estátua dos Sete está no topo daquela rocha gigante. Vocês devem ter visto ela quando vieram por esse caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "É bem alto, não é? Não se preocupe, se acha que não tem força para chegar no topo, tenho certeza que o mestre não se importaria se não limpasse a estátua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "#Não se preocupe, sou {F#uma}{M#um} ótim{F#a}{M#o} escalad{F#ora}{M#or}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "Mesmo? Bem, estou contando com você então. Quando você estiver lá em cima, tome cuidado, não há muito espaço para pisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#{NICKNAME}, Paimon também flutuará junto com você, Paimon pode ajudar você a espanar partes altas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "Oh, Collei, falando nisso, você sabe algo sobre a Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Você está falando da Lorde Maior Rukkhadevata ou da Lorde Menor Kusanali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "Hã? Lorde Maior Rukkhadevata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "Oh, é o nome da antiga Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Sim. Lorde Maior Rukkhadevata foi a primeira Arconte Dendro de Sumeru. Ela criou as florestas tropicais, bem como a Muralha de Samiel ao redor do deserto. Seu trabalho permitiu que todos tivessem uma vida pacífica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "Para o povo de Sumeru, ela não é só um símbolo de sabedoria, mas de poder e bondade. Infelizmente, ela desapareceu na grande calamidade que aconteceu quinhentos anos atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(Igual a Raiden Makoto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "De acordo com o que o mestre me disse, os sábios depois descobriram a recém-nascida Arconte Dendro e a mandaram de volta para Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "Para celebrar a reencarnação de sua divindade, os sábios a chamaram de Lorde Menor Kusanali, e deixaram ela residir no Santuário de Surasthana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "E o que aconteceu depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Depois, uh... Eu não sei bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "Hã? Você não tem certeza? Mas você não é de Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Sim, eu sou de Sumeru, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "#Se isso é algo difícil de discutir com estranh{F#as}{M#os}, não se preocupe, nós entendemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "#Não, não é isso. Eu não tenho nada para esconder de vocês, e não considero vocês estranh{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Ahem... Vocês conhecem a Amber, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "Espere, Amber? Você está falando de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "Da Aventureira dos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Sim, ela mesmo! Eu vivi em Mondstadt por um tempo, e ela me ajudou bastante na época. Pode-se dizer que ela me ajudou a virar uma nova pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "Ninguém é incrível como ela! Ela vive a vida ao máximo, e sempre é fiel ao seu senso de justiça. Ela sempre está pronta para responder a qualquer chamado, mas também é muito compreensiva. Ela é como a faísca que acende o fogo no coração de todos ao seu redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "Para mim, ela é o melhor exemplo do que uma Cavaleira Aventureira deveria ser. Ela é a primeira pessoa que qualquer pessoa indo para Mondstadt conhecerá. Não há como evitar ser cativado por seu charme, e se apaixonar pelas terras de Mondstadt, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Uh, bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Hã, Paimon pensava que o trabalho dos Cavaleiros Aventureiros era diferente do que você havia descrito, mas algo está certo... Você gosta muito da Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "Ahem... Me desculpe, eu acabei me entusiasmando, deve ter soado um pouco estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Hehe, não se preocupe, Collei. Saber que você é uma amiga da Amber faz Paimon se sentir bem mais próxima de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "Mas, como você sabia que nós conhecemos Amber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "Bem, depois que eu voltei para Sumeru, eu e Amber mantivemos contato escrevendo cartas uma para a outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "#Numa carta, ela mencionou que Mondstadt foi atacada por um dragão feroz, mas a cidade foi salva por {F#uma}{M#um} Viajante loir{F#a}{M#o} e sua companheira voadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "#Eu sabia que vocês eram as pessoas que ela mencionou assim que {F#as}{M#os} vi. Mas, considerando por tudo que vocês haviam passado naquele dia, não seria apropriado falar disso no momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "Oh, então foi isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "Sim! Saibam que eu confio totalmente em vocês, de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "Eu gostaria de dizer mais sobre a Arconte Dendro para vocês, mas eu fiquei muito tempo longe de Sumeru, e não li livro nenhum... Me desculpem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "Não tem problema! Você já nos ajudou bastante. Nós nunca tínhamos ouvido falar da Lorde Maior Rukkhadevata ou do Santuário de Surasthana até você ter falado neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "Oh, fico feliz que pude ajudar. Mas, eu gostaria de perguntar algo... Por que vocês querem saber sobre a Arconte Dendro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "Você explica o propósito de sua viagem para Collei...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Entendo. Obrigada por me contarem isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "#Não tem de quê! Afinal, somos amig{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon tem razão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Hehe! Certo, de volta ao trabalho, temos que limpar uma estátua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "Oh, muito obrigada! Enquanto estiverem ali em cima limpando, eu vou em frente inspecionar o dossel da floresta. Nos vemos aqui em breve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "Eu nunca vi esse lado seu, Collei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "A campeã de voo de Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Será que se refere a Khaenri'ah?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Será mamão com açúcar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
