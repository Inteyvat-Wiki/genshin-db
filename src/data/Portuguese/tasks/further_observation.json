					"content": "Sim, voltamos. Você viu Collei por aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011103,
					"content": "Collei? Sim, eu vi ela ir para seu quarto agora há pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "Nasrin"
				},
				{
