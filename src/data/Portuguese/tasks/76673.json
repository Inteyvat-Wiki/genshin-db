				{
					"id": 766730903,
					"content": "Ah, não foi nada. Mas hmmm, como entregamos as fotos para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "Podem ficar com elas por enquanto. Estarei aí em alguns dias, e conversamos mais sobre as estátuas então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730905,
					"content": "Combinado. Até daqui a alguns dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667310,
			"completionStepIds": [],
