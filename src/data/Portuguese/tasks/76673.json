				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Agora só precisamos que a Nicole dê os toques finais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731133,
					"content": "Você removeu toda a pedra excedente, né? Deixe-me dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731134,
					"content": "Hehe, está pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731101,
					"content": "Uau! É o chalé da Bruxa! Quando foi que isso apareceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731102,
					"content": "Esse é o poder de uma Bruxa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "#\"Esse é o poder de uma Bruxa?\" {M#O}{F#A} jovem visitante falou, chei{M#o}{F#a} de admiração. \"Estou realmente impressionad{M#o}{F#a}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731104,
					"content": "#Aha! Finalmente, a história continua! Então, o que aconteceu com a Bruxa e s{M#eu}{F#ua} jovem visitante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731105,
					"content": "#El{M#e}{F#a}s viveram felizes para sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731106,
					"content": "...Fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731107,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731108,
					"content": "E o processo!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "#*Suspiro* Clientes exigentes, hein? Bem, se estão tão ansios{M#o}{F#a}s para ouvir, suponho que vou começar do início...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731111,
					"content": "#\"Agora, tudo o que meu coração deseja é transformar os seus desejos nos meus\", disse {M#o}{F#a} jovem. Essas palavras conquistaram a total atenção da grande Bruxa, Nicola Coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731112,
					"content": "#Mas, justo quando {M#os dois}{F#as duas} começaram a se aproximar, um grupo de convidados indesejados invadiu o local, capturou a Bruxa e fugiu com ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731113,
					"content": "#Enquanto {M#o}{F#a} jovem permanecia ali, em choque, surgiu uma nova Bruxa chamada Alynas. Ela firmou um contrato com {M#o}{F#a} jovem, concedendo a {M#ele}{F#ela} o poder da magia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731114,
					"content": "#Mas depois de superar um programa de treinamento exaustivo, {M#ele}{F#ela} acabaria descobrindo outra conspiração operando nas sombras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731115,
					"content": "Acontece que a grande Bruxa Nicola Coco era uma entidade alienígena. Sua verdadeira identidade era a primeira filha do Rei Miautres III do Planeta Miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731116,
					"content": "Ela havia vindo disfarçada de Bruxa como parte de um plano secreto para enganar o mundo inteiro e fazê-lo adorar o Planeta Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731117,
					"content": "#\"Ó grande Bruxa... você esteve mentindo para mim esse tempo todo?\" A voz d{M#o}{F#a} jovem tremia enquanto seu coração começava a se partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731118,
					"content": "\"Vá embora. A guerra está destinada a eclodir entre o nosso planeta e o seu. Éramos inimigos desde o começo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731119,
					"content": "A Bruxa virou o rosto, recusando-se a deixar que alguém visse as lágrimas que brotavam em seus olhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731120,
					"content": "#Mas {M#o}{F#a} jovem estendeu a mão com coragem e segurou seu braço, jurando jamais deixá-la. Comovida por tamanha paixão, a Bruxa decidiu se rebelar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731121,
					"content": "#Mas, naquele momento, Alynas, que antes havia ajudado {M#o}{F#a} jovem, agora tomou o lado do rei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731122,
					"content": "#Alynas sempre fora a segunda filha de Miautres III. Ela só havia ajudado {M#o}{F#a} jovem na esperança de incitar sua irmã à traição, garantindo assim a chance de usurpar o lugar de Nicola na linha de sucessão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731123,
					"content": "#Nicole prossegue com sua longa e confusa história. Depois de inúmeras reviravoltas estranhas, até mesmo {M#o}{F#a} protagonista já não é mais um ser humano...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "#Enfim, esse é o resumo. No final, {M#o}{F#a} jovem — que a essa altura já havia se transformado em um gato — uniu forças com a Bruxa para frustrar com sucesso o plano do rei. Depois, voltaram junt{M#o}{F#a}s para o chalé da Bruxa e viveram felizes para sempre em paz e tranquilidade. Fim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731125,
					"content": "*Soluça* Isso foi incrível... Essa história tem tudo! Amor verdadeiro... rebelião contra a injustiça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731126,
					"content": "Parece que começou como uma história e terminou como outra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "Não há o que fazer. Toda criação acaba escapando do controle de seu criador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731128,
					"content": "Nós, anjos, somos prova disso. Um dia, fomos incumbidas de guiar os seres humanos, mas como algumas de nós escolheram um caminho diferente, toda a nossa raça foi punida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731129,
					"content": "Se até mesmo os Princípios Celestiais não conseguem controlar totalmente suas próprias criações... Que chance eu tenho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731130,
					"content": "O destino sempre é inescrutável, mas... ainda assim espero poder guiar aqueles que encontro para um final feliz em sua história. Isso vale também para os personagens das minhas histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731131,
					"content": "De qualquer forma, a história acabou por ora, e estou ficando sem energia. Da próxima vez que eu tiver uma boa história para contar, compartilharei com vocês, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731135,
					"content": "Alynas fora a segunda filha de Miautres III o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731136,
					"content": "#Ela só havia ajudado {M#o}{F#a} jovem na esperança de incitar sua irmã à traição,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731137,
					"content": "garantindo assim a chance de usurpar o lugar de Nicola na linha de sucessão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731109,
					"content": "Você deixou de fora o meio inteiro da história!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
