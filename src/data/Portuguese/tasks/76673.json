						766730803
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730803,
					"content": "#\"Este é o lar secreto de Nicola Coco, a Grande Bruxa Eterna. Oh, desamparad{M#o}{F#a}, diga-me o maior desejo do seu coração e, sob a minha orientação, você o alcançará.\"",
					"roleType": "TALK_ROLE_NPC",
