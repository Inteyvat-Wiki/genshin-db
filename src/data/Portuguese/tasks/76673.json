			"dialogs": [
				{
					"id": 766730801,
					"content": "#Há muito, muito tempo, havia um{F#a} jovem que fugiu de casa. Depois de gastar a última da sua Mora, {M#ele}{F#ela} caminhou pelo frio do inverno, tremendo em suas roupas puídas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 766730802,
					"content": "#De repente, {M#o}{F#a} jovem se viu pisando no ar, e {M#ele}{F#ela} caiu em um lugar estranho. Mas antes que {M#ele}{F#ela} pudesse reagir, uma voz ecoou de algum ponto distante:",
					"roleType": "TALK_ROLE_NPC",
