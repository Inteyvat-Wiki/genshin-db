				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "\"Na luz da troca dos ciclos do dia, sobre a ponte vejo o farol iluminando suas costas voltando apressadas do trabalho.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 735020102,
					"content": "O-o que é isso...? Um enigma? Ou um provérbio ou algo assim...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020103,
					"content": "Na luz da troca dos ciclos do dia? Suas costas enquanto volta do trabalho...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020104,
					"content": "#Oh, você não é {F#a}{M#o} Viajante? Está interessad{F#a}{M#o} nos enigmas de Drusus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020105,
					"content": "Isso é mesmo um enigma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "Foi um pesquisador da Academia chamado Drusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020108,
					"content": "De acordo com o que eu sei... Ele era considerado um excêntrico até mesmo por aqueles na Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020109,
					"content": "Ele adorava discutir sobre todo tipo de enigmas com as pessoas, e de investigar todo tipo de método de criptografia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020110,
					"content": "Mas seus enigmas eram incompreensíveis demais, por isso quase ninguém gostava de conversar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020111,
					"content": "Por isso, ele propôs o conceito de \"Enigma com Recompensas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020112,
					"content": "Explicando de forma simples, quer dizer que o enigma indica um Local dos Tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020113,
					"content": "Basta utilizar o método certo, no tempo certo e no lugar certo, e você poderá obter o tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020114,
					"content": "Drusus deu uma dica: todos os Locais dos Tesouros se situam dentro da Cidade de Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020115,
					"content": "Como vocês podem ver, até agora nenhum aventureiro conseguiu desvendar esse enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020116,
					"content": "Se vocês tiverem interesse, podem tentar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020117,
					"content": "Mas na minha opinião, vale mais a pena vocês irem fazer alguma coisa séria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020106,
					"content": "Você sabe quem o criou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "Será que ninguém virá hoje também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020302,
					"content": "Este é \"o portão principal do Salão do Conhecimento\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "Isso mesmo! Este é o portão principal do Salão do Conhecimento. Você parece ter resolvido todos os meus enigmas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020304,
					"content": "Incrível! Eu pensava que hoje também ninguém conseguiria fazer isso! Na verdade, já é quase hora do meu almoço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020305,
					"content": "Por que você escreveu esses enigmas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "Porque é divertido, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020307,
					"content": "Que resposta rápida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020308,
					"content": "Além dessa razão, por que você acha que escrevi esses enigmas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020309,
					"content": "Você acha que eu gosto de dificultar as coisas para as pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020310,
					"content": "Quem sabe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "Hahaha, assim como outras pessoas da Academia de Sumeru, você me entendeu mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020313,
					"content": "Eu escrevi esses enigmas porque eu simplesmente amo a sensação de reflexão que vem ao desvendá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020314,
					"content": "Quando você olha para os meus enigmas, pode ver que sempre há uma palavra-chave para resolvê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020315,
					"content": "Se você usar essa palavra-chave como base e continuar pensando nela, poderá resolver o enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020316,
					"content": "Se eu simplesmente quisesse dificultar as coisas para os outros, apagaria todas as pistas e transformaria o enigma em um verdadeiro problema sem solução.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020317,
					"content": "Não vamos falar sobre isso agora. Já que você resolveu todos os meus enigmas, vocês podem pegar essas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020318,
					"content": "Esta é a recompensa que você ganhou com sua \"reflexão\", guarde-a bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020311,
					"content": "Eu não sei dizer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
