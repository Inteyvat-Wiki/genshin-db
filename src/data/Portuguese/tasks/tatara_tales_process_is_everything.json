			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Que bom! Deixe-me dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Estamos com sorte, ao que parece. A Fornalha Mikage é bastante estável, e as energias dentro dela ainda não estão saturadas em excesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "A este nível de concentração, meu dispositivo ainda resistirá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Será que precisamos purificar toda essa energia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Se este dispositivo pudesse fazer isso, eu teria pedido uma patente há muito tempo. Mas nosso bom amigo aqui só pode diminuir os níveis de energia em apenas algumas áreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Entretanto, a razão para a desativação da Fornalha Mikage e até mesmo a falha do seu programa de reinício automático é devido à alta saturação das energias do Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Desde que encontremos a área com a maior concentração e a purifiquemos, poderemos reiniciar o núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "Nesse ponto, a Fornalha Mikage deve reiniciar, e, além disso... Tais assuntos não serão nossos para nos preocuparmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Esse é o meu plano. Antes de colocarmos em prática, ainda preciso de mais algumas preparações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
