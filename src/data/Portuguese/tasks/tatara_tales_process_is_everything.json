			"dialogs": [
				{
					"id": 721180501,
					"content": "As recentes ações dos Fatui se tornaram cada vez mais estranhas. Todos eles estão se reunindo em torno do núcleo da fornalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "Esperemos que não estejam criando outra conspiração traiçoeira. Ou devo dizer, tentando fazer algo que não possamos mitigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
