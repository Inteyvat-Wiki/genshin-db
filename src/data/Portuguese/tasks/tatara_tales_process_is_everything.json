			"dialogs": [
				{
					"id": 721180301,
					"content": "Então, você já registrou todas as coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Xavier"
				},
				{
