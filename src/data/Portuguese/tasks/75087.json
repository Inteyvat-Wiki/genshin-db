			"dialogs": [
				{
					"id": 750870501,
					"content": "Já que vocês encontraram o caminho até aqui, acho que posso finalmente abandonar o papel de \"boa comerciante\". Preciso de um descanso de tratar com todos aqueles idiotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "Sua bandida! Como você pode acusar os outros de fazer as atrocidades que você cometeu? Você criou um mal-entendido gigante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "Não é natural para uma vilã cometer atrocidades? Além disso, o fato que aqueles três idiotas entenderam errado não prova que sou boa no que faço?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Haha, e agora vou cometer algo ainda pior! Vocês não vão fugir dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870505,
					"content": "Pegue eles, Bola de Pelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Quilla"
				},
				{
