				{
					"id": 750876301,
					"content": "Bem-vindo à Escola de Voo Pakpaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876302,
						750876303
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876302,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876304
					]
				},
				{
					"id": 750876304,
					"content": "Dou as orientações e a ajuda necessárias para os alunos. As coisas agora são bem diferentes de antigamente, antes não tínhamos esses serviços tão atenciosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876305
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876305,
					"content": "Mas uma vez, houve um problema porque o instrutor foi meio... severo nas palavras? E, por azar, o aluno também era alguém de temperamento explosivo... Ai, nem gosto de lembrar da confusão daquele dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876306
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876306,
					"content": "De qualquer forma, desde então a escola de voo mudou sua abordagem de ensino. Como dizem, ninguém resiste a um sorriso amigável, e quem não gosta de receber elogios, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876303,
					"content": "Vou nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876307
					]
				},
				{
					"id": 750876307,
					"content": "Tenha um ótimo dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
		}
