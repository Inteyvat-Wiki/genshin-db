					"nextDialogs": [
						750870507
					],
					"speakerTitle": "Bola de Pelo"
				},
				{
					"id": 750870507,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#Vamos lá, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}? Você vai mesmo enfrentar alguém muito maior que você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "Rawr! Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon parece meio desanimado. Ele só tá preocupado com Taruka ou ele comeu Bolachas Saurus demais...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} foi corajoso para nos proteger e encorajar ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "Há muitas coisas nesse mundo que apenas a coragem não consegue mudar. Comparado a algo ilusório como isso, controle absoluto é mais confiável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "Atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Uau! {REALNAME[ID(2)|SHOWHOST(true)]} esquivou mesmo daquele ataque com uma especialidade Tepetlissauro! Nem mesmo o governante dos céus pode fazer nada com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Ataque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, se prepare para atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "O ataque atingiu! Causou quase dano nenhum?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "Rawwr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Bem, atingir é impressionante. Paimon tá se sentindo cansada, isso foi só uma rodada? O que tá acontecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "É minha vez agora, não é? Atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} rapidamente assume uma posição defensiva para reduzir o ataque feroz do inimigo! Ele sobrevive ao ataque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Espera, você defendeu sozinho depois de atacar! Você quebrou as regras, seu desprezível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870537,
					"content": "Só nos baseamos em turnos aqui, não somos acorrentados por eles!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "O que faremos agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870539,
					"content": "...Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870540,
					"content": "Hã? Oberon parece tá se erguendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870541,
					"content": "Rawr! Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "Paimon não entende o que ele tá dizendo, parece que eles chegaram a um... entendimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870543,
					"content": "Usar um Ataque Coordenado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "Lá vamos nós! Hora de mostrar o que a Estrela de Amanhã da escola de voo pode fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870552,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#Oberon bloqueou a rota de fuga aérea do oponente e {REALNAME[ID(2)|SHOWHOST(true)]} está lançando um ataque! Um ataque coordenado brilhante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "Bola de Pelo sofreu muito dano! Será que machucou o pé dele? Tipo bater o mindinho contra a quina da mesa? Enfim, parece que o oponente tá atordoado e não consegue se mover!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "Atacar, mas eu que atacarei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#Você pode fazer isso, mas, qualé... {REALNAME[ID(2)|SHOWHOST(true)]} não tem muitas chances de mostrar as habilidades dele, pare de ser tão infantil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870566,
					"content": "Rawwr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#Oh? Parece que {REALNAME[ID(2)|SHOWHOST(true)]} e Oberon têm um plano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Bolachas Saurus? De onde essas Bolachas Saurus saíram?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "Rawr! Raawwrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Espera, você estava escondendo elas sobre suas asas? Que Sauriano esperto... Taruka deve ter tido dificuldades para lidar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870572,
					"content": "Agora não! Ei! Pare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870573,
					"content": "Hã? Bola de Pelo ignorou a ordem dela e correu na direção das Bolachas Saurus! A chance de recuperar 5 de Stamina é muito tentadora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "Mal sabe ele que é o Sauriano que vai acabar sendo comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#Em resumo, a batalha continuou assim, com cada parte trocando golpes.\\n{REALNAME[ID(2)|SHOWHOST(true)]} agiu corajosamente, já que tentava se provar. Embora ele não tenha sido nomeado um estudante excelente na escola de voo, ainda assim, podia usar suas habilidades para ajudar seus companheiros.\\nSurpreendentemente, até o ganho de peso inesperado de Oberon ajudou. Agora com um corpo maior que a maioria dos Qucussauros, ele fechou o campo de batalha aérea e deu um grande golpe contra Bola de Pelo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "Quilla foi inútil na luta, e por isso fugiu depois que Bola de Pelo perdeu a vontade de lutar.\\n\"Seu quebra-regras! Você não vai ganhar tão facilmente na próxima! Só espere!\"\\nDepois de dizer algo típico de vilões mesquinhos como ela, ela fugiu com o Bola de Pelo ferido.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "Oh! Paimon esqueceu de perguntar onde Taruka está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870579,
					"content": "Ei, vamos, não fique triste. Taruka é esperto. Ele vai ficar bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "Rawr! Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#Sim, é isso que você acha também, né, {REALNAME[ID(2)|SHOWHOST(true)]}? Vamos, Oberon, hora de você voltar pra escola de voo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Persuadir o oponente a se render.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "Se palavras pudessem resolver problemas, por que haveria tantos conflitos no mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "Ahem... Paimon tá só dizendo que isso tem poucas chances de funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Capturar com um item mágico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "Vamos fugir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#Qualé! Você agora tá botando até {REALNAME[ID(2)|SHOWHOST(true)]} pra baixo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Defender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Espera, são dois contra um aqui. Nosso oponente não vai poder atacar os dois oponentes de uma vez só, então isso não é desperdiçar uma rodada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Usar um item.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "Comeu Bolachas Saurus para restaurar 5 de Stamina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "... Não que fosse necessário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Fugir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "Qualé, as coisas tão indo tão bem. Por que você ainda tá pensando em fugir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Defender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "Roooah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} parece achar que defender muito vai causar oportunidades perdidas. Ele tá se preparando para atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Usar um item.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "Não podemos usar nada agora! Você não acha que já é tarde demais pra colocar uma armadilha de besta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "Roooah... Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#Oh! {REALNAME[ID(2)|SHOWHOST(true)]}, se prepare para atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Fugir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "Agora não é a hora de fugir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "Rroo? Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#Até {REALNAME[ID(2)|SHOWHOST(true)]} sabe disso. Ele tá se preparando pra atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
		},
