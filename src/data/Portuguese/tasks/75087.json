			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "Hã? Taruka! Você voltou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#{F#Srta.}{M#Sr.} {NICKNAME}! Estou tão feliz que você está bem... eu contei para minha irmã e todo mundo o que aconteceu. Lamizana é um idiota, como eu imaginei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Sim, mais estúpido do que você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#Certo, certo, acho que ele está irritado depois de ser sido separado de você por tanto tempo. Ele se deu muito bem com {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Ainda há espaço para melhorar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Bem, ainda estamos falando de um pequeno Sauriano! Se você cuidar dele bem, Taruka, Paimon tem certeza que ele vai virar um ótimo Qucussauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "Falando nisso, como você voltou para cá? Alguém te encontrou e te salvou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Eu fugi sozinho. Quis trazer Oberon comigo, mas ele tava muito ocupado comendo Bolachas Saurus e não queria se mover. Fiquei irritado, daí fui embora sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Hã? Fácil assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Depois de descobrir os padrões dos movimentos dos guardas Saurianos, percebi que havia uma abertura que eu podia usar para fugir. Foi bem fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Sabe, você parece ser o mais confiável aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Por que vocês demoraram tanto?! Eu estava prestes a resolver a situação com aquela mentirosa... e me desculpar oficialmente com vocês, claro... eu fiz decisões arbitrárias, e quase incriminei pessoas inocentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "Tarde demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Isso! Você só apareceu depois que tudo acabou. Se isso não é roubar o crédito, o que é então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Eu não tenho o que dizer, por isso vou pagar a compensação acordada, ou o que você quiser. Não vou ser mesquinho. Você pode até mesmo me dar um soco se quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Eu sou um homem de verdade, por isso não vou fugir das minhas responsabilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#Vamos fazer {REALNAME[ID(2)|SHOWHOST(true)]} te dar um soco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Ai! Ai! Eu não fui atingido, mas já dói! Por favor, misericórdia, não mova suas mãos... e pés!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Você não disse que era um homem que não ia fugir das suas responsabilidades? Você é um perdedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Esqueça, somos maiores que isso. Não acham, {NICKNAME} e {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Obrigado por me perdoarem. A escola de voo... ela não tem portas, mas suas portas figurativas sempre estarão abertas para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#Já que você e {REALNAME[ID(2)|SHOWHOST(true)]} são tão próximos, queria aproveitar para perguntar o segredo de se dar bem com Saurianos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hehe, sem problemas. Vamos voltar depois se tivermos uma chance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} vai dar um chute nos seus dedos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
