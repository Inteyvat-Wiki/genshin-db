				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "Como está indo a pintura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "Eu tenho pintado aqui ao lado dessas duas estátuas desde que seus olhos se iluminaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Mas... Como posso dizer isso? Sinto que não fui capaz de pintar aquele quadro perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "É só que parece que falta alguma coisa, sabe o que quero dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "É como um prato que usa bons ingredientes e é bem cozido mas... Mas algo simplesmente está faltando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Eu não sei como expressar este sentimento e também não consigo entendê-lo. Tudo o que posso fazer é continuar a pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Não se preocupe, você pode rir. Realmente, me sinto tonta de tanto pintar. Eu deveria fazer uma pequena pausa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Não sei por que, mas quando fecho os meus olhos, vejo os olhos daquelas estátuas brilharem na minha frente. Como se elas fossem vivas, e olhassem diretamente para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "É por isso que voltei aqui para fazer uma pausa. Não devo conseguir ver os olhos das estátuas daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Ah, sim. Por que você não aceita este quadro? É o melhor que já fiz até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Agora, se você não se importa, estou muito cansada. Preciso de uma pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Ainda assim, o que está faltando em minhas pinturas... O que está faltando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}