					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "Uaaau! A Salvadora dos Gatos e Paimon, a Sussurradora de Gatos! Mal posso acreditar que vocês vieram mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Hã? Como é que você nos chamou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Isso me soa familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Hmm... Será que já nos vimos antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Haha! Não acredito que a Sussurradora de Gatos ainda se lembra de mim! Manda ver, Valerina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Vamos deixar o papo em dia pra depois — que tal experimentar meu novo jogo patrocinado? Aquele que me fez sorrir por uma semana inteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "Batalhas Explosivas de Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Eita! Tantas Dodocos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "E são todos rostos familiares.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "#Olhe, Salvador{F#a} de Gatos... Hehe, ou talvez eu devesse dizer, {M#nosso}{F#nossa} admirável e brilhante Cavaleir{F#a}{M#o} Honorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "Essa boneca Dodoco foi feita com sua imagem em mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#Ela tem razão! Uau, até as cores e estampas... Hehe, é igualzinha a você, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "Nesse jogo, Dodoco das Faíscas, Dodoco Brilhante, Dodoco Cavaleira e Dodoco Bruxa têm que juntar formas e usar explosivos para derrotar inimigos nunca vistos antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Só sou responsável pela operação e patrocínio do jogo, não sei muito sobre o desenvolvimento. Esses inimigos são tão misteriosos para mim quanto são para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Mas tenho certeza que até se nos encontrarmos na vida real, as incríveis Dodocos com certeza vão mandar eles voando de volta de onde vieram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Claro! Nenhum monstro consegue impedir Klee e sua melhor amiga Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Bem, vamos experimentar então!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Hehe, tenho certeza de que vocês vão se divertir muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "Um novo jogo do Dodoco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Bem, o protótipo é difícil de passar despercebido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Essa é nova pra mim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
