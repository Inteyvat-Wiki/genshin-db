			"dialogs": [
				{
					"id": 735150101,
					"content": "#Ah, aventureir{F#a}{M#o}, você chegou. Estávamos terminando de instalar tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Se tudo der certo, vamos dar uma boa lição para aquele monstro! Uma que ele nunca vai se esquecer1",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Durante o processo formal de carregamento, é possível que alguns monstros apareceram para interrompê-lo. Pedimos que você preste atenção ao processo de carregamento e a durabilidade dos dispositivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Pode deixar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "Obrigada, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "Ah, tive uma ideia! Você passou muito tempo ajudando o Canhão Destruidor de Vermes da Areia. A honra de testá-lo pela primeira vez deveria ser sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Você não vai querer fazer isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Eu vou ficar feliz se os tiros atingirem os monstros! Além disso, ver alguém ativar o canhão para podermos ver os disparos em toda sua glória... Ah, fantástico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Você só precisa proteger o Carregador dos monstros. Quando ele carregar completamente, você só precisará esperar o momento em que o ponto fraco do Verme da Areia ficar exposto. Você só vai precisar disparar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "Os mecanismos de ignição e autocorreção cuidarão do resto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Uau, isso parece incrível... {NICKNAME}! Paimon também quer dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Está bem, eu vou controlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Hehe, então temos um acordo! Deixe eu explicar a você como funciona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Eu não faço ideia como controlar isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Oh, relaxe! Eu o desenhei seguindo à risca o princípio de interface amigável ao usuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
