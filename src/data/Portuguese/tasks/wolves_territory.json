			"dialogs": [
				{
					"id": 4510101,
					"content": "Este é o Reino dos Lobos, poucas pessoas de Mondstadt já ouviram falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510102,
					"content": "Mas, mesmo assim, não é muito longe da cidade, o ambiente aqui está totalmente intocado. É um local selvagem governado por leis da natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510103,
					"content": "Aqui os mais aptos sobrevivem. Até os Slimes por aqui são gigantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510104,
					"content": "Veja, grande assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510105,
					"content": "...Eles nos viram! Prepare-se para a batalha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "Obri..Obrigada... Ah lobos! Corra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510303,
					"content": "Não se preocupe, os lobos são mansos. Mas... Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510304,
					"content": "Somos apenas viajantes que estamos passando por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510305,
					"content": "Vocês não parecem normais, mas possuem um cheiro familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510306,
					"content": "Cheiro familiar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510307,
					"content": "Você cheira como os outros Cavaleiros de Favonius. Eu sou amigo deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510308,
					"content": "Qual é o seu nome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "Eu sou o Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510311,
					"content": "Você também é um dos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510312,
					"content": "Não, não sou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510314,
					"content": "Hã...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510315,
					"content": "O que é essa alcateia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "Eles são minha família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510317,
					"content": "Família?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510318,
					"content": "Sim, eles me criaram. Nós vivemos juntos. Somos uma família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510319,
					"content": "Tantas perguntas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510320,
					"content": "Eles estão bravos comigo. Eu te ajudar, expus nossa emboscada, javalis fugiram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510321,
					"content": "#Ah... Não se preocupe, Paimon vai pedir {F#a}{M#ao} {NICKNAME} para caçar aquele javali para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME} é mais forte do que parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510323,
					"content": "N-Não precisa. Quando cavaleiros tentam ajudar, lobos ficam com fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510324,
					"content": "Não diga besteira! Espere aqui, não vamos arruinar isso. Apenas fique olhando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510309,
					"content": "Você também é um dos Cavaleiros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "Eu sou o Razor. Não sou Cavaleiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				}
			]
		},
		{
