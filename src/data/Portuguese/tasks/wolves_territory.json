			"dialogs": [
				{
					"id": 4510601,
					"content": "Haha! Eu te disse que conseguiríamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510602,
					"content": "Eu - Obrigado, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510603,
					"content": "... Lobos pegam cinco ou seis a cada caçada... *Suspiro* Esta noite, eles passam fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510604,
					"content": "Oh-oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510605,
					"content": "Não se preocupe. Você tentou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510606,
					"content": "Pelo menos você se saiu melhor que outra cavaleira amiga... A vermelha, garota flamejante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510607,
					"content": "Se ela estivesse aqui, toda montanha seria fogo. Não pegaria nem mesmo um javali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510608,
					"content": "Tenho que ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510609,
					"content": "Aqui não é seguro. Cuidado. Sempre observando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510610,
					"content": "Que sujeito estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510611,
					"content": "Garota vermelha e flamejante? Dos Cavaleiros de Favonius? Ele estava-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, quem você acha que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
