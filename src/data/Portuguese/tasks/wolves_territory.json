						4510502
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510502,
					"content": "Lobos caçam por instinto. Funciona sempre. Mas... Montar armadilhas parece divertido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510503,
					"content": "Primeiro, montamos uma armadilha. Em seguida, perseguir os javalis - sim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510504,
					"content": "Espero que isso não exploda...",
					"roleType": "TALK_ROLE_NPC",
