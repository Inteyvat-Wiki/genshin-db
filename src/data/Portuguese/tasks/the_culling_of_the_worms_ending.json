			"dialogs": [
				{
					"id": 735190101,
					"content": "Não entendo... Foi ela quem mencionou a ideia de ir ao café escrever o relatório...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Por que você está aqui sozinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "Ah, nem me fale. Ela escreveu o relatório sozinha e foi embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Deveríamos nos encontrar no café ontem, mas ela demorou muito para aparecer. Ela nem trouxe caneta ou papel para o relatório!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Eu a critiquei por perder tempo com o relatório, e então ela ficou furiosa! Ela disse que escreveria ela mesma o relatório e me mandou embora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "Que absurdo! Vocês não acham?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Ainda assim, estou acostumado com seu temperamento explosivo e ela vai se acalmar em alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Se os sentimentos dela fossem simples como os de um mecanismo, tudo seria melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Boa sorte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Hã? Por que vocês estão agindo de maneira tão estranha? Esqueçam... Ainda há alguns Vermes da Areia afetados por aqui, mas eles se acalmarão se deixados em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Mas se vocês tiverem tempo, por favor, impeçam que eles façam os transeuntes correrem perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Falando nisso, o ambiente elemental e o Carregador voltaram ao normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "Se há uma oportunidade perfeita para testar toda capacidade do Canhão Destruidor de Vermes da Areia, é essa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Tudo de bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Onde está Shriya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}