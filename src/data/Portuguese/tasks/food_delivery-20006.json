			"dialogs": [
				{
					"id": 200060201,
					"content": "Obrigada, estes Slimes são uma dor de cabeça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Orlean Ativa"
				},
				{
					"id": 200060202,
					"content": "Se eu ainda tivesse força, esses caras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Orlean Ativa"
				},
				{
					"id": 200060203,
					"content": "Sua comida, senhorita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Hum... Cheira à cenoura e carne... É uma pena que não cheguei mais cedo, senão eu teria mandado aqueles Slimes para longe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Orlean Ativa"
				},
				{
					"id": 200060205,
					"content": "É melhor deixar para lá. Aqui está o dinheiro, leve para a Sarah por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orlean Ativa"
				}
			]
