			"dialogs": [
				{
					"id": 200060101,
					"content": "Pedir para viagem",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "#Bem-vind{M#o}{F#a} ao Caçador de Cervos... Oi, Viajante, você chegou na hora certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Desculpe, sei que está com fome, mas posso pedir um favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "A senhora Orlean do Vale Termal pediu um prato de <color=#00E1FFFF>Carne Frita com Cenoura e Mel</color>, mas ouvi dizer que tem alguns Slimes causando problemas ao redor do Vale Termal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "Eu não me atrevo a ir sozinha... Você poderia entregar este pedido para a <color=#00E1FFFF>Orlean no Vale Termal</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Pode ser, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Quando você voltar, você será recompensado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Conto com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Eu apenas vim aqui para comer. Eu estou morrendo de fome!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Quando você fizer o que eu pedir, eu vou preparar um prato especial do Caçador de Cervos para você! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
