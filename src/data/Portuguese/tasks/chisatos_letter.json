			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#Você é... Ah, você é aquel{F#a}{M#e} Viajante forasteir{F#a}{M#o}. Em que posso lhe ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Sobre a carta de Hiiragi Chisato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "A senhorita Hiiragi realmente lhe pediu para entregar essa carta para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Essa escrita... Realmente é dela... Ótimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "Obrigado por fazer isso, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Quanto a Permissão de Viagem... Já que ela é um pedido pessoal da senhorita Hiiragi, cuidarei disso pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Entretanto, eu precisarei de algum tempo para preparar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Que tal fazermos assim: vocês podem ir primeiro para o Restaurante Kiminami e esperar por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Por que ir para lá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Bem, isso... Eu gostaria de lhe pedir que me ajudasse um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Recentemente, eu também estava pensando em enviar algo para a senhorita Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Eu escrevi uma carta e também para a senhorita Kiminami fazer alguns aperitivos para mim. Eu estava pensando em os enviar para a senhorita Hiiragi como um presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "Mas se meu pai descobrir meus planos, pode acabar se irritando... Você apareceu na hora em que eu estava pensando o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "É só um presente, nada demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Meu pai não quer que eu fale com a senhorita Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Eu entendo as preocupações dele. Afinal de contas, eu sou um membro do Clã Kujou, e um dos executores da Comissão Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "E a senhorita Hiiragi é a jovem dama do Clã Hiiragi da Comissão Kanjou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Se eu me aproximasse dela, seria inevitável que alguém se aproveitasse de nossa situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Apesar de ser apenas um presente, é muito mais do que isso nos olhos de algumas pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Haha, mas deixemos de falar de assuntos triviais como esses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "Viajante, por favor, espere por mim no Restaurante Kiminami. Depois de aprovar a Permissão de Viagem, levarei ela até você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "O seu pai é muito severo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Meu pai naturalmente é um homem muito severo. Eu entendo porque ele não está disposto a me comunicar com a senhorita Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
