					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Você está falando do Mestre Kamaji? O que vocês querem com ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Mostrar a carta de Chisato)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Você disse que essa carta é da senhorita Hiiragi Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Se essa carta realmente é dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Eu acho que você deveria falar com o Mestre Kamaji diretamente. Ultimamente ele tem caminhado perto da ponte.",
