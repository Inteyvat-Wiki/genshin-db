			"dialogs": [
				{
					"id": 728070401,
					"content": "#Olá, seja bem-vind{F#a}{M#o} ao Restaurante Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070402,
					"content": "Sobre os aperitivos de Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "Oh, eu já preparei o que o Mestre Kamaji pediu. Trarei para você agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070404,
					"content": "Mas, estou curiosa sobre quem o Mestre Kamaji os dará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070405,
					"content": "São apenas negócios públicos, nada demais, senhorita Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070406,
					"content": "Um tempo atrás, o senhor Hiiragi Shinsuke presenteou o meu pai com um lote ótimo de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070407,
					"content": "Meu pai sabe que a amada filha do senhor Hiiragi, Chisato, adora aperitivos. Por isso ele me disse para preparar alguns como um presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070408,
					"content": "#Eu estava preocupado que a entrega poderia tomar muito tempo, e também alguns problemas no caminho seria inevitáveis na jornada... Por isso pedi para ess{F#a}{M#e} Viajante especificamente os entregar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070409,
					"content": "Senhorita Kiminami, posso dar uma olhada neles, por favor? Quero garantir que não deixei nada passar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070410,
					"content": "Sim, claro. Aqui estão. Pode olhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070411,
					"content": "Tudo está aqui. Obrigado, senhorita Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070412,
					"content": "Vamos sair do caminho, Viajante. Eu ainda tenho algo para falar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070413,
					"content": "Aqui está sua Permissão de Viagem, pegue-a.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070414,
					"content": "Com essa Permissão de Viagem, você poderá entrar e sair de Ritou livremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070415,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "Não precisa agradecer. Essa Permissão fará sua entrega mais conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070417,
					"content": "Além disso... Aqui está a carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070418,
					"content": "Você mesmo escreveu essa carta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "Sim. Eu tentei escrever essa carta de uma maneira... Delicada. Eu espero que a senhorita Hiiragi não fique ofendida com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070420,
					"content": "Por favor, entregue essa carta e esses aperitivos para a senhorita Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070421,
					"content": "Nós temos que voltar de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "Haha, mas dessa vez, você tem uma Permissão de Viagem. Devemos ter muito mais liberdade de agora em diante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070423,
					"content": "Deixarei isso com você, Viajante. Também preciso retornar e lidar com alguns assuntos oficiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070424,
					"content": "Ugh, quando será que poderei eu mesmo ir lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				}
			]
		},
