			"dialogs": [
				{
					"id": 728070501,
					"content": "Viajante, você voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070502,
					"content": "Creio que você deve ter entregue a minha carta para Kamaji. E quanto a Permissão de Viagem? Conseguiu ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070503,
					"content": "#Sim, consegui. Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "Não precisa me agradecer. Isso é graças a ajuda de Kamaji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070506,
					"content": "Hã? O que é isso? Aperitivos... E uma carta escrita pessoalmente por Kamaji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070507,
					"content": "Qual era o pedido dele? Esses Dango de Três Cores... Ele os preparou para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070508,
					"content": "Obrigada, Viajante. Degustarei bem desses aperitivos. E quanto a essa carta, lerei ela cuidadosamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070509,
					"content": "Obrigada pelo seu trabalho duro. Por favor, aceite isso daqui como sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070510,
					"content": "Eu talvez precise de sua ajuda novamente no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070505,
					"content": "Isso é de Kamaji para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
