			"dialogs": [
				{
					"id": 740580201,
					"content": "Uau, vocês encontraram tanto... Isso é uma ajuda enorme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Eu já enviei o minério para a oficina, mas ainda não recebi minha amostra de produto. Pode ser porque os artesões não têm familiaridade em trabalhar com minérios como esse e encontraram alguns problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Mas não se preocupem! Eu confio em meu julgamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Estou planejando transformá-las em acessórios que sem dúvida se tornarão a mais nova moda em toda Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "Vocês vão ver como ficou o produto final da próxima vez que visitarem! Eu darei algumas amostras a vocês de presente quando chegar a hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Ou talvez... quando vocês chegarem, já vão ver os nobres mais por dentro da moda usando eles, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "#Enfim... não importa quando voltarem, vocês sempre serão bem-vind{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
			]
