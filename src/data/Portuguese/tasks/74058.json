			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#{NICKNAME} e Paimon! Vocês vieram para brincar comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Hmm, na verdade, não! Você nos disse que a gente podia te perguntar qualquer coisa relacionada a veios de minério e gemas, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Sim! Eu já coletei todas as pedras bonitas da área. O que vocês querem perguntar exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "É sobre aquela pedra que encontramos da última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Vocês contam à Puca como venderam o minério estranho para o comerciante de gemas...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Hã? As pessoas de fora pensam mesmo que isso é uma gema preciosa? Mas até minha irmã já disse que elas não têm valor... Humanos são mesmo difíceis de entender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Mas eu sei de muitos lugares com pedras assim! Se quiserem, eu mostro onde elas estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca marca os locais do minério estranho no seu mapa.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Maravilha! Obrigada, Puca! Oh, sim. Aqui está a Mora que Chesil pagou adiantado. Podemos dar metade dela para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Oh, não precisa. Não precisamos de nada como isso na vila... além do mais, vocês já me ajudaram bastante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
