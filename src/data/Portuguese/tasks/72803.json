			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladrão de Tesouro Sarcástico"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "Seus ladrões! A divindade não está me respondendo porque vocês roubaram minhas oferendas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030202,
					"content": "Oferendas? Você está falando das coisas que foram colocadas do lado do santuário? Por favor, nós não iríamos querer essas coisas mesmo se você as desse para nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "Ladrão de Tesouro Sarcástico"
				},
				{
					"id": 728030203,
					"content": "Se você está oferecendo um lixo como aquele para o santuário, seria engraçado se uma divindade sequer respondesse você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "Ladrão de Tesouro Sarcástico"
				},
				{
					"id": 728030204,
					"content": "O que você está dizendo? Minhas oferendas não são lixo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030205,
					"content": "Esqueça, não temos tempo para ficar gastando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "Ladrão de Tesouro Sarcástico"
				},
				{
					"id": 728030207,
					"content": "Minhas oferendas não são lixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030208,
					"content": "Você pode nos dizer seus desejos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "Está bem... Já que isso aconteceu, acho meu desejo não será concedido mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030210,
					"content": "Meus dois desejos são simples. O primeiro é que não quero mais fazer provas. Se eu não tiver que fazer provas, não serei repreendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030211,
					"content": "O segundo desejo... Eu quero que a malvadona na escola pare de fazer bullying comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030212,
					"content": "Eu também não gosto de provas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "Sim! Provas são muito ruins... Mas aquela malvadona me faz sentir ainda pior...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030216,
					"content": "Ela já me viu várias vezes enquanto estava fazendo uma oferenda para o santuário. Quando me ouviu dizer que não gosto de provas, foi até os professores e perguntou pelos meus resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030217,
					"content": "De agora em diante, ela sempre diz que meu tempo é melhor gasto prestando atenção nas aulas ao invés de rezando em um santuário. Ela também disse que, se eu ficar incomodando, até as divindades ficarão impacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030218,
					"content": "Ela até mesmo disse que eu estou sendo patético...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030219,
					"content": "Bem, realmente não é bom depender tanto de uma divindade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "Mas, quando os adultos têm problemas, eles sempre fazem oferendas para os santuários...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030221,
					"content": "Eles só estão fazendo um desejo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "Humm... Eu não entendo. Pensei que todos faziam oferendas para os santuários para pedir a ajuda de sua divindade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030224,
					"content": "Vamos perguntar a alguma outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030225,
					"content": "Hum... Está bem. De qualquer jeito, meu desejo não será concedido agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030222,
					"content": "No final, eles mesmo têm que resolver seus problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "Malvadona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "Ela é uma pessoa da minha classe. Ela é totalmente irracional!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280304,
			"completionStepIds": [
				7280306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280306",
							"2"
						],
						"stepId": 7280306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "Olá, podemos ajudar vocês com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030402,
					"content": "Sobre as oferendas no santuário...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "Oh... Os Santuários... Eu estive algumas vezes lá também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030404,
					"content": "Hehe, eu quero as bênçãos da divindade, pois quando crescer, possa sair e ver como o resto do mundo é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030405,
					"content": "Entretanto, no final do dia, as oferendas são só uma forma de oração. Eu ainda preciso trabalhar muito para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030406,
					"content": "Meus pais disseram que se eu quiser viajar, preciso ganhar muito dinheiro antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030407,
					"content": "Sim, desde que você tenha as bênçãos da divindade, seus sonhos se realizarão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030408,
					"content": "Bem, não posso dizer isso com certeza. Afinal de contas, se eu realmente visitasse o resto do mundo, não acho que as divindades de Inazuma seriam capazes de me proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030409,
					"content": "Meus pais costumavam dizer que dar oferendas para as divindades é só para ter a consciência limpa. Se você realmente quer realizar seus desejos, isso dependerá de quanto trabalho duro você colocar neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030410,
					"content": "Eu não sei exatamente como explicar isso bem. Se vocês quiserem saber mais, falem com Nanatsuki. Ela sabe bastante sobre essas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030411,
					"content": "#Hmm... {F#Tia}{M#Tio}, vamos procurar por Nanatsuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "Shouta? Por que você está tão irritado? Alguém lhe chateou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030502,
					"content": "Nanatsuki, você deve saber que todos na cidade dão oferendas para o santuário e obter bênçãos das divindades, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030503,
					"content": "Desde que coloquemos nossas verdadeiras intenções em nossas oferendas, e também façamos com que as divindades tenham uma razão para responder, qualquer desejo pode ser concedido, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030504,
					"content": "Hã? Por que você está falando sobre isso do nada? Aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030505,
					"content": "O que aconteceu foi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "Shouta... Você foi para o santuário tão entusiasmado por causa de uma coisa como essa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030508,
					"content": "Sim! Eu dei as oferendas com todo meu coração! Mas elas continuaram a ser roubadas... Eu pensei que a divindade me culparia por isso e não me protegeria mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030509,
					"content": "Oh, que ingenuidade... Não se preocupe, a divindade não ficará irritada com você por causa de algo pequeno como isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030510,
					"content": "Mesmo? Que bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030511,
					"content": "Mas da mesma forma, essa divindade não ajudará alguém só por causa de algumas oferendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030512,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030513,
					"content": "A razão para as pessoas fazerem oferendas e pedirem bênçãos não é porque querem que seu desejo se realize. Ao invés disso, essas pessoas deram suas oferendas para construírem uma base firme para sua confiança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030514,
					"content": "Acreditar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030515,
					"content": "\"Como já falamos nossos desejos para a divindade, devemos tentar nosso melhor para fazer com que eles se realizem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030516,
					"content": "\"Com uma divindade nos olhando, se colocarmos o esforço suficiente, certamente teremos sucesso\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030517,
					"content": "Com tal tipo de confiança, as pessoas então estão dispostas a darem o melhor de si para realizarem seus desejos. Essa é a razão porque todos dão oferendas para os santuários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030518,
					"content": "No final do dia, são pessoas que movem o mundo. Se rezarmos para divindades e não fizermos nada, ainda que uma divindade queira ajudar, não saberá o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030519,
					"content": "Mas quando eu fazia oferendas para o santuário antes, a divindade sempre me ajudou diretamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030520,
					"content": "Naquela ocasião com o fogo, com o senhor que queria ficar mais forte, e também com aquela revista em quadrinhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030521,
					"content": "(Ele ainda está falando sobre as divindades...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "Hmm... Você está certo. Parece que aquela divindade tem um jeito direto de realizar desejos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030524,
					"content": "Mas, não apenas as provas não desapareceram, aquela malvadona ainda está lá. Ela ainda me incomoda todo dia sobre fazer minha tarefa de casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030525,
					"content": "Hmm, espere um pouco. Essa pessoa que está fazendo bullying com você, qual o nome dela? Quando ela apareceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030526,
					"content": "Ela se chama... Ela... Hã, qual é o nome dela mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030527,
					"content": "Acho que ela entrou na escola na mesma época que eu... Não, não, acho que antes... Ou foi depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030528,
					"content": "Que estranho... Por que não consigo me lembrar? A única coisa que me lembro é de uma garota me dizendo para estudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030529,
					"content": "Hmmm, parece que essa divindade respondeu seus desejos, e está lhe ajudando a vencer seu desgosto por provas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030530,
					"content": "Você está dizendo que essa garota que me intimida o tempo inteiro foi enviada pela divindade para me obrigar a estudar?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030531,
					"content": "Não! Não! Eu não quero estudar, e nem quero fazer provas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030532,
					"content": "Aaaah! Ela está aqui de novo, ali! Está vindo do outro lado da rua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030533,
					"content": "onde está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "#{F#Tia}{M#Tio}, você não consegue ver ela? Ela está vindo com uma pilha enorme de provas! Aaah! Eu não quero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030536,
					"content": "Parece que essa divindade é muito dedicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030537,
					"content": "Essa divindade faz tudo ao seu ritmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "Mas, sob a supervisão pessoal daquela divindade, essa criança deve ser capaz de passar suas provas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030540,
					"content": "Afinal de contas, creio que até divindades não conseguem aguentar os constantes incômodos dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030541,
					"content": "Hã? Espere um pouco. Por que será que há folhas na estrada? Elas não estavam aqui antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030538,
					"content": "Não parece algo que uma divindade faria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "Não consigo ver nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(Não tem nada a ver...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}