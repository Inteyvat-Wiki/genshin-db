			"dialogs": [
				{
					"id": 750910501,
					"content": "Olhe só, ela fez de novo, e estão ainda melhores do que antes... Ainda parece bem mágico, apesar de já termos visto isso duas vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "#Heh, hehe, forasteir{M#o}{F#a}s cautelos{M#o}{F#a}s...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Agora que viram com seus próprios olhos, não podem mais negar a grandeza da Pedra do Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Aaah, e graças às pedras que vocês trouxeram, o poder da Pedra do Tesouro ficou ainda mais forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Quem sabe o quão poderosa ela pode se tornar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Agora que você mencionou, até a Paimon está começando a ficar curiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Tudo o que você precisa fazer é alimentá-la com pedras e ela cria outras ainda melhores para você... Mas como isso funciona? Por que não a abrimos para dar uma olhada por dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "C-Como você pode sugerir uma coisa dessas? Não, eu não permitirei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Se você realmente está planejando abri-la... Terá que passar por cima do meu cadáver primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Hã, isso foi só um comentário sem importância...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Hunf, considerando que vocês trouxeram todas aquelas pedras antes, vou deixar sua insolência passar... Mas só desta vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "T-Tá bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Eu posso sentir, hehe! Se eu conseguir alimentar a Pedra do Tesouro com pedras de qualidade ainda mais alta, tenho certeza de que ela produzirá algo incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "Viajante de terras distantes, um mercador estrangeiro uma vez me falou sobre um tipo especial de pedra do deserto que guarda um poder extraordinário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Seu nome... Sim, seu nome é Trishiraita. Se você pudesse trazê-la para que eu pudesse alimentar a Pedra do Tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Tenho certeza, sem sombra de dúvida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Hmm... O que você acha, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "Vamos tentar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Paimon está bem curiosa para ver o que vai acontecer também, com certeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "Se vocês realmente conseguirem Trishiraita... Um único pedaço deve ser suficiente...",
					"roleType": "TALK_ROLE_NPC",
