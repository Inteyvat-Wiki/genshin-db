			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "Uau, algo realmente cresceu a partir dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "Salve a Pedra do Tesouro... Espere um segundo, você não só colocou essas pedras em cima, colocou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "...Heh, hehe, eu pareço alguém que faria algo tão tolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "Graças às pedras que você trouxe, a Pedra do Tesouro está ainda mais energética do que antes. Ei, você não consegue ouvi-la...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Esse som, pulsando como o magma que flui sob a terra, é exatamente como... Ah, como um batimento cardíaco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Eu sabia... Eu sabia que só precisava encontrar outras pedras para alimentá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Er... Paimon não está ouvindo nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#Você consegue ouvir alguma coisa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "Soa apenas uma pedra comum para mim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "#Hehe, forasteir{M#o}{F#a}s... Ou talvez eu deva dizer, ilustres convidad{M#o}{F#a}s de terras distantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Se puderem, por favor, encontrem mais algumas pedras para mim... melhores, mais bonitas... O poder da Pedra do Tesouro não os desapontará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910315,
					"content": "Eu sinto isso nos meus ossos... Eu sei que isso será bom para ela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910316,
					"content": "Por que parece que estamos caindo cada vez mais fundo em uma armadilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910317,
					"content": "#O que você acha, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910318,
					"content": "Se isso significa que conseguiremos colocar as mãos em algumas pedras melhores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Definitivamente vale a pena tentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910320,
					"content": "Hehe, ótimo! Então, desta vez, vocês irão escolher algumas pedras ainda melhores do que antes e vão entregá-las diretamente a mim... E com pedras ainda melhores para se alimentar, a Pedra do Tesouro certamente se tornará mais poderosa do que nunca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910311,
