			"dialogs": [
				{
					"id": 750910201,
					"content": "Mmm... Paciência, paciência é a chave. Quando as coisas se acalmarem, eu vou alimentar a Pedra do Tesouro com estas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Dê um pouco de tempo, hehe, e ela produzirá algumas pedras ainda melhores... Hehe... Um, dois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
		{
