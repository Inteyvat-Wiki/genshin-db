					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Eu soube que durante o Ritual de Lanternas, as pessoas daqui gostam de incluir um desses envelopes com os outros presentes.",
