					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Então queria seguir o costume e eu mesma fazer alguns envelopes de presente. Mas eles não estão indo muito bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "#Quero que meus envelopes de presente sejam lindos! Pode me mostrar como faz? Cavaleir{F#a}{M#o} Honorável?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
