			"dialogs": [
				{
					"id": 715370101,
					"content": "#Cavaleir{F#a}{M#o} Honorável! Não esperava te encontrar aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
