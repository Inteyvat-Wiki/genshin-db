			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, finalmente chegou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050102,
					"content": "O ajuste correu bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "O ajuste foi concluído, embora eu esteja um pouco preocupado, mas agora só posso temporariamente colocar a Ponta nas profundezas da mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050104,
					"content": "Também pedi a Khedive para fazer remédios, que serão enviados para Lao Tu e Hao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}, ative a Ponta, e então feche a saída da Linha Ley jorrando Lama Preta... Precisa conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050106,
					"content": "Originalmente, Khedive me pediu para vir e me fazer um pequeno favor. Naquele momento pensei comigo mesmo, se eu não conseguir resolver esse problema, máximo que pode acontecer é eu voltar para Sumeru carregando a Ponta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050107,
					"content": "De qualquer forma, experimentos suficientes foram conduzidos com a Ponta de Pursina, e é mais que suficiente para completar um relatório com dados detalhados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050108,
					"content": "Mas para Lao Tu e Hao, essas pessoas que vivem aqui... Eles só podem viver suas vidas ao lado dessa Lama Preta perigosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050109,
					"content": "Se minha pesquisa não puder realmente ajudá-los, e for apenas para um relatório, temo que ela não seja muito significativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050110,
					"content": "Por isso resolvi encontrar uma forma de resolver o problema da Lama Preta que sai da Linha Ley. Sem falar no contato com essa Lama Preta... É também um alerta para mim como um Estudioso de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050111,
					"content": "#Eu acredito na sua força, mas o lugar de onde a Lama Preta está saindo ainda é muito perigoso, tome cuidado, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050112,
					"content": "Claro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "Hahaha, ah... *Cof, cof* *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050115,
					"content": "#Estou falando de você, {NICKNAME}, embora ativando a Ponta de Pursina, diminua o efeito da Lama Preta nos monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050116,
					"content": "Mas o número de monstros que foram reunidos pela Lama Preta é grande demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050117,
					"content": "Deve ter cuidado com a sua própria segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715050113,
					"content": "Terei cuidado com a Ponta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}