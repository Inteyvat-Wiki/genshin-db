			"dialogs": [
				{
					"id": 722020101,
					"content": "Pássaro do Trovão, você me abandonou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020102,
					"content": "Olá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "Pássaro do Trovão, não fique irritada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020105,
					"content": "Eu farei o meu melhor para ler a sua vontade e seus ensinamentos... mas... mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020106,
					"content": "Mas por que você me recusou? Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020107,
					"content": "Por que eu não consigo entrar no seu nevoeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020108,
					"content": "Ler? O que você quer dizer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "As Pedras do Trovão que você deixou... Eu vou pensar em uma maneira... O barco prateado já chegou, não tenho mais muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020110,
					"content": "Pedras do Trovão... o que são?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "Pedras do Trovão da Planície Autake... só poderão ser revividas por aqueles que manipulam o Electro... E apenas aqueles que encontram um caminho na névoa poderão encontrá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020112,
					"content": "Como se a Pássaro do Trovão estivesse de pé e abrisse as suas asas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chise"
				},
				{
					"id": 722020113,
					"content": "Mas o nevoeiro já se dissipou, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "Precisa de alguma ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
