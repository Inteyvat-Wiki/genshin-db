			"dialogs": [
				{
					"id": 706990101,
					"content": "#Cavaleir{F#a}{M#o} Honorável! Temos muita sorte por você ter vindo testar as barracas de entretenimento. Isso realmente me tranquiliza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "Na verdade, esta é a primeira vez que participo de um projeto de desenvolvimento, então estou um pouco nervoso. Isso está meio que fritando meu cérebro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Tudo que tive de fazer foi colocar uma capa num dispositivo existente. Mas há tantas considerações no design, tantos parâmetros para ajustar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Eu não invejo o capitão Albedo por ter criado um dispositivo multiúso do zero... deve ser algo tão difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Acho que está funcionando bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "#Uau, obrigado, Cavaleir{F#a}{M#o} Honorável! Isso é muito encorajador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Eu... eu vou fazer melhor. Espero chegar ao ponto de poder construir algo útil para o Grupo da Guerrilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "Oh, eu ganhei alguns brinquedos nesses jogos. Gostaria que você ficasse com esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "Eu outro igual. Agora, quando olhar para ele, vou lembrar do encorajamento que você me deu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Não seja tão duro com você mesmo, você só pode melhorar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
