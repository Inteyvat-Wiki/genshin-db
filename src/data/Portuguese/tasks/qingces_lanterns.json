					"nextDialogs": [
						413313707
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 413313707,
					"content": "Vovó, nós também vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "Dongdong"
				},
				{
					"id": 413313708,
					"content": "Ah vocês... Está bem, vamos logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413313709,
					"content": "Você não vai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "Eu? Não tenho pressa, quero ver as Lanternas Celestes mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413313711,
					"content": "Por favor, fique com isso. Obrigada pela sua ajuda com tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413313712,
					"content": "#Obrigad{M#o}{F#a} Avó Ruoxin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "Não precisa agradecer. Vi que sua idade também não é tão avançada. Ficar fazendo tudo isso é realmente muito trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413313714,
					"content": "Fique mais um pouco e aproveite o feriado com todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413313715,
					"content": "Você ficou correndo para todos os lado durante o ano inteiro. Sempre é bom descansar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				}
			]
