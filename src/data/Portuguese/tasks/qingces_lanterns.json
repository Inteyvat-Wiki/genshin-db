				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "Chegou o Ritual de Lanternas... Ugh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310202,
					"content": "Com o quê você está preocupado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "É o Ritual de Lanternas. Deveria ser uma época animada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310204,
					"content": "Mas aqui na Vila Qingce, só há crianças e idosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310205,
					"content": "Os jovens que foram para a cidade trabalhar estão muito ocupados para voltarem a vila para descansar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310206,
					"content": "Ou eles estão muito longe e não conseguem retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310207,
					"content": "É um festival que deveria ser passado com toda a família, entretanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310208,
					"content": "Eu também entendo que eles estão com seus problemas, mas é um festival grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310209,
					"content": "Eu não devo dizer mais nada... Mas um feriado como esse não devia ser assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310210,
					"content": "Sim, se você quiser, poderia ajudar Xiaobai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310211,
					"content": "Ela disse que queria comprar para todos muitas comidas, e está muito ocupada. Temo que ela sozinha não consiga resolver tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310212,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "Muito obrigada, muito obrigada mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Avó Ruoxin"
				},
				{
					"id": 413310213,
					"content": "Não se preocupe, eu ajudarei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
