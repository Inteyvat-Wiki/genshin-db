			"dialogs": [
				{
					"id": 190785001,
					"content": "O Sr. Kaveh parecia com raiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Quem se importa com ele? Talvez ele só esteja preocupado de tomarmos todas as comissões dele quando finalmente nos formarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "M-Mas não pode ser isso, né? O Sr. Kaveh é super famoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Quem sabe? Meu pai me disse que quanto mais famoso alguém é, mais arrogante e teimoso vira. Pessoas acessíveis como o Sr. Alkami é que são raras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
