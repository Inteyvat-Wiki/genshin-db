			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Você ouviu? Alkami recrutou Kaveh para ser um instrutor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Heh, aposto que isso vai aumentar o número de matrículas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Isso te deixa com inveja, né? Se você pensar sobre isso, Alkami nunca foi tão talentoso como arquiteto. Se estivermos falando sobre habilidades profissionais, ninguém pagaria por uma aula com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Isso é verdade, mas você tem que admitir, a publicidade dele é bem eficaz... Afinal, a Academia apenas admite aqueles que conseguem passar no exame de admissão, então apenas algumas pessoas poderiam esperar estudar arquitetura nos salões do Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Para aqueles que não conseguem passar no exame ou aqueles que querem entrar direto na indústria, o centro de treinamento é o melhor custo-benefício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Cara, ter esse tipo de perspicácia de negócios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
