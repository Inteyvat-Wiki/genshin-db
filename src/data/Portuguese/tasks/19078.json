			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Ei, posso te ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Você conhece um homem chamado Alkami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Oh, Alkami? Você quer dizer aquele sujeito rico que está criando um nome para si mesmo? Ele comissionou um conjunto de móveis comigo pouco tempo atrás. Até pagou bastante Mora por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "Ouvi dizer que ele ganhou uma fortuna trabalhando como um arquiteto renomado. Agora ele abriu um centro de treinamento para que outros possam seguir seus passos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "Se o valor não fosse tão alto, eu inscreveria meu filho sem nem pensar. Arquitetura realmente parece ser uma profissão muito lucrativa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Me pergunto se você sabe algo sobre Alkami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
