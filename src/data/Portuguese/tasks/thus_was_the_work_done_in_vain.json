			"dialogs": [
				{
					"id": 790132701,
					"content": "Paimon espera que Wolfgang desista dessa ideia dele de ir para a Espinha do Dragão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132702
					],
					"speakerTitle": "Mensagens"
				},
				{
					"id": 790132702,
					"content": "Vamos voltar às ruínas em que estávamos anteriormente quando saímos pelo lago. Talvez encontraremos alguma indicação de que ele mudou de ideia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mensagens"
