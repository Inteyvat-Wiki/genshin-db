			"dialogs": [
				{
					"id": 790132601,
					"content": "Ainda bem que ele não entrou, Paimon está aliviada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132602,
					"content": "Mas Paimon não entende o motivo dele estar com essa atitude arrogante! Que irritante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132603,
					"content": "Ele está cada vez mais cheio de si...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132604
					]
				},
				{
					"id": 790132604,
					"content": "Ele disse que as ruínas altas devem ter caído na última vez para perto das ruínas na água...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132605,
					"content": "Vamos dar uma olhada... Paimon não tem nem ideia se ele conseguiu escalar até tão alto em segurança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
