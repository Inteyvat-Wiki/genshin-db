			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131801,
					"content": "(Um entalhe antigo escrito por alguém...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790131802,
					"content": "\"O vento está muito forte, não tenho como escrever nada em uma nota.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790131803,
					"content": "\"O amanhecer aqui é lindo. Apesar de ter vindo aqui ter sido uma experiência perigosa, me sinto muito satisfeito.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790131804,
					"content": "\"Será que alguém depois de mim também poderá vir aqui e ver essa bela paisagem?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790131805,
					"content": "\"...Eu consegui passar pelos perigos do caminho e vir até aqui. Minha próxima parada é a Espinha do Dragão!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790131806,
					"content": "\"Esse lugar é ótimo, só é uma pena que não possui nenhum Frango Assado com Mel...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790131807,
					"content": "\"Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Entalhe"
				}
			]
		},
		{
			"id": 7901319,
			"completionStepIds": [
				7901327
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7901327",
							"2"
						],
						"stepId": 7901327,
						"stateName": "QUEST_STATE_UNFINISHED"
