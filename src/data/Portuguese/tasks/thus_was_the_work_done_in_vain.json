			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "Hmm, Frango Assado com Mel é realmente delicioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130202,
					"content": "Paimon entende porque Wolfgang disse que sentia saudades do gosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130203,
					"content": "Mas, ele ficou preso aqui e não comeu o Frango Assado com Mel... Isso deixa Paimon triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130204,
					"content": "Este caderno é muito velho...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#Sim... Mas, falando nisso, {NICKNAME}, você lembra que atravessamos algo tipo um lago em uma ilha para chegar na ilha do outro lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130217,
					"content": "As construções na ilha dentro do lago parecem bem mais completas das que estão do lado de fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130218,
					"content": "Esses edifícios daqui parecem iguais aos daquelas ruínas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130219,
					"content": "As construções dentro do lago devem ser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "É bem possível! As construções da ilha de dentro devem ser as formas originais das ruínas por fora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}, você quer dizer que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130223,
					"content": "Que a ilha no lago é a ilha de antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "Sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130207,
					"content": "Além disso, veja... Podemos salvar aquele sujeito se encontrarmos onde a Câmara Secreta costumava ficar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130208,
					"content": "Só influenciará o que aconteceu dentro da miragem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "Sim, mas... mesmo que tudo seja mentira, e mesmo que esse aventureiro nem exista... Não deveríamos pelo menos tentar salvá-lo? Seu destino é tão triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130212,
					"content": "Paimon está certa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#Bem, sabia que {M#o}{F#a} {NICKNAME} acharia o mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130216,
					"content": "Vamos dar uma olhada naquela ilha no lago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130214,
					"content": "Bem, vamos dar uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "Sim, se pudemos ajudar Wolfgang, ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790130209,
					"content": "Isso não mudaria o que aconteceu na realidade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "As construções dentro do lago refletem sua aparência original...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "Isso aconteceu há muito tempo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
