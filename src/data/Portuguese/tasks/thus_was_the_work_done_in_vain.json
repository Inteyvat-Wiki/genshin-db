			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790132901,
					"content": "(Um entalhe antigo escrito por alguém...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132902
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132902,
					"content": "\"O vento está muito forte, não tenho como escrever nada em uma nota.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132910
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132910,
					"content": "\"Haha, e imaginar que eu encontraria um Frango Assado com Mel aqui — e ainda quentinho! É praticamente um milagre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132903
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132903,
					"content": "\"Não sei quem deixou aquele Frango Assado com Mel aqui ou como sabiam que eu queria um. É tudo muito estranho... mas mesmo assim, estou muito grato.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132904
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132904,
					"content": "\"Obrigado, pessoa que deixou esses entalhes para trás. Seu Frango Assado com Mel é o melhor que já comi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132905
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132905,
					"content": "\"Obrigado. Eu sei que a Espinha do Dragão é perigosa, e eu também compreendo minha condição... Mas eu ainda assim quero ir até lá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132906
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132906,
					"content": "\"Irei para a Espinha do Dragão, e se eu morrer lá, pelo menos deixarei informações para trás sobre armadilhas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132907
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132907,
					"content": "\"Mas se alguém conseguir evitar os perigos e chegar mais longe do que cheguei, para mim, isso seria ainda mais precioso do que um Frango Assado com Mel.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132908
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132908,
					"content": "\"Obrigado, pessoa que deixou estes entalhes. Quero ir para uma aventura na Espinha do Dragão justamente por ela ser perigosa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132909
					],
					"speakerTitle": "Entalhe"
				},
				{
					"id": 790132909,
					"content": "\"Atenciosamente, Wolfgang.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Entalhe"
				}
			]
		},
