			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "Oh, ele não deixou uma nota porque deixou essa mensagem entalhada nesse pilar! Ele conseguiu chegar aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131902,
					"content": "Mas de onde ele tirou essa confiança? Se não fosse por nossa ajuda, ele ainda estaria preso naquela Câmara Secreta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131903,
					"content": "Se ele for para a Espinha do Dragão, com certeza vai virar um pedaço de Carne Fresca Fria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131904,
					"content": "Acho que você está exagerando, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "O que Paimon quer dizer é que se ele for para a Espinha do Dragão, com certeza encontrará algo perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131908,
					"content": "Temos que contar a ele que ele não pode ir para a Espinha do Dragão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131909,
					"content": "Então vamos deixar mais uma mensagem para ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "Sim, Paimon concorda! Desta vez vamos preparar mais um Frango Assado com Mel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131911,
					"content": "Talvez se ele comer, se lembrará de Mondstadt e de como suas temperaturas são agradáveis, e assim não irá para a Espinha do Dragão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131912,
					"content": "Você não acha que o Frango Assado com Mel vai estragar...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131913
					]
				},
				{
					"id": 790131913,
					"content": "Hã... O que vale é a intenção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131906,
					"content": "Com certeza encontrará algo perigoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131907
					]
				},
				{
					"id": 790131907,
					"content": "Sim! A Espinha do Dragão é muito fria, é cheia de Hilichurls... E ainda tem aquele Grande Rei Javali da Neve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
