			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "O quê? Esse cara está falando várias bobagens, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131602,
					"content": "Isso é péssimo. Temos que voltar à Espinha do Dragão e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131603,
					"content": "Paimon, as mudanças que ocorrem na miragem não mudam o passado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "Ah... Certo, é verdade. Afinal de contas, o Wolfgang só está \"aqui\" pois o Arquipélago de Maçã Dourada está sob o efeito daquele dispositivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131606,
					"content": "Paimon achava que Wolfgang tinha sido salvo... Mas na verdade, ele nunca saiu da Câmara Secreta, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131607,
					"content": "Mas... Mas esse tal de Wolfgang não vale nada! Nós ajudamos ele, mas ele ainda acha que seria bom se ele pudesse \"abrir o caminho\" para os outros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131608,
					"content": "Ele não poderia simplesmente valorizar mais sua vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131609,
					"content": "Todos possuem algo que buscam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "Ah, Paimon entende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131612,
					"content": "Mas Paimon ainda assim acha que eles deveriam ter um final feliz! Tipo voltar para Mondstadt, virar um aventureiro e depois... E depois ir para restaurantes, brincar com gatinhos e comer Frango Assado com Mel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131613,
					"content": "Por que eles não podiam ter um final feliz como esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131610,
					"content": "Bem, é apenas por conta de pessoas como ele existem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "Wolfgang nunca chegará à Espinha do Dragão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
		{
			"id": 7901318,
			"completionStepIds": [
				7901318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
