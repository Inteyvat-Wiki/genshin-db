			},
			"dialogs": [
				{
					"id": 790132401,
					"content": "Ei, parece que ele conseguiu sair de dentro da Câmara Secreta no final das contas! ...E ele... Colocou os créditos em seus olhos aguçados pela sua fuga!? Qual é, deixamos a pista em um lugar tão óbvio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132410,
					"content": "Além disso, quantos papéis essa pessoa está levando com ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132402,
					"content": "*Suspira* Ele não voltou depois de ter saído daquela câmara. Na verdade, ele quer continuar se aventurando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132403,
						790132404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132403,
					"content": "Porque ele conseguiu superar essa crise...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				},
				{
					"id": 790132405,
					"content": "Sim! Ele antes sempre ficou preso aqui nessa Câmara Secreta, mas agora ele mudou, e se tornou um obstáculo que ele facilmente consegue superar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132406,
					"content": "Entretanto, não há como ver as ruínas na montanha que ele falou dessa ilha no lago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132407,
					"content": "Acho que já se passou muito tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132408
					]
				},
				{
					"id": 790132408,
					"content": "Será que ela desabou e tudo caiu no mar? Paimon tem a impressão que viu algo parecido com alguns prédios na água...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132409,
					"content": "Vamos dar uma olhada quando tivermos tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132404,
					"content": "Porque ele conseguiu escapar da Câmara Secreta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132405
					]
				}
			]
		},
