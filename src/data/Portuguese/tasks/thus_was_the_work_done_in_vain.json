			"dialogs": [
				{
					"id": 790131101,
					"content": "A porta abriu! Que mecanismo problemático...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131102,
					"content": "#{NICKNAME}, aqui não parece ter nenhuma nota de Wolfgang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131103,
					"content": "Isso quer dizer que ele não veio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "Então vamos ajudá-lo a abrir essa Câmara Secreta... Assim ele não ficará trancado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131105,
					"content": "Se esse mecanismo puder ser ativado várias vezes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "Então o que faremos? Hã... Oh, Paimon já sabe! Vamos deixar uma mensagem para ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131108,
					"content": "Vamos fazer um entalhe para deixar uma mensagem em um lugar visível. Assim poderemos contar para ele uma maneira de resolver este mecanismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790131106,
					"content": "Mesmo que abra dessa vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
		{
			"id": 7901312,
			"completionStepIds": [
				7901315
