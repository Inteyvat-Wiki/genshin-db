					"nextDialogs": [
						790133502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133502,
					"content": "Vamos deixar algumas pistas para ele de como abrir a Câmara Secreta de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133503,
						790133504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133503,
					"content": "Essa solução...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				},
				{
					"id": 790133505,
					"content": "Oh, sim. Se Wolfgang não puder usar energia elemental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133506,
					"content": "Então a solução é inútil para ele. O que vamos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133507,
						790133508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133507,
					"content": "Que tal simplesmente fazermos com que ele nem entre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133509,
					"content": "Oh! Faz sentido! Só precisamos deixar alguma dica na entrada de que há uma Câmara Secreta aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133510,
					"content": "Assim ele não entrará e não ficará preso nela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790133511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133511,
					"content": "Vamos logo deixar uma mensagem para ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790133508,
					"content": "Vamos deixar uma mensagem na entrada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133509
					]
				},
				{
					"id": 790133504,
					"content": "Sem o uso de poderes elementais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790133505
					]
				}
			]
