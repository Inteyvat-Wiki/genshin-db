					"nextDialogs": [
						790132502,
						790132503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132502,
					"content": "Ele ficou preso nessa Câmara Secreta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				},
				{
					"id": 790132504,
					"content": "Acho que algumas pessoas precisam de algum castigo antes de aprenderem alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790132505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132505,
					"content": "#Essa ruína no fundo do mar... Deve ser daquela montanha da ilha ao lado que desabou... {NICKNAME}, vamos para o lago dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790132503,
					"content": "Parece que não aprendeu sua lição...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790132504
					]
				}
			]
		},
		{
