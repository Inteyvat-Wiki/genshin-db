			},
			"dialogs": [
				{
					"id": 790131201,
					"content": "Vamos deixar aqui, ele deve conseguir ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "Mensagens"
				},
				{
					"id": 790131202,
					"content": "Paimon espera que Wolfgang veja e que ele não acabe preso nessa Câmara Secreta de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "Mensagens"
				},
				{
					"id": 790131203,
					"content": "Vamos voltar e dar uma olhada! Talvez a nota desta vez tenha mudado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mensagens"
				}
			]
