			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "Oh, Rei dos Animais de Carga? Você está falando sobre o Animal de Carga gigante, correto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760502,
					"content": "Dois dias atrás eu estava indo para Liyue quando o vi perto do Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760503,
					"content": "Por sorte, ele estava tirando uma soneca. Me esgueirei ao redor dele consegui me safar. Ele era do tamanho de um morro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760504,
					"content": "Hmm... Onde eu o vi? Liyue fica ao sul daqui, então deve estar em algum lugar nessa direção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760505,
					"content": "As pessoas geralmente não viajam de Sumeru para Liyue pela água? Por que passar por perto do Despenhadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760506,
					"content": "Isso... é meio que pessoal. Não tem nada a ver com o que você, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760507,
					"content": "Bem, isso é tudo que sei, tenho outras coisas a fazer... então me deixe em paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najib"
				}
			]
		},
		{
