			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "De fato, só em Sumeru se pode realmente sentir a natureza. Em comparação, o ar em Fontaine é praticamente só fumaça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760102,
					"content": "O que foi? Posso te ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760103,
					"content": "Só por curiosidade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "Você mora nessa tenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760105,
					"content": "Isso, estou aqui tem muito tempo... haha eu entendo, é estranho ver alguém de Fontaine vivendo em uma tenda na natureza de Sumeru, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760106,
					"content": "Quanto ao porquê disso, deixe-me explicar ...ah, antes de mais nada, quais são os nomes de vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760107,
					"content": "Paimon se chama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760108,
					"content": "#Meu nome é {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#Então é isso, {NICKNAME} e Paimon, vou me lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760110,
					"content": "Eu sou Santon, como podem ver, sou de Fontaine e estou em Sumeru pela floresta, é claro! Eu amo florestas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760111,
					"content": "Se você viver na cidade por tempo demais, seu corpo enfraquece por falta de exercício, e a mente se torna fraca e cansada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760112,
					"content": "Somente na vasta natureza se pode recuperar esse profundo senso de harmonia. Esta floresta é o melhor lugar para se reconectar com a natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760113,
					"content": "É por isso que eu vim para Sumeru. Afinal, as melhores florestas de Teyvat estão aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760114,
					"content": "Paimon acha que entendeu, mas ainda está um pouco confusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760115,
					"content": "Mas com todos os tipos de monstros que habitam as florestas de Sumeru, elas podem ser bem perigosas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760116,
					"content": "E esse é o ponto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760117,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760118,
					"content": "Se não fosse perigoso, não teria uma sensação de sobrevivência! Não se preocupe, na verdade, sou um caçador famoso em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760119,
					"content": "Hã? Então o que você gosta mesmo é de caçar nas florestas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760120,
					"content": "Você é só um caçador de animais silvestres de Fontaine, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760121,
					"content": "Acho que devemos intervir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "Não, calma! Vocês confundiram as coisas. Eu não sou um caçador de animais silvestres! Caçar animais silvestres é um crime grave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760124,
					"content": "Se você for pego caçando animais silvestres em Fontaine, a sua vida acaba na hora! Eu nunca faria uma coisa dessas. Nós, caçadores de Fontaine, só lidamos com \"animais selvagens\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760125,
					"content": "Lidar com \"animais selvagens\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760126,
					"content": "Imagine só: quando os animais selvagens que se aproximam demais dos assentamentos humanos, isso pode causar problemas para ambos os lados... Então eles devem ser afastados de locais frequentados por seres humanos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760127,
					"content": "Então é isso que você faz...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760128,
					"content": "Dessa forma, os moradores próximos não serão perturbados pelos animais selvagens, e para esses animais, as atividades dos moradores não serão um incômodo para suas rotinas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760129,
					"content": "Para ser honesto, ouvi falar que havia animais selvagens na área e aceitei a missão de expulsá-los. Por isso eu moro aqui... Como caçador, como eu posso ficar parado sem fazer nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760130,
					"content": "...Claro, tenho um interesse pessoal nestes animais selvagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760131,
					"content": "Aqueles crocodilos gigantes são bem impressionantes, por exemplo. As crianças o conhecem como \"Rei Crocodilo\", parece um personagem direto de uma lenda urbana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760132,
					"content": "Dizem que ele pode ser encontrado em águas próximas daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760133,
					"content": "Existe também o \"Caracal Raja\", que tenta roubar crianças e o enorme Animal de Carga bloqueando a passagem para Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760134,
					"content": "O Caracal Raja parece estar na selva a oeste daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760135,
					"content": "O Rei dos Animais de Carga... Ah, esse é o enorme Animal de Carga, por sinal. Também foi visto por algumas testemunhas assustadas que alegam que ele assombra o leste e ataca quem estiver à vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760136,
					"content": "Tudo isso parece muito perigoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760137,
					"content": "Sim, tenha cuidado se você se deparar com eles... Bem, de alguma forma eu posso sentir aquele ar de caçador experiente vindo de vocês, então talvez as minhas preocupações sejam desnecessárias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760138,
					"content": "Se você encontrar algum deles, por favor expulse estas criaturas selvagens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760139,
					"content": "Isso deve manter as pessoas daqui seguras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760140,
					"content": "Claro, se encontrarmos eles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "Serei muito agradecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760142,
					"content": "Para a segurança das pessoas, dos animais selvagens e é claro, para sua própria segurança, tenha cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760143,
					"content": "Sim, pode deixar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760122,
					"content": "A caça dos animais silvestres destrói o ecossistema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
