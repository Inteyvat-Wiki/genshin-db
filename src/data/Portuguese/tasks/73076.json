			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anaya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "Hã, sobre o \"Rei dos Animais de Carga\"? Eu o vi quando estava na floresta noutra noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760602,
					"content": "Era uma noite nublada. Estava caminhando quando vi uma sombra do tamanho de uma colina correndo na minha direção, com um som estrondoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760603,
					"content": "Eu desmaiei e só acordei no dia seguinte. O cara que me carregou de volta disse que perdi a consciência no sopé da montanha. Felizmente não fiquei gravemente ferido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760604,
					"content": "Quanto ao local... Eu não tenho certeza, mas deve ter sido no leste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anaya"
				}
			]
		},
		{
			"id": 7307607,
			"completionStepIds": [
				7307607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307607",
							"2"
						],
						"stepId": 7307607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "Você afastou as criaturas selvagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760702,
					"content": "Eu ainda não vi nenhuma delas. E aí, as criaturas eram mesmo muito selvagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760703,
					"content": "Não eram tão intimidadoras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "Parece que você poderia ter feito isso de olhos fechados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760707,
					"content": "Embora eu esteja aliviado ao saber que os animais se foram, me sinto mal por perder a oportunidade de vê-los pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760708,
					"content": "Não é raro ver animais se rendendo a outros animais mais fortes na natureza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760709,
					"content": "Hahaha, se houver uma próxima vez, não vou ficar para trás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760710,
					"content": "Nós também não vamos perder!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "É isso aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760712,
					"content": "Espera, \"controle de animais selvagens\" não deveria ser o dever de um Guarda-Florestal aqui em Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760713,
					"content": "Ah, eu não disse isso antes? Eu recebi a Comissão... de um Guarda-Florestal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760714,
					"content": "Alguns problemas recentes com o Definhamento parecem ter mobilizado muita mão de obra, mas eu não sei mais detalhes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760715,
					"content": "Então, me foi confiado o serviço de \"Controle de Animais Selvagens\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760716,
					"content": "Então foi isso que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760717,
					"content": "De qualquer maneira, muito obrigado pela ajuda! Aqui está a sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760705,
					"content": "Eram mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "É mesmo? Como eu queria ter visto com os meus próprios olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				}
			]
		},
