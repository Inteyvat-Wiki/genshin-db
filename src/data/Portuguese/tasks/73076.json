			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "Você encontrou algum dos animais ferozes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760302,
					"content": "Se você encontrar um, por favor, ajude a se livrar dos animais ferozes. Seria é uma coisa boa tanto para os residentes quanto para os animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760303,
					"content": "Sobre o Rei Crocodilo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "Dizem que o Rei Crocodilo está nas águas no lado leste da cidade, mas já conferi várias vezes e nunca vi a fera astuta",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760305,
					"content": "Sobre o Caracal Raja...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "Parece que a história do Caracal Raja contada por aqui é que ele sai da floresta no oeste à meia-noite para capturar crianças levadas que não querem dormir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760307,
					"content": "Embora esta última seja provavelmente uma forma de os pais assustarem seus filhos, o Caracal é de fato mais ativo à noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760308,
					"content": "Há rumores que pessoas viajando durante à noite foram perseguidas pelo Caracal, apesar de que felizmente, não houve nenhuma morte até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760309,
					"content": "Sobre o Rei dos Animais de Carga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "Ouvi dizer que alguns Animais de Carga têm um forte senso de território atacam invasores sem pensar duas vezes. Tenho certeza que o mesmo se aplica ao Rei dos Animais de Carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760311,
					"content": "Seu território está em algum lugar a leste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760312,
					"content": "Fico imaginando o tamanho que o Rei dos Animais de Carga deve ter para ganhar o título de rei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760313,
					"content": "Ainda estamos investigando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "Bem, vamos seguir fazendo um bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				}
			]
		},
