			"dialogs": [
				{
					"id": 730761001,
					"content": "\"Sobre os avistamentos recentes de um enorme Caracal:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "Um Aviso"
				},
				{
					"id": 730761002,
					"content": "\"Por favor, não fique do lado de fora depois do anoitecer. Esse é o momento que o Caracal sai e fica ativo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "Um Aviso"
				},
				{
					"id": 730761003,
					"content": "\"Por favor, não deixe qualquer carne nas proximidades. Alimentar o Caracal e mantê-lo cheio não é a maneira correta de se manter seguro. Pelo contrário, pode induzir o Caracal a ficar pelas redondezas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Um Aviso"
				}
			]
		}
	]
