			},
			"dialogs": [
				{
					"id": 730760401,
					"content": "O \"Rei dos Animais de Carga\"? Isso foi alguns dias atrás. Eu estava procurando por alguns minérios especiais e de alguma forma, acabei viajando até para fora da montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760402,
					"content": "E lá estava o Rei dos Animais de Carga. Pelos Arcontes, era enorme. Nunca vi algo tão grande em minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760403,
					"content": "Ele me atacou assim que me viu. Felizmente consegui ser rápido o suficiente para fugir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760404,
					"content": "Que lado da montanha? Pode ter sido o oeste. Eu não me lembro bem, mas deve ter sido o oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hong"
				}
			]
		},
		{
			"id": 7307605,
