			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "Obrigada. Estas flores doces devem ser suficientes. Vou fazer as flores secas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270302,
					"content": "Ah sim, eu tenho um presente para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270303,
					"content": "Aqui, por favor, pegue esta flor seca. Embora esteja um pouco murcha, é uma flor muito valiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270304,
					"content": "#Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "Esta é a primeira flor que desabrocha neste mar de flores. Você me ajudou a encontrar as sementes da flor, então eu gostaria de lhe dar esta flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270308,
					"content": "Embora não seja nada muito valioso, mas mesmo assim... muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270309,
					"content": "Tenho certeza que todos voltarão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "Sim! Portanto, preciso plantar mais flores para que, quando todos voltarem, possam ver mais flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270305,
					"content": "Tem algo de especial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "É claro que há algo de especial nisso, se não eu não daria especialmente a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		}
	]
