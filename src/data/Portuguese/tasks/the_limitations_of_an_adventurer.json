			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "O que fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "É que... Minha filha Ellin está decidida a se juntar aos Cavaleiros de Favonius. Ela está treinando para os testes agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "*Suspiro* Eu realmente esperava ajudar a orientá-la, mas ela simplesmente não acredita em mim quando digo que costumava ser aventureiro. Ela só pensa treinar sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Não tem jeito para comprovar a ela. Depois de se casar e ter filhos, seria egoísta de fazer algo perigoso como uma aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "Minha responsabilidade de cuidar da minha família tem maior prioridade sobre o impulso do ego que eu teria ao partir em uma aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Ainda sou um aventureiro de coração, e certamente ainda sei alguma coisa sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Uma vez, quando estava em uma aventura, reparei nesses bonecos de madeira que os Hilichurls usam para treinamento de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Eles parecem bastante resistentes, tenho certeza de que também seriam ótimos para Ellin treinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Você poderia pegar alguns Bonecos de Madeira para mim? Obviamente, eu respeito o código dos aventureiros e não faria você fazer isso gratuitamente. Que tal isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Esse é o espírito! Ah, eu era como você quando entrei para o Clã, pronto para qualquer coisa! E quando digo qualquer coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Eu estava brincando. Ok, agora vai, rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "São só Hilichurls, você consegue lidar com eles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Eu realmente não consigo. Até mesmo os aventureiros possuem suas limitações. Apenas é possível lidar com uma aventura de cada vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "E a aventura que é a vida de casada é mais do que suficiente para lidar sozinha, não ligo para quem você é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Então, recolher os manequins de madeira vai ficar para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
