				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "Qual seria a melhor forma de treinar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Estou praticando para os testes dos Cavaleiros de Favonius, mas eu simplesmente não consigo entender e não tenho ninguém para me ensinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Meu pai sempre se ofereceu para ser o meu mentor. Ele dizia que era um aventureiro... Sim, isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "É impossível que, alguém como o meu pai, pode me ajudar a entrar nos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620506,
					"content": "Então ele disse que ia me arranjar algum tipo de equipamento de treinamento. Não consigo imaginar o que ele tem em mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
