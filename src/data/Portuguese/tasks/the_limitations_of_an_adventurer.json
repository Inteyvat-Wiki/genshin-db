			"dialogs": [
				{
					"id": 200620601,
					"content": "Uau, este manequim de madeira é realmente muito bom. Isso vai deixar o treinamento muito mais fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620602,
					"content": "Não sei dizer de onde diabos meu pai conseguiu um boneco de treinamento tão resistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620603,
					"content": "Tem certeza de que ele não pode ter comprado? Isso deve ter custado caro...",
