			"dialogs": [
				{
					"id": 200620301,
					"content": "Você encontrou alguns manequins de madeira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Sim, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Haha... Parece que você coloca muita força nisso. Eu não sei como você conseguiu quebrar uma engenhoca de madeira tão resistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Penso que ninguém vai afrouxar seus golpes em combate por causa de um manequim de madeira só...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "Não posso dar à Ellin agora... Mas já temos materiais suficientes, vai ficar muito bom só com um pouco de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Depois de muito trabalho, está como novo! Não está mal, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "Tudo graças a você, em última análise. Aqui está o seu pagamento. Como prometido, não aceito favores de graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Você pode deixar de ser um aventureiro, mas não pode deixar de respeitar o código!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
