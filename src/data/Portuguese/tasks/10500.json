				{
					"id": 105000328,
					"content": "Aaaaaaah—! Shhhhahahahaha! Isso não aconteceu! Esqueça isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000329,
					"content": "#...Hmph! Bem, de repente eu sinto que você de fato contribuiu para nossa boa fortuna. Eu digo que nós deveríamos gastar este dinheiro para tratá-l{M#o}{F#a} com uma boa refeição!",
