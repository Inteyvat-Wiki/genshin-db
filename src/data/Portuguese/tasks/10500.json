						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000902,
					"content": "Já faz um bom tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000903,
					"content": "É a Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000901,
					"content": "Minha capacidade de ver através de seus segredos tão facilmente não evoca nenhuma lembrança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000902,
						105000903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000904,
					"content": "Ah! A Paimon se lembra! Você é a astróloga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000905,
					"content": "Isso! Sou eu, Astrologist Mona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000906,
					"content": "Desta vez, gostaria que viessem comigo a Mondstadt para recuperar uma caixa que pertence a minha mestra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Foi parte de um acordo que ela fez com uma amiga há 50 anos. Mas ela não é tão ágil quanto costumava ser, por isso agora depende de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Não tenho certeza do que pegar uma caixa de volta tem a ver conosco. Por que você precisa que a gente acompanhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Bem... O motivo é que eu também gostaria de enfrentar o guardião da caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000911,
					"content": "Então, você quer provar a si mesmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000912
					]
				},
				{
					"id": 105000913,
					"content": "Então, basicamente você quer aparecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000914
					]
				},
				{
					"id": 105000112,
					"content": "Minha mestra e sua amiga lutaram nas artes místicas durante toda a vida sem um claro vencedor. Se eu triunfar aqui, então eu me mostrarei superior à minha mestra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000114,
					"content": "*Cof* Bem, eu quero provar o poder e o prestígio da astrologia, para ser mais precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000116,
					"content": "O que você está dizendo? Só queria aproveitar esta oportunidade para provar o poder e o prestígio da astrologia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Agora, pelas minhas previsões, sei que a amiga da minha mestra deixou Mondstadt, deixando seu sucessor como o atual guardião daquela caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Como eu, esse sucessor também deve ser aquele que superou sua professora. Eu não posso ser descuidada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000918,
					"content": "Mas... Eu não faço ideia de como a astrologia funciona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000919
					]
				},
				{
					"id": 105000920,
					"content": "Como você acabou pensando em mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000921
					]
				},
				{
					"id": 105000119,
					"content": "Mas prefiro assegurar minha vitória neste desafio, e ao pensar um pouco, você veio à mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000121,
					"content": "#Como {M#o}{F#a} {NICKNAME} acabou sendo envolvid{M#o}{F#a} nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "O conhecimento que me foi transmitido por minha mestra deve ser por sua vez, transmitido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "#Se eu trouxesse {M#o meu}{F#a minha} discípul{M#o}{F#a}, então a liderança já é minha, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000924,
					"content": "Eu me recuso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000925,
					"content": "#Desde quando eu me tornei {M#seu}{F#sua} aprendiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000125,
					"content": "#E você é {M#o}{F#a} {M#herói}{F#heroína} de Mondstadt, meu igual em status. Então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000128,
					"content": "#Vamos lá, você não precisa se tornar {F#minha}{M#meu} discípul{F#a}{M#o} de verdade. Só precisa fingir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "Tem algo para você também, se você vier comigo para pegar aquela caixa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Uma vez que eu encontre aquele sucessor e tenha a oportunidade de trocar conhecimentos com ele, eu deveria ser capaz de ler seu destino com mais precisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Então, eu terei respostas para você, mesmo em relação a assuntos tão distantes e nebulosos como deuses e semelhantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000133,
					"content": "Parecem ser condições boas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000134,
					"content": "Bem... Acho que vamos entrar na brincadeira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000132,
					"content": "Isso parece muito mais rápido do que procurar pela terra, país por país!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000135,
					"content": "Hehe. sábia decisão! Então, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Dito isto, eu gostaria de fazer uma visita a um determinado lugar antes de irmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		}
	]
