					"content": "Não é preciso me agradecer, só estou fazendo o que uma boa mestra deveria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000332
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000332,
					"content": "Ela disse que estava nos convidando para um jantar!? Paimon está ouvindo coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000333,
						105000335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000333,
					"content": "\"Vamos atrás dela\". Pronto. Eu disse por você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000334
					]
				},
				{
					"id": 105000334,
					"content": "Vamos atrás dela! Pela boa comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000335,
					"content": "\"Ela é muito simpática\", já disse por você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000336
					]
				},
				{
					"id": 105000336,
					"content": "Ela é muito simpática! Hehe. Vou comer coisas boas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000321,
					"content": "#Eu nunca disse que ia ser {M#o seu}{F#a sua} discípul{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000322
					]
				},
				{
					"id": 105000322,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000323
					],
					"speakerTitle": "Paimon"
				},
				{
