					"nextDialogs": [
						105000330
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000330,
					"content": "Se viajarmos para o norte, <color=#00E1FFFF>Albergue Wangshu</color>. Ouvi dizer que a comida lá é muito boa, então vamos experimentá-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000331
					],
					"speakerTitle": "Mona"
				},
