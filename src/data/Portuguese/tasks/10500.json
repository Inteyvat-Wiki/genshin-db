					"nextDialogs": [
						105000327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000327,
					"content": "Ah, certo, você não deve ter comido nada há dias. Lamento muito, esqueci que você não tem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000328
					],
					"speakerTitle": "Sr. Zhu"
