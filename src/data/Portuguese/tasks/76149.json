			"dialogs": [
				{
					"id": 761490101,
					"content": "Quem!? Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}. Alguém que pertence a esta era.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Embora eu nada saiba sobre o seu tempo, meu nome é Alara. Eu já fui um Asceta da Era do Silêncio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "Já não me lembro de quanto tempo se passou desde que vim para cá. Até mesmo este lugar quebrou meu cultivo silencioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "Então é verdade... cultivar uma mente sem pensamento ou desejo leva alguém a reencarnar no Céu Irrefletido do Mal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "Não foi nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "Não precisa me agradecer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "Ah! Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Salvar você foi mais uma coisa do calor do momento. Dito isso, estamos planejando procurar uma saída que não seja meditação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "Você não tem prática em meditação? Ou simplesmente não se ensina isso na sua era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "Na primeira vez que deixei este lugar, levei centenas de anos. Eu desisti da minha busca pela verdade... e do meu desejo de ver meus entes queridos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "Desta vez, não estou disposto a abrir mão dessas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "Conte comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490115,
					"content": "Dex pegou outro Fragmentos do Pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "Pesar? Ah, você tá falando da técnica de meditação Maranasati. Eu a conheço e seu uso no cultivo do estado mental perante a morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Agora que Zeitlind foi encontrada, vamos tentar achar uma saída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "Tem certeza de que conseguimos sair daqui sozinhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Melanta e Nihilita podem se mover livremente neste espaço, e geralmente trazem pessoas junto. Nesse caso, Dex deve conseguir fazer o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490121,
					"content": "Três Fragmentos do Pesar coletados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Ah, embora eu deva dizer que é um nome temporário, já que eu também não faço ideia do que Dex vai usar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "E agora, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490125,
					"content": "Vamos seguir a direção indicada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
