				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Onde Omid e Mirsad estão? Será que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Não se preocupe, eles estão bem. É só que... eles têm outros planos, por isso não vão continuar trabalhando em nosso negócio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Hã? Como assim? Não temos como trabalhar somente com duas pessoas... precisamos contratar mais! Mas quem iria querer vir para a Vila Aaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Esqueça, vamos falar sobre isso depois. Enfim, Cyrus voltou em segurança. Pelo menos isso é algo que dá para ficar feliz, não é? Nunca mais vou deixar ele ir para um lugar tão perigoso novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "O que você está dizendo? Nós somos comerciantes de Animais de Carga, se não colocarmos eles para trabalhar, não teremos o que comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Comer vento não enche a barriga, além disso, experimente abrir a boca num lugar desse, ela vai ficar cheia de areia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Mesmo assim, Cyrus não pode se arriscar. Você me parece bem forte, você pode puxar a carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nachtigal"
				}
			]
		}
