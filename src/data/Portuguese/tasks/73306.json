					"Tirzad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "... São vocês, há algo mais que vocês queiram falar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Quanto ao Jebrael.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "... Eu desconfiei dele até o fim, eu sou um idiota mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Agora eu só sinto gratidão por ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Antes eu hesitava, tanto academicamente quanto na vida... Mas a partir de hoje eu não vou mais hesitar, eu vou trilhar o caminho que eu acredito, não importa quão difícil seja...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Nem que seja pelo Jebrael...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Sobre o Rei Deshret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "No começo eu desconfiei que os textos que li talvez não fossem confiáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "Aquela \"oração\"... Era estranha, de um jeito que não sei explicar, e também tem aquilo que Samail falou... Eu preciso voltar para estudar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Claro, o maior objetivo ainda é escrever minha tese, conforme o plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Sobre a Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "*Suspiro*... Eu gostaria de poder fazer algo por ela. Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Não tem nada que eu possa fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "E ela se recusa a dizer qualquer coisa. Se ela apenas falasse seu desejo, eu estaria disposto a fazer qualquer coisa ao meu alcance para ajudá-la...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
