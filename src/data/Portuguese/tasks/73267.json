				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "#Junte-se aos Eremitas! Abra seus braços para uma ótima vida! Ei, amig{F#a}{M#o}, está interessad{F#a}{M#o} em saber mais sobre os Eremitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Err...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Ahem! Deixe eu contar mais para você sobre a organização. Os Eremitas são um bom lugar para se ficar. Liberdade! Unidade! Amizade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "Além disso, nós conseguimos tirar dinheiro das carteiras daqueles caras que moram no topo da árvore. Os pesquisadores da Academia são ricos, e nunca atrasam seus pagamentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Eu já faço parte da Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Hã... A Guilda de Aventureiros? Oh, então não vou mais tomar do seu tempo! Hoje em dia, quem é que não faz mais de um trampo? E para mim, sabe, mercenários e aventureiros são quase a mesma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Há uma diferença enorme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "*Suspiro* A nossa comida também é muito boa, quase todo dia temos peixe e carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "Além disso, caso você tenha sorte, poderá até mesmo falar com Dehya, a Juba Flamejante! Eu.... Ahem... *COF*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Hidrate-se...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "Uff... Fiu... Me desculpe, eu acabei ficando nervoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "Você tem ideia do quanto é difícil conseguir alguém que queira me escutar? Eu fiquei emocionado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "Mas, você realmente não está pensando em se juntar aos Eremitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "Por enquanto não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "Bem, já que você está dizendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "Você fica aqui o tempo inteiro recrutando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Sim. Esse é meu trabalho. Este ano, todos estão com falta de pessoal, e para nós, mercenários, é ainda pior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "*Suspiro*. Mas isso não tem nada a ver com você. Você vê que há muitos de nós, Eremitas, por aí... Mas ser um mercenário é perigoso, escoltar caravanas até que é bom, só é cansativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Mas se tivermos que acompanhar um pesquisador, temos que ficar sempre com nossa mão na cintura e cabeça atenta para arriscarmos nossa vida, e se não perdermos um braço ou perna, temos que agradecer aos deuses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "Quando meus companheiros que costumam fazer esse tipo de trabalho terminam ele e voltam, precisam descansar uns dez ou quinze dias, e durante esse tempo alguém tem que compensar no lugar deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Sumeru é muito grande, e está cheia de pesquisadores. Todos os dias sempre há vidas novas entrando por aqui, nós quase nunca temos uma folga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "Se não recrutarmos mais ninguém, não aguentaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "Você recrutou alguém?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "Você está falando desta vila daqui? Haha! Nem uma pessoa sequer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Hã... Bem, não posso dizer que não recrutei, mas, as pessoas que eu queria recrutar não queriam vir, e as pessoas que queriam vir eu não queria recrutar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "Ei, se você não acredita em mim, que tal dar uma volta comigo? Talvez depois dela queira se juntar a nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "... Ah, qual é, eu só estou tirando com a sua cara! Você disse que não queria entrar, eu não vou te forçar. Eu só estou procurando por alguém para caminhar comigo, só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "Eu posso ir com você, sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Hehe, muito obrigado. Deixe-me ver... Vamos procurar Sania primeiro. Ela normalmente está livre durante o dia, mas à noite... Bem, ela geralmente está ocupada tendo discussões importantes com Jabari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "Os problemas da Guilda de Aventureiros já são de além da conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Você é bom de lábia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "Tenho muitas Comissões para fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
			"id": 7326703,
			"completionStepIds": [
				7326703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326703",
