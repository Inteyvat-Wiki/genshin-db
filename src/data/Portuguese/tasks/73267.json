	"talks": [
		{
			"id": 7326701,
			"completionStepIds": [
				7326701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326701",
							"2"
						],
						"stepId": 7326701,
						"stateName": "QUEST_STATE_UNFINISHED"
