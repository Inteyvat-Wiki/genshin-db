			"dialogs": [
				{
					"id": 732671001,
					"content": "*Choro* Aqueles escorpiões... eles são muito grandes, não quero chegar perto deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Eu vi que acertei as flechas neles, por que não aconteceu nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "Mas como você derrotou eles com tanta facilidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "Eu treinei muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "*Choro* Mas a tia Candace disse que eu tive muito progresso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Karima, não fique triste. Só é possível fazer um pouco de progresso todo dia, mas um dia você será muito forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Ayten, você também. Continue treinando que entrar para os Eremitas será só uma questão de tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Hmm, se eu pedisse para Dehya me ensinar artes marciais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "Na próxima vez que você ver Candace, por favor peça para ela me treinar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "Oh, essas crianças... É isso que chamo de entusiasmo, hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "Então é por isso que você ainda não recrutou ninguém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "*COF* Ahem! Então, acho que algumas coisas não precisam ser mencionadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "Vamos falar sobre isso do trabalho depois... Além disso, não é como se minha propaganda não fosse eficaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Depois de ouvirem minha propaganda, muitos jovens da vila querem sair dela para explorar... mas eles não querem entrar nos Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Enfim, não é hora de falar disso. Eu preciso levar essas crianças de volta para a vila. Já ficamos muito tempo fora, os pais delas devem estar nervosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "Aqui está sua recompensa. Obrigado por me ajudar, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "*Suspiro* Acho que é melhor eu voltar para os Eremitas e relatar meu progresso... como vou explicar isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Ei, tio Atiyah, você ainda não testou a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "Hã? Oh, sim, sim, vamos voltar primeiro. Testarei vocês quando chegarmos na vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "E agora? E o seu trabalho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
					"content": "Vocês ainda são muito pequenas.",
					"roleType": "TALK_ROLE_PLAYER",
