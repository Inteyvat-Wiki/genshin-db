						],
						"stepId": 7326703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sania",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "É realmente preocupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "Sania! Bom dia! O que você está escolhendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Atiyah, eu já disse! Jabari não está interessado nos Eremitas, e eu também não quero que ele vá virar um mercenário, não me peça para ajudar você com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Ah, qual é, Jabari é um cozinheiro fantástico, se ele entrasse nos Eremitas, encontraria um cargo alto. E a renda de vocês também aumentaria bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "Além disso, ele também não disse que queria sair mais para ganhar a vida? Se ele quer sair mais para trabalhar, ter um conhecido como eu para introduzir ele seria ótimo, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "Não dê ouvidos a ele. Ele sempre fala algo assim de vez em quando, depois de alguns dias vai falar de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "Enfim, ele só não quer me deixar sozinha na vila... E eu também não quero deixar ele ir sozinho para ganhar a vida lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "E quer saber mais? Vocês são todos mercenários que brincam com suas vidas todos os dias! Nem pense nisso, mesmo que Jabari queira ir, eu vou impedir ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Já chega, basta! Eu tenho que comprar algumas coisas, vá procurar outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "Urgh... Está bem. Viajante, você viu? Essa é a situação do meu ganha-pão diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Bem, vamos agora procurar por Fadilo, ele... ele antes era um dos nossos, mas depois saiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Se você pudesse convencê-lo a volta, seria perfeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fadilo",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah, o que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670502,
					"content": "Hehe! Você devia saber que persistência é uma qualidade dos Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "Então você também deve saber que eu persisto em meus princípios ainda mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670504,
					"content": "Oh, companheiro Fadilo, qual é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Eu saí dos Eremitas, não me chame assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670506,
					"content": "*Suspiro* Sr. Fadilo, você realmente não reconsideraria retornar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "Embora o estilo de alguns de nossos companheiros seja um pouco... hã... imprudente, muitos deles respeitam a ordem e a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Atiyah, eu já disse: eu não vou voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670509,
					"content": "Eu vi com meus próprios olhos essas coisas que você falou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670510,
					"content": "Talvez não sejam todos os Eremitas que não respeitam a lei, e também não sejam todos os Eremitas que aproveitam para depois da queda darem um coice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670511,
					"content": "Mas más ações se espalham, Atiyah. Tudo que precisa é que uma pessoa aja como se a lei fosse uma mera sugestão, e todos são afetados por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670522,
					"content": "Uma pessoa influencia outra, e essa outra, assim vão sempre influenciar mais pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670523,
					"content": "Tenho certeza que você sabe melhor do que eu o que isso significa, Atiyah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670512,
					"content": "É por isso, Atiyah, que o mal se espalha em um ambiente como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Você quer me convencer a voltar, mas eu quero convencer você a sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670515,
					"content": "Talvez, para você, os Eremitas não tenham moral, mas também não são maus... Entenda, as pessoas não podem viver para sempre numa zona cinza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670516,
					"content": "... Esse é o meu sincero conselho para você. Cabe a você decidir o que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670517,
					"content": "Oh, entendi, meu companheiro Fadilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "Tudo bem. Se você quiser sair... E também pensar em como ganhar a vida, lhe ajudarei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fadilo"
				},
				{
					"id": 732670519,
					"content": "Você está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Hahaha, realmente não tenho como argumentar com você, Fadilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "E agora... haha, vamos descansar um pouco. Já falamos muito, minha garganta está doendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326706,
			"completionStepIds": [
				7326706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326706",
