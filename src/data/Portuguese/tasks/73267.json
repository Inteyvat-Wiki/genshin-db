				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670802,
					"content": "#Uau, {F#ela}{M#ele} é tão rápid{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670803,
					"content": "Muito bem! Ótima velocidade, e sua corrida é firme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670804,
					"content": "Ayten, Karima, espero que tenham prestado atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670805,
					"content": "Quando encontrarem uma situação perigosa, não tentem se exibir. Quando for hora de correr, corram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670806,
					"content": "Especialmente você, Ayten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670807,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670808,
					"content": "Bom. Vamos seguir para o próximo passo... É hora de uma demonstração de combate ao vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670809,
					"content": "Uhul! Papai me deu uma espada afiada de madeira, estou levando ela comigo. E você, Karima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670810,
					"content": "Eu tenho um arco pequeno aqui, mas a minha mãe me deu flechas sem ponta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670811,
					"content": "Hahaha! Tudo bem, vocês têm uma espada e um arco, e também estão cheios de coragem, isso é suficiente para vocês pisarem no caminho da aventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670812,
					"content": "#Mas lembrem-se de não saírem correndo por aí quando estivermos fora da vila, fiquem o tempo inteiro ao meu lado e d{F#a}{M#o} Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670813,
					"content": "Você realmente quer levá-las?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "... Relaxe, eu já passei por esse lugar antes, tem só alguns escorpiões doentes praticamente inofensivos, não haverá problema nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670816,
					"content": "Além disso, nós não estaremos por lá também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670817,
					"content": "Você me incluiu na contagem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "... Veja bem, nós já chegamos até aqui, pessoas boas fazem as coisas até o fim, Viajante. Eu pagarei você de acordo com as regras dos Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670820,
					"content": "Então, pessoal, se estiverem prontos, vamos partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670821,
					"content": "Urrul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670822,
					"content": "Hã, estou um pouco nervosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670818,
					"content": "Eu disse que iria?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "Levar duas crianças...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
