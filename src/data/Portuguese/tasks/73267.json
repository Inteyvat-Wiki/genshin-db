			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Atiyah",
					"Karima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Tio Atiyah! Você ainda está recrutando para os Eremitas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670602,
					"content": "Ayten, o que você está fazendo aqui? Você disse para sua mãe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670603,
					"content": "Eu contei para ela! Mamãe está trabalhando, eu vim procurar Karima para brincar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670604,
					"content": "Olá, tio Atiyah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670605,
					"content": "Tio Atiyah, o que você acha daquilo que falei com você na última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670606,
					"content": "Eu estive treinando muito com Karima... Estou quase mais rápido que ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670607,
					"content": "Ei, quem é que corre mais rápido do que eu? Naquele dia, eu só não fiquei na frente porque não comi o bastante no almoço naquele dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670608,
					"content": "Enfim, eu treinei bastante naquele plano que você fez para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670609,
					"content": "Tio Atiyah, você poderia me testar de novo hoje? Quero ver se sou capaz de entrar nos Eremitas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670610,
					"content": "Então era sobre isso que você estava falando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Ahem! Tudo certo, Ayten. Como membro dos Eremitas, eu conduzirei o teste mais uma vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670613,
					"content": "Uhul! Karima, venha! Vamos dar nosso melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670614,
					"content": "Eu não quero entrar para os Eremitas, só quero ficar dentro da vila e proteger todo mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670615,
					"content": "Mas... se o tio Atiyah puder me testar, será ótimo, eu pedi para Candace me ensinar alguns truques!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670616,
					"content": "Hã? Quando você...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670617,
					"content": "Hahaha, vocês são cheios de energia, ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670618,
					"content": "Ayten, não fique com vergonha. Se tiver uma chance, vou levar você comigo para pedir que Dehya nos ensine alguns golpes, o que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670619,
					"content": "Sério?! Você faria isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670620,
					"content": "As palavras de um membro dos Eremitas valem ouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670621,
					"content": "#Mas, antes que comecemos o nosso teste de hoje, gostaria que {F#a}{M#o} Viajante demonstrasse os movimentos padrões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670622,
					"content": "Como isso sobrou para mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "... Eu nunca tive antes a chance de fazer uma demonstração. Eu não posso sair por aí fazendo uma e deixar essas duas crianças aqui sozinhas, isso é muito perigoso... Estou contando com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670626,
					"content": "#*Ahem* enfim, nosso Viajante aqui é um{F#a} aventureir{M#o}{F#a} muito capaz. Eu tive que fazer muito para fazer el{M#e}{F#a} vir e fazer a demonstração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670627,
					"content": "Ayten, Karima, prestem bastante atenção!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670628,
					"content": "Certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670629,
					"content": "#Aventureir{F#a}{M#o}... tipo da Guilda de Aventureiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670630,
					"content": "Não importa se você é um mercenário ou um guarda, todos se deparam com situações em suas missões em que precisam se afastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670631,
					"content": "E nessas horas, o que precisamos é correr o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670632,
					"content": "Obrigado, Viajante. Agora, deixe-nos demonstrar... Como fazer uma retirada veloz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670633,
					"content": "O ponto de partida está ali, por favor, faça sua demonstração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670624,
					"content": "Você nunca fez uma demonstração?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "Ah, vamos lá, eu pareço alguém que tem tempo para demonstrações entre meu trabalho e cuidar dessas crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670634,
					"content": "Conto contigo, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670611,
					"content": "Sobre a pessoa que queria entrar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
		{
			"id": 7326708,
			"completionStepIds": [
				7326708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
