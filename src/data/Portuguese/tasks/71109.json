					}
				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "Eita, quem diria que um segredo tão grande poderia tá escondido nesse Pavilhão acabado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Honestamente, eu também não esperava.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Além disso, Paimon não acha que Huang, o Terceiro sabia deste lugar também... Espera, isso poderia ser mesmo a \"Câmara do Tesouro de Guhua\" de verdade, registrada nas lendas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#E também, {NICKNAME}, olha ali! Paimon tá vendo alguma coisa brilhando naquela plataforma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Deve ser tesouro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Enfim, vamos conferir imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Será que é um... mecanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Talvez seja por isso que dizem para não julgar um livro pela capa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "\"Os céus são traiçoeiros, e aqueles que procuram uma audiência são raros. O destino é imprevisível, e aqueles que conseguem avançar sem falhar são poucos... Aqueles que levantam seus olhos para o céu muitas vezes não são vistos no final de seus caminhos...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Inscrições Entalhadas"
				},
				{
					"id": 711090502,
					"content": "\"...Esse monumento foi deixado para perguntar essa única pergunta. Quando você chegar ao final de sua jornada, o que você fará?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Inscrições Entalhadas"
				},
				{
					"id": 711090503,
					"content": "(Tocar na Placa de Pedra.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Sair.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
			"completionStepIds": [
				7110906
