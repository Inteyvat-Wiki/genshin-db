					{
						"sceneId": 3,
						"position": [
							2250.204,
							346.642,
							2187.956
						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Hã? Parece que tem alguma coisa escrita na espada. Deixa a Paimon dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"...Acariciando a lâmina, cantando vou, abater dragões e beber do sangue deles. A luz divina, como um raio, como uma onda frígida, ameaça destruir as montanhas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Inscrições do Antigo Espadachim"
				},
				{
					"id": 711090603,
					"content": "\"...Sob a Montanha Tianheng, assassino tigres, empalo a fera de escamas entre o Mar de Nuvens... Quando retornar coroado pelo sucesso, viveremos tranquilamente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Inscrições do Antigo Espadachim"
				},
				{
					"id": 711090604,
					"content": "Também tem uma Placa de Pedra ao lado dela... Hã? A caligrafia abaixo parece ser diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"...Originalmente, eu queria deixar algumas iguarias aqui. Mas a comida inevitavelmente estragaria ao longo do tempo, então deixei as receitas aqui para você cozinhar em vez disso. Eu garanto que serão realmente deliciosas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Entalhe Antigo"
				},
				{
					"id": 711090606,
					"content": "\"...Além disso, nada mais resta. Apenas esta espada e a bela paisagem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Entalhe Antigo"
				},
				{
					"id": 711090607,
					"content": "\"...Quando nos deparamos com um beco sem saída, o que devemos fazer? Você já sabe a resposta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Entalhe Antigo"
				},
				{
					"id": 711090608,
					"content": "\"...Não tome... tesouro, deixando apenas um... doravante...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Entalhe Torto"
				},
				{
					"id": 711090609,
					"content": "\"Examine-me... quando estiver em desespero...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Entalhe Torto"
				},
				{
					"id": 711090610,
					"content": "Uau... Essas linhas aqui estão tão ilegíveis que Paimon não consegue entender nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Eles significam mais ou menos que ele não levou nada consigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "*Snif* Depois de tudo isso, não encontramos nenhum tesouro valioso. Toda essa esperança para nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Paimon nunca imaginou que conseguiríamos ver uma paisagem assim em um aperto desses... Nada mal, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Tudo bem. Eu vou fazer algo para você comer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Hã? Sério!? Então está decidido, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Eu também não entendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
			"id": 7110925,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
