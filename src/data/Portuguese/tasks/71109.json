				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wen o Quarto",
					"Huang, o Terceiro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "*Suspiro*... E pensar que após mil anos de legado, o porteiro chefe do Clã de Guhua deve enganar outros para sobreviver... O que faremos, o que pode ser feito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Wen o Quarto"
				},
				{
					"id": 711092502,
					"content": "Ugh... Tudo bem, tudo bem. Não estou poupando júnior de morrer de fome enquanto protege nossos portões...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Huang, o Terceiro"
				},
				{
					"id": 711092503,
					"content": "#E não olhe para mim assim. Você tá sempre tão deprimido... Mas ficou tão contente em ver o desempenho de {NICKNAME} ainda agora, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Huang, o Terceiro"
				},
				{
					"id": 711092504,
					"content": "#{M#Aquele tolo}{F#Aquela tola} de antes? {M#Ele}{F#Ela} pode bisbilhotar por aí em troca de te preparar um pouco de arroz com bacon? E eu deveria ficar contente com isso? Se eu fosse alguns anos mais jovem, eu acabava com você no tapa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Wen o Quarto"
				},
				{
					"id": 711092505,
					"content": "Hah! Sua técnica era inferior à minha apenas alguns anos atrás!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Huang, o Terceiro"
				},
				{
					"id": 711092506,
					"content": "...Enfim, ouça... Apenas alguns de nós, velhotes, restamos. O que você planeja fazer após a gente parar de testar aqueles que possam estar destinados a se juntar a nós? Levar aqueles livros conosco para nossos túmulos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Huang, o Terceiro"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Wen o Quarto"
				},
				{
					"id": 711092508,
					"content": "Hah... Só esqueça. Qual é o propósito de dizer coisas tão deprimentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Huang, o Terceiro"
				},
				{
					"id": 711092509,
					"content": "Oh, por que você não experimenta a comida que aquelas crianças fizeram? Hehe! Acho que é melhor do que o que se come no Restaurante Wanmin! Aqui, dá uma mordida! Só uma mordida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang, o Terceiro"
				}
			]
		}
	]
}