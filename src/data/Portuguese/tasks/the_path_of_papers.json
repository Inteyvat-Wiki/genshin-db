				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "Alrani! Você vai sair ou não?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050702,
					"content": "Eu não vou sair! Eu não quero mais ser uma estudiosa! Eu também não quero mais voltar para a academia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050703,
					"content": "Eu já te dei muito dinheiro. Você não pode me deixar em paz?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050704,
					"content": "Insuportável! Você é muito teimosa mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050705,
					"content": "Bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "Olá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050708,
					"content": "Hmm? Quem são vocês...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050709,
					"content": "V-Viajante! *Soluços*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050710,
					"content": "Senhorita Alrani, você realmente está aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050711,
					"content": "É um alívio que você esteja bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "*Soluços*... Eles são... Eles são tão injustos! É óbvio que eu escrevi essa tese primeiro! Eu escrevi primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050714,
					"content": "Se eu não tivesse ficado tanto tempo em Inazuma, eles teriam aceitado minha tese! *Soluços*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050715,
					"content": "Calma... Você ainda quer continuar escrevendo a sua tese agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050716,
					"content": "*Ofegante*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050717,
					"content": "Eu... Desisti dessa tese! Só os tolos escrevem teses! Nunca mais vou estudar! A Academia pode fazer o que quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050718,
					"content": "De qualquer forma, eu já paguei Narzam para me proteger. Ninguém vai me forçar a sair daqui ou continuar escrevendo essa tese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050719,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050720,
					"content": "Você é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "Eu sou Narzam! Eu trabalho como... Você já deve saber disso, então vou poupar você da conversa fiada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050722,
					"content": "#Eu conheço você, Viajante. Você tem estado ativ{M#o}{F#a} por aqui ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050723,
					"content": "Se você está em uma missão para levar essa garota para casa, vá em frente e tente convencê-la. Não vou te impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050724,
					"content": "Ei! Eu te paguei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050725,
					"content": "E você acha que é o bastante? Essa grana só é suficiente para pagar alguns dias de comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050726,
					"content": "Eu não vou voltar de jeito nenhum. São apenas novos temas e pesquisas de campo lá. Serão dias e noites sem descanso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050727,
					"content": "Difícil de dizer. Eu poderia ser pega por pessoas estranhas ou encontrar monstros estranhos. Então não dá tempo de terminar a tese e perderia o dia em que deveria defendê-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050728,
					"content": "*Soluços*... Não quero, não quero... Prefiro ficar aqui, prefiro ser capturada por ladrões de tesouros... *Soluços*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050729,
					"content": "Viajante, por favor, envie uma mensagem para a Srta. Niloofar por mim. Vou escrever um bilhete: Eu não quero voltar, me deixe em paz por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050738,
					"content": "Alrani escreveu um bilhete, choramingando...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "Aqui está... *Soluços*... Por que coisas como essas têm que existir neste mundo...? *Soluços*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050731,
					"content": "Está tudo bem... acalme-se. Ninguém vai forçá-la a voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050732,
					"content": "A Senhorita Alrani... Não parece nada bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050733,
					"content": "Deixe ela ficar aqui, vamos devolver o bilhete para a Srta. Niloofar primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050734,
					"content": "Mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "Não se preocupe com isso, seremos bons para Alrani. Como ela mesma disse, no final ela nos pagou pelo serviço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050737,
					"content": "Além disso... Além disso, finalmente encontramos alguém que sabe das coisas. Ela ainda será de grande utilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050735,
					"content": "Ladrões de Tesouro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Niloofar nos contou tudo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "Com licença...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
