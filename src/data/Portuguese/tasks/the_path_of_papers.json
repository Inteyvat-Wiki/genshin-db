			"dialogs": [
				{
					"id": 731050801,
					"content": "Viajante! Diga-me o que aconteceu! Você encontrou Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050802
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050802,
					"content": "Encontrar, encontramos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050823,
					"content": "Você contou para Niloofar o que aconteceu e entregou o bilhete de Alrani...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050803
					]
				},
				{
					"id": 731050803,
					"content": "Narzam? Mas como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050804
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050804,
					"content": "Você conhece ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Pessoalmente não. Ouvi falar dela como uma estranha integrante dos ladrões de tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050806,
					"content": "Dizem que quando ela rouba as pessoas, ela sempre faz uma pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050807,
					"content": "Essa pergunta pode ser sobre literatura, elementos e todo tipo de coisa, e até... Pode até ser algum enigma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050808,
					"content": "Se você responder à pergunta dela corretamente, ela não apenas devolve seus pertences, mas também acompanha você de volta à cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050809,
					"content": "Ela sempre foi tão excêntrica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "O que é isso... Uma fora da lei dos enigmas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Ninguém sabe. Eu só sei disso porque meu orientador teve a chance de encontrá-la no deserto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "A pergunta que Narzam fez na época foi: \"O que enche rapidamente uma sala vazia?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
