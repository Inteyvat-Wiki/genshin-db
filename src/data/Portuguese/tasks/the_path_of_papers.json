			"dialogs": [
				{
					"id": 731053001,
					"content": "Alrani, está a salvo por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "Como Alrani era na Academia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Alrani é uma estudante muito diligente. Embora ela às vezes... Se envolva em assuntos estranhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "Mas ela é uma aluna mais do que qualificada, tenho certeza que se tornará uma excelente pesquisadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "É muito difícil para a Academia aceitar teses de alunos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Para ser honesta, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "A revisão de tese é um negócio complicado... Você precisa considerar não apenas a direção da sua pesquisa, mas também a extensão das suas referências...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "Além disso, você deve considerar quantas outras teses falam sobre um tema semelhante ao seu e se há algum conflito entre elas. Após a proposta de tese, você ainda pode encontrar todos os tipos de dificuldades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*Suspiro* Alrani realmente tem muito azar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
