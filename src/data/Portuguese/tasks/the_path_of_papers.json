				{
					"id": 731053101,
					"content": "Mais alguma coisa que eu possa te ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053102,
					"content": "Por que você é tão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "Tão \"boa\" para Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053104,
					"content": "Você entendeu errado. As razões pelas quais faço isso são muito simples. Primeiro, a Alrani me pagou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053105,
					"content": "Segundo, roubo fortunas, não vidas. Eu arruinaria minha reputação se a abandonasse na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053106,
					"content": "Terceiro, Alrani é uma pessoa inteligente com um futuro brilhante pela frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053107,
					"content": "Se eu puder ajudá-la um pouco, talvez... Talvez dê alguma esperança para os Ladrões de Tesouros também... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053108,
					"content": "Quanto ela te pagou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Não foi uma quantidade pequena. Ela disse que ganhou aquele dinheiro fazendo algum \"fertilizante\" para algumas pessoas. Sei lá, eu não entendi direito e, honestamente, isso não me interessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053110,
					"content": "O importante é que ela nos pagou, então farei minha parte. Simples assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				}
			]
