					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "O vento! Certo? Sim, deve ser isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Hmm... O brilho de uma vela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Meu orientador respondeu: \"A Energia elemental é onipresente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "Isso é trapaça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Hahaha... Enfim, Narzam escoltou meu orientador até a cidade, e até se despediu muito educadamente dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "Se é ela que está com Alrani, não há com o que se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "Mas também não está certo ela ficar lá, tenho que pensar em algo para ajudar a resolver o problema da tese de Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
