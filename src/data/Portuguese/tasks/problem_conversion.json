			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Eu sabia, fazer desse jeito é mais caro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "De que você está falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Olá. Estou pesquisando um problema no design deste navio e encontrei um gargalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "Sem rodeios... Quero aumentar a capacidade do navio sem aumentar os custos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Uma vez que a carga é aumentada, a estrutura do navio fica mais susceptível a danos. O navio também pode ter problemas de equilíbrio se a carga for desigual...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "A melhor maneira de resolver esses problemas é usar materiais melhores, mas aí os custos sobem. Esse é o \"X\" da questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "*uuuf* Para ser honesto, é que eu quero construir um bom navio, mas não tenho a Mora necessária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Portanto, para alguns problemas que podem ser resolvidos com dinheiro, devo pensar em uma técnica alternativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Você pode realmente fazer isso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Hahaha, você pode não acreditar, mas muitas pessoas realmente fazem isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Afinal, os navios que construímos são navios de pesca costeira. Eles não encontram tempestades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "No que diz respeito à construção naval, nós acreditamos em economizar quaisquer custos possíveis e em consertar e remendar o que pudermos... Contanto que possa ser usado, nós improvisaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Graças a esta crença, o nosso negócio de reparo naval desempenha bem diariamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "Viajante, por favor, me ajude a ir até lá e examinar o navio que acaba de retornar ao porto. Ele muitas vezes carrega cargas pesadas, e desta vez parece que algo está errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Acontece que estou pesquisando exatamente esse assunto, talvez eu possa me inspirar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Muito obrigado! Eu tenho que me apressar e começar a consertar outro navio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Por que você não vai lá você mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Eu mesmo faria, mas me pediram para reparar outro navio que precisa voltar para o mar e pegar sua rede de volta logo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "Então só posso deixar isso para você, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
