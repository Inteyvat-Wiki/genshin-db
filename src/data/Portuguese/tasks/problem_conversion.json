			"dialogs": [
				{
					"id": 230190401,
					"content": "Então, você terminou de verificar o navio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Acabei de verificar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Você descreve a condição do navio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Entendo. As estruturas com truques para cortar custos estão tendo problemas, conforme esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Mas vai custar uma fortuna consertar essas estruturas. O dono do navio... Lembro que estava com dificuldades financeiras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "*Suspira*, é melhor eu ir falar com ele... Comparado ao dinheiro, a vida dele é mais importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		}
