			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "Ah! São vocês! Tô esperando há um tempão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "Já fez amizade com o Regisvine Pyro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Argh, nem me fale. Você \"negociou\" um período de calma, muito breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "#Assim que ele se recuperou, começou a bater em mim de novo! Quer saber? Você estava cert{F#a}{M#o}. Não é possível ter uma amizade com uma criatura como essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Ainda assim, seus frutos são bem gostosos. Como Pyro. Meus amigos em Natlan vão gostar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "E qual é o sabor disso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "Quer provar? Se quiser, eu posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "Hã, não, valeu! Enfim, agora é o Dragarto Primordial Geo, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "Isso mesmo. Acho que com ele vai dar certo. Dragartos Primordiais Geo são como Saurianos de Peito Pontudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Se você fosse para Natlan de Sumeru, como eu fui, seria a primeira coisa que veria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "Claro, beleza. Paimon não tá com esperança nesses aí também... Por que você não escolheu as Crias de Dragarto Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "... Elas não têm barrigas redondas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "Quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "Crias de Dragarto Geo não têm barrigas fofinhas. Imagino que seja por causa daquele rola-rola rápido que elas fazem. Não conseguem ficar segurando gordura no corpo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "*Suspiro* Mas a razão principal é a falta de... impacto. O que uma Cria de Dragarto Geo é do lado dos meus amigos que vivem com Saurianos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "Mas um Dragarto Geo é outra história. Mesmo como uma história, vai valer a pena. E de qualquer forma, um protagonista forte precisa de oponentes fortes, entendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Certo. Não vamos enrolar, certo? Os Dragartos Primordiais Geo nos esperam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Vamos indo nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Tenho outras coisas para resolver. Te vejo em breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Sem problemas. Vou esperar por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}