			"dialogs": [
				{
					"id": 752780101,
					"content": "E-Esperem, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780102,
					"content": "Como podemos ajudar você, mocinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "\"Carregue o milagre do florescer da Opúncia, e deixe a Chama Sagrada acender seu sorriso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780104,
					"content": "Hã? Mas o quê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "\"Em nome do Resort da Brisa Tranquila, apresento a vocês uma dança de boas-vindas! Brilhe, Ídolo Pippipan\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780106,
					"content": "Ugh! Aquela fala de novo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#É, sou eu, \"Seaden\"! Hehe, há quanto tempo, Sr{F#ta}. {NICKNAME} e Srta. Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780108,
					"content": "Ah! É só você, \"Seaden\"! Paimon achava que a gente ia encontrar alguém assustador de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Você parece feliz. Boas notícias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hehe, adivinha só? Meu pai vai me treinar pessoalmente para virar uma artista de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780112,
					"content": "Viu? Ele se faz de durão, mas se importa de verdade! Embora fosse melhor se ele não te ensinasse... coisas questionáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Oh, e isso também é para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780114,
					"content": "Espera, esse não é seu figurino de apresentação? Mas sem ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Sem problemas! Meu pai fez um novo que veste melhor! Nada de quedas do palco para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780116,
					"content": "Considere essa roupa antiga como uma lembrança! Por favor, aceitem, considerem um símbolo da nossa amizade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780117,
					"content": "Na próxima vez que nos encontrarmos, vou usar minha roupa nova e dançar só para vocês. Prometam que vão vir me assistir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780118,
					"content": "É! A gente promete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "\"Seaden\"! Hora do treino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Ok, tenho que ir trabalhar esses músculos. Tchau tchau, Sr{F#ta}. {NICKNAME} e Srta. Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "\"Seaden\""
				},
				{
					"id": 752780121,
					"content": "Tchau-tchau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Você vai mesmo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "É claro! Apesar de que... ver uma apresentação normal de ídolo seria legal também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Como estão as coisas ultimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}