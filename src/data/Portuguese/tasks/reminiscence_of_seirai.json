			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Furuya Noboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "Hmm, isto é uma dor de cabeça e tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Sobre esta imagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "A julgar pelo mapa, eu diria que este é algum lugar na Ilha Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "Como você sabe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "A Guilda publicou várias expedições para a Ilha Seirai no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "Os aventureiros que aceitaram essas comissões nos trariam informações sobre a ilha sob a forma de relatórios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Infelizmente, as questões de mão de obra nos impediram de lançar expedições em larga escala, então estamos presos ao envio de apenas alguns aventureiros por vez para explorar a área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "Receio que isto limite a medida em que posso continuar ajudando você a analisar este mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "No entanto, conheço alguém que pode saber mais sobre a Ilha Seirai do que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "Seu nome é Oda Tarou. Ouvi dizer que seus ancestrais costumavam viver na Ilha Seirai antes de migrarem para cá por várias razões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "Por falar nisso, ele veio à Guilda algum tempo atrás para contratar alguns aventureiros que o acompanhariam à Ilha Seirai para ver o lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "Você pode perguntar a ele sobre este mapa. Com alguma sorte, talvez ele saiba algo a respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
