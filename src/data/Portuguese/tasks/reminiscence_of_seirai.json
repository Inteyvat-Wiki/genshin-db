			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "*Suspira* Quando vou encontrar alguém que me acompanhe até lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630302,
					"content": "Sobre esta imagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "#Você é... {M#Um}{F#Uma} aventureir{M#o}{F#a} da Guilda? Eles finalmente puderam dividir seu pessoal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630304,
					"content": "#Uh, sou apenas {M#um}{F#uma} viajante de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "Oh, entendo. Que imagem você quer me mostrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630306,
					"content": "Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630307,
					"content": "Is-Isso! Seria isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630308,
					"content": "O que você viu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "Essa não é a Ilha Seirai?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630311,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "Haha, é isso mesmo? Eu apenas imaginei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630314,
					"content": "Embora meus ancestrais tenham vivido na Ilha Seirai, isso já faz muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630315,
					"content": "Minha geração já não tem mais nenhuma lembrança de nosso antigo lar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630316,
					"content": "Tudo o que nos resta na casa para nos lembrar dele são três pinturas de paisagens da ilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630317,
					"content": "Então por que você quer voltar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "Bem... Ainda é minha \"terra natal\", não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630319,
					"content": "Eu sinto que... preciso vê-la, haja o que houver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630320,
					"content": "Infelizmente, estou muito ocupado administrando meu negócio no momento, então não tenho tempo para ir lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630321,
					"content": "Além disso, tive alguns problemas para encontrar Aventureiros dispostos a me acompanharem até à Ilha Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630322,
					"content": "Então eu escolhi a Opção B: publicar uma missão na Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630323,
					"content": "Com sorte, alguns Aventureiros podem me ajudar a ir para a Ilha Seirai, encontrar os três lugares mostrados nessas pinturas, tirar algumas fotos com um Aparelho Fotográfico e trazê-las para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630324,
					"content": "Mas ninguém aceitou essa missão até agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630325,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "V—você realmente faria isso? Seria incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630328,
					"content": "Quanto ao pagamento, você não precisa se preocupar. Prepararei tudo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630329,
					"content": "Pois bem, Viajante, conto com você. Use o mapa que você trouxe para tirar fotos de quatro locais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630330,
					"content": "Pois bem, Viajante, vá até estes quatro locais e tire uma foto de cada um deles para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630326,
					"content": "Eu posso ir lá para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "Você tem razão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "É a sua casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
			"completionStepIds": [
				7216307,
				7216310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216307",
							"2"
						],
						"stepId": 7216307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "Você voltou. Como foram as coisas? Conseguiu tirar as fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "É claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Que maravilha! Deixe-me vê-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "Er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Ahaha! Não sei dizer onde estão esses lugares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "Parece que esses três locais mudaram muito desde que nossa família partiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "Eu me pergunto se a Srta. Fujiwara Toshiko será capaz de reconhecer estes lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Bem, na verdade... eu duvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630409,
					"content": "Ela também é da Ilha Seirai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "Mais precisamente, ela está no mesmo barco que eu - nossos ancestrais moravam lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630411,
					"content": "Na verdade, há muitos de nós aqui na cidade de Inazuma cujos ancestrais já foram nativos da ilha, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630412,
					"content": "Então, por que todos vocês se mudaram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "Eu realmente não me lembro mais... Foi há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630414,
					"content": "Acho que podem ter sido as tempestades insanas, ou para impedir o contrabando e a travessia ilegal da fronteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630415,
					"content": "Seja qual for o caso, o Shogunato providenciou para que os habitantes da ilha viessem para a Ilha Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630416,
					"content": "Oh, não vamos falar sobre isso. Isto é para você. Aceite isto como um agradecimento por fazer esta tarefa para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630417,
					"content": "*Suspira* Ah, eu gostaria de poder ir pessoalmente à Ilha Seirai algum dia...",
