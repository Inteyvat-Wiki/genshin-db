			"dialogs": [
				{
					"id": 737080201,
					"content": "Parece que a mensagem foi entregue sem nenhum problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080202,
					"content": "Finalmente, nos encontramos novamente, Cometa Dourado, Parceira de Prata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080203,
					"content": "#Ver vocês radiantes e chei{F#as}{M#os} de energia me dá uma ótima sensação de que o tempo parou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080204,
					"content": "Há quanto tempo, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "Haniyyah, Cabeça de Bongô, são vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080206,
					"content": "Não foi à toa que Paimon achou que isso era familiar... isso quer dizer que o laço entre Paimon e Cabeça de Bongô ainda existe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737080212,
					"content": "Imaginei muitos jeitos que poderíamos nos reencontrar. Um grande banquete, uma festa de boas-vindas criativa, ou algo que realmente surpreendesse vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080213,
					"content": "#Mas, no final, tudo parecia meio formal. Vocês estavam ocupad{F#as}{M#os}, e eu fiquei preocupada que poderia tomar muito de seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080214,
					"content": "Além disso, nossos cogumigos gostam de ambientes calmos. Por isso, vamos nos reencontrar de um jeito relaxado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080215,
					"content": "Isso mesmo! A prosa de Haniyyah finalmente valeu a pena. Uma calma mental é ótimo para a vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080216,
					"content": "Jogar conversa fora é o melhor jeito de ir levando a vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "Pyroalegria"
				},
				{
					"id": 737080218,
					"content": "Souka está aqui também, e Pyroalegria... e quem é esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080219,
					"content": "Esse aqui é o meu cogumigo Dançarino da Brisa. Vocês e o Cabeça de Bongô nos derrotaram nas classificatórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080220,
					"content": "Hehehe, você lembra bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080221,
					"content": "Parece cada vez mais familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "Enfim, como vocês podem ver, não tivemos tempo de organizar o espaço para nosso próximo encontro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080224,
					"content": "Eu e Haniyyah compramos esse distrito comercial e o transformamos no Parque de Diversões dos Cogumigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080225,
					"content": "Espera, então você tá dizendo que essas instalações daqui não são alugadas para o novo jogo de mesa, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080226,
					"content": "Isso mesmo. De agora em diante, vamos viver no Porto Bada, e vamos promover o jogo de mesa dos cogumelos, bem como compartilhar nossa teoria de como se comunicar com animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080227,
					"content": "Fique à vontade para aparecer por aqui e brincar com os Cogumigos quando estiver livre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737080229,
					"content": "Uhul! Cogumigos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "Isso é uma das melhores coisas que Paimon ouviu hoje!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080232,
					"content": "Depois do primeiro Torneio de Cogumelos, Paimon pensou em tantas ideias para se divertir com o Cabeça de Bongô. Agora vamos poder realizar todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080233,
					"content": "Falando nisso, deve ser bem caro manter esse lugar, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "Não se preocupe, Mora não é um problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080235,
					"content": "Recentemente, além de obtermos fundos com jogos de mesa tipo Fungo Mechanicus e Festa Fúngica Fantástica com a ajuda do Sr. Balfour...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080236,
					"content": "Também refletimos nas nossas experiências passadas, e organizamos nosso conhecimento sobre domesticação de cogumelos em uma teoria mais sistematizada. Chegamos até a publicar alguns livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080237,
					"content": "Alguns pesquisadores tiveram interesse ao ponto de fornecerem apoio financeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080238,
					"content": "Tudo entrou um ciclo positivo. Usar meu conhecimento para fazer as coisas mais acessíveis para outros, ganhar Mora por isso, e ajudar nossos cogumigos a terem vidas melhores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080239,
					"content": "Uau, isso é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080240,
					"content": "Parece que Haniyyah se tornou uma especialista em domesticação de feras bem tranquila que pode lidar com tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080241,
					"content": "É tudo graças a Souka. Ela me incentivou a me desafiar e aprender as habilidades que eu precisava, usando os mesmos métodos de ensino de seus estudantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080242,
					"content": "Ei! Eu não ensinei essa humildade pra você! Eu não sou uma professora perfeita, se alguém lhe elogiar, você aceita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080243,
					"content": "Você faz isso parecer fácil, mas deve ter havido alguns momentos difíceis, não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "Houve muitos desafios, sim. Mas o passado e as coisas ruins desaparecerão com o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080246,
					"content": "Meu maior arrependimento é que, no ano passado, não fiz nossos Cogumelos se divertirem muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080247,
					"content": "Desde que comecei a elaborar minhas teorias sobre domesticação de feras, passamos a maior parte dos nossos dias em cavernas e casas na árvore, vivendo um vida de escrita noite e dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080248,
					"content": "O lado de negócios é exaustivo, e os dias que passamos pensando em prazos eram horríveis. Eu entendo os pensamentos de Souka bem melhor agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080249,
					"content": "Bem, nem tudo são comentários negativos! No momento que você termina de escrever, você sempre passa a se sentir satisfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080250,
					"content": "Sim. Eu concordo. Todo rascunho terminado merece uma refeição comemorativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080251,
					"content": "Mas nossos cogumigos não podem aproveitar nossa comida... e do ponto de vista deles, a vida pode estar bem chata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080252,
					"content": "Se isso continuar por muito tempo, eles vão sofrer, e isso não é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080253,
					"content": "Por isso, agora que as coisas já melhoraram do seu lado, e como você tem um lugar para ficar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080254,
					"content": "Que tal a gente levar os cogumigos pra se divertir? Podemos deixar eles se divertirem o quanto quiserem, e então trazer eles de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080255,
					"content": "Assim, você pode focar no seu trabalho, e os cogumelos ainda vão se divertir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080256,
					"content": "Ótima ideia, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "Eu também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080259,
					"content": "Quando se trata de lugares que valem a pena uma visita, eu sou mais da teoria. Só consigo pensar em coisas de livros. Até mesmo me perdi quando fui em Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080260,
					"content": "Haniyyah não é tão esperta quando se trata disso. Ela nem mesmo sabe quais são os locais divertidos de Sumeru. Só vive pensando no trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080261,
					"content": "Ficamos em Fontaine por muito tempo, mas o planejamento do itinerário foi horrível. No final, nem consegui ir até a loja de sobremesas que eu queria, e acabei perdendo os Macarons que queria tanto provar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080262,
					"content": "#Ahem... Mas se tivesse sido {F#a}{M#o} Cometa Dourado e a Parceira de Prata, tenho certeza que vocês teriam encontrado vários lugares fantásticos para levar nossos cogumigos para se divertirem à beça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080263,
					"content": "Então eu preciso mesmo pensar em quais locais escolher!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "Só um momento, leve essa câmera com você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080266,
					"content": "Haniyyah tira uma câmera e a coloca em cima de Cabeça de Bongô. Para a surpresa de todos, Cabeça de Bongô equilibra ela com facilidade, como se já estivesse acostumado a carregar coisas voando...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "Pode parecer ordinário, mas é uma lembrança especial...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080268,
					"content": "Cabeça de Bongô salvou o filho de um comerciante que se perdeu ao sul da Floresta Apam. E para nos agradecer, deu muitos presentes para Cabeça de Bongô, incluindo essa câmera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080269,
					"content": "Ele adora as fotos que ela tira. Por isso, você pode aproveitar essa viagem para guardar essas memórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080270,
					"content": "Eu encontrei uma especialista de equipamentos, a Srta. Helene, que impermeou a câmera para que ela pudesse aguentar ambientes úmidos que o Cabeça de Bongô adora... até mesmo embaixo d'água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080271,
					"content": "Noutras palavras, essa câmera é um dos símbolos de honra do Cabeça de Bongô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080272,
					"content": "Isso aí, Cabeça de Bongô!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737080275,
					"content": "#Quanto a tirar fotos, não se preocupe! {NICKNAME} e Paimon são profissionais nisso. O equipamento não importa, o que importa é tirar boas fotos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}, vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080277,
					"content": "Não se esqueça da comida especial para os cogumigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080278,
					"content": "Isso mesmo! Paimon lembra dessa parte, levar bastante Geleia Maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080279,
					"content": "A versão mais nova e melhorada tem um gosto ainda melhor, e armazena muito bem. Não importa quão quente fique, não há preocupação em ela estragar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080280,
					"content": "Só tenham cuidado para não dar muito de uma vez. Dar comida demais de uma vez para eles não é bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080281,
					"content": "Hehe, entendi! A Geleia vai pro inventário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080282,
					"content": "E agora podemos ir, e vamos voltar com um montão de lembranças de nossa viagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080273,
					"content": "Parabéns, Cabeça de Bongô!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "Vou escolher locais divertidos e bonitos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "Quero levar nossos cogumigos para se divertirem também!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "Parece que você pulou vários momentos difíceis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "Agora podemos nos ver sempre!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "Essa atmosfera calorosa e de boas-vindas tá me relaxando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "Eu não me lembro bem, mas... olá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "São Haniyyah e Cabeça de Bongô! Nos conhecemos na Copa Nilotpala de Domadores de Feras! São nossos amigos de longa data!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080210,
					"content": "Depois disso, Paimon se lembra que nos encontramos de novo no Porto Ormos, e na Corte de Fontaine. Já faz tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Cabeça de Bongô"
				}
			]
		},
