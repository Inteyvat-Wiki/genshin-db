			"dialogs": [
				{
					"id": 737080101,
					"content": "Ei, um Cogumelo acabou de passar voando. Você tem certeza que não tem problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080102,
					"content": "Geralmente, ter um Cogumelo flutuando pela cidade é bem perigoso! A não ser que seja um especial que tenha sido treinado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080103,
					"content": "Espera, por que isso parece familiar? A gente já passou por algo assim antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080104,
						737080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080104,
					"content": "Espera, é o Cabeça de Bongô?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080105
					]
				},
				{
					"id": 737080105,
					"content": "Isso mesmo! Cabeça de Bongô! Nosso cogumigo de Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080106,
					"content": "Aaaaah! Há quanto tempo a gente não se vê! Vamos dar um oi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080107,
					"content": "Quais especiais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080108
					]
				},
				{
					"id": 737080108,
					"content": "Eu acho que o Cabeça de Bongô? Nosso cogumigo de Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080109,
					"content": "Aaaaah! Há quanto tempo a gente não se vê! Vamos dar um oi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
