			"dialogs": [
				{
					"id": 737080301,
					"content": "Ufa... finalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080302,
					"content": "A jornada tomou um tempão, mas Paimon acha que o Pico Teticpac aqui dos Descendentes das Copas têm muita personalidade. Nossos cogumigos vão adorar esse cenário novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080303,
					"content": "Paimon trouxe alguns rascunhos da paisagem. Podemos deixar eles compararem as ilustrações com o que veem na própria frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080304,
					"content": "Se eles olharem mais de perto, combinarem as cenas, e então repararem nos detalhes que escapam aos olhos, e assim chamar sua atenção... isso quer dizer que esse lugar é perfeito para explorar ainda mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080305,
					"content": "♪♫!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "Cabeça de Bongô"
				},
				{
					"id": 737080306,
					"content": "♫... ♩?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "Pyroalegria"
				},
				{
					"id": 737080307,
					"content": "Tem outro jeito melhor não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "Hehe, quando Paimon tá livre, ela lê guias também, estudando os pontos turísticos diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080310,
					"content": "Essa é uma habilidade essencial de qualquer guia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080311,
					"content": "Certo, vamos deixar nossos cogumigos tentarem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080308,
					"content": "Você é ótima, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				}
			]
		}
