			"dialogs": [
				{
					"id": 722680101,
					"content": "#Eu sou Uda dos Jibashiri. {M#Herói}{F#Heroína} de Sangonomiya, reconheço que você é mereced{F#ora}{M#or} deste desafio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "Eu sou o responsável pelo julgamento da \"sabedoria\". Vá em frente e resolva todos os quebra-cabeças para retornar as Chamas do Portão Alto para seus lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "#Se você não for sábi{F#a}{M#o} o suficiente, avançar em frente não se trata de coragem, mas sim tolice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "Aguardarei você completar o desafio na Torre dos Três Reinos acima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
