			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Muito obrigada. Pensei que eu estava realmente acabada... Este grupo de Ladrões de Tesouro tem me seguido durante todo este tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Logo quando eu tinha finalmente feito alguns progressos em minha pesquisa, e estava pensando que seria bom encontrar o tesouro aqui e levá-lo de volta comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "Os Ladrões de Tesouro invadiram meu acampamento, me prenderam e me trouxeram até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Eles ficaram me questionando sobre a localização do tesouro, e ameaçaram tirar minha vida se eu me recusasse a contar-lhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Mas se eu tivesse dito assim, de cara, aí sim que teria sido realmente o meu fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*Suspiro* Eu devia escutar a Soraya. Ela sempre insiste que arqueólogos como nós, deveríamos estar concentrados nos resultados acadêmicos ao invés de no tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Mas eu não consigo tanto financiamento. Algumas redações não serão suficientes para me compensar as despesas de viagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Eu não consigo entender como a Soraya conseguiu ficar sozinha em Liyue durante todo este tempo. Só de olhar para sua pilha de manuscritos rejeitados, me sinto exausta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "O que você planeja fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Bem, o que mais? Terminei de reunir meu material de pesquisa. Quanto ao tesouro... Bem, você pode ficar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Não repetirei o complexo processo de pensamento que me trouxe até aqui. Tudo que você precisa saber é que o tesouro está enterrado <color=#00E1FFFF>embaixo daquela árvore dourada gigante</color> no meio do Passe de Lingju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Pegue-o se quiser. Escreverei uma descrição para você não esquecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Descansarei por um tempo e depois voltarei ao meu acampamento para recolher minhas coisas. Tenho que sair daqui o mais rápido possível, para que mais Ladrões de Tesouro não venham para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "Não faço ideia de quanto tempo levará para chegar daqui até o Albergue Wangshu. Só posso esperar que a Soraya ainda não tenha saído quando eu chegar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*Suspiro* Se pelo menos a Soraya pudesse ser minha tutora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
