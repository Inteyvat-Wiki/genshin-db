			"dialogs": [
				{
					"id": 761290101,
					"content": "Obrigada novamente por toda ajuda dada à Guilda, Chefe Nefer, Srta. Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "É apenas uma colaboração. Não precisa de tantas formalidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "É verdade, mas tenho que te agradecer, Chefe Nefer, por estar disposta a ajudar a Guilda com um... trabalho de investigação complexo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "A Guilda de Aventureiros também enviou muitos membros para nos ajudar em nosso trabalho. É uma parceria em que todos ganham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "Espero que nossas futuras colaborações sejam igualmente boas, Sr. Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Você pode ficar tranquila, Chefe Nefer, que nossa Guilda de Aventureiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Ah, eu deveria ser preciso. Nossa filial da Guilda de Aventureiros em Nod-Krai é uma parceria de confiança absoluta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Heh, isso é óbvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Ótimo, ótimo, continue falando assim, Chefe Nef, querida Chefe Nef, não olhe para mim, não olhe para mim, não olhe para mim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, por que não está dizendo nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(Ela olhou para mim mesmo assim! Certo, não olhe para o quadro de comissões, não olhe para o quadro de comissões, não olhe para o quadro de comissões—)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Hã? E-Eu? Eu, eu não tenho nada a dizer! Uh... Obrigada... pela comissão...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Oh, também devemos agradecer à Srta. Jahoda pela sua ajuda. Sem você, a papelada da Guilda provavelmente se amontoaria feito uma montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Não precisa me agradecer, não precisa... Eu estou sendo paga, então é claro que devo fazer um trabalho bem feito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*Suspiro*, Eu ensinei a ela o que dizer, mas parece que ela esqueceu de tudo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "A propósito, já que estamos todos aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(Não! O clima estava tão bom, Chefe, por favor me deixe em paz!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Sr. Sarin, poderia por gentileza trazer a última remessa de comissões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, escolha a comissão que você acredita que é a mais importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Pense cuidadosamente. Não tenha pressa. Está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "Sim... Sim, Chefe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Ugh!! Estou PERDIDA!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
}