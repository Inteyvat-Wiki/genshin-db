					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870111,
					"content": "#Assim como {REALNAME[ID(2)|SHOWHOST(true)]}, ele também não tem uma casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870112,
					"content": "#Venha com a gente! Hehe, eu e {NICKNAME} somos ótim{F#as}{M#os} em fazer amizade com Tepetlissauros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870113,
					"content": "Rawr! Rawr!",
