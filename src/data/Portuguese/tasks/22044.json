					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "Viajante, você está aqui! Você veio para prestar seus respeitos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "Como está indo sua escultura em madeira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Oh, eu diria que estou indo bem. Mas ainda preciso consertar as dimensões das esculturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "De acordo com meus pensamentos iniciais, estas esculturas devem caber confortavelmente na palma da mão de uma pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "Dessa forma, eles podem brincar com elas facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "Aliás, além das esculturas propriamente ditas, acho que deveria fazer algumas decorações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "Já vi que quando as pessoas fazem estas esculturas, elas também acrescentam alguns acessórios na lateral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Coisas como flores, animais, bases que têm padrões florais, coisas assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "Também gostaria de colocar tais bases decorativas em minhas esculturas de madeira. Dito isto, devido a questões de dimensionamento, só podemos colocar um ornamento em uma escultura em madeira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "Mas estou pensando que se as decorações fossem destacáveis, eu poderia simplesmente colocar as decorações que meus clientes pedissem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "Provavelmente gostaria de começar com decorações mais simples... Algo como Erva Naku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "Então, Viajante, você poderia me ajudar a recolher 3 talos de Erva Naku para usar como referência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "Desculpe, Viajante, mas vou deixar isto em suas mãos. Volte e procure por mim quando tiver as Ervas Naku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Por que três?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Se eu puder conseguir três, posso vê-las em três estados diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "Dessa forma, eu poderia ser capaz de esculpir a melhor Erva Naku que eu puder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
