				},
				{
					"id": 721840202,
					"content": "Sobre a pizza do Restaurante Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "Oh, você está falando dessa pizza, ela é muito gostosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840204,
					"content": "Mas... Como posso dizer, não estou muito acostumada a esse sabor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840205,
					"content": "Só penso que se puder misturar alguns ingredientes locais de Inazuma na pizza, por exemplo, o Melão de Lavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 721840206,
					"content": "Talvez a pizza se torne mais popular entre todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rie"
