			"dialogs": [
				{
					"id": 100090801,
					"content": "É isso... Sua execução foi perfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Sim, não vejo nenhuma falha no preparo... Deixe-me extrair um pouco e testar a composição do produto. Um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose extrai um pouco da poção e usa um dispositivo para examinar sua composição...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Sim, como eu disse... Execução impecável. A poção está perfeita. Exatamente como eu esperava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "Então, será que a sétima vez foi a da sorte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "Após a análise, ela parece idêntica às seis versões anteriores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Ah... Isso não tornaria os resultados idênticos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Nem sempre. Os resultados experimentais podem variar mesmo quando todas as variáveis parecem iguais. Nunca se sabe o que vai acontecer — é isso que torna os experimentos tão valiosos em primeiro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Venha, vamos testar isso. Plantei algumas Flores-Doce antes, podemos usá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "Só precisamos regá-las com a poção e ver o que acontece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
