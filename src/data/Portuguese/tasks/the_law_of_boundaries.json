			"dialogs": [
				{
					"id": 100091101,
					"content": "Ufa, a gente conseguiu. Até daquele tamanho, uma Flor Gigante é só uma Flor Gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091102,
					"content": "...Sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091103,
					"content": "Mas, hmm... era pra ter ficando grande daquele jeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091104,
					"content": "Só consegui fazer uma estimativa aproximada durante a batalha, mas parecia pelo menos ter... 16 vezes o seu tamanho original, talvez até mesmo maior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091105,
					"content": "Isso significa que o experimento... funcionou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091106,
					"content": "Espera, mas isso não é uma coisa boa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Ainda não tenho certeza de quais são as implicações... mas se mais tentativas tiverem sucesso em reproduzir esse resultado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091108,
					"content": "Isso significa que algo está diferente... Talvez os limites e leis deste mundo estejam mudando devido a um fator desconhecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091109,
					"content": "Não consigo determinar se isso é bom ou ruim, mas de uma perspectiva alquímica, pelo menos, fronteiras expandidas significa que mais possibilidades estão abertas para nós agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091110,
					"content": "De toda forma, isso conclui minha tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091111,
					"content": "Parece que sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Hmm. Dito isso, também poderia ser um efeito da pessoa que fez a poção. Também pode ter havido algo especial sobre essa Flor Gigante específica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091113,
					"content": "Ainda há muito a ser confirmado, então acho que essa tarefa abre o caminho para mais questionamentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091114,
					"content": "Bem, estamos aqui se você precisar de ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "Será que dá pra usar o soro do crescimento em Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Hehe, só pense nisso... Paimon provavelmente conseguiria acabar com uma gangue inteira de Ladrões de Tesouro rapidinho se ela fosse 16 vezes maior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "Tenho minhas dúvidas. O único motivo do soro ter funcionado na Flor Gigante foi pela sua estrutura interna ser similar suficiente a uma Flor Doce... Se você bebesse um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091118,
					"content": "Você pode ficar 16 vezes maior, mas também pode acabar virando uma forma de vida vegetal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091119,
					"content": "É, não. Nada feito, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "Ah, falando nisso, Paimon queria perguntar... Por que toda a sua pesquisa é focada em coisas como a Flor Doce ou o Fruto do Pôr do Sol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Ah, isso é simples. Tanto o néctar do Fruto do Pôr do Sol quanto da Flor Doce são adocicados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091122,
					"content": "Então, de certa forma, fazer uma Flor Gigante 16 vezes maior acidentalmente vem com um efeito colateral benéfico, porque o néctar da Flor Gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091123,
					"content": "...Tem o mesmo sabor do néctar da Flor Doce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091124,
					"content": "Isso mesmo! Quando eu extrair o açúcar do néctar, vou dar um pouco a vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091125
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091125,
					"content": "Hehe, está combinado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
