			"dialogs": [
				{
					"id": 100090601,
					"content": "Certo, os ingredientes estão prontos, e o Caldeirão de Alquimia está logo ali, então deve estar tudo certo para começarmos. Mas, ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "Tem alguma coisa errada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "Não, não. É só que... Você se importaria se eu observasse do lado? Só para fins de registro preciso, quero dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "Eu sei que muita gente não gosta de ser observada de perto durante experimentos, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "Não tem problema algum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Obrigada. Então, estou pronta para começar quando vocês estiverem. Vou garantir que todas as anotações sejam bem detalhadas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "Então, estão prontos para começar o experimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
