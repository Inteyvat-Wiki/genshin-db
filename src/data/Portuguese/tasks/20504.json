				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "As <color=#00E1FFFF>Selo Anemo</color> aparecem por todo canto de Mondstadt. Se você estiver com falta, apenas continua procurando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "São realmente apenas para decoração?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Com certeza, o que mais poderia ser mais belo que um presente do Arconte Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Hahaha, muito bem, muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "Na verdade, é mais complicado do que isso, mas é mais fácil para as pessoas entenderem se eu apenas disser que é para decoração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Obviamente, a razão de eu precisar de <color=#00E1FFFF>Selos Anemo</color> é porque eles possuem propriedades que os outros materiais não têm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Deixe-me ver quando estiver pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Haha, claro! Eu garanto que você se surpreenderá com o resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "Volte sempre, e me traga muitos, muitos <color=#00E1FFFF>Selos Anemo</color> da próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Qualquer tesouro raro, lembre-se de trazer para cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "Eu acho que você está fazendo isso mais misterioso do que realmente é.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "Está funcionando... Estou curiosa agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "Haha, não seria uma grande surpresa se eu falasse tudo, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
}