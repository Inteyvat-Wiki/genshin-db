			"dialogs": [
				{
					"id": 220000201,
					"content": "Já já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Então, vamos começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000203,
					"content": "... Como começamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000204,
					"content": "Hum! Estou te assaltando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Uau! São os piratas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Pequena Lulu"
				},
				{
					"id": 220000206,
					"content": "Venha cá, Lulu, vou te proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000207,
					"content": "Você deve ser um pirata. Diga-me, por que você está nos roubando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000208,
					"content": "Pois eu sou um pirata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Não todos! Há piratas bons e maus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou diz que é uma pirata, mas é uma boa pessoa, ela nos dá comida! Todo mundo ama a Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000212,
					"content": "#Por que você tem que ser {F#uma pirata malvada}{M#um pirata malvado}? Você não consegue ser {F#uma}{M#um} pirata do bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000213,
					"content": "Foi você que disse que os piratas roubavam as coisas alheias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "#Está bom, eu estava errad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Ótimo! Admitir os próprios erros é o primeiro passo para se tornar uma pessoa melhor. É o que Beidou diz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000217,
					"content": "O próximo passo é arrumar a área. Porque enquanto você faz coisas boas, pode ser uma boa pessoa. Até um bom pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000215,
					"content": "Eu quero ser uma pessoa boa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "É exatamente o que os piratas fazem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
