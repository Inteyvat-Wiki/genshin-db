			"dialogs": [
				{
					"id": 220000101,
					"content": "Então como jogamos hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000102,
					"content": "Hm! Se ninguém quiser ser o pirata, não podemos brincar hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000103,
					"content": "Mas ninguém quer ser o pirata, o que vamos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000104,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Nós estávamos jogando, mas sempre faltava um pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000106,
					"content": "Ninguém queria ser o pirata, nunca conseguimos começar o jogo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000107,
					"content": "Ooh, ooh, eu sei que você consegue! Você quer ser um pirata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000108,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Yeah! Vamos lá nos preparar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000115,
					"content": "#Venha quando você estiver pront{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000110,
					"content": "Não entendo o que tenho que fazer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Não é tão difícil! Um pirata é apenas alguém que é muito travesso e pega coisas que não lhes pertencem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000112,
					"content": "Nunca tinha visto um pirata verdadeiro. Isto é apenas o que a Beidou me contou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000113,
					"content": "Mas penso que não é difícil simular um pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000114,
					"content": "Hehe, tenho certeza de que você consegue. Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
		{
