				{
					"id": 220000301,
					"content": "Você já acabou a limpeza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000302,
					"content": "Concluído.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Bom trabalho! Obrigado por ter brincado conosco! Isto é para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000304,
					"content": "E não se esqueça, ser uma pessoa boa não para por aqui. Tem que ser um hábito de vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000305,
					"content": "Olha, quando vou poder ser o capitão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000306,
					"content": "Na próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
