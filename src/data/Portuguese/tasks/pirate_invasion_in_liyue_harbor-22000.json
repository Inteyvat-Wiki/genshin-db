			"dialogs": [
				{
					"id": 220000501,
					"content": "Você terminou a limpeza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000502,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Rápido! Essa é a sua chance para mudar e mostrar que você pode ser uma boa pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000504,
					"content": "Ei? Está falando sério? Limpando só uma vez já te tornou em uma pessoa melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000505,
					"content": "Aqueles que querem fazer boas ações, tem um bom coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000506,
					"content": "Parece tão fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000507,
					"content": "Faça o bem, você é uma boa pessoa. Faça o mal, você é uma pessoa má. Sim, é muito simples.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000508,
					"content": "Hunf, você pode dizer isso, mas como é que ainda existem tantas pessoas más no mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000509,
					"content": "Por que todas as coisas no mundo são fáceis de dizer, mas difíceis de fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000510,
					"content": "Mas é muito mais fácil de fazer coisas más do que coisas boas",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 220000511,
					"content": "Foi Beidou que lhe ensinou isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Pequeno Fei"
				},
				{
					"id": 220000512,
					"content": "Aquilo que li num livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
