			"dialogs": [
				{
					"id": 240010301,
					"content": "Bem, aí está — e parece muito bem, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Me pergunto quando a Srta. Staelle perceberá que cães não amam ópera ou seus romances.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Vamos voltar — provavelmente ela está morta de preocupação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
