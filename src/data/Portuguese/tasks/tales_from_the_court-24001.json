				{
					"id": 240010501,
					"content": "Será que Barea não gosta do meu romance? *Suspiro* Mas todo mundo acha que é bem bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010502,
					"content": "Talvez eu devesser ler uma passagem melhor...",
