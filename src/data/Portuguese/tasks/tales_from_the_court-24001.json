			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea! Oh, meu bebê! Onde você estava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Ela simplesmente encontrou um lugar calmo para descansar um pouco. Um pouquinho de férias, sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "Ah, eu estava tão preocupada! Obrigada, Policial Blathine, obrigada! Você estará em meu próximo romance com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Obrigada pela consideração, mas talvez seja melhor economizar a tinta — duvido que alguém fique tão interessado no cotidiano de uma policial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Então eu simplesmente terei que dramatizar sua história... Será interessante, eu juro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Essa promessa sua já é drama demais para mim, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Ah, mas a conclusão requer consideração! Deixe-me pensar — quem eu atribuirei para ser seu parceiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
