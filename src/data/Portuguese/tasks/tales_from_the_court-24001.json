					}
				]
			},
			"dialogs": [
				{
					"id": 240010101,
					"content": "Por favor, me ajude! Eu estava pensando agora mesmo na história do romance, e antes que percebesse, Barea tinha desaparecido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010102,
					"content": "Tem certeza que você não deixou na sua cadeira na casa de ópera, ou deixou amarrada na porta do banheiro, ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010103,
					"content": "Eu já procurei em todos esses lugares. Eu até olhei debaixo do assento, mas Barea não estava lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010104,
					"content": "Oh, só de pensar que minha pequena querida Barea seria raptada por alguém, ou talvez seguisse alguém cegamente como se estivesse arrematada por um amor de filhotinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010105,
					"content": "Srta. Staelle, tenho certeza que Barea não cometeria o mesmo erro duas vezes assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010106,
					"content": "Ah, mas minha querida Barea ainda é tão pequena... e crianças cometem erros muitas vezes, e até se divertem com isso, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010107,
					"content": "Eu... tenho bastante certeza que Barea não é tão jovem quanto você diz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010108,
					"content": "E quem é esta Barea, se puder perguntar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "A cachorrinha da Srta. Staelle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010111,
					"content": "Minha família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010112,
					"content": "A... família dela, que está desaparecida, e que ela veio até mim por ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010113,
					"content": "Srta. Staelle, já procuramos nessa área. Eu apostaria que Barea foi em direção à natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010114,
					"content": "Então vamos também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010115,
					"content": "Por favor, Senhorita, peço que permaneça na cidade. Com o vestido que você usa, não conseguiria pegar Barea mesmo se a encontrasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010116,
					"content": "Baboseiras! Ora, Barea pularia em meus braços se me visse de relance!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010117,
					"content": "Então acho que ela não nos ouviu quando estávamos chamando por ela no teatro, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010118,
					"content": "Bem, aí está. Receio que não posso trazer Barea de volta à Srta. Staelle sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010119,
					"content": "Eu não posso simplesmente abandonar meu posto por muito tempo, pior ainda pedir que um colega saia do dele comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010120,
					"content": "#Mas se estiver dispost{M#o}{F#a}, Viajante, poderia nos ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010121,
					"content": "Bem, não seria um problema, exatamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "#Bem, então está decidido . Por favor, venham comigo à natureza — vamos procurar por Barea junt{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010125,
					"content": "Considerando seu peso e energia, não deve ter fugido para longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010126,
					"content": "O quê?! Minha querida Barea é a mais saudável de todas, obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010127,
					"content": "Eu concordaria — se estivéssemos falando da saúde mental dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010128,
					"content": "Vamos partir — antes que Barea adquira gosto pelo mundo exterior e fuja para mais longe ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010129,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010122,
					"content": "Vocês policiais precisam lidar com essas coisas também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "Se os cidadãos da Corte de Fontaine me pedirem ajuda, eu não tenho motivo para recusar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010109,
					"content": "Como posso lhes ser útil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
