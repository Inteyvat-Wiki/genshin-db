				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Hmm... Hã? Quem és tu que perturba meu sono de beleza...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150402,
					"content": "Hã?! Q-Quem falou isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150404,
					"content": "Aaaaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "Hahahaha! Sim, sim! Me temer é natural! Se eu não estivesse confinado a esta pedra, vocês já estariam em minha barriga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150406,
					"content": "O quê...? Ah! Então você é só uma estátua falante... Paimon pensou que fosse algum monstro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Hunf! O que queres dizem com \"só uma estátua falante\"?! Alguém como eu não seria assustador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150408,
					"content": "Hmm, já encontramos muitas estátuas como você antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "O-O quê?! *Suspiro* Certo. Parece que não tem como assustar vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150410,
					"content": "Por que você faz isso mesmo, hein? Aaaaaff! Você é só uma estátua de pedra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hunf! Mesmo se eu fosse apenas \"uma estátua de pedra\", esse lugar ainda é a morada da Herbolorde! Quando ela ainda estava conosco, ela não apreciava que outros a incomodassem quando quisessem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150412,
					"content": "E é por isso que eu assusto todos! Eu continuarei a fazer isso, mesmo que ela não esteja mais por aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150413,
					"content": "No entanto, sua presença parece um tanto diferente daquela dos mortais comuns, e considerando que eu não consegui te assustar também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150414,
					"content": "Vocês poderiam me fazer um favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150415,
					"content": "Hã? Como podemos te ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "*Cof cof* Olhe essas borboletas coloridas! Desde que a senhora do abrigo partiu, essas pequeninas se espalharam por todo lugar, voando como bem entendem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150417,
					"content": "Shh... Espere, tem uma na sua cabeça! Só um momento. Nós vamos te ajudar a pegá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7111505,
