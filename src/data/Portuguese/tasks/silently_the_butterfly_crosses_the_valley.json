			"dialogs": [
				{
					"id": 711151101,
					"content": "Ei! Você é má, a gente já pegou todas as borboletas, mas a aparência da árvore Adepti não mudou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "#Hmmm...? Quem sois vós, que perturbam a mim...? Ah, são vocês, human{F#as}{M#os} gentis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151103,
					"content": "Oh! Eu não achei que vocês tinham encontrado todas elas! Só estava dizendo que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151104,
					"content": "Não, não! Eu quero dizer que... eu sinto o poder dos Adepti! Agora só precisamos recitar a fórmula de Herbolorde para podermos revitalizar a árvore Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151105,
					"content": "Espera, o que eu tinha que recitar mesmo, hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151106,
					"content": "\"... A árvore nasce no inverno, os anos a murcham. Lembro da primavera que ela retorna ao seu esplendor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151107,
					"content": "... As borboletas batem as asas... batem as asas... e eu esqueci o resto. Enfim, no final, todas as coisas retornam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacro Despreocupado"
				}
			]
		},
