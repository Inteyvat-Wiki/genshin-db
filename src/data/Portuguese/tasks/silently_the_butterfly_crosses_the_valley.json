					}
				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Ufa... Sim, é assim mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150502,
					"content": "A Herbolorde do abrigo usava essas borboletas coloridas para adornar sua porta, mas depois que o mecanismo foi destruído. Essas borboletas coloridas e o jarro de medicina... eram originalmente destinados a nutrir a árvore adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150503,
					"content": "Árvore Adepti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Hehe, isso mesmo! Naquela época, a Herbolorde plantou essa árvore adepti ela mesma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150505,
					"content": "Ela pode estar murcha agora, mas a Herbolorde disse que, enquanto as borboletas coloridas não se dispersarem completamente, a árvore pode ser revivida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150506,
					"content": "*Suspiro* Ela partiu assim que perdeu o poder de manter sua forma humana. Eu me pergunto como ela está atualmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150507,
					"content": "\"À medida que as borboletas vívidas convergem no jarro, nova vida será restaurada à árvore murcha...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Sim, isso mesmo! Contanto que... Espera, como você sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150509,
					"content": "#Deixa pra lá. Enfim, é isso! Contanto que essas borboletas coloridas sejam colocadas de volta no jarro, nós podemos então nutrir aquela árvore murcha! Estou contando com vocês, human{M#o}{F#a}s bondos{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacro Despreocupado"
				}
			]
		},
