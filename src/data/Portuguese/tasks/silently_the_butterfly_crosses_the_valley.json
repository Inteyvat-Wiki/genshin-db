			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "Ufa... Sim, é assim mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150602,
					"content": "A Herbolorde do abrigo usava essas borboletas coloridas para adornar sua porta, mas depois aquele mecanismo foi destruído. Essas borboletas coloridas e o jarro de medicina eram originalmente destinados a nutrir a Árvore Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150603,
					"content": "Árvore Adepti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Hehe, isso mesmo! Naquela época, a Herbolorde plantou essa árvore adepti ela mesma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150605,
					"content": "Ela pode estar murcha agora, mas a Herbolorde disse que, enquanto as borboletas coloridas não se dispersarem completamente, a árvore pode ser revivida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150606,
					"content": "*Suspiro* Ela partiu assim que perdeu o poder de manter sua forma humana. Eu me pergunto como ela está atualmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150607,
					"content": "Então, o que eu preciso fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, minhas desculpas. Eu me deixei levar um pouco relembrando da minha senhora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150609,
					"content": "#Ahem! Escutem com atenção, human{M#o}{F#a}s! Contanto que essas borboletas coloridas sejam colocadas de volta no jarro, nós podemos então nutrir a árvore murcha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150610,
					"content": "Hehe, esse é o mecanismo Adepti projetado por Herbolorde. Fascinante, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150611,
					"content": "Vou tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "#Estou contando com vocês, human{F#as}{M#os} gentis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150613,
					"content": "Por que é uma borboleta colorida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Hã? Oh, sim, o porquê... talvez Herbolorde goste de borboletas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711150615,
					"content": "#En... Enfim, estou contando com vocês para mandar as borboletas de volta para os jarros, gentis human{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacro Despreocupado"
				}
			]
		},
