					"id": 711151201,
					"content": "Uau, mudou completamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "#Desde que a Herbolorde confiou a árvore a mim, eu não suportava vê-la continuar a murchar! Obrigado, human{M#o}{F#a}s bondos{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151203,
					"content": "Você nem mesmo conseguia lembrar o mantra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Não se preocupe com esses detalhes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Simulacro Despreocupado"
				},
				{
					"id": 711151205,
					"content": "#Ah, se você estiver interessad{M#o}{F#a}, eu posso te dar uma dica secreta! Quebre um galho e coloque-o no jarro quebrado do lado de fora do abrigo, e o portão de pedra se abrirá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Simulacro Despreocupado"
				}
			]
