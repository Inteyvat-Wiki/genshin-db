					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700085104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700085104,
					"content": "Depois misture tudo sem bater muito, <color=#00E1FFFF>deixe descansar por um tempo</color>, o cheiro das flores lentamente começará a ser sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700085105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700085105,
					"content": "Coloque as <color=#00E1FFFF>Sementes de Dandelion</color> e os <color=#00E1FFFF>Cubos de Gelo</color>. Assim estará bom. Se você entendeu, pode ir tentar fazer!",
					"roleType": "TALK_ROLE_NPC",
