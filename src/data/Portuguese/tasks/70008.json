			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "Afinal de contas, temos que lançar uma nova bebida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "Ah, é você. Na verdade, eu estava pensando em criar uma nova bebida especial com o tema do Festival da Brisa Florescente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080104,
					"content": "Durante o período do Festival da Brisa Florescente, todos podem se divertir, comer e beber à vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080105,
					"content": "Só que... Se continuarem bebendo, podem ficar bastante bêbados. E se ficarem bêbados demais, podem acabar sendo levados pelos Cavaleiros de Favonius para recuperar a sobriedade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080106,
					"content": "Por outro lado, o excesso de álcool poderia afetar a atmosfera festiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080107,
					"content": "Hmm. É sério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "Apesar disso... Eu também já ouvi falar que tem gente que adora esse ambiente cheio do aroma do vinho, mas ficar bêbado na rua, durante o Festival, não é uma boa opção, no final das contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080109,
					"content": "Então, eu estou pensando em fazer uma bebida não alcoólica à base de leite e com sabor do vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080110,
					"content": "Para enaltecer o sabor do vento, pensei em usar dois ingredientes especiais: Dandelions e Margaridas Voadoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080111,
					"content": "Mas se eu coletar sozinha, vai demorar muito... Viajante, você pode me ajudar a coletar um ingrediente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080112,
					"content": "Vou procurar Dandelions.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "Então eu vou deixar com você! Os Dandelions no Penhasco das Estrelas são de boa qualidade. Então posso pedir-lhe para coletar alguns lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080114,
					"content": "Também posso ir coletar algumas Margaridas Voadoras, quando você coletar os materiais, nos encontramos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080115,
					"content": "Depois de preparar a bebida aqui, procurarei alguma pessoa para prová-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080116,
					"content": "Vou procurar Margaridas Voadoras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "Por favor, você poderia ir até a Origem do Vento e colher algumas Margaridas Voadoras? A qualidade delas é muito boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080118,
					"content": "Também vou coletar algumas Sementes de Dandelion. Depois de você coletar os materiais, nos encontramos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700080119,
					"content": "Depois de preparar a bebida aqui, procurarei alguma pessoa para prová-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
