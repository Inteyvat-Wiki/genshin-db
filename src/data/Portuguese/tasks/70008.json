					"nextDialogs": [
						700081104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081104,
					"content": "Deixe-me provar... Uh? Essa bebida não tem álcool nenhum, parece igual a Leite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081105,
					"content": "Hum... Essa bebida tem um bom sabor, só que não estou sentindo o gosto de álcool, então não é muito apropriada para o Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081106,
					"content": "Afinal de contas, muita gente está ansiosa para ser um \"bêbado legalizado\" durante o Festival da Brisa Florescente. Uma bebida sem álcool como esta talvez seja muito pouco procurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
