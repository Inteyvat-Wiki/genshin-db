					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 700081102,
					"content": "Sobre a nova bebida do Festival da Brisa Florescente da Cauda do Gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "Você quer que eu prove? Hahaha, não tem problema, quando se trata de bebidas, sou um especialista.",
