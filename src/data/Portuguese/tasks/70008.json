			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "Ótimo, já temos os dois ingredientes necessários, podemos começar a preparar a bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083802,
					"content": "No final das contas, que sabor terá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "Você também quer provar uma bebida como essa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083804,
					"content": "Hum... Não é muito difícil fazer essa bebida. Basta seguir o processo criado por mim, vai sair uma boa bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083805,
					"content": "Viajante, você... Veio tentar fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083806,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "Tudo bem. Primeiro vou descrever o processo de como preparar essa bebida, preste muita atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083808,
					"content": "Primeiro coloque a <color=#00E1FFFF>Flor Doce</color>, despeje o coquetel num recipiente apropriado... Claro, o <color=#00E1FFFF>Leite</color> que estamos usando dessa vez deu um sabor doce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083809,
					"content": "Para dar um sabor de vento, coloque <color=#00E1FFFF>Margaridas Voadoras</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083810,
					"content": "Depois misture tudo sem bater muito, <color=#00E1FFFF>deixe descansar por um tempo</color>, o cheiro das flores lentamente começará a ser sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083811,
					"content": "Coloque as <color=#00E1FFFF>Sementes de Dandelion</color>, a bebida parecerá como se estivesse cheia de estrelas dentro dela. Muito bonita. No final, coloque <color=#00E1FFFF>Cubos de Gelo</color> e estará pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083812,
					"content": "A ordem é essa. Ela é muito importante para o sabor da bebida sair correto, lembre-se dela bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700083813,
					"content": "Se você entendeu, pode vir tentar. Se esqueceu, pode me perguntar novamente, não tem problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
