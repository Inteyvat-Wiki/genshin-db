						747030104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030104,
					"content": "Tá com dúvidas sobre seus 30% de participação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "Você acha mesmo que sou mesquinha assim? Só estou impressionada com como vocês se saíram tão bem cuidando do aquário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030106,
					"content": "Paimon acha que o Festival de Cinema de Fontinalia merece um pouco de crédito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "Toda essa receita... Mesmo após pagar o aluguel do Wingalet, ainda tem muito lucro sobrando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030108,
					"content": "Pensando em mudar de carreira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Nem um pouco. Não tenho ilusões quanto à minha habilidade nos negócios. Construir máquinas e estudar fórmulas é onde estão minhas paixões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030110,
					"content": "Dito isso... Ver este lugar se transformar de uma sala sem peixes no que é agora realmente tem parecido um milagre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030111,
					"content": "Hehe, bem, devemos te agradecer por nos emprestar o espaço! É tão gratificante ver todo o nosso trabalho trazendo tanta alegria para tantas pessoas! Você não acha, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hmph. Talvez um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747030113,
					"content": "Só um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "Deve ser porque ela só aceitou 30%...",
