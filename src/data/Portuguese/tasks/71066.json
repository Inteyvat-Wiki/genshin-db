					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Isso mesmo, é ele! Muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Por favor, aceite essa recompensa. Ela pode não ser muito, mas espero que você não se importe. Eu redigirei versos que contam de seus feitos e os espalharei em todas as direções!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106605,
