					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "*Suspiro*... Estranho, muito estranho mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660102,
					"content": "Ainda deveria estar por aqui... Mas por que não consigo encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660103,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Meu anel, ele sumiu... Ele é muito importante para mim, não posso tê-lo perdido aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660105,
					"content": "Como é o seu anel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "É um anel de latão, com uma gema vermelha incrustada nele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660107,
					"content": "Eu o peguei perto do lago de lava onde o lendário dragão Durin caiu. Isso explica porque ele possui um resplendor de chamas escuras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660108,
					"content": "Uau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660109,
					"content": "Dizem que o Soberano do Abismo fixa seu olhar no usuário do anel e envia um exército da escuridão para encontrá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660110,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
