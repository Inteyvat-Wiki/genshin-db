			"dialogs": [
				{
					"id": 710660201,
					"content": "Você voltou! E então, encontrou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660202,
					"content": "Veja, é seu anel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
