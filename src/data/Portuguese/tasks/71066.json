			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "*Cof* *Cof* Me desculpe. Como poeta, eu tenho um costume de acrescentar uma ficção na narrativa, deixa a história com cara de mais original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Hehe, na verdade, eu encontrei esse anel em um ninho de Furões Ladrões. Ele estava em bom estado e era bonito, por isso fiquei com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Hunf, então você é um ladrão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Não diga isso... Eu apenas o peguei, somente isso! E para mim, ele é muito precioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Você tem alguma pista sobre o paradeiro do anel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Sim... Ouvi dizer que Furões Ladrões costumam rondar essa região daqui. Eles podem ter roubado meu anel enquanto eu estava dormindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Hmm, então realmente existem pessoas que tiram seus anéis antes de dormirem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Nunca ouvi isso antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "De qualquer forma, Paimon não tem esse costume! Você precisa pensar onde vai colocar o anel ao tirá-lo, e isso é um desperdício de delicioso tempo para dormir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Será que realmente há um pequeno anel para você, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Hunf, é claro que sim! Há muitas coisas nesse mundo que você não sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Chega. Parem de julgar os costumes de outras pessoas e ficarem aí tagarelando! É muita falta de educação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "Enfim, se vocês quiserem ajudar... Por favor, procurem por ninhos de Furões Ladrões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "Ouvi dizer que os Ladrões de Tesouro estabeleceram um acampamento nesse local aqui no mapa. Venha, deixe-me marcar para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Dizem que por aqui há Furões Ladrões. É bem provável que aqueles Ladrões de Tesouro desavergonhados tenham algo a ver com eles... Enfim, por favor, deem uma olhada por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Hunf... Um anel roubado dos Furões Ladrões, para depois ser roubado por eles de volta. Paimon diria que agora está com o dono real deles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Pare de tirar sarro comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
