			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Olá, o que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "Sobre os Furões Ladrões...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Oh, você está falando dos Furões Ladrões aqui no Despenhadeiro? Haha, eu que originalmente devia cuidar deles, mas acabei estragando tudo... Não há muito o que se dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Hmm, é improvável que eu consiga capturá-los... Afinal, eles aparecem e desaparecem do nada, e são bem difíceis de rastrear...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "Mas se esses ladrõezinhos roubaram alguém, eu posso lhes dar algumas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Os Furões Ladrões treinados pelos Ladrões de Tesouro possuem um horário fixo para serem alimentados. Dentre eles, existem três tipos diferentes de Furões Ladrões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "O mais esperto deles é o Furão Ladrão Dourado... Depois é o relativamente comum Furão Ladrão de Tesouro, e ainda há o tonto Furão Ladrão Novato... Mas quanto ao horário que eles aparecem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "*Suspiro*... Deve existir algum manual sobre o seu treinamento, e o horário deve estar escrito nele. As únicas pessoas que estariam interessadas em registrar isso são os Ladrões de Tesouro. O manual deve estar no acampamento deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Oh, eu quase esqueci! Se você quiser chamá-los, basta assobiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660810,
					"content": "Assobiar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
					"id": 710660811,
					"content": "Um assobio normal já basta, não é nada complicado, o importante é só o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		}
	]
}