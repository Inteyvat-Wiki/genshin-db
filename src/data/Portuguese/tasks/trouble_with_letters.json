				},
				{
					"id": 411260804,
					"content": "Com certeza é dizendo que devido ao trabalho ele não pode vir comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 411260805,
					"content": "Quando aqueles Millelith vieram, eu pensei que meu pai estaria junto, mas não foi o que aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 411260806,
					"content": "Mas na verdade, isso é bom, porque com tantas pedras caindo do céu, se o papai estivesse aqui, seria perigoso para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 411260807,
					"content": "Você está com medo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260808
					]
				},
				{
					"id": 411260808,
					"content": "Um pouco... Mas os Millelith estão aqui, então nada acontecerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 411260811,
					"content": "Sim, por favor, leve essa carta de volta para papai, ele deve estar preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260812
					],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 411260812,
					"content": "Que estranho... Sempre acontece algo quando papai diz que vai tirar uma folga para ficar comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequena Liu"
				},
				{
					"id": 411260809,
					"content": "Não vá para os arredores da cidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260810
					]
				},
				{
					"id": 411260810,
					"content": "Eu sei, os Millelith já falaram muitas vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
