			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "Ugh, o que eu posso fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260102,
					"content": "O que foi que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "Aqueles meteoritos que caíram do céu, você também deve ter visto, os interiores da cidade estão bem, mas seus arredores estão um caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260104,
					"content": "Entretanto, os meteoritos cortaram o caminho, e os monstros nos redores parecem estar mais bravos e perigosos devido a esses meteoritos, e começaram a atacar os passageiros e comerciantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260105,
					"content": "O Ministério dos Assuntos Civis mobilizou quase todos os Millelith disponíveis. Podemos apenas manter algumas vilas e ruas principais em segurança, visto que Liyue é super vasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260106,
					"content": "Eu me inscrevi para ir para a Vila Qingce para assumir funções de guarda lá, mas por algum motivo, eu ainda fui realocado aqui para aguardar ordens...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260107,
					"content": "Viajante, você pode me ajudar levando essa carta para a Vila Qingce e a entregando para uma garota chamada Pequena Liu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260108,
					"content": "Ela é minha filha, tinha dito a ela que retornaria para encontrá-la por alguns dias, mas devido a essa situação, não posso mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260109,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "Acho difícil ser uma coincidência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260115,
					"content": "Mas, de acordo com as pessoas que trocaram de guarda que os arredores da Vila Qingce estão cheios de monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260116,
					"content": "Não quero me intrometer, mas suas roupas, você é um aventureiro, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260117,
					"content": "Quando entregar a carta, você pode dar uma olhada nos arredores da Vila Qingce e ajudar a se livrarem dos monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260118,
					"content": "Os Millelith geralmente protegem as principais estradas e caminhos... Se esses monstros conseguiram entrar na Vila Qingce secretamente, sem dúvidas, isso é algo terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260119,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Obrigado, eu fico muito feliz",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260121,
					"content": "Isso lhe custará um pouco mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Ah, quanto a isso... Não se preocupe, eu certamente lhe pagarei uma quantia adequada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260123,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260111,
					"content": "Não há nada que possa ser feito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "Eu sei, mas... Ai, é muito estranho, toda vez que quero uma folga, acontece alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260113,
					"content": "É estranho demais para ser uma coincidência...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260114,
					"content": "Eu peço a você dê essa carta para Pequena Liu na Vila Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				}
			]
		},
