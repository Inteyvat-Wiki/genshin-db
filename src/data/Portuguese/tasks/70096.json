			"dialogs": [
				{
					"id": 700960701,
					"content": "*Suspiro* Ainda assim, mesmo que fosse minha primeira tentativa, não posso acreditar que as coisas acabaram assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960702,
					"content": "Começar nunca é fácil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "Além disso, não acabou tão mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Mas sua primeira tentativa de quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Hah... Minha primeira Tarefa da Bruxa. Vou explicar tudo depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
