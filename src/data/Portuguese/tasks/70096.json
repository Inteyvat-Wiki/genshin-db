				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa! Ineffa! Você viu aquele moinho de vento?! Eu preciso que você registre como ele funciona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Entendido. Preparando para fotografar o moinho de vento. Gostaria de estar na foto dessa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Hã? {NICKNAME}, Paimon... E Lohen! Olá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Ahhh... Informações de Nod-Krai sobre um antigo dragão poderoso... Paimon sabe onde isso vai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Avaliando a situação... Parece que o Sr. Lohen espera lutar comigo. Isso está correto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "Resumidamente, sim. É exatamente isso que eu esperava fazer. Quando a expedição estava em Nod-Krai, eu não tinha razão para suspeitar que você tinha um histórico tão extraordinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Mas isso não importa. Quero testar minhas habilidades contra você há muito tempo, então... Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Hehe! Ineffa, mostra a ele quem é que manda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Peço desculpas, segundo o cronograma de hoje, ainda precisamos visitar Mondstadt para coletar alguns componentes especiais. Minhas avaliações indicam que lutar contra você agora pode impactar nossas operações subsequentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Ah, é... Quase esqueci! Eu soube que havia algum tipo de robô gigante em Mondstadt... É por isso que estamos aqui! Mas aí eu me deixei levar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Está tudo bem... Eu entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... Você não vai desistir mesmo desse jeito, né?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Se eu ajudar vocês a lidarem com os Guardas das Ruínas, isso deve liberar seu cronograma, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
