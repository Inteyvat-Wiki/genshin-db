			"dialogs": [
				{
					"id": 700960401,
					"content": "Movimentos tão fluidos... Eu nunca imaginaria que você é uma máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Seus ataques também são bem precisos, Sr. Lohen. Quase mecânicos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Uhuuul, peças novas! Vou conseguir criar uns módulos novos excelentes com elas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "E... hmm... Isso quer dizer que você está livre para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa, procura por mais! Quero o máximo que a gente conseguir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Entendido... Peço desculpas, Sr. Lohen. Podemos falar sobre isso mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Após muita exploração...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Aino dormiu... Ela se cansou brincando no Porto Dornman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "Ela é sempre assim, a bateria dela acaba rapidamente. Peço desculpas, Sr. Lohen, mas receio não poder me levantar no momento. Devo ficar aqui até Aino entrar num estado de sono profundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "...Está tudo bem. Eu já vi o suficiente para saber do que você é capaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "...Espero que meus dados de combate forneçam algumas informações úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Por acaso, a pessoa que nos contou sobre esses mecanismos especiais também mencionou a Espinha do Dragão. Vocês podem querer conferir as coisas por lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
