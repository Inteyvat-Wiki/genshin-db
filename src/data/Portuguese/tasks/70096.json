			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "#...Perseguidor{F#a} do Poder, Seguidor{F#a} do Destino, você está aqui finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "É Durin... Paimon não tá nem um pouco surpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Tem algo estranho sobre a maneira que ele tá falando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Um governante soberano, a criação de uma bruxa e descendente de anjos... Todos empunham poderes diferentes, mas todos foram coroados como dragões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "...Isso é porque dragões são um símbolo de poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Então \"batalhar contra grandes dragões\" se tornou seu jeito de provar sua força?... Acho que posso estar começando a entender a Grande Mestre fundadora um pouco melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Posso ver que você ainda tem muito a dizer, mas sugiro cruzar nossas espadas ao invés disso. Afinal, uma única espadada vale mais que mil palavras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "E-Espere! J-Jovem, o julgamento que você busca está longe daqui. Você deve ser aventurar na Toca de Stormterror e e-enfrentar a profecia final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Por que ele tá falando tão rápido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Você tá bem, Durin? Tá meio esquisito hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Ufa... Acho que passei pelas partes importantes... mesmo tendo que pular muito!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Hmm, acho que Albedo disse que ele precisava de ajuda com um experimento, então é melhor eu voltar agora. Desculpem, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Ele saiu mesmo com pressa... Que pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Ei, o que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Hmm... Por que exatamente Durin tava aqui? Fora aquela última fala sobre \"se aventurar na Toca de Stormterror\", parecia que ele só tava falando besteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Algo me diz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Interessante. Estou ficando curioso sobre como exatamente essa \"profecia\" ser concretizará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "...Que ele só estava aqui para o próximo dragão contar como o número três.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "Ele tá parecendo um ator querendo sair do palco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
