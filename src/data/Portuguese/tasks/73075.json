			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} e Paimon, obrigado, agora o jardim de Vanarana está cheio de Viparya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "Todas as Viparya estão felizes aqui então Arakara também está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "#O Festival Utsava acabou, e antes que {M#o}{F#a} Nara dourad{M#o}{F#a} deixe Vanarana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "Obteve uma Viparya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Dei a Viparya feliz para {M#o}{F#a} Nara dourado. Espero que Nara {NICKNAME} e Paimon sejam felizes também. A Viparya não murcha, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "Lembre-se de falar com ela ocasionalmente, e melhor ainda, toque música para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#A terra e Aranara não esquecerão, e espero que Nara {NICKNAME} e Paimon também não esqueçam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
