			"trigger": {
				"objectNames": [
					"Garcia",
					"Ahangar",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Este rolamento não é compatível com os demais, ele não encaixa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150102,
					"content": "O último era muito pequeno, este é muito grande! Você vai usar todos os meus Pedaços de Ferro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "A verdade é que nossos fundos estão acabando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "Por que vocês estão discutindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Essa pessoa me pediu para fazer um monte de tubos e engrenagens de aço, cada um com especificações diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "Estou acabando com todos os Pedaços de Ferro para fazer essas... coisas para ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Mas ele ainda diz que não são suficientes, e precisa de mais engrenagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "Por favor, permita-me explicar meu trabalho novamente, se você me ouvir, tenho certeza que você vai me entender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150109,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Deixe o Sr. Garcia explicar tudo ao Sr. Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "Viajante, eu... erm, o Sr. Garcia quer lhe pedir um favor. Você poderia nos ajudar a coletar alguns Pedaços de Ferro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Eu até que tenho um tempo livre, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "Sobre a construção da máquina... Encontramos alguns obstáculos há muito esperados, e o Sr. Garcia está pensando em como superá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "#Se estiver interessad{F#a}{M#o}, pode perguntar pessoalmente ao Sr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Acho que... Além do próprio Sr. Garcia, ninguém mais saberia explicar como funciona aquela máquina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Mas antes de ir até ele, por favor, traga alguns Pedaços de Ferro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "Como está a reforma da máquina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
		{
