			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Para que você quer tantas engrenagens e tubos? Você vai construir uma casa de ferro ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "Verdade, senhor! É uma casa, uma casa cheia de engrenagens. É isso que estou construindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "Decidi chamar a área que armazena uma parte das engrenagens de \"câmara\". Enquanto o restante dos rolamentos e engrenagens vão compor a \"base numérica\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "As engrenagens da \"câmara\" são usadas para armazenar e registrar números, e as engrenagens da \"base numérica\" são usadas para realizar cálculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Você vai entender melhor se eu desenhar, você tem uma folha de papel? Não? Não importa, vou desenhar na minha roupa mesmo, assim fica mais claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Você pode me passar aquele pedaço de carvão? Muito obrigado. Veja bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
}