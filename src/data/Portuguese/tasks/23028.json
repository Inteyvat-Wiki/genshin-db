			"dialogs": [
				{
					"id": 230280501,
					"content": "Yasmin! Uaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "E-Eu não consigo respirar! Tenho que dar o fora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "O que é isso?... *cof* *cof* Esse cheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280504,
					"content": "Parece que o Ladep fez um bom trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280505,
					"content": "Terminamos nosso trabalho aqui. Vamos para o próximo lugar. Não está tão longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
