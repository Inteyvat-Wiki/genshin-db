			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "Viajante, que bom que você está aqui. Eu preciso de alguém para me ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280102,
					"content": "Alguma coisa ruim aconteceu com as raízes da Árvore Divina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "Ah, a Árvore Divina está perfeitamente bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280104,
					"content": "Meu trabalho é garantir que ela esteja sempre bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280105,
					"content": "Para ser específica, estou espalhando essas poções ao redor das raízes da árvore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280106,
					"content": "Mas, não consigo carregar tantas poções sozinha. Além disso, Ladep e Pharez estão muito ocupados com seu próprio trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280107,
					"content": "Então, se você não se importa, você poderia me ajudar a carregar essas poções?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280108,
					"content": "Ladep e Pharez... Quem são eles mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "São alunos como eu. Ladep é um Spantamad, enquanto Pharez é um Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280110,
					"content": "Estamos pesquisando um tema em comum. Temos ideias diferentes, mas estamos trabalhando juntos agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280111,
					"content": "Essas poções são o resultado do nosso trabalho em equipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280113,
					"content": "Bem, eu vou levar este. Estou contando com você para o resto, obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280114,
					"content": "Tenha cuidado com isso. Ladep disse que fez a poção especificamente com um cheiro desagradável para que as pessoas não a bebessem por engano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280115,
					"content": "Se você deixar a poção cair nas suas roupas, o cheiro desagradável não poderá ser removido facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280112,
					"content": "Nesse caso, vamos lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
