			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Esse cano aqui precisa ser trocado... e as válvulas... também tem a questão de limpar a coisa... *Suspira* Problemas em cima de problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Hã? Você precisa de algo? Pela sua cara... você não parece ser do pessoal que a Estelle enviou para consertar a fonte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "Sobre Remaudiere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Oh, ele? Heh, a mágica dele é realmente interessante. Ela enferrujou uma válvula da tubulação inferior da fonte e também destruiu completamente o bocal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Haha. Estou brincando. Na verdade, foi a válvula deformada que ficou presa e travou todo o sistema de água. Por questões de segurança, desativamos temporariamente toda a fonte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Mas por que o bocal quebrou? Não entendo... que estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudiere não para de dizer que se a fonte não for consertada logo, ele vai estar em apuros... mas há um limite em tudo que consigo fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Finalmente tive tempo para comprar uma válvula e bocal novos de Estelle. Estou indo para a cidade para pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "Você pode vir comigo se quiser. Eu tenho muitas coisas para coletar, por isso acho que não vou conseguir sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
		{
