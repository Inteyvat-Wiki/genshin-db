			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "É essa fonte aqui. Então mãos a obra. Essa fonte está parada há muito tempo. Hora de fazê-la voltar a funcionar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "Os dois começam a trabalhar a todo vapor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "A válvula foi colocada. Também fiz uma inspeção geral. Não encontrei problemas maiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Muito bem. Então vamos dar uma parada no momento. O único trabalho que sobrou deve ser o de abrir a comporta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Deixe-me ver... a comporta principal está ali, e a comporta secundária também precisa ser ajustada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Por favor, espere por mim aqui. Irei abrir a comporta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Quem que desenvolveu esse sistema? Por que colocaram a comporta principal tão longe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel correu rapidamente até a comporta principal e voltou depois de um tempo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Arg, abri-las foi um sofrimento. Estou exausto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Vamos esperar um momento. A água deve estar chegando logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Depois de alguns sons abafados e tremores, a fonte voltou a funcionar normalmente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Incrível! A fonte está funcionando de novo... mesmo que Keratry comente o que aconteceu naquela noite, eu posso fingir que não sei do que ela está falando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370813,
					"content": "Agora você sabe que precisa ter cuidado com o momento que faz suas mágicas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "Esse problema não teve nada a ver com mágica... mas, obrigado, de qualquer forma. Aqui está, uma demonstração de meu agradecimento, por favor, aceite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370816,
					"content": "A recompensa que falamos antes está lá dentro aguardando por você. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370817,
					"content": "E obrigado também, Edel e Srta. Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370818,
					"content": "Apenas fiz o meu trabalho, não precisa me agradecer. Da próxima vez, não saia com sua irmãzinha tão tarde da noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Irmão, o que você tá fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry?! O que você está fazendo aqui?! Você... Você não devia estar caminhando com papai e mamãe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370821,
					"content": "Hehe... Eu fugi quando eles não estavam prestando atenção. Eu queria ver como era a fonte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Você não usou magia antes para parar ela? Eu achei que ela ainda podia estar parada hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Haha, bem, isso... haha, minha magia tem um limite, sabia? Só posso usar ela por um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370824,
					"content": "Hmm... então eu quero ver a magia mais uma vez! Irmão, você pode parar a fonte agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Ahem... Keratry, tem muitas pessoas aqui agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370826,
					"content": "Se eu quiser parar a fonte, as outras pessoas que querem ver a fonte não vão ficar felizes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370827,
					"content": "Hmm... então vamos voltar de noite! A gente aproveita para trazer mamãe e papai, eles também vão querer ver sua magia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Hã?! Não, irmãzinha... eu ainda não domino bem a magia dessa fonte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370829,
					"content": "Eu tenho certeza que papai e mamãe não vão querer ver uma magia de meia boca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370830,
					"content": "É por isso que você não deve contar nada disso para eles, Keratry.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370831,
					"content": "Quando eu dominar essa magia, vou fazer uma supresa para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370832,
					"content": "Certo! Eles vão adorar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Isso mesmo, vão adorar. Vamos voltar para casa, eu posso mostrar um truque novo para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370814,
					"content": "Mágica e milagres sempre têm um preço.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
