			"dialogs": [
				{
					"id": 740370701,
					"content": "Isso deve ser suficiente! Espera aí, terminarei em um segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle começa a trabalhar apressadamente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Muito bem. Tudo terminado. A válvula e o bocal, junto com todos os componentes secundários comumente usados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "Edel, Viajante, vamos para Erinnyes. Comigo lá, poderemos reparar a fonte rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "Desde já eu lhe agradeço... Deixe só eu pegar essas coisas aqui, Viajante. Vamos indo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
