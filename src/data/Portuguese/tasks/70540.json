			"dialogs": [
				{
					"id": 705400101,
					"content": "*Sibilo*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Miaurtorias"
				},
				{
					"id": 705400102,
					"content": "*Choro*... O gato tá fazendo esse barulho para mim, Srta. Rosaria! Estou com medo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Você provavelmente deveria dar algum espaço para ele. Se aproxime demais e todos os ataques podem te acertar na cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "Eita, parece que Valerina encontrou mais encrencas felinas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Parece que o abrigo tem um novo gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "#Cavaleir{F#a}{M#o} Honorável! Domadora de Gatos! Esse gato grande só entrou aqui atrás de Picolé! Ele deve ter visto ela quando saiu para dar um passeio e a seguiu até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Calma, calma. Ninguém vai te machucar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "Todas aquelas coisas ruins, todas aquelas pessoas ruins que te forçaram a fazer o necessário para sobreviver... Elas não podem te encontrar aqui. Você tá seguro aqui dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "Você tá cercado por pessoas boas agora. Talvez elas sejam um pouco irritantes de vez em quando, mas é tudo para seu bem. Só relaxe. Uma vida tranquila não é algo ruim, sabe. Você só precisa se acostumar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*Sibilo*... *Choro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Miaurtorias"
				},
				{
					"id": 705400112,
					"content": "E-Ele entendeu isso tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "Parece que funcionou. Haha, gato esperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "Eita, esse gato é beeeem maior que os outros. A cor dele parece com suco de Fruta Bulle fresco! E ele também tá usando uma echarpe! Hmm, parece que tem algum tipo de design nele... Oh! É o símbolo dos Cavaleiros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "Ele merece um nome adequado para um cavaleiro então! Hmm, ele é feroz igual a um cavaleiro lendário que caminhava pelo abismo. Que tal \"Miaurtorias\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Miaurtorias"
				},
				{
					"id": 705400117,
					"content": "Você tem mesmo jeito com gatos. Ele parece bem mais tranquilo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Paimon acha que Rosaria merece levar o crédito nessa. Miaurtorias parecia bem calmo logo depois de tudo que ela disse a ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "Você tá ficando muito melhor com eles, Rosaria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "Não me importo com isso. Embora... O fato de eles serem fofinhos não machuca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "#Deixa Paimon te mostrar como tranquilizar Miaurtorias completamente, {NICKNAME}! Paimon só precisa fazer um pouco mais da mágica dela e ele vai ser o mais feliz possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Com sorte, você também tá achando esse trabalho um pouco mais divertido!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Tem algo quase... respeitável sobre ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}