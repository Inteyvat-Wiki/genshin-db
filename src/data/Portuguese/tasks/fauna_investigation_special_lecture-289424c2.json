			"dialogs": [
				{
					"id": 761720301,
					"content": "Desculpe por fazer você ver isso tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720302,
					"content": "Não precisa. Eu aprendi muitas coisas hoje também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720303
					]
				},
				{
					"id": 761720303,
					"content": "Sério? Que maravilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
		{
			"id": 7617204,
			"completionStepIds": [],
