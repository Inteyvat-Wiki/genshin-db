			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "Encontrou meus sinalizadores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040202,
					"content": "Achei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Deixa eu ver... Sim, está certo, são estes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040204,
					"content": "Ugh, olhe o estado deles... Aqueles monstros não foram nada gentis com eles. Mas felizmente não estão completamente danificados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040205,
					"content": "*Suspiro* Mesmo assim, acho que não vou usá-los num futuro próximo... Ah, não tem jeito. Terei que me contentar com uma pesquisa em menor escala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040206,
					"content": "Tenho outros sinalizadores aqui. Poderia colocá-los na montanha para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040207,
					"content": "Onde exatamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "... Isso é um sim? Vou considerar como um sim! Obrigada! Vou marcar o local no mapa para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040215,
					"content": "... Pronto, agora estão claramente marcados. Basta colocar os sinalizadores na área geral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040216,
					"content": "Coloque-os em locais altos. Quanto maior a altitude, mais exata será a pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040209,
					"content": "Por que você mesma não vai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "Eu não me atreveria... Se nem mesmo uma equipe inteira de exploradores conseguiu enfrentar aqueles monstros, com certeza não voltarei lá sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040211,
					"content": "Não encontrei nenhum outro explorador planejando uma viagem para lá, mas também não posso adiar isso indefinidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040212,
					"content": "Então você é a única chance que tenho. Vendo como você trouxe meus sinalizadores de volta sem esforço da última vez, acho que você está mais do que à altura da tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040213,
					"content": "Obrigada mais uma vez. Com certeza darei uma boa recompensa para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040214,
					"content": "Espere, deixe-me marcar o local no mapa para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				}
			]
		},
