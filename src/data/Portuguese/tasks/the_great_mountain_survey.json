			"dialogs": [
				{
					"id": 701040301,
					"content": "Todos os sinalizadores foram colocados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040302,
					"content": "Sim, coloquei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "Ótimo, foi uma ajuda e tanto. Pegue isto - e mais uma vez receba meus agradecimentos por tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040304,
					"content": "Ugh, com tão poucos sinalizadores para a pesquisa, quem sabe se encontrarei algo interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
