			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "E pensar que este templo ainda está tão destruído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350402,
					"content": "Muito bem, senhorzinho, por qual motivo você do nada teve a ideia de vir aqui e consertar o templo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "*Cof* Bem, essa é uma longa história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350404,
					"content": "Enquanto fingia ser um adeptus, eu reuni muitos recursos que me ajudariam a manter a atuação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350405,
					"content": "Mas eu prometi fazer o bem depois de ter aprendido a lição com aquele adeptus, não foi? Então eu voltei e me preparei para destruir todos aqueles meus materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350406,
					"content": "Mas então eu pensei... Ao invés de destruir tudo isto, não deveria eu pegar nestes recursos e o meu códice de charlatanice e distribuí-los aos outros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350407,
					"content": "Dessa forma, eu posso ajudar aos outros descobrirem fraudes e trapaceiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350408,
					"content": "Não esperava que o guia que escrevi ajudasse tantas pessoas. Até o Ministério dos Assuntos Civis disse que era muito útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350409,
					"content": "Até me forneceram algumas contramedidas adicionais de fraude para acrescentar ao que eu mesmo tinha escrito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350410,
					"content": "Por conta disso, eles até me pagaram uma quantia considerável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350411,
					"content": "Além desse guia, estou atualmente planejando escrever um livro sobre o Guardião Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350412,
					"content": "Seu propósito, é claro, é para popularizar as histórias do Guardião Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350413,
					"content": "Dessa forma, poderei colocar o conhecimento folclórico que tenho em bom uso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350414,
					"content": "Quanto ao templo do Pardal de Bronze, eu o descobri enquanto estava juntando material para o segundo livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350415,
					"content": "Está gravado aqui que este templo foi criado para lembrar o Yaksha Pardal de Bronze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350416,
					"content": "Mas eu jamais esperava encontrar o templo em um estado tão deplorável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350417,
					"content": "Quando retornei e pensei sobre o assunto, decidi que iria financiar os reparos do templo do meu próprio bolso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350418,
					"content": "Afinal de contas, eu também fui guiado de volta ao caminho certo por um adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350419,
					"content": "Eu imagino que reparar este templo possa ser considerado como penitência pelos meus pecados passados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350420,
					"content": "Uhh... Acho que isso tudo parece verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Parece verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "O que você quer dizer com \"parece\"? Eu *estou* falando a verdade! Cem por cento verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350426,
					"content": "*Suspira* Ai, tudo bem, ache o que quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350427,
					"content": "Se você não acredita, então volte quando o trabalho tiver começado. Você vai ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350424,
					"content": "Bem, você era um golpista há pouco tempo atrás...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Mas eu não sou um agora! Eu sou um cidadão honesto! Eu não prometi que seria depois daquele adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
