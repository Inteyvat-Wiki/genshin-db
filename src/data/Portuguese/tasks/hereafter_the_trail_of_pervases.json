					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "Eu só estava de passagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350204,
					"content": "#Por que vocês {M#dois}{F#duas} estão aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350205,
					"content": "Estamos aqui para ver o Pardal de Bronze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350206,
					"content": "...Aw, mas este lugar esta tão bagunçado quanto antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350207,
					"content": "Tem um templo e uma estátua, também... Por que ninguém veio para manter o lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350208,
					"content": "Talvez este lugar tenha sido esquecido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "Mas será que deveriam? Os Yakshas são heróis que defenderam o Porto de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350211,
					"content": "Xiao, você... está bravo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350212,
					"content": "Não. Os Yakshas não fizeram sua obrigação por nenhuma forma de reconhecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350213,
					"content": "...Err, não vamos falar desse tipo de coisa agora. Peixe Tigre Frito primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350214,
					"content": "#Uhh, e se você quiser um pouco, Xiao, nós {M#dois}{F#duas} podemos te dar metade de cada um dos nossos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350215,
					"content": "Está tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350216,
					"content": "Socorro! Alguém me socorra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350217,
					"content": "Hã? Paimon consegue ouvir algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350218,
					"content": "Ali! Alguém pedindo por ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350219,
					"content": "Vamos lá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "Hã!? Mas e quanto ao Peixe Tigre Frito? Paimon ainda não terminou de comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
