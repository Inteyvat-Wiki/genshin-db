			"dialogs": [
				{
					"id": 710350101,
					"content": "O que vocês gostariam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350102,
					"content": "Três porções de Peixe Tigre Frito para viagem, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Certo! Espere só um momento, ficará pronto logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350104,
					"content": "Três porções? Uma para você, uma para Paimon... Para quem é a terceira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Vamos ver Pardal de Bronze com essa última porção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Você quer dizer o mesmo Pardal de Bronze que nos deu a Lanterna de Qixing e o Incensário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Hã, isso mesmo. Ele disse que sentia falta do gosto do Peixe Tigre Frito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Mas ele já não se foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Bem, pelo menos poderemos ir fazer uma visita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "É, faz sentido. Vamos ir visitar ele então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Quando encontramos o Pardal de Bronze lá antes, aquela construção estava em um estado bem deplorável, e tinha vários Ladrões de Tesouro pela área, também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Esperemos que a estátua dele não tenha sido desfigurada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Aqui estão suas três porções de Peixe Tigre Frito. Segurem firme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350115,
					"content": "#Ooh, esse cheiro é tão bom! Vamos lá, {NICKNAME}. Em direção à nossa próxima parada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Pardal de Bronze adora Peixe Tigre Frito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
