			"dialogs": [
				{
					"id": 200090101,
					"content": "Viajante, aqui! Venha cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090102,
					"content": "Não assuste aqueles Hilichurls, por que você está sempre correndo em direção dos acampamentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090103,
					"content": "Esquece, não é nada importante. Eu tenho estudado a língua dos Hilichurls já há algum tempo, mas eu prefiro pôr um pouco em prática ao invés de ficar só nos livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090104,
					"content": "Finalmente encontrei um acampamento inteiro de Hilichurls... Não posso deixar essa oportunidade passar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090105,
					"content": "Então, Viajante, você pode ir comigo ao acampamento e me ajudar a encontrar um Hilichurl para praticar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
