			"dialogs": [
				{
					"id": 402460701,
					"content": "Você está pronta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Sim. Vou tentar conversar com eles primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460703,
					"content": "Mas esse aglomerado de almas provavelmente já perdeu a razão. Se não for possível dialogar com elas, é bem provável que a situação acabe evoluindo para um combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460704,
					"content": "Ok, se a coisa ficar feia, Paimon vai se esconder num lugar bem seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Hum, se realmente chegarmos ao combate, deixem o golpe final comigo, vocês não interfiram. Confiem em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460706,
					"content": "Entendido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "#Tudo bem, agora fiquem quiet{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "...Almas errantes que vagam ao sabor das marés, eu vos chamo. Fragmentos de alma separados, abandonados, forçados ao silêncio, retornem seguindo o sopro do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "...Que o rancor sem nome se reconheça entre si, que a essência vil e proibida se atraia mutuamente e aqui se reagregue, tomando forma outra vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(... E então? É só isso?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460713,
					"content": "(Ah... é por isso que não consigo lidar com essas magias e arcana... não faço ideia de que etapa do algoritmo já foi alcançada, e a lógica dos rituais também me escapa completamente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460714,
					"content": "(Totalmente diferente da ciência mecânica que conheço...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460715,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460716,
					"content": "Cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Ressentimento das Almas Errantes"
				},
				{
					"id": 402460718,
					"content": "Ei, você! Ou quem quer que esteja aí dentro... Preciso que me escute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460719,
					"content": "Sou uma descendente do \"Lorde Artífice\" de Fontaine, Alain Guillotin. Posso restaurar vocês por completo e devolvê-los às Linhas Ley. Só preciso que cooperem comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460720,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Ressentimento das Almas Errantes"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Tsc... Parece que resolver isso na conversa está fora de questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460723,
					"content": "Certo, plano B... Hora de aliviar o estresse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
