				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Citlali bebeu bastante ontem, será que ela já acordou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Bom dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460203,
					"content": "Aaaah! Columbina! Você... O que você tá fazendo aqui? Quer dizer, por que você sempre aparece nas costas das pessoas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Vim aqui com todo mundo de manhã para gravar umas cenas extras, acabamos agora há pouco. Então resolvi subir no convés para tomar um ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460205,
					"content": "Parece que os outros ainda estão lá embaixo discutindo sobre o último ato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460206,
					"content": "O último ato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Sim, é o final desse filme. Todo mundo está se perguntando se a protagonista finalmente reencontrou a amiga que ela tinha no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460208,
					"content": "Ah... Paimon tava tão ocupada com outras coisas esses dias que quase esqueceu, mas esse filme de arte é sobre a protagonista descobrindo que a amiga dela desapareceu e voltando pra terra natal dela, né.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Sim, a Diretora Furina e a Srta. Chiori acreditam que, do ponto de vista da essência da história, um final trágico onde as duas nunca se reencontram seria mais comovente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460210,
					"content": "Já o Diretor Xavier acha que um final com reencontro é mais emocionante e reconfortante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460211,
					"content": "O que você acha, Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Eu? Eu... eu não sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460213,
					"content": "Se fosse \"eu\", é claro que gostaria de vê-la... Como eu queria que ela ainda pudesse se encontrar comigo... Nem que fosse num filme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460214,
					"content": "Mas significa que... outra pessoa teria que tomar o lugar dela e isso me deixa um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Não se preocupe com isso agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460218,
					"content": "Exato, exato! Não fica com essa cara triste por causa disso. Fazer filme tem que ser uma diversão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "E... Paimon garante que vai dar tudo certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "Dar certo? Quer dizer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460221,
					"content": "Err, é... é que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "Com certeza vai ter um final feliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Sim! É exatamente isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Hah... tudo bem. Eu confio em vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460225,
					"content": "Então, como vocês disseram, vou aproveitar o processo de filmar primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460226,
					"content": "#Ora, ora! Se não são {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "#Ora, ora... Se não são {F#as fujonas}{M#os fujões} responsáveis pela iluminação e pela claquete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "Err... desculpa... a gente meio que faltou bastante nessas filmagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "#Hehe, é brincadeira. Não leve a sério. Desta vez as filmagens estão indo bem, então fiquem tranquil{F#a}{M#o}s e cuidem das coisas de vocês primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Agradeço a compreensão de todos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Hm? A senhorita Columbina parece estar de muito melhor humor. Ah, desculpe, foi nossa discussão sobre o final que a deixou desconfortável, não foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Tudo bem, agora estou melhor. {NICKNAME} e Paimon me ajudaram a entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460234,
					"content": "Oh? Então você quer filmar um final com reencontro ou sem reencontro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Vamos fazer um final feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 402460236,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Depois vamos compensar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
