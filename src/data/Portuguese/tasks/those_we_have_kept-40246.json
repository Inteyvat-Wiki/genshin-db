			"dialogs": [
				{
					"id": 402460501,
					"content": "Parece que não está aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460502,
					"content": "Quer que eu comece o ritual agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Espere um pouco, vamos drenar a água deste piso da Torre de Gestalt primeiro. Assim será mais fácil se mover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460504,
					"content": "Dá pra drenar essa água?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Claro que sim. Quando Alain e René observaram o destino de Fontaine simultaneamente, eles compartilharam alguns métodos de impermeabilização de construções. O princípio é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460506,
					"content": "Aham, estou divagando. Enfim, vocês só precisam desativar os mecanismos na ordem que eu disser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
