			"dialogs": [
				{
					"id": 402460901,
					"content": "Acabou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Acabou. Eu disse que era fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460903,
					"content": "Como você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "Aquele aglomerado de ressentimento nada mais é do que o resultado da junção de inúmeras almas sem lar. Nele, estão misturadas muitas impurezas e pensamentos malignos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460905,
					"content": "Eu apenas separei suas almas originais da impureza, permitindo que fossem aceitas pelas regras do mundo atual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460906,
					"content": "O princípio da fórmula do mundo é a divergência. Partindo de uma origem, ela desestrutura e reestrutura as possibilidades do mundo, buscando uma resposta no meio disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460907,
					"content": "Ao usar a matriz numerológica para realizar a operação inversa da fórmula do mundo, é possível alcançar a função de convergência, reunião e restauração. Ou seja, a reversão da fórmula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460908,
					"content": "Isso é semelhante à redução homológica na matemática: sem alterar a essência do grupo, reduz-se os indivíduos a uma existência mais simples e substancial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460909,
					"content": "#Então... ah, esquece. Pelo jeito de vocês, não estão realmente interessad{F#a}{M#o}s em entender essas coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460910,
					"content": "Acho que agora entendo como os estrangeiros se sentem quando ouvem os xamãs dos Mestres do Vento Noturno explicando as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "E-Enfim, Paimon sabe que é incrível, isso sim! Você é realmente demais, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Haha! Eu sempre fui incrível! Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460913,
					"content": "Como esperado de quem desconstruiu todas as verdades...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Mas isso não!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402460915,
					"content": "Acho... acho que já está na hora de ir! Vou voltar lá dentro da Torre de Gestalt e restaurar os mecanismos. Nos vemos na superfície!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
