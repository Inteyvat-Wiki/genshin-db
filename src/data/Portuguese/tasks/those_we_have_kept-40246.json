					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461107,
					"content": "Onde você estava agora há pouco, Srta. Columbina? Do nada, sumiu do set e aí, de repente... Hã, apareceu junto com essa moça aqui. Se abraçando.",
					"roleType": "TALK_ROLE_NPC",
