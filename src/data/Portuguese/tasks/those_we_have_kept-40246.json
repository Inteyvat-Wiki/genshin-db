			"dialogs": [
				{
					"id": 402461001,
					"content": "Pronto, pronto! Finalmente terminei de arrumar toda essa bagunça do passado. Que alívio, me sinto bem mais leve agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Marionette"
				},
