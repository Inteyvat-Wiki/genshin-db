			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, estamos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Opa. Bem pontuais, hein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Você é que... bebeu tanto ontem, tá tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Hã? Tá me subestimando? Aquilo não é suficiente pra me deixar bêbada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Mas depois você começou a falar coisas sem sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "Foi... foi? Não tô lembrando não. Eu não falei nada... nada tão grave, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Xingou o neto por meia hora, reclamou do trabalho dos Mestres do Vento Noturno por meia hora, compartilhou light novels por uma hora... e tem mais... Uh, acho que Paimon dormiu depois disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "...Elas já foram embora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461209,
					"content": "Elas? Ah, você tá falando da equipe de filmagem, né. Já foram embora, a gente esbarrou nelas no convés.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Mas já que você resolveu seus problemas, por que não vai logo ver a Columbina? Ela tá morrendo de vontade de te ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Eu... quero primeiro resolver essa bagunça que tá na minha mão antes de encontrar com ela. Além do mais, uma chance tão boa dessas de dar um susto nela, é claro que eu vou planejar bem direitinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461212,
					"content": "Mas chega disso. Você encontrou a localização do agregado de impurezas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461213,
					"content": "Claro, quando a Vovó Itztli promete algo, ela cumpre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Obrigada. Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461215,
					"content": "Região Mortaine... Hmm? Não é a Torre de Gestalt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461216,
					"content": "Será que o maior rancor ainda é pelo lugar onde a alma foi cortada? Ou então... seria rancor contra Cruz de Narcissus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461217,
					"content": "Vou com vocês. O lugar onde essa coisa aparece não é muito fixo. Se não estiver lá, eu também sei como atraí-la com algum tipo de ritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Sério? Mas isso já causou muitos problemas para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461219,
					"content": "Deixa disso. Eu já fico à toa mesmo. Fazer uma invocaçãozinha pra galera nova não vai me pesar não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(Se eu não for com vocês, quem sabe o papo que vocês vão puxar que eu fico de fora?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Tudo bem, então conto com você. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 402461222,
					"content": "Hehe, não temos tempo a perder. Vamos partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
