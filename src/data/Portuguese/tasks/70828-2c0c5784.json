					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(Entregar \"A Canção de Ay-Khanoum\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Eita, que belo livro! Tudo bem, vejamos o que diz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "\"...Nenhum trono se ergue sem serpentes sob ele, nenhuma rosa floresce livre de espinhos. Beba o amargor da gota final, Ferigees, e com aqueles seus meigos olhos, prometa-me... prometa-me...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Hmm... espera, como se pronuncia isso mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "#É, isso aí é profundo demais pra mim! Minha língua já tá toda revirada! Vou levar para casa e ler devagar mais tarde... Obrigado, aventureir{M#o}{F#a} de cabelos dourados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(Entregar \"O Cânone do Amor, Inspiração Divina e Virtude\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Ah! Já ouvi falar desse. É a coleção de poesia da Igreja Favonius, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Vejamos... \"A alma dela é um campo em chamas, derramando sua canção ardente pelo vento. Entre as estrelas, a lua e o sol radiante, até minha própria luz é queimada pelo brilho dela...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "Que tipo de poema é esse? É meio perturbador, na verdade... e a Igreja Favonius claramente não sabe nada de poesia. Digo, estrelas, lua e sol aparencendo juntos? Tá certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "#Bem, está decidido! Minha confiança voltou. Se esse é o nível de poesia nesse livro, então até eu consigo fazer melhor. Vou comprar. Obrigado, aventureir{M#o}{F#a} de cabelos dourados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
			"completionStepIds": [
				7082804
