			},
			"dialogs": [
				{
					"id": 708280701,
					"content": "(Entregar \"Brisa na Floresta\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Haha, Brisa na Floresta? Qual é, sou uma barda brilhante. Você acha que eu não ia conhecer esse? Eu já li de capa a capa mais vezes do que consigo contar! Você não tem nada novo?",
					"roleType": "TALK_ROLE_NPC",
