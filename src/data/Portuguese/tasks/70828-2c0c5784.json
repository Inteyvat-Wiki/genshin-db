				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(Entregar \"O Sonho de Rhonabouillet\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Ah, uma coleção de poesia de Fontaine! Me mostra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "Viajando de volta ao passado... a corte da Cavaleira da Água Pura... e ele se apaixona por uma empregada à primeira vista...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "Pfft! Isso é hilário! Você tem a chance de voltar no tempo e a única coisa que você pensa é ir atrás de romance com alguém da idade de uma ancestral sua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Ah, então esse é o ponto. É um poema de amor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "#Hah, agora entendo. O amor faz mesmo as pessoas perderem o sentido. Enfim, vou comprar e ler adequadamente mais tarde. Obrigado, aventureir{M#o}{F#a} de cabelos dourados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
