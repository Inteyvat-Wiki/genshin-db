	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "#Ah! Com licença! Você, aventureir{M#o}{F#a} de cabelos dourados! Por favor, espere um momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Você precisa da nossa ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Ah, não, não é nada disso! Eu só queria perguntar se você tem, por acaso, uma coleção de poemas sobre amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Olha, sou uma barda incrível, talvez a mais incrível de toda Mondstadt depois do próprio Lorde Barbatos! Sério, sou a elite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Mas tem Linus... aquele bardo irritante nunca parece admitir que sou melhor! Ele aparece o tempo todo, recitando poemas para mim sem parar! Não importa como você olhe para isso, ele com certeza tá tentando passar a perna em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "E o pior? Cada poema é sobre amor e romance... Coisas que nunca nem cheguei perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Então estou tomando as rédeas da coisa toda. Vou escrever um poema de amor tão épico que Mondstadt nunca vai esquecer! Isso vai ensinar a ele o que é talento de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Claro... já que estou dedicando todo meu tempo à busca de arte realmente grandiosa, não tive chance de experimentar o amor eu mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Então, se você tiver uma coleção de poesia sobre o amor, por favor, me venda! Eu só preciso dar uma olhadinha rápida. Quando eu fizer isso, a inspiração me inundará. Com talento como o meu, isso é praticamente inevitável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Receio não poder ajudar. Tenho mais o que fazer. Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "Não, não! Eu não queria pedir sua ajuda. Afinal, se todos pedissem ajuda a um estranho sempre que algo desse errado, ninguém ia viajar nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "Ahem. Eu só queria perguntar se você tem um livro de poemas de amor, por acaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
