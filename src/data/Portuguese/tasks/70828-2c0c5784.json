			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Haha, obrigado, aventureir{M#o}{F#a} de cabelos dourados! Você é {M#meu herói, o maior de todos}{F#minha heroína, a maior de todas}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Já consigo sentir a inspiração inundando minha mente, como os ventos da Toca de Stormterror, o miasma do Vale Chenyu e os trovões da Ilha Seirai... Está tudo prestes a explodir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Isso parece meio perigoso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Heh, pode aguardar! Estou escrevendo todas essas ideias nesse momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Os poemas pretensiosos de Linus não terão a mínima chance. Quando minha obra-prima estiver concluída, tavernas por todo Teyvat estarão preenchidas com meu nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082806,
