				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "*Choro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200102,
					"content": "Aah! É Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200103,
					"content": "Ahem... Lamento que Nara tenha me visto em um estado tão bagunçado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200104,
					"content": "Nara gentil, eu sou Arachatora. Quem são vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200105,
					"content": "#Eu me chamo {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "Paimon se chama Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200107,
					"content": "#Nara {NICKNAME} e Paimon, entendo. Muito obrigado. Se não tivesse encontrado com vocês aqui, teria tomado mais tempo para me recuperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200108,
					"content": "Quanto tempo é \"um pouco mais\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200109,
					"content": "Tenho vergonha de dizer isso... mas algo parecido aconteceu uma vez devido a má qualidade de cogumelos. Os Lótus Nilotpala na água floresceram e fecharam, duas vezes, antes de eu me regenerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200110,
					"content": "Floresceu e fechou... Isso não leva dois dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200111,
					"content": "Ah, dois dias. Entendi, então é isso que um dia significa. Vocês Nara são realmente interessantes. Então me digam, dois dias é longo ou curto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200112,
					"content": "#Hmm... O que você acha, {NICKNAME}? É longo ou curto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200113,
					"content": "Longo, suponho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Uh-huh, Paimon não consegue imaginar como Arachatora ficou choramingando por dois dias inteiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200115,
					"content": "Sério? Então é muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200126,
					"content": "Mas, se você se chama Arachatora... Você não é um familiar de Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200127,
					"content": "Não sou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200128,
					"content": "Hã? Mas... Você é o irmão mais velho de Arapacati, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200129,
					"content": "Oh, como vocês sabem? Arapacati é minha \"irmã mais nova\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200130,
					"content": "O que está acontecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200131,
					"content": "Talvez isso seja diferente para os Aranaras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "De qualquer forma, o que aconteceu foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200133,
					"content": "Você conta para Arachatora o que aconteceu.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "O Festival Utsava está chegando de novo... O que devo fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200135,
					"content": "Eu não preparei nenhum ingrediente importante ainda. O Festival Utsava deveria ser a melhor época para provar a grandeza de pratos de cogumelo para Arasaka, Arapas e Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200136,
					"content": "Então, Ara... Arasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200137,
					"content": "Arasaka, Arapas e Araphala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "Aaah! Por que os nomes dos Aranaras são tão difíceis?! Arachatora, onde estão seus irmãos?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200139,
					"content": "Nós nos separamos em nosso caminho de treinamento, assim como um rio se divide em riachos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200140,
					"content": "Então vocês se separaram, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200141,
					"content": "Treinamos para cozinhar a iguaria suprema. Mas eles se recusam a reconhecer os pratos de cogumelo. Como eles não conseguem ver que Cogumelo Cabeça é insuperável?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200142,
					"content": "Enfim, decidimos completar nossos pratos e competir uns contra os outros depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200143,
					"content": "Oh, Paimon entende a busca por comidas deliciosas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200144,
					"content": "Então, onde está sua Cabeça de Cogumelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200145,
					"content": "Marana vem se espalhando rapidamente. Até o habitat do \"Cogumelo Cabeça\" foi tomado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200146,
					"content": "Ah, o Definhamento... Paimon espera que Rana esteja bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200147,
					"content": "Suas garras fulminantes provavelmente levaram os preciosos cogumelos para lá. Tenho certeza que vocês sabem o quão perigoso é o território de Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200148,
					"content": "Sem Cabeça de Cogumelo, só podemos provar os cogumelos estranhos que nenhum Aranara provou antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200149,
					"content": "E?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200150,
					"content": "E vimos o resultado disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Eu realmente sinto muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200153,
					"content": "Agora que Paimon pensa sobre isso, o Definhamento... Marana... Já lidamos com isso antes, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200154,
					"content": "Não foi nada demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "Uau, inacreditável! Você pode lutar contra Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200157,
					"content": "#Bem, faz sentido. Já que Nara {NICKNAME} pode me curar com o poder do Lorde Menor Kusanali, então remover o efeito de Marana não deve ser um problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200158,
					"content": "#Eu gostaria de pedir que Nara {NICKNAME} viesse comigo para o habitat do Cogumelo Cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200159,
					"content": "#Essa é a nossa chance de provar um cogumelo delicioso! {NICKNAME}, vamos ajudar a reunir esses irmãos de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200160,
					"content": "Demos nossa palavra a Arapacati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "Tudo bem, está na caverna em frente. Sigam-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200161,
					"content": "Você só está fazendo isso pela comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "Estamos matando dois coelhos com uma cajadada só! O que tem de errado nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200155,
					"content": "Foi mais difícil do que eu pensei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "O choro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Curto, suponho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "Hum... Verdade. Parando para pensar, já nos conhecemos há muito tempo, mas parece que foi ontem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200118,
					"content": "Sério? Que alívio. Portanto, ficar sem controle por dois dias na floresta não é muito longo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200119,
					"content": "Não foi isso que quisemos dizer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200120,
					"content": "Depende de como esse tempo foi usado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Bem... É verdade. Dois dias inteiros de choro é muito, mas dois dias inteiros na vida de um javali da floresta é pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200122,
					"content": "Sério? Então é muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200123,
					"content": "O tempo é um conceito subjetivo, não tem significado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Sim. Nara {NICKNAME}, você entende os princípios da floresta bem. Para a floresta, a vida nasce, cresce, e retorna para a terra... Tudo isso não precisa de um conceito como \"dia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200125,
					"content": "Você não está fazendo sentido nenhum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302005",
							"2"
						],
						"stepId": 7302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "Aaah! É o Cogumelo Cabeça que eu sempre sonhei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "Cabeça Cogumelo, você ainda seria o mesmo sem o seu cheiro doce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "Hehe... Esse cogumelo realmente tem um cheiro bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "De qualquer forma, vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "Eu tenho muita sorte de ter conhecido vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200302,
					"content": "Este é o cheiro do Cogumelo Cabeça totalmente maduro. Está ainda melhor que da outra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200303,
					"content": "Então, você cresceu bem mesmo quando a Marana ocupou o seu habitat. Você é incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200304,
					"content": "Hã, então... Podemos prová-lo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200305,
					"content": "Claro. Além de me ajudarem, servir o prato de cogumelo mais delicioso para Nara sempre foi o objetivo do meu treinamento culinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200306,
					"content": "Uhul! Cogumelo Cabeça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200307,
					"content": "Arachatora imediatamente começa a cozinhar...\\nA panela exala o aroma fresco do cogumelo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "Quando está pronto, Arachatora serve para você e Paimon.\\nPoderia ser considerado decepcionante? Ou de acordo com as expectativas? Não tem gosto nenhum.\\nAlém disso, está cheio de vitalidade e duro demais ao ponto de ser difícil de mastigar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "... Está pronto. Meu treinamento culinário finalmente está completo. O que acham? Eu tenho certeza que é a melhor iguaria para Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200310,
					"content": "*Nhac nhac*... *Gulp*... Hã, como Paimon pode dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200311,
					"content": "(Mastiga forçado...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "(Engole forçado...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "É comestível. Mas se você forçar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Hmm... É um cogumelo com um cheiro ótimo, mas a sua textura e gosto não combina muito com a gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200317,
					"content": "Como é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200318,
					"content": "#Como isso é possível? Quando eu servi para {F#o outro}{M#a outra} Nara antes, {F#ele}{M#ela} disse que era gostoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200319,
					"content": "Antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200320,
					"content": "#Eu servi meu prato de cogumelos para {F#um}{M#uma} Nara um tempo atrás, e como era tão delicioso, {F#ele}{M#ela} engoliu de uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200321,
					"content": "Deveria estar bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200323,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "Oh, assim como cada Aranara tem folhas diferentes, o gosto dos cogumelos pode não combinar com todos os Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200325,
					"content": "Oh, isso! Falando de folhas... Os Aranaras não têm medo do fogo? Você claramente está coberto de folhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200326,
					"content": "Claro que é assustador. Incêndios florestais às vezes destroem florestas inteiras, até restar apenas o solo chamuscado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200327,
					"content": "Mas isso é pelo meu treinamento culinário, por isso tenho que controlar meu medo, e controlar a temperatura das chamas é parte de meu treinamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200328,
					"content": "Entendi... Acho que é hora de voltar. Arapacati está esperando por vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200329,
					"content": "Sim, retornarei para Vanarana imediatamente. Não posso permitir que minha importante irmã fique se preocupando comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200330,
					"content": "Quanto aos outros... Arasaka, Arapas e Araphala estão <color=#00E1FFFF>nos arredores de Vila Gandharva</color>, <color=#00E1FFFF>na Floresta Apam</color> e <color=#00E1FFFF>na Montanha Devantaka</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200331,
					"content": "#Obrigado. Nara dourad{F#a}{M#o} é brilhante como o sol, e Paimon é um pouco fantástica também. Deixarei a comissão de minha irmã com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200332,
					"content": "Ei! Por que Paimon é só \"um pouco fantástica\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200333,
					"content": "Ah, não se preocupe com isso... Enfim, não sei como retribuir toda a ajuda que você me deu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200334,
					"content": "Hmm... Eu resolvi dar a receita da Iguaria Suprema para você. Talvez você passe a gostar dela com o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}, deixa Paimon modificar um pouco esta receita... Deve virar um prato original bem bom!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200314,
					"content": "Pelo menos não é venenoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "É muito cedo para eu comer algo assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
		{
