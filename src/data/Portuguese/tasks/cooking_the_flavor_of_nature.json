					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "#Estou tão feliz por ter conseguido reunir o \"Cogumelo Cabeça\", completar meu Treinamento Culinário e conhecer {F#uma}{M#um} Nara forte e confiável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Arapacati, Arasaka, Arapas e Araphala também lhe são gratos. Nara {NICKNAME}, você é {F#uma boa}{M#um bom} Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Gratos? Por quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Porque ao me ajudar, lhes deu a chance de provar Cogumelo Cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
