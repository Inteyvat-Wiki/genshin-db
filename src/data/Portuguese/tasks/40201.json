				{
					"id": 402010417,
					"content": "Vocês então descreveram para a Yelan o conteúdo da carta deixada pelo Golpista para Corder e Doddamani.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
