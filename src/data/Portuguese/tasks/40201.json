			"dialogs": [
				{
					"id": 402010501,
					"content": "Agora está confirmado, aqueles dois vilões estão realmente com pressa para enviar a maior parte da mercadoria para Fontaine de uma vez, sem truques enganosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010502,
					"content": "Mas o que será que significam aquelas mercadorias com marcas estranhas...? Vamos perguntar à Yelan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010503,
					"content": "Você encontra a Yelan e conta a ela os resultados da investigação...",
