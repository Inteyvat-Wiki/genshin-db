			"dialogs": [
				{
					"id": 402010101,
					"content": "#Muito bem, vocês {M#dois}{F#duas}. Bem na hora certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Como está indo o trabalho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "No dia seguinte à nossa infiltração na área de armazenamento, os dois lacaios do Financiador Sombrio, Corder e Doddamani começaram a movimentar as mercadorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Vê aquele barco? É o que o Doddamani enviou para transportar as mercadorias. Ele opera sob o disfarce de um navio conjunto de passageiros e carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Uau, esse é um barco enorme! Paimon consegue ver todas as mercadorias empilhadas no píer! Parece que ele também está transportando alguns passageiros para o Porto Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "E se essas mercadorias não forem as de verdade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Pensando dois passos à frente? Gostei disso. Você aprende muito rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Se Corder e Doddamani acham que as autoridades estão atrás deles, é possível que as mercadorias sejam um monte de nada. Apenas uma isca para afastar os agentes da lei que estão atrás deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Mas tome cuidado, de acordo com as informações fornecidas pelos prisioneiros capturados, o veterano dos Ladrões de Tesouro conhecido como \"O Golpista\" também está colaborando com o Financiador Sombrio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "O Golpista é um prisioneiro foragido e um mestre em permanecer escondido. Com base em nossa investigação anterior, está claro que é ele quem está fazendo o reconhecimento do farol dos Millelith.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "#Vou circular pela área para desviar a atenção do Golpista da cena enquanto vocês {M#dois}{F#duas} inspecionam as mercadorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Lembre-se de agir discretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Entendi. Irei tomar cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#É! E Paimon vai tentar... voar mais perto do chão! Não mais alto que os ombros de {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Não se preocupe. Eu cuido disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Deveríamos investigar elas por precaução?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Algum desenvolvimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
