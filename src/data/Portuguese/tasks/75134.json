					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340404,
					"content": "Você conta a Bona sobre tudo que aconteceu lá embaixo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751340405
					]
				},
				{
					"id": 751340405,
					"content": "Hã!? Você encontrou outro pedaço de Pyrofosforita? Uau, e cá estava eu achando que aquela que eu tenho era a única do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340406
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340406,
					"content": "Espera, será que a minha é falsificada? ...Hmm, talvez esse seja o motivo que eu não percebi nada especial sobre ela todos esses anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340407
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340407,
					"content": "Não pode ser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340408
					]
				},
				{
					"id": 751340408,
