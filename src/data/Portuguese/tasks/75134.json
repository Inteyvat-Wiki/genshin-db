			"dialogs": [
				{
					"id": 751340201,
					"content": "Rrooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "Urg, o exterior foi corroído pelo Abismo. Parece que vai cair a qualquer momento. Era isso que Coco estava apontando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340203,
					"content": "E nós não sabemos o que está lá dentro, embora Paimon tem quase certeza que não é o Altar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340204,
					"content": "\"Lógica rígida não vai nos levar a lugar nenhum...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "Agora Paimon entendeu. Coco não quis entrar por causa do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340206,
					"content": "Precisamos fazer algo sobre o Abismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "É, e deve ser por isso que Coco não quis entrar. Temos que nos livrar dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340208,
					"content": "#Vamos lá, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "Espera, e quanto a Paimon? Grosseria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340211,
					"content": "Vamos nos livrar de toda essa sujeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
