			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "Todos nos deram muitas informações úteis. Vamos passar por isso e tentar organizar tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530802,
					"content": "Algumas coisas que ouvimos foram bem diretas, mas outras eram ridículas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530803,
					"content": "Devemos ser capazes de descobrir mais sobre sua identidade e localização.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "É, deixe-me pensar e ver o que posso fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530805,
					"content": "(Certo, acalme-se Layla. Eu sei que a informação está por toda parte, mas você definitivamente consegue.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530806,
					"content": "(Primeiro, vamos tentar descobrir a identidade da Seelie baseada nas pistas que temos no momento.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530807,
					"content": "(Então, iremos analisar onde foi avistada e seus motivos... Finalmente, poderemos colocar tudo junto...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530808,
					"content": "(Daí, poderemos prever seus movimentos. Muito bem, vamos tentar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
						],
						"stepId": 1915304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Certo, acho que agora consigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "Então, o que você planejou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "Primeiro, baseada nas informações que Katayoun nos deu, podemos assumir que a Seelie é uma estudante do Darshan Rtawahist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "A possibilidade de ser alguém de fora desse Darshan pode ser excluída, pois é impossível conseguir acesso a esses dois livros sem passar pela bibliotecária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "Em seguida, deixando as habilidades doidas de lado, todos os avistamentos foram feitos em lugares que são oficialmente recomendados para observação astrológica pela Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "Em outras palavras, está apenas conduzindo pesquisa, e a natureza de sua pesquisa é muito parecida com a minha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "A questão que eu submeti não era uma simples pergunta, mas ela conseguiu me dar uma resposta em apenas um dia. Isso implica que tem familiaridade com um campo de conhecimento similar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "Então, baseado neste raciocínio, tudo que temos que fazer é esperar por ela no próximo local de observação astrológica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "Seu raciocínio é confiável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "Ah, uh... não é nada, sério. Na verdade, há alguns outros fatores sobre os quais eu estive especulando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "Mas isso não é importante agora, vamos prosseguir. Apesar de termos uma pista, ainda é difícil dizer se conseguiremos fazer alguma descoberta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "Eu vou contar o que quero dizer com isso se a Seelie não aparecer..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "Olhe só para você, terminar sua tese não deve ser problema algum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}