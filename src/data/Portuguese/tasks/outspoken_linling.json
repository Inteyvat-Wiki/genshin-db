			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "Hum... O melhor é ir no local buscar inspiração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "Estou ajudando alguém a pensar em coisas para escrever nas Lanternas Celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360104,
					"content": "É o Ritual de Lanternas, todos não estão soltando Lanternas Celestes? E também escrevendo algum desejo nelas, algo como uma bênção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360105,
					"content": "E para combinar com a atmosfera festiva, algumas pessoas podem querer que seus desejos e bênçãos estejam escritos com um... Como posso dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360106,
					"content": "Com um certo talento literário, vamos dizer assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360107,
					"content": "Bibo, Gerente do Estaleiro Xiao e Degui me pediram para ajudar eles a escrever uma bênção com tal talento literário. Depois de escrever na Lanterna Celeste, eu as darei para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360108,
					"content": "Mas se eu só escrever parada aqui, não sairá nada de bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360109,
					"content": "Entao, primeiro quero preparar a Lanterna Celeste. Depois quero observar as pessoas que me pediram para escrever nelas para fazer bênção de acordo com elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360110,
					"content": "Mas eu não sei como fazer uma Lanterna Celeste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360111,
					"content": "Podemos ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "Mesmo? Muito obrigada. Por favor, me ajude e faça três Lanternas Celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360114,
					"content": "Depois vamos até o local para ver o que devemos escrever nas bênçãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360115,
					"content": "Haha, eu tenho uma certa noção do que vou escrever. Só preciso procurar um pouco mais de inspiração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360112,
					"content": "Eu sou excelente em fazer Lanternas Celestes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
