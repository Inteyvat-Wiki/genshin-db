			"dialogs": [
				{
					"id": 413360401,
					"content": "O Gerente do Estaleiro Xiao está ali. Vamos ficar aqui e observar ele um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360402,
					"content": "Deixe-me pensar. Tenho boas impressões do Gerente do Estaleiro Xiao. Posso escrever uma mensagem para ele rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360403,
					"content": "Vou ler para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360404,
					"content": "\"Esse velho com má cara não tem bom humor\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360405,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "\"Porém, ele tem um bom coração\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360408,
					"content": "Hum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "Agora, o título. O título é... \"No fundo, uma boa pessoa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360411,
					"content": "Muito apropriado, não acha? Apesar do Gerente do Estaleiro Xiao parecer muito amedrontador, ele é uma boa pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360412,
					"content": "Há alguma outra alternativa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "Não, só essa... Mas parece que não faço ideia de como continuar com esse tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360414,
					"content": "Você quer me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360415,
					"content": "A primeira frase é \"Os jovens chegam e enfrentam seu olhar impressionante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360416,
					"content": "\"O vento passa e ele dorme pacificamente nas montanhas\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "Creio que está bom... Mas ainda falta um título...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360418,
					"content": "Uh... \"Pacífico como uma montanha\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "#Isso! Você é realmente talentos{F#a}{M#o}. Esse título está ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360420,
					"content": "Escreverei isso na Lanterna Celeste, espere um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360421,
					"content": "Pronto, escrevi. Vamos entregar a Lanterna Celeste para o Gerente do Estaleiro Xiao",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360409,
					"content": "É melhor que você não continue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "Espere um pouco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
