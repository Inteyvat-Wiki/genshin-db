			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "Ah, é a Linling, você precisa de alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "Gerente do Estaleiro Xiao"
				},
				{
					"id": 413360502,
					"content": "#Na última vez que lhe vi, você me pediu para lhe escrever uma mensagem na Lanterna Celeste. Eu e {F#essa}{M#esse} Viajante escrevemos junt{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360503,
					"content": "Eu lhe ajudei a escrever uma mensagem na Lanterna Celeste. Aqui está ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360504,
					"content": "Muito obrigado, Linling, deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "Gerente do Estaleiro Xiao"
				},
				{
					"id": 413360505,
					"content": "\"Os jovens chegam e enfrentam seu olhar impressionante\", \"O vento passa e ele dorme pacificamente nas montanhas\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "Gerente do Estaleiro Xiao"
				},
				{
					"id": 413360506,
					"content": "\"Pacífico como uma montanha\"... Haha, ficou ótimo. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "Gerente do Estaleiro Xiao"
				},
				{
					"id": 413360507,
					"content": "Não precisa agradecer. Eu tenho aqui uma mensagem que eu mesma escrevi, deixe-me lê-la para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360508,
					"content": "Vamos logo procurar a próxima pessoa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "Oh, isso mesmo... Está bem, vamos procurar por Degui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360511,
					"content": "Tenho orgulho da mensagem que escrevi para Degui. Em breve falarei ela para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 413360509,
					"content": "Ainda há Lanternas Celestes que não entregamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				}
			]
		},
