					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "Aqui está uma Aurora Beijada pela Neve, espero que goste!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "Está uma delícia, fofura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480203,
					"content": "Acidez agradável, doce sem ser enjoativa, suave no paladar, além de deixar um gosto refrescante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480204,
					"content": "Após tomar essa bebida, pareço estar um pouco mais animada do que eu gostaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480205,
					"content": "Talvez você desvendou o segredo de Glenfidia sem saber e produziu uma bebida ainda mais energizante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480206,
					"content": "Será que mexo nos ingredientes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "Não se preocupe, não há pressa! Seus olhos estão brilhando com curiosidade, como se tivesse muitas outras perguntas a fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480209,
					"content": "Vamos conversar um pouco. Vá com calma... A inspiração chegará logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480210,
					"content": "Quais livros você coletou hoje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "*Suspiro* Já que você está me perguntando, foi um dia um pouco incomum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480212,
					"content": "Tem uma chef que acabou de se formar em Fontaine e que assumiu uma vaga no Grand Hotel Goth. Ela pegou emprestado nosso livro mais valioso, \"O Compêndio Milenar de Sobremesas de Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480213,
					"content": "Aparentemente, ela planeja usar técnicas de confeitaria para melhorar o sabor de vários pratos salgados. Algo sobre reduzir a oleosidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480214,
					"content": "Sobremesas de carne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "De fato... e julgando pelos resultados, ela exagerou no molho de caramelo. O que deveriam ser fatias de carne cheirosas acabaram enjoativas de tão doces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480217,
					"content": "Caramelo é mesmo um ingrediente fantástico, sabe? Nunca falha em agradar ao ser colocando em bebidas. Às vezes, eu até coloco uma colher no meu chá da tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480218,
					"content": "Acho que melhorar comida não é sobre ser o mais criativo possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480219,
					"content": "Por acaso... isso é um caderno que você trouxe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "Ah, isso? Era para outro dos trabalhos de hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480221,
					"content": "Um grande contingente da equipe de expedição retornará a Mondstadt logo. Eles ficaram longe tanto tempo, então tem uma boa chance que muitas dos gostos deles mudaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480222,
					"content": "Jean me pediu para visitar algumas famílias para tentar entender melhor quais novos ingredientes poderiam satisfazer as novas preferências dos nossos cavaleiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480223,
					"content": "Que planejamento detalhado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "Bem, todos dedicaram seu sangue, suor e tempo protegendo Mondstadt. Eles merecem um pouco de cuidado e respeito em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480226,
					"content": "Baseado no que reuni, o ingrediente mais solicitado foi Cacahuatl de Natlan. Parece que nossos cavaleiros desenvolveram uma afinidade por cacau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480227,
					"content": "Nas cartas deles, muitos mencionaram dependerem de cacau para se manterem energizados. Eu mesma experimentei chocolate quente e, devo dizer, achei tão eficiente quanto café no quesito ficar alerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480228,
					"content": "Foi para algum lugar fora da cidade recentemente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "É claro que você não está sugerindo que eu aproveite esse oportunidade para sair em um passeio pelo campo?... Hehe, você me pegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480230,
					"content": "Minhas investigações sobre as bebidas menos conhecidas de Mondstadt me levou até a Adega do Alvorecer, onde tive uma conversinha com a empregada chefe, Adelinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480231,
					"content": "No meu caminho de volta, encontrei Ematol em patrulha. Ela havia encontrado alguns monstros que não sabia como lidar e, em desespero, me pediu ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480232,
					"content": "Eu a acompanhei num desvio ao Reino dos Lobos para ensinar uma lição a alguns cães agressivos... Já faz um tempo desde que tive um treino tão revigorante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480233,
					"content": "Então, que tipo de ingredientes você gosta recentemente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "\"Recentemente\"? Quanto cuidado com suas palavras, fofura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480235,
					"content": "Isso é por que você acha que eu também posso ter mudado desde que nos encontramos pela última vez... ou você simplesmente não consegue lembrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480236,
					"content": "Bem, você é viaja e lê tanto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "Nada mau! Uma resposta perfeita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480239,
					"content": "Nos meus dias de estudante, eu posso ter sido atraída para cada novo ingrediente que lia sobre, expandindo constantemente meus horizontes e saindo da minha zona de conforto. Mas agora, me acostumei a uma vida de conforto e rotina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480240,
					"content": "Para parafrasear um especialista jurídico de Liyue, minha vida está rapidamente se aproximando de um estado de \"viver os anos dourados em paz e conforto\". Não sou mais tão facilmente emocionada por aventuras e agitação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480241,
					"content": "#Tenho certeza que você lembra que há alguns anos quando estávamos nos aventurando junt{M#os}{F#as}, você encontrou para mim aquele ingrediente alquímico doce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480242,
					"content": "Bem, meus gostos não mudaram nem um pouco desde então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480243,
					"content": "Tudo bem, acho que sei o que vai ser bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "Me deixa preparar uma nova versão melhorada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "Como esperado, fofura, sua mente brilhante está ainda mais afiada. Só alguns toques gentis foram necessários para acender aquela fagulha de inspiração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
