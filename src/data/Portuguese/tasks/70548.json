					"nextDialogs": [
						705480302
					]
				},
				{
					"id": 705480302,
					"content": "Isso deve ajudar você a dormir rapidamente e garantir sonhos tranquilos. Se chama \"Rosa do Sonho\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "Das cores de escolha ao copo, tudo foi feito com bastante atenção. Você transformou isso numa bebida completamente diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480304,
					"content": "Baseado puramente em aparência, é exatamente meu estilo! Hora de experimentar...",
