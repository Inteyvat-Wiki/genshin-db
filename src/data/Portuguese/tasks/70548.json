					"nextDialogs": [
						705480307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480307,
					"content": "Eu não me sinto mais drenada de energia, mas também não estou estimulada demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480308,
					"content": "*Bocejo* Estou começando a ficar com sono de verdade... Como uma bebida antes de dormir, isso é a pura perfeição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480309,
					"content": "#Tão boa, na verdade, que sinto vontade de escrever um artigo para louvar as virtudes dessa \"Rosa do Sonho\". Posso usar como oportunidade para coroa você \"{M#Novo}{F#Nova} Mestre das Bebidas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
						705480311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480310,
					"content": "Acho que você tá indo longe demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				},
				{
					"id": 705480312,
					"content": "Falando de passeio pelo lago, por que você não vem comigo na próxima vez que o dia estiver ensolarado, mas o sol não estiver tão intenso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480313,
					"content": "Qualquer passeio seria mais relaxante com você para conversar pelo caminho, fofura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480314
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480314,
					"content": "Então, quando voltarmos, você pode me preparar outro copo de Rosa do Sonho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480315,
						705480316
