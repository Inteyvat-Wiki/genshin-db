							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "Minha nossa, parece que Hertha voltou aos deveres dela e Glenfidia está fora também... Nossa querida fofura tomou conta completamente do estande de bebidas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480102,
					"content": "Isso mesmo, quem manda aqui sou eu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "Minha nossa! Agora posso pedir sem me preocupar em acabar com uma das \"misturas especiais\" da Companhia de Logística, o tipo de bebida que mantém você acordada a noite toda, não deixando escolha senão passar o tempo trabalhando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480105,
					"content": "Trabalhar a noite toda... Isso não deveria ser uma coisa do passado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "Isso mesmo! Sou apenas uma bibliotecária despreocupada agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480108,
					"content": "Se ao menos não houvesse tantas pessoas com livros atrasados, eu não teria que ir de porta em porta atrás deles... Eu teria passado aqui para conversar com você antes, e experimentar suas deliciosas criações, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480109,
					"content": "Então, o que será?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "Deixe-me pensar... Hmm, eu não tenho uma bebida favorita. Só prepare algo que rejuvenesce o espírito e anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480112,
					"content": "E se puder me levar a uma noite de sono tranquila mais tarde, seria ainda melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480113,
					"content": "(O estande de bebidas tem uma coleção de receitas clássicas, vamos começar escolhendo uma delas...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(Já que Lisa quer se sentir rejuvenescida, \"Aurora Beijada pela Neve\" parece uma boa escolha...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "Tá querendo algum sabor específico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "Eu achava que você não estava tão ocupada esses dias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "Bartender Honorável, ao seu dispor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
