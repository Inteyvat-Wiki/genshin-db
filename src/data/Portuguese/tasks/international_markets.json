				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "Olá! Meu nome é Atefeh. Sou uma comerciante viajante de Sumeru. Prazer te conhecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "Uau, você fez uma bela de uma jornada! Parece que notícias de nossa humilde loja já se espalhou por todos os cantos de Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "E é tudo graças a você, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Paimon é praticamente uma especialista em vendas. Ela conseguiria vender água a um peixe, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Haha, tenho que concordar! Esse seu empreendimento está se tornando bem conhecido. Na verdade, vários comerciantes bem informados ouviram falar de seu negócio de venda de poções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "Mas a maioria das pessoas ainda não estão dispostas a se arriscar por uma mercadoria tão rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Mas se você me perguntar, quando a oportunidade aparece, você precisa estar pronto para agarrá-la. É assim que se faz bastante Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "Embora o público ainda não saiba muito sobre poções alquímicas no momento, com um pouco de esforço e propaganda do seu lado, você consegue um belo espaço no mercado para si. Uma vez que isso acontecer, a Mora não vai parar de fluir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Uma vez que você tenha gerado demanda o suficiente, você pode até aumentar os seus preços em dez vezes... Hehe, com esse tipo de lucro, você poderia até tirar o resto do ano de descanso se quisesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "Dez vezes! Tá falando sério!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Hehe, desde que exista demanda, as pessoas pagarão qualquer coisa. Você poderia dizer que é um tipo de acordo entre consumidor e fornecedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "Da forma que você fala, Paimon não consegue evitar de lembrar de outra comerciante obcecada por Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Espera, você disse que era de Sumeru. Talvez você conheça ela. Sabe da Dori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "Espera, você está falando da Lorde Sangemah Bay? Uma das comerciantes mais famosas de toda Sumeru? Essa Dori? Você conhece ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "Ela é uma amiga minha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Uau! Lorde Sangemah Bay é uma das minhas maiores ídolos. Seu senso de negócio e dedicação em fazer Mora sempre foi uma das maiores inspirações!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "Eu tive sorte o suficiente de visitar o Palácio de Alcazarzaray uma vez. É realmente magnífico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "Um dia, eu espero ser igual a ela — coberta até as orelhas de mais Mora do que consigo contar, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Uhh... parece que ela ficou doidinha... Será que Paimon deveria acordar ela pra vida, ou...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Te desejo tudo de bom!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "Obrigada, isso significa muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "#De volta a onde estávamos, então. Eu acredito que estava te contando como poderíamos fazer muita Mora junt{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "A ideia, na verdade, é bem simples. Você faz poções, me fornece um suprimento regular, e eu te ajudarei a vender por todo Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Se isso parece bom para você, então deveríamos falar mais sobre que tipo de poções vender dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "Checar requerimentos de poções...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "De acordo com meu senso aguçado de mercado, essas são os tipos de poções que atualmente estão em demanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Talvez mais tarde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "Hmm, ok. Mas não espere muito. Quando se trata de Mora, você precisa agir rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Vamos voltar aos negócios.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "*Ahem* Você tem razão. Pareço ter saído um pouco do assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "Nos encontramos algumas vezes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Todo nosso trabalho duro está se pagando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
