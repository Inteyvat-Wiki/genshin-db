						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#Você que sabe, {M#rapaz}{F#moça} do cabelo dourado. Posso ver que você é um{F#a} veteran{M#o}{F#a} só com um olhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "Que tédio, não tem ninguém para treinar comigo. Se você treinar, eu te dou Cupons Especiais! Eu ganhei muitos de Roussimoff e não descobri ainda como gastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
