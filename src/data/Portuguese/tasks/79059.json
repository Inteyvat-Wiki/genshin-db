			"dialogs": [
				{
					"id": 790590101,
					"content": "Este é um cenário abandonado da peça teatral \"Jornada para o Leste: Início\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790590102,
					"content": "A história falava sobre um sábio viajante que partiu de Fontaine rumo ao leste, na direção de Sumeru, em busca da verdadeira sabedoria da Casa de Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790590103,
					"content": "Nesse ato, ele salvava um Mestre das Transformações que foi preso por uma rocha, e eles passam a viajar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790590104,
					"content": "Mas tanto o Eidolon Hydro que fazia o papel do sábio viajante como o que interpretava o Mestre das Transformações desapareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Nota do estúdio"
				},
				{
					"id": 790590105,
					"content": "Se alguém pudesse <color=#00E1FFFF>trazer eles de volta</color> para fazerem a cena juntos perto da rocha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Nota do estúdio"
				}
			]
		},
