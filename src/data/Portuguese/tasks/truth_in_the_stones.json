			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Você trabalha aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah! Sim, sim! Você deve ter vindo devido ao desaparecimento. Por favor, encontre eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210303,
					"content": "Eu não sei... Não sei o que houve. Naquele dia, estava nublado. O líder da equipe levou algumas pessoas para tratar de uns assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210304,
					"content": "Eu e os outros quatro homens ficamos na mina, trabalhando, e até descansamos um pouco... Só um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210305,
					"content": "Eu acabei adormecendo na tenda, e quando acordei todos já tinham desaparecido, e não havia rastro! Tinha falado com eles há pouco tempo, e repentinamente... Desapareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210306,
					"content": "Talvez... Talvez eu seja o próximo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210307,
					"content": "Então, quem estava dentro da tenda não desapareceu e quem estava trabalhando é que desapareceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Será que houve algum acidente na área de trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Ei! Que medo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Talvez tenha havido algum incidente na área de trabalho. Registre essa pista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
