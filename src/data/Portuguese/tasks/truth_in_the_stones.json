			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Uau! Essa mina é enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "Aqui é onde ocorreu o incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210103,
					"content": "Há seis dias, eu e meu grupo saímos para cuidar de outros assuntos. Quando voltamos, os quatro homens que tinham ficado desapareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210104,
					"content": "Nós procuramos por toda a mina, mas não encontramos eles. Não há qualquer pista, por isso pedimos ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210105,
					"content": "Ou seja, quatro mineradores desapareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Isso. Nós éramos dez pessoas, mas perdemos Long, Cen Valente, Cen Corajoso e Mao. Trabalho com todos eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210107,
					"content": "Os trabalhadores deste ramo são normalmente jovens fortes que estão na flor da sua juventude. Não teriam ido trabalhar para outra mina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Acho que não. Não há outras minas nas redondezas. Nós também não vimos outras minas durante o caminho para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210109,
					"content": "Hum... Uma mina tão grande assim. Vocês procuraram por todo o lado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Sim, por todo o lado mesmo, até debaixo da terra. Fizemos todo o possível. Mas como podem quatro jovens desaparecer assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210111,
					"content": "Precisamos explorar a mina antes de tirar conclusões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Tudo bem. Espero aqui. Fiquem à vontade para explorar. Caso encontrem alguma pista, me falem logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sr. Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
