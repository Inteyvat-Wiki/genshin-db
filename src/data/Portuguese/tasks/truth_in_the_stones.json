				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun, o que está procurando ainda? Já encontramos todas as pistas, vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Ah, me desculpem. Isso é um assunto particular. Estou buscando um tipo de jade chamado Dragonite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Dragonite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Nunca ouvi falar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "A Dragonite normalmente é usada no forjamento. Para que precisa dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "Eu... Eu não sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "Desculpem. Eu não sei bem o motivo... Tenho me sentido distante. Não consigo me lembrar de nada além do meu nome e endereço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "De fato, me sinto ansioso, sinto que tem algo que preciso fazer. Não me lembro e não me sinto bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Ah! Eu conheço essa sensação! Sei que me esqueci de algo mas não sei exatamente o quê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Ei. Eu também não sei bem. Só fico andando, sem um objetivo. Naquele dia eu fui ao mercado e ouvi algumas pessoas falando sobre a Dragonite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Essa palavra é bem familiar. Parece que o que preciso fazer está relacionado a ela... Por isso, queria encontrar uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Talvez se eu encontrar vou me lembrar do que esqueci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Entendi... Se tiver oportunidade, ajudarei você a encontrar essa pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "É sério? Muito obrigado, Sr. Zhongli. Você é muito gentil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Não é nada, sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Vamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Seguindo para o norte a partir do Despenhadeiro, você chegará ao Passe de Lingju. Se eles foram por esse caminho, com certeza devem ter deixado alguns vestígios nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Bem, vá logo ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Não entendo disso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
