			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Olhem, o que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Roupas e sapatos espalhados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Itens de uso cotidiano deixados na mina, devem ser do Sr. Dai e dos outros trabalhadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Um, dois, três, quatro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Hum... Sim. Há dez camisas e dez calças no total.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Isso são roupas para trocar? Olhe, o Sr. Dai está vestindo as mesmas roupas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Aqueles quatro homens saíram há seis dias. E não levaram as roupas para trocar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "Aqui tem também toalhas e sabão para lavar o rosto.... E umas bolsinhas, onde colocavam as ferramentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Objetos para lavar o rosto pela manhã, e equipamentos de mineração...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Isso significa que não levaram suas malas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Talvez não precisem delas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Não parece ser assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Faltam quatro picaretas. Isso significa que eles levaram elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Tiveram tempo de levar as picaretas, mas não os objetos pessoais? Estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Hum... Em que situação alguém sai levando ferramentas, mas não suas malas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Um: eles foram trabalhar nos arredores e não precisaram levar as malas, mas até agora não voltaram, por isso essa hipótese não parece certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Dois: eles saíram forçados e não tiveram tempo para levar suas malas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Oh!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Você quer dizer que... Eles foram raptados?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Há uma certa possibilidade. Precisaremos de mais provas, é necessário mais pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Se eles não saíram por querer, mas foram forçados... É melhor registrar essa possibilidade e mais tarde falar com o Sr. Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Talvez se esqueceram de levar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sr. Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Vocês voltaram. Como correu a investigação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210702,
					"content": "Encontramos três pistas nos arredores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "Em primeiro lugar, estão faltando quatro picaretas, mas eles não levaram nenhum objeto cotidiano. Isso significa que esses trabalhadores provavelmente não saíram por querer, mas foram forçados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Foram forçados?! Mas... Quem faria isso com eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210705,
					"content": "Em segundo lugar, havia cinco trabalhadores na mina, mas um deles saiu da área de trabalho e foi dormir um pouco. Quando ele acordou, seus companheiros já tinham saído sem deixar nenhum rastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Os trabalhadores que ficaram na área de trabalho desapareceram, mas quem permaneceu na área de descanso ficou são e salvo. Por isso, o incidente aconteceu na área de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Agora que você falou, Hu realmente disse que tinha descansado um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210708,
					"content": "Será que alguém entrou na área de trabalho e levou eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210709,
					"content": "Isso nos leva ao meu terceiro ponto. Kun Jun usou seu método especial para fazer uma suposição e chegou à conclusão que eles foram levados para fora da mina por uma criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Uma criança? Nos arredores há poucos habitantes, como poderia uma criança vir até aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210711,
					"content": "Apesar de soar impossível, a conclusão é que os quatro trabalhadores saíram com uma criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Para onde foram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210713,
					"content": "De acordo com nossa suposição, eles seguiram para o norte e saíram da mina. Foram na direção das ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Norte! Muito bem. Reunirei alguns homens e seguiremos nessa direção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210715,
					"content": "Precisam de ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Vocês me ajudaram muito com a investigação, podem deixar o resto conosco. Se sairmos agora talvez ainda os encontremos pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210717,
					"content": "Espere um pouco. Isso ocorreu há seis dias. Mesmo se eles tiverem ido a pé, acredito que já estarão bem longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "Hum... É, realmente. Então irei enviar meus homens para perguntar a alguns habitantes da área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210719,
					"content": "Fora da mina, não há muitos lugares para passar a noite. Podemos investigar esses lugares sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210720,
					"content": "Gostaria de pedir a vocês para continuarem olhando e procurando por pistas. Vamos nos separar. Se não nos encontrarmos no caminho, podemos nos reunir amanhã de noite no Albergue Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210721,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Então vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Sr. Dai"
				},
				{
					"id": 111210723,
					"content": "Então, agora nós continuamos nossa investigação e eles vão procurar informações junto dos habitantes das redondezas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Sim, isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Mas não há mais pistas na mina... Não devemos ir para o norte também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Espere. Falta uma pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Sim. Kun Jun ainda está investigando. Vamos chamar ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
