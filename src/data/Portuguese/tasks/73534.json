			"dialogs": [
				{
					"id": 735340101,
					"content": "Olá! É você quem está me ajudando com a Terapia Onírica? Para ser sincero, não sei sobre o que meus sonhos vão ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Sou de Mondstadt, e normalmente não tenho nenhum passatempo... Sabe, exceto beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "E sou do tipo de acabar cometendo erros quando fico bem de cara cheia, então... estou contando com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
