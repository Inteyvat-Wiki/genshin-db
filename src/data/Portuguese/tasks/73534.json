			"dialogs": [
				{
					"id": 735340501,
					"content": "Prazer te conhecer. Meu nome é Higuchi Tetsuya, um escritor de novels youkai de Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Estive sob bastante pressão ultimamente, então... Tentarei qualquer coisa e farei o que for preciso para voltar ao normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "A propósito, meu mundo onírico pode ter uma... aparência bem personalizada, considerando que é um mundo criado por mim — com todos os seus problemas. Peço desculpas com antecedência por quaisquer coisas estranhas que você possa ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
