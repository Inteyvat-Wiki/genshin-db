			"dialogs": [
				{
					"id": 735340301,
					"content": "Um prazer te conhecer. Acredito que estamos prestes a entrar em um mundo onírico juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Sou Youguang, um guarda de Liyue. Toquei em algo... sujo enquanto trabalhava recentemente, e não consegui ter uma boa noite de sono desde então. É por isso que procurei ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Se eu puder acabar com meus pesadelos com essa Terapia Onírica, isso seria simplesmente incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
