					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Meu nome é Nitesh. Sou um estudioso viajante de Sumeru, atualmente trabalhando há muito tempo em Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "Nós mais velhos costumamos nos deparar com todo tipo de problema mais facilmente. Conto com você para me ajudar a resolver o centro das coisas, jovem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
