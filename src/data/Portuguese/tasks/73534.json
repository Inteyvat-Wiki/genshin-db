			"dialogs": [
				{
					"id": 735340901,
					"content": "Então você é a pessoa que Dharajeeli apresentou? Biyush, prazer te conhecer. Trabalho com arquitetura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Biyush"
				},
				{
					"id": 735340902,
					"content": "Ouvi Kaveh mencionar seu nome antes, mas ainda não tive a chance de dar um olá, então essa é uma bela coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Biyush"
				},
				{
					"id": 735340903,
					"content": "Imagino que sonharei com um projeto que acabei de enviar. Foi um verdadeiro pesadelo... É uma pena termos que nos conhecer de forma tão formal... Enfim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biyush"
				}
			]
