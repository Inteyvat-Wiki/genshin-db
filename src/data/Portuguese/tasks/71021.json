					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210102,
						710210106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210102,
					"content": "Você pode usar o Planador.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210103
					]
				},
				{
					"id": 710210103,
					"content": "Esqueça. Estou trancado em casa desde que entrei para a Academia Sumero. Desde então, não tenho feito nenhuma atividade ao ar livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210104,
					"content": "Você também realmente não pode usar seu Planador na Academia, então provavelmente eu já devo ter esquecido todos os ensinamentos do meu instrutor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210105,
					"content": "Se você me pedisse para planar até lá, eu provavelmente cairia na água na metade do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210106,
					"content": "Você podia alugar um barco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710210107
					]
				},
				{
					"id": 710210107,
					"content": "Eu também pensei isso. E me lembro que no Porto de Dornman você podia alugar um barco, mas ele está muito longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210108,
					"content": "Quem sabe quanto tempo levará uma viagem de ida e volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710210109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710210109,
					"content": "Mas eu não poderia simplesmente construir meu próprio barco. Quero dizer, não aprendi nada sobre isso na Academia Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
}