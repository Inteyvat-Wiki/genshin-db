				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Bem, ler, eu li, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Não posso afirmar que realmente entendi todas as regras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Ótimo, você está aqui! Você deu uma lida no Guia de Planagem? Já está com todas as regras em mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Isso me parece forçado. Já entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "O Guia de Planagem é muito maçante... Eu não consegui ler tudo, mas não conte a Grande Mestre Intendente Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Sério? Eu pensei que tínhamos algumas histórias interessantes no Guia de Planagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Histórias legais? Oh, você deve estar se referindo aos casos que estão na Apêndice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Gosto de alguns deles. O meu favorito é aquele que fala sobre a decolagem ilegal com Slime Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Aparentemente se você estourar um Slime Anemo e decolar com a explosão de vento, pode disparar você muito, muito alto... Eu queria experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Não são dessas histórias que eu estou falando, eu me refiro aquela na qual um pássaro queria aprender a voar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Err...? Espere...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Deixe-me dar uma olhada... Ah, não! Este não é um livro que eu costumava ler quando era criança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Ops, desculpa! Eu coloquei os dois livros na mesma estante e devo ter pegado o errado quando eu estava indo embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Como diabos você confunde uma história de dormir com um manual de instruções!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ah... Isso é tão vergonhoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "É porque... É porque talvez no fundo, aquele conto de fadas foi a coisa que realmente me ensinou a como voar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "\"O que lhe faltou não foi vento, mas coragem. É a coragem que permite você ser uma das primeiras aves voadores deste mundo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Ao ler aquilo, me deu coragem para voar, para me tornar uma Aventureira e me tornar a Campeã de Voo de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "Enfim, não vamos mais falar disso, vamos voltar ao teste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "#Não fique nervos{M#o}{F#a}, apenas voe como você costumava fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "#Estou pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Siga a <color=#00E1FFFF>rota marcada</color> para terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
