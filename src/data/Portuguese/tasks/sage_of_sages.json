				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "O grupo se reencontra no horário mercado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "Pensei bastante. Se eu conheço o professor, ele veio para o deserto sabendo que provavelmente jamais retornaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "Ele é um velho teimoso que costuma ser insistente. Não vamos chegar a lugar nenhum tentando convencer ele a escapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Eu concordo. Meu mestre, Naphis, diz a mesma coisa. Quando Cyrus se decide sobre algo, ninguém vai convencê-lo do contrário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "Hmm. Outras coisas vieram à mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Todos vocês ouviram tudo que precisavam sobre o Templo do Silêncio. Não tenho mais nada a acrescentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "Minhas memórias desse lugar são confusas. Deve ter algo a ver com a influência dos Fragmentos de Ba. Isso poderia explicar porque sofri de dores de cabeça constantes e febres quando era criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Eu me lembro de ter alguns momentos de emoções profundas, com imagens vagas na minha mente. Mas não me lembro de muito, só uns pedaços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "Eu ainda era jovem, e tudo que podia entender é que havia uma vontade poderosa na minha mente. Pensando bem nisso, acredito que foi o jeito que Hermanubis encontrou de me encorajar, mesmo que não pudéssemos nos comunicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "O poder que veio a habitar meu espírito provavelmente era uma pedra angular da fé deles. Se a vontade e poder de Hermanubis é algo tangível, e eles são seus fiéis verdadeiros, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Você não vai ceder as demandas deles, vai? Deve ter algum outro meio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Não tome decisões precipitadas, Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "Não, não tenho intenção de devolver. Preciso desse poder para proteger Sumeru. Mas o Templo tem o direito de fazer a decisão final sobre seu destino, já que pertence a um dos Sete Pilares do Rei Deshret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "Por isso vou enfrentar eles de frente, e ganharei o direito de usar esse poder para mim, de forma justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Hmm, isso me lembra algo que Alhaitham mencionou antes de partir. Ele disse que o Templo do Silêncio originalmente foi fundado pela elite dominante da época. Tradicionalmente, essas organizações são regidas por um código nobre estrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Kaveh fez observações similares sobre as tribos do deserto em suas viagens por lá. Ele disse que muitas delas têm regras próprias. Eles falam sobre a importância de nunca desonrar os laços tribais, ou as regras colocadas por seus ancestrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Eu acho que podemos aproveitar isso para nossa vantagem. Retorne para eles com uma proposta nossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Uau, viramos o jogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "Parece que temos a mesma ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Retornar para eles agora, enquanto ainda podemos, em termos que eles não poderão recusar. É assim que venceremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Parece bom pra mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Ótimo. E já sei como começar a conversa. Vamos procurar Sethos. Vamos contar a ele que sei um pouco sobre medicina, e gostaria de dar uma olhada no avô dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Deve haver outra maneira!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
