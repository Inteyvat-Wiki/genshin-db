			},
			"dialogs": [
				{
					"id": 130380301,
					"content": "Nos reunimos nesse dia para realizar o Ritual dos Duelos mais uma vez, com o maior dos sábios como nossa testemunha, o Lorde Hermanubis. Seu poder e autoridade estão presentes entre nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380302,
					"content": "Essa é uma de nossas cerimônias mais sagradas, e nenhuma interrupção da audiência será tolerada. Todos devem observar o duelo com respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380303,
					"content": "Representando o Templo do Silêncio. Os defensores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380304,
					"content": "Vovô, você veio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380305,
					"content": "*Cof*... Um Ritual de Duelos depois de tantos anos... estou surpreso, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "Bamoun"
				},
				{
					"id": 130380306,
					"content": "Eu sei o que estou fazendo, vovô. Deixe comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380307,
					"content": "Representando a Academia. Os desafiantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380308,
					"content": "Pronto. Vamos lutar até que ouçam nossas vozes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380309,
					"content": "Guerreiros, assumam suas posições e decidam a ordem de batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380310,
					"content": "Não viemos debater o que traz nossos desafiantes até aqui, nem o que acontecerá com os duelistas derrotados. Duelistas, o poder de Hermanubis está em jogo. Lutem até que o vitorioso seja declarado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380311,
					"content": "Eu vou primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "Hã? Você tem certeza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380313,
					"content": "Sim. Queremos manter nossa moral alta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#Concordo. Vamos mandar {NICKNAME}, vai ser tiro e queda. {F#Ela}{M#Ele} vai tremer as bases deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380315,
					"content": "Certo, então você é o segundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380316,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380317,
					"content": "Decidimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380318,
					"content": "Nós também. Vamos começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
