					}
				]
			},
			"dialogs": [
				{
					"id": 130380601,
					"content": "Bem, depois de como foram as coisas, não há como voltar atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Nunca houve. Voltar atrás não é uma opção para mim desde o momento que o professor fugiu para retornar ao deserto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Você precisa ganhar. Você precisa desse poder — tanto como General Mahamatra quanto para si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "É, isso mesmo! Além disso, esteve com você desde que você era uma criancinha. Certamente é um sinal de que pensa em você como dono por direito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "...Tanto como General Mahamatra, quanto para mim mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "É, quando você fala desse jeito... Eu tive que superar muita coisa para adestrar esse poder e reivindicá-lo para mim. Nem todo mundo poderia ter feito isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Não vamos nos desviar. Temos que focar em ganhar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#Sim. {NICKNAME} e eu jamais perderemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "E eu também não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "O deserto era a casa de uma grande civilização antiga, que por diversos motivos, se distanciou da civilização da floresta tropical. É como Dehya disse — preconceitos afastaram as pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Mas também deve haver fatores pessoais em jogo. Não consigo me livrar da sensação de que Bamoun se importa com muito mais coisas do que ele deixa transparecer, e eu não acho que Sethos seja nenhum tipo de vilão. Ele só está fazendo o que acha que é o melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "...Amanhã, tudo será resolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Vamos te ajudar nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
