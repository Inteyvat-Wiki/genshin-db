						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Fico muito agradecida. Ter a oportunidade de ver a Rosa de Sumeru crescer por estas terras me deixa muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030302,
					"content": "Enquanto Sabbah fala com vocês, um conjunto de novas folhas brota a partir das velhas.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "As folhas se alastram, revelando botões de flores.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "Os botões de flores desabrocham lentamente e se tornam Rosas de Sumeru.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Ela colhe uma Rosa de Sumeru e a estende a Paimon e você.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Você não precisava ter feito isso. As rosas plantadas pela Srta. Sabbah já não eram muitas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "Isso não é nada, se não fosse pela ajuda de vocês, a Rosa de Sumeru não apareceria nessas terras de toda forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030308,
					"content": "Foi só uma mãozinha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Um jardim de rosas é magnífico, mas uma única rosa também carrega sua beleza. Quando eu era pesquisadora, me interessava por rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030311,
					"content": "Hmm, então a Srta. Sabbah era pesquisadora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Ah, sim, eu ainda não havia contado para a Paimon. Eu não sou cidadã da Vila Aaru, eu vim em nome da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030313,
					"content": "Paimon bem que ficou desconfiada, a Srta. Sabbah fala de um jeito muito eloquente, como os estudiosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "Você as plantou porque queria continuar pesquisando sobre o assunto, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "Eu não diria isso. Para ser honesta, não acho que o interesse dos pesquisadores em seus assuntos não deva ser cultivado apenas por causa da pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030316,
					"content": "Fiz isso porque realmente amo este mundo e quero contribuir para o ciclo da vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030317,
					"content": "Quanto a mim, uma vez estudei o impacto da geografia na evolução das rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030318,
					"content": "Imagine se a direção tomada pela evolução ambiental de Sumeru fosse completamente diferente da que temos hoje, como estas rosas teriam se adaptado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030319,
					"content": "Poderia ser o caso e ter evoluído para uma planta que escala paredes como vinhas? Se fosse assim, talvez as paredes da Academia estariam cobertas de rosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030320,
					"content": "Teriam se aglomerado? Um buquê natural! Muito estiloso, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030321,
					"content": "Talvez tivesse de todas as cores... Branco, vermelho, dourado... E então, seriam espécies completamente novas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030322,
					"content": "Claro, atualmente, pouquíssimas pessoas podem vir a descobrir novas espécies. Muito menos cultivar novas espécies, como faziam os estudiosos do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030323,
					"content": "O que eu quero ilustrar é o seguinte: dentro de cada rosa, há um mar de possibilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030324,
					"content": "Era uma alegria poder explorar todas essas possibilidades. Naquela época, todos os dias, curiosa e contente, eu coletava amostras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030325,
					"content": "Parando para pensar, de fato foi uma fase cheia de pureza e felicidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030326,
					"content": "Resumindo, peguem e está tudo certo. Do meu ponto de vista, isto não representa perda alguma, representa uma contente partilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030327,
					"content": "Se você quiser me agradecer, traga algumas Rosas de Sumeru depois, quando vierem me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030328,
					"content": "Eu me sinto muito confortável falando com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030329,
					"content": "Não importa o que eu esteja dizendo, vocês não tratam como se fosse bobagem e não interrompem a minha fala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030330,
					"content": "Eu também tenho algumas lembrancinhas, para vocês. Apesar de serem coisas que, basicamente, não tem utilidade para mim, talvez vocês gostem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030331,
					"content": "Nós visitaremos sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Traga-as quando vier me visitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030309,
					"content": "Não esquente a cabeça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
		{
			"id": 7320304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
