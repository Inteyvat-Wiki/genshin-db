					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "Vocês voltaram como prometido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030102,
					"content": "Eu cozinhei alguns Frangos na Manteiga. Se estiverem com fome, sentem-se para comer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030103,
					"content": "Frango na Manteiga! Uhul! Paimon quer um montão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Paimon, tenha modos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Hã... Paimon pede desculpas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "Sem problemas, não precisa ser tão formal. Apreciar boa comida é comum da natureza humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030108,
					"content": "Quando os vegetais estiverem cozidos, vou separar uma porção para vocês. É o mínimo que posso fazer para agradecer pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030109,
					"content": "Uau, Srta. Sabbah, você é tão gentil! As rosas que você planta certamente seguirão seu coração e crescerão bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Hahah, ultimamente, eu venho me esforçando como posso para manter o solo o mais úmido possível. As mudas vêm crescendo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030111,
					"content": "Só que elas crescem tão devagar. Fico preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030112,
					"content": "Geralmente, se as mudas estão bem, elas brotam rapidamente, mas essas daqui não mudaram em nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030113,
					"content": "Não estou certa se é o caso do solo não ser fértil o suficiente. Mas, com elas nessa situação, o melhor a fazer é continuar adubando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030114,
					"content": "Vamos adubar mais uma vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Você me faria esse favor, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030117,
					"content": "Tranquilo, deixa com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "Podemos usar a força do Dendro de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Desculpe, a Paimon é assim mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
