			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030401,
					"content": "#Você não parece ter Visão, mas, ao mesmo tempo, controla o poder do Dendro. Você não é um{F#a} Aventureir{F#a}{M#o} comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030402,
					"content": "Dizem que existe, de fato, um grupo de pessoas que pode conduzir a Energia Elemental sem a ajuda da Visão, mas essas pessoas são universalmente ruins, mas você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030403,
					"content": "Em suma, eu acredito que você é uma pessoa de bom coração. Não vá se perder por caminhos tortuosos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}