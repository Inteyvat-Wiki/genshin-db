			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "Acho que eu nunca veria essas rosas brotarem se não tivesse encontrado vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930502,
					"content": "Se eu soubesse que seria assim, eu teria trazido alguns livros para cá ao invés de sementes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930503,
					"content": "Você não é daqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "#Está surpres{M#o}{F#a}? Isso mostra que eu me adaptei bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930505,
					"content": "Quando eu havia acabado de chegar aqui, eu não conseguia me acostumar com nada, comida, habitação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930506,
					"content": "Mas depois de um tempo, me acostumei com os costumes daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930507,
					"content": "Mas isso não quer dizer que eu aceitei meu atual ambiente completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930508,
					"content": "É muito difícil fazer as rosas que crescem na Cidade de Sumeru florescerem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930509,
					"content": "Você é uma pesquisadora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Eu... Já fui chamada de pesquisadora, mas não hoje em dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930511,
					"content": "Eu disse algo além da minha posição, e aprendi algo que não deveria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930512,
					"content": "Isso violava certos tabus da Academia, por isso deixei de ser uma pesquisadora entre eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930513,
					"content": "O que você disse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "A curiosidade é a maior motivação na busca por conhecimento, mas também é a fonte de muitos erros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930515,
					"content": "Isso foi algo que eu só entendi após ser exilada aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930516,
					"content": "Pensando na sua segurança, acho melhor não contar todos os detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930517,
					"content": "Está bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "*Ahem*, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930535,
					"content": "Eu pensei que os aventureiros fossem muito ocupados, e que depois de te ajudar uma vez, você nunca mais os veria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930536,
					"content": "Nunca pensei que iria conversar tanto com um deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930537,
					"content": "Na verdade... Eu não tenho muitos amigos com quem posso conversar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930538,
					"content": "Você acha que pode vir e fertilizá-los amanhã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930539,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "Bem... Ótimo, eu vou esperar por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930519,
					"content": "Por que você quer cultivar Rosas de Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Talvez você não entenda muito sobre as Rosas de Sumeru, mas esse tipo de planta possui muitas utilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930521,
					"content": "Ela serve como alimento, remédio, presente, e tem um grande valor econômico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930522,
					"content": "E esses são apenas alguns dos usos mais frequentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930523,
					"content": "Nem sempre as flores, folhas e caules das Rosas de Sumeru tiveram a aparência que têm hoje, no passado elas tinham outros formatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930524,
					"content": "Eu acredito que as mudanças nas condições geográficas fizeram as Rosas de Sumeru mudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930525,
					"content": "Seu processo de evolução morfológica revela muitas informações geográficas e históricas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930526,
					"content": "Esse não é um assunto fácil de explicar, talvez contar para aventureiros de passagem também seja contra as regras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930527,
					"content": "Se você tiver interesse em evolução botânica, recomendo que vá para a Academia. Eles terão mais informações sobre o assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930528,
					"content": "Então você está pesquisando isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Eu não sou mais uma pesquisadora, não tenho as qualificações nem condições de fazer pesquisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930530,
					"content": "#Se for preciso dar um motivo... *Suspiro* você é muito curios{M#o}{F#a}, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930531,
					"content": "Eu costumava plantar muitas Rosas de Sumeru na minha antiga casa. Elas ficavam muito bonitas quando floresciam, e eu podia apreciá-las todos os dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930532,
					"content": "Se for possível, eu gostaria que fosse como antes, e que eu pudesse tê-las como companhia novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930533,
					"content": "... É só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930534,
					"content": "Eu consigo compreender isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
