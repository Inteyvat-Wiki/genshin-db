			},
			"dialogs": [
				{
					"id": 240020201,
					"content": "Srta. Isadora, posso ajudar com alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Policial Muirne, tenho uma pergunta para você. Você lembra da pilha de contas que eu trouxe ao escritório essa manhã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Eu lembro daquilo. Você foi atacada por Gaivotas Pescadoras Violeta Dourado também, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "Sim, isso mesmo! Quando aquelas gaivotas malditas foram embora, eu me apressei para chegar ao meu escritório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "Você poderia me ajudar a lembrar se eu deixei alguma folha no chão quando saí correndo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Uh... Não lembro. Eu também estava ocupada com outro trabalho na hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Mas se você precisa delas urgentemente, podemos \"refazer\" seu caminho ao escritório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "Hã? Você pode mesmo? Eu... não quero pedir demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Só estamos procurando por coisas — uma tarefa muito mais fácil do que trabalhar no Palais Mermonia, certamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Eu realmente me lembro que você tinha amarrado os documentos que carregava juntos em pilhas. É isso mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Isso! Precisamos ser precisas com nossos relatórios para revisão de custos, afinal. Você tem um bom olho, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Tudo deve ser listado, de grandes serviços como contratar artesões para fazer a manutenção das paredes externas do Palais, a serviços pequenos como mudar uma fechadura em uma mesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "É assim que as despesas de todo mês chegam a uma pilha grossa que precisa de corda para amarrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Resumindo, não tem como uma única folha só ter saído voando sozinha — mesmo que você tivesse perdido documentos, você teria perdido pilha por pilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Não faz muito tempo desde que você chegou ao escritório, vamos sair agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
