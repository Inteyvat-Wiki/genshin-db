	"talks": [
		{
			"id": 2400201,
			"completionStepIds": [
				2400201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400201",
							"2"
						],
						"stepId": 2400201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isadora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Hã. Aonde ela foi? Que azar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Ugh. Eu também não vou conseguir escrever outra cópia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "Você perdeu alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Bem, eu espero mesmo que SÓ esteja perdida — eu me considero uma otimista, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "Isso é o que você chama de otimismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Bem... Pode ser quando a coisa que você está procurando é o registro de despesas semianual do escritório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Isso precisava ir à Srta. Keiser em breve... só para eu descobrir que o registro estava com cinco páginas faltando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Estas cinco páginas são de cinco meses separados e contêm um grande número de despesas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Foi só na última revisão que eu percebi que elas tinham desaparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Se eu não coloquei elas no lugar errado acidentalmente, eu nem sequer as fiz pra começo de conversa... então como essa quantia final para nossas despesas oficiais apareceu aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Ugh, eu nem ouso pensar nisso. Se eu realmente esqueci de escrevê-las, a Srta. Cadme com certeza vai me forçar a procurar nos registros da última década de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Isso parece bem sério...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "É porque é mesmo! Se os documentos não foram escritos ou foram perdidos, muitos escritórios terão problemas de financiamento no mês que vem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Que azar maldito... Eu só lembro de virar uma noite escrevendo o registro e trazendo para o Palais hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "Quando eu cheguei nesse ponto, eu me assustei por um bando de gaivotas e minhas mãos afrouxaram por um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "*Suspiro* Eu posso mesmo ter perdido os documentos nesse tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Eu te ajudo a procurar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "#Você estaria dispost{M#o}{F#a} a ajudar? Maravilha! Vem, vamos seguir esse caminho primeiro então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "Os dados envolvidos não são super secretos ou nada assim, então não se preocupe em pegar as folhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "Ah, sim, eu também encontrei a Policial Muirne naquela hora! Ela até me ajudou a afugentar as gaivotas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "Podemos perguntar a ela se viu o registro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "#Vamos procurar junt{M#os}{F#as}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Perder coisas é bom?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
		{
