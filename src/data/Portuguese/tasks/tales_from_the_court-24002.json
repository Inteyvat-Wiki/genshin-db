						],
						"pointId": 4427
					}
				]
			},
			"dialogs": [
				{
					"id": 240020401,
					"content": "Ah, estes são os documentos que preciso! Oh, graças à Arconte, estão todos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Por que você estava fazendo contabilidade no café?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "B-Bem, eu preciso de muito café para garantir que estou fazendo contas tranquilamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Estes são os gastos de todos os escritórios dentro do Palais, sabe — fazer essa contabilidade deveria ser trabalho para cinco pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Mas além de mim, todos no escritório frequentemente são pegos emprestados por outro escritório, enviados a trabalho ou estão ocupados com alguma visitação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Então quando chegou a hora de fazer a contabilidade das despesas, tudo ficou nas minhas costas — eu não durmo há dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Não só as despesas precisam ser contabilizadas, mas até o pagamento das contas sobrou para mim. Minha visão está praticamente nadando aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Independentemente, é bom que encontramos aquelas contas. Se me permite, Srta. Isadora, eu a acompanharei de volta ao Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "#Obrigada, Policial Muirne. *Suspiro* Eu juro, você e {M#o}{F#a} Viajante são as únicas almas bondosas que eu encontrei nos últimos três meses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "O resto ou está gritando comigo ou me fazendo trabalhar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "Ugh, não, não, preciso parar de reclamar. Preciso voltar, ou a Srta. Keiser vai gritar comigo de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}