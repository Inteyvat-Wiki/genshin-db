				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Ótimo... Esse vinho da Cauda do Gato é realmente muito bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Que taverna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "Uh? Oh... Viajante, você não conhece a Cauda do Gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "Pela sua cara, com certeza nunca ouviu falar, e nem deve ter ido lá... Você não sabe o que está perdendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "Há muitos Coquetéis na Cauda do Gato... Aposto que você ainda não provou nenhum deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Ainda por cima, como o seu nome diz, há muitos gatos fofos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Com a companhia de tantos gatos fofinhos e um bom vinho, é fácil esquecer da existência do tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "A Cauda do Gato está aberta agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Errr... Mas você não parece ter idade suficiente para beber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Mas não tem problema! A Diona é a melhor Bartender de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Deve ser moleza para ela preparar uma bebida sem álcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Ainda por cima, ela também é tão fofa quanto um gato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*Hic* Oh não... Disse isso em voz alta? Por favor, não conte a ela o que eu falei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Bom, sem mais delongas! A entrada da Cauda do Gato fica ali atrás, se você quiser ir lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Eu... Eu... Bom, vou esperar a embriaguez passar... Bebi demais e não aguentarei uma quinta rodada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Eu quero ir provar as suas bebidas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}