					],
					"speakerTitle": "O Enjaulador"
				},
				{
					"id": 727330102,
					"content": "Depois que eu te derrotar, destruirei a Gangue Arataki inteira, um membro por vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727330103
					],
					"speakerTitle": "O Enjaulador"
				},
				{
					"id": 727330103,
					"content": "Parece que temos... um adulto...? E por que ele parece mais animado do que as crianças?",
