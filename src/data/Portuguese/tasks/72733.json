			"dialogs": [
				{
					"id": 727330101,
					"content": "\"Melão de Lavanda Destruidora do Céu\"! Eu vim para vingar Elyctra! Prepare o seu Onikabuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
