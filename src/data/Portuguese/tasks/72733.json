					"nextDialogs": [
						727330104,
						727330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727330104,
					"content": "Não precisa ter medo, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727330106
					]
				},
				{
					"id": 727330106,
					"content": "Bem, Melão de Lavanda Destruidora do Céu! Parece que esse cara está te desafiando para um duelo — e não tem como fugir de algo assim.",
					"roleType": "TALK_ROLE_NPC",
