			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "Puxa, de novo essas folhas cheias de mordidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "Viajante, olha só! Esse gato vive mordendo minhas flores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Olha essa folha, e essa, e mais essa! Todas com um pedação mordido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "O gatinho está com fome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Foi o que o Raef disse. Ele até alimentou o gatinho pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "Mas no dia seguinte, o gatinho voltou para morder as flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "Por enquanto ele só morde as folhas, mas e se ele começar a morder os caules? Seria terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "Mas eu também acho crueldade afugentar ele... afinal lá fora só tem deserto, e se ele sair dessa vila, não teria mais para onde ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "Viajante, você pode me ajudar a alimentar o gatinho? Acho que, de estômago cheio, ele não vai mais morder as flores. E flores nem são tão apetitosas no fim das contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "Muito obrigada, Viajante! Vou marcar no mapa os lugares onde o gatinho passa mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Vou ficar aqui cuidando das flores caso apareça outro gato para tentar mordê-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "Eu sou especialista em gatos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Perfeito, então! Toda vez que vejo as patinhas de um gato, já fico com medo que ele vá pular em mim com aquelas garras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Será que o gatinho não morde só de brincadeira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Não faço ideia do que o gatinho gosta de brincar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
