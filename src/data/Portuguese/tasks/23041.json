			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "Viajante, você chegou na hora certa! Venha provar minha Sopa de Feijão com Menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "Estes ingredientes são...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Alguns ingredientes eu pedi para comprarem para mim, mas a menta fui eu mesma que cultivei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "O Raef não me mandou um conjunto de ferramentas de jardinagem, mais um tanto de fertilizante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "Achei que plantar só um vaso seria um desperdício... então pedi pro Azalai comprar algumas sementes de Menta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Depois de plantar as sementes de Menta, cuidei delas da mesma forma que cuido das flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "E conforme fui cuidando, a Menta foi crescendo, amadurecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "Então eu colhi algumas e fiz essa Sopa de Feijão com Menta. O que achou? Está uma delícia, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Bem... agora que você tomou minha Sopa de Feijão com Menta, quero te pedir um favor em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Mas... eu nem terminei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Calma, é brincadeira! Vou retribuir sua ajuda direitinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "Só queria pedir que me ajudasse a colher três Pêssegos Zaytun. O Raef adora esses pêssegos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410315,
					"content": "Quero colocar eles dentro da minha Sopa de Feijão com Menta, depois levar para o Raef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410316,
					"content": "Agora que já sei fazer a Sopa de Feijão com Menta, só preciso que alguém me ajude a colher os Pêssegos Zaytun",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410317,
					"content": "Entendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Obrigada! Quando você voltar, te dou mais uma tigela de Sopa de Feijão com Menta",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410321,
					"content": "Conto com você então, Viajante. Quando terminar de colher os Pêssegos Zaytun, volte para me entregá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410319,
					"content": "Ele consegue tomar durante o trabalho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "É só tomar uma coisinha, o trabalho dele não é assim tão ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
