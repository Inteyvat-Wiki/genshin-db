			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Fujiwara Toshiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "O-Obrigada... Ufa, e pensar que aqueles caras iriam tentar me pegar de surpresa assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620102,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "Eu sou Fujiwara Toshiko, e estou aqui para... Hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620105,
					"content": "Não importa. Já que você me salvou, posso muito bem lhe dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620106,
					"content": "Na verdade, estou aqui para encontrar o tesouro que meus antepassados deixaram aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620107,
					"content": "Te-Tesouro...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721620108,
					"content": "Você já encontrou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "Hahaha, mas é claro. Segui algumas pistas para a localização do tesouro, e determinei meu método de entrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620110,
					"content": "Mas quando eu estava prestes a ativar o mecanismo e entrar na área onde o tesouro está guardado, fui atacada de surpresa por aqueles monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620111,
					"content": "Eu lhe devo minha vida por afugentar esses monstros. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620112,
					"content": "Uh, então, eu poderia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620113,
					"content": "Posso pedir que me protejam por um pouco mais de tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620114,
					"content": "Ainda tenho que encontrar esse tesouro, mas acho que não serei capaz de lidar com todos esses monstros sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620115,
					"content": "Se vocês quiserem me ajudar, eu... Eu até mesmo dividirei um pedaço do tesouro com vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620116,
					"content": "Existe realmente um tesouro aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "Tenho certeza que posso! Confie em mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620119,
					"content": "Eu até encontrei o mecanismo que nos permitirá entrar no local onde o tesouro está escondido. É logo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620120,
					"content": "Dito isto, o mecanismo não parece ser ativado diretamente. Ele precisa de algum método especial para isso....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620121,
					"content": "Tenho aqui comigo um mapa deixado por meus antepassados, que contém pistas de como eu poderia descobrir como resolver este mecanismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620122,
					"content": "Mas... Heh, eu não descobri ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620123,
					"content": "Aqui, por que você não dá uma olhada também? Quem sabe, talvez você consiga descobrir alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620124,
					"content": "*Suspira* Mas, sinceramente, como vou resolver este quebra-cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620117,
					"content": "Você consegue realmente encontrá-lo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
