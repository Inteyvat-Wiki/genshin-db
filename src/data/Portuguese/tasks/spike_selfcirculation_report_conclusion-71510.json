					"nextDialogs": [
						715100104
					]
				},
				{
					"id": 715100104,
					"content": "Que bom, que bom. Embora a Ponta de Pursina não possa fechar todas as saídas de uma só vez, mas tendo sucesso uma vez, basta continuarmos.",
