			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#Bom dia,{NICKNAME}! Bom dia, Paimon! Adivinhem só... Sou só eu e meus flutuadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Bom dia, Mualani! Como você tá cheia de energia? Não era você que tava sendo a inimiga do fim na festa ontem?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "Isso foi ontem! Tudo que eu preciso é uma boa noite de sono e tô praticamente nova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Aqui, pegue isso. É seu prêmio por completar o álbum — eu também peguei o seu para te poupar da viagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Uau! Você é muito atenciosa, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Uma boa guia sempre pensa à frente e ajuda como pode, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Odeio falar nisso, mas falando de trabalho, acho que nossas férias estão quase acabando... Além disso, se eu não voltar logo, tô preocupada que meu cachorrinho nem vai saber quem eu sou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Falando com os outros, parece que todos têm suas próprias razões para voltar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Uns disseram que sentem falta da família, outros do sabor do Vinho de Dandelion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Até Chasca parece tá sentindo também. Ela não disse isso mesmo, mas quando chega a noite, ela sobe nas árvores e fica olhando em direção ao Clã das Plumas de Flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Eu entendo completamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Mas o verão ainda não acabou! Então digo... que dá pra gente espremer mais uns momentos inesquecíveis com o tempo que a gente tem restando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Tipo outra foto em grupo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Ei, que tal tirar uma aqui? Depois desse tempo todo, Paimon até que gostou desse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Ótima ideia! Por que vocês não enfeitam essa parede e eu vou reunir os outros? Vejo vocês na praça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
