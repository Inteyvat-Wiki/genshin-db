			"dialogs": [
				{
					"id": 150450601,
					"content": "Uau, isso parece incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450602,
					"content": "Pessoal, aqui! Vamos tirar uma foto juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450603,
					"content": "Nada mal, nada mal! Parece que tá todo mundo com energia no máximo — sem nenhum rastro de cabelo bagunçado ou olhos cansados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450604,
					"content": "Espera, você nem procura por coisas como essa antes de tirar uma foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450605,
					"content": "Qualé, que tipo de guia eu seria se não prestasse atenção aos detalhes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450606,
					"content": "Igual tipo, se você estiver procurando por um companheiro de viagem perfeito, não dá para errar com um bardo que gosta de tomar uma! Não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450607,
					"content": "O que isso tem a ver...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450608,
					"content": "Haha! Mas de alguma maneira, sei exatamente o que ele quer dizer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450609,
					"content": "O privilégio da amizade é falar besteira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "Tem certeza que isso é uma boa ideia? Ou você só tá indo na do Bardo Desafinado também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450611,
					"content": "Ei, um pouco de bobagem não machuca ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450612,
					"content": "Aqui, coloque essa bandana Asha. Uma lembrancinha da gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450613,
					"content": "Valeu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "Combina muito com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450615,
					"content": "Tudo bem então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450616,
					"content": "Três, dois, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450617,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450618,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450619,
					"content": "...Desculpa, esse tanto de bobagem afetou a cabeça de Paimon. Tá completamente vazia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450620,
					"content": "Não quer que tudo acabe, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450621,
					"content": "Ou é porque você se preocupou que quando dissesse isso, as férias acabariam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450622,
					"content": "Como... Paimon achava que você tinha dito que pacificadoras não podiam ler a mente das pessoas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450623,
					"content": "Haha, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450624,
					"content": "Não se preocupe, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450625,
					"content": "O verão voltará de novo, igual como você disse quando fez aquele desejo para a Arconte Pyro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450626,
					"content": "Mesmo a gente se separando, contanto que a gente valorize nossas amizades, sei que nossos caminhos vão cruzar novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450627,
					"content": "Bennett tá falando pelos cotovelos agora, hein, Professor Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450628,
					"content": "Ei, isso não tem nada a ver comigo! Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450629,
					"content": "Então por que você parece tão contente com isso? Ugh... E Paimon aqui começando a ficar comovida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450630,
					"content": "Será que tentamos de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450631,
					"content": "Por que não fazemos juntos dessa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450632,
					"content": "O que a gente grita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450633,
					"content": "Estrela da sorte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "Maravilha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450635,
					"content": "Três, dois, um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450636,
					"content": "Estrela da sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450641,
					"content": "Você se diverte muito com seus amigos...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "...Quais são os seus planos para o futuro, Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450643,
					"content": "Se você estiver com problemas para decidir, sempre dá para vir ao Povo das Termas. Você pode ficar com a gente quanto quiser, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450644,
					"content": "Agradeço a oferta gentil, Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450645,
					"content": "Por acaso, eu fui encontrar a Arconte Pyro para dizer a ela o quanto sou grato por tudo que ela fez por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450646,
					"content": "Ela me contou que o Domínio que entramos era uma simulação Abissal do Mare Jivari. Era extremamente instável e agora se foi completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450647,
					"content": "Mais tarde, quando começamos a falar sobre meu futuro, a Arconte Pyro disse que eu seria mais que bem-vindo para ficar aqui em Natlan... mas que também respeitaria minha decisão, independentemente de qual seja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450648,
					"content": "Depois que pensei muito, muito mesmo... decidi voltar para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450649,
					"content": "Você sente falta dos seus pais, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450650,
					"content": "Esse com certeza é um dos motivos. Prometi contar a eles tudo o que aconteceu nessa aventura, então não posso voltar atrás com a minha palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450651,
					"content": "Mas também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450652,
					"content": "Quando me despedi da Mamãe e do Papai, prometi que um dia me tornaria o aventureiro mais lendário de toda Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450653,
					"content": "E quem já ouviu falar de um aventureiro que passou a vida inteira parado no mesmo lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450654,
					"content": "Bennett...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450655,
					"content": "E se a sua sorte começar a piorar de novo no momento em que você sair de Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450656,
					"content": "Haha, tudo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450657,
					"content": "O calor e a bondade que experimentei nessa aventura já são o bastante para enfrentar todos os desafios que me esperam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450658,
					"content": "Não só estou determinado a moldar meu próprio destino, como também quero transmitir todo o carinho que minha família e meus amigos me mostraram. Sempre acreditei nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450659,
					"content": "Viva! Ao nosso líder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450660,
					"content": "Ao nosso líder, Bennett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450661,
					"content": "Saúde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450662,
					"content": "Uhh... Vai ser mais uma noite em claro, não é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450663,
					"content": "Isso tá divertido demais! Quem vai se apresentar agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450664,
					"content": "O Bennett já quase dormiu várias vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450665,
					"content": "Não, não... Eu ainda consigo... continuar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450666,
					"content": "Descansem um pouco, pessoal. E vendo que você ainda tem energia, vou deixar a limpeza contigo, Mualani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450667,
					"content": "Hã? Por que eu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, você pode me acompanhar em uma caminhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450669,
					"content": "Conheço um ótimo lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1504507",
							"2"
						],
						"stepId": 1504507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							984.35,
							298.017,
							14628.56
						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "Você pode ser desafinado, mas sabe mesmo como descobrir uma bela vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Haha, que bom que gostou. Algumas histórias não são para pássaros — apenas para as estrelas no alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "Hora de uma historinha de ninar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Haha... Mais como uma história que começa com o próprio Tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "Há muito, muito tempo, \"Tem{RUBY#[D]Istaroth}po\" começou a escrever a história desse mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Ela tratava todos os seres vivos de maneira igual; mas para ela, eles eram de igual insignificância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Como um pergaminho antigo, ela registrou todas as pessoas, eventos, encontros e despedidas na própria memória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "Na época, como um espírito Anemo, tive uma chance de encontrar com \"Tempo\" no Templo do Vento Milenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "Ao ouvir meus desejos, ela confiou a mim, fragmentos do próprio poder e autoridade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Sementes, trazidas pelo vento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "Parece que você já ouviu a história do \"Tempo e o Vento\" antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Charmoso, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "Através das memórias registradas nos rituais, poemas, ruínas e textos antigos, aqueles seres que ela considerava tão insignificantes a encontraram... todo o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "Então essa é a história que você queria contar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Mmm... Está mais pra um prólogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "A corrupção do Mare Jivari está ligada ao próprio tempo. Em outras palavras, é uma calamidade presente em cada momento no tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "Diferentemente da própria \"Tempo\", eu sempre guardei muitos desejos em meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Quinhentos anos atrás, para prevenir a corrupção do Mare Jivari de se espalhar para além de Tenochtzitoc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "...Eu soprei o Mare Jivari para fora da linha do tempo, transformando numa \"Terra Sem Vento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "Então essa é a verdade por trás do desaparecimento do Mare Jivari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "Opa, parece que eu posso ter confundido você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Se você estiver perguntando como o Mare Jivari desapareceu de Tenochtzitoc duas ou três décadas atrás, pode haver alguém com mais propriedade para contar essa história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "O Mare Jivari foi o portador de histórias demais que não deviam ser dele... Eu meramente desempenhei um papel em um de seus capítulos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "E a escolha que fiz quinhentos anos atrás veio com um preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Algumas almas não conseguiram retornar para Mondstadt como resultado... Enquanto outras ficaram para se estabelecer nesta terra, se fundindo com os Monetoo para se tornarem os Asha que vemos hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Então, o motivo de você estar aqui em Tenochtzitoc é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "Correto. Estou aqui para cooperar com a atual Arconte Pyro, Mavuika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Você tá falando de quando acendemos aquela vela...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Acertou de novo. A chama era nosso sinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "Só fazendo Mavuika abrir uma fenda entre aquele espaço e o verdadeiro Mare Jivari que eu podia ter esperanças de entrar. Aquela era a única maneira de trazer de volta todas aquelas almas que desejavam retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "Quanto ao meu truquezinho de trazer as memórias de volta também... Heh, bem, como você sabe, não é primeira vez que eu faço uma coisa dessas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "Mavuika também mencionou como você queria ajudar nos apresentando... Parece que eu passei na sua frente, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "Fiquei feliz em descobrir que ela compartilha do meu amor por bons vinhos e liberdade. Nos demos muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "Você realmente se superou...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Passei dias cansado... tão cansado que caí no sono de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450738,
					"content": "Isso é verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450739,
					"content": "Mas pensar em toda a Cervejafídio e Vinho de Dandelion não bebidos me convenceu a suportar por mais um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450740,
					"content": "Você não parece tão cansado assim pra Paimon. Não pense que você pode usar essa desculpa e que vamos do nada pagar todas as suas contas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450741,
					"content": "Qualé, você não tá sendo meio exigente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450742,
					"content": "Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450743
					]
				},
				{
					"id": 150450743,
