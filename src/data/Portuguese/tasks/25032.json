			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "Você voltou! Terminou de tirar aquelas fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "#Uau, você é {M#bom}{F#boa}. Muito melhor do que meu assistente, com toda certeza. Sempre que ele tira fotos das áreas que estamos sondando, precisamos de, no mínimo, milhares de fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "Se tivéssemos você na equipe de sondagem, teríamos certamente precisado de menos Aparelhos Fotográficos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "Você realmente consegue usar essas fotos para ajudar a escrever poesia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Eu... acho que sim? Bem, se eu não conseguir fazer isso funcionar, apenas usarei essas fotos como cartões postais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "Vou escrever algo como \"queria que estivesse aqui\" atrás deles e mandar para o Ministério. Ninguém dirá nada, não depois dos presentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
					"content": "*Cof* Mas, isso é apenas em último caso. No meio tempo, farei uma bela tentativa nesse negócio de \"escrever um bom poema\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320609,
					"content": "Os cinco ventos... sopram? ...Não, se agitam, talvez... Espera aí. Quantas tribos Natlan tem mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
			"id": 2503210,
			"completionStepIds": [
				2503201
			],
			"beginWay": "TALK_BEGIN_NONE",
