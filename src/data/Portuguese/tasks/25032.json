	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Hmm... Remeter à poesia com pintura, ou pintar com poetismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Hmm... Não, não, essas duas frases não estão se referindo à mesma coisa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Do que você está falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Ah, olá. Isso mesmo. Estou tentando escrever um poema sobre as paisagens de Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Mas... Para ser honesto, as paisagens daqui são bem diferentes daquelas de Liyue. Também não estou familiarizado com a história local, então eu sequer sei por onde começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Além disso, eu não sou um poeta profissional, nem um rimador de renome... De fato, sequer dei uma animada com um poema de humor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "*Suspira* Mas, eu não posso simplesmente voltar de mãos abanando. Meus colegas no Ministério dos Assuntos Civis vão zombar de mim. \"Você estava buscando inspiração por aí, ou apenas respirando?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Você trabalha no Ministério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Isso mesmo... mais ou menos. Eu fui contratado um tempo atrás para fazer um pouco de sondagens do terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "*Suspira* Em prática, eu estava levando as pessoas por Liyue para ver se a água e solo mudaram, ou se os mapas precisam ser atualizados, e tal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Uma rodada disso me deixou exausto, e só os arcontes sabem quantos pares de sapatos desgastados... Então eu decidi tirar umas férias. Precisava de uma mudança de rotina, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "É só que... eu não sei o que eu estava pensando, mas quando eu apliquei para tirar umas férias, eu dei meu motivo como: \"Tive o impulso de escrever poesia. Vou buscar um pouco de inspiração.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "Eu não esperava que a pessoa encarregada de aprovar licenças responderia tão seriamente com \"que a força poética esteja com você\"... e meio mês de férias junto disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "Isso não é algo bom?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Você acharia que sim... Exceto que agora todo o Ministério sabe o motivo de eu estar de férias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "*Suspira* Tem sido divertido, é claro. Disso não tenho dúvidas. A paisagem é ótima, a comida é muito boa e eles têm todo tipo de vida interessante por aqui, especialmente os pequenos bebezinhos Saurianos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Mas nem sequer um verso de poesia me veio em mente. Nenhum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "Eu até peguei um Aparelho Fotográfico emprestado para conseguir inspiração, mas isso não me ajudou em nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Me dou bem com paisagens naturais, mas esqueça lojas e multidões — eu não consigo entender nada nessas fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Uh, e se eu te ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Espera. Você me ajudaria? Oh, graças aos céus... Preciso conseguir inspiração de qualquer jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Vamos lá, pense, pense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "#Oh, sou ótim{M#o}{F#a} em tirar fotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "E, por acaso, você se provou ser um poeta imponente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Nem um pouco, mas as notícias de minhas férias e seu propósito se espalharam por todas as partes mesmo assim. Agora todos no Ministério sabem o motivo de eu ter vindo para Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Você está escrevendo poesia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
			"completionStepIds": [
				2503206,
				2503210,
				2503217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
