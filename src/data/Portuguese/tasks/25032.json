					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"25032"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "Ah, sim! Eu soube de gente dizendo que o Povo das Termas tem placas de lojas muito distintas, e entre elas, acredito, está os \"Estúdios Djembe\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250321002
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250321002,
					"content": "Por favor, me ajude a tirar uma foto daquele estúdio logo cedo de manhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
		{
			"id": 2503211,
			"completionStepIds": [
