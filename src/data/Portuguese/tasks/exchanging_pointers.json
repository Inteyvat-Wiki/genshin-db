				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Bom, Connor! Você fez um ótimo trabalho! Se continuar assim, com certeza a Diona vai trabalhar para a Adega do Alvorecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Espero que funcione! Esperei algumas semanas para ter um encontro com ela, e vou certamente agarrar essa oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Muito obrigado, Connor! Você foi ótimo! Todos os nossos esforços valem a pena se conseguirmos convencer Diona a trabalhar para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Temos que deixar a Diona sentir a nossa sinceridade e paixão. Mas lembre-se, não pode ser de uma maneira grosseira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Sem problemas, Elzer! Já praticamos várias vezes, e vai correr tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "O que vocês estão falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Ah? Nada... Nada... Estamos apenas falando sobre negócios da adega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Isso! Estamos apenas falando sobre isso. Ah sim, Elzer, sobre as despesas da Adega, o que você acha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
