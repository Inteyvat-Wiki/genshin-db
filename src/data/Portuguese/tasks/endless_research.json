			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "Ugh. Como vou escrever minha tese desse jeito? O que devo fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100102,
					"content": "Está tudo bem com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Eu... O quê? Oh! É você! Ainda se lembra de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100104,
					"content": "Eu era aquela, err, pessoa que você encontrou em uma gaiola dos Ladrões de Tesouro no Passe de Lingju. Heh, de qualquer forma, obrigado por me salvar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100105,
					"content": "O que te traz aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "Bem, err, após ser resgatado por você, fui procurar Soraya no Albergue Wangshu. Por sorte, consegui encontrá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100107,
					"content": "Soraya é uma ótima pessoa - ela não apenas me ofereceu uma refeição, mas também me ajudou a reorganizar minhas anotações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100108,
					"content": "Mas... ela me disse depois que o tema que eu escolhi já foi discutido em muitas outras teses na Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100109,
					"content": "A menos que eu escreva uma tese inédita, não tem como passar... Ela me aconselhou a mudar de perspectiva - por exemplo, eu poderia escrever sobre algo relacionado aos elementos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100110,
					"content": "Mas como não tenho uma Visão e não consigo usar os elementos, não sei por onde começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100111,
					"content": "Então não havia nada a fazer senão vir à cidade e tentar encontrar algum material aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100112,
					"content": "Espere... Quando me salvou naquele dia, você lutou de maneira única...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100113,
					"content": "Por acaso você tem uma Visão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100114,
					"content": "Não, eu não tenho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "Ahn? Você luta desse jeito sem ter uma Visão? Como isso é possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100116,
					"content": "Não, deixa para lá. Sem dúvida deve ser uma história muito longa... De qualquer forma, preciso pedir uma coisa a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100117,
					"content": "Poderia mostrar sua forma de lutar para mim? Talvez eu veja algo que possa ser usado para refinar minha tese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100118,
					"content": "Por favor, me ajude! Se eu não terminar essa tese, vão acabar comigo quando eu voltar para a Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100119,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "Muito obrigado! Vamos lá para fora então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100121,
					"content": "Me lembro de ter notado um grupo de Hilichurls ao redor destas partes. Me mostre seu estilo de luta, usando-os como seu alvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100122,
					"content": "A Academia é tão assustadora assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Oh, é um lugar muito, muito assustador. Acordo chorando sempre que sonho com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100124,
					"content": "Prefiro ficar naquela gaiola dos Ladrões de Tesouro do que fazer outro esboço ou defesa de tese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100125,
					"content": "Tudo bem, chega de Academia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100126,
					"content": "Me lembro de ter notado um grupo de Hilichurls ao redor destas partes. Me mostre seu estilo de luta, usando-os como seu alvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181003",
							"2"
						],
						"stepId": 7181003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Uau... Seu estilo de luta é realmente único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100202,
					"content": "Oh sim. Também ouvi dizer que os portadores de uma Visão podem sentir a presença de elementos. Algo conhecido como Visão Elemental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100203,
					"content": "Embora você não tenha uma Visão, vi você manipular a energia elemental - então você deve ter essa habilidade, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100204,
					"content": "Descobri alguns Slimes aqui perto. Poderia me mostrar sua Visão Elemental novamente? Use-a para encontrar os Slimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Haha, da perspectiva de alguém sem uma Visão como eu, não percebi você usar a Visão Elemental...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100302,
					"content": "Suponho que seja algo que apenas outros portadores de uma Visão podem sentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100303,
					"content": "Mesmo assim, obrigado por demonstrar tantas coisas para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100304,
					"content": "*Suspiro* Como eu gostaria de ter uma Visão... Ter uma Visão Electro seria o máximo. É bem legal e eu poderia me defender também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100305,
					"content": "Hmm, não - uma Visão Electro provavelmente seria a mais difícil de conseguir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100306,
					"content": "Tenho certeza de que você conseguirá se trabalhar duro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "Não, isso não vai acontecer, não importa o quanto você tente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100308,
					"content": "Espere. Você não sabe? Parece que ninguém conseguiu uma Visão Electro no último ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100309,
					"content": "Ouvi dizer que a Academia tem investigado isso há algum tempo, e eles concluíram que a falta de Visões Electro concedidas aos mortais é a vontade da Arconte Electro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100310,
					"content": "Também ouvi dizer que a Arconte Electro de Inazuma proclamou um \"Decreto de Caça à Visão\" para confiscar a maioria das Visões dos portadores de Visão em Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100311,
					"content": "Quem desobedecer e esconder sua Visão será punido severamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100312,
					"content": "Queria viajar para Inazuma e escrever uma tese sobre o decreto, mas parece ser um lugar perigoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100313,
					"content": "Você ficará bem. Você não tem uma Visão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "E—ei, não diga isso! Pense bem, se as pessoas com Visões já estão sofrendo, não acha que seria pior com quem não tem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100315,
					"content": "Acho melhor ficar aqui em Liyue, terminar minha tese em paz e apresentar minhas conclusões à Academia Sumeru o mais rápido possível. Se demorar muito, não viverei para saber o final da história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100316,
					"content": "Ah, sim, ainda preciso te agradecer por me mostrar tantas coisas. Considere isso como provas da minha consideração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100317,
					"content": "Desta vez, com certeza terminarei minha tese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		}
	]
}