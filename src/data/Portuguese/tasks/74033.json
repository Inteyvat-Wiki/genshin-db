							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Mitul, tá tudo bem? Espero que não tenha ficado preso por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330402,
					"content": "Meu salvador! Finalmente chegou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330403,
					"content": "Cadê Koblenz? Ele não tá com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330404,
					"content": "Ele me falou sobre te prender aqui e me pediu ajuda, mas saiu porque um guarda interrompeu a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330405,
					"content": "Sabia que ele não era confiável! Ele provavelmente fugiu porque se sentiu culpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330406,
					"content": "Digo, como você ganha dinheiro nos negócios se não se arrisca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330407,
					"content": "Ele era desajeitado e cauteloso demais para completar... Digo, Água da Pureza é uma coisa, mas até Fonta está disponível atualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330408,
					"content": "Se Fonta está aqui, como devemos sobreviver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330409,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330410,
					"content": "O quê, você gosta de Fonta também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330411,
					"content": "Você não gosta de Fonta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Gosto! Tenho que admitir, é um rival formidável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330415,
					"content": "Enfim, tenho que resolver isso com Koblenz. Por sinal, ele pagou vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330416,
					"content": "Não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330417,
					"content": "...Às vezes eu quero enfiar ele em um balde grande. Isso vai fazer ele refletir sobre o que fez. Enfim, peguem esses Cupons Especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330418,
					"content": "Podem pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330419,
					"content": "O quê? Você quer que a gente pegue tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330420,
					"content": "Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330421,
					"content": "Obrigada, então. Podemos ir até a Loja Osso Duro de Roer mais tarde ver se eles têm alguma coisa nova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330422,
					"content": "Falando nisso, eu queria me desculpar por arrastar vocês a isso. Tenho algumas bebidas saudáveis frescas — gostariam de uma garrafa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330423,
					"content": "Bebidas saudáveis... frescas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330424,
					"content": "Sim! Mais saudável do que Água da Pureza, na verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330425,
					"content": "Eu aceito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(Ei, Caterpillar não disse pra recusar?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330427,
					"content": "#Não, {NICKNAME} não quis dizer isso! Já bebemos muito no caminho para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330431,
					"content": "Mas Paimon aposta que essas bebidas são boas! Com certeza vamos provar da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330432,
					"content": "Momento inoportuno, né? Bem, voltem quando tiverem chance. Mostrarei minha hospitalidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330433,
					"content": "Enfim, devo ir falar com Koblenz agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330434,
					"content": "Tenho outra coisa para resolver, então preciso ir. Não se preocupem demais com os Cupons Especiais. <color=#00E1FFFF>Vou colocar as pistas que encontrar na lousa de giz</color>. Vamos nos encontrar depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330435,
					"content": "Até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330428,
					"content": "Eu vou querer uma Fonta, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Bem, eu também tenho isso. Espera. Por que você tem um problema com minhas bebidas saudáveis? Deixa eu te contar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330430,
					"content": "#Não foi isso que {NICKNAME} quis dizer! É só que... a gente bebeu muito antes de vir para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330413,
					"content": "Não é nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "Um cliente com bom gosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				}
			]
		}
	]
}