			"dialogs": [
				{
					"id": 740330101,
					"content": "Ninguém vem mais aqui depois que o Poço da Mina de Geodes foi fechado e os dispositivos aqui não são para qualquer um mexer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "E é exatamente o que aconteceu dessa vez. Alguém mexeu com a válvula de transmissão e prendeu o próprio companheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "Enfim, vamos operar para abrir a passagem para o <color=#00E1FFFF>Armazém de Suprimentos 1</color>. Por sinal, se te oferecerem uma bebida, é melhor recusar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "Quem vai oferecer uma bebida? E por que não vamos aceitar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Você vai descobrir logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
