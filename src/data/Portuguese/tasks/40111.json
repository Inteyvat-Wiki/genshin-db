			"dialogs": [
				{
					"id": 401115301,
					"content": "Ouvi você se referir a sua oponente como uma \"kitsune youkai\" mais cedo, você poderia me dizer um pouco mais sobre isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Não deixe de dar nenhum detalhe. Quem sabe, talvez tenha algo que eu possa usar na minha notícia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Oh! É melhor não, tenho medo de dizer algo errado. Além disso, eu não sou exatamente a youkai mais qualificada para responder perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "Ok, então talvez você possa explicar por que uma kitsune teria tanto interesse em Tofu Frito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Ah, agora as suas perguntas estão me deixando faminta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Por que eu não apenas te levo para experimentar alguns Ramem Kitsune aqui em Inazuma? Posso explicar enquanto comemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
			]
		}
