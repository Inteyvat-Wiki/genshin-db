			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "Ouvi dizer que até mesmo o torneio não oficial do Chamado Sagrado dos Sete está desfrutando de uma enorme participação. Muitos jogadores sérios de cartas se registraram tanto para o torneio oficial quanto o não oficial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Quanto a mim... eu não me importo de tentar jogos de tendência de tempos em tempo, embora eu prefira xadrez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Mas, no fim das contas, quaisquer diferenças que existam entre os diversos jogos que existem, eles compartilham uma coisa em comum: Eles juntam amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
