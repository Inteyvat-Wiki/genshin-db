			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "Eu ganhei, eu ganhei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111102,
					"content": "Parabéns, Timmie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "Obrigado. Mal posso esperar para contar à minha mãe... Isso vai deixar ela bem feliz, não vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111104,
					"content": "Foi a mamãe que ficou insistindo para que eu entrasse no torneio, então eu vou dar a premiação para ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111105,
					"content": "Eu realmente gostaria que meu pai pudesse me ver agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 401111106,
					"content": "Adeus, Timmie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "Adeus! Ah, Chamado Sagrado dos Sete é muito divertido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mika",
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "Espere, por que todos estão indo embora? Cheguei tarde demais...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111202,
					"content": "Ah, Mika. Uma pena que você não estava aqui para ver. Infelizmente... o Capitão Kaeya perdeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111203,
					"content": "O quê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111204,
					"content": "Conte-me tudo! O que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111205,
					"content": "Bem, pessoalmente, eu não sei muito sobre Chamado Sagrado dos Sete, mas eu tentei acompanhar pelo que as outras pessoas estavam dizendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111206,
					"content": "O Capitão Kaeya derrotou uma das cartas de personagem do Timmie logo no início, dando a ele uma vantagem logo cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111207,
					"content": "Mas acho que era tudo parte da estratégia do oponente...? De qualquer forma, Timmie passou as primeiras rodadas apenas juntando cartas em sua mão, e então virou o jogo com uma ofensiva brutal bem no final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111208,
					"content": "Hmm, mas quem sabe, talvez a partida já estivesse terminada desde o momento que jogaram a moeda e determinaram que o Kaeya iria em segundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111209,
					"content": "*Suspiro* Preciso beber algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111210,
					"content": "Se acalme, cara. Agora não é o momento de afogar as mágoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111211,
					"content": "Conhecendo o Capitão Kaeya, ele não gostaria de nos ver tão chateados por ele ter perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111212,
					"content": "Ei, por que não aprendemos a jogar também? Talvez, assim, possamos jogar contra o Capitão Kaeya algum dia! Hehe... Mas tenho certeza de que perderíamos feio para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111213,
					"content": "Hah, é, você tem razão, Mika. Não é um plano ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
