			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Olá. Mais alguma coisa que você queira conversar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "Sobre o Chamado Sagrado dos Sete...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "O jogo realmente ficou bem popular ultimamente. É parte da vida cotidiana agora. Não importa onde você vá, você vê pessoas jogando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "Na verdade, algumas pessoas até pararam de beber para manter a concentração durante o jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Hehe, tenho certeza de que a Diona vai ficar feliz em ouvir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "Como estão os Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Não se preocupe, todos estão bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "Na verdade, eu até consegui convencer a Jean a jogar uma partida comigo, mas só conseguimos chegar até a metade do jogo antes dela ser convocada. Acabei tendo que terminar a partida por nós dois. *Suspira* Mas o que poderíamos fazer? Todos nós precisamos colocar o trabalho em primeiro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "Mas, vendo o sucesso do torneio e o tanto todo mundo se divertiu, espero que pelo menos ela tenha uma coisa a menos com o que se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Vamos conversar melhor em outro momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Claro. Deveríamos jogar uma partida do Chamado Sagrado dos Sete quando você puder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011114,
