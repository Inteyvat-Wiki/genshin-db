			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charlotte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "\"A Cidade Do Lago Está Repleta de Talentos no Torneio de Cartas: Jovem Prodígio Ganha do Capitão da Cavalaria de Favonius\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Hmm, esse título favorece os Cavaleiros, mas não tem muita graça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "\"Maior Mente Estrategista dos Cavaleiros de Favonius é Derrotado por Garoto da Ponte em Cinco Rodadas\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "\"Capitão Tem Esperança em Campeonato Estraçalhada em Grande Derrota\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Hmm... Será que eu deveria ficar com o meu primeiro rascunho...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
		{
