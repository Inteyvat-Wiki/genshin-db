			},
			"dialogs": [
				{
					"id": 401111401,
					"content": "Que torneio incrível. Aquele Timmie, hein... Ele realmente tem o dom para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "Pois é, surpreendeu todo mundo... Mas pelo menos eu me sinto um pouco melhor de ter perdido para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lennard"
				}
			]
		},
		{
			"id": 4011115,
