			},
			"dialogs": [
				{
					"id": 401113101,
					"content": "A propósito, a Capitã Beidou joga Chamado Sagrado dos Sete, por acaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 401113102,
					"content": "Sim. Na verdade, ela é uma das melhores de toda Frota Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Você se importaria de falar de mim, Kazuha? Sou uma grande fã da Capitã Beidou. Sempre sonhei em fazer amizade com ela algum dia, mas até então, nunca tive a oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hutao"
				},
				{
					"id": 401113104,
					"content": "Claro. Mas, por favor, seja gentil quando você inevitavelmente derrotá-la no Chamado Sagrado dos Sete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
