			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charlotte",
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "Olá, meu nome é Charlotte. Sou uma repórter do Pássaro a Vapor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Eu poderia tomar um pouco do seu tempo para uma breve entrevista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*Suspira* Certo, vá em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113304,
					"content": "Você começou de forma promissora na competição, deixando muitos competidores comendo poeira enquanto você ia em direção a final, antes de perder por pouco uma vitória no campeonato, quando você perdeu para Diretora Hutao da Funerária de Wangsheng. Deve ser difícil para você, sabendo quão perto você chegou da vitória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Com isso em mente, você gostaria de compartilhar seus pensamentos em como foi essa partida final?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Uhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113307,
					"content": "Desculpe, você quer uma resposta para a mídia, ou você quer saber meus pensamentos verdadeiros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113308,
					"content": "Gostaria de ouvir seus pensamentos verdadeiros, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*Suspiro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113310,
					"content": "Bem, eu sempre disse que jogar cartas é setenta por cento de habilidade e trinta por cento de sorte... Mas quando o seu oponente tira seis dados do mesmo elemento de vez, não tem como superar isso, nem mesmo com habilidades de nível de um adeptus... então não existe esperanças para um mero aventureiro feito eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4011151,
			"completionStepIds": [],
