			"trigger": {
				"objectNames": [
					"Arataki Itto",
					"Kuki Shinobu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Ufa, aquela partida entre a moça raposa e a moça peixe realmente deixou meu sangue fervendo! O suor está praticamente evaporando de minha testa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Sim, sim. Tenho certeza de que todos em Ritou sabem o quão animado você está, mas a gangue está esperando por nós. Deveríamos voltar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "#Ehh, eles podem esperar mais um pouco... Pelo menos {M#meu consagrado}{F#minha consagrada} e eu poderemos jogar uma última partida! Você não pode negar isso... por favorzinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "Tudo bem, vamos jogar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "#{M#Esse é o meu consagrado}{F#Essa é a minha consagrada}! Eu sabia que você estaria dispost{M#o}{F#a} a um duelo! Só você entende um jogador da pesada feito eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "Sinceramente, o que eu vou fazer com vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "Talvez da próxima vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "...Tá bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "Está tudo bem, eu não te culpo... Mas você provavelmente deveria ir embora. Você não quer ver um oni crescido chorando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
