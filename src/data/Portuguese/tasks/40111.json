				"points": []
			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "General Kujou, posso falar com você um instante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Sim. Parabéns pela sua vitória, Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Eu quis demonstrar minha gratidão pelo conselho útil que você me deu antes da partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Não foi nada. Qualquer um que tenha uma cabeça funcional em seus ombros sabe que habilidade e estratégia determinam o vencedor. De qualquer forma, foi uma partida animada de se assistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "É uma pena que você não tenha se registrado para o torneio, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Temo que eu não seria párea para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Não diga isso. Você não é tão diferente de mim... procurando oportunidades para aprimorar suas habilidades no jogo, considerar medidas defensivas, e competir com os outros como se fossem amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "...Talvez você tenha um ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "Nesse caso, vamos jogar uma partida do Chamado Sagrado dos Sete antes que você vá para a Ilha Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Com muito prazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
