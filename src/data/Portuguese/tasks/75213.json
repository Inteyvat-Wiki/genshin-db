			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "Olá, aqui estão suas bebidas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "Ah! Ha! Então vocês são o pessoal da entrega. Eu estava me perguntando por que estava demorando tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "A culpa é toda sua! Você pediu para entregar o pedido a \"um hóspede de calça azul na praia\", e aí foi se enterrar na areia! Passamos um tempão procurando você e sua calça azul boba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Você devia pagar o dobro da taxa de entrega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Ah, nesse caso, a culpa foi toda minha mesmo. Esqueci disso... Devia ter deixado minha calça pra fora da areia pra vocês me encontrarem mais fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Mas... por que você está enterrado na areia, afinal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Porque é muito divertido! Ouvi dizer que é algo que as pessoas fazem nas férias, então quis experimentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Ué, você não tá fazendo isso errado? Parece mais uma cenoura enfiada no chão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "É mesmo? Isso é... um problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Alguém pode tropeçar em você, e os dois podem se machucar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Hmm, entendi... Vou pensar nisso. Ah, e aqui está sua taxa — dobrei o valor! Valeu de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
