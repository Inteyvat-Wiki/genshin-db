					"nextDialogs": [
						752130503
					]
				},
				{
					"id": 752130503,
					"content": "Bebida grátis? Uhul! Parece que os Arcontes ouviram minhas preces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
