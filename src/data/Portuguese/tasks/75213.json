			"dialogs": [
				{
					"id": 752130201,
					"content": "Posso ajudar em algo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Hmm? Sério? Bem, se você insiste... Já enviamos toda a nossa equipe e ainda temos um pedido de entrega urgente que precisa ser feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Há uma anotação no pedido para que seja entregue a <color=#00E1FFFF>um hóspede de calça azul na praia</color>. Está tudo certo, contanto que chegue a tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "Mas falando sério, obrigada pela ajuda. Além da taxa de entrega, também vou incluir a receita da nossa bebida como compensação pela sua ajuda. Estou contando contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
