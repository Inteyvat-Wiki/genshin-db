					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "O quê?! Paimon quase teve um ataque cardíaco sendo sugada pra uma pintura assim!... Espera um segundo, esse lugar parece familiar... Ah, é a mesa onde as bruxas fazem as festas do chá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Tudo começou na primeira vez que Alice me convidou para tomar chá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "Naquele dia, eu não compareci pessoalmente, principalmente porque, na época, eu ainda não tinha decidido se queria mesmo me juntar à Sociedade das Feiticeiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Alice era a única que sabia da minha identidade verdadeira. Ela me avisou para não dizer nada, ou não deixar ninguém descobrir quem eu era. Eu só deveria observar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "E o que aconteceu depois?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Bem... Aí concluí que ela estava me punindo por minha hesitação em me unir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Todas estavam falando sobre coisas tão interessantes. Como eu poderia não participar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Claro, quando você tá no meio de uma conversa e alguém faz uma pergunta que você sabe responder, como você vai conseguir ficar de boca fechada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "O que nos traz à aposta entre Barbeloth e Alice, as criações proibidas de Rhinedottir, as conspirações políticas de Ivanovna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Era como uma série de cenas interpretadas incrivelmente, destiladas nos confins de uma xícara de chá. As palavras delas foram suficientes para acender meu instinto de expor a verdade para elas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Aí você se meteu na cabeça delas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Claro que não! Apesar de eu sentir como se minha cabeça fosse explodir, ainda garanti segurar tudo. Sou um anjo responsável, afinal, e sei bem a diferença entre \"o que eu quero dizer\" e \"o que posso dizer\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "Então tive uma palavrinha em particular com Alice na cabeça dela, só nós duas, e concordei em me juntar à Sociedade das Feiticeiras, naquele mesmo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Ela ficou muito contente com minha decisão, mas quanto a falar na cabeça dela... Bem, ela disse que, nos dias seguintes, ela ficou uma dor de cabeça tão grande que teve que visitar um médico em Liyue para aliviar. Mas ela não pode me culpar por isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620303,
