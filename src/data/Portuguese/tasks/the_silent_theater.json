			"dialogs": [
				{
					"id": 762030401,
					"content": "Ei, aqui é Simulanka! Hmm, mas por que tem light novels da Editora Yae no chão todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Bem, em relação à minha iluminação literária, minha maior inspiração de todas... é ninguém mais do que a própria Srta. Anya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "Ela foi a última a se unir à Sociedade das Feiticeiras, mas a primeira a sair...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "Eu amava todas as histórias dela. Fosse só uma ideia ou um manuscrito completamente desenvolvido, Anya era sempre tão habilidosa em fazer os leitores dela ficarem surpresos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Discussões da Sociedade das Feiticeiras raramente iam além da magia, e eu acredito que Anya possuía uma magia única a ela. Ela podia tecer amor e compaixão em palavras e histórias que tocariam os corações de outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Eu pedi a ela dicas de como escrever histórias envolventes. Ela me ensinou muitos truques e técnicas, mas, no fim, meu maior inimigo sempre fui eu mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Preguiça demais pra levar caneta até o papel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Ha! Essa é uma forma de dizer. Me comunicar por pensamentos é tão mais conveniente. Acho que anjos podem sucumbir à preguiça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Contudo, recentemente, decidi fazer um esforço, mesmo que seja somente para me poupar de esporros de uma certa Seelie amiga minha das antigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Aah! Isso quer dizer que vamos finalmente poder ler alguma coisa que você escreveu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Quem falou sobre escrever? Estou falando sobre comprar obras populares dos últimos séculos para ler no meu tempo livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Ha! Essa é uma forma de dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Me comunicar por pensamentos é tão mais conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
