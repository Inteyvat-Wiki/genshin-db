						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "Ah, vocês chegaram! Eu tava começando a me perguntar se deveria ter enviado instruções mais claras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Mas aí eu pensei, se deixar minhas dicas óbvias demais, pode atrapalhar seus planos de viagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "Aí, bem enquanto eu andava de um lado para o outro, agonizando sobre o que eu iria fazer... Vocês apareceram aqui! Então, parece que deu tudo certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "Oi, Nicole! Você tá tão cheia energia hoje! E... palavras... tão cheia de palavras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "#Vou considerar isso um elogio! Tudo bem, então, pront{M#os}{F#as} para conferir o próximo cômodo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
