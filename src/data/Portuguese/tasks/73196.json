					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960802,
					"content": "Se você tiver alguma informação sobre eles, visite a Loja de Tesouros Menakeri e entre em contato com Khalid. Você será recompensado generosamente!",
