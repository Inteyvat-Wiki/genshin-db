			"dialogs": [
				{
					"id": 731960701,
					"content": "Vendemos uma grande variedade de produtos básicos. A qualidade dos nossos artigos é garantida graças a um controlo pessoal realizado pelo proprietário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960702,
					"content": "\"Pai, você pode me dar um pouco mais de dinheiro? Ouvi dizer que o preço das tâmaras vai disparar em breve. Tenho certeza de que vou fazer uma fortuna desta vez.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
