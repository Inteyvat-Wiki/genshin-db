				},
				{
					"id": 731961102,
					"content": "\"Quando posso pegar as roupas que enviei para você no mês passado?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961103,
					"content": "\"Eu sinto muito mesmo! Minha esposa deu à luz nosso bebê ontem, então não tive tempo de trabalhar. Volte amanhã, por favor. Eu garanto que elas estarão prontas a tempo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961104,
					"content": "\"Mas já se passaram três meses. Devolva minhas roupas. Não quero mais tingi-las.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961105,
					"content": "\"Desculpe! Suas roupas foram roubadas por um ladrão enquanto estavam sendo secas após o processo de tingimento. Por favor, cace o ladrão se você as quiser de volta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
