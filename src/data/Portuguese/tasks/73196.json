					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Você já ouviu falar de levitação? Você já viu alguém voar? Quer saber o mistério por trás dos Animais de Carga? Então não perca a primeira apresentação do Grupo de Arte Voadora de Fontaine em Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960302,
					"content": "Bem-vindo, o show está aqui! Não perca esta mostra de arte única. Apenas cinco Mora por um bilhete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960303,
					"content": "Devido a relatos do público, descobrimos que este show não foi aprovado pela Academia, e este anúncio será retirado imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
