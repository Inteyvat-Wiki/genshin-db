			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Nosso banco está prestes a abrir em breve um escritório em Sumeru! Convidamos você a aproveitar, querido futuro cliente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960402,
					"content": "Se você tiver algum negócio para cuidar, entre em contato com Viktor para ser feito em nossa filial de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960403,
					"content": "Se você está pensando em solicitar um empréstimo, venha e consulte nosso Agente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
