				},
				{
					"id": 731961402,
					"content": "De acordo com nossa investigação, o proprietário original foi dado como desaparecido durante uma expedição no deserto há três anos. De acordo com os regulamentos, a gestão do café deve ser transferida para o Vahumana.",
					"roleType": "TALK_ROLE_NPC",
