				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "A Bolsa Kalimi empreende todos os esforços para garantir a precisão e confiabilidade de todas as informações fornecidas, mas não garante sua precisão e integridade de forma alguma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960202,
					"content": "Todas as partes interessadas não podem reclamar perdas decorrentes do uso das informações de mercado, no todo ou em parte, que estão publicadas neste quadro de avisos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
