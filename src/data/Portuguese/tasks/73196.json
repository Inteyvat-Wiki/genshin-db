			"dialogs": [
				{
					"id": 731961601,
					"content": "Busque a felicidade na vida! Saia de casa para explorar o mundo! Junte-se a Liga dos Aventureiros agora e torne-se nosso membro! Apenas cinco mora para o seu primeiro mês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961602,
					"content": "O verdadeiro conhecimento só pode ser obtido através da prática real. É muito mais significativo perder a vida numa árdua travessia do que ser um preguiçoso a vida inteira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961603,
					"content": "\"Olhe com cuidado! É a Liga dos Aventureiros, não a Guilda de Aventureiros.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961604,
					"content": "\"O quê?! Eu paguei por um ano! Posso pegar meu dinheiro de volta?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
