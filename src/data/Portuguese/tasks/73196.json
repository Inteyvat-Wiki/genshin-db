			"dialogs": [
				{
					"id": 731961001,
					"content": "\"Eu já possuí uma riqueza infinita, mas por conta de desperdício não consegui acalmar meu coração.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961002,
					"content": "\"Depois desta viagem, não sobrou nenhuma Mora na minha bolsa de moedas, mas me sinto em paz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731961003,
					"content": "\"Se você gostaria de ouvir minha história, então venha para minha loja de vegetais. Claro, é melhor você comprar alguns vegetais enquanto estiver aqui.\"",
					"roleType": "TALK_ROLE_NPC",
