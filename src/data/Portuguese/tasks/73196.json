			"dialogs": [
				{
					"id": 731960101,
					"content": "Este quadro de avisos da Bolsa Kalimi destina-se à publicação de informações comerciais de comerciantes nacionais e estrangeiros. Postagens irrelevantes são proibidas.",
					"roleType": "TALK_ROLE_NPC",
