			"dialogs": [
				{
					"id": 731960501,
					"content": "Tapetes tricotados à mão, uma obra-prima da arte de Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960502,
					"content": "Todo morador de Sumeru deveria ter um tapete assim na vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 731960503,
					"content": "Os tapetes têm um preço, mas a arte não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
