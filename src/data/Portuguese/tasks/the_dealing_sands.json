						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "Quando compartilhamos laços, não dizemos \"obrigado\" nem mesmo para favores grandes. Se estiverem em apuros, é só chamar que a gente aparece rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160203,
					"content": "Uau! Não precisa ser tão formal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "Então vou direto ao ponto. A grana está um pouco apertada ultimamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Tá precisando de Mora? Haha, bem, o negócio é que a gente tá com um probleminha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160206,
					"content": "Nossa Mora? O mandachuva levou tudo. Estamos na pior aqui, totalmente quebrados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160210,
					"content": "Mandachuva?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Nosso Chefe, o líder da Gangue do Sal de Ferro. Ele tá com uma galerinha de Fontaine lá embaixo do penhasco, e deixou a gente para proteger a fortaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160212,
					"content": "Mas você viu o que aconteceu também, certo? Aqueles sapos de Fontaine entraram sorrateiramente enquanto o mandachuva estava fora e nos apunhalaram bem onde o sol não toca, nos colocaram em apuros pra valer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160213,
					"content": "Quêêêê!? O-onde o sol não toca...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Eita...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Ei, tá tirando uma com a minha cara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160216,
					"content": "#Já que eles deram bandeira e mostraram a cara aqui, é só uma questão de tempo até traírem o Chefe. O que você acha, parceir{M#o}{F#a}? Pela Mora ou pela honra, você não vai desistir agora, vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160217,
					"content": "Contanto que o Chefe esteja seguro, não vai faltar nem grana e nem coisa boa pra você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160218,
					"content": "Onde ele está? Vou dar uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "Na praia debaixo daquele penhasco. Você vai ver ele quando chegar lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160220,
					"content": "Conto com vocês. Eu passo lá depois que resolver as coisas aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160207,
					"content": "Apenas fazendo minha parte para manter a justiça.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Muito justo! Justo além da medida! Nesse caso, tenho algo interessante pra contar para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160209,
					"content": "Nosso mandachuva... Ele provavelmente está bem ferrado, tá precisando de ajuda, sacou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Donzela de Ferro"
				}
			]
		},
