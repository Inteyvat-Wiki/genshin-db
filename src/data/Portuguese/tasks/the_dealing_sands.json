					}
				]
			},
			"dialogs": [
				{
					"id": 711160801,
					"content": "#Essa viagem realmente valeu a pena! Não só conseguimos quem viemos buscar, mas também conhecemos {M#o}{F#a} famos{M#o}{F#a} Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Olhos de Ferro"
				},
				{
					"id": 711160802,
					"content": "Você conhece a gente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "Claro. Tenho parentes no Porto de Liyue, e ouvi falar muito sobre você, então reconheci você desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160804,
					"content": "Mas havia muitas pessoas ouvindo por perto, e eu não queria arriscar assustá-las, então não fui sincera. Desculpe por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160805,
					"content": "Então, não estivemos envolvidos em uma transação ilegal, mas em uma operação dos Millelith para capturar criminosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Correto. Estávamos de olho nessa gangue há um tempo, mas só conseguimos nos infiltrar neles recentemente com um pouco de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Olhos de Ferro"
				},
				{
					"id": 711160807,
					"content": "Já se passou cerca de um mês desde então, mas hoje finalmente tivemos a oportunidade de pegar a Gangue do Sal de Ferro e o Peixão de Fontaine de uma só vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Olhos de Ferro"
				},
				{
					"id": 711160808,
					"content": "Sem mencionar o fato de que aqueles sujeitos de Fontaine quase nos eliminaram com seus truques sujos. Tivemos a sorte de ter sua ajuda, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160809,
					"content": "Infelizmente, teremos que adiar a festa chique que prometemos. No entanto, temos algumas Moras para você. Por favor, aceite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160810,
					"content": "#E nem pense em recusar. Você deve ser recompensad{M#o}{F#a} por ajudar os outros. Esse é o contrato que todos nós devemos cumprir. Caso contrário, no futuro, cada vez menos pessoas estarão dispostas a estender a mão para aqueles que precisam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160811,
					"content": "Muito bem, vamos cuidar do resto. Não vamos tomar mais do seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160812
					],
					"speakerTitle": "Olhos de Ferro"
				},
				{
					"id": 711160812,
					"content": "Boa sorte na sua jornada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Olhos de Ferro"
				}
			]
		},
