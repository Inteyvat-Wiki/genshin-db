			},
			"dialogs": [
				{
					"id": 711160601,
					"content": "#{M#Dois heróis}{F#Duas heroínas} incríveis! Estou em dívida com vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160602,
					"content": "Está tudo bem! Não importa onde você faça um acordo, você deve sempre honrar seu contrato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Hehe, essa pequena heroína entendeu! Mas parece que vocês conhecem muito bem nosso acordo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160604,
					"content": "A Donzela de Ferro nos contou sobre isso. Ela disse que vocês estavam contrabandeando ou algo do tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "Mas o que significa \"contrabandear\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Algum tipo de transação ilegal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "#Nesse caso, eu devo recompensar vocês, {M#cavaleiros}{F#cavaleiras}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160608,
					"content": "#Rapazes! Venham amarrá-l{M#o}{F#a}s bem firme e jogá-l{M#o}{F#a}s no mar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160609,
					"content": "#Certifiquem-se de amarrar algumas pedras extras também. El{M#e}{F#a}s fizeram um grande favor para nós, da Gangue do Sal de Ferro, então não vamos fazer el{M#e}{F#a}s sofrerem mais do que deveriam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160610,
					"content": "O quê!? Você... Você quer fazer O QUÊ conosco!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Querida pequena cavaleira, pelo que você acabou de dizer, eu pensei que você entenderia. Liyue é realmente um lugar muito específico sobre contratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160612,
					"content": "E entrar em uma transação entre criminosos significa que você será silenciado. Certamente isso é um contrato não dito conhecido por todos, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160613,
					"content": "Não existe isso! Retribuir nossa bondade com assassinato é a verdadeira quebra de contrato aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Por favor, não tornem isso mais difícil para vocês. Se eu tiver que fazer isso sozinho, vocês vão enfrentar uma dor terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160615,
					"content": "Você sabe quem eu sou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "#Calem-se! Donzela de Ferro, Olhos de Ferro, o que vocês estão esperando? Peguem el{M#e}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160618,
					"content": "Chefe Tieming... Você é realmente sem coração. Injusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Olhos de Ferro"
				},
				{
					"id": 711160619,
					"content": "Desde que possamos impedir vilões como você de sujar Liyue com sua conduta criminosa, todos os nossos esforços terão valido a pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160626,
					"content": "Fechem o cerco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160620,
					"content": "O-O quê...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160621,
					"content": "Tieming seu miserável! Abra os olhos e olhe bem! Quem somos nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Donzela de Ferro"
				},
				{
					"id": 711160622,
					"content": "M-Millelith!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160623,
					"content": "Calma aí, calma! O que está acontecendo? Como é que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Eu pensei que vocês fossem só novatos, nunca imaginei que fossem um bando de investigadores malditos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160625,
					"content": "Não achem que vou me render tão fácil! Podem vir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tieming"
				},
				{
					"id": 711160616,
					"content": "Essa não, estou tremendo de medo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
		{
