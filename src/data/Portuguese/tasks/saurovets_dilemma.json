			"dialogs": [
				{
					"id": 750180101,
					"content": "—Shwaaaargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "\"Kururuk\""
				},
				{
					"id": 750180102,
					"content": "Qual é, vamos lá, para de besteiras. Se você não tomar seus remédios, você não vai melhorar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180103,
					"content": "#Oh, não, ela está em perigo! Precisamos ajudá-la, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
