					"id": 750181009,
					"content": "Estou impressionada com quão bem vocês se dão com esse Tepetlissauro. Eu posso aprender muito com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "Eu sou a última bolacha do pacote.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "Eu adoraria dizer que poderia ajudar você com algo, ou fazer por você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "Mas eu acho que vou só desejar o melhor pra vocês. Que vocês nunca precisem da minha ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181014,
					"content": "Certo, mas se quiserem conversar, podem ficar à vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181015,
					"content": "Claro! Paimon espera que Kururuk se recupere logo, de preferência sem bater em pessoas como antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181016,
					"content": "Quanto a isso... não se preocupem, vou pensar em algo. E nunca se sabe, vai que o temperamento dele melhore com os ferimentos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181011,
					"content": "#Não, {REALNAME[ID(2)|SHOWHOST(true)]} foi ainda mais fantástico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
		},
