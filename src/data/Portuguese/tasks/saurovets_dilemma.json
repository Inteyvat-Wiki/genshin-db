				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "\"Shwrawr!\"\\nComo se soubesse que não tem chances, o Qucussauro sai voando com um grito...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "Arg, ele é rápido! Saiu voando num piscar de olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "Vamos lá, Paimon, atrás dele!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "O quê? Correr atrás dele? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "...Hmm, se mais nada, realmente parece que ele se recuperou bem. A seguir, deveríamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "Falando nisso, por que aquele Qucussauro estava tão irritado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "...Hmm, Paimon sabe! Você deve ter roubado os lanchinhos dele! Vingança nascida de roubo de comida leva a problemas sérios, sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "Lanchinhos? Bem, sim, comi alguns, mas Kururuk não é do tipo de se importar com coisas pequenas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "\"Kururuk\"? Espera, então ele tem um nome... Parece que é um sujeito temperamental! Quase te bateu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "Bem, não culpo ele, o tratamento sendo do jeito que é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "Então levar uma surra também é uma forma de se curar? Se aprende algo todo dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#O quê? Qualé, como isso foi parar na sua cabeça? Deixa disso, não tá fazendo bem pra {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "Rrroo? Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "Haha, se essa fosse uma terapia que funcionasse, adoraria tentar! Infelizmente, Saurianos são diferentes de nós. Mesmo que você contasse algo para eles para ajudar a se recuperarem rapidamente, não há garantias que eles descobririam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "Ah, sim, deixem eu me apresentar. Sou Mazkal. Costumo cuidar dos Saurianos feridos ou doentes. Não quero me gabar, mas meus remédios são bem avaliados pelos clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "Hmm. Seu companheiro parece bem saudável. Parece que ele não precisa da minha ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "Rawr! Raaaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "Ah, então você é uma veterinária de Saurianos! Hmm, pelo jeito que Kururuk se comportou, parece ser difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "Oh, não é tão difícil assim. É só que o caso de Kururuk é um pouco especial... ele não confia nos humanos no local, e por isso resiste a todos os tratamentos e medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "*Suspiro* Ah, se eu fosse um Sauriano. Eu observei ele, e ele se dá bem com outros Saurianos. Talvez ele iria querer tomar o remédio se outro Sauriano recomendasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "Hmm. Nesse caso, talvez tenhamos que ajudar você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "Hã? Espera, você quer dizer que vocês são Saurianos, apesar dessa aparência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "Sua imaginação faz sentido nenhum. Urgh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#Enfim, podemos fazer isso porque {REALNAME[ID(2)|SHOWHOST(true)]} é um pequeno Sauriano super esperto! Ele pode nos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "Hã, ele é tão bom assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "#Se nada mais, ele pelo menos foi bom em me escolher como companheir{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "Sim, mas esse não é o assunto que estamos agora, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#Sim! Pode deixar isso com {REALNAME[ID(2)|SHOWHOST(true)]}, tranquilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180334,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#Então, agradeço você de antemão, {REALNAME[ID(2)|SHOWHOST(true)]}, em nome de Kururuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180336,
					"content": "Eu fiquei preocupada que essa perturbação dele pudesse fazer com que seus ferimentos antigos não curassem, além de fazer novos aparecerem... Sua ajuda me tranquiliza muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180337,
					"content": "Eu preparei duas fórmulas de poções para ele. Eu dei o meu melhor para balancear os efeitos terapêuticos e a palatabilidade, mas ainda não bolei uma solução perfeita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180338,
					"content": "Então, das duas poções, a com maior propriedades curativas não é tão gostosa assim, entretanto, a que os Saurianos preferem não é tão eficaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "Mazkal"
