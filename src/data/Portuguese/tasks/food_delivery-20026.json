			"dialogs": [
				{
					"id": 200260101,
					"content": "Pedir para viagem",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "Ei, Viajante, o que está acontecendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "Oh, você disse que está aqui só para comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Eu entendo, eu entendo... Mas eu prometo que vou lhe fazer o melhor prato que você já experimentou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Ernest, da Adega do Alvorecer, costuma pedir comida aqui para acompanhar o seus vinhos e seus pedidos sempre vêm com exigências especiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Desta vez, ele quer <color=#00E1FFFF>Bolinhas de Rabanete Fritas</color>, mas com ovo. Infelizmente, eu não tenho mais ovos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Então, se você puder me arranjar alguns Ovos de Aves, seria ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Pode ser, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Você deve conseguir encontrar um monte na Origem do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "Eu agradeço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Eu apenas vim aqui para comer. Eu estou morrendo de fome!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Você deve conseguir encontrar um monte na Origem do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "Quando você fizer o que eu pedir, eu vou preparar um prato especial do Caçador de Cervos para você! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
