			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "Você já terminou de oferecer incenso? Como você se sentiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310502,
					"content": "Nada mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Esplêndido. Espero que este templo esteja sempre cheio de incensos queimando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310504,
					"content": "Vou ficar aqui por um tempo. Este é um lugar calmo, perfeito para eu trabalhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310505,
					"content": "Preciso organizar os materiais que reuni e continuar compilando meu livro sobre o Guardião Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310506,
					"content": "Se você tiver tempo, pode passar por este templo e checar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310507,
					"content": "Se você quiser oferecer incenso, é só pegar alguns comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310508,
					"content": "*Suspira* Eu gostaria de poder arrumar as redondezas também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310509,
					"content": "O caminho precisa ser repavimentado, com cercas em ambos os lados, e devemos ter um canteiro próximo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
