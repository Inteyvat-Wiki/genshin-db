				"points": []
			},
			"dialogs": [
				{
					"id": 718310301,
					"content": "O templo está um pouco melhor agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310302,
					"content": "Realmente está, sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310303
					]
				},
				{
					"id": 718310303,
					"content": "Hã? Oh, você sempre aparece na hora certa, não é? Os reparos acabaram de ser concluídos, e eu acabei de terminar de pagar os artesãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310304,
					"content": "Ah, não imaginava que isso fosse custar tanta Mora. Eu mais ou menos torrei tudo que eu tinha neste lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310305
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310305,
					"content": "Mas de qualquer forma, este templo está completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310306
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310306,
					"content": "Você gostaria de oferecer algum incenso? Eu inclusive pedi a alguém para construir um incensário novinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310307,
						718310308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310307,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310310
					]
				},
				{
					"id": 718310310,
					"content": "Pegue estes palitos de incenso. O incensário está logo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310308,
					"content": "Você já ofereceu incenso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310309
					]
				},
				{
					"id": 718310309,
					"content": "Mas é claro. Eu fui o primeiro a fazer isso assim que a restauração foi completada, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310310
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
			"id": 7183105,
			"completionStepIds": [
				7183105
