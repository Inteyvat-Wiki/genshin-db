			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harrison"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "Obrigado, Viajante. Muito obrigado pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090205,
					"content": "Se não fosse por você, esse lugar hoje seria o meu túmulo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090206,
					"content": "Você que ergueu esse acampamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "Uh... Pode-se dizer que sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090210,
					"content": "Quero dizer, você sabe que é difícil fazer negócios aqui em Ritou. Esse acampamento daqui é... Pode-se dizer que é um truque meu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090211,
					"content": "Alguns dias atrás, eu pedi a um... Amigo para me enviar alguns ingredientes de Mondstadt para fazer álcool.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090212,
					"content": "Ele recebeu um lote de testes de um novo produto da Adega do Alvorecer que foi enviado para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090213,
					"content": "Mas ele não foi tão cuidadoso assim, e por isso, algumas caixas quebraram, e a tampa de uma garrafa com os ingredientes ficou solta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090214,
					"content": "Eu decidi desrosqueá-la para que pudesse reinstalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090215,
					"content": "Mas não imaginei que um monte de Slimes sairiam de dentro. Realmente inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090216,
					"content": "Ingredientes de fermentação da Adega do Alvorecer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "Mas não importa agora. Quanto aos ingredientes, resolverei as contas com esse amigo na próxima vez que ele voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090218,
					"content": "Você salvou minha vida, e eu lhe devo algo em troca. Por favor, fique com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090219,
					"content": "Além disso, está vendo aquele barco ali? Aquele é outro de meus truques...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090220,
					"content": "Usando aquele barco, você pode ir sorrateiramente para a Ilha Narukami. Conveniente, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090221,
					"content": "E por que eu precisaria \"entrar sorrateiramente\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "Ah, bem, isso é o que as pessoas costumam dizer com \"melhor prevenir do que remediar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090223,
					"content": "Bem, eu preciso retornar e pegar um estoque desses produtos, por isso não posso ficar aqui por muito tempo. Mais uma vez, obrigado, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090224,
					"content": "Parece que eu terei que mudar o meu local de receber mercadorias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harrison"
				},
				{
					"id": 728090208,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "Eu... Estou transportando mercadorias! Isso mesmo, haha, transportando mercadorias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "Harrison"
				}
			]
		}
	]
}