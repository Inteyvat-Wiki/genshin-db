					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "Então, já o eliminou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "#Derrotar os inimigos como os Caçadores das Ruínas parece fácil para você... De qualquer forma, você é {M#um aventureiro forte}{F#uma aventureira forte}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "... Ainda nada da espada? *Suspiro* Estou começando a ficar cansada de ficar perguntando isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "Não tem problema! Muito obrigada, você concluiu todas as minhas missões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "Lâmina Oculta, onde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Você encontrará eventualmente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "... Você está tentando me fazer sentir melhor? Obrigada, mas isto é apenas um contratempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Não importa quando e onde, eu vou conseguir encontrá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Seguirei ampliando a área da minha busca. Talvez eu volte a precisar da sua ajuda, mas fique calmo, vou pagar pelos seus serviços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Aqui está o seu pagamento. Eu tenho que ir, há uma nova lista de missões esperando por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "Lâmina Oculta, vou te encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Estas missões, parecem que não tem relação com a espada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "É porque eu concluí todas as missões relacionadas com a espada, mas infelizmente não deram resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Então eu pensei... Certamente, o que quer que tenha acontecido para separar meu irmão de sua espada, só pode ter sido em circunstâncias altamente perigosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "Por isso, comecei a aceitar mais missões, para os lugares mais perigosos, em buscar da Lâmina Oculta",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "No entanto, existem missões um pouco perigosas demais para eu administrar por conta própria. Por isso comecei a pedir ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
}