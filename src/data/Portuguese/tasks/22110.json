					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "É inútil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "... Você realmente não tem nada para fazer, não é? Ou você é bom demais no que faz, ou irremediavelmente inadequado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Duvido que seja o último. Você tem feito um bom trabalho com minhas missões até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "Ok. Como agora você tem muito tempo, aceita mais uma missão minha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "Mas nesta vez, o alvo para derrotar é um pouco perigoso, é um Caçador das Ruínas. Aceita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "#Você é {M#um aventureiro corajoso}{F#uma aventureira corajosa} como o meu irmão... Talvez você também possa alcançar uma grande conquista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "Isso é tudo. A localização fica nas Planícies de Guili. Prepare-se, então vá e elimine aquele Caçador das Ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Depois de derrubar ele, lembre-se de procurar itens relacionados à espada. Qualquer coisa que encontrar, traga de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "Do contrário, venha diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Este é o meu pedido para você... Só espero que desta vez você possa encontrar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Preciso buscar uma espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Sim por favor. Quando você derrotar o Caçador das Ruínas, procure uma espada ou qualquer item relacionado a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Devo avisar que os Caçadores das Ruínas são adversários difíceis. Você deve manter sua atenção neles o tempo todo, se quiser derrotá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "Quanto aos itens relacionados à Espada, é melhor encontrá-los, senão, também não faz mal. Contanto que derrote todos os Caçadores das Ruínas, eu te pago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
