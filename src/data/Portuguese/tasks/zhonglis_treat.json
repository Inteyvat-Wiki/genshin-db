			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "E com isso, o emissário que se chamava Ganyu, simplesmente desapareceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161002,
					"content": "Mas recebemos um convite dos Qixing de Liyue. Paimon ainda não consegue acreditar nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! Vamos conhecer pessoas que têm muito mais dinheiro do que Paimon poderia contar... Devemos ser bem educados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161004,
					"content": "Eu sempre tenho educação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "Hah... De fato, um convite para visitar a Câmara de Jade é uma honra rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161007,
					"content": "Você deveria ir agora. Mas não esqueça sobre o Ritual de Ascensão. Quando você tiver terminado na Câmara de Jade, encontre-me no Pântano Dihua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161008,
					"content": "Não se preocupe, não vamos esquecer! Pântano Dihua. Vemos você lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161005,
					"content": "Paimon está tramando algo novamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}