			"dialogs": [
				{
					"id": 10160301,
					"content": "Sobre Ningguang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160302,
					"content": "Gostaria de saber onde vamos encontrá-los em meio dessas marés escuras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
