			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "Ah, vocês estão aqui. Não é preciso de pedir, eu já o fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "Esse \"Alto no Terceiro Copo\" não é para pesos leves, como qualquer taverna em Mondstadt. Aqui o dono recusa pedido de bebida ridículos, por exemplo, suco de fruta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Então, quer dizer que posso pedir o vinho desta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "Por isso, desta vez, pedi uma tigela de arroz glutinoso fermentado em vinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "Eu acho que eu deveria ter pensado nisso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "... Se vocês desejarem ouvir mais, queridos clientes, continuarei a história da Câmara de Jade de Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160107,
					"content": "Uau, tem até um Contador de Contos aqui! Que atmosfera ótima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "Além do bom vinho, o excelente ambiente também é razão por que esse lugar é tão procurado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Mas quando digo ambiente, me refiro a um tipo diferente daquele que o Guia de Viagem de Teyvat usa para julgar os outros estabelecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Como todos sabem, bem acima da terra de Liyue, se encontra um pavilhão nas nuvens, um palácio na névoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160111,
					"content": "O que significa ter um \"olho que tudo vê\"? Isto, meus amigos: A obra-prima da senhora Ningguang que faz a ponte entre a terra e o céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160112,
					"content": "Imagine. O tempo está limpo e você olha do palácio para o mundo abaixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160113,
					"content": "As paisagens gloriosas do porto de Liyue, se estendendo por toda parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160201,
					"content": "Estes são apenas pedaços de papel, e ainda assim guiam a mão da Senhora Ningguang - tal é o seu valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160202,
					"content": "Apenas agarrar um ou dois deles certamente lhe dará um fragmento de sua sabedoria - o suficiente para ficar um ou dois passos à frente de seus colegas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Tian \"Língua de Ferro\""
				},
				{
					"id": 10160203,
					"content": "Tianquan Ningguang... Parece que estamos ouvindo este nome várias vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Os habitantes de Liyue falam sobre ela, os Fatui a odeiam, ela provavelmente escondeu a Exuvia, e nós a vimos no Ritual de Descensão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Não sei se ela realmente é esse tipo de pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Finalmente, encontramos você, que voltou do Relevo de Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Quem está aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon, temos que fugir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Espere! Não sou Millelith, e não estou aqui para te capturar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "#No entanto, sou uma emissária dos Qixing de Liyue. Meu nome é Ganyu, secretária do Pavilhão Yuehai, e vim especificamente para conhecê-l{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "Emissária?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "Mais precisamente, sou a secretária corporativa dos Qixing. No momento, estou servindo como emissária especial da Senhora Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Uau! Agora que estávamos falando de Ningguang e sua emissária aparece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Peço desculpa, você acabou de voltar do Relevo de Jueyun... mas sou do mundo mortal, então não posso estender a minha cortesia na íntegra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Mas eu tenho comigo uma carta da Senhora Ningguang. Ela lhe faz um convite formal em sua posição como Tianquan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Lhe convidou para ir para o palácio celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Um convite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "A senhora Ningguang disse:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "#\"Convide-{M#o}{F#a} para vir aqui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "#\"Quero conhecê-l{M#o}{F#a}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "#\"Na Câmara de Jade, cortaremos {M#juntos}{F#juntas} cada um desses fios escuros entrelaçados.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "Secretária?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
