			"dialogs": [
				{
					"id": 221010201,
					"content": "Como está indo? Já eliminou todos os monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010202,
					"content": "Ainda não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "OK. Bem, não se apresse. Esses monstros podem não vão parar de incomodar as pessoas indo e vindo, mas não ousariam pôr os pés na própria pousada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "Se alguns mais corajosos se aventurarem por aqui dentro, eu posso cuidar disso, e não vou deixar a segurança dos hóspedes em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "Hahaha, ninguém abre um albergue assim tão longe da cidade sem saber um pouco de defesa pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
