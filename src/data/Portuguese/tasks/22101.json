			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "*Suspiro* é só uma coisa atrás da outra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "Este local... realmente é um desafio abrir um Albergue aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010104,
					"content": "Talvez eu seja o único, mas sinto que há cada vez mais monstros ao nosso lado recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010105,
					"content": "Eles não ousariam chegar perto da própria pousada, mas os hóspedes precisam entrar e sair e o Millelith não pode estar aqui o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010106,
					"content": "Se você estiver com tempo, me ajude a eliminar os monstros ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "Haha... gosto da sua franqueza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010113,
					"content": "Sinto muito por lhe dar tantos trabalhos cansativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010114,
					"content": "Mas eu prometo que farei valer seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010115,
					"content": "Então, boa sorte para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010108,
					"content": "Este albergue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "Já sabíamos que não era possível evitar tais problemas quando escolhemos o lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010111,
					"content": "Mas então, onde estariam os viajantes que passavam as noites se não fosse por nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010112,
					"content": "Um pouco cansativo, mas tem que ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
