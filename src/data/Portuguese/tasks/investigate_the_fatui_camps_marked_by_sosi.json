	"talks": [
		{
			"id": 7333007,
			"completionStepIds": [
				7333007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7333007",
							"2"
						],
						"stepId": 7333007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Ei, seus humanos traiçoeiros! Eu sugiro que vocês saiam daqui agora. O legado e os segredos de nós, Pari, não são para vocês cobiçarem, e com certeza não estão ao seu alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "...Pari? Oh, você é uma Pari! Que experiência fantástica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#Oh! E também há {M#um}{F#uma} jovem com seu... animal de estimação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "#Ei! Segura sua língua! Paimon é a melhor amiga del{F#a}{M#e}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "Amiga... Oh, é claro! Melhor amiga! Como isso soa bonito! Sempre quis ter um melhor amigo, desde quando era criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#Jovem {F#senhorita}{M#rapaz}, você por acaso não precisa de dois melhores amigos, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "Onde você quer chegar com isso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Eu quero dizer que... Mesmo que você tenha dois melhores amigos, não acha que é um pouco injusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Desigualdades como essa são injustas... Por isso, entregue a Pari para mim. Quanto a como irei tratá-la... Não se preocupe. Garanto-lhe que a usarei ao máximo de seu potencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Que cara mal-educado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Uau, esse cara não está sendo nem um pouco razoável! Não temos jeito nenhum de nos comunicarmos com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "#Sempre podemos fazer ele entender sem palavras... Ó, {F#minha cara}{M#meu caro} Yasnapati, certamente entendes o que estou dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Oh, Paimon sabe! Você quer dar uma lição a ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Hunf! Silêncio, Flutuante Pálida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "Não me importaria em ter mais um amigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "Ei! Nada disso! Só Paimon pode ser sua melhor amiga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}