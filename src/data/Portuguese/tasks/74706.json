			"dialogs": [
				{
					"id": 747060101,
					"content": "...E esse aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 747060102,
					"content": "Ainda sinto que tá faltando alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina? Furina? O que vocês estão aprontando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "A Diretora Furina e eu estamos... \"montando o elenco\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 747060105,
					"content": "Que forma maravilhosa de dizer! Mas os \"atores\" que estamos procurando... por acaso são peixes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "...Peixes podem atuar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Atores animais não são exatamente uma raridade hoje em dia. Estamos procurando um peixe com a atitude certa para filmar algumas cenas extras... É essencial para criar a atmosfera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Mas parece que já vimos todos os peixes do aquário inteiro, e nenhum deles se encaixa perfeitamente no que precisamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#Que tal tentar pedir ajuda a {NICKNAME} e à Paimon? {M#Eles resolvem}{F#Elas resolvem} muitos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 747060110,
					"content": "Paimon fica feliz que você tenha tanta fé na gente... mas quando se trata de contratar peixes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Será que dá pra gente reunir mais uns \"candidatos\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Ótima ideia! Quem tem experiência em gerir aquários são vocês, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Então você tá dizendo que devemos ficar de olho em candidatos com potencial sempre que a gente nadar de agora em diante? Paimon não vê por que não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Então está decidido! Vou0 explicar pra vocês depois qual é a atitude que estamos procurando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "#Acho que isso faz de vocês \"olheir{M#os}{F#as}\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 747060117,
					"content": "Você pegou mesmo o vocabulário da indústria desde que começou a andar com Furina, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "A gente pode tentar fazer os testes do local de filmagem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
