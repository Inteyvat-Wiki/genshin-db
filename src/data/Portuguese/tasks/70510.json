			"dialogs": [
				{
					"id": 705100401,
					"content": "Minha nossa... as coisas realmente andam bem animadas na taverna recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100402,
					"content": "Alguns clientes vieram pelas bebidas, mas a maioria veio por você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100403,
					"content": "Hmm... por que isso é tão difícil de acreditar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100404,
					"content": "Nunca vi uma Semana de Treinamento de Bartender tão bem sucedida. Ganhamos dinheiro e reputação desta vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100405,
					"content": "#Enfim, muito bem, {M#meu amigo}{F#minha amiga}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100406,
					"content": "Hã, só se passou alguns dias e agora já somos amigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100407,
					"content": "De certa forma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "Tenho pensado em perguntar, você não gostaria de ficar e trabalhar aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100410,
					"content": "#Não é possível. Embora refis infinitos seja tentador, Paimon fez uma promessa de continuar viajando com {M#ele}{F#ela}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705100411,
					"content": "Tudo bem, então. Não vou ficar te pressionando. Na verdade, Charles comentou isso comigo também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100412,
					"content": "Enfim, sinta-se livre para visitar a Presentes dos Anjos sempre que quiser. E lembre-se de trazer seus amigos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100413,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "Adeus, e boa sorte em sua jornada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luka"
				},
				{
					"id": 705100408,
					"content": "Ele não está exatamente errado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
	]
