			"dialogs": [
				{
					"id": 250340101,
					"content": "Ele não gosta de vocês, então vazem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340102,
					"content": "Seu pirralho... Qual é a sua e a do Sauriano? Você conhece ele ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340103,
					"content": "Rawr... Rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250340104,
					"content": "Oh, olha, ele está ficando impaciente. Muito bem, então, para trás. Não batemos em crianças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340105,
					"content": "Tragam a bolsa, rapazes. Aposto que esse Sauriano vai vender por um bom preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340106,
					"content": "Não se aproxime mais! E não me culpe se você se machucar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340107,
					"content": "E-Espera, você está dizendo que vai nos bater? Hahahahaha! Ouviram isso, pessoal? Ele vai acabar com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340108,
					"content": "Ooh, garotinho, estou tão assustado, estou tremeenndo nas bases. Mas se você diz... não me culpe se você se machucar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340109,
					"content": "Rawr! Rawrrr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250340110,
					"content": "Tsc... Esse Sauriano é bem barulhento. Muito bem, rapazinho, apenas vá tirar uma sonequinha ali—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340111,
					"content": "São vocês quem precisam tirar uma soneca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#Irmãozão}{F#Irmãzona}! Eles estão tentando levar Jika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340114,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250340115,
					"content": "...Ei, você. Que tal sair dessa? Não vamos machucar você. Oras, até te daremos uma parte. Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340116,
					"content": "Não machuquem Jika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Hã. Então, acho que é isso. Bem, acho que você sabe as regras. Vamos cair pra dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340119,
					"content": "Vamos lá, pessoal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bandido Impaciente"
				},
				{
					"id": 250340117,
					"content": "Quem morreu e te fez rei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Espero que você não se importe se eu me juntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
