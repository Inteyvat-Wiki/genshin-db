			},
			"dialogs": [
				{
					"id": 250340501,
					"content": "#Obrigado por nos salvar, {M#irmãozão}{F#irmãzona}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340502,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250340503,
					"content": "Esse lugar é muito longe da tribo — se você não tivesse aparecido, de jeito nenhum eu teria conseguido alertar Illapa antes de Jika ser pego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340504,
					"content": "Mas o que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Praticando escalada, como sempre — mas ficamos com fome na metade do caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340506,
					"content": "Então nós dois saímos para colher algo... E antes de percebermos, andamos para muito longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340507,
					"content": "Até a gente estar cheio, já estávamos bem, bem longe. A mamãe certamente vai me dar um belo sermão quando voltarmos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340508,
					"content": "Obrigado novamente por nos salvar. Fique com esses Cacahuatls — acabei de colher eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340509,
					"content": "Voltaremos o mais rápido possível. Vamos, Jika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250340510,
					"content": "Rawr! Rawrrr! Rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jika"
				}
			]
		}
	]
