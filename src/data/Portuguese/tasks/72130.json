			"dialogs": [
				{
					"id": 721300101,
					"content": "A lanterna de pedra estranha parece estar emitindo uma energia perturbadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721300102,
					"content": "Essa lanterna de pedra é tão assustadora... Mas ela tem um ar familiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Oh, alguém escreveu algo nela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "\"Soldados montando guarda aqui, se tiverem perguntas sobre o amuleto, por favor vão até a Garganta Musoujin e falem com o Sr. Kaji\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721300105,
					"content": "A escrita parece nova, mas erodida pela chuva. Algumas linhas claras de escrita menor estão embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721300106,
					"content": "\"Por favor não acredite nas notas de um estranho. Não temos tempo a perder. É só a estratégia do inimigo para nos atrasar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721300107,
					"content": "\"Quem deixar seu batalhão sem permissão será punido severamente!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 721300108,
					"content": "O Sr. Kaji parece se importar com esta lanterna de pedra. Por que não vamos até a Garganta Musoujin e perguntamos a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
