			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Miau, miau, quando é que aquela pedra se tornou a cópia perfeita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "Como está a estátua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "O humano de pedra diz que terminará de bater na pedra em breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "Hibiki ficará tão feliz quando ela voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "Hmm, sim. Esta pedra é boa, mas devemos decorar um pouco ao redor do santuário, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "Por favor, me ajude a pendurar estas bolas de metal redondas e cintilantes ao redor do santuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "Estas coisas foram preparadas pela Hibiki. Se a memória não me falha, Domeki as deu a ela porque ela adorava brincar comigo e outras crianças. Foi preciso muito esforço para encontrá-las novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "Hã. Elas tem... Sinos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "\"Sinos\"? Eu não tenho certeza do que são, mas a Hibiki costumava usar estas bolas de metal quando brincava comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "Ela colocava as bolas de metal no chão, e depois as jogava para longe. Elas faziam este barulho tilintante sempre que se moviam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "Eu não entendo que poder possuíam, mas o som que faziam sempre me atrairia e os outros gatos para persegui-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "Eu entendi, portanto, a razão pela qual poucas pessoas vêm ao santuário atualmente é porque carece de bolas de metal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "Assim, eu solicito sua ajuda para pendurar estas bolas de metal em lugares altos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "Dessa forma, os humanos ouvirão o tilintar das bolas de metal e virão aqui para adorar, e não perderão seu caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "A Caixa de Oferendas estará cheia de Mora, e o santuário prosperará... E Hibiki ficará muito feliz quando ela voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "Então, por favor, me ajude a pendurar estas bolas de metal redondas e cintilantes ao redor do santuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Obrigada, miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
