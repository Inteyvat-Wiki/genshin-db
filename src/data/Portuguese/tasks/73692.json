				"points": []
			},
			"dialogs": [
				{
					"id": 736920101,
					"content": "Ah, olá, Viajante. Me parece que você veio até aqui para participar da Feira da Sabedoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920102,
					"content": "#Se você estiver interessad{M#o}{F#a}, gostaria de experimentar o jogo que nós do Amurta montamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920103,
					"content": "E que tipo de jogo seria esse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "Nosso Darshan montou um joguinho chamado \"Replicação Mimética\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920105,
					"content": "Nesse jogo, te introduzirei aos padrões comportamentais de alguns animais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920106,
					"content": "Claro que, esses padrões foram simplificados e generalizados para torná-los mais fáceis de compreender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920107,
					"content": "Tudo que você precisa fazer é usar os modelos que preparamos para imitar as ações dos animais correspondentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920108,
					"content": "Realmente parece bem simples.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Precisamente. \"Animais possuem padrões comportamentais comuns\" é uma afirmação que é tanto simples de entender quanto de aceitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920111,
					"content": "Mas por trás de algo tão simples, existem mistérios que são incrivelmente profundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920112,
					"content": "Porém, vamos deixar essa observação acadêmica de lado por um momento e apenas apreciar os comportamentos comuns dos animais de uma forma mais relaxada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920113,
					"content": "Vou tentar, por que não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "Muito bem. Nesse caso, por favor, venha até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920115,
					"content": "#Desculpe, estou um pouco ocupad{M#o}{F#a} no momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Tudo bem. Minha tenda ficará aberta durante toda a Feira, então você pode vir e experimentar o jogo a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920109,
					"content": "Não tem cara de ser difícil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
}