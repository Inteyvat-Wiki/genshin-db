			"dialogs": [
				{
					"id": 411220401,
					"content": "Uh? Oi, você quer falar comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "Sobre a situação atual...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Eu sei, nós saímos para ver os meteoritos. Assim que nós vermos, voltaremos para a cidade, não precisa se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "Também é possível ver eles de dentro da cidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Mas para isso precisamos ir para um lugar muito alto, eu já tentei várias vezes, todas elas os Cavaleiros me impediram e ainda me deram um sermão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "Por isso eu trouxe Jill para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "O senhor Cavaleiro ali do lado pode ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "Ajudar? Ele pode nos levar para um local alto da cidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "Impossível... Ele é muito estranho, muito irritado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "Eu estou trazendo uma ordem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Ordem? Deixe-me ver. Ai... É realmente uma ordem dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
					"content": "Com essa ordem, aquele Cavaleiro realmente pode nos levar para um lugar alto para ver os meteoritos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220413,
					"content": "Hehe, com certeza ver eles dentro da cidade é melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220414,
					"content": "Converse com aquele Cavaleiro um pouco, eu e Jill vamos conversar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220415,
					"content": "Eu ainda quero ver como são os meteoritos caindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will"
				}
			]
		},
