			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "Olá, com licença, tem alguma razão para você me procurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220202,
					"content": "Eu trouxe uma ordem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "Ordem? Deixe-me ver... Está ordenando que eu retorne para a cidade para ajudar ela voltar ao normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220204,
					"content": "Ai ai... Não é um problema retornar para a cidade, mas olhe para aquelas duas crianças, eles com certeza não vão querer voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220205,
					"content": "Não sei para onde eles foram, também não posso levar eles de volta à força, só me resta ficar aqui protegendo eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220206,
					"content": "Se eu retornar para a cidade, como ficarão essas duas crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220207,
					"content": "Eu já disse várias vezes, eles não escutam o que eu digo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220208,
					"content": "A não ser... Você pode ir falar com eles? Não tenho certeza se vão lhe ouvir, mas você pode tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220209,
					"content": "Se você conseguir persuadir eles para retornarem à cidade, então eu também posso retornar para ela com minha consciência limpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220210,
					"content": "Farei uma tentativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
		{
