			"dialogs": [
				{
					"id": 411220601,
					"content": "Olá, posso ajudar você com alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220602,
					"content": "Eu trouxe uma ordem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "Ordem? Deixe-me ver... Oh, eu devo retornar para a cidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220604,
					"content": "Me desculpe, não posso cumprir essa ordem agora, ainda estou fazendo coisas muito importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220605,
					"content": "Depois da queda dos meteoritos, os monstros daqui foram afetados, e se tornaram mais violentos e perigosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220606,
					"content": "Para proteger a segurança dessa região, eu devo derrotar esses monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220607,
					"content": "Mas não tem pessoas aqui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "Justamente porque não tem pessoas aqui é que posso me livrar desses monstros sem amarras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220609,
					"content": "Isso é muito importante, enquanto não lidar com isso, não posso sair daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220610,
					"content": "Vou te ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Ótimo! Monstros comumente se reúnem nessa região.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220613,
					"content": "Vamos agir separadamente, cada um vai acabar com os monstros de um lugar, depois de lidar com eles, vamos nos encontrar aqui novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				},
