						411220503
					]
				},
				{
					"id": 411220503,
					"content": "Ótimo! Muito obrigado, mas... Como assim você 'acha'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "Eles querem que você os ajude...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "Ajude? Ajude com o que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "Uh? Levar eles para um lugar alto de Mondstadt para ver meteoritos? Isso é muito perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "São duas crianças, eu tenho que reportar isso para os Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
					"content": "Mas eu estou com a ordem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "A ordem não é para ser usada assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220510,
					"content": "Deixe para lá, só preciso levar eles para a cidade e pensar em algum jeito de os levar para um canto alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220511,
					"content": "Você realmente vai levar eles...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Claro. Eu sou um Cavaleiro de Favonius e... Uh... Um adulto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "Não importa a quem eu prometa, desde que a promessa seja cumprida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "Eu lhe incomodei muito desta vez, pode deixar que dou conta do resto, vou levar eles de volta para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220515,
					"content": "Depois, vou descobrir como levá-los ao ponto mais alto de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
