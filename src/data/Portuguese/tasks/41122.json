			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "Ai, parece que não tem nenhum outro jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "É você. Você deve ter visto os meteoritos que caíram recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220104,
					"content": "Apesar da cidade ter sido muito sortuda, e nenhum meteorito cair nela, seus arredores estão um verdadeiro caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220105,
					"content": "Muitas pessoas entraram na cidade em busca de refúgio, ainda tem aquelas pessoas que caíram naquele sono indescritível, a cidade não voltará ao normal nem tão cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220106,
					"content": "Eu quero chamar os Cavaleiros de Favonius que estão em missões fora da cidade de volta, precisamos primeiro organizar os assuntos da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220107,
					"content": "Mas todos eles se dispersaram no campo, e os Cavaleiros de Favonius não tem ninguém sobrando para procurá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 411220108,
					"content": "Você pode me ajudar, pegue essa ordem e entregue-a para eles, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
