			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "Que estranho... O que tem de errado com este Aparelho Fotográfico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010102,
					"content": "Tem algo de errado com esse Aparelho Fotográfico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "Parece que ele quebrou... Ou algo assim. Resumindo, ele não está funcionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010104,
					"content": "Antes, quando eu estava em Fontaine, pedi um Aparelho Fotográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010105,
					"content": "O vendedor disse que esse Aparelho Fotográfico era a mais nova tecnologia de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010106,
					"content": "Disseram que ele pode imprimir uma foto com cores especiais e que possuem efeitos únicos. Comprei um para testar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010107,
					"content": "Não sei se sou eu que não estou usando corretamente, ou esse Aparelho Fotográfico que tem algum problema. De qualquer maneira, as fotos não estão saindo normalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010108,
					"content": "Será que eu realmente estou usando esse aparelho da maneira incorreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010109,
					"content": "Sim, você sabe como usar esse Aparelho Fotográfico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010110,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "Ótimo. Você poderia me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010114,
					"content": "#Pela sua aparência, vejo que você é {F#uma}{M#um} Viajante, correto? Com certeza você deve ter ido a muitos locais e visto muitas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010115,
					"content": "Gostaria que você pegasse esse Aparelho Fotográfico e fotografasse coisas com cores muito fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010116,
					"content": "Depois de fotografar, tragas as fotos para mim. Quero ver se esse Aparelho Fotográfico realmente tem algo de errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010117,
					"content": "Na verdade, não. Pegarei essas fotos e irei perguntar ao vendedor. Quando tiver elas como prova, ele admitirá que vendeu um produto com defeitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010118,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010120,
					"content": "O que você quer dizer com \"cores fortes\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "Uh... É algo como... Cores que são muito fortes e vivas. Um vermelho como o da Pimenta de Jueyun, ou azul da Flor da Neblina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010122,
					"content": "Depois de fotografar, traga as fotografias até mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jitong"
				},
				{
					"id": 414010112,
					"content": "Nunca ouvi falar na minha vida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "Não tem problema. Usá-lo é relativamente simples... Você poderia me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "Jitong"
				}
			]
		}
	]
}