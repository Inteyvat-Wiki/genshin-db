			"dialogs": [
				{
					"id": 750100101,
					"content": "\"Não tenho objetivos que preciso alcançar, nem tenho desejos urgentes. Sou um pastor feliz. Me importo apenas com minhas alpacas, com as estações e coisas que crescem, com brisa fresca e as chuvas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100102
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100102,
					"content": "Essa é minha música favorita. O que acha? Muito bom, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				}
			]
		},
