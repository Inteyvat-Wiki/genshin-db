			"dialogs": [
				{
					"id": 750101201,
					"content": "Vejo que você voltou, amiguinho. Como foi? Fez amizade com as Alpacas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "Rawr! Rawr rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Haha, olha só como você está feliz. Oras, você até está me fazendo sentir animada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Ei, Wactana, você não deveria estar um pouco mais preocupada sobre o que acontece com as Alpacas? Aquela que {REALNAME[ID(2)|SHOWHOST(true)]} fez amizade estava em uma situação bem difícil agora há pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "É mesmo? Então, acho que preciso falar com Mal Passado, dizer a ele para ter mais atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "Você está relaxada demais quanto a isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "Digo, estou vivendo um sonho! Qual é, fique feliz por mim e tal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "#Ah, sim. Se {REALNAME[ID(2)|SHOWHOST(true)]} gostou do brinquedo de Alpaca, ele pode ficar com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "Rawwr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#Paimon acha que {REALNAME[ID(2)|SHOWHOST(true)]} realmente não sabe o que é fazer cerimônia, hein. Então, obrigada, Wactana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101214,
					"content": "#Eh, não foi nada. E se quiser passar por aqui de novo, vocês são sempre bem-vind{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101208,
					"content": "As coisas são bem difíceis para Mal Passado, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101209
					]
				},
				{
					"id": 750101209,
					"content": "Sim... Mas ele sempre foi bem preocupado. Se eu levasse ele para o estudo de guarda de Alpacas, ele começaria a perder pelo com o estresse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101210
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101210,
					"content": "Então desse jeito é melhor. Satisfação de trabalho para ele, vida livre e fácil para mim. Todos ganham, você não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				}
			]
		},
