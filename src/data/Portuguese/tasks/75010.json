					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101613,
					"content": "#Além disso, Paimon tem certeza de que ela vai ficar feliz em saber que {REALNAME[ID(2)|SHOWHOST(true)]} também fez um amigo!",
