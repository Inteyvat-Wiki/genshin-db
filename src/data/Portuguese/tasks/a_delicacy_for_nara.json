	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "#Ah! Se não é {M#o}{F#a} Nara Dourad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130102,
					"content": "#Arapacati, não tem medo. Nara {NICKNAME} é {M#um bom}{F#uma boa} Nara, assim como {M#o}{F#a} Nara das histórias. Nara {NICKNAME} e Paimon nos ajudaram muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130103,
					"content": "#Sim, eu não tenho medo. Arapacati confia em Arama e na grama, nas folhas e nas sementes. Todos dizem que você é {M#um bom}{F#uma boa} Nara. Olá, Nara {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130104,
					"content": "Olá, Arapacati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130105,
					"content": "Na verdade, eu sou ruim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "Ei! Não faça esse tipo de brincadeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130107,
					"content": "Não é. Arapacati sabe disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130108,
					"content": "#Muito vento traz muitas sementes pequenas. Eles vêm para Vanarana com Nara. Dizem que Nara {NICKNAME} é legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130109,
					"content": "Arama disse algo assim também! Falando nisso, sementes de um lugar com muito vento? Você quer dizer tipo sementes de dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130110,
					"content": "Ou talvez de margaridas voadoras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Nara {NICKNAME} ajudará Arana a obter uma Bija. Então vamos nos preparar juntos para o Festival Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130116,
					"content": "Oh, o Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130117,
					"content": "Arapacati parece estranha. Alguma coisa está incomodando você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130118,
					"content": "Os irmãos mais velhos de Arapacati nunca mais voltaram a Vanarana. Nós, os irmãos, não poderemos celebrar o Festival Utsava juntos se eles não voltarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130119,
					"content": "Também não vejo Arachatora, Arasaka, Arapas e Araphala em Vanarana há muito tempo. Eles desapareceram após aquele incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130120,
					"content": "Há muito tempo... Quanto tempo mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130121,
					"content": "Isso foi há muitas e muitas luas. O broto tinha acabado de nascer. Agora ele já cresceu a ponto de se tornar uma enorme árvore que protege Aranara da chuva. Tem sete Arapacatis de altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130122,
					"content": "De mudas a árvores! Uau! Isso é muito tempo! Seus irmãos estão desaparecidos, Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130123,
					"content": "Desaparecidos? Isso é um tipo de semente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130124,
					"content": "Uau! As sementes de Nara se chamam Desaparecidos? Incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130125,
					"content": "#Nara são incríveis! Nara {NICKNAME} deve ter muitos Desaparecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130126,
					"content": "Não é isso que queremos dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130127,
					"content": "Isso significa que você não sabe onde eles estão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "Oh, não é bem assim. Arapacati sabe onde Arachatora, Arasaka, Arapas, e Araphala estão. Irmãos não estão desaparecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130129,
					"content": "Eles estão treinando em Vanarana há muito tempo. Treinamento Culinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130136,
					"content": "Oh, Treinamento Culinário. Paimon entendeu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130137,
					"content": "Parece algo que a Paimon estaria interessada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Hehe! Paimon está mais interessada no treinamento culinário {M#do}{F#da} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130139,
					"content": "Então, o que é exatamente esse \"treinamento culinário\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130140,
					"content": "Aconteceu no último Festival Utsava. Nara fez muitos e muitos pratos para Aranara experimentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130141,
					"content": "Então, para fazer comida para Nara em troca nesse Festival Utsava, Arachatora e os outros estão conduzindo treinamentos culinários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130142,
					"content": "Paimon mal pode esperar por esse Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130143,
					"content": "Mas é um prato dos Aranaras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Comida de qualidade é o idioma comum de todos os seres vivos! Não há problema algum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130146,
					"content": "Mas Arapacati, já que você sabe onde eles estão, por que não vai atrás deles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130147,
					"content": "É que o Festival Utsava está perto, Arapacati tem que fazer muitas coisas, preparar outras. Sem tempo para ir procurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130148,
					"content": "Eles deixaram Vanarana para treinar culinária para o Festival Utsava, mas não sabem que o festival já está chegando! Arachatora, Arasaka, Arapas, e Araphala burros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130149,
					"content": "#Então deixe conosco! Nós vamos com Arama explorar a floresta para encontrar Aranaras e nos preparar para o Festival Utsava. Certo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130150,
					"content": "Deixa com a gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Mas como vamos fazer para encontrar Arachatora, Ara... Quais eram os nomes mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130153,
					"content": "Arachatora, Arasaka, Arapas, e Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130154,
					"content": "Ai! Arana, Arama, Araja, Arapacati... Os nomes Aranara são tão difíceis de lembrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130155,
					"content": "Paimon, não diga isso dos nomes Aranara. Os Aranaras ficarão tristes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130156,
					"content": "Está bem, está bem. Então, como podemos encontrá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130157,
					"content": "Eles costumavam fazer Treinamento Culinário em Vanarana. Mas eles fizeram muita fumaça, então Arapacati os expulsou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130158,
					"content": "Todo mundo estava tão assustado, alguns Aranaras até hibernaram. Por sorte, Arama foi corajoso e puniu a fumaça. Arapacati ficou furiosa e os fez sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130159,
					"content": "Devemos conseguir encontrá-los procurando por <color=#00E1FFFF>pilares de fumaça subindo ao céu</color>, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130160,
					"content": "Então foi você que os expulsou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130161,
					"content": "Sim. Fiz algo errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130162,
					"content": "#Na verdade não... Enfim, {NICKNAME}, vamos partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130163,
					"content": "Ah, sim. Tem outra coisa. Se os irmãos ficarem estranhos, use a <color=#00E1FFFF>força do Dendro</color> para dar um jeito neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130164,
					"content": "No passado, eles criavam fumaça demais. Encheram toda Vanarana de fumaça. Eles também estavam com medo e corriam por toda parte. Às vezes, eles ficavam assim se tocassem em cogumelos estranhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130165,
					"content": "Mas Aranaras são espíritos da floresta. Assim, podemos nos recuperar e acordar absorvendo o <color=#00E1FFFF>poder do Dendro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130166,
					"content": "#Paimon entende. {NICKNAME} se restaura comendo Frango Assado com Mel. Assim, é um espírito do Frango Assado com Mel então! Uhum! Faz muito sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130170,
					"content": "... Enfim, vamos partir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130172,
					"content": "#Nara {NICKNAME} e Paimon, boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130171,
					"content": "Pois é, vamos nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Mal posso esperar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "Eu entendo como você se sente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Nara {NICKNAME} entende como me sinto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130132,
					"content": "#Sim! {M#O}{F#A} {NICKNAME} também perdeu {M#uma irmã}{F#um irmão}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130133,
					"content": "#Oh, Nara {NICKNAME}, {M#sua irmã}{F#seu irmão} também está treinando culinária?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130134,
					"content": "Hã? Paimon acha que houve um mal-entendido... Desaparecido significa que você não sabe onde algo foi parar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130135,
					"content": "Ah, não é isso. Arapacati sabe que irmãos mais velhos não estão desaparecidos. Eles foram treinar fora de Vanarana por muito, muito tempo. Treinamento Culinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130111,
					"content": "Ou talvez de pinha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Como se os ventos estivessem trazendo sementes daquelas histórias...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130114,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301302",
							"2"
						],
						"stepId": 7301302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "...Tão difícil falar com Nara, são tão altos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Oh! É você, Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati não está com medo. Irmãos são corajosos, então eles definitivamente não estão assustados também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "Você deve encontrá-los se seguir um <color=#00E1FFFF>pilar de fumaça</color>. Se eles estiverem estranhos, use o <color=#00E1FFFF>poder Dendro</color> para dar um jeito neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati está muito brava! Argh! Mais do que brava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "A floresta é muito perigosa. \"Marana\" toca o terror por lá. Quando estávamos saindo, Arapacati fez questão de alertar os irmãos para trabalharem juntos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "Mas foi só saírem e já começaram a brigar. E você, Arachatora, ainda deu para comer aquela coisa estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "*Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati decidiu. Arachatora decidiu. Arachatora não pode mais colher cogumelos até que os Frutos do Pôr do Sol tenham amadurecido dez vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Como isso foi acontecer... Snif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Exatamente! O que faríamos se ele trouxesse esporos ruins e cogumelos monstruosos para cá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Araphala, você também! Você foi tão longe de Vanarana para coletar frutas. Existem muitas coisas ruins por lá! Araja especialmente nos contou sobre isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "*Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "Exatamente. Frutas precisam de água e Aranara também tem que beber água. Portanto água é o mais importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Arapas, de todos os lugares, você tinha mesmo que ir para a Máquina Varuna? Você não sabe que até mesmo Nara Varuna disse que a água de Vanarana é a mais gostosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "*Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "E—Entende? Apenas o \"Gosto da Felicidade\" pode trazer a felicidade para nossa irmãzinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Arasaka, ouvi dizer que você causou muitos problemas para Nara {NICKNAME} por causa do seu Gosto da Felicidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "Tudo que fiz foi pela \"Iguaria Suprema\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "O propósito de fazer a \"Iguaria Suprema\" é para mostrar os frutos do treinamento culinário. Oh, mas qual a finalidade do treinamento se você pode apenas completá-lo com a ajuda de alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati acha que Arasaka precisa muito fazer uma autorreflexão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "*Choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! Chegamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Oh, é você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME} e Paimon dividiram o problema de Arapacati, e resolveram ele na raiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Arapacati não vai mais ter que se preocupar dos irmãos perderem o Festival Utsava ou estarem em perigo. Graças a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati e irmãos estão muito gratos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "Isso é ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "Mas tem uma coisa que Paimon sempre quis saber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "Afinal, quem é \"Nara Varuna\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{M#Ela é nossa amiga, amiga de Vanarana.}{F#Ele é nosso amigo, amigo de Vanarana.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#{M#Uma amiga}{F#Um amigo} dos Aranaras de muito, muito tempo. {M#Uma}{F#Um} Nara dourad{M#a}{F#o} como {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "Paimon entendeu. Mas Paimon ainda tem outra pergunta para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "É sobre os irmãos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Sim. Arapacati, quais dos seus irmãos é o mais velho e o mais novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "Hmm? Mais velho e mais novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "Das suas idades...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "Idade... Ah, Arapacati entendeu. Assim como os anéis das árvores. Hmm, os filhos da floresta não são distinguidos por sua idade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Hã? Então por qual motivo eles são seus irmãos e por que você é a irmã mais nova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Oh, isso. Tivemos {M#uma amiga}{F#um amigo} Nara. Nara Varuna. {M#Ela}{F#Ele} disse que {M#ela tinha \"um irmão\"}{F#ele tinha \"uma irmã\"}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "#Quando Arapacati e os irmãos ouviram {M#ela}{F#ele} falar sobre \"{M#seu irmão}{F#sua irmã}\", {M#ela}{F#ele} parecia muito feliz e triste ao mesmo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "Foi assim que entendemos. Para um \"irmão mais velho\", uma \"irmã mais nova\" é um Nara importante. Para uma \"irmã mais nova\", um \"irmão mais velho\" é um Nara importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "Nós achamos ótimo, então Arapacati e seus irmãos começaram a se chamar de irmãos e irmãs. Nara Varuna disse que isso era uma coisa boa, que é preciso dar valor à nossa família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "Isso mesmo, devemos dar valor a nossa família.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "Tem mais uma coisa que Paimon está pensando... Os Aranaras precisam comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "Os humanos cozinham os ingredientes em comida, e os filhos da floresta também podem transformar ingredientes em comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Nara Varuna nos ensinou como os Nara comem. É por isso que Arapacati e seus irmãos começaram a treinar culinária...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Uau, isso é realmente estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "É como se estivessem jogando um jogo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati e seus irmãos levam isso muito a sério. Pois, Nara Varuna disse que dividir comida é algo muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Sim, Arapas disse que Nara {NICKNAME} também sabe cozinhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Sim! {M#O}{F#A} {NICKNAME} tem muita experiência culinária!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#Arapacati entendeu... Nesse caso, Nara {NICKNAME} precisa vir ao Festival Utsava. Para ajudar os irmãos de Arapacati sem talento culinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
					"content": "Para que eles vejam, mais uma vez, que só Nara entende o que Aranara nunca entenderá, a verdadeira culinária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130355,
					"content": "Tente não se surpreender até lá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Arapacati vai esperar ansiosamente. Este Festival Utsava com certeza vai ser incrível e maravilhoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130356,
					"content": "Vou te mostrar tudo que tenho!",
