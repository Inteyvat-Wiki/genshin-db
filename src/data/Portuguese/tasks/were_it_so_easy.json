				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Ah, é {M#o}{F#a} {NICKNAME} e Paimon, {M#os}{F#as} entregador{M#o}{F#a}s de flores exóticas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Olá, Cosanzeana. As flores que trouxemos estão crescendo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Bem, eu... passei um dia inteiro sem olhar elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Ué? Você não gostou das flores? Por que não foi lá dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Foi tão difícil para mim conseguir elas, então eu quero muito cuidar delas, mesmo... Mas quando eu penso que elas podem murchar bem diante dos meus olhos, eu... eu fico com medo de ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "#Oh, uau, você realmente está bem preocupada... Por que não vamos dar uma olhada junt{M#o}{F#a}s? Se algo ruim acontecer, iremos te ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Não há motivo para se preocupar tanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "#Vocês têm razão... Vamos junt{M#o}{F#a}s! Com a ajuda de vocês, sinto que não há nada a temer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
