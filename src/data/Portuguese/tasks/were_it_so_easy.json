			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#Incrível, {NICKNAME}! Com uma porrada, você transformou aquela máquina horrorosa em lindos componentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Ele não vai mai incomodar o seu jardim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Algumas das flores foram danificadas, mas o resto ainda parece estar tudo bem. Os Primofissuradores não voltarão para incomodar seu jardim de novo, então agora suas flores vão poder crescer fortes e saudáveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Isso é ótimo... Mesmo assim, aprendi a minha lição. De agora em diante, preciso cuidar melhor das minhas preciosas flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}, Paimon... Vocês me trouxeram flores tão exóticas, e até me ajudaram a defender meu jardim. Como poderei agradecer por isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Não foi nada, sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "Ah, já sei! Eu peguei essas flores por conta própria — elas são muito preciosas para mim! Posso dar elas a você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Oh! Hmm, se essas flores são realmente tão preciosas, então talvez você deveria fazer seu próprio jardim de flores para plantá-la, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Falando nisso... isso não são Maralgas? Elas realmente contam como flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Maralgas são plantas, e elas são lindas, então é claro que são flores! Isso é o que os humanos chamam de \"biologia\" — passei algum tempo estudando isso para que eu pudesse me tornar uma grande floricultora no futuro, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Paimon sente que tem algo meio errado nisso tudo, mas não é como se a Paimon fosse especialista em plantas, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Continuarei me esforçando em direção ao meu objetivo. Ouvi os humanos dizerem que floricultores incríveis são capazes de criar novos tipos de flores, das quais eles podem levar para \"feiras de floricultura\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "Eu também criar novos tipos de flores, e ganhar \"prêmios\" nessas feiras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Bem, isso tudo é incrível e coisa e tal, mas Paimon sente que ainda existem alguns mal-entendidos que são difíceis de explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "O propósito de participar de uma feira de floricultura é para levar novas variedades de plantas que ela fez e deixar os humanos apreciá-las, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "A questão é, o sentido de estética dela pode ser meio diferente dos humanos... Você não acha que os humanos vão achar as flores que ela cria estranhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Você está realmente bem investida na carreira de floricultura, hein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Mas é claro! Paimon é a professora dela, sabe? Se ela ganhar, Paimon também vai sair bem na fita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "O prêmio não é tão importante. O importante é ser feliz com suas flores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "Isso é verdade. A única pessoa que precisa achar suas flores bonitas é você mesma! Você não deveria se preocupar tanto com o que as outras pessoas acham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Você só precisa cuidar do seu jardim, ver suas lindas flores todos os dias e ficar feliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Sim! Vou garantir que elas cresçam saudáveis e fortes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Você deu o seu primeiro passo em direção ao sucesso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "É verdade. As variedades que ela inventar provavelmente vão ser bem únicas, mas algumas pessoas vão gostar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "Quando você tiver criado suas variedades únicas, não se esqueça de contar primeiro para a gente, tá bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "Claro! Afinal de contas, vocês me ajudaram muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
