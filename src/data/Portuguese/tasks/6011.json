					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60111101,
					"content": "#Ah, que maravilha te encontrar aqui, {NICKNAME}. Quanto a mim, achei que um período de reparo e manutenção fosse apropriado, agora que a grande batalha acabou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111102,
					"content": "Obrigado por manter meus segredos, apesar de saber tanto quanto sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111103,
						60111104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111103,
					"content": "Eu não tive tempo para perguntar isso antes, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				},
				{
					"id": 60111105,
					"content": "Porque eu não queria problemas com Starshyna, claro. Se eles não detectassem, suspeito que os superiores teriam me dado uma lanterna de Ratnik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111106,
					"content": "Um Ratnik carregando duas lanternas, imagine isso! Uma visão realmente estranha e carente esteticamente, ainda mais. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60111104,
					"content": "Por que os Portadores da Lâmpada conseguiram detectar sua lâmpada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60111105
					]
				}
			]
		}
	]
}