				]
			},
			"dialogs": [
				{
					"id": 60110901,
					"content": "Hã? O que te traz aqui? Não esperava ver vocês por aqui de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110902
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110902,
					"content": "E para onde você foi, hein? Não fugiu nem nada assim, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110903,
					"content": "Ah, claro que não! Eu só tava em outro lugar discutindo negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110904
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110904,
					"content": "De fato, foi tudo graças a vocês que minha loja foi salva. *Choro* Sou tão grata. Tão grata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110905
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110905,
					"content": "Tá bom, pode ir parando com o fingimento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110906
					]
				},
				{
					"id": 60110906,
					"content": "O quê? Ora, eu não tava fingindo nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110907
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110907,
					"content": "E eu não te disse que meus preços eram razoáveis? Ah, mas vocês ainda foram para a Curadoria dos Segredos, ou sei lá qual é o nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110908
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110908,
					"content": "*Suspiro* Se até clientes fiéis como vocês abandonarem o navio, o que uma mulher de negócios pode fazer além de levar seus produtos para outro lugar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110909
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110909,
					"content": "Você se preocupa demais com a Curadoria dos Segredos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110910
					]
				},
				{
					"id": 60110910,
					"content": "E como eu não me preocuparia, hein? Tocar pequenos negócios internacionais não é nada fácil — sem falar com uma competição tão formidável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110911
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110911,
					"content": "Ah, esqueça. Sorte e destino são um só, não faz sentido reclamar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110912
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110912,
					"content": "Não é como se Nefer não tivesse me feito favores por causa da nossa terra natal quando eu cheguei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110913
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110913,
					"content": "Se for pra culpar algo, é a falta de oportunidade de fazê-la me dever uma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110914
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110914,
					"content": "Agora! Caso ela precise de alguma coisa, garanta — não, garanta duas vezes — me informe primeiro, beleza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
