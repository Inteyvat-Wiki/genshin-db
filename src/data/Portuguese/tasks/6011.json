			"dialogs": [
				{
					"id": 60110501,
					"content": "Chefe, eu... você se lembra daquela coisa que eu queria a sua opinião?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110502
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "Numa escala de 1 a 10, quanto esforço a Curadoria dos Segredos deveria dedicar se trabalhássemos com outros de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110503,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110504
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110504,
					"content": "Isso é um 1? Não tá meio baixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110505
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110505,
					"content": "Adivinha de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110506
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110506,
					"content": "Espera, você quer dizer zero? Mas a gente só não ia tacar nossa marca no negócio e fechar para balanço? Por que se unir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110507
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110507,
					"content": "*Suspira* ...Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "O que quero dizer é que não há limite superior nem inferior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Hmm! Isso é bem sua cara, Chefe, sempre pensando na frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110510,
					"content": "Espera um minuto, isso nem sequer é uma resposta, né? Qual é, só me dê um número, chefe, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
