						],
						"pointId": 13094
					}
				]
			},
			"dialogs": [
				{
					"id": 60110701,
					"content": "...Interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110702
					],
					"speakerTitle": "Vingador da Lua"
				},
				{
					"id": 60110702,
					"content": "Você já me seguiu até esse ponto. Que tal mostrar seu rosto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110703
					],
					"speakerTitle": "Vingador da Lua"
				},
				{
					"id": 60110703,
					"content": "Haha, sim. Esqueci de me apresentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110704
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60110704,
					"content": "Me chamo Varka, Cavaleiro de Boreas, e Grande-Mestre dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
