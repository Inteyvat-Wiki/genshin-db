			"dialogs": [
				{
					"id": 60110401,
					"content": "Criação de rolinho de ovo completo. Por favor, aproveite enquanto está quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110402,
					"content": "Obrigado por ter isso em mente, senhorita Ineffa. Que isso seja o testemunho de nossa amizade, e que ela perdure apesar dos anos passarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Entendido. Entretanto, os rolinhos de ovo não duram tanto tempo assim. No máximo uma semana até o gosto ficar ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110404,
					"content": "Hã, não foi isso que eu quis dizer com... Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110405,
					"content": "Hmm. Parece que temos convidados escondidos ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110406,
					"content": "Ah, eles devem ter seguido o aroma do rolinho de ovo. Está tudo bem, podem se aproximar. Ineffa é uma amiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110407,
					"content": "Afirmativo. Na verdade, posso fazer uma omelete de cereais segundo preferências pessoais, antes de esmagar tudo em porções que podem ser divididas entre todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110409,
					"content": "O que eles estão conversando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110410,
					"content": "Estão... falando do seu endereço. Querem ir pra casa com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
