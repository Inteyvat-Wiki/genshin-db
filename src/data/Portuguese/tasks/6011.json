					},
					{
						"sceneId": 3,
						"position": [
							1547.072,
							258.854,
							9322.94
						],
						"pointId": 13087
					},
					{
						"sceneId": 3,
						"position": [
							1547.907,
							258.402,
							9321.152
						],
						"pointId": 13088
					}
				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "Esse homem era como um farol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Aqui ele viveu e trouxe luz àqueles ao seu redor, os mostrando benevolência. Mas quando as pessoas se acostumaram com sua iluminação, passaram a ignorar a presença da lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Lentamente, gradualmente, ele também passou a pensar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "\"Minhas ações não são nada de mais. Eu não fiz um trabalho bom suficiente. Tenho que ser paciente. Tenho que continuar esperando...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Talvez esse fim seja trágico, mas permaneço orgulhoso do jeito pelo qual ele iluminou o caminho para outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Cada sombra nascida da luz lembrará dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "Coitado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "Eu já ouvi o conto de uma Fada da Lanterna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Ah, eu também ouvi esse conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "E eu gostaria de dizer o mesmo a ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "Bem, você tem razão. Pode parecer que nossos esforços foram em vão, que Rerir realmente alcançou seus objetivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Mas vamos perseguí-lo até o fim, mesmo se o resultado não seja o qual desejamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Não é diferente do papel de um coveiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Não queremos trazer os mortos de volta à vida, apenas conceder paz a eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "É bom ouvir isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "O que vocês tão falando?! Poderiam explicar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Agora não, Paimon. Vou contar quando voltarmos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "De qualquer forma, o Feérico da Lanterna não será o protagonista nesses rituais finais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "\"Portador da luz, você abriu o caminho para a glória e justiça com seu sangue.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "\"Apesar de termos nos apressado, apesar de termos causado muitos ferimentos, ficamos um tempo e olhamos para trás, vendo o amor e o ódio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "\"Até que o mundo feche seus olhos nas profundezas da noite, até que a lanterna acenda lentamente para você, e que ninguém mais a veja.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Obrigado por tudo, Sargento-Mor Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Não precisa se apegar tanto ao resultado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
