						],
						"pointId": 13576
					}
				]
			},
			"dialogs": [
				{
					"id": 60110801,
					"content": "Flins? Não te vejo vir por esses lados frequentemente. Fique à vontade para dar uma olhada. Estou ocupada no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110802,
					"content": "Bem, eu vim te visitar, Srta. Aino. Aqui — trouxe uns lanches da vila no sabor tradicional de manteiga. Então, onde eu deixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110803,
					"content": "Shh! Ineffa pode te ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110804,
					"content": "...Então, qual é a ocasião? Você vai dizer que os Portadores da Lâmpada vão resolver todos os incidentes da Caçada Feroz após aquele incidente com o canhão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "E criticar um gênio como você por causa de resultados que nenhum de nós poderia antecipar? É claro que não seríamos tão estúpidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Se realmente fizéssemos isso, ouso dizer que jamais veríamos avanços tecnológicos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Hunf. Fala manso, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "Me alegra tranquilizar seu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Enfim, qual é o problema exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Bem. Você poderia me ajudar a consertar essa lâmpada? Eu a trouxe mesmo até a Cidade de Nasha para consertar, mas quebrou de novo durante nossa batalha anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Você quer que um gênio como eu conserte sua lâmpada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Oh, perdão. Talvez seja melhor pedir à Srta. Ineffa, talvez os lanches também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "O-O-O... Eu... Digo, eu consigo, sem problema nenhum. Só espere bem aí. Vou terminar antes que você consiga dizer \"Consertou\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110814,
					"content": "Muito obrigado, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110815,
					"content": "Na próxima vez que isso acontecer com você, venha até mim primeiro, tá ouvindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
