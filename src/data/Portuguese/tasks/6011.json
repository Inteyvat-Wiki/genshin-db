			},
			"dialogs": [
				{
					"id": 60110601,
					"content": "Columbina! O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "Hã? Não foram vocês que me recomendaram dar umas caminhadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110603,
					"content": "É, mas você não tem medo dos Fatui te verem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone não parece ter interesse em me capturar e os outros são improváveis de arriscarem entrar em contato comigo. Eles têm problemas maiores para lidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110605,
					"content": "(Rerir, se eu tivesse que adivinhar... Ele é uma ameaça a todos que vivem em Nod-Krai.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Bem, é bom sair para dar um passeio de todo jeito. Então, como você se sente? A Cidade de Nasha te agrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Hmm... O fluxo do kuuvahki é meio turbulento, e as pessoas estão muito agitadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110608,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110609,
					"content": "Mas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "Vocês compraram os pratos que me \"deram\" aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110611,
					"content": "(Tá falando sério? É com isso que ela tá preocupada? Carne Frita com Frutas?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "Hmm, bem, podemos te levar para lanchar se quiser. Tem todo tipo de coisa deliciosa que por aqui que você não pode experimentar em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "#...Você está bem quiet{M#o}{F#a}. Algo te incomoda, talvez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110614,
					"content": "#Tô preocupad{M#o}{F#a} com Rerir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Eu não pude perceber os esquemas dele, receio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110616,
					"content": "Agora que ele assumiu uma forma física, subestimar seu poder seria um erro fatal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110617,
					"content": "Mas aquele poder dele é uma obsessão que beira a mania.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110618,
					"content": "Não posso dizer se essa fixação é direcionada às luas ou outra coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110619,
					"content": "Talvez compreender o objeto de sua fixação se prove essencial para lutar contra ele no futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110620,
					"content": "Vamos falar dos Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Bem, o cotidiano de Sandrone é altamente irregular, enquanto Dottore frequentemente dá ordens aos outros. Quanto a Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110622,
					"content": "Hã? Não era sobre isso sua curiosidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110623,
					"content": "Bem, você já foi ao Escritório de Design de Experimentos deles? Aquela \"arma\" desempenhará um papel-chave no plano da Tsaritsa. Foi isso que ouvi, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110624,
					"content": "E que plano é esse, precisamente? Bem, não posso dizer que me importo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110625,
					"content": "Tenho pensando na nossa nave espacial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Eu poderia pesquisar na medula da Lua Eterna, caso você deseje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110627,
					"content": "Mas após nossa tentativa anterior, suspeito que sua nave espacial foi escondida intencionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110628,
					"content": "Talvez alguém tenha certas verdades que gostaria de esconder de você, ou de outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110629,
					"content": "E eu duvido que existam muitos que poderiam realizar tal feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110630
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110630,
					"content": "Não tenho mais perguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110631
					]
				},
				{
					"id": 60110631,
					"content": "Eu... ainda desejo retornar à lua que me pertence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110632
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60110632,
					"content": "É lá onde as respostas estão enterradas. Lá... é meu verdadeiro \"lar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
