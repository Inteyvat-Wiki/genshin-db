				],
				"points": []
			},
			"dialogs": [
				{
					"id": 60111001,
					"content": "\"Conserte minha lanterna\", ele diz. Por favor! Isso não vai levar nem dez minutos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111002
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111002,
					"content": "Se pelo menos todos soubessem o que raios estão fazendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111003
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111003,
					"content": "Aquele Hintsa, por exemplo. Como é que ele acabou criando um controle integrado para o canhão *e* a barreira de componentes aleatórios que as pessoas te pedem para consertar?! Ugh, me dá dor de cabeça só de pensar nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60111004
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60111004,
					"content": "Eu dei a ele um sermão daqueles e disse para ele me enviar relatórios regulares — se ele esteve trabalhando nisso ultimamente, quero saber mais disso! *Suspiro* É-É, digo, sei que é parcialmente minha culpa também, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
			]
		},
		{
			"id": 601111,
