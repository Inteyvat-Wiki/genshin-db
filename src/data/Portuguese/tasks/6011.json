			"dialogs": [
				{
					"id": 60110101,
					"content": "Todos se reúnem e compartilham o que descobriram...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "Conseguímos minimizar o mal causado. Só alguns habitantes foram feridos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Mas o Vingador da Lua agora adquiriu uma forma completa, enquanto não sabemos de nada sobre seus objetivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "Parece que fizemos algo similar a liberar um Qucussauro furioso na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "...Desculpa. Ninguém aqui conhece um Qucussauro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "P-Paimon entende o que você quer dizer, mas essa analogia parece meio fraca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Ele disse que esse mundo não significa nada para ele, então é possível que ele não tenha um motivo para lutar contra nós agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110108,
					"content": "Se o objetivo dele é apenas vingança, não há nada que possamos fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110109,
					"content": "Ainda, hmm, dá tempo de eu pedir demissão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "Brincadeira, brincadeira! Não se preocupe, Chefe, sei que não tem como fugir agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "Então meu canhão, meu orgulho e alegria, foi um problema mais que uma ajuda... Argh! Quer saber? Vou desmontar ele. Agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "Isso não foi sua culpa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Isso mesmo, e ainda funciona em anomalias normais da Caçada Feroz. Não deixe isso te afetar, Aino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, precisamos que você cuide da situação com os Portadores da Lâmpada. Não se preocupe, expliquei tudo a eles. Você tá de boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110116,
					"content": "Muito obrigado, por isso e por tudo que você fez para nos ajudar a chegar à verdade mais facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Se você estivesse disposto a se mostrar em público com mais frequência, você não teria sido tão fácil de ser isolado, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110118,
					"content": "Heh. Anotado. Refletirei sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Hmm. Acho que essa é uma maneira que eu me beneficiaria de substituir o Sargento-Mor Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "Você quer dizer algum tipo de promoção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Ele tá brincando, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "Ah, espera. Só Paimon que não entendeu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#Bem, {NICKNAME}, se você tiver um momento, gostaria de vir comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "Tem um cavalheiro que eu gostaria de me despedir pela última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "Nem do canhão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
		{
			"id": 601102,
			"completionStepIds": [
				601102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
