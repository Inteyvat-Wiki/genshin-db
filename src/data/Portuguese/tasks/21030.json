			"dialogs": [
				{
					"id": 210300201,
					"content": "Como estão indo as coisas, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300202,
					"content": "Deve estar mais seguro agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "Uau, você é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300204,
					"content": "Meu pai disse que vai contratar algumas pessoas para proteger a gente enquanto estivermos viajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300205,
					"content": "Só espero que essas pessoas sejam tão boas quanto você, Viajante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300206,
					"content": "Senhor Ferreiro, isso significa que você pode continuar minerando e fazendo as ferragens agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300207,
					"content": "Hahahaha, mas é claro! Apenas me dê um momento para me preparar. Vou pegar os minérios e voltar logo para continuar meu trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300208,
					"content": "Dito isto, tem um limite de quanto minério consigo carregar por mim mesmo. Com sorte, a área deve estar completamente livre de monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mestre Zhang"
				}
			]
		},
