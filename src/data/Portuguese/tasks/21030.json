			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeno Meng",
					"Mestre Zhang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Hã? Estes dois minérios não são o mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300102,
					"content": "Mas é claro que não. A qualidade e o preço de qualquer coisa forjada a partir de qualquer um desses tipos de minérios seria completamente diferente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300103,
					"content": "Uh, mas... mas isso é tudo que temos sobrando desses dois tipos, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300104,
					"content": "*Suspiro* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300105,
					"content": "O que vocês estão fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "Olá, Viajante! Estou ajudando meu pai a checar as ferragens que ele pediu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300107,
					"content": "O senhor Ferreiro é o melhor de todos! Ele disse que me faria uma pequena espada, também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300108,
					"content": "Mas ele diz que ultimamente não tem havido matéria-prima suficiente pela loja, por isso o lote de ferragens do meu pai pode acabar atrasando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300109,
					"content": "E eu também não faço ideia de quando minha espada vai ficar pronta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300110,
					"content": "*Suspiro* Bem, fazer o que. Temos estado muito ocupados ultimamente, por isso estamos mais ou menos sem minério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300111,
					"content": "As áreas onde o minério é mais abundante também são bem ocupadas por muitos monstros, por isso não me atrevo a ir lá minerar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300112,
					"content": "Vou ter que esperar até que eu tenha tempo livre antes de contratar um aventureiro para me acompanhar enquanto vou minerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300113,
					"content": "Mas quando será isso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300114,
					"content": "#Na verdade, Viajante, ouvi dizer que você é {M#muito bom}{F#muito boa} em derrotar monstros. Isso é verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300115,
					"content": "Se for, você poderia por favor me dar uma ajuda? Por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300116,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "Viajante, você vai verificar a situação por lá? No caso, deixe-me marcar meus locais típicos de mineração no mapa para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300119,
					"content": "Muito bem, deve bastar. Tenha cuidado enquanto estiver por lá. Esses lugares estão cheios de monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Mestre Zhang"
				},
				{
					"id": 210300120,
					"content": "Estou contando com você, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210300117,
					"content": "Eu... Vou ver o que posso fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
