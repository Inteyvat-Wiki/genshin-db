					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "Eu... Sinto \"razão\". Visitantes, vocês são sucessores da Cruz de Narcissus, ou são uma ameaça?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650102,
					"content": "Vocês sacaram suas armas. Entendi sua resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650103,
					"content": "Narzissenkreuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Hã? Essa coisa é Narzissenkreuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "#Se você já ouviu meu nome, então sabe de minha missão para salvar o mundo, e há uma chance de que você possa ser salv{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650106,
					"content": "#Vocês erguem suas armas contra mim, pois foram enganad{M#o}{F#a}s por mentiras. Mas não é hora de desperdiçar minha energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650107,
					"content": "Maravilhem-se e alegrem-se. Quando tudo acabar, explicarei e demonstrarei. Mas agora, coloquem a Espada Sagrada em minha mão e fujam para a segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650108,
					"content": "Não vamos dar a Espada Sagrada para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "#Tol{M#o}{F#a}s, tol{M#o}{F#a}s. Mas eu {M#o}{F#a}s perdoo, e {M#o}{F#a}s salvarei mesmo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650110,
					"content": "Posso sentir que os quatro quadrantes foram revertidos. Mas a árvore do fluxo ainda não está completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650111,
					"content": "Não é mais possível salvar todos. Estenderei minha benevolência o mais longe que puder, mesmo que consuma minha própria energia vital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650112,
					"content": "Se apenas cinco em dez puderem ser salvos, almejarei salvar seis em dez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650113,
					"content": "Agora, pegarei a Espada Sagrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
