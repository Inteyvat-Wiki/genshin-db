				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Impossível... eu já cheguei à fase de \"não ter volta\". Como caí até esse ponto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650202,
					"content": "E perdi todo o controle do Mar Primordial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650203,
					"content": "Por que, por que isso aconteceu? Por que, por que você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650204,
					"content": "O novo mundo não pode nascer. Todos morrerão em uma concha, uma casca de um sonho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650205,
					"content": "Paimon acha que é você que devia tentar acordar desse sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "O fim do mundo é o tipo de coisa que todo mundo tem que se juntar para impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Entendo. A Espada Sagrada não está ao meu lado. Com cada golpe, ela corta a vontade universal que me rodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650208,
					"content": "Até lá, pelo menos, meu eu fraco e comum retornou ao seu corpo físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650209,
					"content": "O Mar Primordial não transbordará tão cedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "De fato, posso sentir mudanças nos valores introduzidos originalmente na fórmula do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650211,
					"content": "Quem reivindicou controle da energia vital? Quem abriu o reino feral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650212,
					"content": "Então, há mais uma variável. Você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650213,
					"content": "A pessoa destinada a ver a Baleia Devoradora ser derrotada. Quem testemunhará tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650214,
					"content": "Entendo, entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650221,
					"content": "Eu já sonhei me tornar alguém como você. Mas esse sonho agora está despedaçado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650222,
					"content": "Tudo que fiz foi insignificante. Um sonho vazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650223,
					"content": "Não, menos do que um sonho, até. Um sonho, pelo menos, é inofensivo. Mas eu... Não, você, e eles... pagaram muito pelo que eu fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650224,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Ah, é você. Não te vi aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650226,
					"content": "Você sabe quem sou de verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "Nomes são apenas rótulos. Mas sim, sou muito familiar com as duas cores que se misturam em sua alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650228,
					"content": "Diretora Lyris não sabe o que aconteceu. Ela só se agarra a Mary-Ann, que ainda se segura à vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650229,
					"content": "Ela não pode entender um presente e futuro tão complexo, e espera manter o passado. Assim, ela faz a única coisa que pode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650230,
					"content": "Meu nome é Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "Nesse caso, olá, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650232,
					"content": "Estou disposta a perdoar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "Que coisa estranha de se dizer. Desde o início, meus planos tiveram objetivos elevados e sagrados. Altruísmo nunca foi um deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650234,
					"content": "Ninguém pode me julgar ou me criticar, nem preciso de perdão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650235,
					"content": "Seu objetivo pode ter sido elevado, mas sua insanidade prejudicou muitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "Você nem sequer preencheu a fórmula corretamente... e qual é o problema em ser perdoado por um erro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "...Você está certa. Peço desculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650238,
					"content": "Então, por favor, Narzissenkreuz, volte com a gente. Tem outras pessoas que você precisa ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "Esse cara parece ter ficado muito mais amigável. Mas um pedido como esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650241,
					"content": "Hã? Esse tipo de coisa geralmente não precisa de um conflito interno e horas de persuasão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Como disse antes, não sinto que fiz nada errado. Minha missão falhou, mas o mundo foi salvo mesmo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650243,
					"content": "Que outros me zombem e amaldiçoem. Sou vazio por dentro agora. Apenas um desejo permanece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650244,
					"content": "Qual é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Eu também desejo retornar ao início — ao tempo antes dos heróis da Cruz de Narcissus partirem em sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650246,
					"content": "Mas isso é impossível. Não somos mestres dos nossos próprios destinos. Eu nem tenho mais o poder de determinar meus próprios sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650247,
					"content": "#Bem, Cavaleir{M#o}{F#a} {NICKNAME}, quando estiver pront{M#o}{F#a}, selaremos de novo as águas primordiais, então sairemos desse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "Aquela criatura já foi derrotada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "Eu deveria ter sentido mudanças nos valores originalmente inseridos na fórmula do mundo. Uma \"variável\" desceu a este mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650217,
					"content": "Nem tudo de fora do universo pode ser chamado de uma \"presença\" ou \"variável\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650218,
					"content": "Mas mesmo assim, parece que negligenciei uma variável. Você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650219,
					"content": "#Testemunha de tudo, registrador{F#a} de tudo, criador{F#a} de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650220,
					"content": "Apenas alguém que vale um mundo pode carregar este título.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7416505",
							"2"
						],
						"stepId": 7416505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650301,
					"content": "Impossível... eu já cheguei à fase de \"não ter volta\". Como caí até esse ponto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650302,
					"content": "E perdi todo o controle do Mar Primordial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650303,
					"content": "Por que, por que isso aconteceu? Por que, por que você fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650304,
					"content": "O novo mundo não pode nascer. Todos morrerão em uma concha, uma casca de um sonho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650305,
					"content": "Paimon acha que é você que devia tentar acordar desse sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "O fim do mundo é o tipo de coisa que todo mundo tem que se juntar para impedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "Entendo. A Espada Sagrada não está ao meu lado. Com cada golpe, ela corta a vontade universal que me rodeia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650308,
					"content": "Até lá, pelo menos, meu eu fraco e comum retornou ao seu corpo físico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650309,
					"content": "O Mar Primordial não transbordará tão cedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "De fato, posso sentir mudanças nos valores introduzidos originalmente na fórmula do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650311,
					"content": "Quem reivindicou controle da energia vital? Quem abriu o reino feral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650312,
					"content": "Então, há mais uma variável. Você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650313,
					"content": "A pessoa destinada a ver a Baleia Devoradora ser derrotada. Quem testemunhará tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650314,
					"content": "Entendo, entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650315,
					"content": "Eu já sonhei me tornar alguém como você. Mas esse sonho agora está despedaçado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650316,
					"content": "Tudo que fiz foi insignificante. Um sonho vazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650317,
					"content": "Não, menos do que um sonho, até. Um sonho, pelo menos, é inofensivo. Mas eu... Não, você, e eles... pagaram muito pelo que eu fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650318,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650319,
					"content": "Ah, é você. Não te vi aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650320,
					"content": "Você sabe quem sou de verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650321,
					"content": "Nomes são apenas rótulos. Mas sim, sou muito familiar com as duas cores que se misturam em sua alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650322,
					"content": "Diretora Lyris não sabe o que aconteceu. Ela só se agarra a Mary-Ann, que ainda se segura à vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650323,
					"content": "Ela não pode entender um presente e futuro tão complexo, e espera manter o passado. Assim, ela faz a única coisa que pode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650324,
					"content": "Meu nome é Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650325,
					"content": "Nesse caso, olá, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650326,
					"content": "Estou disposta a perdoar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650327,
					"content": "Que coisa estranha de se dizer. Desde o início, meus planos tiveram objetivos elevados e sagrados. Altruísmo nunca foi um deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650328
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650328,
					"content": "Ninguém pode me julgar ou me criticar, nem preciso de perdão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650329
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650329,
					"content": "Seu objetivo pode ter sido elevado, mas sua insanidade prejudicou muitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650330
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650330,
					"content": "Você nem sequer preencheu a fórmula corretamente... e qual é o problema em ser perdoado por um erro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650331
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650331,
					"content": "...Você está certa. Peço desculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650332
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650332,
					"content": "Então, por favor, Narzissenkreuz, volte com a gente. Tem outras pessoas que você precisa ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650333
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650333,
					"content": "Esse cara parece ter ficado muito mais amigável. Mas um pedido como esse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650334,
					"content": "Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650335
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650335,
					"content": "Hã? Esse tipo de coisa geralmente não precisa de um conflito interno e horas de persuasão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650336,
					"content": "Como disse antes, não sinto que fiz nada errado. Minha missão falhou, mas o mundo ainda está destinado a ser salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650337
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650337,
					"content": "Que outros me zombem e amaldiçoem. Sou vazio por dentro agora. Apenas um desejo permanece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650338
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650338,
					"content": "Qual é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650339,
					"content": "Eu também desejo retornar ao início — ao tempo antes dos heróis da Cruz de Narcissus partirem em sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650340
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650340,
					"content": "Mas isso é impossível. Não somos mestres dos nossos próprios destinos. Eu nem tenho mais o poder de determinar meus próprios sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650341
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650341,
					"content": "#Bem, Cavaleir{M#o}{F#a} {NICKNAME}, quando estiver pront{M#o}{F#a}, selaremos de novo as águas primordiais, então sairemos desse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		}
	]
}