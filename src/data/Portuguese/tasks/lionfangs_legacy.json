			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Eis aqui, o <color=#00E1FFFF>Escudo da Honra Magnífica</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "Mentiroso, mentiroso, sua calça está pegando fogo! É apenas um pedaço de madeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Um pedaço de restos de madeira com uma alça acoplada. Quem em pleno juízo usaria isto como escudo!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Também tem manchas de vinho nele... É, tenho certeza de que isso foi tirado de um barril de vinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "E ainda assim, a minha intuição de bardo me diz que isto não é outra coisa senão o Escudo da Honra Magnífica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "Os guerreiros usam suas cicatrizes de batalha com orgulho, e os escudos não são diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Certamente, um escudo intacto é aquele que se afastou do campo de batalha. Não é o escudo quebrado e estilhaçado aquele que lutou em incontáveis guerras e viveu para contar a história?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Embora o corpo do soldado esteja cansado e despedaçado, eles ainda lutam até o fim, até não terem mais sangue para sangrar. Tal magnífica força de vontade... Não é esse o verdadeiro significado de honra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "Eu concordo com o Venti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Você tem um ponto... Escudos novos e brilhantes não ficam novos e brilhantes por muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "Muito bem, então... Bem, talvez se pedirmos gentilmente, ele nos deixe levar o Escudo da Honra Magnífica de graça?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "Com licença, senhor Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120616,
					"content": "#Hu. Muito bem, você toma conta a partir daqui, {NICKNAME}! Espero que você já tenha aprendido um pouco de Hilichurliano. Se não, há sempre a linguagem corporal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "Pagarei uma boa Mora por este escudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120623,
					"content": "Oh oh... Parece que ele <color=#00E1FFFF>não gostou muito</color> disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Por favor, tome esta Flor Doce que eu peguei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120628,
					"content": "Parece que ele está <color=#00E1FFFF>animado</color> o suficiente. Talvez a negociação funcione afinal de contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti canta, você dá escudo, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Hmm? Bem, se você insiste, uma melodia irei cantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Venti"
				},
