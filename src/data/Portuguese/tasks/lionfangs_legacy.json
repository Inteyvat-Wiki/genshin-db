			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Pessoal, muito obrigado! Não posso acreditar que eu os encontrei de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121002,
					"content": "Mãe! Pai! Vejam as armas lendárias que eu encontrei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121003,
					"content": "Ei, espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121004,
					"content": "O vinho, você prometeu! Ugh, e eu realmente ajudei muito desta vez——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121005,
					"content": "Hmm? O que você está fazendo aqui, Stanley? Saiu para dar um passeio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121006,
					"content": "Ah... Haha, ah- Ei...! O que você está fazendo aqui, bardo! Que coincidência, hein? Você, uh... Saiu para dar um passeio também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121007,
					"content": "Isso mesmo, um passeio após o jantar, para ser mais preciso. Nós também estávamos ajudando um amigo a procurar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121008,
					"content": "(Paimon está começando a pensar que Stanley pode ser uma fraude...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121009,
					"content": "(Eu também estou seriamente começando a pensar nisso.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(O Stanley deixou a espada e o escudo aqui com antecedência para não magoar os sentimentos do Jack?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121012,
					"content": "Aventureiros devem estar bastante familiarizados com o Vale de Dadaupa, não é? Afinal, você já travou batalhas aqui antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121013,
					"content": "Pode acreditar! Eu poderia navegar por toda esta área com os olhos fechados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121014,
					"content": "Uau. Então eu admiro sua perseverança e a sua memória também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "É de se esperar de um grande aventureiro como eu! Mas é melhor terem cuidado. Este lugar está repleto de Hilichurls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "Eu, ah... Voltarei ao meu... Ah... Passeio agora. Até mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121017,
					"content": "Consciência pesada, demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121018,
					"content": "Bem, ele não deveria ter se entusiasmado tanto se gabando ao Jack, deveria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121019,
					"content": "Embora... Em uma reflexão mais profunda, devo dizer que estou intrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121020,
					"content": "Alguém que não consegue largar o passado e, em vez disso, desiste do presente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121021,
					"content": "Eu me pergunto... Se tal pessoa fosse forçada a dar seu primeiro passo em direção ao futuro, qual seria o caminho a seguir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121022,
					"content": "Do que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121023,
					"content": "Haha, estou apenas me questionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121024,
					"content": "#Enfim, {NICKNAME}, proponho que façamos uma viagem ao <color=#00E1FFFF>Presentes dos Anjos</color> hoje à noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121010,
					"content": "(Ele é definitivamente uma fraude. Sem dúvida.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
