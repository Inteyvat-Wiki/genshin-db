				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Hehe. Eis aqui, a <color=#00E1FFFF>Espada da Bravura</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120402,
					"content": "Você tem certeza? Parece um pouco básico para Paimon, e um pouco-muito desgastada também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120403,
					"content": "Por que os Hilichurls estariam se curvando diante de um pedaço de lixo como este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120404,
					"content": "(Ahh... Parece que alguém jogou uma espada velha em uma pilha de espólios que esses Hilichurls já estavam celebrando...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120405,
					"content": "Isto está em péssimo estado! E é tão básico, eu... Estou sem palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120406,
					"content": "Hmm... Veja, Jack, você já viu uma Borboleta de Cristal? Elas são encontradas em campo aberto ao redor da cidade de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120407,
					"content": "Se você visse uma em plena luz do dia, você não iria dar a mínima. Mas na escuridão do breu da noite? Seu brilho radiante é hipnotizante - realmente se assemelha a um cristal requintado dançando no ar noturno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120408,
					"content": "A bravura não é o mesmo? Quando tudo segue seu caminho, parece sem sentido - desvanece-se em segundo plano. Mas quando você está em apuros, a bravura é o que faz com que você se sinta mais animado e lute novamente. É o raio de luz brilhante que guia você para fora da escuridão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120409,
					"content": "Isso foi um monte de bobagem muito bem elaborada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "Você está certo... Você está certo! Então deve ser isto - esta é a Espada da Bravura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120413,
					"content": "Uhum. Então temos nossa espada, agora só precisamos daquele escudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120414,
					"content": "Vamos dar uma olhada em volta! Definitivamente está pelo <color=#00E1FFFF>Vale de Dadaupa</color> e- hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120415,
					"content": "Tem alguém ali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120416,
					"content": "Stanley? O que ele está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120417,
					"content": "Ele está agindo de forma tão estranha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120418,
					"content": "O que aconteceu? Por que você parou de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120419,
					"content": "Hã? Oh, ah, não é nada. Apenas um daqueles Furão Ladrão que passou por aqui, só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120420,
					"content": "O quê? Onde? Eu quero ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120421,
					"content": "Talvez em outro momento. Temos um escudo para encontrar, lembra-se?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120410,
					"content": "Excelente recuperação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "Eu mesmo quase caí nessa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
