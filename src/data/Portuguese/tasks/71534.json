			"dialogs": [
				{
					"id": 715340101,
					"content": "Hmm, eu provavelmente deveria dar uma olhada em outros envelopes primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#Ah, {NICKNAME}! Há quanto tempo... Por que a cara de surpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Eu só não esperava...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Ver uma guerreira aproveitando o Ritual de Lanternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Eu não acho que já tenha te visto relaxar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "A Comissão Tenryou carrega uma grande responsabilidade com as pessoas. Como membro, não posso me dar o luxo de relaxar na maior parte do tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Talvez as pessoas me enxerguem exclusivamente como uma guerreira, completamente deslocada em um bairro festivo e refinado como Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Mas abaixar minha guarda significa deixar crimes impunes... Isso é não apenas em detrimento de meu dever como da atmosfera inteira de Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "O máximo que posso fazer é aproveitar qualquer momento livre que aparecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Ah, perdão. Eu não deveria falar sobre questões tão sérias durante um feriado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "Estou tentando fazer um envelope de presente, mas não está dando certo. Talvez você possa me dar alguns conselhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Claro, me deixa pensar um segundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
