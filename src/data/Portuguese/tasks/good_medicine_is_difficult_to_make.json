			},
			"dialogs": [
				{
					"id": 230381101,
					"content": "Hmm, eu não acho que tenha algo de errado com este ingrediente ou com o processo de preparo.O que será que aconteceu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "Viajante? O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "Eu trouxe os remédios de Zakariya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "Ah, então você deve ter ouvido sobre minha situação, eu sinto muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Beba o remédio primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "Oh, tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf bebeu o remédio...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Ufa... estou me sentindo um pouco melhor. Zakariya é mesmo um ótimo médico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "Por que você mudou a receita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Não lembra da última vez que preparamos um remédio juntos? Não sei por que, mas não deu muito certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "Acho que aconteceu algum erro durante a preparação, ou algum Ingrediente Medicinal deve ter faltado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "Então eu... bem... preparei mais uma porção, seguindo minha experiência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "Para garantir que está tudo certo, eu sempre provo primeiro. E deu nisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "Eu acabei de enviar uma pessoa para pegar um remédio com o Dr. Zakariya, não imaginava que você pudesse trazer tão rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "Muito obrigado, Viajante. Vou descansar mais um pouco antes de voltar a receber pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "Fiquei doente por tanto tempo, com certeza deve haver muitos pacientes me esperando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*Suspiro* Mas meus Ingredientes Medicinais estão acabando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
