			"dialogs": [
				{
					"id": 130280201,
					"content": "Após chegarem ao acampamento, os dois Cogumelos são acolhidos calorosamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "Oh, parece que os Cogumelos daqui nos reconhecem. Eles são tão amigáveis e gentis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280203,
					"content": "Essa forma de vida elemental deve ter sido muito respeitada por todos que vivem aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280204,
					"content": "Hã? Você está tentando brincar com Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280205,
					"content": "♩~♩~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Cogumelo Flutuante Anemo"
				},
				{
					"id": 130280206,
					"content": "#Tá bom, tá bom! {NICKNAME}, Paimon vai ficar logo ali brincando com os Cogumelos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280207,
					"content": "Pode ir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Eu te devo um pedido de desculpas. Quando a Semente de Fogo despedaçou enquanto estávamos dentro de Apep... Eu planejava sacrificar o meu poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280210,
					"content": "Paimon contou para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280211,
					"content": "#Sim, eu fiquei muito preocupad{M#o}{F#a}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Eu deveria ter pensado mais e ter julgado melhor a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280214,
					"content": "Quando eu lembro do Dragão Dendro e do povo de Sumeru correndo perigo, eu fico ansiosa e assustada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280215,
					"content": "Se há algo que você pode fazer e acaba não fazendo, se você não se esforçar até o final, então tudo será tempo perdido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280216,
					"content": "Usar um poder é muito simples, mas também muito complicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280217,
					"content": "Você ainda precisa \"crescer\" mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Sim, acho que eles ensinaram bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280219,
					"content": "Eu entendo o que significa ter os desejos deles realizados, mas ainda não consigo aceitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280220,
					"content": "Por que ela parecia tão contente e tranquila quando estava fazendo algo que... só dá vontade de chorar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280221,
					"content": "Parece que eu ainda não consegui entender totalmente o conceito de \"empatia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280222,
					"content": "Não é sua culpa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Obrigada por me confortar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280225,
					"content": "Meus sentimentos são muito complicados, acho que ainda preciso continuar aprendendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280226,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280227,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Cogumelo Flutuante Hydro"
				},
				{
					"id": 130280228,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Cogumelo Flutuante Hydro"
				},
				{
					"id": 130280229,
					"content": "Eles sabem como cuidar da terra? Hmm, talvez só estejam seguindo o exemplo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280230,
					"content": "Mas já que aquele Cogumelo consegue falar... Talvez isso seja o resultado de ser exposto a Energia Elemental por muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280231,
					"content": "O tempo realmente é poderoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "Isso mesmo. E não precisamos mais nos preocupar com a segurança desses Cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280233,
					"content": "Depois virei cuidar desse acampamento, passarei aqui às vezes para ver como eles estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280234,
					"content": "Quero proteger os vestígios que eles deixaram para criar uma chance de se encontrarem no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280235,
					"content": "De toda forma, ela se lembrou do nome \"Nur\". Suas memórias voltaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280236,
					"content": "Eu acredito nos laços familiares deles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Sim, vamos considerar tudo como um belo desejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280239,
					"content": "Nahida, os Cogumelos trouxeram frutas novamente, vamos comer juntas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280240,
					"content": "Você sabe que eu topo! Pode contar comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280237,
					"content": "Eu acredito em milagres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Me sinto do mesmo jeito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "#Sim, e eu fiquei muito brav{M#o}{F#a}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
