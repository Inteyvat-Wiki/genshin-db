			"trigger": {
				"objectNames": [
					"Pequeno Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "Viajante, bem na hora! Estava te procurando para perguntar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280102,
					"content": "Qual é o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Ele disse que a jornada vai ser longa, e que precisaremos de alguns medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280106,
					"content": "Coisas para dores de cabeça, diarreia, insolação, ressacas, coisas para ajudar na digestão... são muitas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280107,
					"content": "Na verdade, por que eles precisam de coisas para ressaca...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "É provavelmente para negociações comerciais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Hã? O que um medicamento de ressaca tem a ver com acordos comerciais? Não é como se os negócios fossem crescer quanto mais se pode beber, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Seja qual for o caso, meu pai quer que eu vá ao Chalé de Bubu perguntar quais medicamentos eles já prepararam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280111,
					"content": "Você poderia me acompanhar até lá? Eu gostaria de pedir sua ajuda com algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280112,
					"content": "Vamos nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "Venha, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280113,
					"content": "O que é que você gostaria da minha ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Vamos falar sobre isso quando chegarmos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280103,
					"content": "Como estão indo as preparações?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Bem, é mais meu pai e seus amigos se preparando... Mas meu pai também me deu uma tarefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
		{
