					"Pequeno Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "#Bem-vind{M#o}{F#a}s. Vocês estão aqui para procurar por medicamentos de ervas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280202,
					"content": "...Pequeno Meng? O que o traz aqui hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280203,
					"content": "...Oh, certo. Agora me lembrei. Você está pelos medicamentos, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280204,
					"content": "Não se preocupe, estão quase prontos. Enviarei eles ao seu pai em lotes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280205,
					"content": "Dito isto, seu pedido acabou com nossas reservas de ervas, então alguns medicamentos só ficarão prontos mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280206,
					"content": "Deixe-me ver... bem, o principal que está em falta é a Menta, o que fez com que parasse a produção de medicamentos para insolação por agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280207,
					"content": "Digo, também estamos com pedidos de medicamentos de outras pessoas, não apenas do seu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280208,
					"content": "Então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280209,
					"content": "Parece que é minha hora de brilhar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "Hehe, obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280213,
					"content": "Estou contando com você para pegar essas ervas! Ficarei aqui por enquanto para checar os medicamentos, assim como meu pai pediu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280214,
					"content": "Hahaha, você é mesmo um garoto dedicado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280215,
					"content": "Muito bem, por aqui. Farei este lote de medicamentos com você, mostrando em detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280216,
					"content": "Uau, isso é... Muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280217,
					"content": "Dê uma olhada nestes primeiro. Trarei o próximo lote em instantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280218,
					"content": "Hã? Tem mais!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280211,
					"content": "Apenas não esqueça de me pagar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "Hehe, sem problemas! Obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
