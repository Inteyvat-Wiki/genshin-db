			"dialogs": [
				{
					"id": 210280401,
					"content": "Obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280402,
					"content": "Sim, estas serão suficientes para fazer alguns medicamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280403,
					"content": "Colocarei os medicamentos de insolação no próximo lote e mandar entregarem para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280404,
					"content": "Obrigado, irmãozão Gui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280405,
					"content": "E isso é para você, Viajante. Obrigado pela sua ajuda! Vamos voltar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280406,
					"content": "Hehe, meu pai vai ficar bem contente em ouvir isso, tenho certeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280407,
					"content": "Só um momento, Pequeno Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280408,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280409,
					"content": "Você não deveria ter checado os medicamentos? Você ainda não passou pela lista na parte de trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280410,
					"content": "Hã... o quê!? Eu... mas eu estava checando por tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210280411,
					"content": "E tem mais de onde veio esse, Pequeno Meng. Vamos, vamos continuar verificando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Herborista Gui"
				},
				{
					"id": 210280412,
					"content": "Ahh... Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
