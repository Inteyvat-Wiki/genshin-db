					}
				]
			},
			"dialogs": [
				{
					"id": 750680401,
					"content": "Então você ainda está aqui, Valente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680402,
					"content": "No passado, dizem os estudiosos, o antigo e tirânico Senhor desta Cidade Incandescente conhecia... uma forma de impedir a corrosão Abissal. Então nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680403,
					"content": "Mas realmente há algo sombrio sobre este lugar, Valente. Ultimamente, eu também comecei a me sentir um pouco... estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680404,
					"content": "Às vezes, ao acordar, você descobre que uma estrada que estava perfeitamente intacta no dia anterior agora está quebrada e dilapidada... E aquelas casas de pedra estavam assim desde o início? Parece que elas deveriam ser mais... completas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680405,
					"content": "Mas às vezes, quando acordo, vejo amigos que não deveriam mais estar aqui... Eles são monstros? Deve ser isso... São monstros que tomaram a forma dos meus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680406,
					"content": "Meu... Meu dever aqui é eliminar esses monstros, mas... por quê? Por que eu tenho que fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680407,
					"content": "De qualquer forma, dito isso, este é um lugar muito estranho. Você deveria partir... o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
