				]
			},
			"dialogs": [
				{
					"id": 750680501,
					"content": "É melhor sair de uma vez. Se você ficar mais tempo, será tarde demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680502,
					"content": "Por que será tarde demais, você pergunta? Porque... porque toda a nossa equipe de exploração foi dizimada. Aquele monstro gigante, escuro como breu... Todos eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680503,
					"content": "Eles me encarregaram de proteger os evacuados, e, ao menos, garantir que eles deixassem a cidade. Enquanto falamos, uma equipe de resgate do Clã das Plumas de Flores está a caminho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680504,
					"content": "Eu preciso eliminar esses monstros malignos, para que os sobreviventes possam retornar a uma terra onde o sol brilha... Mas, hm... Por que estou aqui de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680505,
					"content": "Esse som nos meus ouvidos... Ahh, está ficando mais alto e mais alto. Eu... Eu tenho que voltar para a cachoeira. Sim, eu preciso... voltar para a cachoeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680506,
					"content": "Valente, você também deveria partir... o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
