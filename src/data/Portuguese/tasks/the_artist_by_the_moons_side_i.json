			"dialogs": [
				{
					"id": 760360301,
					"content": "Essas bastam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360302,
					"content": "Sim. O kuuhenki parece bem satisfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360303,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Paimon nunca imaginou que os kuuhenki podiam pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "São como nós, na verdade. Cada um possui uma personalidade, e seus passatempos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360306,
					"content": "Espera, então você consegue reconhecer todos os kuuhenki de Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Os que eu já conheço, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360308,
					"content": "Uau, que impressionante! Especialmente porque fora Luonnotar, todos os outros kuuhenki são meio parecidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Qual é o nome desse pintorzinho daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Nome...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360311,
					"content": "Espera, você não deu nome pra eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Eu reconheço eles, e eles me reconhecem. Os nomes não são necessários... Eu mesma não tenho um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360313,
					"content": "Isso não é razão para perpetuar más tradições!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hmm... nesse caso, Luonnotar significa \"uma criatura nascida sob a bênção da Deusa da Lua\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "Como se fala pintura na língua dos Filhos da Lua Gelada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Acho que é... Maa... raus? Maalaus? Sim. Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360317,
					"content": "Oh, parece bem legal! Vamos chamar você de Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "O que foi, Maalaus? Terminou sua pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "Oh, vamos ver! Vamos ver! Hã, isso aqui é...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "Isso aqui é incrível! Tipo, super incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Paimon tava esperando um aspecto mais infantil... ou, sabe, uma pegada mais Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Os kuuhenki são especialistas em sentir os arredores e, ao recriar o que veem, eles tendem a registrar seus sentimentos exatamente como são.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360326,
					"content": "Hmm... Essa que você desenhou é Columbina, Maalaus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360328,
					"content": "Hã...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360329,
					"content": "...Parece Columbina quando ela nasceu.",
