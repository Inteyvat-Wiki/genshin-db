			"dialogs": [
				{
					"id": 760360101,
					"content": "Não era esse azul, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360103,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "Ah? São vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360106,
					"content": "#Podem me ajudar? Fiquem tranquil{M#o}{F#a}s, eu retribuirei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360107,
					"content": "Hmm... Quando você vai deixar esse hábito pra trás...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360108,
					"content": "Você ajudou muito a gente antes também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "É. A gente ia te ajudar mesmo que não tivesse nada para nos dar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360111,
					"content": "Então, que tipo de ajuda você precisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360112,
					"content": "Bem... Para ser precisa, essa criatura que precisa de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360114,
					"content": "O kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360115,
					"content": "Essa criança conseguiu um pincel de alguma fonte desconhecida e, ao retornar ao meu lado, ficou balançando ele alegremente por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360116,
					"content": "Encontrei algumas telas e tintas, mas mesmo com um pouco de tempo passando, suas tentativas de misturar as cores que deseja não tiveram muito sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360117,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360118,
					"content": "Ei, olha só quem apareceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360119,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360120,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360121,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360122,
					"content": "Ei, ei, não esqueça, não entendemos gesticulações...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360125,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360126,
					"content": "Hmm, parece que ele se interessou pela sua mochila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360127,
					"content": "Você carrega cores adequadas consigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360128,
					"content": "Hmm, a gente não carrega esse tipo de coisa geralmente... Falando nisso, onde você encontrou as tintas? Sem ofensa, mas, hmm, você não parece ser uma pintora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360129,
					"content": "Esta criança estava ficando muito impaciente, então fiz algumas tintas para ela usando algumas flores coloridas próximas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760360130,
					"content": "Hmm, será que Luonnotar tá procurando por outras coisas com cores vibrantes para fazer tintas, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360131,
					"content": "Vem, vamos ver o que temos nas nossas bolsas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360109,
					"content": "Você já nos ajudou bastante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "O que tá acontecendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
		},
