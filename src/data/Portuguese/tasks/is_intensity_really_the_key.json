			"dialogs": [
				{
					"id": 751781401,
					"content": "Hã? Um pequeno Koholassauro? Por que ele está aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki'o-ki'o...! Então você estava aqui, afinal... Se vocês não tivessem saído quando saíram, eu- eu teria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "E se você tivesse se ferido? Não só saia correndo por aí assim novamente, tá bom? *choro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "E-Ei, anime-se! Olhe, seu pequeno Sauriano está bem, tá vendo? E super cheio de energia também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Ah, uhm... Estou bem agora. Ohm, eu esqueci de me introduzir. Sou Linaha, do Povo das Termas. Geralmente sou encarregada se cuidar dos pequenos Koholassauros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Sozinha? Isso é impressionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "N—Não realmente... Se eu fosse mais que nem você, Srta. Paimon, eles provavelmente não teriam fugido assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "Eu estava pensando que eles todos poderiam ter ido brincar perto das aberturas, e acabou que eu estava certa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "Então a fonte termal ficou quente porque os pequenos Koholassauros bloquearam as aberturas de Flogisto, hein? Não é à toa que o cuidador da fonte não percebeu nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "Na verdade... ainda tem dois outros Koholassauros que não achei. Acho que eles provavelmente também estão se escondendo nas saídas de combustível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "Deixe isso com a gente! Nós vamos encontrar os outros Koholassauros enquanto ajustamos a temperatura da água, não se preocupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Sério? Muito obrigada! É ótimo ter a Srta. Paimon por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Hehe, mas é claro! Você sempre pode contar com uma aventureira lendária como a Grande Paimon — isso é moleza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Uau! Srta. Paimon, você é incrível! Quero ser igual a você um dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
					"content": "Concordo. A Grande Srta. Paimon realmente é incrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Ei, você poderia não colocar a Paimon contra a parede assim, na frente de todo mundo? Que tal isso — a Paimon vai deixar você comer o melhor prato hoje à noite, tá bom?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "Cof! Enfim, vamos em frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781417,
					"content": "Certo então, deixarei a próxima luta com você, oh, Grande Srta. Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				}
			]
