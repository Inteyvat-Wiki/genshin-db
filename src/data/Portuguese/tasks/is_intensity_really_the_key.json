						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#Espera, {REALNAME[ID(2)|SHOWHOST(true)]}, não saia correndo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "Provavelmente deve ter um monte de magma no vulcão aqui perto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Oh! Paimon já sabe! Nós podemos fazer o nosso pequenino cavar um túnel e então podemos usar o magma vulcânico para aquecer a fonte termal, certo? Essa é uma boa ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "Rawr! Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#...Como se isso fosse verdade! Fala sério, por favor? Podemos acabar matando pessoas com esse método! Pior, {REALNAME[ID(2)|SHOWHOST(true)]} acreditou em você por um segundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				}
