					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781009,
					"content": "*Suspiro* Não tem uma solução mais realística que podemos tentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "Paimon"
