				"points": []
			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "Alguém pode me ajudar!? Alguém acabou de desmaiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Oh não, parece que o mestre desmaiou! Vamos ajudar também, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Parece que o mestre só desmaiou do calor e não se machucou seriamente. Com sua ajuda, Yoleehe carrega o mestre inconsciente para longe...\\nParece que a própria habilidade do mestre de lidar com \"intensidade\" ainda tem espaço para melhoria...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
