					"Loshts"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "#Como está indo sua jornada para encontrar o \"mais forte\" oh, guerreir{M#o}{F#a} de terras distantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "Conte-me onde o \"mais forte\" está...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Se você subir a montanha, irá se deparar com uma região brilhando com as \"Águas da Intensidade\". Lá, talvez, você encontrará traços do \"mais forte\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "Ainda trabalhando nisso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Ah, sim, isso seria adorável! Adorável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
		{
