						"pointId": 10881
					},
					{
						"sceneId": 3,
						"position": [
							-2894.659,
							289.808,
							10732.25
						],
						"pointId": 10899
					}
				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "Tão \"frio\"! Isso é tão \"frio\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "Hã!? Frio? Do que você está falando... Você está sentado em uma fonte termal, não está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "Não, não... Isso ainda não é suficiente! Se eu vou me tornar o \"mais forte\" — o \"mais forte\" do Coletivo da Fartura, não, em toda Natlan — não posso me contentar com esse nível de frio! A \"intensidade\"... não é nem um pouco suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "Hã... Por que você se sentou de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "Parece que a \"intensidade\" ainda não é suficiente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "E o que exatamente é essa \"intensidade\" de que você está falando? Paimon não entende nadinha do que você está falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Oh, vocês devem ser {M#os famosos aventureiros}{F#as famosas aventureiras}, {NICKNAME} e Paimon! Maravilha! Agora estamos a salvos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "O-O quê? Salvos? O que está acontecendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Tá, eu vou falar. Segundo o próprio mestre, ele está em uma jornada para se tornar o \"mais forte\". Para isso, ele mergulhou totalmente em algum tipo de treinamento de fontes termais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Espera, treinamento? Em uma fonte termal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "É... Sei que parece loucura, mas ele tirou essa ideia de algum livro de artes marciais chamado \"O Caminho das Nascentes Ferozes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "O livro diz que se você seguir seus ensinamentos, você pode <color=#00E1FFFF>fazer a água fria ferver</color> eventualmente apenas usando sua própria \"intensidade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "E essa não é nem a parte mais estranha! O livro está cheio de histórias insanas sobre lendas das artes marciais — como a de um cara que atravessou uma montanha com um soco em uma noite, e outro que conseguia esmagar pedras e transformar elas em pedras preciosas com as próprias mãos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Paimon nunca imaginou que pudessem existir artes marciais tão incríveis no mundo! Se você pudesse aprender elas também, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Uau, isso parece algo saído diretamente de um romance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Olha, eu entendo — parece ridículo. Mas esse não é um livro qualquer. Nosso mestre encontrou ele nas coleções dos Mestres do Vento Noturno, então, tem que ser legítimo, certo? E, mais importante, ele completamente acredita nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "É por isso que ele escolheu essa fonte termal específica, ou melhor, essa \"fonte fria\". Seu objetivo é transformar a água congelante em uma verdadeira fonte termal usando nada além de pura \"intensidade\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "Espera... é verdade! Essa água é muito gelada! Mas, por mais forte que ele seja, ele não vai ficar doente por ficar em uma água como esta por tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Sim, exatamente! E mesmo que ele não fique doente, isso não pode continuar para sempre. Nosso \"Desafio de Guerreiro\" foi suspenso por dias, e todos estão esperando que ele volte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Mas o mestre fica dizendo que desistir no meio do caminho significaria que ele não tem \"intensidade\" suficiente. Ele jurou que não vai sair até que a água comece a ferver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "Em primeiro lugar, o gerente da fonte não faz ideia de por que a água esfriou. Honestamente, se ao menos tivéssemos alguns aventureiros habilidosos por perto para ajudar... Olha, eu até já preparei uma recompensa! Tudo isso, para qualquer um que conseguir resolver o problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Talvez você devesse pedir ajuda a alguém do Povo das Termas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "#(Ei, não vamos ser tão rápid{M#os}{F#as} em recusar ele. Pelo menos, vamos verificar o quanto ele está oferecendo primeiro!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "Cof, não se preocupe — nós vamos aquecer essa Fonte Termal novamente. Além disso, não podemos simplesmente deixar o mestre sentado em uma água gelada até que ele fique doente. Ajudar as pessoas é o que os bons aventureiros fazem, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Oh, muito obrigado! Contarei com vocês, então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Fique aqui. Vamos resolver isso rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Você está realmente tentando me subornar com essa recompensa agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Você não acredita realmente nisso, acredita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Provavelmente por que ficar de pé deixa ele sentindo ainda mais frio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Paimon também acha. Não é à toa que ele está se tremendo feito vara verde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
