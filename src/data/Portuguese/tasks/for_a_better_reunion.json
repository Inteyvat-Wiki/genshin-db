			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730310601,
					"content": "Rana parece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "Paimon quer dizer que ela está tendo um bom sonho, mas isso não parece certo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Uma imagem vaga de algo aparece dentro da \"bolha\" em que Rana está presa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "#(Você está imers{M#o}{F#a} na paisagem...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Você estava na floresta, e tudo parecia ser gigante. O local era muito calmo e sereno. Você estava se sentindo muito à vontade. \\nA luz do poente atravessava as folhas das árvores num ritmo intermitente e brilhante. O mato alto parecia rir baixinho e tocava em sua mão enquanto você passava.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "Escutando com atenção o canto das árvores e a melodia das águas, você ouviu um chorinho inquieto. Seguindo o som do choro, você encontrou uma criança muito pequena. \\nTalvez porque tivesse se cansado de chorar, ela estava deitada de bruços no campo e dormia. Você foi até o lado dela e começou a cantar docemente uma canção capaz de acalmar qualquer criatura...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#... Ei! Você está bem, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Que bom que você está bem... Paimon estava tão preocupada... Parecia que você ia desmaiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}! Vocês vieram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Uou! Paimon se assustou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Uou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Uou!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Nossa, o que há de errado com você Aranaras, assustando as pessoas assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "Por que o \"Uou\" do nada, Branca Voadora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "Paimon é Paimon, não Branca Voadora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana estava no chão para preservar o poder Ararakalari. Assim, Nara Rana não murchará. Mas Bija ainda é necessário para ela ser forte de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#Paimon entende. Falando nisso, o que aconteceu com {NICKNAME} agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Explique a visão que teve...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Acho que era uma memória de Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Uma memória... ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "Paimon não entende. Arana explica. O poder dos Aranaras está na sua coisa mais preciosa. Memórias e sonhos. Com memórias e sonhos, Arana pode usar Ararakalari para ajudar Nara e Aranaras que precisam de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Alguns Nara podem sentir as memórias em Ararakalari. Nara {NICKNAME} também pode sentir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "Isso faz com que Ararakalari pareça importante! Também foi Arana quem usou Ararakalari para proteger Iotham naquela caverna antes, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "Sim, foi Arana. Nara Iotham, Nara Kavus e Nara Sudabeh são amigos, por isso Arana protegeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Brincamos na floresta juntos, por isso Arana ensinou coisas sobre a floresta e linguagem das plantas. São bons amigos, como Nara Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "Sobre as crianças desaparecidas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Certo! Antes de Iotham, Kavus e Sudabeh também desapareceram... Mas eles voltaram a Vila Vimara depois. Você também fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Sim. Arana notou Nara mau e Nara Valuka levando-os, então Arana ajudou Nara Kavus e Nara Sudabeh a correr de volta quando Nara mau não estava olhando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "Entendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "Tudo bem... mas por que eles não se lembram de nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana fez os pequenos Nara dormirem e sonharem, então removeu as coisas ruins em seus sonhos. Então, quando eles crescerem, assim como mudas crescendo em grandes árvores, eles não se tornarão maus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Senão, os pequenos Nara teriam medo. Se sempre se sentirem assim, eles acreditarão no poder do \"medo\", e iriam crescer e se tornar Nara maus assustadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Eles são amigos de Arana. Arana não queria que eles se tornassem Nara maus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Faz sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Eles serão pessoas incríveis! Então, Arana tem alguma ideia sobre quem são aqueles Nara maus que queriam capturar as crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana nunca os perdoaria. Esses Nara maus não são filhos da floresta. Eles trazem Nara Valuka com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "Na Vila Vimara, há um Nara que não é filho da floresta, mas sim filho da neve. Ele parece ser um bom Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Ele frequentemente andava com os pequenos Nara e eles falavam sobre ele também. Por isso Arana acha que ele é bom. Mas Arana também o viu conversando com o Nara mau sobre os Aranaras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "Na Vila Vimara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Um colaborador dos Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Como isso é possível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Não, Paimon não quer nem imaginar isso. As pessoas na Vila Vimara deveriam se tratar como família... Sem falar que essa é a pessoa responsável pelo que está acontecendo com Rana agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Devemos pegar esse vilão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Isso. Nós vamos pegar essa pessoa, custe o que custar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Prometam-me, Nara {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "Prometa que você punirá aquele Nara mau, então Nara Iotham, Nara Kavus e Nara Sudabeh crescerão e se tornarão grandes Nara destemidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Nara Rana está crescida agora, então ela não pode mais ver Arana. Mas está tudo bem. Arana está feliz por saber que ela está bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Faz muito tempo que não brinco com Nara Rana. Muitos amanheceres e entardeceres, muitas luas e muitas frutas cresceram nas árvores e caíram na terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Nara Rana ficou cada vez mais alta. Ela era mais ou menos da altura de Arana, e depois do tamanho de uma árvore pequena. Foi quando ela parou de vir brincar com Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana contou muitas histórias sobre a floresta. Cogumelo Estrelar é o reflexo das estrelas que caíram do céu. Ver uma Lótus Nilotpala significa que terá sorte até a próxima lua nascer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Arana ensinará a Nara Iotham e seus amigos o mesmo. Espero que eles cresçam bem como Nara Rana. Oh espere, exceto encontrar Marana como Nara Rana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Eles esquecerão os encontros quando crescerem, assim como Rana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Nara Iotham, Nara Kavus e Nara Sudabeh vão crescer. Tudo bem se eles esquecerem, já que a floresta lembra de tudo, e nada será perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "A floresta lembra de tudo. Nada de bom desaparece. Todas as dores se tornarão os nutrientes de algo belo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana! Nara {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama! Arana não te vê há um bom tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Paimon, por que você não gritou: 'Aah'?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "Ei, Paimon não se assusta tão facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Arama veio nos chamar para voltarmos juntos para Vanarana e comemorar o Festival Utsava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Sim! O Festival Utsava está pronto, e todos estão esperando por Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "É isso aí! Festival Utsava! Mas você vai, Arana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Não, Arana não vai. Se eu ficar muito tempo fora, Ararakalari não vai aguentar e Nara Rana estará em perigo. Então, nada de Festival Utsava para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Como assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Tudo bem, desde que Nara {NICKNAME} e Paimon estejam felizes, Arana, Arama e todos em Vanarana também estarão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Arana, a Bija precisa de seu poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Então Arana estará pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310679,
					"content": "#Ah, isso é para você, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310680,
					"content": "É uma florzinha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310681,
					"content": "Sim. Por favor, cuide bem dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310682,
					"content": "Cuidarei bem dela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#Obrigado, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310685,
					"content": "#Bem, vamos voltar então, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310683,
					"content": "Tá bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "Nós vamos voltar para celebrar o Festival Utsava?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "Eu farei o meu melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "Nós vamos pegar aquela pessoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "Alguém quer fazer mal as crianças?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310638,
					"content": "Espero que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310639
					]
				},
				{
					"id": 730310639,
					"content": "Eles serão pessoas incríveis! Então, Arana tem alguma ideia sobre quem são aqueles Nara maus que queriam capturar as crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310640,
					"content": "Sobre Nara ruim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310641
					]
				},
				{
					"id": 730310632,
					"content": "Sobre as memórias perdidas das crianças...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310633
					]
				},
				{
					"id": 730310613,
					"content": "Tive uma sensação de déjà vu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				}
			]
		},
