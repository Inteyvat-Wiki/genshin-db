					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Ah, vocês voltaram! Todo mundo estava falando sobre como Nara, muito alt{M#o}{F#a} e poderos{M#o}{F#a}, {NICKNAME} os ajudou muito. Todos ficaram muito felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#É muito bom ter alguém para ajudar com as coisas! Certo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "Não, eles estão felizes porque fizeram novos amigos. Mesmo que Aranakin, Aranaga e Aragaru não consigam mais se lembrar, a floresta conseguirá. A história sempre viverá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "O Festival Utsava está quase preparado. Ainda falta algum tempo para estar organizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Sim, tudo graças à ajuda de Nara {NICKNAME} e Paimon. Estou muito ansioso para o Festival Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
