			"dialogs": [
				{
					"id": 250250101,
					"content": "Poderia vir até a margem, só um pouquinho? Preciso limpar a água aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Koholassauro Preguiçoso"
				},
				{
					"id": 250250103,
					"content": "Vamos lá, rapaz! Senão, vou ter que ir aí te buscar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Koholassauro Preguiçoso"
				},
				{
					"id": 250250105,
					"content": "E ele se foi num lampejo, do nada. Ugh, como vou conseguir segurar ele agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "Hã? Você veio aqui para se banhar na fonte termal? Desculpe, estou no meio da limpeza dessa fonte aqui, então talvez você tenha que esperar um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Além disso, esse tonto não sai, independentemente do que eu diga. *Suspiro* E tenho muito mais fontes para limpar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Será que ele tá fazendo birra porque eu carreguei ele para fora alguns dias atrás? Sério, que saco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
