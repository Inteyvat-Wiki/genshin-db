			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "Hã, parecem ser criaturas de fogo. Tem umas sombras estranhas, e uma câmera automática aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "O instinto da Paimon diz que deve haver algum mistério difícil de ser explicado por trás disso! Talvez isso tenha algo a ver com o tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "O que você viu, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Para ser honesta... Paimon não faz ideia! Mas... o dono do Aparelho Fotográfico deve tê-la colocado aqui para registrar imagens quando o solo tremesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Então, só precisamos consertar o Aparelho Fotográfico e esperar que o solo trema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Hehe, quando for a hora, as pistas do tesouro vão ser tipo um caminho, os tremores vão revelar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513106,
