			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "Uau, é uma chuva de criaturas de fogo! Essas criaturas que tão voando pelas nossas cabeças são tipo um fogo vivo? Esses vulcões de Natlan são muito assustadores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}, Paimon tá curiosa. Que tal a gente explorar essa área em frente agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
