				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Chuva Biológica Incendiária... Espera, poderia realmente ser como nas lendas? Vulcões evoluindo e se espalhando como criaturas vivas, tornando tudo em volta deles mais vulcões? Oh, não, não, não! Isso seria um desastre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "Vulcões não se formam assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Certo, certo. Sem magma, sem vulcão. Eles não podem apenas aparecer do nada. Se pudessem, esse lugar seria uma zona de perigo há muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Mas... e se a lenda for real? Urg, se pelo menos aquela câmera que grava sozinha pelo menos funcionasse direito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Espera! E se a câmera der problema e não gravar nada? Isso seria péssimo! Não, eu preciso ir checar por conta própria, só para garantir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Oops, perdão por interromper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Tá, tchau... Ou, espera, tem mais alguma coisa acontecendo por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "Então, a Chuva Biológica Incendiária são, na verdade, aqueles Pássaros do Fluxo Escaldante caindo do céu? Ah, não é à toa que atinge uma área maior do que uma erupção normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Oh não, e se um deles acabar caindo na minha casa um dia? Não, preciso pensar em um plano para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Bem, provavelmente foi só algo raro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "É, é, aqueles Pássaros do Fluxo Escaldante só subiram lá por conta das erupções vulcânicas. Minha casa não é nem um pouco perto de um vulcão, então, provavelmente vou ficar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "Mas... e se — apenas se — um dia tiver uma mega e insana erupção? Isso não significaria que nenhum lugar está seguro? Urg, não, eu ainda preciso pensar em um plano... só por segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Oops, perdão por interromper.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "Não tem problema, você não está interrompendo... Enfim, vamos começar a reforçar o telhado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
