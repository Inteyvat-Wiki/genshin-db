			"dialogs": [
				{
					"id": 751310601,
					"content": "Após examinarem o Aparelho Fotográfico, vocês descobriram que ela não apenas contém um conjunto de imagens da paisagem ao redor, mas também possui um dispositivo especial. Esse dispositivo parece permitir que a câmera registre imagens automaticamente quando o solo treme.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
