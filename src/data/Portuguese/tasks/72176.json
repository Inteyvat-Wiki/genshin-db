				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Garoto Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#Oi! {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}, eu tenho uma coisa boa aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760102,
					"content": "#Não estou interessad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Que pena, ser forçado a fazer negócios obscuros em uma idade tão jovem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "#Não! Eu quero jogar Temari com {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760105,
					"content": "Temari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "#Deixa eu explicar de uma forma simples. Eu irei esconder o Temari em um local aqui perto. Se {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]} encontrar o Temari dentro do tempo de uma canção de Temari, então {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]} ganhará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760107,
					"content": "É assim que Temari é jogado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "O que é isso? Uma grande aventureira me ensinou. E ela disse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760109,
					"content": "\"Kujirai, lembre-se. Você deve dizer: 'Se você ganhar, você conseguirá coisas boas.'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760110,
					"content": "#Por isso, {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}, se você ganhar, pode obter uma coisa boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760111,
					"content": "#Sim, é uma coisa boa, {NICKNAME}. Paimon acha que é justo brincar com crianças!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Mas eu ainda acho que Temari não é jogado assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Pode ser um jogo que só as pessoas locais conhecem, não vamos nos importar com tais detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Você é o Garoto Kujirai, certo? Vamos brincar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Que legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760115,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217602",
							"2"
						],
						"stepId": 7217602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garoto Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Eh, é muito difícil para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760203,
					"content": "Isso é porque Paimon estava apenas aquecendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}, vocês querem tentar novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760205,
					"content": "#É claro! {NICKNAME}, precisamos mostrar ao Garoto Kujirai o quão {M#bons}{F#boas} somos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "Mais uma vez!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Ótimo! O objetivo é encontrar o Temari dentro do limite de tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garoto Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garoto Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]} é incrível, você encontrou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Hehe! {NICKNAME} é {M#um}{F#uma} viajante experiente que já esteve em muitas nações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Uau! Você também já esteve em Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760705,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Isso é tão legal! Ouvi daquela Grande Aventureira que há muitos lugares bonitos em Mondstadt, como a Toca da Tempestade do Terror com torres super altas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760707,
					"content": "É a Toca de Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Yeap, será que essa torre é mais alta, ou Tenshuu da Toda-Poderosa Shogun é mais alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760710,
					"content": "Garoto Kujirai, por que você está aqui sozinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Porque quando minha irmã estava pescando, ela pensou que eu iria assustar os peixes, então ela me pediu para sair para brincar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760712,
					"content": "Uma vez, conheci aquela Grande Aventureira. Ela viu que eu estava entediado, então me deu muito Temari, e me disse para \"encontrar viajantes gananciosos para brincar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760713,
					"content": "Viajantes gananciosos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "#Não somos ganancios{M#os}{F#as}, estamos muito preocupad{M#os}{F#as}! Paimon está preocupada se o Garoto Kujirai está entediado ao brincar sozinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "#Sim, eu também acho que {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]} tem bom coração. Estou muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760716,
					"content": "Sozinho na natureza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Você está brincando sozinho na natureza, não tem medo de encontrar algo perigoso? E você até tem \"coisas boas\" em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}, você é gentil. Mas não se preocupe, aquela Aventureira me ensinou um truque especial para transformar Temari em uma bomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760719,
					"content": "Que perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Não é nada perigoso! Eu derrotei um montão, desde Hilichurls, até Slimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760721,
					"content": "Você que é um perigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "#Ah, sim! {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}, se você quiser jogar Temari com outros amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760723,
					"content": "Vou deixar aqui um Temari! Aqui estão as regras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760724,
					"content": "Quando você esconde um Temari, você tem que escondê-lo dentro do tempo de uma canção Temari. A pessoa que está procurando por ela também terá que encontrá-lo dentro do tempo de uma canção. Isso tornará as coisas justas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760725,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "Só de pensar que estamos realmente brincando com bombas, a Paimon está bem assustada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}, não tenha medo. Ela me falou que as bombas apenas atingem pessoas más, provavelmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760728,
					"content": "Será?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "#Então, vou para outro lado brincar! Adeus, {PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garoto Kujirai"
				},
				{
					"id": 721760708,
					"content": "É mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}