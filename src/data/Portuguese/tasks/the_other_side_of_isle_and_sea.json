			},
			"dialogs": [
				{
					"id": 790040101,
					"content": "Hmm? Olha, há algum tipo de... desenho nesta pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040102
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 790040102,
					"content": "Parece um navio com muitas pessoas... Enfrentando perigos nos mares... E depois tem muitas pessoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040103
					],
					"speakerTitle": "Observar"
				},
				{
					"id": 790040103,
					"content": "Paimon não consegue ler muito bem... De qualquer forma, vamos tomar nota deste mural primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Observar"
				}
			]
		},
		{
			"id": 7900402,
