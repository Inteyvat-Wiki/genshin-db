			},
			"dialogs": [
				{
					"id": 790041201,
					"content": "#Olá, amig{M#o}{F#a}. Posso fazer alguma coisa por você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041202,
					"content": "Você é um pesquisador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790041203,
					"content": "Haha, suponho que sim. A princípio, sou um \"estudioso ambulante\", mas acho que seja o mesmo que um \"pesquisador\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041204,
					"content": "Enfim. Você encontrou um problema que precisa da ajuda de um \"pesquisador\" para ser resolvido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041205,
					"content": "Bem, foi isto que aconteceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "Ilhas no mar... E você encontrou murais nelas. Que fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041207,
					"content": "#Então você está procurando um pesquisador que possa ajudá-l{M#o}{F#a} a decifrar esses murais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041208,
					"content": "Pode nos ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "Claro, nunca rejeitei uma oportunidade de estudar o desconhecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041213,
					"content": "Bem, não vamos perder tempo. Posso dar uma olhada nesses murais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041214,
					"content": "Aqui estão os que registramos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "Oh, nada mal, nada mal mesmo. Preciso de um tempo para pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041210,
					"content": "Podemos pagar a você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "#Hahaha. Ao que parece, vocês devem ser {F#Aventureiras}{M#Aventureiros} muito experientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 790041212,
					"content": "No entanto, eu diria que essas histórias secretas são meu maior pagamento. Não precisam me dar mais nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "Sayid"
				}
			]
		},
