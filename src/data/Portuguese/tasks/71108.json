		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "\"...Praticando a técnica Perfurador da Luz. Destruí todos os bonecos por engano... Nenhum dinheiro ou recursos... Tenho uma ideia. Vou amarrar palhas para fazer a minha própria...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080302,
					"content": "\"Reunir palha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080303,
					"content": "\"Amarrar palha. Exaustivo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080304,
					"content": "\"...Praticando a técnica Perfurador da Luz. Destruí todos os bonecos por engano... É melhor treinar com a espada primeiro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080305,
					"content": "Continuar lendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "\"...Entendiado. Conforme sentava no pátio, me senti levemente faminto... Considerei o que vi no outro dia, e de repente me senti iluminado. Se eu usar a espada... (ilegível) Vou chamar de Corta Chuva. Vou tentar outro dia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080308,
					"content": "\"...Eu caí acidentalmente enquanto praticava o Corta Chuva. Felizmente, não é nada sério... Pensei em uma ideia. Por que não cavar um poço profundo sob as pulhas? Não só previne feridas de quedas, como posso criar peixes para comida...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080309,
					"content": "\"...Eu fui até um pescador e comprei dúzias de peixes... Tentei cozinhá-los. Aquela delícia era incomparável...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080310,
					"content": "(As próximas dez páginas são dedicadas a registros detalhados de modos de preparo para peixes e alguns até têm ilustrações para acompanhar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080311,
					"content": "\"...Acidentalmente caí enquanto praticava o Corta Chuva.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080312,
					"content": "\"...Sucesso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080313,
					"content": "Continuar lendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "\"...A lança e a espada devem ser empunhadas com o mesmo domínio de... (Indiscernível. Há um comentário do 3º Mestre ao lado: segunda natureza.)... E essa é a verdade... Mesmo assim não há nada... Como será concedida? Como será revelada?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080316,
					"content": "\"...Renovar a biblioteca. Design... dentro e...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080317,
					"content": "...Olhe com os <color=#00E1FFFF>olhos</color> e combine <color=#00E1FFFF>pergaminhos de conhecimento de todos os lugares</color> com <color=#00E1FFFF>câmaras de todos os cantos</color>, então...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080318,
					"content": "(As próximas páginas estão borradas e ilegíveis. Tem um comentário do 3º Mestre no canto: Isso aconselha gerações futuras a ler extensamente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080319,
					"content": "Continuar lendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "\"...Recuperado do ferimento. Bai Xiaosan visitou com carneiro e peixe. Gordo, delicioso e sem qualquer mau cheiro. Perguntei pela receita... Transmiti a técnica Fim à Vida... Registrado aqui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080322,
					"content": "(As páginas seguintes contêm vários registros detalhados de modos de preparo de carneiro.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Notas de Guhua\""
				},
				{
					"id": 711080320,
					"content": "Já foi suficiente. Que bagunça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "Já foi bastante. O processo de treinamento não está nada registrado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "#Já estou fart{M#o}{F#a} dessa besteira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
