			"dialogs": [
				{
					"id": 760320201,
					"content": "Ei, você sabe o que acontece com quem mete o nariz onde não foi chamado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Oprichniki Fatui"
				},
				{
					"id": 760320202,
					"content": "...Acho que estou para descobrir! Veja, isso aqui é tudo novo para mim. Ainda estou aprendendo tudo. Que tal me dar mais uma chance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Pessoa Suspeita"
				},
				{
					"id": 760320203,
					"content": "Me dê só mais uma chance, eu prometo que você não vai me pegar na próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Pessoa Suspeita"
				},
				{
					"id": 760320204,
					"content": "Você bateu a cabeça? Não vamos deixar nenhum de vocês <color=#00E1FFFF>ratos ladrões</color> escaparem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Oprichniki Fatui"
				},
				{
					"id": 760320205,
					"content": "Escute, aquela garota provavelmente já saiu correndo com tudo a essa altura. Vocês têm mesmo o tempo para ficarem aí de pé discutindo com gente tipo eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Pessoa Suspeita"
				},
				{
					"id": 760320206,
					"content": "Você não precisa se preocupar com ela. Vamos, você vem conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oprichniki Fatui"
				}
			]
