					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "Mas como fazer uma Lanterna Celeste... Irmã, você sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430102,
					"content": "Não sei... Se houvesse alguma que pudesse nos ajudar a fazer uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430103,
					"content": "Vocês também querem soltar uma Lanterna Celeste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "#Ah, é {F#a}{M#o} Viajante. Estou muito curiosa para soltar uma Lanterna Celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430105,
					"content": "Originalmente nós planejávamos provar os lanches tradicionais do Ritual de Lanternas, mas Geri disse que ele queria soltar uma Lanterna Celeste primeiro para sentir como é a atmosfera do Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430106,
					"content": "Bem, é assim: primeiro se deve entrar na atmosfera do festival, e depois se deve provar suas comidas. Somente assim é possível sentir realmente como ele é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430107,
					"content": "E nós ouvimos que quando soltar uma Lanterna Celeste, pode se fazer um desejo... Mas nós não sabemos como fazer uma lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430108,
					"content": "Viajante, você poderia nos ajudar a fazer uma Lanterna Celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430109,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Muito obrigada. Vamos ficar aqui esperando você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
