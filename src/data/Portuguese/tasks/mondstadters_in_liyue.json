				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "Obrigada. Em seguida devemos escrever nosso desejo na Lanterna Celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430302,
					"content": "Entendo... Deixe-me pensar o que escrever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430303,
					"content": "Isso deve bastar. Vamos deixar a Lanterna Celeste levar o desejo para bem alto no céu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430304,
					"content": "Quando estávamos em Mondstadt, também falávamos nossas emoções para os Dandelions ouvirem, e depois espalhávamos as sementes de Dandelion para que o vento as levasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430305,
					"content": "Agora que falei isso, sinto falta de Mondstadt. Faz muito tempo que não vejo um Dandelion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430306,
					"content": "Viajante, você poderia nos ajudar novamente e trazer algumas Sementes de Dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430307,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Maravilhoso, obrigada. Traga-as para mim assim que as encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
