					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "Obrigado. Apesar de ter saído de Mondstadt há pouco tempo, eu já quero retornar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430502,
					"content": "Eu também não sei como está minha família por lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430503,
					"content": "Devemos aproveitar esta chance. Irmã, você tem algum desejo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430504,
					"content": "Eu? Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430505,
					"content": "Acho que isso deve bastar. Viajante, ainda tenho algo mais a lhe pedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430506,
					"content": "As Sementes de Dandelion devem ser espalhadas em um local alto, mas as construções de Liyue são bem diferentes que as de Mondstadt... Ainda pior, eu e o Geri não fazemos ideia como subir até um ponto alto de Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430507,
					"content": "Você poderia nos ajudar a espalhar essas sementes em um lugar alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430508,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
