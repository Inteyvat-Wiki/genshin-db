			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "Olá Viajante. Você já espalhou as sementes de Dandelion?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430702,
					"content": "Já.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "Ótimo. Espero que aqueles Dandelions sejam levados pelo vento de volta para Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430704,
					"content": "Você diz que quer se integrar em Liyue, mas você não esquece os costumes de Mondstadt. Por que não procuramos uns petiscos de Mondstadt para comer hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430709,
					"content": "Não, isso simplesmente não serve de nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430710,
					"content": "Hã...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430705,
					"content": "Uma coisa é não esquecer os costumes de Mondstadt e outra coisa é se integrar em Liyue. Vamos lançar as Lanternas Celestes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430706,
					"content": "Você escreveu seu desejo? Depois de soltarmos a Lanterna Celeste vamos provar os lanches tradicionais do Ritual de Lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430707,
					"content": "Escrevi sim, mas... Quer comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430708,
					"content": "Não se pode perder de jeito nenhum a chance de comer os lanches tradicionais do Ritual de Lanternas de Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		}
	]
