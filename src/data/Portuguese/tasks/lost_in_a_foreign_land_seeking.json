				"points": []
			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "Eu preciso descansar, minhas feridas ainda doem... Me desculpem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580602,
					"content": "Se precisar, venha me procurar outro dia... Eu tenho algo a lhe pedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "Vocês chegaram! Por favor, sentem, fiquem à vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590102,
					"content": "Me desculpem. Eu acabei mandando vocês embora apressadamente da última vez, e não disse com o que queria que vocês me ajudassem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590103,
					"content": "Não tem problema, pode falar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "Mas relaxem, eu não quero que vocês façam nada ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590108,
					"content": "Então pode falar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "A questão é a seguinte... Eu e meu Kolya... Nikolay, um membro de minha equipe... Nós nos separamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590114,
					"content": "Por isso, eu queria lhes pedir para procurarem pelas pistas que ele deixou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590115,
					"content": "Se ele ainda estiver vivo, traga-o até mim. Se ele já faleceu... Eu gostaria de saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590116,
					"content": "Peço sinceras desculpas por lhes pedir isso... Mas espero que vocês possam considerar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590117,
					"content": "Então é isso que você quer? E Paimon aqui pensando que você queria que fizéssemos algo ruim! Tipo... Tipo... Sabotar os Millelith...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590118,
					"content": "Os Millelith? Por quê? Ter eles como inimigos dos Fatui não tem nenhum benefício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590119,
					"content": "O que você quer dizer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "Eu ainda tenho uma pergunta para lhes fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590121,
					"content": "Espere... Eu entendi... Nosso pessoal no local teve um problema com o povo de Liyue? Bem, isso deve explicar porque nossa linha de suprimentos foi cortada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590122,
					"content": "Droga... O que raios aconteceu na superfície...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590123,
					"content": "É uma longa história...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "Hunf... Bem, vamos falar disso depois. Guerra é assim mesmo... Seus aliados e inimigos mudam do dia para a noite, essa é a realidade que os Fatui vivem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590126,
					"content": "Mas agora eu... Pelo menos por enquanto, só estou preocupada com Kolya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590127,
					"content": "Quando nós batemos em retirada, ele acabou se separando de sua equipe... Eu depois voltei para procurá-lo, e como resultado também acabei me separando deles... *Suspiro* É patético...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590128,
					"content": "E quanto ao último lugar que ele estava antes de desaparecer, posso marcar no seu mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590129,
					"content": "Foi aqui que nós nos separamos. Ele queria atrair os inimigos que estavam nos perseguindo... Ele é um excelente soldado, sei que ele não morreria ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590130,
					"content": "Espero que ele tenha deixado pistas para trás... Desejo que esse seja o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590124,
					"content": "Foi um incidente que vocês fizeram...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "Você com certeza não deixará que nós atrapalhemos os planos dos Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "Isso mesmo. Se a coisa boa que iremos fazer atrapalharem seus planos maus, nem tente nos deter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590111,
					"content": "Do que vocês estão falando? Coisa boa? Coisa má...? Eu deter vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590112,
					"content": "*Suspiro* Vocês são uma dor de cabeça. Deixem-me terminar de falar primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590104,
					"content": "Não tem problema, nós ainda não aceitamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "Sim, você é uma Fatui! Se o que você está querendo é que façamos alguma coisa ruim, nós recusaremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590106,
					"content": "Pff... Bem, você tem razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105902,
			"completionStepIds": [
				7105902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
