						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7105909",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "Você voltaram. O que descobriram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590402,
					"content": "Se não descobriram nada, não tem problema. Descansem um pouco se quiserem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590403,
					"content": "Não se preocupem se eu estou preocupada... De qualquer forma, eu estou fazendo planos para ficar aqui e me aposentar. Talvez eu até mesmo lhe peça para lidar com o meu registro de pensão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590404,
					"content": "Uau, você é realmente preguiçosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590405,
					"content": "Hunf, se vocês não descobrem nada, não me resta nada a não ser ficar aqui criando raízes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "Hã? Isso aqui foi o que foi deixado para trás por aquele Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590601,
					"content": "Hã... Não há sinal de ninguém, o que devemos dizer para Katya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590602,
					"content": "Hmm, não tem jeito. Vamos voltar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "Isso daqui... Insígnia de um sargento, um diário de operações e... Anotações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591306,
					"content": "Por favor, digam-me, onde está Kolya? Ele ainda está vivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591307,
					"content": "Não encontramos ele, mas é possível que esteja vivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "#Kolya nunca me abandonaria. Vocês podem ficar tranquil{F#as}{M#os}. Eu sei que ele não desertaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591310,
					"content": "Onde vocês encontraram essas coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591311,
					"content": "É uma caverna no sudeste. Eu marcarei para você no mapa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "É um lugar muito sinistro, há muitos monstros estranhos nele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591313,
					"content": "Obrigada... Obrigada... E me desculpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591314,
					"content": "Eu prefiro pensar que Kolya se sacrificou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591315,
					"content": "Kolya, não permita que a Tsaritsa seja desonrada, não me faça ser humilhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591316,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "*Cof* *Cof* Eu estou bem... Me desculpem! Acabei deixando o ambiente tenso... Oh, acabei de lembrar, eu ainda não tive uma oportunidade para lhes agradecer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591318,
					"content": "Oh, sim, a água de fogo... Ah, vocês não bebem, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591319,
					"content": "Eu ainda tenho um pouco de Mora... E também algumas mercadorias que consegui antes. De qualquer forma, nada disso serve para mim, podem ficar com elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591320,
					"content": "O que você planeja fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "Agora? Obrigada por se preocupar, mas eu não preciso de sua ajuda com nada \"ruim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591323,
					"content": "Bem, talvez eu vá procurar por Kolya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591324,
					"content": "Antes de termos sido realocados, ele me escreveu uma carta. Eu tenho ela aqui comigo. Para mim ela é a única prova restante de sua existência. Eu a levarei comigo para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591325,
					"content": "Se ele ainda está vivo... Como um Fatuus leal à Tsaritsa, eu encontrarei esse traidor e o matarei, não importa onde ele vá ou se esconda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591326,
					"content": "Se ele está morto... Como sua irmã mais velha, eu aceitarei o destino inevitável de todo Fatui e terei orgulho dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591327,
					"content": "Quando nós dizemos \"Se não for eu, quem?\", queremos dizer que não hesitaremos em dar nossas vidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591328,
					"content": "E se você estiver fazendo algo mal e eu tenho que lhes parar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "... Todos nós temos horas que não temos escolhas, e também coisas que não podemos deixar de fazer, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591333,
					"content": "#Bem... Você está sendo muito séri{F#a}{M#o}. Jovens que ainda não tem idade para beber tem preocupações muito estranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591334,
					"content": "Vamos ver. Vamos esperar até o momento em que eu não terei mais escolhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591335,
					"content": "Entretanto, agora eu preciso descansar... Descanse também, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591336,
					"content": "Mas tem só uma esteira de palha aqui! Como que vamos dormir?! Você só quer se livrar da gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591337,
					"content": "Hahahaha! Isso é problema de vocês... Que pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591338,
					"content": "Mas, não importa, estou muito grata pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591330,
					"content": "Você realmente tem que fazer as coisas do jeito de um Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Hã? Sim, você acha isso estranho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591332,
					"content": "Ideias e perspectivas são todos problemas muito chatos... Pff, não há apenas ideias sob minha máscara, eu também tenho medo de balas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591321,
					"content": "Ainda precisa de minha ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "Talvez ele tenha fugido por uma passagem secreta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "\"...Eu consegui entrar nessa câmara oculta. Monstros mecânicos gigantes ainda estão rondando do lado de fora como predadores ferozes, esperando eu sair...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Anotações do Cabo Nikolay"
				},
				{
					"id": 710591402,
					"content": "\"... Minha perna esquerda está muito ferida e dói demais. Eu a enfaixei de qualquer jeito, mas está inchada. Talvez esteja com uma infecção...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Anotações do Cabo Nikolay"
				},
				{
					"id": 710591403,
					"content": "\"... A caverna tem outra saída, mas não sei para onde ela leva. A saída parece frágil. Sem algo para apoiá-la, colapsará caso atingida por alguma força violenta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Anotações do Cabo Nikolay"
				},
				{
					"id": 710591404,
					"content": "\"... Eu fui descoberto, tem alguém vindo. É... Um espadachim? Vestido de negro...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Anotações do Cabo Nikolay"
				},
				{
					"id": 710591405,
					"content": "\"... Ele, não, isso? Isso parece imparável, até mesmo pela cerca de metal. Só de olhar para isso, eu já sei...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Anotações do Cabo Nikolay"
				},
				{
					"id": 710591406,
					"content": "\"... Me desculpe, Katya...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anotações do Cabo Nikolay"
				}
			]
		}
	]
}