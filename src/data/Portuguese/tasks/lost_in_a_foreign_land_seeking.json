			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "\"... Que azar, a balalaica de Katia está quebrada. Não sei como acabei danificando-a enquanto me movia apressadamente. Tenho que repará-la antes que ela fique reclamando...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				},
				{
					"id": 710590202,
					"content": "\"... Nossos ancestrais de quinhentos anos atrás lutaram assim contra a calamidade? O capitão disse que de todas batalhas ferozes de nossos ancestrais, nós sabemos apenas uma fração...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				},
				{
					"id": 710590203,
					"content": "(Muitas páginas no meio estão manchadas por alguma substância escura. Quando você a limpa, a tinta da escrita também está totalmente ilegível).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				},
				{
					"id": 710590204,
					"content": "\"... Eu não posso mais ficar aqui. Eles poderão me encontrar através dessa lama negra...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				},
				{
					"id": 710590205,
					"content": "\"... Em seguida, continuarei indo na direção oposta para os atrair para ainda mais longe de onde a equipe está...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				},
				{
					"id": 710590206,
					"content": "\"... Há uma caverna perto da ruína da fortaleza no sudeste, talvez eu possa seguir por esse caminho...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				},
				{
					"id": 710590207,
					"content": "\"...Me deseje sorte. Se não for eu, quem!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Página do Diário do Cabo Nikolay"
				}
			]
		},
		{
			"id": 7105903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
