			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "#Ei! Amig{M#o}{F#a}! Tenho umas coisinhas bem legais por aqui, preços ótimos também! Quer dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Hã? Isso não são bonequinhos de Koholassauros? Paimon já viu eles no Mercado da Brisa Tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Isso mesmo! Mas o meu é mais barato, apenas metade do preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Por que são tão baratos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "#Heh, {M#amigão}{F#amiga}, não se preocupe com isso. Tenho meus métodos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Podem ser mais baratos, mas as cores parecem meio estranhas... Isso não são imitações, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Imitações!? Tsc, e o que você sabe, hein, sua burrinha. Saia daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Saiam, saiam! Não vou mais vender a vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
		{
