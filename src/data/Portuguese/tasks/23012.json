			"dialogs": [
				{
					"id": 230121101,
					"content": "Bem, eu já falei com gatos antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Você está falando da Neko? Mas a Neko é uma gata que sabe falar a linguagem humana, então não conta como falar com gatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "De fato. Ainda assim, em troca, você precisará me ajudar a encontrar um gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Então, vocês concordaram? Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Ahem... Então escutem com atenção. Este é o esboço da Língua Felina em que venho trabalhando há muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Tem uma forma diferente de procurar gatos em cada cidade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Haha, é verdade! Pensando assim, parece que já ajudamos pessoas a procurarem por gatos em muitas cidades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Não sei se devemos dizer que todos gostam de gatinhos, ou que... Todos que têm um gato têm os mesmos problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
