			"dialogs": [
				{
					"id": 230120301,
					"content": "Ah, vocês trouxeram meu gatinho de volta! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Parece que vocês aprenderam a Linguagem Felina muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Aqui está a sua recompensa, fique com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "É difícil encontrar pessoas que aprendam a Linguagem Felina tão rápido assim, talvez eu ainda te procure para me ajudar na próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Miau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Pode falar linguagem humana! A Srta. Sareh não é um gato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Eu posso ver em seu rosto que você estava tentando dizer \"o prazer é meu\", mas sua pronúncia ainda tem espaço para melhorias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "#Mas não tem problema, vou te ensinar mais da linguagem Felina no futuro. Vamos aprender junt{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
