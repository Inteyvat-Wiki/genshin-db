			"dialogs": [
				{
					"id": 230120101,
					"content": "Miau—— *Tosse*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "Estou procurando pelos meus gatos, normalmente eles me respondem quando eu chamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120104,
					"content": "Será que a pronúncia de hoje está errada? Chamei tantas vezes e não tive nenhuma resposta, que estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120105,
					"content": "Por que você não os chama diretamente pelo nome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "Verdade, normalmente quando procuram por um gato, chamam eles pelo nome, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120107,
					"content": "Mas se você chamá-los no nosso idioma, eles conseguem entender, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120108,
					"content": "Hmm, parece que ela tem razão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120113,
					"content": "Mas continuar miando por aí também não me parece um grande plano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120114,
					"content": "Viajante, eu queria te fazer uma pergunta muito séria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120115,
					"content": "Deixa comigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "...Você quer aprender a \"Linguagem Felina\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120118,
					"content": "Como é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "Quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120120,
					"content": "Quer dizer que vai nos ensinar a falar com gatos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120116,
					"content": "A recompensa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "O que você quis dizer com \"a pronúncia de hoje não está certa\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "Bem, eu estava chamando pelos seus nomes, na verdade. Só que eu usei a linguagem dos gatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120111,
					"content": "Afinal, eles não necessariamente entenderiam se os chamássemos em nossa língua, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120112,
					"content": "Hmm, parece que ela tem razão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
