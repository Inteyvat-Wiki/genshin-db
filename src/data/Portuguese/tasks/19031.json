				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "#É perigoso andar sozinh{M#o}{F#a} por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102102,
					"content": "Não se sabe quem... ou o que se pode encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "#Hmm, você parece estar bem calm{M#o}{F#a}. Há um ditado que diz: \"Quem caminha ao longo do rio fica com os sapatos molhados\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102106,
					"content": "Em um lugar tão estranho e assustador como este, você pode encontrar algo que não deveria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102107,
					"content": "E o que encontrar aqui pode se tornar um pesadelo que assombrará você pelo resto de sua vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102108,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "#Hã? Como pode estar tão calm{M#o}{F#a}? As pessoas geralmente fogem com medo antes mesmo que eu possa terminar uma frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102111,
					"content": "Você parece uma pessoa comum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Sim, mas a melhor forma de interpretar um fantasma é criar uma atmosfera assustadora que amedronte as pessoas psicologicamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102113,
					"content": "Nesse caso, minha aparência é irrelevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102117,
					"content": "Além do mais, nunca vou conseguir assustar alguém como você, que não acredita em fantasmas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102118,
					"content": "Parece que você está apenas enrolando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "Ei, isso não é verdade! Oh, é melhor eu procurar alguns covardes para assustar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102120,
					"content": "Você deve voltar e encontrar seu companheiro. Ele deve estar apavorado a essa altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102114,
					"content": "Você não tem uma fantasia ou algo parecido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Sim, tenho uma, mas é quente demais por dentro... e, além disso, a melhor forma de fingir um fantasma é criar uma atmosfera assustadora que amedronte as pessoas psicologicamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102116,
					"content": "Nesse caso, minha aparência é irrelevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fusaner"
				},
				{
					"id": 1903102109,
					"content": "Desculpe, não entendi... O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
