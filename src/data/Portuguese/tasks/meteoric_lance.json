					"nextDialogs": [
						740742104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742104,
					"content": "Quem será que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742105
					]
				},
				{
					"id": 740742105,
					"content": "É o Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742106,
					"content": "Tivemos um conflito uma vez em Elynas. Para ser mais específico, aconteceu recentemente em Elynas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742107,
					"content": "Quando eu vi aquela vítima trágica no portão, sabia que tinha sido trabalho dele. Parece que ele continua ativo, no fim das contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742108,
					"content": "Então, o que ele quer fazer com as coisas daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742109,
					"content": "É simples. Ele também quer reforjar a Espada Sagrada da Cruz de Narcissus, porque o trabalho da Cruz de Narcissus ainda não terminou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742110,
					"content": "Enfim, devemos seguir até a área final agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
