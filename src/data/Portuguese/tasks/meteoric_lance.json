			"dialogs": [
				{
					"id": 740741901,
					"content": "Você inspeciona cuidadosamente o topo do Mecanismo, mas não encontra nada.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "Então, no final, não há nada aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741903,
					"content": "Parece que algo foi feito aqui, mas parece que outra pessoa levou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741904,
					"content": "Espera, isso não quer dizer que nosso plano já falhou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741905,
					"content": "O nascimento da \"razão\" requer a união de quatro quadrantes. Se conseguirmos o resto deles, ainda temos uma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741906,
					"content": "Nesse caso, é melhor ir logo à próxima área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
