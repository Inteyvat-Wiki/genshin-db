				{
					"id": 740742102,
					"content": "Alguém... pegou o que fosse que estivesse aqui também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742103,
					"content": "Realmente parece o caso.",
