			"dialogs": [
				{
					"id": 740740101,
					"content": "...Você não deveria estar mais preocupado com a pessoa deitada no chão em seu campo de visão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Hã? Ah! O que aconteceu...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Minhas desculpas, senhorita. Eu priorizei a busca pela Placa de Pedra. Permita-me escanear agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "...Minhas desculpas, senhorita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "O quê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Embora ele ainda esteja vivo, o sopro da vida escapou seu corpo através de seus orifícios. Já vi esse método antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "Ahhh! Paimon não consegue olhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Vamos procurar alguém para ajudar! Não podemos simplesmente deixar ele deste jeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Juntos, vocês levam o homem inconsciente até o Porto Lumidouce.\\nAs pessoas por lá o levam imediatamente para receber cuidados médicos.\\nSabendo que ele está em boas mãos, vocês retornam para onde estavam.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Certo, vamos dar uma olhada na Placa de Pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "\"Contemplem, este lugar é o Quadrante dos Desejos, o Salão dos Desejos, a Sala dos Desejos...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "\"Normalmente contraditório\"... \"Nascido em um instante, sua companhia em descanso eterno, nunca separado\"... \"Os frutos maculados do pecado\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Mais uma charada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "Por que fazer algo tão assustador aqui... será que tem algo a ver com a resposta para a charada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Pois os habitantes de Fontaine são \"pecadores\", a vida manchada com o pecado original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "Por esse motivo, a resposta é \"vida\". Eu já tinha adivinhado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "Você tem certeza de que essa é a resposta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Eu conheço muito bem a retórica e a semiótica da Ordem da Cruz de Narcissus. A menos que existam surpresas, essa é a resposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Certo, hora de compensar o tempo perdido. Temos que nos apressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
