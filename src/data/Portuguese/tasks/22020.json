				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "Viajante, você por aqui! Parece que a diretora estava certa quando disse que voltaríamos a nos encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "São ordens da diretora, para digamos que encerrar o último caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Bom, na verdade estou indo levar uns doces para os guardas da patrulha, para agradecer pela ajuda deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Eles que deveriam agradecer a gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "Realmente, mas isso na verdade também é só uma desculpa para levarmos uns presentes e nos aproximarmos dos guardas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Afinal, a Agência de Detetives pode acabar precisando da ajuda deles futuramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "São ordens da Sango, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Haha, sim, sua intuição nunca falha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "Mas o que você acha sobre isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Eu? Bom, já trabalhei antes com o Amano e o Andou, acho que não tem nada demais levar uns doces para uns velhos amigos, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Mas... A diretora me passou uma outra tarefa também, preciso investigar algo, e estou achando que não vai dar tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "Viajante, tem como você me ajudar a entregar esses doces para os guardas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "Pode deixar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Muito obrigado pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "Tenho aqui três porções de doces, um para o Amano, um para o Andou e outro para o Owada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "Owada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "Ele... trabalhava antes comigo. Antes de eu ter saído da Comissão, ele cuidava bastante de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Ele nos ajudou também no caso de roubo em série.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "Obrigado, Viajante! Te encontro aqui de novo então depois que você entregar os doces.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Acho melhor você ir pessoalmente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "É que... A outra tarefa que a diretora me passou, é um pouco mais urgente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Mais tarde eu vejo quando que consigo ir visitar os três.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "Isso soa exatamente como uma razão que a Sango daria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "Não fomos nós que ajudamos eles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
			"id": 2202002,
			"completionStepIds": [
				2202002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
