				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "Muito obrigado, Viajante! Conseguiu entregar os presentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "A Sango que te ordenou a pedir ajuda pra mim né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Vo-você... Descobriu? Sinto muito... Foi realmente ordens da diretora pedir para que você entregue o presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "A Chefe me disse que você seria imprescindível para encerrar meu caso e encontrar o suspeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Esse caso ainda não foi resolvido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Não. A chefe me disse que tudo o que aquele criminoso tinha era muito perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Após ter iniciado a sua investigação, todas as provas ou pistas apareceram com muita facilidade, e todas elas indicaram que ele era o criminoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "Apesar da Comissão ter o julgado como criminoso, a Chefe não parou de achar que o criminoso seria uma outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Então acho que a razão pela qual ela me contratou para trabalhar na comissão é para encontrar algumas pistas para encerrar o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Mas... não faço ideia de que eu posso fazer para ajudá-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Eu nunca consegui adivinhar o que ela está pensando. Uma vez, ela me contou que a sua mente tornou cada vez mais pequena por ter ficado em Inazuma o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Se ela conseguisse encontrar uma pessoa com sabedoria, mas sem preocupações, talvez fosse possível avançar o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "Viajante, talvez a Chefe ache que você é a pessoa certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "#Também posso ser {F#uma}{M#um} detetive?Também posso ser {F#uma}{M#um} detetive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "Claro, se você quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "De qualquer forma, você ajudou bastante! Tome isto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Tudo isto também foi a Sango que te ensinou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "Não! É o que tem no meu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "#Muito obrigado pela sua ajuda. Se você quiser, será sempre bem-vind{M#o}{F#a}. Volte sempre, e poderemos dar uma volta ao redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Será bem pago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Hehe, eu não tenho certeza. Mas vai ser uma recompensa generosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "E este caso é o Crime Perfeito que a Sango tem comentado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "Sim. A chefe me disse que tudo o que aquele criminoso tinha era muito perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Após ter iniciado a sua investigação, todas as provas ou pistas apareceram com muita facilidade, e todas elas indicaram que ele era o criminoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "Apesar da Comissão ter o julgado como criminoso, a Chefe não parou de achar que o criminoso seria uma outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Você poderia ter me falado antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
