			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Owada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Uhh... Olha se aqui não é perfeito? Eu venho sempre aqui tomar um ar fresco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "Nada melhor do que uma linda paisagem e ar puro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Se quiser perguntar algo, agora é o momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Você também já trabalhou com o Ryuuji antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "Foi o Ryuuji que te contou sobre isso? Sim, nós realmente já trabalhamos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "Não sei se o Ryuji já comentou com você sobre o que aconteceu naquela época, se você já sabe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "Mas resumindo, do jeito impulsivo que o Ryuuji era, ele acabou caindo em uma armadilha e se tornou o bode expiatório de um crime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "E mesmo me tendo como testemunha, o juiz responsável pelo caso continuou considerando ele como culpado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Apesar de eu ter pedido ajuda para várias pessoas, para que elas investigassem o caso, mas sempre no final, ou a pessoa não descobria nada, ou me falava para largar mão do caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "*Suspiro* E eu naquela época... Como posso dizer? Aceitei e larguei de fato a mão do caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "E como isso é um \"segredo\" que todos sabem, assim como o caso em que o Ryuuji foi injustiçado, tudo bem contar pra você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Mas se todos sabem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "É por isso mesmo, como todos sabem que \"todo mundo sabe\", as pessoas começaram a ficar com medo de se envolver com o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Mas ainda bem que uma detetive que \"não sabia de nada\" veio resolver umas coisas na Comissão e acabou se interessando pelo caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "Graças a essa detetive, a verdade foi descoberta e Ryuji foi também libertado da culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Mas depois disso, Ryuuji saiu da Comissão, começou a trabalhar para essa detetive e fim de história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Por que você está me contando sobre isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Quem que te pediu para trazer esses doces para a Comissão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Mas o Ryuuji provavelmente teria recebido \"ordens da diretora\", né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Do jeito que o Ryuuji é, se a Sango tivesse pedido para ele entregar os presentes pessoalmente, ele teria feito isso mesmo se tivesse que passar por um mar de chamas e ainda traria os presentes sem um dano sequer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Se o Ryuuji te pediu ajuda para entregar os presentes, então certeza que foi a Sango que ordenou ele a fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Então a Sango queria que eu soubesse de tudo isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "Hahaha, nada mau! Só o fato de você estar aqui já é como se a Sango estivesse me falando: \"encontrei alguém para me ajudar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "Parece que ela ainda não largou mão do que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Mas faz sentido, já que até agora ela ainda não encontrou a verdadeira pessoa que fez aquela armadilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Bom, já te contei tudo o que eu podia. Agora fica a seu critério embarcar ou não nesse \"barco\" da Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Ah é, não se esqueça de agradecer o Ryuuji pelas Sakura Mochis por mim, eu sempre gostei muito desse doce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Por que o Ryuuji saiu da Comissão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "Acredito que tenha sido uma escolha pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
