							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "...Como o tempo voa. Minhas queimaduras estão quase saradas agora, então devo estar pronto para retomar a cozinha amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 401490102,
					"content": "#Você realmente se excedeu nesses últimos dias, {NICKNAME}. Hoje é o último, espero que tudo ocorra sem nenhum incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 401490103,
					"content": "Ugh, por que Paimon sente que você acabou de condenar a gente de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "O dia passa sem incidentes...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "Ufa, conseguimos chegar até a noite! Acabou sendo bem tranquilo o dia todo, no fim das contas. Talvez seja porque a gente já tá experiente em trabalhar aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Percorremos um longo caminho desde nosso primeiro dia de serviço, né? Na época, a gente tinha dificuldade de lembrar quem pediu o quê... Mas tudo é mamão com açúcar agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Não se precipite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "É, mas quem viria tão tarde da noite? Ah... Na verdade, agora que Paimon pensa nisso, Lyney e os irmãos dele vieram mais ou menos essa hora no primeiro dia, não foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}? Paimon? Que prazer encontrar vocês aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber? Eula e Mika também! Vocês tão aqui para jantar? Por que vieram tão tarde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Acabamos de concluir uma missão de escolta para uma caravana de comércio. O plano original era fazer acontecer com algumas rações essa noite e continuar nossa jornada ao norte em direção ao Portal de Pedra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Mas a Capitã Eula mencionou o fato de nenhum de nós já ter experimentado da gastronomia de Liyue. Pensamos que a gente podia logo passar pelo albergue e ver se ainda podemos pedir alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Ooh, então Eula tá pagando, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "...Ahem! Temos comido as mesmas rações a viagem inteira, então eu simplesmente pensei que já era hora de termos uma refeição de verdade. Tem algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Sejam bem-vindos ao Albergue Wangshu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "Boa pergunta, o que eu deveria pedir... Hã? Espera um segundo, por que você tá pegando nosso pedido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME} tá substituindo o chef daqui! Vocês chegaram bem na hora, vão ser os últimos clientes a desfrutar da comida del{M#e}{F#a} antes do chef original tomar as rédeas de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Uau, sério? Ainda bem que Eula sugeriu que a gente viesse aqui! Eu não ia querer perder isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Então, o que a gente devia pedir? Hmm... Não sou tão familiar com a culinária de Liyue tanto quanto costumava ser. Mika, Eula, vocês tão a fim de quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "#Qualquer coisa serve! Estou ansioso para provar a comida {M#do}{F#da} Cavaleir{F#a}{M#o} Honorável. Tenho certeza que vai ser uma ótima oportunidade de aprendizagem para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "...Uma coisa pequena, eu acho. Temos que pegar a estrada de novo após comermos. Tirando isso, qualquer coisa vai ser ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "Mas não foi sua ideia vir aqui? Vixe, isso é tipo tirar leite de pedra... Beleza, Paimon acha que tá contigo, Amber. Você diz, a gente prepara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Hã? Então acho... Hmm, também não me importo. Qualquer coisa serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "Urg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Posso anotar seu pedido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "O dia ainda não acabou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
