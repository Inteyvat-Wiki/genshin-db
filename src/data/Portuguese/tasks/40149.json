			"dialogs": [
				{
					"id": 401499601,
					"content": "#Desculpa! Eu não consigo mesmo pensar em nada agora... Digo, eu podia escolher aleatoriamente do cardápio, mas me sinto mais confortável deixando {F#a}{M#o} chef escolher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499602,
					"content": "Ah, uma coisa — eu sei que disse que não me importo com o que comermos, mas sem álcool, por favor. Nenhum deles pode beber... é uma grande pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499603
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401499603,
					"content": "E-Eu ainda tenho um pouco de água com gás aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				}
			]
		},
