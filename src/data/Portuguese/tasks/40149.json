				{
					"id": 401499401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499402,
					"content": "Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "...Ah, perdão. Eu estava viajando ainda agora — não te vi chegando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Tá preocupada com alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "É... A comida que você preparou pra gente agora — me lembrou da comida que meu avô costumava preparar pra mim. Pensei que tinha esquecido o sabor, mas tudo veio à tona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Ele costumava fazer pratos de Liyue o tempo todo. Eu fazia meu treinamento de Aventureira com ele até a noite, então esperava pacientemente na mesa de jantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "...Eu sentava lá, com o cheiro de comida deliciosa saindo da cozinha, esperando por ele para finalmente surgir com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "Às vezes a gente jantava com Eula, apesar dela só achar algo pra reclamar, eu podia perceber que ela gostava muito da comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Ah... então talvez ela lembre também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "...Suas palavras, não minhas. Não pergunte a ela sobre isso — ela vai te dar outro sermão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "E talvez seja por isso que ela sugeriu vir aqui para jantar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
			]
		},
