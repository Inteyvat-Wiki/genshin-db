			"dialogs": [
				{
					"id": 401490301,
					"content": "#Aí está você, {NICKNAME}! Muito obrigado pelo seu trabalho duro nesses últimos dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "O prazer foi meu... assumindo que ainda vou receber, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Hahaha, direto ao ponto, não é? Aqui, pegue. Coloquei um pouco a mais também — considere um bônus. Trabalho duro é recompensado aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Oba! É como se todo o cansaço e estresse de repente derretessem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "Tenho muita sorte que você só fez esse trabalho por alguns dias. No ritmo do seu progresso, mais algumas semanas e acho que eu teria ficado obsoleto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 401490306,
					"content": "Bem, eu, particularmente, mal posso esperar para aproveitar sua comida muito mais vezes no futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Haha, à vontade! Traga uns amigos com você da próxima vez e vou mostrar a vocês tudo que Yanxiao Sorridente pode fazer quando está com as duas mãos intactas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 401490308,
					"content": "Ótimo! Apesar de que... só por segurança, cozinhe com cuidado enquanto isso! Você pode ter chamado um mau agouro com isso de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
