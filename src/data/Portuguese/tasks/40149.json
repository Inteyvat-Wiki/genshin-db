						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "...Hmm, isso tá delicioso! Temperado perfeitamente e até o arroz tá transbordando de sabor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Nada como uma refeição quentinha servida direto do fogão... Que saudades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "Hehe, você humilhou as melhores rações de campo dos Cavaleiros de Favonius, e isso não é nada fácil... Conta pra gente, Viajante, qual é o nome desse prato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Se chama... Hmm... Paimon acha que a gente não pode ser chamar de \"qualquer coisa serve\", né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "...Socorro, Paimon não sabe nem um pouco como explicar esse prato! Não tem nome e são só ingredientes básicos, cozidos de um jeito simples...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "#Ingredientes básicos, cozidos de maneira simples? Sério? Podia jurar que você colocou algo requintado aqui, ou deu algum tipo de toque de mágica d{F#a}{M#o} chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Esse não é o prato mais delicioso do mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Mas é o que vocês precisam agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "Não é o prato mais delicioso do mundo, mas o que eles precisam agora...? Certo, você perdeu Paimon, o que você tá falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Vocês estiveram na estrada por muito tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "E vocês só têm comido rações de combate o tempo todo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Então você quer dizer... Nós só achamos que isso é delicioso por que estamos com tanta fome? Hmm, tem que ter mais além disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "...Talvez o fato que o aroma da comida preparada na hora seja uma mudança bem-vinda das rações pré-preparadas e frias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Ah, tipo o sentimento de acordar com o cheiro de pão fresquinho de manhã? Faz sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Sim... é quase como se a gente tivesse no Caçador de Cervos de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Hã? Mas o Caçador de Cervos é em Mondstadt... Por que querer experimentar a comida de Liyue se você nem consegue sentir a diferença?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Ah, não tô falando do sabor. Só quis dizer o sentimento de... conforto, sabe? É tipo o sentimento de voltar para casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Conforto... Voltar para casa... Bem, Yanxiao disse mesmo que a gente quer fazer os clientes se sentirem em casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "O que compõe um prato saboroso é altamente subjetivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Todo mundo tem suas próprias preferências.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Mas os chefs fazem isso pelos seus clientes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Os chefs sempre tentarão conquistar seus convidados com sua paixão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "...E esse é o amor de um chef por estampar sorrisos nos rostos dos clientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Então, em outras palavras... o ingrediente secreto é \"amor\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Apesar de quão incrivelmente clichê isso parece, admito que é verdade para essa refeição. Muito bem... Marque minhas palavras, lembrarei dessa receita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "Certo, mas você não pode mesmo ter uma receita sem um nome, né? A gente já pensou em um nome pra esse prato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "Eu não pensei tão longe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
