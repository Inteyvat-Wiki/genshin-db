			"dialogs": [
				{
					"id": 401499701,
					"content": "Quando eu estava em expedição com o Grande Mestre, eu ficava geralmente encarregado de cozinhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499702
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499702,
					"content": "Sob as circunstâncias, eu só conseguia cozinhar umas refeições bem grosseiras... Mas todo mundo ainda gostava muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499703
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499703,
					"content": "Talvez \"amor\" fosse o ingrediente secreto também então?",
