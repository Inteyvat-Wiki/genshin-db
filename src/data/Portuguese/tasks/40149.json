			},
			"dialogs": [
				{
					"id": 401490401,
					"content": "Qualquer coisa serve, hein? Oh céus... Esse é o pior pesadelo de um chef. Sem ideia dos paladares dos clientes, a gente tem que dar um chute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 401490402,
					"content": "Mesmo assim, agora que você trabalhou na cozinha por tantos dias, tenho fé que você vai conseguir fazer isso. Pode ir, mostre a eles do que é capaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490403
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 401490403,
					"content": "(Deixe-me pensar... Do que eles gostam? O que eles podem estar desejando?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
