				},
				{
					"id": 718030303,
					"content": "Miau... Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030304,
					"content": "Um gato cinza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Um gato cinza... Que se perdeu fora da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Ah! A Lan mencionou uma missão de encontrar o gato... Será que esse é o gato mesmo? O nome dele é Huihui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Não esperava encontrar ele aqui... Será que estava aqui tão perto esse tempo todo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Visto que um Lawachurl da Pedra Oculta está aqui, ninguém se ousa vir para cá... entretanto ele também não se atreve ir para fora. Portanto, ele sempre se esconde cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "Ainda bem que viemos, se não, não sabemos quanto tempo ficaria aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Miau... Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030314,
					"content": "Miau... Miau...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Ei! O que você está fazendo? Mesmo assim, ele não entende nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Estamos levando ele de volta para Lan, ela levará Huihui de volta para o Solicitante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Miau... Miau! Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030320,
					"content": "Miau... Miau! Miau!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Ele não entende nada não se importa o quanto você tenta aprender com ele! Vamos levá-lo de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Parece que ele não se importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Como você chegou a entender?... Bom, vamos levá-lo de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Vamos levar ele de volta para Lan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "É o único jeito. Vamos levar ele de volta para Lan, e ela o levará para o Solicitante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
