				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Deixe-me ver, onde estão as três pessoas que a Ayaka comentou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "O que você está fazendo? Por que ainda quer sair após tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Sim, ainda não estamos preparados. Agora do nada, você quer ir embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "As crianças estão ansiosas para você levá-las para brincar... Por favor, pense muito bem antes de rejeitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Então, aposto que ele é aquele que a Ayaka acabou de comentar, vamos dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Esse parece ser o diário do Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Deixe-me dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "\"Hoje eu fiz um Peixe Seco Salgado com o pessoal da vila. Eu acabei queimando o meu um pouco, portanto eu fingi que fiz um Peixe Queimado Salgado\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "\"Hoje eu resgatei um menino que tinha caído na água, mas ele afirmou que o seu amigo Banbu ainda estava na água. Eu procurei a tarde inteira, e acabei entendendo que o Banbu é um caranguejo seu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "\"Hoje fui soltar pipa, mas o fio arrebentou. Eu corri tanto para alcançá-la mas não consegui. Por fim, me sentei em um lugar qualquer e fiquei olhando ela ir cada vez mais longe.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Uh... Parecem assuntos triviais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Oh? Espere, olha isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "\"Hoje fui orar em um santuário próximo, e fiquei lá por muito tempo. O Omamori que você me deu já está desgastado, mas ele continua sendo a coisa que eu valorizo mais...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "A Paimon acha que isso é uma pista útil. Vamos dar uma olhada no Santuário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
