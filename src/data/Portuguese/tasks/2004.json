				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "Isso é o Omamori que o Tejima mencionou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "Tanto a cor quanto o padrão, dizem que isso pertencia a uma menina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "Se o Tejima sempre estivesse com ele em mãos, alguns rastros da Energia Elemental poderiam ser deixados nele. Isso poderia ser algo que possa dissipar o nevoeiro em nossa mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "A Paimon encontrou! Aqui deve ser o lugar onde o Tejima sempre frequentava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "O solo parece ter sido revirado... Será que o Tejima escondeu alguns tesouros, e é por causa disso que ele fica por aqui por tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "O Tejima guarda o tesouro por mais de 30 anos, isso é um ato extraordinário. Vamos desenterrá-lo~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "Isto é uma... carta? O papel já está bastante amarelado, deve ter sido escrita há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "Vila Konda... Que nome familiar! Mas onde ela está localizada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "É aqui mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "Ei? Então o Tejima está aqui esperando por alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "Mas já passou 30 anos, a pessoa que ele tem esperado ainda não apareceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "Enfim, vamos primeiro dar esse diário ao senhor Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Certo, fui eu que escrevi esse diário, e o Omamori e a carta também devem ser meus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "Embora eu não esteja lembrando o mínimo do conteúdo da carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Eu realmente estava esperando por alguém por mais de 30 anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Durante esse período, anotei tudo o que eu achava de engraçado para que pudesse contá-los a ela no dia de nosso reencontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "O tempo voa, aconteceram tantas coisas em apenas um piscar de olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "Mas por que eu até me esqueci de uma coisa tão importante como essa? Após a minha Visão ser confiscada, eu me sinto sem alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Tanto o amor quanto a pena... Tudo o que era relacionado a ela desapareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Você está se sentindo triste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "Parece que nem tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Afinal de contas, nem estou conseguindo lembrar quem é ela, muito menos sua aparência, sua voz e tudo o que ela passou comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "É como se ela nunca tivesse aparecido na minha vida e tudo que aconteceu fosse um sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Então você ainda quer sair daqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Não... Eu já estou esperando por mais da metade da minha vida, que diferença faria se eu continuasse esperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Só que... se ela aparecer, eu nem consigo chamá-la pelo seu nome. Será que ela ficará triste por causa disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "Só de pensar, me deixa nervoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Que estranho... Agora que eu nem consigo me lembrar dela, por que ainda fico pensando nisso? Como antes, estou sentindo vazio no meu coração, e parece que está faltando alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "De qualquer forma, muito obrigado por me arranjar um motivo para continuar permanecendo por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Eu ficarei esperando por ela por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Mesmo que o Tejima tenha negado que ele está triste, não sei porquê, a Paimon está se sentindo muito triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Eu também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "É exatamente como o que a Ayaka e o Thoma disseram. Se você perder sua Visão, também se perde todas as suas esperanças e sonhos também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Talvez isso explique por que o Tejima está assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "Pelo menos chegamos a ajudar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "Ugh... Vamos nos encontrar com a próxima pessoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Nada é mais triste do que perder a razão da tristeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200406",
							"2"
						],
						"stepId": 200406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "Você... Você também está aqui para convencer o Tejima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "O Tejima, desde que chegou aqui, tem ficado esperando por mais de 30 anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Expulsando os Ladrões de Tesouro, repelindo os monstros, resolvendo as disputas na vila... Ele contribuiu bastante para a vila, e ele é uma pessoa em quem temos mais confiança e respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Mas agora do nada ele quer sair da vila... Será que fizemos algo errado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Caso necessário, podemos pedir desculpas ao senhor Tejima. Mas tudo o que queríamos é que o Tejima possa ficar com a gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
						],
						"stepId": 200407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kenjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "*Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040702,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "Na minha opinião, isso está relacionado com o Decreto de Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040704,
					"content": "Mas o Tejima não fez nada de errado, mas a sua Visão acabou sendo confiscada... E desde então, ele passou a parecer como uma outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040705,
					"content": "Não sei como explicar. Mas sinto que ele parece ter perdido algo importantíssimo, e acabou circulando pela vila sozinho e querendo ir viajar pelo mundo de repente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040706,
					"content": "Mas sério, também não temos certeza de que estamos certos ou não em convencê-lo a ficar, mas de qualquer forma, não queremos que ele fique assim, indo embora sem voltar a si mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040707,
					"content": "Parece que todos na vila o respeitam de corpo e alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200408",
							"2"
						],
						"stepId": 200408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Você é o Tejima? Por que você quer sair daqui agora do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "Eu? Em vez de ficar falando sobre por que eu quero sair, é melhor entender por que eu tenho que ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Você já vive aqui há muito tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Todo mundo depende de você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Sim, mas isso não é um motivo para eu ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "Por que eu vim para cá 30 anos atrás? E durante esse 30 anos, por que eu não queria sair daqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "Não me lembro de nada nem um pouco. Desde que a minha Visão foi confiscada, parece que eu me esqueci de muita coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Antes eu sabia que eu tinha que ficar aqui, mas agora tudo o que me impedia desapareceu, então seria uma boa altura para eu dar uma saída, apesar de estar sentindo um vazio no coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Isso quer dizer que se conseguirmos arranjar um motivo para ficar, você ficaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Hmm... Mas se você não consegue lembrar de nada, não vai ser fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "Talvez, se você tentar um pouco mais, então... Tudo vai acabar voltando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Oh, isso me lembra que... Da última vez que trouxe algumas frutas ao Tejima, acredito que vi ele escrevendo um diário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "...Eu tenho um diário? Se você diz... Eu honestamente não consigo me lembrar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "Sim, sim, você tem! E, além disso, lembro-me de você ter dito na época que queria fazer uma anotação de algumas coisas interessantes - coisas que se revelariam muito importantes mais tarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "Perfeito! Portanto, se quisermos evitar que Tejima saia, só precisamos encontrar seu diário. Ele deve estar por aqui em algum lugar, vamos dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Se você não se importar, deixaremos você encontrar o diário... Devemos voltar à vila para informar os outros sobre a situação de Tejima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
