			"dialogs": [
				{
					"id": 742510201,
					"content": "É um prazer compartilhar histórias do passado com você enquanto apreciamos esta água maravilhosa, Srta. Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742510204,
					"content": "Muito bem. Onde for em seguida, desejo-lhe uma jornada tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}