			"dialogs": [
				{
					"id": 220490301,
					"content": "Vocês voltaram! Como foi soltar fogos de artifício?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490302,
					"content": "Foi demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Que bom que vocês gostaram, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "Bem, eu preciso voltar para cuidar da loja agora. Os negócios realmente tomaram impulso recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "Heh, por que aquela garota ainda não voltou? Aonde ela foi para fazer suas besteiras, me pergunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "Queria que tivesse durado mais...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Vejo que vocês realmente gostaram, isso é ótimo! Venham pegar mais fogos de artifício aqui comigo quando estiverem com vontade de soltar de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		}
	]
