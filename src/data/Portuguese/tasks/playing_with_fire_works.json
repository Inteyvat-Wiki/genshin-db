			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "#Oh, você é {F#a}{M#o} nov{F#a}{M#o} amig{F#a}{M#o} da minha garotinha, não é? Marcaram de sair de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490102,
					"content": "Como estão os negócios hoje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "Bom, muito bom! Hahaha, minha garotinha é realmente ótima, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490104,
					"content": "Você veio procurar ela hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490107,
					"content": "Bem, é uma pena! Ela disse que ia recolher material para fazer novos fogos de artifício, então ela está fora no momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490108,
					"content": "Hã. Então onde ela está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "O quê? Errr, o que você disse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490110,
					"content": "Yoimiya! Aonde ela foi!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "Oh, uh... Na verdade, não tenho tanta certeza. Ela deve ter mencionado, mas sabe, acho que não ouvi claramente com estes meus ouvidos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490112,
					"content": "Tem algo que você precise dela? Você gostaria de comprar fogos de artifício?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490113,
					"content": "Estávamos só procurando sair com Yoimiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "Ah. Bem, nesse caso, acho que você não vai ter muita sorte. Nunca se sabe quando ela voltará quando sai para mexer com fogos de artifício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490115,
					"content": "Que tal assim, então? Ela fez e depois deixou alguns fogos de artifício novos aqui na loja antes de sair. Por que você não os leva e sai para brincar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490118,
					"content": "Uhh, onde foi que eu deixei eles... Por aqui, talvez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490119,
					"content": "Uh, está realmente tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "Oh, está tudo bem, não se preocupe. Temos toneladas de estoque aqui na loja. Pegue e vá se divertir. Não se preocupe com isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490122,
					"content": "Além disso, minha garotinha estava procurando pessoas para dar a estas coisas um teste de qualquer maneira. Já que você está aqui, nada mais justo do que ser você, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490123,
					"content": "Basta levá-los para dar uma volta e me contar como foram as coisas depois de terminadas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490124,
					"content": "E assim que Yoimiya voltar, passarei sua mensagem para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490125,
					"content": "Não se preocupe com isso. Tenho certeza de que ela ficará mais do que feliz em saber que foi você quem os levou para fazer uns testes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490126,
					"content": "Vão lá. Mas não se esqueça de soltá-los fora da cidade. Se você acendê-los aqui dentro, vai atrair um monte de pessoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490120,
					"content": "Mas não pedimos à Yoimiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "Até que gostaríamos de nos divertir com alguns fogos de artifício...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "Haha, entendi, entendi. Isso é bom, então. Yoimiya fez e depois deixou alguns fogos de artifício novos aqui na loja antes de sair. Por que você não os leva e sai para brincar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490105,
					"content": "A Yoimiya está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "Ah, você está aqui procurando por ela, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		},
