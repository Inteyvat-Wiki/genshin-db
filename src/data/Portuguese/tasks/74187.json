			"dialogs": [
				{
					"id": 741870901,
					"content": "Parece que você resolveu nosso problema anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "Imagino que isso significa que você está indo em direção ao seu próximo objetivo, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "Sim. Estou contando com você para cuidar deste lugar, Este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870904,
					"content": "Além disso, lembre-se de confiar em seu coração ao invés de passar todo julgamento de certo e errado para Phobos ou para algum Harmosta qualquer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "O Sebastos criou Phobos para nos livrar de nossa servitude ao destino, mas a fé cega das pessoas nos levou para uma escravidão ainda mais assustadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "No futuro, você pode mais uma vez encontrar uma escolha parecida. Espero que você tome a decisão correta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Dominus Cassiodor, por que você está falando de tais coisas do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Mesmo assim, manterei suas palavras em meu coração. Eu, Este, aplicarei meu próprio senso de justiça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Muito bom. Adeus, Este. Acredito que nos encontraremos novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		},
