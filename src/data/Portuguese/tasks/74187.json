					}
				]
			},
			"dialogs": [
				{
					"id": 741870201,
					"content": "Ei, você! Sim, você! Seu idiota tagarela! Tá arrastando esse pé por quê? Mesmo que a gente envelheça, esses tesouros não vão se mover sozinhos, com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870202,
					"content": "Não, senhor! Eles simplesmente são pesados demais! Estamos nisso o dia inteiro, mas ainda há muito pelo chão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "O Cara Chamado de \"Idiota\""
				},
				{
					"id": 741870203,
					"content": "Então, onde está o mérito intrínseco de alimentar esse seu tamanho prodigioso!? É um tesouro, seu brutamontes, tesouro! É claro que seria pesado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870204,
					"content": "Além disso, \"confiscamos\" todos esses tesouros daqueles malditos bárbaros, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870205,
					"content": "Deixar tamanha riqueza na mão daqueles insetos que vivem como porcos e vira-latas seria um tremendo desperdício!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870206,
					"content": "Mas, senhor, você não acha que deveríamos ter trazido mais alguns navios se quiséssemos levar tudo isso de volta para Remuria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "O Cara Chamado de \"Idiota\""
				},
				{
					"id": 741870207,
					"content": "O que você é, idiota? Nossos navios de carga imperiais não devem ser usados para coisas assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870208,
					"content": "Bem, então por que não destruímos o que não podemos carregar? Melhor do que deixar parar nas mãos desses selvagens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "O Cara Chamado de \"Idiota\""
				},
				{
					"id": 741870209,
					"content": "Uh, é só Paimon ou já ouvimos essa conversa antes...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "Parece com aquela vez que havíamos acabado de chegar em Petrichor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "É, aqueles aventureiros azarados que afugentamos disseram algo parecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "E parece pior do que a de antes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Como isso aconteceu? Eles foram transformados em golens depois que o barco deles afundou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Isso é tão assustador!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Vocês são da Nona Legião? O que estão fazendo aqui? Vocês não deveriam ter sido ordenados a se retirarem para o Forte Charybdis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "Ei, Este! Não ouse estragar nossa diversão, ouviu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870218,
					"content": "De qualquer forma, lidar com esses bárbaros é mais fácil do que lidar com peixes mortos, então deixe-nos brincar por mais um tempo aqui, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870219,
					"content": "Esses tesouros... *Suspiro* Eu não sei quais ordens o seu Harmosta lhe deu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Mas o Sebastos não nos ordenou subjugar essas tribos ignorantes e libertá-las das correntes do destino? Essas ordens não incluem tais... atos claramente criminosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Hah? Certamente você está brincando! Nosso comandante, grande Boethius, nos ordenou a punir severamente esses selvagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870222,
					"content": "Além disso, não recebemos nenhuma punição. Isso significa que até mesmo Phobos e Vossa Majestade, o Sebastos, aprova nossas ações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870223,
					"content": "E qual é todo esse papo sobre crimes... você está tentando criar problemas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870224,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "Tem um outro Este aqui? Bem, as coisas estão ficando cada vez mais estranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Parece que é hora de responder à sua pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870227,
					"content": "Receio que o Este na cidade seja um descendente dos Remurianos. Seu ancestral deve ter me seguido para se juntar à nova nação, se tornando um habitante comum de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870228,
					"content": "Então, uma sinfonia feita para roubar as almas das pessoas de Fontaine não afetaria ele. Mas em troca, a melodia que registra o destino de seus ancestrais não tinha para onde ir, e se prendeu àquela estátua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870229,
					"content": "Nesse caso, o Este daqui é o antepassado do Este da vila? Será o verdadeiro sábio Este? E aquela outra pessoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Todos são almas perdidas que estão vagando nas memórias do passado aqui. Vamos ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870231,
					"content": "Vocês avançam com o Sr. Os...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Olá, Este.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Oras, olá. Quem é você mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "#Vocês não parecem ser Remurian{M#os}{F#as}. São selvagens, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "#Sou apenas {M#um}{F#uma} viajante de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Bem, esse é um campo de batalha e se colocam em grande perigo. Vocês precisam sair deste lugar, independente de quem sejam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "Sou eu, Este. Já faz um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870239,
					"content": "...Céus, é você, Dominus Cassiodor! Você raramente aparece nesta forma, eu quase não consegui te reconhecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "#{M#Aqueles dois... são seus servos}{F#Aquelas duas... são suas servas}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "Você pode considerar que sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Mesmo assim, Dominus Cassiodor, o que te traz aqui? O Sebastos te enviou para... Maldições! Eu não consigo lembrar! Estou em algum tipo de sonho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Esse parece ser o caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870247,
					"content": "Haha! Certamente você está brincando, meu lorde! Imagino que o Sebastos te enviou em alguma missão secreta novamente, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Você adivinhou corretamente. Falando nisso, por que esses soldados da Nona Legião estão guardando essas correntes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870249,
					"content": "As correntes... Você quer dizer, o tesouro? Acredito que sejam espólios da guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Embora o Sebastos tenha dito que a guerra tenha infelizmente sido um meio necessário para alcançar nossas grandes aspirações, e há muito tempo proibiu tais comportamentos sem sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Você sabe tão bem quanto eu que isso se tornou algo comum de qualquer forma... Estamos no caminho da escuridão, mas ninguém percebeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Dominus Cassiodor, o que aconteceu? Phobos deveria nos trazer felicidade, mas tudo que sinto é desânimo e dor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Eu também estou procurando pela resposta dessa questão. Mas parece que teremos que lidar com o problema em questão primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870254,
					"content": "Mas eles ainda são membros das nossas legiões! Vamos tentar resolver as coisas pacificamente primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "#Na verdade, sou {M#o dono}{F#a dona} dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Ei, ei, {NICKNAME}, pare de complicar ainda mais as coisas! Não se preocupe, {M#ele}{F#ela} só estava brincando, Este, por favor, continue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "Oh, eu posso ser bem selvagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870211,
					"content": "É aquilo com os \"Ladrões de Tesouro\" de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				}
			]
		},
