					"Este"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741870701,
					"content": "#Está bem... você está cert{F#a}{M#o}. Tudo que fizemos precisa ser considerado. Mas eu não sei por que as coisas mudaram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870702,
					"content": "Não sei o motivo, mas há uma sensação estranha em meu coração desde que essa guerra começou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870703,
					"content": "O que buscávamos devia ser a liberdade e felicidade, mas Phobos nos trouxe até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870704,
					"content": "Alguma coisa deu errado? O que poderia ser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870705,
					"content": "Se você se encontrar com o Sebastos ao retornar, por favor, conte a ele sobre nossas circunstâncias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870706,
					"content": "Você vai estar nos fazendo um tremendo favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870707,
					"content": "Não se preocupe, iremos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
