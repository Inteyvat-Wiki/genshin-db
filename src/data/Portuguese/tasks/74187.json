						"position": [
							1641.498,
							588.635,
							4626.62
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Ahem, soldados da Nona Legião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "#Hã? Quem são vocês? Ajudantezinh{M#o}{F#a}s de Este?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870603,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Não somos ajudantes quaisquer, somos fortes! Nós viemos junto com Dominus Cassiodor, para ajudá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "(Parece que vocês realmente possuem talento para atuar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Você disse Dominus Cassiodor... Ouvi dizer que o Sebastos enviou ele para Aremorica. Ele já voltou tão cedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870611,
					"content": "Bem, esse do nosso lado é, na verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "S-Seja qual for o caso, temos que inspecionar as legiões da linha de frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Certo. Imaginei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870615,
					"content": "Digo, não fomos ao Forte Charybdis com as tropas principais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870616,
					"content": "Mas fazer um trabalho de \"limpeza\" final como a retaguarda da unidade faz sentido dentro da melodia de guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870617,
					"content": "Essa é uma ordem de Phobos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Phobos guia cada um de nossos movimentos e direções, mas desde que chegamos aqui, houve diversos momentos que não pudemos ouvir sua melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870619,
					"content": "Por isso, só podemos agir segundo as instruções do Mestre Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870620,
					"content": "Aquele imbecil grosseiro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Ei, como é que você pode falar do Mestre Boethius desse jeito?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870622,
					"content": "Como um estimado Harmosta, tudo que Boethius fez seguiu as revelações do Sebastos. Suas ordens têm o mesmo poder que a de Phobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870626,
					"content": "Talvez Phobos também cometa erros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "#Você é Remurian{F#a}{M#o}? Você sabia que o criador de Phobos é um profeta supremo, capaz de tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870628,
					"content": "Mas vocês também não receberam a melodia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Sim, é verdade. Mas se não for em Phobos, no que confiaremos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870630,
					"content": "Se encontrarmos um desvio no caminho, como ele ficaria indiferente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870623,
					"content": "O Sebastos não deixará vocês ferirem os inocentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "É, sim, ele nos mandou ajudar os humanos vulneráveis antes da guerra começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870625,
					"content": "Mas nossas ações foram aprovadas por Phobos. Será que a ordem dele e a vontade sagrada do Sebastos são contraditórias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741870605,
					"content": "Somos enviados especiais de Vossa Majestade, o Sebastos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Que tipo de posição é essa... Bem, não é totalmente errado. Estamos com o Dominus Cassiodor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "#Somos {M#os retentores}{F#as retentoras} de Cassiodor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "#Isso mesmo! {M#Seus}{F#Suas} ajudantes leais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
