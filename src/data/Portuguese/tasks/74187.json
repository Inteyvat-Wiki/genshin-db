			"dialogs": [
				{
					"id": 741871201,
					"content": "Phobos é uma criação perfeita. Como Remuriano, aconselho que você não duvide disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871202,
						741871204
					],
					"speakerTitle": "Líder"
				},
				{
					"id": 741871202,
					"content": "Perfeito? Não existe nada perfeito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871203
					]
				},
				{
					"id": 741871203,
					"content": "O que estamos fazendo discutindo sofisma? Fale com aqueles eruditos musicais na capital. O dever de um soldado é de obedecer ordens. Não consigo entender problemas muito difíceis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Líder"
				},
				{
					"id": 741871204,
					"content": "O silêncio de Phobos significa rejeição.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741871205
					]
				},
				{
					"id": 741871205,
					"content": "De fato, é possível. Eu não havia considerado isso. Será que foi a nossa impetuosidade que fez Phobos não nos orientar mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741871206
					],
					"speakerTitle": "Líder"
				},
				{
