			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Corvo Noturno Solene",
					"Corvo Noturno Severo",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "Ei, parados! Quem são vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Corvo Noturno Solene"
				},
				{
					"id": 400720202,
					"content": "Vocês não parecem cidadãos do Reino da Noite Eterna. Expliquem-se! O que os trazem aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Corvo Noturno Severo"
				},
				{
					"id": 400720203,
					"content": "Esse lugar até tem guardas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "Se acalmem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "Hã? O que você está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "Somos servos da Princesa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "Viajamos pelo mar de estrelas para chegar até aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "#Como você pode provar que é {F#uma}{M#um} súdit{F#a}{M#o} de Sua Alteza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Corvo Noturno Solene"
				},
				{
					"id": 400720209,
					"content": "Hunf, tal pergunta absurda mostra sua ignorância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "\"Que meu povo seja livre das correntes de decretos antigos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "Essa... Essa é a senha para o Reino da Noite Eterna! Eles realmente são Retentores de Sua Alteza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Corvo Noturno Severo"
				},
				{
					"id": 400720212,
					"content": "Pelos céus... Não sabíamos! Por favor, perdoem-nos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Corvo Noturno Solene"
				},
				{
					"id": 400720213,
					"content": "Retirem-se, agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "Sim, nos retiraremos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Corvo Noturno Solene"
				},
				{
					"id": 400720215,
					"content": "Eles se foram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "Este é o segundo volume do \"Canto da Terra Sagrada\". Pessoal, vocês estão prontos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "Vamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007204",
							"2"
						],
						"stepId": 4007204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narração",
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "\"Entretanto, o Reino da Noite Eterna logo foi envolto por um pesadelo perpétuo. Tasraque, o dragão maligno, oculto nas profundezas, cruzou o oceano e emergiu sobre a capital.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Narração"
				},
				{
					"id": 400720402,
					"content": "Hã? Um dragão? Mas só parece que o tempo ficou escuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400720403,
					"content": "Será que o dragão é uma metáfora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720404,
					"content": "Você acha? O arqui-inimigo dela, o dragão maligno Tasraque, é feito de tudo que rejeita sua fantasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007210",
							"2"
						],
						"stepId": 4007210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "Oh, ainda bem... Hã? O que vocês estão fazendo aqui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721002,
					"content": "Temos a mesma pergunta. O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "Voltamos de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "Acho que vimos a verdadeira natureza do dragão maligno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "*Suspiro* Já estou familiarizada com isso. Sempre haverão pessoas que acreditam que nossas paixões são uma perda de tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721304,
					"content": "Hã? Você é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "Sou \"Arnold, o Peça-direções\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "Quero dizer, por que você está aqui de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "Oh, oh, eu vim porque supus que vocês procurariam pelo terceiro volume de \"O Canto da Terra Sagrada\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "Bem, você acertou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "Senhorita, você não precisa fazer nada para mim. A oportunidade de admirar sua beleza é a maior recompensa que eu poderia desejar. Lhe darei a resposta que buscam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "O terceiro volume do \"Canto da Terra Sagrada\" pode ser encontrado no andar mais alto do castelo real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "Ele é guardado por alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "Oh, mas é claro que sim, senhor. Que tipo de pergunta é essa? Nenhuma nação séria cuidaria de seus livros preciosos como se fossem jogados às intempéries.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "Isso quer dizer que encontraremos Guardas Corvos Noturnos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "Guardar as escrituras sagradas é uma grande honra para os cidadãos. Mas isso não importa, pois tenho certeza que essa bela senhorita apenas deseja consultá-los, e não possui intenções maliciosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "Seu rosto é cativante, cheio de sabedoria, e aqueles que lhe acompanham parecem serem heróis renomados. Eu tenho fé que você compreenderá o significado por trás das histórias em nossas escrituras sagradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "Os feitos de Sua Alteza foram registrados pelo Grande Escriba, Oz, e se tornaram tesouros do Reino da Noite Eterna. Desejo alegria para Sua Alteza todas às vezes que leio esses livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Eu lamento que você me veja em um estado tão decadente. Suponho que ainda não sou bom o suficiente para atuar o papel de um Cavaleiro Corvo Noturno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721802,
					"content": "Atuar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721803,
					"content": "Tenho vergonha em admitir, mas não sou um cavaleiro de verdade... Na verdade, sou um ator novato que começou a trabalhar no papel de um cavaleiro para a companhia de teatro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721804,
					"content": "Isso não é algo que você deveria ter orgulho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721805,
					"content": "Ah, bem, vejam, é aí que vocês estão errados! O teatro é uma parte essencial da cultura do Reino da Noite Eterna! Uma performance teatral fantástica é o maior tributo que podemos oferecer a Sua Alteza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721806,
					"content": "Oh, então isso é parte da cultura local de vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721807,
					"content": "Exatamente! Por isso que estou tão feliz em atuar como um cavaleiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721808,
					"content": "Por que a Princesa gosta tanto de teatro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721809,
					"content": "Sua Alteza uma vez disse: \"Celebrem-me atuando uma peça nos campos abertos. Ajoelhem-se, e tragam-me belos sonhos em troca de glória eterna no reino da escuridão.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721810,
					"content": "Creio que seja porque sua Alteza aprecia a verdadeira arte, e pode sentir as emoções profundas escondidas nas almas humanas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721811,
					"content": "A cristalização e sublime expressão da emoção é a alma do teatro. Pessoas que genuinamente compreendem o teatro sempre terão um belo e sensível coração, cheio de emoções transbordantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721812,
					"content": "... Oh, então é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721813,
					"content": "Obrigado pela sua resposta, Sr. Cavaleiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721814,
					"content": "Oh! Você me chamou de cavaleiro, muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721815,
					"content": "Bem, revestido com essa glória, partirei para a batalha! Que nos encontremos novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721816,
					"content": "Esperemos que não... Tenha mais cuidado na próxima vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721817,
					"content": "Oh, e por favor, lembre-se da senha para abrir o portão: \"Sob minhas ordens, abram as asas e voem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		}
	]
}