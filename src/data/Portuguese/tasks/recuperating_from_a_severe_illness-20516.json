			"dialogs": [
				{
					"id": 205160101,
					"content": "Para onde ela fugiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160102,
					"content": "A Anna saiu outra vez para brincar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160103
					]
				},
				{
					"id": 205160103,
					"content": "Parece que você já está acostumado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160104,
					"content": "Anna se torna cada vez menos obediente. Ela fugiu rapidamente quando eu estava só um pouco distraído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160105,
					"content": "Ela ainda não se recuperou cem por cento, por favor, ajude-me a procurá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160106,
						205160108,
						205160111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160106,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160107
					]
				},
				{
					"id": 205160107,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160115,
					"content": "Ah, certo. A Anna que me disse que queria sempre ir ver a Estátua do Arconte Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160116,
					"content": "Eu me lembro que a Freira Grace sempre fica lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160117,
					"content": "Você pode perguntar a ela primeiro, talvez ela saiba alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160108,
					"content": "Você já a procurou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160109
					]
				},
				{
					"id": 205160109,
					"content": "Claro, até fui para fora da cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160110,
					"content": "Mas não consegui encontrá-la, por isso, tenho que pedir a sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160111,
					"content": "O que a Anna gosta de comer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160112
					]
				},
				{
					"id": 205160112,
					"content": "Oh, ela gosta de comer... Oh! Já te disse que a minha irmã não é um gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160113,
					"content": "Aliás, tem tantas coisas que ela gosta de comer que não dá para contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205160114,
					"content": "Ok, já chega! Por favor, procure por mim. Vou ficar à sua espera, estou morrendo de cansaço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160115
					],
					"speakerTitle": "Anthony"
				}
			]
		},
