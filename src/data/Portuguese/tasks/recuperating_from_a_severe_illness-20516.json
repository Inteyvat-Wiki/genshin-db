					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Ah! Deve ser a Freira Grace que te disse, não é? Ela andava sempre perto daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Os remédios que eu tomava eram sempre entregues por ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "A Freira Grace é uma pessoa muito boa, mas não quero só ficar em Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "Sei que o meu irmão está à minha espera, voltarei logo. Não vou deixá-lo se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
