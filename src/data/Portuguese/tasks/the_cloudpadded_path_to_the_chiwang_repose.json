			"dialogs": [
				{
					"id": 711271101,
					"content": "Ouvindo Montanha, parece que as \"óperas\" de Fontaine são bem parecidas com as nossas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271102
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711271102,
					"content": "Cavaleiros, mágicos, guerreiros corajosos e dragões malignos, você me mata, eu te mato e no fim, todos estão mortos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271103
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711271103,
					"content": "O que é importante não é o final! É o processo, como você chega lá! Nem toda tragédia pode ser vista como uma mera sequência de cenas de luta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271104
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271104,
					"content": "Oh, oh! E a Montanha \"Golens Juvenis\" estava mesmo falando sobre som bem, bem maneiro também! Queria saber se são maiores do que Azulzinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271105
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711271105,
					"content": "Hã? Azulzinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271106
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271106,
					"content": "Ah, certo! Eu nunca te falei de Azulzinha, né... Que tal isso? Você me fala mais dos Golens \"Juvenis\" e eu te conto sobre Azulzinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Mao"
				}
			]
		},
