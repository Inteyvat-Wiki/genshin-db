			"dialogs": [
				{
					"id": 711270501,
					"content": "#Hã? {NICKNAME}, Paimon e Lingyuan... Por que vocês vieram aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270502,
					"content": "Eita, esse é a voz de Fujin! E tá... vindo lá debaixo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270503,
					"content": "#Estou um pouco preocupad{M#o}{F#a} contigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "#É! Estamos preocupad{M#os}{F#as} com sua saúde, então viemos aqui sem te avisar— Mas você fez o mesmo com a gente primeiro, então Paimon acha que estamos quites!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "Hã? Ah! Desculpe! Quando eu voltei aqui para descansar, acho que esqueci de desbloquear a entrada...! Mil perdões. Vocês vieram aqui me ver, mas os Simulacros Sagrados dificultaram para vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "Ah, não foi tão ruim assim! Mas por que você tá... hmm, se escondendo em uma poça?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Hmm, como devo dizer...? Por que eu não posso retornar à forma que prefiro ainda, e com vocês sempre me vendo na minha forma de Carpa, não consigo deixar de sentir um pouco de... vergonha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "Você tá sabendo que a gente já te viu um montão de vezes, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Ahaha... Mas antes, eu podia voltar a ser humana sempre que queria, então pensei que sair por aí como uma Carpa era só uma questão de conveniência. Mas agora, tudo que tenho é essa versão lisa e escorregadia, então acho ela um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Eita, isso é algo estranho de se insistir tanto... Mas enfim, tudo que importa é que você tá bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "Mas Lingyuan disse que sua força Adepti não foi consumida, só tinha se dispersado pelas montanhas, florestas e rios do Vale Chenyu, por isso que você enfraqueceu tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "Então se a gente coletasse a força Adepti espalhada, igual quando estávamos procurando Carpas Douradas no Vale Yaodie, então você ia melhorar, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Sim... Pelo menos, em teoria, isso está correto, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "Certo, certo? Então se a gente vir Carpas similares, a gente só traz elas aqui! Assim, você vai se recuperar mais rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "I-Isso seria problema demais para vocês! Meu poder ainda não está tão fraco. Se eu simplesmente descansar aqui por um tempo, será suficiente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "Não é tanto problema assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "...Vamos ficar de olhos abertos se a gente encontrar alguma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Obrigada, então. Contudo, eu realmente não quero incomodar. Vocês já fizeram demais por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270524,
					"content": "Se vocês encontrarem alguma força adepti por coincidência em suas viagens, por favor, só a transfiram para o jade aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270525,
					"content": "Embora o equilíbrio tenha sido restaurado ao solo e água, se pudermos adicionar mais poder à Chuva de Jade, podemos garantir um clima favorável e próspero para o ano vindouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270526,
					"content": "...E quanto a você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270527,
					"content": "Sério! Eu já te falei, tudo que preciso é descansar um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}, Paimon, estou mesmo muito grata e muito contente que vocês vieram me visitar. Essa é a primeira vez que alguém vem aqui desde que Herbolorde se foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270529,
					"content": "E obrigada a você também, Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270530,
					"content": "Não fiz nada digno de sua gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270531,
					"content": "#Tudo bem, basta disso! Então só pense nisso como um agradecimento por trazer {NICKNAME} e Paimon aqui! Sério mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#E finalmente... Deixe-me agradecer vocês mais uma vez, {NICKNAME} e Paimon. Por tudo que fizeram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "Então não precisa de esconder, precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "Lingyuan tá um pouco preocupada com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "Eu não. Eu só...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270508,
					"content": "É! Lingyuan tá tão preocupada com sua saúde que ela quase não consegue falar, então a gente só veio aqui sem te avisar— Mas você fez o mesmo com a gente primeiro, então Paimon acha que estamos quites!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7112709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
