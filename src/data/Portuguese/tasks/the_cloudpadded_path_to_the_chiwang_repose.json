	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "Falando nisso, essa deve ser a morada de Fujin, certo? Parece um pouco diferente das outras moradas de Adepti que visitamos... Como Paimon pode dizer... parece mais... pragmática?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270302,
					"content": "Não tem mecanismos esquisitos ou pontes invisíveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270303,
					"content": "Peço desculpas... eu só estava com vergonha antes e nunca me expliquei claramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270304,
					"content": "Não posso criar novos paraísos mágicos como os adepti do sul. \"Pavilhão do Brocado Caído\" não é uma \"morada\", é no máximo apenas uma \"caverna\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270305,
					"content": "Caverna, paraíso, que seja! São todas \"moradas\" onde Adepti vivem, não são? Mesmo assim, a gente nem sabe quando Fujin pode voltar à forma humana dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270306,
					"content": "Todo o poder que ela acumulou se espalhou por essa terra. Ela não vai conseguir reverter para a forma humana por algum tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270307,
					"content": "O mesmo acontece quando eu esgoto meu poder. Após Mestre morrer, a neve caiu, derreteu e caiu mais uma vez após derreter, e aconteceram incontáveis vezes antes que eu pudesse recuperar a forma humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270308,
					"content": "Oh, então é isso... né? Peraí, Lingyuan, você também pode virar uma pessoa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270309,
					"content": "Hunf! Claro! Tem muito que vocês não sabem! Ora, na época, na Montanha Yaojun, a aparência de Lingyuan era—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270310,
					"content": "Fujin. Não precisa falar de tais coisas. Não tem nada a ver com o assunto em questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270311,
					"content": "Hã? Então, aquilo tudo de comer bolos de chá demais na Feira do Templo em forma humana, e chorar para a Herbolorde sobre fazer um chá de perda de peso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270312,
					"content": "Ou o incidente sobre beber acidentalmente as libações comemorativas e arrastar javalis da floresta para perguntar a eles \"Quem é mais bonita, eu ou a Herbolorde?\"... Ah! Mas eu não precisava falar de tais coisas, afinal, precisava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270313,
					"content": "... Fujin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270314,
					"content": "Uau! Depois disso tudo, Paimon tá curiosa sobre como Lingyuan se parece em forma humana! Será que ela ia ser azul como é agora? Ou talvez um azul mais branco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270315,
					"content": "#Agora também tô curios{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "#Não entendo sua curiosidade. Você é uma pessoa. Se está interessad{F#a}{M#o} em formas humanas, basta olhar para si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270321,
					"content": "#Hehe, enfim, obrigada, {NICKNAME} e Paimon. Eu nunca imaginei que chegaria o dia em que eu poderia falar com outros assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270322,
					"content": "*Cof*— Como esta se encontra em estado mental tão alegre, esta está disposta a conceder proteção sobre vocês para sua jornada, garantindo sucesso e grande sorte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270323,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270324,
					"content": "...Desculpe, me deixei levar um pouco. Eu queria tentar ser como aqueles adepti, então decidi tentar uma frase ou outra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270325,
					"content": "Enfim! Vou ficar aqui e orarei para que sua jornada seja tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270317,
					"content": "Lingyuan, você podia virar uma humana? Só por um segundo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "Me recuso. Corpos humanos são fracos. Eles não têm presas e garras para caçar inimigos. Não faria algo assim a não ser que Fujin ordenasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270319,
					"content": "... Hã? Mesmo? Nesse caso, acho que vamos respeitar o desejo dela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270320,
					"content": "Eu não desejo. Se tiver, me diga diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
