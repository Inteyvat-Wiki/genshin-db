			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pequeno Mao",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "Azulzinha, Azulzinha, você não me contou o final daquela história que você tava contando da última vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711270902,
					"content": "Sim, eu lembro. Contudo, mudei de ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270903,
					"content": "\"Mudou de ideia\"? O que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711270904,
					"content": "Vou deixar o final da história... para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270905,
					"content": "Hã?! Qual é, Azulzinha, você tá trapaceando! Você prometeu que se eu te contasse uma história, você me contava uma história! Por que eu tô contando as duas histórias agora?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711270906,
					"content": "Sou apenas uma fera simplória. Não consigo pensar em um final bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "O final que pensei era ruim. A história era uma história ruim que não faria ninguém feliz. Então, você conta o final da história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270908,
					"content": "Mas isso é trapaça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "Pequeno Mao"
				},
				{
					"id": 711270909,
					"content": "Eu não nego. Como compensação, posso te levar para ver as paisagens escondidas da Montanha Lingmeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270911,
					"content": "Por favor, não faça essa cara. Eu ainda te dou permissão especial para... Sentar nas minhas costas, por uns cinco minutos. Dez minutos está tudo bem também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270912,
					"content": "Nesse... Nesse caso, então fechado! Vou pensar em um final pra história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Mao"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271001,
					"content": "Hã? Aquilo não é Lingyuan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271002,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271003
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271003,
					"content": "Ah, desculpe! Você tá caçando? A gente te incomodou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271004,
					"content": "Eu não estava caçando. Vocês também não me incomodaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271005
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271005,
					"content": "Uh... Então você só tava... distraída? Tipo, pensando em comidas gostosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271006,
					"content": "Eu também não estava pensando em vocês. Eu estava pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271007
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271007,
					"content": "Pensando... Espera, calma lá! O que você quis dizer com a primeira parte?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271008,
					"content": "#Eu estava pensando na pergunta que {NICKNAME} fez mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271009
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271009,
					"content": "\"Se as atividades humanas fossem parte das leis da natureza, como você enxergaria a humanidade?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271010
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271010,
					"content": "Já faz muito tempo desde que tive contato com os humanos constituindo o assentamento pela última vez — não estive lá desde que Fujin e a cobra partiram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271011
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271011,
					"content": "Ei, isso quase fez parecer que Pequeno Mao não conta como humano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271012,
					"content": "#Pequeno Mao é um humano que pertence aos humanos do assentamento, mas não é um humano que constitui o assentamento. Você e {NICKNAME} \"constituem\" companheir{M#os}{F#as} de viagem, mas você não \"pertence\" a {NICKNAME}. Essa é a diferença.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271013,
						711271015
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271013,
					"content": "Você não considera Pequeno Mao parte da ordem social?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271014
					]
				},
				{
					"id": 711271014,
					"content": "Ainda não se tornou totalmente parte da ordem. A maioria dos jovens humanos são assim até que são completamente absorvidos pela ordem, assim como a natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271017,
					"content": "Eu não tive contato com humanos que constituem o assentamento por muito tempo. Talvez seja por causa do ódio, talvez seja por causa do medo, talvez por causa dos dois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271018,
						711271019
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271018,
					"content": "Por que eles ocupam a terra que pertence à natureza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271020,
					"content": "Eu não sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271021
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271021,
					"content": "Ou talvez não existam diferenças óbvias que separam \"nós\" e \"eles\", mas não tenho certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271022
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271022,
					"content": "Os jovens dos humanos andam comigo, e os jovens da minha espécie andam com os humanos por curiosidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271023
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271023,
					"content": "Hã? Os jovens da sua espécie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271024,
					"content": "Aquela criança encontrou humanos mortais nas montanhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271025
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271025,
					"content": "Então, eu não consigo responder sua pergunta. Devo continuar a observar a humanidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271026
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271026,
					"content": "Há muitas coisas que eu não entendo. Eu tentarei entender, como prometido, até que eu possa responder sua pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271019,
					"content": "Por que Fujin escolheu se sacrificar por eles?",
