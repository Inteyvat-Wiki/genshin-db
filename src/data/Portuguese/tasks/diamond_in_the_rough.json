				},
				{
					"id": 223050502,
					"content": "#Bem generos{M#o}{F#a}! {M#Senhor}{F#Senhora}, nem todos os novos clientes apreciam que se deve semear generosidade para poder colher generosidade.",
					"roleType": "TALK_ROLE_NPC",
