				{
					"id": 223051001,
					"content": "Não há muito jade dentro desta pedra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051002
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051002,
					"content": "Bom, não se preocupe. Foi uma boa experiência né? A Mora gasta para se divertir é bem investida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051003
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051003,
					"content": "Você me fez acreditar que não havia pedras ruins...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223051004
					]
				},
				{
					"id": 223051004,
					"content": "É verdade. Mas todas as pedras são selecionadas com cuidado. Chamá-las de \"pedras ruins\" não condiz com a realidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051005
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051005,
					"content": "Por favor, não desanime! Às vezes somos enganados por uma pedra que, apesar de sua boa aparência, acaba sendo uma decepção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051006
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051006,
					"content": "Deixe-me ajudar. Se você quiser continuar tentando, podemos continuar. Vamos acertar as contas no final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051007
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051007,
					"content": "<color=#00E1FFFF>Eu irei calcular quanto que você possui</color> no final. Se fizermos de pouco a pouco ao longo do caminho, podemos acabar nos perdendo nas contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051008
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051008,
					"content": "O que você acha? Mais uma rodada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
