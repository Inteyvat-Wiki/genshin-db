			"dialogs": [
				{
					"id": 30111113,
					"content": "Hmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "Não estamos em um círculo temporal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Assim, o bip que ouvimos todas as noites pode estar indicando o momento em que nossas memórias são apagadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "É por isso que quando acordamos, todos pensam que o Festival Sabzeruz ainda não aconteceu. Já é o dia seguinte, mas todo mundo ainda pensa que é o dia anterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Mas a memória muscular não pode ser apagada. É por isso que a Dehya ficou melhor no manejo do seu espadão! Agora tudo faz sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "... Humm, uma dedução brilhante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Nahida, diga-nos se temos razão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "Em poucas palavras, é como se você confundisse Borboletas de Cristais Pyro com um Vagalume à noite. Você perdeu de vista sua verdadeira natureza porque se concentrou demais em sua percepção de que ela brilha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "Isso não é nada fácil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "Ainda chegamos na conclusão errada, hein...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Por que você não vai falar com a senhorita Dehya novamente? Talvez você possa aprender algo novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "Bem... Afinal, ela nos ajudou a encontrar nossa última pista. Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Em vez disso, nossas memórias são apagadas no final de cada dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
