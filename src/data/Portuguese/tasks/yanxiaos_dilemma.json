			"dialogs": [
				{
					"id": 220030301,
					"content": "Espere um momento. Por favor entregue a comida quando eu a acabar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030302,
					"content": "Não pareça tão difícil! Não estou fazendo você fazer isso de graça. Você vai conseguir o que merece, não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030303,
					"content": "Bom! Você pode entregar este prato para aquele comilão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030304,
					"content": "O nome dele é <color=#00E1FFFF>Jiangxue</color>, que sempre pesca no lago, não é difícil distinguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Yanxiao Sorridente"
				}
			]
		},
