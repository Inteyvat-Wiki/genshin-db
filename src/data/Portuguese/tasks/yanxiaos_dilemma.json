			"dialogs": [
				{
					"id": 220030701,
					"content": "Você ainda está aqui?... Provavelmente é melhor você voltar. Quando você o mantém esperando, ele tende a fazer uma de suas birras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030702,
					"content": "Por que ele cozinha para você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Somos...amigos. Já nos conhecemos há muito tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Eu, hum... Eu fui a Ilhota de Dihua uma vez para... uma coisa ruim, mas era algo que eu tinha que fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "Esse é o único lugar onde Liyue me permite ficar e o chefe se certifica se eu estou bem alimentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030706,
					"content": "Eu poderia continuar falando, mas você provavelmente tem coisas melhores para fazer com seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030707,
					"content": "É melhor eu voltar, aquela cozinheira nunca tem paciência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
