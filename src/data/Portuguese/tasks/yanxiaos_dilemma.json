					"Yanxiao Sorridente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Hnf! Ele é muito sem-vergonha de ficar se aproveitando de mim assim o tempo todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Eu? Estou fazendo comida para quem não merece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030104,
					"content": "Incrível! Ele gasta o tempo todo fazendo nada, mas não oferece para ajudar no albergue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030105,
					"content": "Ele fica pescando todos os dias, mas nunca vi nenhum peixe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030106,
					"content": "Se não fosse por mim, morria de fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030107,
					"content": "Ugh, não vale a pena ficar gastando saliva. Ele não consegue me ouvir, e mesmo se conseguisse, fingiria que não consegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030108,
					"content": "Se você não tiver outra coisa para fazer, você podia me ajudar a pegar alguns outros ingredientes. Estou ficando quase sem já.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030109,
					"content": "Não precisa muito, basta uma <color=#00E1FFFF>Pimenta de Jueyun</color> e uma <color=#00E1FFFF>Cabeça de Lótus</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030110,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Ok regresse assim que o encontrar, assim podemos cozinhar mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030112,
					"content": "Aqui no albergue tem monte de ingredientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Foi o meu chefe que pagou! Você acha que ele vai pagar de volta? Duvido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030114,
					"content": "Tudo o que cozinho para ele sai do meu bolso ...Hmph, ele me deve muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030115,
					"content": "Apenas vá buscar os legumes, pode ser? Não é um pedido muito grande e não vai levar muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				}
			]
		},
