			"dialogs": [
				{
					"id": 220030501,
					"content": "Hum? Em que posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030502
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030502,
					"content": "Isso foi o Yanxiao Sorridente que lhe deu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030503
					]
				},
				{
					"id": 220030503,
					"content": "A-há! Fiquei me perguntando de onde vinha aquele cheiro delicioso. Ele é um chef muito talentoso, você sabe disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030504
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030504,
					"content": "Obrigado. Por favor, agradeça por mim quando você regressar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
