			"dialogs": [
				{
					"id": 220030401,
					"content": "Rápido! Ele deve estar com muita fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030402,
					"content": "Por que você entrega a comida para ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Por que você pergunta isso? Ele não tem nenhum familiar. Eu sou a única pessoa que ele conhece em todo Liyue e aqui é o único lugar que ele tem coragem de vir comer e beber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030404,
					"content": "A razão? E o que isso interessa? Bem... É porque estou com vontade de cozinhar para ele, feliz agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030405,
					"content": "Se eu não estivesse disposto a cozinhar para ele, ele provavelmente iria fazer algo estúpido em na Ilhota de Dihua novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030406,
					"content": "Por que você ainda está aqui? O que você está esperando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				}
			]
		},
