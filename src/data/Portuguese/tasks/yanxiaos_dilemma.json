			"dialogs": [
				{
					"id": 220030601,
					"content": "Já entregou a comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030602,
					"content": "Sim, e ele disse que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Agradecer-me profusamente? Por favor. Poupe-me essa farsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030604,
					"content": "Já estou farto destas palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030605,
					"content": "\"Quando puder, venha pescar comigo. É melhor vir ajudar no albergue!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Yanxiao Sorridente"
				},
				{
					"id": 220030606,
					"content": "Tsc, por que estou te contando essas coisas? Toma, a sua recompensa. Vai fazer o que você tem para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanxiao Sorridente"
				}
			]
		},
