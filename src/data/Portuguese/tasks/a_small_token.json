			"dialogs": [
				{
					"id": 752380101,
					"content": "O chá está lhe agradando? Ou você prefere algo mais forte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380102,
					"content": "Ele está ótimo. Só me sinto culpada de beber durante o dia. Melhor não fazer isso sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Enfim, Srta. Guillotin, o que a traz até Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Só estou viajando, visitando velhos conhecidos. Além disso, queria agradecer você por me ajudar durante o Festival Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380105,
					"content": "Você é muito gentil. Veio mesmo até aqui só por isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Bem... apesar de você não ter mencionado na última vez, eu estou ciente dos problemas que causei para vocês no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380107,
					"content": "Ah... Aquele caso com sua subordinada? O incidente envolvendo a robô, Ineffa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Heh... A vida não é estranha? De repente você pode se tornar amiga do chefe da sua antiga inimiga... Ou até mesmo descobrir que ela se tornou sua própria chefe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "Espero que você possa aceitar isso como uma pequena demonstração de desculpas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380110,
					"content": "I—Isso... É uma edição limitada... Não, uma edição de colecionador!? E é do meu gênero favorito!? C—Como você soube...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#Eu perguntei a {NICKNAME} sobre coisas que você poderia gostar e segui {M#a sugestão dele}{F#a sugestão dela}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Argh...! Que sentimentos confusos são esses!? É como se eu estivesse feliz e constrangida ao mesmo tempo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "#(Claro que fico feliz que {M#ele}{F#ela} saiba do que eu gosto, mas não precisava ficar contando pros outros! Devia ter vindo me dar pessoalmente!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Você gostou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380116,
					"content": "Ah... O-Obrigada! Você é gentil demais, Srta. Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Se você gostou, da próxima vez eu trago mais. Claro que vou ter que incomodar {NICKNAME} de novo para me ajudar a escolher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380118,
					"content": "#...C-Com você!? Quer dizer que... Vocês foram junt{M#os}{F#as} à livraria comprar isso!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "#Sim, {M#ele}{F#ela} escolheu este livro com muito cuidado para você. Da próxima vez, talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380120,
					"content": "...É melhor não haver uma próxima vez!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Oh... Eu... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
