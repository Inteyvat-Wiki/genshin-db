			"dialogs": [
				{
					"id": 752380201,
					"content": "#Hmph... vou acertar as contas com {M#ele}{F#ela} da próxima vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380204,
					"content": "Já é essa hora? Tudo bem, Srta. Guillotin, cuide-se em sua jornada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
