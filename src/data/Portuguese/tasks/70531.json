			"dialogs": [
				{
					"id": 705310101,
					"content": "Por favor, espere! Você também está aqui pelo Grande Torneio do Rei do Chamado Sagrado dos Sete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Se você tiver um minutinho, eu gostaria de te dizer tudo sobre esse evento organizado pela Guilda de Aventureiros chamado de \"Passeio das Maravilhas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Uh... Claro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Obrigada! Deixe eu explicar o básico do evento para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "De forma resumida, a Guilda de Aventureiros colocou vários Pontos Turísticos em várias localizações por Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Tudo que você precisa fazer é encontrar esses Pontos Turísticos e marcar em sua Caderneta de Turismo com as estampas comemorativas de cada um desses locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "O desafio será considerado como completo quando você encontrar todos os Pontos Turísticos e coletar todas as insígnias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Realmente se parece com algo que a Guilda de Aventureiros faria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Hehe... Pensamos bastante em onde colocar esses Pontos Turísticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Entretanto... Alguns deles estão localizados em áreas mais remotas, e não posso garantir que esteja completamente sem monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "Mas tenho certeza de que lidar com esses monstros vai ser bem simples para alguém tão experiente como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "E isso é tudo! Aqui está sua Caderneta de Turismo. Divirta-se!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Ok, pode dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}