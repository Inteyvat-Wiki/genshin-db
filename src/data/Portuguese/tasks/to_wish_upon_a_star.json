			"dialogs": [
				{
					"id": 750210501,
					"content": "É só isso, né? Esta missão foi muito mais fácil do que Paimon imaginava! Mas, será que é realmente tão mágico assim? Antes Paimon estava um pouco cética...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Paimon, você também quer despertar poderes ocultos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Claro que sim! Se Paimon pudesse ter uma habilidade super poderosa para encontrar baús ou uma força incrível para derrotar monstros com um só golpe, não seria muito útil? {NICKNAME}, você não gostaria também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Eu preciso de mais podeeeeer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Ooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "#{M#Irmão}{F#Irmã}, coloque os fragmentos de volta na estrela. Uau... Que poder será que eu vou despertar? Talvez eu consiga até voar até os céus... hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "Eu já sou forte o suficiente, então não preciso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Hã? Mas não dizem que o caminho em busca de poder é infinito...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
