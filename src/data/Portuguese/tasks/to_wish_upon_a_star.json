			},
			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, você sente alguma energia extraordinária?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Não sinto nada de especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "Essa grande rocha também não mudou em nada. Não emitiu um brilho misterioso, não começou a tremer de repente, nem se quebrou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Uh, será que o problema foi o encantamento que recitamos? Embora tenha soado bem convincente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Mas às vezes, quando estamos explorando ruínas, também acontece isso! Basta errar uma senha ou um código e os mecanismos não respondem de jeito nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Que estranho... Essas palavras foram ditas por outra pessoa. Disseram que se fizéssemos isso, liberaríamos o poder oculto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "A pessoa que me contou isso, após recitar o encantamento, logo começou a gritar de dor enquanto segurava os olhos. Mas aí ela ganhou um \"Olho Mágico\" que permite discernir o valor das gemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Uau, isso é incrível!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Hã? Paimon acha isso bem suspeito, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Ai, finalmente te encontrei! Seu bobo, como você veio parar num lugar desses? Seu pai está desesperado procurando por você em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211312,
					"content": "Eu já disse a ele que voltaria na hora do jantar. Precisava mesmo te contar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Ainda respondendo? E vocês, crianças, parem de ficar aí embaixo. Quem sabe que perigos podem estar esperando se ficarmos aqui por muito tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211314,
					"content": "Você volta à superfície com Orqo e explica a situação...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "Ai, essas coisas que ele disse são só invenções de criança. Agradeço a vocês por entrarem na brincadeira com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211316,
					"content": "Essa criança não teve a mãe por perto desde pequena, e o pai tem problemas de visão, então ninguém pôde educá-lo adequadamente. Ele é bem travesso. Como vizinha, eu tento ajudar o máximo que posso, mas minha energia é limitada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211317,
					"content": "Ah, entendi. Paimon já sabia! Não pode ser tão fácil assim, conseguir um poder misterioso só coletando alguns fragmentos de pedra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Eu não estou sendo travesso, estou fazendo isso pelo meu pai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Seu bobo, você nunca escuta as pessoas que sabem mais do que você. Desta vez tudo ficou bem, mas e se um dia isso causar um grande problema? Aí será tarde demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211320,
					"content": "Tá bom, tá bom, agora volte para casa comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211321,
					"content": "#Tá bom, mas antes disso... {M#irmãos}{F#irmãs}, como prometido, toda essa Mora é de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Aceitem, por favor. Não podemos deixar que ele fique sem cumprir sua palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211323,
					"content": "Já que vocês insistem... não vamos recusar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Sim, talvez eu precise da ajuda de vocês novamente no futuro. Desta vez falhou, mas isso não significa que não teremos sucesso na próxima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Essa criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mamãe Coco"
				},
				{
					"id": 750211327,
					"content": "#Mamãe Coco, vamos embora para não deixar meu pai preocupado. Querid{M#o}{F#a}s {M#irmãos}{F#irmãs}, até mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Esses sintomas parecem um pouco familiares...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
