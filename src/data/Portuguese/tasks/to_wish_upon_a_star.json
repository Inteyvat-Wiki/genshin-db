			"dialogs": [
				{
					"id": 750210101,
					"content": "Ei, o que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "...Uau! Que susto! E se eu caísse, como você iria me compensar? Com meus poderes ocultos ainda não despertados, eu sou apenas uma criança indefesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Ah, desculpe, eu não quis te assustar. Mas... poderes ocultos? São tipo habilidades poderosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Já que é um poder oculto, como eu saberia o que ele realmente é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Isso faz sentido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Deixando isso de lado, vocês poderiam me ajudar a encontrar os fragmentos de estrela? Eu ajudo a Mamãe Coco normalmente e economizei bastante dinheiro. Toda essa Mora será de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Já que precisa de ajuda, pelo menos diga seu nome primeiro. A propósito, Paimon é Paimon, e {M#ele}{F#ela} é {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "#O nome que uso agora é apenas um codinome... Todos me chamam de Orqo, vocês também podem me chamar assim. Então, sobre os fragmentos de estrela, vocês estariam dispost{M#o}{F#a}s a ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Hmm, afinal, o que são exatamente esses fragmentos de estrela? Parece que não é algo que se encontra facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "São fragmentos que se dispersaram quando estrelas caíram do céu. Se conseguirmos encontrá-los e colocá-los de volta em seu lugar, poderemos recuperar o poder perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "#Vejam, a estrela que caiu do céu está logo ali embaixo. Com certeza podemos encontrar pistas dos fragmentos de estrela lá. Querid{M#o}{F#a}s {M#irmãos}{F#irmãs}, me ajudem, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Tá bom, tá bom, vamos te ajudar desta vez. Mas, falando nisso, esses fragmentos de estrela e poder perdido... parece coisa de história de aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "Vocês nunca ouviram a história de Qoyllor e Ukuku? Vou contar para vocês então. Meu pai me contou tantas vezes que eu já sei de cor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Mas o mais importante agora é irmos lá embaixo dar uma olhada juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Tão jovem, mas cheio de argumentos tortos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
