			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Ufa! Eu definitivamente não conseguiria descer sozinho. Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Essa é a estrela que caiu do céu? Vendo de perto assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Ah, uma energia misteriosa está surgindo dentro de mim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "O quê?! Sério? Espera, ainda não encontramos os fragmentos dispersos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Falando nisso, será que realmente há alguma pista dos fragmentos aqui? Não tenho a menor ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "O que devemos fazer agora então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Só podemos contar com força bruta agora. <color=#00E1FFFF>Usar a força de um Tepetlissauro</color> para dar um tapinha pode revelar onde estão os fragmentos dispersos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "#A maioria dos problemas pode ser resolvida com força bruta, foi o que meu pai disse. Mas eu ainda não despertei meus poderes, nem tenho meu próprio Sauriano... então vou deixar isso com vocês, {M#irmãos}{F#irmãs}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Que pedra estranha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Realmente é bem peculiar... Mas será que é a Paimon que é insensível? Paimon não sentiu nenhuma energia misteriosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
