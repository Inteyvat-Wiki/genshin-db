			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "Deixa Paimon ver! Hmm... Isso me parece ser um mapa do tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200102,
					"content": "Sério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "Heh! Paimon nunca está errada quando se trata de tesouros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200116,
					"content": "Hm, parece que o \"Ako Domeki e os piratas\" foram os responsáveis por deixar esta imagem para trás. Parece que já ouvi isso antes, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200104,
					"content": "Além disso, olhe só! \"O tesouro está escondido...\" Viu? Tem um tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200105,
					"content": "Vamos continuar lendo... \"...Foi dividido em quatro partes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200106,
					"content": "Então eles dividiram algo em quatro partes, hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200107,
					"content": "Então, tem quatro tesouros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "Paimon não... tem certeza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200110,
					"content": "Mas seja qual for o caso, diz bem aqui que existe algo que foi colocado \"em meio aos recifes das quatro grandes ilhas\". Isso deve estar mencionando os recifes das quatro ilhas do Arquipélago de Maçã Dourada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200111,
					"content": "Espera aí, esse não é um dos recifes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200112,
					"content": "Hmm, isso significa que devem ser quatro pistas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "E elas devem estar perto dos recifes nas quatro ilhas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200114,
					"content": "Hmm, isso deve estar se referindo as quatro grandes no arquipélago, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200115,
					"content": "Vamos dar uma olhada nas três ilhas e ver o que podemos encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790200108,
					"content": "Então, tem quatro pistas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
