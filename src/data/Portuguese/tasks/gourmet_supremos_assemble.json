					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Permita-me. Basicamente, você precisa procurar por algo próximo conhecido como Galho da Sakura do Trovão e tocá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "#Depois disso, algo conhecido como Electrogrão se prenderá a você, e {F#a}{M#o} permitirá a cruzar a barreira.",
					"roleType": "TALK_ROLE_NPC",
