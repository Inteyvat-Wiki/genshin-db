				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Ufa, que alívio. Parece que a situação do vulcão não é tão ruim quanto pensávamos. Acho que podemos dormir tranquilos hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "E é tudo graças a vocês, é claro. Se vocês não tivessem aparecido e nos ajudado sem guardar rancor, as coisas não teriam ido tão bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Por favor, aceite isso como uma demonstração de minha gratidão — e também como um pedido de desculpas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Hehe, bem, já que você falou dessa forma... aceitamos graciosamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "O que você planeja fazer agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Eu ainda tenho algumas mercadorias acumuladas. Operações normais devem colocar nossas finanças de volta ao caminho certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Claro que não estamos em uma emergência desta vez, então farei negócios de forma justa, não se preocupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"3"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_FINISHED"
