			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "Ei, ei, ei! Essas coisas são para vender. Se você não vai comprar, não toque— Huh... Ei, você! Sim, você de cabelo loiro — espera um segundo aí, não saia correndo. Deixa eu dar uma olhadinha em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "Hmm, bem como pensei. Esse cabelo, brilhando como o sol, e esses olhos, tão profundos quanto o Reino da Noite... Consigo perceber que — não, tenho certeza — que você vai se tornar alguém incrível um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "#Aqui, tenho um conjunto de ornamentos de jade maravilhosos, cada um contendo uma melodia diferente. Perfeitos para {M#um herói}{F#uma heroína} de verdade como você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "#Mas, esses são tesouros inestimáveis. Se mais alguém quisesse comprá-los, eu estaria pedindo por pelo menos 10 milhões de Mora. Mas, você estava destinad{M#o}{F#a} a ficar com eles, então pode ficar por apenas um décimo do preço. O que me diz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Nossa, um décimo!? Que descontão! Mas, espera aí... isso ainda não seria mais de um milhão de Mora? É um pouco demais, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "É, bem... isso é basicamente o preço de custo. Vendedores pequenos como eu não fazem muito lucro, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "Você realmente não deveria estar fazendo dinheiro assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Ah, então você ouviu tudo aquilo, né? Haha, acho que tenho o hábito de falar sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "*Suspira* Tá, já que você me pegou, serei sincero contigo. Encontrei este ornamento de jade por acidente. Nem de longe vale tudo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Mas, bem, como você ouviu, estamos meio apertados em dinheiro — tanto, que nem conseguimos pagar ninguém para coletar os dados das boias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "Bem, então apenas esqueça a coleção de boias! É melhor do que enganar as pessoas, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Não é possível... Outras organizações não podem apenas parar de operar pela falta de fundos, mas nosso trabalho voluntário também inclui observação de vulcões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "Colocamos aquelas boias para medir atividade vulcânica ao coletar dados da temperatura da água e coisas do tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Com o vulcão se tornando mais ativo, precisamos recuperar rápido aquelas boias, ou podem haver consequências sérias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Do jeito que estou ferida, não posso quebrar as boias, muito menos recuperar os dados delas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#O que você acha, {NICKNAME}? Por que não ajudamos ela? Essas coisas de vulcões afetam a todos, não podemos apenas ignorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "#S-Sério? Se você estiver dispost{M#o}{F#a} a me ajudar, esses ornamentos de jade serão todos seus, de graça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Você não havia mencionado um milhão de Mora...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Não se preocupe. Não temos muito, mas nós certamente temos mais a te dar do que só esses ornamentos de jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Hehe, são suficientes para nós! Afinal de contas, estamos fazendo isso pela segurança de todos próximos ao vulcão! Então, não se preocupe, deixa com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Bem, então vamos começar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Preciso me preparar antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Tudo pronto para ir a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "Oh, então isso é tudo que recebo como recompensa, hein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Não foi você quem disse que um ajudante vale um milhão de Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"2"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_UNFINISHED"
