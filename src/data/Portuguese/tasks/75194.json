				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "Dez, vinte... Vendi um monte de coisas, então nossas finanças devem estar boas por enquanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Você não vai tentar ganhar mais um pouco de Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "#Haha, não! Vou parar por agora! Se você não tivesse sido tão compreensiv{M#o}{F#a} e me ajudado, eu, com toda certeza, teria me metido em problemas só por alguns pedaços de jade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Além disso, ficar constantemente correndo atrás de dinheiro é entediante. É só um passatempo para mim. Observar o vulcão é o que realmente importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Podemos sempre fazer mais dinheiro, mas se um aviso de erupção não foi enviado por culpa nossa... isso seria uma enorme perda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "A Câmara de Discussões não te fornece financiamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Não fizemos nenhuma solicitação. Com todas as coisas que eles já precisam lidar diariamente, duvido que eles precisem do estresse adicional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Eu e meus companheiros são outra história. Estamos acostumados a financiar nossas próprias viagens ao aceitar uns bicos aqui e ali. Se tornou um estilo de vida, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Dessa forma, monitorar os vulcões enquanto viajamos não é nada de mais, assim como você normalmente costuma ajudar as pessoas necessitadas — vem naturalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Te vejo por aí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Hehe, cuide-se. Espero nos encontrarmos novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
