					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Se você estiver disposto a ajudar, você poderia, por favor, trazer um pouco de Condensado de Slime para mim?",
