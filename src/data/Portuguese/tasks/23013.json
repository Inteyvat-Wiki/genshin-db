					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Já que você está aqui, não preciso voltar para a cidade para contratar pessoas. Agora que ganhei um pouco de dinheiro, posso te oferecer um pagamento melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
