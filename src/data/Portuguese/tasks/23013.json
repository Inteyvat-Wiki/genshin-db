			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "Você conseguiu pegar o Condensado de Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Consegui, bem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Excelente! Deve ser suficiente. Assim que voltar farei os testes. Com este lubrificante minha Aritmeticadora certamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Lutong, tenho que ir fazer alguns testes, deixarei o resto com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Sim, senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "Esta é sua recompensa, Viajante, muito obrigado pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "E hmm... Na minha humilde opinião, talvez precisemos da sua ajuda no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "#Não se preocupe, enquanto eu estiver encarregado de gerenciar as finanças, você sempre será recompensad{F#a}{M#o} de forma justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "*Suspiro*... Decidi viajar com o Sr. Garcia porque não queria viver como meus pais, não queria passar a vida inteira gerenciando as finanças do Ministério dos Assuntos Civis de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Mas agora... Além de fazer cálculos com o Sr. Garcia, não faço nada além de administrar suas finanças...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Talvez seja isso que as pessoas chamam de destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301311,
