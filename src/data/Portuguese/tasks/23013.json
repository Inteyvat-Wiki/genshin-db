			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, nossas economias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "Sempre poderemos encontrar uma saída, Sr. Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "Em Liyue, temos um ditado: \"Quando seu caminho está bloqueado por uma montanha, existirá um caminho em volta.\" Acho que isso descreve perfeitamente nossa situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Este ditado significa que quando nosso caminho é bloqueado por uma montanha, sempre podemos encontrar uma maneira de atravessá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Aha! Uma analogia muito inteligente. Suponho que não estamos em uma situação tão ruim assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Sr. Garcia, você acha que a pessoa que inventou esse ditado encontrou o caminho para atravessar a montanha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Hm? Qual é Lutong, não dê azar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
