			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Mais uma vez, Sr. Garcia, sugiro sinceramente vender alguns livros para ganhar um pouco de Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "Não! De modo algum! Querido Lutong, é como pedir para vender minha alma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Senhor, para ser honesto, ninguém está interessado em comprar almas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Você ainda está aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "Viajante? O que te traz aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "Ugh... O meu último experimento falhou. O meu método de diluição do Condensado de Slime deve ter algo de errado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "O lubrificante que fiz não tem a capacidade de lubrificar os rolamentos da minha Aritmeticadora, pelo contrário, eles ficaram ainda mais rígidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "É por isso que preciso de mais Condensado de Slime, para poder fazer mais testes. Você poderia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "#Estou contando com você para conseguir mais Condensado de Slime, e é claro que vou recompensá-l{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Vocês não têm uma maneira de ganhar Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Não é que não tenhamos maneiras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "É uma questão de habilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Muito obrigado pela sua contribuição, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "Bem, é certamente uma pena... Embora eu tenha terminado de construir a Aritmeticadora, suas funções são incalculavelmente abaixo do esperado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "Ela nem sequer funciona bem como uma calculadora automática, necessitando de auxílio manual para facilitar sua operação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Mas... vou aperfeiçoá-la! Estou totalmente convencido de que minha Aritmeticadora se tornará uma invenção incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Uma... Uma invenção que ficará para a história! E depois, eu definitivamente terei uma maneira de ganhar Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "M-mas antes disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Você precisa de mais Condensado de Slime?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
