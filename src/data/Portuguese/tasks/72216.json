					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "Você está aqui. O humano de pedra diz que está quase pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160102,
					"content": "Venha comigo. O humano de pedra está logo ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei",
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Ufa, está quase pronta. Esse foi o maior trabalho que já fiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160202,
					"content": "Oh, é você, e a Senhorita Sacerdotisa também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160203,
					"content": "Como está? A estátua está completa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160204,
					"content": "Está sim, como você pode ver, hehe! Na verdade, deixei um pouco mais de pedra aqui - estava apenas esperando que a Senhora Sacerdotisa voltasse antes de esculpi-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160205,
					"content": "Isso foi muito atencioso da sua parte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "Mas, é claro. Afinal, as estátuas dos santuários devem ser tratadas com a maior formalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160207,
					"content": "Miau, miau, bater na pedra é uma coisa tão importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160208,
					"content": "Bem, como devo dizer isto... Normalmente, as coisas que transformamos em estátuas são todas muito importantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160209,
					"content": "Sabe, Paimon, você provavelmente deveria pedir para fazer uma estátua de comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "Ei! Que grosseria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722160211,
					"content": "Então... Você faz estátuas de coisas boas, você quis dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160212,
					"content": "Hahaha! Bem, eu diria que são muito mais do que apenas \"boas\"! Afinal de contas, pode-se dizer que estátuas são o que se chama de \"memoriais para a eternidade\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160213,
					"content": "Não, não, isto não é um \"memorial para a eternidade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160214,
					"content": "Eu só desejo que caso Hibiki se perca em seu caminho para cá, poderá ver a estátua e encontrar o caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160215,
					"content": "Dessa forma, ela saberá para onde ir e não se perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160216,
					"content": "O-Oh, entendo. Senhora Sacerdotisa, você realmente se importa muito com essa tal de \"Hibiki\", não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160217,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Afinal de contas, a Hibiki estará de volta a qualquer momento. Além disso, ela e Domeki disseram que algo bom aconteceria uma vez que a pedra estivesse completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160219,
					"content": "Bem, então, humano de pedra. Você precisa de mim para fazer mais alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160220,
					"content": "Bem, na verdade não... Bem, já que você está aqui, Senhora Sacerdotisa, eu posso tirar esse último pedaço de pedra agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160221,
					"content": "Três... dois... um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160222,
					"content": "O qu-O que é essa nuvem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160223,
					"content": "Ela se transformou na forma de um gato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "É a Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160226,
					"content": "Er?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160228,
					"content": "Miau, miau, miau! Deve ter sido a Hibiki! Uma coisa boa aconteceu, assim como ela disse que aconteceria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160229,
					"content": "É exatamente como ela disse, é exatamente como ela me disse! Uma coisa boa aconteceria se essa pedra fosse completada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160230,
					"content": "Maravilhoso, isto é maravilhoso! O que ela disse era verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160231,
					"content": "Sim, ela certamente voltará!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160232,
					"content": "Hoo... Viva! Hahaha, eu não sei exatamente o que está acontecendo, mas dado o quanto a Senhora Sacerdotisa parece satisfeita, isto deve ser de fato uma coisa boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160233,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Com sua ajuda, o santuário está lindo novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160235,
					"content": "A Caixa de Oferendas foi reparada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160236,
					"content": "O Suporte de Placa de Oração também foi consertado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160237,
					"content": "E a pedra também foi construída! Agora, Hibiki definitivamente voltará, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160238,
					"content": "E Domeki, Janome, e todos os amigos da Hibiki também! Eles voltarão com ela com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160239,
					"content": "Você... Você é uma boa pessoa! Melhor que aquela refeição! Hibiki vai gostar de você com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160240,
					"content": "Eu devo chamar todos aqueles malandros juntos e fazer planos para o seu retorno. E... Sim, é claro, claro, as muitas pessoas que virão visitar o santuário. Eu também terei que dar instruções a respeito disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160241,
					"content": "E há todos esses outros assuntos que devem ser resolvidos primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160242,
					"content": "Oh, Hibiki... Miau, miau, miau! Isto é maravilhoso, maravilhoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160224,
					"content": "O que está acontecendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "Haha, a Senhora Sacerdotisa está muito contente. Essa \"Hibiki\" deve ter sido realmente alguém de grande importância para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160302,
					"content": "O problema é que não sabemos onde ela está...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Etsuko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "De fato, \"Hibiki\", \"Santuário Asase\", \"Domeki\"... Todos esses nomes são, na verdade, bastante preocupantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160402,
					"content": "E de onde vocês saíram?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Bem, vocês estavam fazendo tanta barulheira, então é claro que nós viemos até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160404,
					"content": "Ainda assim, há algo que eu acho que você deva saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160405,
					"content": "Taisuke, se você puder fazer as honras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160406,
					"content": "Ah certo, é claro, Srta. Etsuko. Então, o que vamos dizer... Diz respeito à Ilha Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "A história deste lugar é muito obscura e, embora a Guilda tenha tentado pesquisar especificamente por informações a respeito dele, encontramos muito pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "De acordo com as informações que conseguimos obter, este era um local de reunião de piratas há vários séculos. Então, foi o Shogunato quem expulsou todos os piratas e mudou os habitantes para outros lugares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "A menos que eu esteja enganado, esse \"Domeki\" de que falamos pode muito bem ter sido o líder pirata \"Ako Domeki\", que escolheu lutar contra o Shogunato. Os registros mostram claramente seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "De acordo com a mesma informação que temos, este Ako Domeki liderou sua frota pirata em uma batalha naval contra o Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "Eles foram rapidamente reprimidos e forçados a fugir de volta para a Ilha Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "Mas enquanto a frota do Shogunato o perseguia, uma tempestade repentina irrompeu na Ilha Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "A frota de Ako Domeki e a do Shogunato foram pegas pela tempestade que se seguiu... e foram perdidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "Uma tempestade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Vou cuidar das coisas a partir daí. O maior mistério aqui, é claro, é o surgimento repentino dessa tempestade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160417,
					"content": "Embora a frota de Ako Domeki também tenha sido atingida pela tempestade e quase exterminada, a frota enviada pelo Shogunato também foi quase perdida, e as pessoas remanescentes foram forçadas a recuar para a Ilha Narukami. Levaria muito tempo até que a frota estivesse pronta novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160418,
					"content": "O surgimento daquela tempestade foi certeiro. Quase como se... alguém a estivesse controlando especificamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160419,
					"content": "Tenho certeza de que você se lembra das Pedras Sagradas nesta ilha. Os selos delas foram quebrados propositalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160420,
					"content": "E assim que os selamos novamente, a tempestade na ilha se acalmou mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160421,
					"content": "Não vou tirar conclusões precipitadas, mas meu instinto diz que esses incidentes definitivamente estão relacionados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160422,
					"content": "Bem, poderíamos perguntar para a Senhora Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "...Eh, eu diria para deixar pra lá. O registro afirma que Domeki desapareceu - bem, é o que diz de qualquer maneira, mas se ele foi atingido por aquela tempestade, ele provavelmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160424,
					"content": "Continuaremos explorando esta ilha e coletando mais informações sobre esse incidente por um tempo, e depois informaremos a Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160425,
					"content": "Quem sabe? Talvez tenhamos o prazer de trabalhar juntos novamente um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160426,
					"content": "#Estou ansios{M#o}{F#a} por isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "O sentimento é mútuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160428,
					"content": "Bem, Taisuke, vamos nos preparar. Temos algumas explorações a fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160429,
					"content": "Então, Srta. Etsuko, sobre a Srta. Neko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "Você pode continuar tratando aquele gato da mesma forma que antes, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160431,
					"content": "Só lembre-se de não dizer nada que você não deva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160432,
					"content": "Ela deve estar feliz agora, não diga nada que estrague o dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160433,
					"content": "Entendi Haha, Srta. Etsuko, você realmente é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "...Apenas tentando terminar nossas comissões de forma mais eficiente. Vamos lá, vamos ao trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160435,
					"content": "Ilha Seirai... Parece que este lugar ainda está cheio de muitos mistérios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722160407,
					"content": "Você sabe de alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}