				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "Obrigado pelo seu trabalho. Apesar das ilhas ainda estarem em perigo, graças a você, pessoas que saíram de sua cidade natal ganharam um pouco de sua fé de retornar para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Apesar da chuva ter parado, os lados combatentes podem estar até mais agressivos ao lutar pela ilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Mas já que eles não terão tempo para mudar a situação na ilha, o que nós fizemos é melhor que deixar se deteriorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Bem, esse é o presente de agradecimento que eu lhe prometi antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Essa é a famosa lança usada pelos Guardiões Yashiori. Não sei quanto uso esse desenho aqui terá para você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Mas se você der ele para um ferreiro suficientemente hábil, ele deve ser capaz de recriar a glória que tinha nas mãos do Senhor Kitain...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*Suspiro* A era dos heróis chegou e acabou, e os Kitain, que antes destruíram muitos males, jamais retornarão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Entretanto, parece que estamos um passo mais próximo de alcançar os feitos do Senhor Kitain no presente, graças à sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Em seguida, eu irei encontrar com meus amigos no exército do Shogunato para ver se posso ajudar com algo. Espero poder ver você de novo no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
