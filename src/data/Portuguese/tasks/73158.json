			"dialogs": [
				{
					"id": 731580101,
					"content": "\"...Idade do paciente: 65. Gênero: Masculino...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580102
					],
					"speakerTitle": "Ficha médica de Khayyam"
				},
				{
					"id": 731580102,
					"content": "\"Sintoma: Dismnésia de curto prazo. Piora com o tempo. Emocionalmente instável, ficava falando sobre adolescência e memórias de infância...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580103
					],
					"speakerTitle": "Ficha médica de Khayyam"
				},
				{
					"id": 731580103,
					"content": "\"... Doença cerebral de causa desconhecida. Os resultados do exame mostram que as células cerebrais do paciente estão inativas desde os 60 anos, o que significou uma perda gradual da sua memória\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580104
					],
					"speakerTitle": "Ficha médica de Khayyam"
				},
				{
					"id": 731580104,
					"content": "\"... Um pedido de aposentadoria foi submetido ao Darshan Amurta da Academia de Sumeru, na esperança de que uma vida estável e confortável e um ambiente psicológico pudessem retardar a deterioração da condição do paciente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580105
					],
					"speakerTitle": "Ficha médica de Khayyam"
				},
				{
					"id": 731580105,
					"content": "\"Os Amurta anuncia que o sábio Siman Farrokhzad será pessoalmente responsável pelo tratamento do paciente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ficha médica de Khayyam"
				}
			]
		}
	]
