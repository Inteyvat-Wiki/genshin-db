			"dialogs": [
				{
					"id": 740660201,
					"content": "A \"Arte da Negociação\"...? Hunf! Até o título é chato! Paimon não tá interessada nisso... hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Hein? Tem uma nota aqui? Hmmm... \"Vá ao balcão de registro na recepção para participar da Pesquisa de Satisfação Interna do Refeitório Coupon para uma chance de ganhar Cupons Especiais...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "Cupons Especiais... Opa! Viu isso? A gente pode ganhar Cupons! Paimon não esperava algo tão bom assim! Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
