					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "É mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411108,
					"content": "Falando nisso, como é que Canotila ainda não deu as caras? Será que ela não foi até os guardas da Corte de Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411109,
					"content": "#...Vamos voltar depois. Estou meio tont{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "Sim, é melhor. Quer comer alguma coisa? Você deu um susto tão grande em Paimon que ela ficou com fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411111,
					"content": "Pera, foi só um piscar de olhos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "Paimon ficou super-híper-preocupada com você!",
