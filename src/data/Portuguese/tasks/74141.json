			"dialogs": [
				{
					"id": 741410101,
					"content": "(O conteúdo nas páginas ainda consiste em símbolos, letras, línguas antigas e figuras geométricas incompreensíveis. Mas ao se focar por um certo tempo, tudo parece gradualmente se tornar compreensível.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Ler"
				},
				{
					"id": 741410102,
					"content": "Canotila não parece estar aqui. Talvez ela esteja naquele lugar misterioso de novo! A gente vai começar a meditar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Ouvindo o que ela disse da última vez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "#Estou um pouco preocupad{M#o}{F#a}. Vou checar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "#Bem... isso é meio preocupante, mas vamos junt{M#os}{F#as}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon, por que você não me espera aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "O mundo do Livro da Revelação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "Pode ser mais perigoso do que imaginávamos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "Então eu não quero que você se arrisque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "#Mas... estamos nessa jornada junt{M#os}{F#as} esse tempo inteiro, não é? Não existe dificuldade que não possamos superar e nenhum inimigo que não possamos derrotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "Os perigos lá dentro podem não ser algo que apenas a força possa resolver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "Certo. Bem, você é mais inteligente que Paimon, então Paimon confia em você. Apenas não abandone Paimon! Paimon vai esperar bem aqui até você voltar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Talvez tenha um lado dele que não conhecemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
