				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "Cada um de nós tem seu próprio caminho a trilhar. Não é preciso dizer mais nada. Aliás, este chá é muito bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Cara do Chapéu"
				},
				{
					"id": 733560202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560204,
					"content": "Tudo bem, tchau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cara do Chapéu"
				},
				{
					"id": 733560203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
