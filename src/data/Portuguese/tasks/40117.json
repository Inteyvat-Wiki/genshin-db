					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401171502,
					"content": "Mas, assim como a Grande Estrategista disse... Se pudermos restaurar o domínio, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
