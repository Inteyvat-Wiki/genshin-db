			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "Ei Kaeya, você prometeu me contar a história sobre a Jinni na garrafa se eu não fugisse. Lembra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ah, sim. Tudo bem, onde paramos...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Oh, eu lembro! A Jinni saiu e estava prestes a comer o menino pastor que abriu a garrafa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Certo, conforme a Jinni abria sua grande e ameaçadora boca, o menino pastor de repente teve uma ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Ele arremessou uma Bomba Saltitante na boca da Jinni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha, tenho certeza que ele faria isso se tivesse uma Bomba Saltitante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Mas o menino pastor não fez nada do tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Ele falou para a Jinni, \"Espere, como o seu corpo gigante coube dentro de uma garrafa tão pequena? Eu jamais acreditarei a não ser que veja com meus próprios olhos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "A Jinni ficou com raiva e disse, \"Mwahaha. Menino tolo, ousa questionar meus poderes?!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "A Jinni então retornou para dentro da garrafa e o menino a fechou rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Oba! Isso significa que a Jinni nunca mais vai sair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Mas, a Jinni consegue dormir dentro de uma garrafinha tão pequena? Não deve ser muito confortável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "Não, mas a Jinni foi capturada e selada na garrafa por que ela fez muitas coisas ruins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "Então a coisa mais importante de se lembrar é, se você for fazer algo ruim e não quer ser aprisionada, não seja pega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
