			"trigger": {
				"objectNames": [
					"Collei",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Klee disse que descobriram uns trilhos misteriosos que você pode viajar usando um \"Carrinho Piuí super divertido\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Ah, eu também ouvi sobre isso. Aparentemente é um carrinho que viaja por uma rota \"aterrorizante\" a uma velocidade \"incontrolável\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "É, deve ser esse. Parece que quando o carrinho desce uma ladeira íngreme, seu corpo começa a flutuar como se não pesasse nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Sério? Hmm, eu soube que a mochila de Klee quase voou na viagem. Se Kaeya não tivesse a pego rapidamente, várias Bombas Saltitantes teriam sido jogadas ao ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Ah não, isso parece bem perigoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*Suspiro* Mas, se você quiser ir mesmo em um passeio, eu te acompanho se tiver tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Hã? Mas Eula, como você sabia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "Eu percebi que você queria experimentar... Mas deixe-me esclarecer uma coisa, eu não vou te ajudar a pegar nada que voar do carrinho. Então é melhor você se lembrar de tirar tudo dos seus bolsos antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Ah, sim, claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
