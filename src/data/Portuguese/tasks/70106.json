			"dialogs": [
				{
					"id": 701060401,
					"content": "Sobre a carne do Grande Rei Javali da Neve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060402
					]
				},
				{
					"id": 701060402,
					"content": "Oh, você conseguiu a carne do Grande Rei Javali da Neve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060403
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060403,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060404
					]
				},
