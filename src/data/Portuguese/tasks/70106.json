			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Faltam apenas mais alguns ingredientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "Hmm? Ah, viajante. Estou dando os toques finais em uma receita antiga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Há pouco tempo, uma equipe de exploradores saiu em uma expedição para as montanhas. Um deles é um amigo meu, um aventureiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Não foram muito longe devido às condições meteorológicas ruins. Mas meu amigo me contou que eles encontraram uma ruína ancestral enquanto se protegiam da tempestade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Estava cheia de livros e outros documentos. Até... até mesmo uma receita. Não sei como ela permaneceu intacta por tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Meu amigo aventureiro entregou a receita para mim. Ele quer que eu recrie o gosto do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Na verdade, nunca ouvi falar de alguns dos ingredientes da receita. Até mesmo algumas das técnicas culinárias são novas para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Então estou cozinhando uma versão modificada que usa apenas os ingredientes mais essenciais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "Estaria disposto a me ajudar a reunir os ingredientes incomuns da receita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Deixa comigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "É bom ver você tão entusiasmado com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Ouvi dizer que alguns javalis se perderam nas montanhas e ficaram presos no gelo... Estou curioso para saber como isso afeta o sabor da carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Talvez você possa me trazer dez porções de Carne Fresca Fria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Para esclarecer, você quer dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Sim, a carne daqueles javalis congelados. Deve estar bem fresca com todo aquele gelo, não acha? Quando alguém me fala sobre um pobre javali preso no gelo, tudo que ouço é \"Carne Fresca Fria\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Obrigado por fazer isso por mim. Venha me encontrar assim que tiver os ingredientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "Quais ingredientes você precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
