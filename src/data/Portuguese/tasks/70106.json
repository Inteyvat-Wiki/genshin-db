			"dialogs": [
				{
					"id": 701060201,
					"content": "Aqui está a sua Carne Fresca Fria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Uau, essa Carne Fresca Fria parece ótima... Agora preciso encontrar apenas mais um ingrediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Você já ouvir falar no Grande Rei Javali da Neve? Dizem que é uma besta feroz que vive nas profundezas da Montanha Nevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "De acordo com as receitas, a carne do Grande Rei Javali da Montanha é de ótima qualidade. Seja frita ou cozida, fará um ótimo prato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "Viajante, poderia fazer esta tarefa para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Posso saber o que ganho com isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Não se preocupe, tenho algo reservado para quando você retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
