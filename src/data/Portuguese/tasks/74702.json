			"dialogs": [
				{
					"id": 747020101,
					"content": "Ah, vocês têm trazido tantos peixes ultimamente. O aquário está começando a parecer um verdadeiro habitat oceânico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020102,
					"content": "#Hehe, a gente já é praticamente pescador{M#es}{F#as} profissionais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "Vocês parecem ter muito orgulho do seu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020104,
					"content": "Pode apostar! Mas por trás da sensação de realização, tem mais alguma coisa... algo tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Arrependimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "É isso! É exatamente assim que Paimon tá se sentindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Por que isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020109,
					"content": "Paimon não tem certeza... É só que parece que tá faltando alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Talvez um restaurante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Ei! Não fale uma coisa dessas! Como alguém poderia ter coragem de comer peixinhos tão lindos!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Estamos sem visitantes para vir e admirar nosso trabalho incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Você está querendo dizer... que quer abrir o aquário para visitantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020116,
					"content": "Isso não seria bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Tá preocupada que fique barulhento demais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Se é esse o caso, pode deixar tudo com a gente! Nós cuidamos da divulgação e de todo o trabalho cotidiano, você só precisa focar no seu próprio trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "Se é isso que vocês querem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020121,
					"content": "Podemos dividir os ganhos 30/70!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Hã...? A gente só fica com 70%?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "Não, Sandrone fica com 70%.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Ah, certo, claro... Foi Sandrone que alugou esse barco, né...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Ugh, vocês tão me fazendo parecer algum tipo de senhoria tirana. Vocês tão fazendo o trabalho, então deveriam ficar com a maior parte. Eu não sou mão de vaca que nem Pantalone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020126,
					"content": "Então isso significa... que você tá nos dando sua aprovação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Claro, vocês têm minha permissão. Desde que não atrapalhe minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020128,
					"content": "Uhuuul! O Aquário da Diversão Glub-Glub Wingalet tá oficialmente aberto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*Suspiro* Claro que você já pensou em um nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747020118,
					"content": "Tá preocupada que cause problemas demais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Talvez visitantes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Ah! É isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "Solidão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}