			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "Jamais pensei que Dragartos conseguissem ficar tão grandes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Pff! Afinal, eles não passam de bárbaros. Não seria surpreendente se eles se transformassem em algo muito mais estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Osse"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
