				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monsieur Osse"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "Falando nisso, Neuvillette não é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Isso mesmo! Neuvillette é o Dragão Hydro, não é? Isso não significa que esse cara é até mais velho do que ele, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "Um novo Dragão da Água já nasceu? Bem, já faz muito tempo desde que a antiga Dama de Muitas Águas se foi... Tanto tempo se passou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monsieur Osse"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monsieur Osse"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "De qualquer forma, o dragão malvado Scylla já foi amigo do Sebastos, mas, na verdade, ele se revoltou em um momento crítico na disputa entre os Remurianos e o... povo de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832302,
					"content": "Naquela época, Scylla liderou os brutais descendentes dos dragões até Machimos, com a intenção de invadir a cidade interior, o Capitólio, onde Sebastos residia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832303,
					"content": "Machimos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Sim, as pessoas na cidade sempre falavam sobre esse tal de Machimos, e uma torre do sino ou algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Correto. \"Machimos\" é a cidade exterior da capital, mas se o dragão maligno desejar entrar na cidade interior, ele deve passar pelos Initium Iani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832307,
					"content": "Essa é a barreira que separa as partes interna e externa da capital, e a Sinfonia tecida pelo Sebastos e pelos músicos, que cobriam toda Remuria, passava pelos Initium Iani e seus canais de água dourada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832308,
					"content": "Boethius e suas legiões usaram esse fato para fechar os portões, selando o dragão maligno finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832309,
					"content": "Talvez Scylla tenha buscado ir diante do trono do Sebastos, mas tal oportunidade está agora perdida para sempre. Depois disso, o dragão maligno afundou com Remuria, e o Sebastos também foi perdido, permanecendo assim até hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832310,
					"content": "(Algo não tá certo nessa história...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#Você lembra de alguma coisa, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832314,
					"content": "Isso tudo parece bem caótico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Isso é verdade... Só fiquei sabendo do assunto depois que já tinha acontecido, pois não estava na capital quando o desastre ocorreu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832316,
					"content": "Naquela época, ninguém sabia realmente o que tinha acontecido com o Sebastos. Receio que só possamos aprender mais se continuarmos avançando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832317,
					"content": "Os grandes peixes brilhantes que vimos no castelo devem ser os pensamentos que escaparam das fendas na cela de pedra de Scylla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832318,
					"content": "Temo que ele já tenha percebido nossa presença. Tendo sido selado aqui por tanto tempo, agora que ele finalmente detectou estranhos, naturalmente encontrará uma maneira de nos atrair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832319,
					"content": "Então é isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Espera um minuto! Você disse que o caminho para o palácio dourado é por esses portões, mas Boethius já não fechou eles? Isso não quer dizer que não tem como passar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "Isso vai ser bem difícil, sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832322,
					"content": "Argh, tem que ter um limite de quão mal-educado você pode ser! O que é isso de \"Vou esperar vocês no palácio dourado, mwahahaha!\" se você nem deixa a porta aberta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Sabe, por que a gente não acha algum jeito de quebrar o selo do dragão e fazer esse inimigo que já foi derrotado arrombar a porta pra gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "Não! Como a gente poderia fazer isso?! Digo, no fim, esses são os inimigos odiados de Remuria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832325,
					"content": "Mas o inimigo do meu inimigo é meu amigo, não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "É mesmo. Já faz tempo demais. Até onde você sabe, ele pode ter decidido mudar de vida e ser um dragão legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Mas ele ainda é um dragão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Monsieur Osse"
				},
				{
					"id": 741832329,
					"content": "#Ah, qual é, e daí? Mesmo que ele seja um dragão, ele pode ser razoável e querer conversar. A gente tem experiência em lidar com dragões, não é, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832326,
					"content": "Bem, mas Remuria não existe mais, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "(O cenário dos sonhos de antes... Naquela época...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832312,
					"content": "(Scylla veio ver Remus...)",
