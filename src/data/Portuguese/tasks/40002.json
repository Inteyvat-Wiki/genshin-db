			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "Ohhh... Essas amostras de Azurite e Vermillionite estão em ótima qualidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020502,
					"content": "#Obrigada a vocês {F#duas}{M#dois}. Aqui está o pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020503,
					"content": "Cada esforço de vocês ajudará a deixar o Ritual da Lanterna mais brilhante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020504,
					"content": "Já que vocês vão ficar em Liyue durante o festival, lembre-se de conferir a Lanterna Mingxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020505,
					"content": "À medida que o progresso avança, o local da fabricação no porto fica cada vez mais movimentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020506,
					"content": "#Soa interessante. {NICKNAME}, que tal darmos uma conferida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000214,
