			"trigger": {
				"objectNames": [
					"Huixin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "OH, olá, vocês dois. Muito obrigado pela suas doações no Ritual da Lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020202,
					"content": "Hoje, eu tenho um assunto para tratar. Precisamos fazer compras, vocês têm interesse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020203,
					"content": "Hum? Melhor do que trabalhar de graça como a última vez, eu tenho interesse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020204,
					"content": "Haha, maravilha! Agradeço a ajuda. Agora, deixe-me explicar a situação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020205,
					"content": "Eu preciso de dois tipos de Plaustrite para usar no festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020206,
					"content": "Uma é chamada de Azurite. É encontrada ocasionalmente na parte norte do Monte Tianheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020207,
					"content": "Quando a Azurite é colhida nas raízes de vegetações comuns, às vezes produz frutas Peng, que possuem sementes flutuantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020208,
					"content": "A outra e chamada de Vermillionite, que é extremamente perigosa para a maioria das pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020209,
					"content": "Nas Planícies de Guili, Caçadores das Ruínas que perderam o poder da luz, usam Vermillionite para manter-se no ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020210,
					"content": "Entendido! Azurite e Vermellionite, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400020211,
					"content": "(Na verdade elas são apenas variedades azuis e vermelhas de Plaustrites. Os comerciantes de Gemas apenas deram uns nomes chiques para impressionar os clientes...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 400020212,
					"content": "Isso mesmo, não se esqueça de trazer uma de cada para mim. Boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixin"
				}
			]
		},
