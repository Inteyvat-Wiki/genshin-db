			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling Punho Veloz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210201,
					"content": "Como é possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210202
					],
					"speakerTitle": "Ling Punho Veloz"
				},
				{
					"id": 718210202,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210203
					]
				},
				{
					"id": 718210203,
					"content": "Eu... *Suspiro* Meu mestre disse que recentemente descobriu uma nova técnica de chute, é incrível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210204
					],
					"speakerTitle": "Ling Punho Veloz"
				},
				{
					"id": 718210204,
					"content": "Ele disse que minha motivação não é suficientemente sincera. Não sou excelente nos aspectos básicos e ele não quis me ensinar a técnica do chute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210205
					],
					"speakerTitle": "Ling Punho Veloz"
				},
				{
					"id": 718210205,
					"content": "Mas agora quero aproveitar o Ritual de Lanternas para oferecer uma Lanterna Celeste a meu mestre. Não sei se quando ele estiver com melhor humor quererá me ensinar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210206
					],
					"speakerTitle": "Ling Punho Veloz"
				},
				{
					"id": 718210206,
					"content": "Mas não encontrei nenhuma Plaustrite. Vi uma Lanterna Celeste presa ali e queria pegar a Plaustrite dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210207
					],
					"speakerTitle": "Ling Punho Veloz"
				},
				{
					"id": 718210207,
					"content": "E esse foi o resultado... *Suspiro* Não quero mais a Lanterna Celeste, você pode pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210208
					],
					"speakerTitle": "Ling Punho Veloz"
				},
				{
					"id": 718210208,
					"content": "Inesperadamente, fiquei assim devido aos monstros. Preciso de aperfeiçoar minhas habilidades básicas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ling Punho Veloz"
				}
			]
		},
		{
			"id": 7182103,
