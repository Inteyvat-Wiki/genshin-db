			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210101,
					"content": "Como é que me atribuíram esse trabalho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210102
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210103
					]
				},
				{
					"id": 718210103,
					"content": "Viajante, você talvez não entenda, as Lanternas Celestes do Ritual de Lanternas todos os anos precisam ser recolhidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210104
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210104,
					"content": "Apesar de ser bonito quando as Lanternas Celestes são lançadas, há muitos problemas depois de elas voarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210105
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210105,
					"content": "As cúpulas de algumas lanternas não foram bem fabricadas, então quando estão voando, as cúpulas ficam danificadas e apenas um pedaço de Plaustrite acaba ficando voando no ar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210106
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210106,
					"content": "Algumas Lanternas Celestes são levadas pelo vento e ficam presas em cantos estranhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210107
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210107,
					"content": "Assim, em primeiro lugar, são um perigo para a segurança e, em segundo lugar, afetam a aparência da cidade, por isso o Ministério dos Assuntos Civis sempre envia um responsável para recolher essas Lanternas Celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210108
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210108,
					"content": "Esse ano é a minha vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210109
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210109,
					"content": "Mas o número de Lanternas Celestes soltadas durante o festival é muito grande... Se eu deixar todas se empilharem até o fim do festival, eu ficarei muito ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210110
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210110,
					"content": "Portanto, só me resta pegar as que caíram em cantos estranhos enquanto todos ainda estão soltando elas para voarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210111
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210111,
					"content": "Mas nesse ritmo, eu sozinho já estou muito ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210112
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210112,
					"content": "Viajante, se você quiser me ajudar, poderia ir ver alguns lugares se há Lanternas Celestes que precisam ser recuperadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210113
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210113,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210114
					]
				},
				{
					"id": 718210114,
					"content": "Marquei os locais no mapa para você. Obrigado por sua ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182102,
