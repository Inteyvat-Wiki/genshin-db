					"Hongyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718210301,
					"content": "Que tal? Tem algum lugar onde é preciso coletar Lanternas Celestes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210302
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210302,
					"content": "Recuperei três Lanternas Celestes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718210303
					]
				},
				{
					"id": 718210303,
					"content": "Muito obrigado. Recuperar as Lanternas Celestes é um trabalho muito cansativo. Todas as vezes eu fico muito cansado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718210304
					],
					"speakerTitle": "Hongyu"
				},
				{
					"id": 718210304,
					"content": "Graças a sua ajuda, eu posso descansar um pouco. Ah sim, aqui está sua recompensa, obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongyu"
				}
			]
		},
		{
			"id": 7182104,
