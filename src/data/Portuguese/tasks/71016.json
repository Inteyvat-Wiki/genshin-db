			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "Sobre o Tesouro Sem Nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Esta coisa que você trouxe... Parece muito boa. Este padrão também parece bastante antigo. Espere enquanto eu abro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Existem alguns defeitos aqui e ali, mas se você está com pressa de vender, posso oferecer-lhe um preço. Vai ser justo, mas não vai ser alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Acabei de dar uma olhada neste aqui. Estas marcas são definitivamente as de Liyue, e você pode ver aqui inscrita uma anedota sobre Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Dizem que Azhdaha foi um dragão gerado pela concentração dos espíritos do Geo em Liyue, e que nem mesmo Rex Lapis podia facilmente subjugá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Rex Lapis convocou assim três Adepti em seu auxílio, e juntos criaram um reino cheio de cavernas .",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "O Rex Lapis então lutou contra o Azhdaha, atraindo-o para a caverna, ordenando os Adepti selarem a entrada, e finalmente conseguiu subjugá-lo dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Os padrões nesta coisa que você trouxe parecem descrever os três Adepti que dão as mãos para criar a caverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Acho que deveria haver pelo menos três relíquias deste tipo. A combinação das três deve nos dar o item completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Você sabe tantas coisas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Bem, eu troco itens de todos os tipos. Um pouco de conhecimento geral aqui e ali não faz mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Ah! Me perdoe se estou divagando. Como eu disse, este objeto contém três peças. O valor cai bastante se estiverem separadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Mas se você pudesse reunir todos os três, seria uma história diferente. Mas isso parece ser bastante antigo. Reunir todos os três pode ser uma tarefa difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue é realmente um lugar misterioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Agora isso eu não tenho certeza, mas um senhor me disse que Liyue é realmente muito vasta com uma história incrivelmente ainda maior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Não se surpreenda se você encontrar relíquias estranhas em Liyue. O que sabemos da longa história de Liyue não é senão uma única gota no vasto oceano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
