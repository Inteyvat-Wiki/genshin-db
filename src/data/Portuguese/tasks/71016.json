				"points": []
			},
			"dialogs": [
				{
					"id": 710160301,
					"content": "Sobre o Tesouro Sem Nome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "Se meu palpite não estiver errado, o objeto que você trouxe anteriormente é um de três.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "Ele só estará completo quando todos os três objetos estiverem reunidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "Se você conseguir encontrar todos eles, eu estarei mais do que disposto a lhe fazer uma oferta generosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "Receio, porém, que sejam de uma época muito antiga e que reuni-los... Possa ser difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
