			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Encontrei todos os três.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "Você... Realmente conseguiu colocá-los juntos? Por favor, deixe-me ver... De fato, estes três padrões, quando juntos, contam a história de Azhdaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Pela aparência, esta garça deve ser o Formatador de Montanha, este cervo talvez seja o Escultor da Lua. Mas este último é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Hã? Parece que este padrão foi... Intencionalmente manchado por alguém, ao ponto de eu não poder entendê-lo. Quem será que era este terceiro Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Deixa para lá, essas coisas são fora da minha compreensão. Mas de qualquer forma, esse tesouro já está completo, podemos vendê-lo por um bom preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Então, você gostaria de ficar como recordação, ou prefere vendê-lo para mim? Eu lhe pagarei uma bela quantia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "É todo seu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Ótimo. Fico com isso então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Ainda assim, por que a imagem de um dos três Adepti foi desconfigurada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160510
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160510,
					"content": "Quem fez esta coisa, e quem a quebrou e destruiu a imagem do Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160511
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160511,
					"content": "Certo, parece que a Soraya chegou em Liyue. Eu poderia escrever uma carta para ela... Ela definitivamente estaria interessada neste objeto.",
