			"dialogs": [
				{
					"id": 710160401,
					"content": "Farei uma tentativa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160402
					]
				},
				{
					"id": 710160402,
					"content": "Tudo bem. Se você conseguir reuni-los, por favor, traga-os até mim.",
					"roleType": "TALK_ROLE_NPC",
