			"dialogs": [
				{
					"id": 750641401,
					"content": "Espera... por que você desapareceu quando o Iktomissauro apareceu? E por que ele desapareceu quando você voltou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641402,
					"content": "Será que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641403
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641403,
					"content": "#Isso mesmo, {M#ele}{F#ela} foi para o banheiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641404,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641405
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641405,
					"content": "Uh, só pense sobre isso. Não poderíamos ir ao mesmo tempo, não é? Isso seria estranho — e vergonhoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641406,
					"content": "#Ah, sim, certo... Haha, é claro! {NICKNAME} não poderia virar um Sauriano! Obvio que não! Não que isso seja algo ruim, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
