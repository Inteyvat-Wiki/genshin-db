			},
			"dialogs": [
				{
					"id": 750641101,
					"content": "Hmm... A seguir, um Iktomissauro sob a luz do luar! Sim, isso parece bom. Mas, conseguir a iluminação ideal vai dar um trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641102,
					"content": "#Hmm... Aha! É seu momento de brilhar, {REALNAME[ID(2)|SHOWHOST(true)]}, meu pequeno amigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641103,
					"content": "Pequeno? Pfff. Pois fique sabendo que ele é mais alto do que você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641104,
					"content": "Rrrwar? Roo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Muito bom, muito bom... O momento é perfeito... Haha! Minha obra-prima está quase completa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "Então garanta que vai tirar uma boa foto, que nem você fotografa aquelas garotas de Fontaine! Hehe, é assim o ditado, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "Hrooo, rroooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Haha, só relaxe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Esse ângulo! Essa luz da lua! Ah! Ah! É simplesmente perfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Só um momento, deixe-me ver... Vou precisar de mais duas fontes de luz. Uma precisa iluminar o perfil do Iktomissauro, para termos o contraste entre a luz quente e a luz noturna... É assim que criaremos um ar de mistério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "E a outra fonte de luz precisa iluminar a silhueta do Sauriano. Não por nenhum motivo complicado, mas é uma necessidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Sim, sim... É o que estamos procurando! É como em um sonho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641113,
					"content": "Mas o que... Droga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Desculpe, mas talvez a concentração atmosférica elemental aqui é diferente da de Fontaine. Algo deve ter dado errado com a máquina... Mas, sem pressa, pessoal. Deixe-me checar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "*Cantarolando* Hmm... Aqui não... Aqui também não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Maldição, maldição, maldição! Arg! Seu patife ridículo, seu idiota imbecil, cocozão fedido! Arrrg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641117,
					"content": "Seu... Seu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641118
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641118,
					"content": "Ei, ei, se acalme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641119,
					"content": "Ele está praticamente esfumaçando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "Ufa... Bem... Agora já era, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641124,
					"content": "Heh. Não me olhe desse jeito. Se mais nada, me sinto melhor agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641125,
					"content": "*Suspira* Bem, é como você pode ver. Nossa iluminação artificial está quebrada — e ainda mais depois de toda a Mora que gastei. Decepcionante. Assim como minha ex esposa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641126
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641126,
					"content": "Muito bem, apenas... pare por ora. Cuidado, e não entre em pânico. Estamos aqui para ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641127,
					"content": "*Suspira* Desculpa... Urg. Tudo bem. Do que eu preciso? Ah, sim. Preciso iluminar o <color=#00E1FFFF>lado esquerdo do rosto do Iktomissauro</color> e os <color=#00E1FFFF>contornos de suas costas</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641128
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641128,
					"content": "Sem problemas! Vamos nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641129,
					"content": "Então, Magnifico começa a mexer em sua câmera mais uma vez, deixando vocês para pensar em como fazer uma fonte de luz adequada...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "O que está acontecendo? Você está se divorciando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
					"content": "O quê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641122
					],
					"speakerTitle": "Paimon"
				}
			]
		},
