					}
				]
			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Haha, ótimo, ótimo! Venham, meus modelos, fiquem parados... Sim, você é bem inteligente! Três, dois, um, diga xis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Ah, olhe só para isso! Uma obra de arte? E de quem seria isso? Sim, minha — Magnifico de la Magnificans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Obrigado, muito obrigado! Haha! Então, aqui está o restante do pagamento que te devo! Ah... e isso também. Veja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Ooh, um último pagamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Espera. De apenas uma Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "#Ótimo... E agora, {M#nosso verdadeiro}{F#nossa verdadeira} protagonista está prestes a aparecer! Venha, não seja tímid{M#o}{F#a}! Você é uma estrela, então faça essa entrada brilhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Ufa, acabou! Aqui, pegue essa cópia como presente... e saiba que você obteve essa obra de arte antes de qualquer galeria de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "#Obrigad{M#o}{F#a}. Guardarei com carinho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Mas, o pagamento final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "Estarei indo para esse local a seguir... Aqui, deixe-me marcar no seu mapa. Quem sabe, talvez poderemos nos encontrar novamente em algum momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "E a essa altura, eu até posso precisar de sua ajuda de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640615,
					"content": "Urg, você está praticamente nos esnobando, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Bem, não dependeu de mim nos encontrarmos. Foi o destino — sim, destino! O destino quem nos uniu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640617,
					"content": "#Até mais, e boa sorte, {M#meus amigos}{F#minhas amigas}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640618,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnifico pega suas malas e sobe em um balão de ar quente.\\nVocê assiste o balão sacudir violentamente, fazendo com que ele soltasse uma gargalhada. Então, ele rapidamente reganha a estabilidade antes de voar para bem longe.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "Não parece valer muita Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "Wrooh? Wroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "É... Paimon também está decepcionada... Ela achou que o pagamento final seria mais substancial do que o depósito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
