			},
			"dialogs": [
				{
					"id": 750640801,
					"content": "\"Louis, Louis!\" ... Ah! Você quase me mata do coração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640802,
					"content": "Então, você mudou de ideia ou só está aqui para dar um oi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640803,
					"content": "Dar um oi, e ajudar enquanto isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "Hoohroo~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640805
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640805,
					"content": "Haha. Isso é maravilhoso. Então, vamos começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640806,
					"content": "Só estamos de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
					]
				},
				{
					"id": 750640807,
					"content": "Tudo bem, então, boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
