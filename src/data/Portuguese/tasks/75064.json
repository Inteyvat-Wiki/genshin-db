			"dialogs": [
				{
					"id": 750640412,
					"content": "Ker-chak! Contemple, um milagre da luz e da sombra, a mais nova grande conquista industrial de Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640413,
					"content": "O quê? Isso não é novo pra gente. Além disso, você nem disse com o que precisa de ajuda ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640414,
					"content": "Só fala logo do que tu precisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "Pelo visto, você provavelmente quer que a gente te ajude a tirar uma foto, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640418,
					"content": "Oh... Bem, claro! Aqui está seu depósito. Por favor, pegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640419,
					"content": "Espera. Isso é Mora demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640420,
					"content": "Rwraa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "Como podem ver, preciso tirar algumas fotos de Saurianos, e não um daqueles desenhos que você vê em livros de ilustração animal... Eu quero obter algo cheio de vitalidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640422,
					"content": "S-sim, ok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640423,
					"content": "#Mas por outro lado... mais vitalidade significa \"menos provável de me escutar\". Então, se for conveniente, vocês poderiam me ajudar a tirar as fotos ideais que desejo, {M#caros aventureiros}{F#caras aventureiras}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640424,
					"content": "S-sim, ok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640425,
					"content": "É claro que, você não precisa se forçar para fazer coisas além de suas habilidades, mas eu suspeito que você poderia pelo menos me proteger de ataques de formas de vidas próximas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640426,
					"content": "Então, por favor, fique com o depósito... e quanto a ajudar ou não, deixo a decisão com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640427,
					"content": "Eita... Todo esse dinheiro está deixando a bolsa super pesada... Você tem certeza que é tudo nosso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640428,
					"content": "Ah, eu te enganaria? Ou eu deveria checar a quantidade para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640429,
					"content": "Hehehe... Hahaha! Bem, parece que você veio para as pessoas certas, pois Paimon é uma renomada domadora de Sauriano aqui em Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640430,
					"content": "#Não se preocupe. Desde que {NICKNAME} e Paimon estejam aqui, qualquer Sauriano que você desejar domar será domado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640431,
					"content": "Tepetlissauros? Fácil, fácil! Qucussauros? Facílimo! Iktomissauros? Mamão com açúcar... Uh, também fazemos Koholassauros, Yumkassauros, Tachankassauros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640432,
					"content": "Tachankassauros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "...Cabeçãossauro, Arminhassauro, Grandeóculosssauro, Superassustadorssauro, Meioassustadorssauro, Estranhossauro, Normalssauro, Magrinhossauro, Grandãossauro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640435,
					"content": "Hoohroo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "Do que você está falando, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "E... Rawoorssauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640439,
					"content": "Rawoo, rawoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "E o Wrawerssauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640441,
					"content": "Wraah! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "Enfim, seja qual for o nome, podemos lidar com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640443,
					"content": "Hrrm, Hrmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "*Suspira* Tudo bem, vamos te ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#Claro que iremos. Já aceitamos um depósito desse tamanho, afinal de contas! Não é, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640446,
					"content": "Ah, maravilha. Maravilha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640447,
					"content": "Desculpe, tenho coisas para fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "Mas já aceitamos o depósito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640449,
					"content": "Ha, está tudo bem. Espere até você ter um tempo! Não é como se eu fosse derreter e virar uma poça desamparada sem sua ajuda, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640437,
					"content": "Espera aí, Paimon. Do que você está falando!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "Um momento aí, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "Pague e eu ajudarei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "Somos super legais, então, Mora primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				}
			]
		},
