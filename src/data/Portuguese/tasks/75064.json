			},
			"dialogs": [
				{
					"id": 750641501,
					"content": "Agora, eu achei que ouvi pessoas falando sobre mim — mas jamais esperei que seria você! Hah, que coincidência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641502
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641502,
					"content": "Uau! Acho que esquecemos que você tem um balão de ar quente. E você nunca levou a gente nele, seu mesquinho...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641503,
					"content": "Rawoo! Rawoo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641504,
					"content": "Bem, você nunca pediu, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641505
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641505,
					"content": "E por que iríamos... Uh, você nunca disse que pedir era uma opção!",
