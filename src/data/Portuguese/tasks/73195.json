			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "\"Após me tornar um Patrulheiro Florestal e dedicar todo o meu tempo à floresta, estou perto de falar com os Pássaros do Crepúsculo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951302,
					"content": "\"Se eu pudesse entender as palavras dos Pássaros do Crepúsculo, não estaria tão entediado como estou agora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
						],
						"stepId": 7319514,
						"stateName": "QUEST_STATE_UNFINISHED"
