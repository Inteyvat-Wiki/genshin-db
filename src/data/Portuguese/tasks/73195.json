			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "\"Ele está de volta! Meu Senhor, Ahmar, está de volta!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950802,
					"content": "\"O que ele retornar é o dia que o castigo virá para vocês com folhas nas cabeças!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950803,
					"content": "Essa é uma notícia falsa, e estamos investigando sua fonte. Todas as questões relacionadas a Sumeru serão postadas regularmente no Akasha. Não se deixe enganar por boatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
