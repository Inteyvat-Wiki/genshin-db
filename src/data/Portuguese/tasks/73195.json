					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "\"Nossa senhorita saiu de casa e ainda não voltou. Se você vir uma jovem de cabelos castanhos usando um vestido azul e roxo, entre em contato com o clã Homayani. Você será devidamente agradecido pela ajuda!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950702,
					"content": "\"Se a nossa própria senhorita vir este cartaz, por favor, entre em contato conosco imediatamente. Seus pais estão muito preocupados com você.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
