			},
			"dialogs": [
				{
					"id": 731951701,
					"content": "\"A Cidade da Sabedoria é nossa, assim como a Floresta das Trevas. No topo da Árvore Divina estão os restos do Reino dos Sonhos Perdidos.\"",
					"roleType": "TALK_ROLE_NPC",
