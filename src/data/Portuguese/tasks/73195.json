			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Matras descobriram vários casos de comércio ilegal de Conhecimento Enlatado durante inspeções recentes em Bazares locais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950502,
					"content": "Transações de Conhecimento Enlatado são proibidas pela Academia. Qualquer um encontrado em flagrante será severamente punido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950503,
					"content": "A Academia não será responsável pelas consequências do uso ilegal de Conhecimento Enlatado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "\"O ‘Festival Sabzeruz’ que celebramos ano após ano está chegando. Este ano o Grande Bazar vai organizar um evento mais do que majestoso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950602,
					"content": "\"Para aquecer o clima festivo, nossa senhorita preparou um subsídio especial para todos os comerciantes participantes.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950603,
					"content": "\"Vamos comemorar o aniversário da Lorde Menor Kusanali juntos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
