				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "\"Aviso: Estamos procurando por especialistas para lidar com o Caracal...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950202,
					"content": "A mensagem do aviso foi coberta com uma pincelada. Do lado há uma frase com caligrafia torta e infantil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950203,
					"content": "\"O Caracal Raja só queria brincar com todos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "\"Após comer cogumelos, se você ver mímicos dançando, não se preocupe, é uma reação normal.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950302,
					"content": "\"Mas se você encontrar plantas ao seu redor que falam, procure ajuda do Guarda-Florestal mais próximo imediatamente.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "\"Devido a causas desconhecidas, o Definhamento da floresta começou a crescer recentemente, tanto em quantidade quanto em área.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950402,
					"content": "\"Além de secar a vegetação nas áreas afetadas, o Definhamento é extremamente mortal para a vida selvagem e até para as pessoas. Os Patrulheiros Florestais estabeleceram 'Zonas de Contaminação' para marcar a influência do Definhamento. Para sua segurança, por favor, fique longe de tais áreas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950403,
					"content": "\"Se você encontrar novas áreas afetadas pelo Definhamento na selva, entre em contato com o Guarda-Florestal mais próximo e deixe o resto para os profissionais.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
