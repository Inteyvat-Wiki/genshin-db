				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "\"Eu ouvi que Diwan costumava falar por nós, os habitantes do centro, mas agora ele obedece completamente aos Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951602,
					"content": "\"Como Vizir, sua palavra nunca é cumprida. E ele só existe quando os Mahamata querem se livrar de suas responsabilidades.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951603,
					"content": "As instruções da Academia para todos os órgãos administrativos são baseadas nos ensinamentos da Lorde Maior Rukkhadevata. Por favor, evite qualquer difamação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
