				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "\"Camarada, você está em apuros? A poderosa magnata Lorde Sangemah Bay está aqui para resolver todos os seus problemas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950902,
					"content": "\"Só vai te custar um pouco de Mora, e seu problema não será mais um problema.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950903,
					"content": "\"Aja antes que seja tarde demais! Aqui estão as coordenadas...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731950904,
					"content": "Este quadro de avisos é criado pelo Vizir para regular as transações do mercado. Por favor, não poste anúncios aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
