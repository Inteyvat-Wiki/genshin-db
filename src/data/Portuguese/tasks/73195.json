			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "\"Na verdade, eu me lembro de um mercenário muito bom chamado 'Leoa Flamejante', ou algo assim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951402,
					"content": "\"Eu costumava a contratar quando ia para o mar para negócios. Não importa se você se deparar com Ladrões de Tesouro ou o Millelith, não há nada a temer quando você a tem ao seu lado. Fiz uma fortuna por causa dela.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951403,
					"content": "\"Mas ela não tem aceitado comissões ultimamente, e eu ouvi que os monstros se multiplicaram no caminho para Liyue... Eu posso ter que colocar meus fundos na Bolsa Kalimi se isso continuar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951404,
					"content": "\"Você não parece estar fazendo nenhum negócio legal... Mas sobre Leoa Flamejante, ouvi dizer que ela conseguiu um grande contrato com o clã Homayani recentemente. Então você vai ter que esperar por bastante tempo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951405,
					"content": "\"E um conselho, é melhor gastar seu dinheiro comprando 100 tapetes do que investindo na Bolsa Kalimi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951406,
					"content": "\"Absolutamente! Visite nossa loja para comprar tapetes! Posso até explicar em detalhes como usar cada um deles!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
