			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "Se você encontrar pessoas com olhares vazios ou murmurando para si mesmas na floresta, elas são pesquisadores na Vida Satyavada. Por favor, não perturbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Placa de Avisos"
				},
				{
					"id": 731951502,
					"content": "Se você se incomoda com eles, por favor, denuncie aos Mahamata para tratamento adequado pela Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Avisos"
				}
			]
		},
