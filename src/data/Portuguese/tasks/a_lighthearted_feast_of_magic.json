			"dialogs": [
				{
					"id": 756750101,
					"content": "Ei... Yah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "Minha cabeça já está cheia de música, dança, dança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "Balança, balança~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "Tão feliz~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "Crraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750106,
					"content": "Também ganhei um dinheirinho extra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "Hã? Desde quando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "A Nusta estava atolada de trabalho, então ajudei as alunas dela e limpei alguns ninhos de monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "Em Natlan, lutar e dançar são igualmente empolgantes. Gosto disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Obrigada por isso, Marine. Eu queria que as novatas treinassem mais, mas elas ainda não conseguiam dar conta daquela missão sozinhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750111,
					"content": "Vou fazer treinarem mais pesado quando voltarmos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750112,
					"content": "Não precisa, elas se saíram muito bem. Só não esperávamos que o ninho tivesse sete vezes mais monstros do que o estimado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "E o Clã das Plumas de Flores pagam muito bem. Até economizei o bastante para comprar um presente para a Aeval.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "Mas suas férias também já estão quase acabando, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "Mais alguns dias, depois começo a pensar em reservar o navio de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "Sem pressa, ainda podemos dançar. Roxane, Letellier, Chenee e Frejus andam disputando trabalhos ultimamente, então não vou roubar a cena deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "Então vamos continuar dançando e nos divertindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "Quando estiver cansado, coma. Quando estiver de barriga cheia, durma. Sem preocupação alguma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "Raargh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750120,
					"content": "As Melusines e o pequeno Koholassauro fizeram fila e foram saltitando em direção ao palco.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Que grupo adorável de convidados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750122,
					"content": "Hehe, parece que você também está se divertindo, Nusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Seu sorriso parece muito mais relaxado agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Sério? Então acho que preciso participar de todos os bailes de agora em diante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750126,
					"content": "Vou fazer com que esses jovenzinhos que me chamam de \"senhora\", ou até de \"tia\"... um dia percebam que sou mais jovem que eles em espírito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750127,
					"content": "E acredito que os futuros bailes deveriam ser exatamente assim, ou melhor, deveriam acontecer com mais frequência! Sou totalmente a favor de transformar isso em uma tradição mensal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750124,
					"content": "E você até parece um pouco mais jovem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}