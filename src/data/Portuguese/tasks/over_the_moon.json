			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "Aí está você, desculpe incomodar novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630102,
					"content": "Você parece estar bem melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "Haha, obrigada. Eu meio que aceitei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630104,
					"content": "Nem tudo pode ser forçado, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630105,
					"content": "Falando nisso, tem como você me acompanhar até a costa oeste esta noite? Tenho algo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630106,
					"content": "Uau, é algum tipo de tesouro marinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630107,
					"content": "Você vai ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "Chegamos. E foi aqui, numa noite como esta que o meu pai partiu para o mar... E nunca mais o vi depois disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630202,
					"content": "Você sente muita falta dele, não é? Seu desejo é ver seu pai novamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630203,
					"content": "Haha, sim, de fato, eu sinto muita falta dele, mas como povo do mar, um dia, todos nos voltaremos para o mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630204,
					"content": "Meu desejo na verdade, é de se tornar uma pescadora ainda melhor do que o meu pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630205,
					"content": "Quando eu era criança, eu sempre quis velejar com meu pai, mas ele sempre falava para minha mãe me levar de volta. Às vezes, ele chegava até a levar o filho do vizinho, mas não me levava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630206,
					"content": "Ele sempre falava: \"Momiji, não fique na praia, vá fazer algo que as outras meninas fazem\". Ou: \"Toma esse dinheiro e vá comprar um vestido, não fique o tempo todo correndo para o barco\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630207,
					"content": "Mas eu não entendia. Por quê? O que exatamente uma menina tem que fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630208,
					"content": "Posso comprar doces, colher flores e ser uma princesinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630209,
					"content": "Mas não posso ir em uma aventura, ficar em alto-mar ou explorar o oceano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630210,
					"content": "Quanto mais meu pai não queria que eu fizesse isso, mais eu queria. Depois que meu pai foi embora, me tornei pescadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630211,
					"content": "Explorarei as águas que ele não pôde explorar e pescarei os peixes que ele não pôde pescar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630212,
					"content": "Herdarei os métodos de pesca da família Kujirai e farei história com o nosso sobrenome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630213,
					"content": "Mesmo que o \"Leviatã Lunar\" seja apenas uma lenda, nada disso vai me segurar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630214,
					"content": "Eu tenho fé em você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630216,
					"content": "Já que o peixe divino não está aqui, jogarei os meus desejos para o mar. Creio que assim, o meu pai verá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630217,
					"content": "#Você tem algum desejo também? Vamos fazer isso junt{M#os}{F#as}! Escreva os seus desejos em um papel, coloque em uma garrafa e jogue para o mar com todas as suas forças. Tenho certeza que eles se tornarão realidade um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630218,
					"content": "Uau — Isso realmente funciona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630219,
					"content": "Mas Paimon tem tantos desejos, qual deles escrever...? Paimon está com dúvidas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630220,
					"content": "Desculpa ter incomodado vocês por tanto tempo! Eu realmente não sei nem como agradecer, mas preparei um presentinho, e espero que vocês gostem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630221,
					"content": "Uau — Ei, olhem! O que é aquilo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630222,
					"content": "É um cardume! E os peixes do cardume estão brilhando, eles parecem gostar das nossas garrafas à deriva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630223,
					"content": "Vendo assim, vocês não acham que eles parecem uma grande lua no mar assim reunidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630224,
					"content": "Esses... Esses peixes, são \"Platys\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630225,
					"content": "Ah! Agora eu entendi! Finalmente entendi! É isso, o \"Leviatã Lunar\" é um bando de \"Platys\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630226,
					"content": "Oi? O \"Leviatã Lunar\" é um bando de \"Platys\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630227,
					"content": "Isso mesmo, lembro-me perfeitamente da sua aparência. Seus pontos estrelados iluminados pela lua... O \"Leviatã Lunar\" tinha aparecido também naquele ano depois que o Jiawei deixou cair sua garrafa à deriva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630228,
					"content": "Não é de se admirar que, depois de todos esses anos, ninguém foi capaz de pegar o \"Leviatã Lunar\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630229,
					"content": "Já que ele é na verdade um cardume de \"Platys\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630230,
					"content": "Esses \"Platys\"... Quem diria que uma simples garrafa à deriva poderia atrair eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630231,
					"content": "Hehe, talvez são os desejos que atraem eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630232,
					"content": "Haha! Então observem com atenção que a mestre Kujirai Momiji irá capturar todos eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630233,
					"content": "Queremos ajudar também! Deixa a gente ajudar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726630234,
					"content": "Nesse caso, permita-me dar-lhe esta vara de pescar, feita especialmente pela família Kujirai em busca do \"Leviatã Lunar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630235,
					"content": "Embora isso não seja o suficiente para expressar minha gratidão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726630236,
					"content": "Vamos então capturar todos os \"Platys\" com a vara de pesca da família Kujirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		}
	]
}