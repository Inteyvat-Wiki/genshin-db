			"dialogs": [
				{
					"id": 741140301,
					"content": "#Aha! Você é {M#o}{F#a} melhor, {NICKNAME}. Absolutamente {M#o}{F#a} melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140302,
					"content": "Se não fosse por você, tudo dentro da caixa teria sido perdido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140303,
					"content": "Precisamos voltar à cidade e entregar esses filmes ao Sr. Renault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140304,
					"content": "#Então... Vamos comer juntos. {NICKNAME}, se tiver interesse, você pode vir também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140305,
					"content": "Depois que a gente comer, eu pago a sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140306,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Tudo bem! Está decidido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, traga os filmes nesta caixa e entregue ao Sr. Renault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, vá pegar alguns vegetais. Eu estive treinando a minha Sopa de Pescado Branco, e é hora de eu mostrar minhas habilidades para o Sr. Renault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140311,
					"content": "Chefe, nós já estamos indo ao restaurante, por que você ainda tem que fazer as coisas sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "É conveniente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140313,
					"content": "Ahem! Está decidido. Vamos partir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, pode me seguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140307,
					"content": "Bem, coincidentemente estou com fome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
