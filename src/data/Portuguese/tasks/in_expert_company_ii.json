				{
					"id": 741140401,
					"content": "Essa panela é bem estranha. Hmm... mas deve ser usada do mesmo jeito que as de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140402,
					"content": "Chefe, peguei os vegetais, mas eles não tinham Marcotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "E não encontrei outras lojas que vendessem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#Isso é... o último ingrediente que precisávamos. Bem, uh, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140405,
					"content": "Eu vou pegar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Obrigada pela ajuda. Não se preocupe, eu sei como aventureiros trabalham. Isso não vai sair de graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140406,
					"content": "Inclua isso no pagamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
