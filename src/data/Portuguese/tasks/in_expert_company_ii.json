			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, gostaria de te apresentar ao mestre dos filmes, Sr. Renault.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140602,
					"content": "#Sr. Renault, {M#esse}{F#essa} é {NICKNAME}, um{F#a} aventureir{M#o}{F#a} muito habilidos{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140603,
					"content": "#Se estiver filmando filmes de ação depois, você deveria definitivamente contratar {NICKNAME} como {M#ator}{F#atriz} número 1!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140604,
					"content": "Haha, que exagero. Não sou especialista em filmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140605,
					"content": "Eu sou apenas alguém relativamente familiar nos usos de iluminação para produção de filmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140606,
					"content": "Ah, você é modesto demais. A iluminação em seus filmes praticamente fala por si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140607,
					"content": "Usos de iluminação para produção de filmes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "É. Em minha teoria de iluminação, acredito que a manipulação da luz é a manipulação da emoção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140611,
					"content": "Mas... como eu devo dizer isso... Minhas teorias ainda não são consideradas na indústria de filmes de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140612,
					"content": "A maioria dos diretores prefere dirigir usando movimento ou a própria cena para ilustrar suas histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140613,
					"content": "Eu gravei alguns filmes puramente usando transições de luz para expressar a narrativa, mas quase ninguém se interessou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140614,
					"content": "Mas agora, pelo menos uma diretora acha que minha teoria de iluminação tem valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140615,
					"content": "Diretora? Eu? Hahaha, não brinque. Eu era apenas uma vendedora de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140616,
					"content": "Quem disse que uma vendedora de chá não pode ser uma diretora? Eu era só um jornalista antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140617,
					"content": "Um jornalista... Então você deve ser bom em escrever reportagens? Como aquelas nos jornais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140618,
					"content": "Acho que sim. O que tem isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Renault"
				},
				{
					"id": 741140619,
					"content": "Hmm... Assim como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140620,
					"content": "Ah! Nada! Nada. Teremos tempo suficiente para trabalhar juntos no futuro, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140621,
					"content": "Todos se sentam ao som da risada franca da Srta. Qiu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Após a refeição, a Srta. Qiu fez uma refeição adicional e colocou em uma bolsa depois de embalá-lo...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "A iluminação é muito importante na produção de filmes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Claro. Em minhas teorias, iluminação é maneira principal que o clima da cena é expressado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Renault"
				}
			]
		},
