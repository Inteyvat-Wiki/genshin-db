			"dialogs": [
				{
					"id": 741140201,
					"content": "*Suspiro* Espero que os filmes não tenham sido danificados na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140202,
					"content": "Não se preocupe, chefe, a caixa está selada. A água não vai entrar nela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140203,
					"content": "Ainda bem que nosso Projektor não caiu. Se não, as cortinas se fechariam para nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingye"
