			"dialogs": [
				{
					"id": 741140101,
					"content": "Sem problema. Nossa caixa é à prova d'água. Tudo que precisamos é mergulhar e pegá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140102,
					"content": "Chefe, nenhum de nós sabe como mergulhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Eu sei como nadar, mas mergulhar está além da minha capacidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "A... a comissão que postamos na Guilda de Aventureiros ainda está no quadro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140105,
					"content": "Chefe, você não disse que deveríamos nos apressar e remover a comissão antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "Fizemos isso ontem. A Guilda disse que pode nos devolver nossa taxa pré-paga de postagem da comissão hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Uh... Se a gente quiser enviar uma comissão novamente, vamos precisar pagar uma taxa de serviço adicional...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140108,
					"content": "Vocês já terminaram seu filme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Aventureir{F#a}{M#o}... {NICKNAME}! Você veio exatamente quando precisamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140111,
					"content": "Você pode mergulhar? Ou... você pode me ajudar a encontrar um mergulhador com a habilidade e disponibilidade para mergulhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140112,
					"content": "Você quer... fazer uma filmagem submersa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "Não estamos nem perto de conseguir isso. Também não podemos pagar por equipamento de filmagem à prova d'água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "É puramente porque a caixa em que colocamos nossos filmes caiu na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Tudo bem, já basta! {NICKNAME}, você precisa nos ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140116,
					"content": "Não se preocupe com o pagamento. Eu pago antecipadamente, assim como da última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 741140109,
					"content": "O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
