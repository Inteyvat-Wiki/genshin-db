			"dialogs": [
				{
					"id": 200440101,
					"content": "Ugh! Que dor de cabeça! O que devo fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "Estou praticando para as provas dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440104,
					"content": "*Suspiro* Mas eu não sou tão forte quanto a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440105,
					"content": "Creio que seja melhor me concentrar nas técnicas em vez da força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440106,
					"content": "Por exemplo, eu estava pensando como eu poderia quebrar todos estes manequins de madeira com um golpe só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440107,
					"content": "Se você estiver com tempo, venha pensar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440108,
					"content": "Deixe-me pensar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Claro, vá com calma. Não é como se esses espantalhos fossem fugir sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440111,
					"content": "Nem a minha vida vai para algum lugar enquanto estiver presa resolvendo isso, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440114,
					"content": "Se eu tivesse uma arma maior ou com habilidades elementais fortes como a Jean, quebraria todos esses postes de madeira facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440109,
					"content": "#E se nós tentarmos junt{M#os}{F#as}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "Você gosta de combate em equipe então? Tudo bem para alguns... Sempre tem alguém para ajudá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440113,
					"content": "Para pessoas como eu, só me resta aprender por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
