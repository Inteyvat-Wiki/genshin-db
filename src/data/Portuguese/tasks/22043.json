			"dialogs": [
				{
					"id": 220430301,
					"content": "Hmm, sim, estes servem, eu acho. Desculpe por pedir-lhe ajuda depois de ter feito todo este caminho para chegar ao santuário... Por favor, pegue isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Uma vez que eu tenha realizado meu trabalho de escultura em madeira, eu também lhe enviarei meu melhor trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Hmm, que pose devo esculpir para a sacerdotisa chefe provisória desta vez...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
