			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "Hã, como eu fiquei sem madeira...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430102,
					"content": "Ei, Viajante! Você chegou bem na hora certa, tem como você me ajudar com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430103,
					"content": "Com o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "Tenho tentado fazer entalhes pequenos em madeira de nossa sacerdotisa chefe provisória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430106,
					"content": "Estive pensando em levar um lote destes para a Ilha Narukami para ver se eles vendem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430107,
					"content": "Se venderem, me proporcionarão uma fonte de renda consistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430108,
					"content": "Oh, tenho certeza que venderão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "Hahaha. Obrigado pelos seus votos de sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430110,
					"content": "Dito isto, acho que tenho fé no carisma de nossa Senhorita Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430118,
					"content": "Bem, não importa isso por enquanto. Vamos falar sobre o assunto em questão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430119,
					"content": "Então, a questão é que estou ficando sem a madeira que estava usando para praticar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430120,
					"content": "Você poderia me ajudar a coletar 10 blocos de Madeira Otogi, Traveler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430121,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "Deixarei isso com você, então. Você é realmente de uma grande ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430126,
					"content": "Traga aqueles blocos de Madeira Otogi para mim quando tiver terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430123,
					"content": "Você realmente precisa de tantos assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "Bem, eu só agora comecei a praticar, então é melhor estar do lado prudente e preparar mais material.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430125,
					"content": "Bem, conto com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430111,
					"content": "Qual a das esculturas de madeira de repente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "Ah, bem... Você sabe qual tem sido, até agora, meu pagamento por parte de nossa sacerdotisa chefe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430113,
					"content": "Geralmente são estas... Garrafas, copos, pratos e coisas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430114,
					"content": "Elas parecem um pouco velhas, mas quando fui avaliá-las, descobrimos que essas coisas são de fato um pouco \"antigas\"... E valiosas, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430115,
					"content": "Mas, para dizer a verdade, era bastante problemático e cansativo conseguir vendê-las sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430116,
					"content": "Além disso, isto realmente não faz uma renda particularmente estável... Se a sacerdotisa chefe ficasse sem essas coisas um dia, isso basicamente não me deixaria sem emprego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430117,
					"content": "Dessa forma, decidi buscar um novo empreendimento comercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430104,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
