			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Irmão, vamos nos esconder ali. Aposto que vai ser melhor do que o lugar que ela escolheu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Ei, Verut, volte! Se você se perder, eu não vou conseguir te encontrar rápido, sabia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040103,
					"content": "O que traz vocês aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "#Ei! Você está livre, {M#irmãozão}{F#irmãzona}? Vem, se esconde com a gente! Lovi provavelmente já se escondeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Sobre Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Sem tempo, irmão! Ela conhece esse lugar muito bem... a gente precisa se esconder melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut sai com pressa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*Suspiro* Verut... Quando você vai ouvir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040110,
					"content": "Desculpe, mas vou ter que te incomodar para brincar com a gente de novo. Verut está bem animado por... seja lá o motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040111,
					"content": "Talvez seja porque ele fez uma nova amiga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Eu pensei exatamente isso. Ainda assim, contanto que ele esteja feliz, está tudo ótimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040113,
					"content": "Vamos esperar que ele não fique animado demais e siga Lovi para se esconder em algum lugar estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040118,
					"content": "Desculpa, mas, por favor, brinque de esconde-esconde com a gente de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040119,
					"content": "Acho que tenho que me esconder, ou Verut vai ficar chateado... e se ele chorar bem no meio da rua, vou ficar sem opções...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040120,
					"content": "Aurele sai...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Sobre Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Uma garota que conhecemos. Ela nos viu brincando de esconde-esconde e insistiu em brincar também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040116,
					"content": "A personalidade é quase igual a de Verut. Por isso acho que eles se dariam muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040117,
					"content": "Entretanto, o pai dela não parece ter muito tempo para brincar com ela, então acho que estamos todos no mesmo barco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040104,
					"content": "Ainda estão brincando de esconde-esconde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
