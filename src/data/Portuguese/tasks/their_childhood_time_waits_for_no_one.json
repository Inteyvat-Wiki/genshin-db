			"dialogs": [
				{
					"id": 240040501,
					"content": "Por que vocês estão olhando para mim assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040502,
					"content": "Você se escondeu em algum lugar para ler, não foi, irmão? Você não estava nem um pouco brincando sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Isso mesmo. Vamos lá! Seja sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Bem, vocês pegaram todos os lugares bons, e não sou muito bom nisso... Então eu só fui ler para passar o tempo, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040505,
					"content": "Bleh! Seu mentiroso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Hunf! Rato de Livro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Sério? Me poupe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040508,
					"content": "Certo, deixa ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Hehe, Lovi é muito boa em esconde-esconde. Ela sabe todo tipo de lugares para se esconder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Hehehe, esse lugar é bem incrível quando Lovi está aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut escala paredes bem rápido, e ele é bem forte. Ele me deu uma mão algumas vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "Contanto que a gente vá juntos, aposto que ninguém ia conseguir nos encontrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Tudo bem, acho que estamos mais ou menos terminados por hoje. Vamos te mandar para casa primeiro, Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040514,
					"content": "E... você vai fazer perguntas ao meu pai de novo, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040515
					],
