			"dialogs": [
				{
					"id": 240040201,
					"content": "...Acho que já li esta página antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040202,
					"content": "Você está lendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Você chegou bem rápido. Eu tinha acabado de começar a ler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040205,
					"content": "O pai de Lovi pediu para ela me trazer este livro. Ele até disse que eu podia perguntar a ele qualquer coisa que eu não entendesse nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040206,
					"content": "Mas na verdade... Heh. O que tem nesse livro que eu de fato consigo entender mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040207,
					"content": "Enfim, deixando isso de lado, vou voltar ao ponto de encontro. Você realmente me achou, afinal, e regras são regras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040203,
					"content": "Você gosta bastante de aprender, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
			"id": 2400403,
