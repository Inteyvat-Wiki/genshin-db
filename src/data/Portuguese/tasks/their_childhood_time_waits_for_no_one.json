					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "Ugh, então você achou... Hã? Espera, quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "#Um{F#a} amig{M#o}{F#a} de Aurele e Verut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "#Oh! Eles falaram de você antes... Verut disse que você é {M#muito bom}{F#muito boa} nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "Bem, acho que vi com meus próprios olhos hoje. Você se garante mesmo nisso, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
					"content": "Você me pegou. Acho que vou voltar ao ponto de encontro, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
