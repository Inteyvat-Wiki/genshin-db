			"dialogs": [
				{
					"id": 80030601,
					"content": "Eles foram embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "#Ugh... {NICKNAME}, não fique triste! Iremos encontrar eles, com certeza! Pense positiv{M#o}{F#a}! Pelo menos a gente conseguiu encontrar algumas pistas úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "Eu... Não estou triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "É? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "#Pelo menos agora, assim como os Sete Arcontes, Dain é também uma parte fundamental para encontrar {M#sua irmã}{F#seu irmão}, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "Temos que tomar cuidado quando formos a Inazuma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Certo! O que eles disseram há pouco tempo foi incompreensível, você não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Eu entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Uh! Então vamos endireitar todos os acontecimentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#Primeiro, o Apóstolo do Abismo chamou {F#o seu irmão de \"Príncipe\"}{M#a sua irmã de \"Princesa\"}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "#Obviamente, {F#o seu irmão}{M#a sua irmã} lidera a Ordem do Abismo, e tem uma posição mais elevada que o Apóstolo do Abismo... Só que ainda não sabemos se é {F#o}{M#a} líder ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "#Aliás, {F#o seu irmão}{M#a sua irmã} disse que o seu objetivo era \"engolir os tronos\" e \"lutar contra o destino\". O que {F#ele}{M#ela} queria dizer com isso? Parece que {F#ele}{M#ela} queria dar um fim aos Sete Arcontes e Sete Nações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Segundo, afinal os monstros da Ordem do Abismo são os habitantes de Khaenri'ah quando ela foi destruída... É uma história horrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "O Dain também vem de Khaenri'ah, e presenciou a tragédia 500 anos atrás. Mas ele não virou monstro, e hoje, está confrontando a Ordem do Abismo sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "#Talvez seja isso que o {F#seu irmão}{M#sua irmã} quer dizer com \"O Dain é o seu inimigo\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Mas, se os monstros da Ordem do Abismo de hoje são os habitantes que o Dain protegia... Por que o Dain escolheu por rivalizar com a Ordem do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "#Aliás, por que {F#o seu irmão}{M#a sua irmã}, que temos procurado o tempo inteiro, está ao lado dos monstros da Ordem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Ainda não estamos com informações suficientes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#Então, {NICKNAME}, fique mais animad{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "A nossa jornada não terminará! Chegou a hora de sair desse lugar tão horrível e voltar para um lugar repleto dos raios do sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "#Se {F#o seu irmão}{M#a sua irmã} quer que você chegue ao destino, então, faça isso para mostrar a {F#ele}{M#ela}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "\"Viajante\", vamos indo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Não faz sentido pensar demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#Eu apenas me foquei {M#na Lumine}{F#no meu irmão}, não ouvi direito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Temos mais um objetivo na nossa jornada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "A Paimon tem razão! Temos esperança!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Sim, sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}