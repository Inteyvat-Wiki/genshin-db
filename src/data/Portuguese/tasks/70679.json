			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Olá, olá! Nos encontramos de novo! Que coincidência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Foi mal, mas quem é você mesmo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Gygax! Sou Gygax! Sabe, do Labirinto de Vento? Lembrou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Ah, é você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Lembrei agora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Você não lembrou nada, não foi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Enfim, olhe aqui. Você deve lembrar do Labirinto de Vento, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Você não me deu um monte de sugestões depois de testar? Foram grandes ideias, incorporei todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Revisei as regras e a jogabilidade uma... várias vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Não vão ser difíceis demais de entender?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Oh, não se preocupe. Tenho certeza que você vai adorar as coisas novas. Deixe-me explicar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Primeiro, nesse novo Labirinto de Vento, acrescentei algo chamado \"Dispositivo de Sinalização\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Os cavaleiros Errantes só precisam ativar o Dispositivos de Sinalização 4 vezes, e assim podem derrotar o caçador e ganhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "E quanto ao caçador... continua igual. Só precisa pegar todos os cavaleiros para ganhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Mas dessa vez, quando um cavaleiro for pego pelo caçador, não vai imediatamente sair da partida, mas vai parar num lugar chamado \"Zona de Observação\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Depois de um tempo, ou se outro cavaleiro ajudar, quem foi pego vai poder sair da Zona de Observação e continuar lutando contra o caçador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Entretanto, se quem foi pego antes for pego novamente... vai ser eliminado mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Parece complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Não se preocupe. Parece complicado, mas você vai pegar o jeito depois de umas rodadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "Claro, vou tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Certo, venha por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Ainda tenho outro assunto para tratar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Tudo bem, venha quando tiver livre, ainda vou passar um tempo por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Quantas regras novas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Você não adicionou nenhuma jogabilidade estranha não, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Você é... o cara do Labirinto de Vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "#Gygax! Mas você não está errad{F#a}{M#o}... e não é como se eu ficasse irritado porque o Labirinto de Vento é mais famoso que eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}