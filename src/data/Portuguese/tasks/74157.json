			"dialogs": [
				{
					"id": 741570301,
					"content": "Essa casa está à venda. Por um preço bem razoável, compre antes que seja tarde demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Informações de Venda de Imóvel"
				},
				{
					"id": 741570302,
					"content": "#{M#Sr.}{F#Srta.} {NICKNAME} e Srta. Paimon! Vocês estão aqui para falar com o Sr. Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570303,
					"content": "Benoit está em casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Ele não está aqui. Pai disse que o Sr. Leroy nunca mais vai viver aqui, ele foi viver lá embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570308,
					"content": "No Fleuve Cendre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "É o mesmo Fleuve Cendre para onde fomos antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "Se for, então não, aquele lugar não. Pai disse que é muito mais lá embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570311,
					"content": "O Pássaro a Vapor disse que o Sr. Leroy caiu de um lugar muito alto quando ele estava subindo uma montanha e saiu tombando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570312,
					"content": "Embora, para ser sincera, eu não faço ideia do que cair e se mudar tenham a ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570313,
					"content": "A propósito, eu vi o genro do Sr. Leroy! E tinha uma senhora muito legal também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570314,
					"content": "A senhora gostou realmente de mim, e ela tem os olhos da mesma cor que os meus! Ambos são violetas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570315,
					"content": "Ela até perguntou onde eu morava e disse que viria aqui se tivesse um tempo, para sermos amigas! Acho que todos da família Leroy são boas pessoas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570316,
					"content": "*Suspira* Eu até comprei algumas Fruta Bulle para o Sr. Leroy, mas já que ele não está aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570317,
					"content": "Posso dar elas a você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570318,
					"content": "Obrigada, Moli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Por nada! Papai e mamãe sempre dizem que devemos ser generosos com nossos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570320,
					"content": "Eu fiz outra coisa boa hoje! Eu vou voltar e escrever em meu diário, viva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570321,
					"content": "Conforme você vê Moli indo embora, e deixando aquela rua para trás, a história da família Leroy chega ao fim.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Só estávamos de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Eu estava pensando se deveria te dizer que o Sr. Leroy se mudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570307,
					"content": "Pai disse que o Sr. Leroy nunca mais vai viver aqui, ele foi viver lá embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Moli"
				}
			]
