			"dialogs": [
				{
					"id": 741570201,
					"content": "Essa casa está à venda. Por um preço bem razoável, compre antes que seja tarde demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Informações de Venda de Imóvel"
				},
				{
					"id": 741570202,
					"content": "#{M#Sr.}{F#Srta.} {NICKNAME}, Srta. Paimon, parece que o Sr. Leroy não vive mais aqui! Vocês viram ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570203,
					"content": "(Ei, você quer dizer a verdade?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "Nos deparamos com ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "Então você viu ele! Você disse a ele que os lanchinhos estavam deliciosos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570206,
					"content": "Dissemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#Eu sabia que {M#o Sr.}{F#a Srta.} {NICKNAME} era confiável! Você é {M#o}{F#a} melhor. Eu trouxe algumas Frutas Bulle, vamos comer junt{M#o}{F#a}s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570214,
					"content": "Moli suspira e acena, e assim que ela está prestes a sair...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "A porta abre e Autumn e Atos saem.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "Então foram as vozes de vocês que ouvimos do lado de fora! É alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Só estávamos de passagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "Sério? Mundo pequeno. Autumn e eu estávamos de saída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570219,
					"content": "E Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "Oh, ele já foi para algum outro lugar. Um lugar que iremos apenas depois de mais algumas décadas. Não acho que você o verá tão cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570221,
					"content": "Embora seja difícil de dizer. O que virá primeiro, o amanhã ou o fim? Quem sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570225,
					"content": "Essa não é a menina que está sempre procurando por Benoit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "Oi, moça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570228,
					"content": "...Parecem demais, e você até tem os olhos violetas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "M-Moça, posso te ajudar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570230,
					"content": "Qual é a sua idade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "Tenho nove!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570232,
					"content": "Quais são os nomes dos seus pais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Uh... você está bem, senhora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570234,
					"content": "Sua expressão... tem algo errado com a criança? ...Espere, isso não pode ser uma coincidência, pode?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570235,
					"content": "Você é adotada? Me diga! Agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#...{M#Sr.}{F#Srta.} {NICKNAME}, você conhece essa moça? O que ela está fazendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570237,
					"content": "Quem faz perguntas assim? Permita-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570238,
					"content": "Jovenzinha, eu me lembro que você é bem próxima do nosso pai, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570239,
					"content": "Sim! O Sr. Leroy cuida muito bem de mim. Sr. Genro, ele não vive mais aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570240,
					"content": "Isso mesmo, ele foi para um lugar bem longe, e não voltará novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570241,
					"content": "Sobre o que o nosso pai fala normalmente com você? Você pode me dizer? Quando eu voltar, eu posso dizer a ele que você sente muita falta mesmo dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570242,
					"content": "Sr. Leroy sempre me dá lanchinhos, me deixa fazer carinho na Nana, e diz que meus olhos são bonitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570243,
					"content": "Mais alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570244,
					"content": "Ele costuma me dizer para dar oi para minha mãe e meu pai por ele, mas eles realmente não gostam disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570245,
					"content": "O papai fica bem bravo, e diz que o Sr. Leroy é uma pessoa ruim, e que está \"chantageando\" eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570246,
					"content": "Embora eles me proíbam de vir aqui, eu fiz um acordo com o Sr. Leroy de vir escondida. Por favor, não diga ao meu pai, moço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570247,
					"content": "É bem a cara dele. Ele não vai parar de apertar até que tenha conseguido até a última gota de valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "...Aquele maldito... Desculpe. Estávamos falando de outra coisa agora pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570249,
					"content": "Moço, moça, mais alguma coisa? Se não, então e-eu irei para casa agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570250,
					"content": "...Seu pai e sua mãe te amam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Eles são os melhores pais do mundo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Isso é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "Estou indo para casa agora! Tchau, moça! Tchau, moço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570255,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "Está realmente tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "Eu imaginei essa cena de novo e de novo... mas nada é melhor do que saber que ela está feliz. Isso é o suficiente para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Eu... não sou o meu pai. Eu não quero causar problema para a família atual dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "Eu não quero ser \"aquele\" cara, mas, você não comprou uma caixinha de música para ela? Você não vai mais dar para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "Não, não há necessidade. Ela... não parece que falta coisas assim para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Vou pensar em formas de continuar visitando ela no futuro. Seja o que ela precisar, encontrarei uma forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "...Vou dar a caixinha de música para outra pessoa. Afinal de contas, passei muito tempo e esforço escolhendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Com licença, pequena garotinha de cabelos brancos... você gosta de presentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "Você quer dizer, Paimon? Espera, você quer dar isso a Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Sim. É um presente, então, por favor, espero que goste. Espero que tenha um pouco de valor para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Desculpe, Atos, acho que teremos que ficar um pouco mais na Corte de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "Não se preocupe, dá no mesmo para mim. Vamos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570270,
					"content": "Conforme você vê os dois indo embora, e deixando aquela rua para trás, a história da família Leroy chega ao fim.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "Você não planeja contar a ela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "Como está Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "Esse mundo está cheio de desequilíbrios, extrema pobreza e extrema ganância. As punições que as leis de Fontaine falham em aplicar, nós a aplicaremos no seu lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570224,
					"content": "Eu quero dizer, ele foi para onde ele deveria estar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741570208,
					"content": "Esquecemos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "Ah, sério? Que pena. Acho que nunca vou ter a chance de contar para o Sr. Leroy. Quanto às Frutas Bulle que trouxe... acho que deveria dar elas para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570210,
					"content": "Não nos deparamos com ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Oh, que pena. Acho que nunca terei a chance de ver o Sr. Leroy de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570212,
					"content": "Eu trouxe algumas Fruta Bulle e estava planejando dá-las a ele caso eu o visse... mas já que ele não vive mais aqui, por que você não fica com elas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Moli"
				},
				{
					"id": 741570213,
					"content": "Mas, independente de tudo, acho que sempre me lembrarei do Sr. Leroy! Tchau-tchau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Moli"
				}
			]
		},
