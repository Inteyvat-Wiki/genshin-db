		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Me lembro que esse livro de suspense foi popular por muito tempo, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170402,
					"content": "O sucesso do livro é devido aos seus enigmas e histórias engenhosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170403,
					"content": "Apesar de muitos leitores terem reclamado que algumas histórias eram muito exageradas e inesperadas, e às vezes não as conseguiam compreender. Mas o autor continuou a insistir em seus princípios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170404,
					"content": "Foi assim que esse livro se destacou entre os outros de suspense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170405,
					"content": "Mas ele também possuía uma base sólida. Somente com uma base assim e inflexível que é possível manter uma história de suspense como essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170406,
					"content": "Uh... Viajante, você tem outros livros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Esse daqui? Lembro-me de ser muito bem escrito, e a trama ser muito bem amarrada. Todos os editores o aprovavam, e na época as vendas também foram muito boas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170502,
					"content": "Mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170503,
					"content": "Mas como esse livro estava demasiadamente preocupado em amarrar a trama com a sua base, não deu nenhum espaço para a trama se desenvolver, e ficava repetindo coisas que o leitor já sabia até o final.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170504,
					"content": "Mas como não foram publicadas quaisquer novas histórias, esse livro gradualmente foi perdendo de leitor por leitor até que depois do último desistir dele, desapareceu em silêncio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170505,
					"content": "Não importa se são as bases da história, ou a história em si. Se quer fazer ela caber dentro de uma caixa, como se fosse um padrão, ela gradualmente morrerá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170506,
					"content": "Eu não quero que meu livro se transforme nisso! O que uma boa história precisa para se destacar é sua vivacidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170507,
					"content": "Mas... Se o autor não estiver interessado em sua própria história, como que ele fará seus leitores também se interessarem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170508,
					"content": "Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170509,
					"content": "...Eu entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170510,
					"content": "Não esperei que você teria tantas ideias, afinal de contas, era de se esperar do autor do Espírito Marcial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170511,
					"content": "Na verdade, eu não quero limitar a sua criatividade. Mas já vi muitos autores que por terem exagerado em sua imaginação e desejo criativo, acabaram por destruir suas próprias obras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170512,
					"content": "Junkichi, como um autor, qual sua opinião a respeito da criatividade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170513,
					"content": "Para mim, se não existe desejo do autor em ser criativo, com certeza não poderá fazer uma obra com criatividade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170514,
					"content": "Mas do meu ponto de vista, que também é o ponto de vista de um autor, os autores devem saber controlar sua própria criatividade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170515,
					"content": "Ainda não estão de acordo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Shigeru, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170518,
					"content": "Não sou eu que estou escrevendo esse livro, mas sim você. Eu sou apenas o editor que quer lhe ajudar a completar ele, somente isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170519,
					"content": "Se você realmente tem razão para continuar persistindo, escreva de acordo com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170520,
					"content": "Não posso dizer que chegamos a um entendimento, mas posso dizer que posso me esforçar para lhe compreender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170521,
					"content": "Shigeru, muito obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170522,
					"content": "Tudo bem, isso é o que eu devo fazer. Claro, se estou disposto a lhe entender, você poderia também fazer o mesmo para mim, por exemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170523,
					"content": "Hã, o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170524,
					"content": "Por exemplo, já se passou um dia, onde está o seu rascunho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170516,
					"content": "Parece que você não convenceu ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				}
			]
		},
		{
			"id": 2201706,
