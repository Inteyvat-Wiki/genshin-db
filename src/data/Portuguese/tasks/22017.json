			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Não escreverei mais! Não adianta me pressionar! Eu não serei mais um escritor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Você já ameaçou fazer greve sete vezes, você acha mesmo que vou levar isso a sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Por que vocês estão brigando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "Viajante, finalmente você chegou! Por favor, me ajude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "Desde a última vez que você o ajudou, ele passou a usar isso como pretexto para ser cada vez mais exigente, e não para de criar novas regras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "Elas são a respeito de tudo, desde minúsculos detalhes até a direção da trama. Ele quer mudar todos os padrões de se escrever um livro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Como que eu escreverei um livro dessa maneira? Quer que eu escreva de acordo com o que ele mesmo determina?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Esses são os princípios que tirei dos livros de sucesso, todos eles são parte da experiência de meus antecessores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "Então o que você está fazendo de fato é forçando o que outros fizeram em meu livro! Diga-me, isso é um livro que eu estou escrevendo, ou esses antecessores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Eu me recuso a escrever algo assim. Se você quer uma coisa rígida como essa, então você mesmo escreva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "Além disso, a Editora Yae já não muitos Light Novels assim que não estão vendendo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "Isso é só um erro da estratégia de marketing, não tem nada a ver com o livro em si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Como que isso não tem nada a ver com o livro? Com certeza é porque a maneira com que esses autores escrevem os livros tem problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Você provavelmente não prestou atenção a cada livro editado. Como um escritor, eu li cada livro que a Editora Yae publicou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "Viajante, por favor, traga alguns Light Novels para mim, terei uma boa conversa com ele a respeito disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Que tipo de livros devo pegar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Basta trazer os livros que eu deixei por aí. Uso eles constantemente como um aviso para mim mesmo sobre o que não escrever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
