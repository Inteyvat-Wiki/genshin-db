					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000301,
					"content": "Então, sobre a Ilusão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Hah! Você é tão idiota assim ou se faz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "Você nem sequer é um membro oficial dos Fatui. Você realmente acha que pode só vir perguntando \"o que é uma Ilusão\" assim sem mais nem menos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "Você realmente acha que eu iria te contar tudo? Como aqueles guardas dos Cavaleiros de Favonius no portão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "Ainda assim, Ilusões são nossa fonte de orgulho e alegria - não deve fazer mal em te contar um pouquinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "Vamos fazer o seguinte, então. Acredito que você viu aqueles Ladrões de Tesouro fora de Mondstadt, correto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "Eles são um bando de trapaceiros insignificantes, mas de vez em quando tropeçam em algo de valor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "Se você conseguir ir até lá e pegar alguma coisinha deles, eu te contarei um pouquinho sobre Ilusões em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "Acho que gosto de você. Vá lá então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "Você está sem dinheiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Dinheiro? Hahahaha, você realmente acha que eu sou um daqueles Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "Não, eu só gostaria de saber o que aqueles Ladrões de Tesouro conseguiram achar em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "Dito isso, eu não acho que eles encontrariam nada interessante. *risadinha*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
