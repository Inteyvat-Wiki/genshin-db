			"dialogs": [
				{
					"id": 206001001,
					"content": "Você trouxe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001002
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001002,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Oh, veja só, nada mal. Você tem algumas habilidades afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Então, você gostaria de saber sobre a Sua Majestade a Tsaritsa, correto? Então, por onde começar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "Se você precisar de um simples resumo, basicamente a Tsaritsa é nossa deusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Isso não é dito de forma abstrata, é a mais pura e concreta verdade. A Tsaritsa é a Arconte Cryo, uma dos Sete que dominam o reino mortal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Mas, para nós dos Fatui, Sua Majestade tem um nível ainda maior do que até mesmo o de um deus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "Agora sobre o porquê... Duvido que você iria entender mesmo que eu explicasse. Ou eu deveria dizer, você não conseguiria entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Se você gostaria de entender, então junte-se a nós. Quando você fizer isso, você irá compreender como Sua Majestade a Tsaritsa é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "... He, e isso é tudo que direi por ora. A freira já está me olhando de um jeito torto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		}
	]
}