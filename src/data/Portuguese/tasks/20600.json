			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "Você trouxe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000602,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Deixe-me ver. Bem... É aceitável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Agora, deixe-me contar um pouco sobre os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "Nós do Fatui somos do Palácio Zapolyarny. Ouvimos as ordens de Sua Majestade a Tsaritsa e herdamos a sua vontade, promulgando-a em toda à terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "Os onze mais fortes entre nós, receberam o título de Mensageiro pela Sua Majestade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "Comparado a um soldado sem nome como eu, os Onze Mensageiros são realmente grandes figuras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "Se você se juntar aos Fatui e provar a sua força, então talvez você possa ser escolhido para se tornar um deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "A partir disso você só continuaria subindo e subindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "Quanto a mim? Bem, dificilmente fui \"escolhido\", mas estou fazendo alguns trabalhos para a Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "Mas se me obrigassem a escolher... Eu preferiria trabalhar para o Capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
