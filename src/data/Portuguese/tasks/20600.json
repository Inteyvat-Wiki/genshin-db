			"dialogs": [
				{
					"id": 206000401,
					"content": "Agora, sobre a Tsaritsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "O quê, você quer me perguntar sobre a Tsaritsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "Esse é o motivo pelo qual você quer se juntar aos Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "Eu não pretendo te desapontar, mas meça suas palavras por um momento, por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "Ainda assim, a Tsaritsa é algo do qual eu não posso te contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "Por que você não vai lá e pega algo de um Guarda das Ruínas? Estou precisando de algo para me distrair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Bem, pode ir então. Ficarei esperando aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "Para que você precisa disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Hã? Um homem não pode coletar algumas bugigangas? Ou o povo de Mondstadt tem medo de um pequeno Guarda das Ruínas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "Para nós dos Fatui, nós mal precisaríamos levantar um dedo para lidar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Ainda assim... *Suspiro* essa brisa está realmente me colocando para dormir. Então eu vou deixar este problema insignificante com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
