			"dialogs": [
				{
					"id": 206000901,
					"content": "Você está à procura de um troféu obtido pelo corpo de um Guarda das Ruínas, está certo? Não fique preguiçoso e tente me enganar com qualquer outra coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000902
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000902,
					"content": "*Suspiro* Estou ficando cada vez mais sonolento conforme o tempo passa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
