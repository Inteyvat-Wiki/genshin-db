			"dialogs": [
				{
					"id": 206000801,
					"content": "Você trouxe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000802,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Deixe-me ver. Bah, claro que você não conseguiria encontrar nada de bom nesse lugar tão sem graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "Está bom, está bom, uma história sobre as Ilusões chegando. Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Ilusões são tesouros de incrível poder, concedidos pessoalmente por Sua Majestade a Tsaritsa. Quer seja pela fé ou Visão, uma Ilusão faz com que todos eles pareçam brincadeiras de criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Ainda assim, nem todo mundo pode ter uma. Além dos Onze Mensageiros, poucos são os Fatui que possuem Ilusões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Ainda assim, para um simples e ordinário mortal como eu, uma Ilusão é muito mais prático de se conseguir do que uma Visão, que só pode ser recebido pela graça de um deus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Ha, vejo que você também não possui uma Visão. Que tal, então? Você se junta aos Fatui e quem sabe? Talvez você pode até conseguir possuir uma Ilusão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "E isso é tudo que eu tenho a dizer sobre as Ilusões. Os Cavaleiros de Favonius são bem sensíveis sobre essas coisas, então é melhor você não os mandar atrás de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
