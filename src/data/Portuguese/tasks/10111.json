				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley",
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "*Suspiros*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110402,
					"content": "Eu tinha certeza de que estava prestes a morrer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110403,
					"content": "Para ser sincero, isso poderia ter dado em ambos os sentidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110404,
					"content": "Então - você deve ser Jack, o Aventureiro, suponho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110405,
					"content": "Sim... Quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110406,
					"content": "Na verdade, viemos procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110407,
					"content": "Ellin tem uma mensagem para você, ela disse que não poderá se juntar a você hoje para planejar sua próxima aventura juntos. Ela se juntará a você em outra ocasião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110408,
					"content": "Ah, entendo... Me sinto mal por você ter vindo de tão longe para me encontrar... E depois ainda teve que me resgatar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110409,
					"content": "Hã! Não vejo o porquê de tanto alvoroço. Não foi nada que eu, Stanley, não pudesse ter lidado sozinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110410,
					"content": "Uau! Você é o Stanley? Você é aquele aventureiro lendário? Renomado em toda Mondstadt? Que uma vez pôs os pés no Mare Jivari!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110411,
					"content": "Hehehe, em pessoa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110412,
					"content": "Hahaha! Devo dizer que é uma honra conhecer alguém tão lendário quanto você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110413,
					"content": "Bem, então, como todos gostariam de prosseguir? Voltar ou ir mais para dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110414,
					"content": "O que você acha, Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#Hehehe, bem, {M#Meu garoto}{F#Minha garota}... Acho que agora você está nas mãos seguras de Stanley, o grande explorador e lenda de Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110416,
					"content": "E que neste caso, por que voltar agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110419,
					"content": "Muito bem, moção aprovada por unanimidade! Vamos mais adiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110417,
					"content": "O que você acha, Jack?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Acho que devemos seguir em frente. Com Stanley ao nosso lado, não teremos problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "Viajante, creio ter feito uma pequena descoberta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "Posso te pedir para usar o detector nirnama mais uma vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "O quê? O Stanley tem um amigo imaginário!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "Parece que o amigo imaginário dele é um guerreiro experiente, coberto de cicatrizes da cabeça aos pés, com um olhar de firme determinação em seu rosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "Isso se encaixa na descrição de Stanley sobre si mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Você está dizendo que o amigo imaginário dele é uma versão idealizada dele mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "Ideia interessante! Mas será que é verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "Com licença, eu estou indo embora agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "Tchau, Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "#Vocês {M#dois}{F#duas} ainda têm tempo livre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "Alguns dias atrás, o Stanley ficou bêbado e me contou uns segredos - algo que ele nunca contou a ninguém antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "As armas que ele levou em sua aventura em todos aqueles anos atrás... Não eram outras senão aquelas que uma vez foram empunhadas pela maior heroína de Mondstadt, a própria Vennessa! A <color=#00E1FFFF>Espada da Bravura</color> e o <color=#00E1FFFF>Escudo da Honra Magnífica</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Não sei se você acredita em mim, mas... Aparentemente tanto a espada quanto o escudo ainda estão bem aqui em Mondstadt, no <color=#00E1FFFF>Vale de Dadaupa</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "Como vocês são peritos nisso... Vocês poderiam vir comigo para tentar encontrar essas duas armas lendárias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "Stanley realmente era o dono dessas armas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Pode apostar! É do Stanley que estamos falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Se eu conseguir algo impressionante o suficiente para mostrar à minha família do que eu sou capaz, talvez eles finalmente se adaptem à ideia de eu ser um aventureiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "Neste momento, sou apenas um novato, minhas habilidades são limitadas e meus pais não apoiam nem um pouco meus objetivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Então, o que você diz? Pode me dar uma ajudinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "Não posso contar ao Stanley, porque minhas razões são tão egoístas... Mas, eu juro que lhe devolverei as armas assim que eu terminar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Aw, pobre Jack... Vamos ajudá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "Tudo bem, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, você também vem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Hm... Eu não sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Oh, uma outra coisa - tenho uma garrafa de vinho raro da safra que pedi a alguém que buscasse para mim há alguns anos atrás. Me ajude a encontrar estas armas e é toda sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "No <color=#00E1FFFF>Vale de Dadaupa</color>? Vamos nos apressar, não há tempo a perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "É difícil dizer não depois dessa história triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Por que ele os abandonou na natureza, então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Não sei, as pessoas excepcionais vêm sempre com suas peculiaridades, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110608,
					"content": "Eu sabia que havia algo estranho em sua história...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "Oh? Você também achou, hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110610,
					"content": "Eu concordo. Ele não está contando a história toda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}