	"talks": [
		{
			"id": 2401301,
			"completionStepIds": [
				2401301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
