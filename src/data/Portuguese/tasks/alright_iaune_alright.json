					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "Viajante... Você me preparou mesmo uma xícara de café? Hmm, eu... perdão por te incomodar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "Fica tranquilo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "Este café... É bem melhor do que o que servem no Maison Gestion! Na verdade, tem uma dimensão inteira de diferença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Se esse fosse o café que bebo todo dia, eu não passaria tanto tempo tentando ficar acordado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Obrigado pelo café. Vou voltar ao trabalho assim que terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "Dê o seu melhor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Pode deixar. Preciso me consolidar no trabalho o quanto antes e ficar apoiado nos meus próprios pés, como Roialte faz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "*Suspiro* Eu só queria saber quantos pesadelos terei que aguentar antes disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "Fique de cabeça erguida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Só bebe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
