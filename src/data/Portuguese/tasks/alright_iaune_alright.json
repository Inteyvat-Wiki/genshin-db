					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "Você começa a preparar o café...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Oh, isso tá com um cheiro ótimo! Vamos levar para Iaune! Paimon tem certeza que isso vai animar ele!",
					"roleType": "TALK_ROLE_NPC",
