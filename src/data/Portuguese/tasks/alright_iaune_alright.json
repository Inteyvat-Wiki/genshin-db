				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arouet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "#Viajante, você veio para nos ajudar? Você é muito bem-vind{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130202,
					"content": "Não, não, estamos aqui apenas para ajudar um amigo fazer um café. Ele só está, bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130203,
					"content": "Se sentindo meio para baixo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "Por \"amigo\", você quis dizer, Iaune — sabe, o sujeito sentado bem ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130206,
					"content": "Você conhece ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "Roialte e eu somos bons amigos. Ele mencionou que um sujeito brilhante e trabalhador veio até seu escritório recentemente, no caso, o Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130208,
					"content": "Mas não se preocupe muito com ele — pessoas jovens que acabaram de começar pelo Maison Gestion sempre se encontrarão meio para baixo no início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130209,
					"content": "Eles ficarão bem quando encontrarem um lugar para si por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130210,
					"content": "Você parece bem experiente. Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130211,
					"content": "Bem, eu também costumava ser um rabanete plantado no campo que é o Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130212,
					"content": "Mas eu não estava feliz em ser um mero rabanete, então deixei meu lote e... abri este café algum tempo depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130213,
					"content": "Me parece que muita coisa aconteceu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "Hahaha, talvez! Mas hoje em dia, sou apenas o dono de uma cafeteria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130216,
					"content": "#Muito bem, você não ia fazer uma xícara de café para Iaune? Irei ajustar o dispositivo — venha até mim quando estiver pront{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arouet"
				},
				{
					"id": 240130214,
					"content": "Me parece verdadeiros tesouros de histórias a serem contadas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "Ele está se sentindo pressionado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
