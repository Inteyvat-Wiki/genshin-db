			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "*Suspiro* Eu não sei porque isso aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "Oh, Viajante, prazer te encontrar. Está aqui para beber café? Eu te pago uma xícara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130105,
					"content": "O que houve? Você parece terrível. Alguém esteve te forçando a ficar acordado até tarde de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130106,
					"content": "Obrigado pela preocupação. Mas esse problema é meu dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130107,
					"content": "Estive pensando... sobre o significado do meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130108,
					"content": "Eu sempre acreditei que o Maison Gestion era uma organização justa, eficiente e forte em que todos estavam dispostos a se ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130109,
					"content": "Acredito que sob sua gestão, Fontaine se veria desenvolvendo positivamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130110,
					"content": "Mas do jeito que vejo agora, é uma casa mecânica arruinada. Suas engrenagens, alavancas e aberturas estão sendo puxadas caoticamente... Apenas sua fachada permanece imaculada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130111,
					"content": "Ele só opera por causa de uma série de coincidências e lições, não por uma consideração ou projeto preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130112,
					"content": "Eu... Eu quero fazer algo sobre isso, mas não posso. Receio que um erro faça a casa inteira cair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130113,
					"content": "Roialte sempre me diz para relaxar um pouco, já que meus erros não podem piorar mais as coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130114,
					"content": "E-Esse é um jeito estranho de consolar alguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130115,
					"content": "*Suspiro* Perdão, eu não deveria reclamar. Eu vim até aqui para fugir de tudo isso por um tempo, afinal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130116,
					"content": "Eu te preparo uma xícara de café.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Sério? Você sabe preparar café? Incrível — eu sempre quis aprender, mas nunca tenho tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130118,
					"content": "Eu deixarei isso contigo, então. Vou esperar aqui... com sorte, o trabalho não vai me pegar no café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130103,
					"content": "Está de folga hoje?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
