					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Enfim, apenas posso deixar meu carrinho por lá enquanto vejo se consigo contratar alguém para lidar com a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Se você está com tanta pressa de pegar madeira, vou marcar a localização aproximada do carrinho no mapa para você, então você pode dar uma olhada por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
