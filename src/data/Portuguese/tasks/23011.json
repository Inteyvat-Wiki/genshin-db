			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Hmm... Como vou esculpir isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Oi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Argh, quem é? Pare de me incomodar, eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "Hã?! Viajante? O que você está fazendo em Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Oh, qual é. Rudolf não mandou você aqui para me dar uma surra, né? Eu só mandei um presente para Lily!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "Só estou de passagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Você ainda está viajando... Que energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "Mas eu não esperava encontrar você aqui em Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "Minhas ordens originais eram para retornar de Mondstadt para Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "Mas outra ordem chegou e fui enviado para a Cidade de Sumeru para ajudar o Sr. Vsevolod. Além disso, me disseram que eu fui transferido para o comando do Mestre Pulcinella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "Pulcinella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Sim... Bem, não. Eu não vou falar mais nada, ou o Sr. Vsevolod criticará minha falta de sensibilidade envolvendo questões de confidencialidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "*Suspiro* Mas o nome dos Mensageiros sequer é um segredo. Nunca vou entender o motivo de ele ficar tão nervoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "Então... O que você está fazendo em Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Oh, eu e o Sr. Vsevolod somos responsáveis principalmente por apoio logístico e coordenação. Em resumo, fazemos muitas compras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "Não parece grande coisa, mas é melhor do que ficar parado sem fazer nada na Catedral de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Hehe, e com esse meu trabalho, tenho muito tempo livre, e ninguém fica de olho em mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "Eu até voltei a fazer meu passatempo de infância de entalhar madeira... E quem diria, Sumeru é uma terra cheia de madeira. É perfeito para praticar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "Eu nunca imaginaria que minhas esculturas de madeira seriam populares entre as crianças. Elas ficam sempre me perguntando por elas, por isso prometi que faria uma para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Mas você não é um Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Sou sim, e daí? Quem disse que um Fatui não pode fazer brinquedos para crianças?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "Além disso, eu sou apenas um cara da logística. As coisas importantes ficam todas nas mãos dos meus superiores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "Resumindo, essa é a minha situação. Apesar de não ter voltado para Snezhnaya, estou gostando bastante de Sumeru. Aqui tem comida, é divertido, o ambiente também é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "Depois do trabalho, eu compro algo para comer e procuro por um lugar com bastante sol para trabalhar com madeira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "Entretanto... Haha, todos olham para mim com desconfiança, como você na primeira vez que conversamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "Mas não posso fazer nada, afinal, eu sou um Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "Eu ainda não confio em você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Tudo bem... Enfim, eu estou feliz com minha vida agora. Até consegui poupar um pouco de dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "Se isso continuar por mais alguns anos, eu talvez fique aqui em Sumeru definitivamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "#Ahem! Bem, já chega disso. Como você está aqui em Sumeru, caso esteja interessad{F#a}{M#o}, vamos continuar com nossa \"troca equivalente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "Entretanto, dessa vez não tenho nenhuma história para lhe contar. Seu pagamento dessa vez será apenas de Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Prefiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Tudo bem, deixe-me lhe descrever sobre o que esta comissão se trata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "Encomendei um lote de madeira a Hamawi, mas ainda não foi entregue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "Não posso falar com ele diretamente enquanto estou no meu expediente, ou então o Sr. Vsevolod vai me dar uma sermão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "Viajante, você pode me ajudar perguntando a Hamawi sobre meu lote de madeira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Quero meu pagamento pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Oh, não se preocupe. Já está pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "Ah, não importa, estou contando com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "Você não está tramando nada mesmo, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Oh, qual é, quando eu fiz algo assim? Não se preocupe, não estou com vontade de fazer nada assim... O que tem de errado em eu levar uma vida simples?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Eu estou fazendo uma comissão para os Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Oh, mas é claro que não. Isso é uma comissão para mim, Viktor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "E quem confiaria em você? Não tente fingir que nos damos bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Você não tá tentando se aproveitar das crianças para conseguir informações, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Ei! Eu não faria uma coisa dessas! Que estereótipo horrível você tem dos Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "É outro Mensageiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Sim, volte para Mondstadt comigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Hahaha, vai nessa! Você vai me levar algemado de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Bem, bem, chega de brincadeira. Eu tenho algo para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110103,
					"content": "Vi—Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
