						230110602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110602,
					"content": "Você contou para Viktor o que aconteceu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Foram os monstros de novo? Argh, sou só eu, ou parece que toda carroça no mundo está sendo atacada por monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110604,
					"content": "Ah, não importa, só quero que minha madeira chegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110605,
					"content": "Oh, sim. Aqui está o pagamento que prometi. Pode contar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110606,
					"content": "E, mais uma coisa... Lily, ela, uh... Ela está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110607,
					"content": "Eu não me despedi dela quando parti. Ela não ficou brava, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "Ela está bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Bom, bom... Ahem! Oh, qual é, por que está olhando assim para mim? Eu só estava preocupado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "Enfim, conte seu pagamento. Eu preparei a quantidade exata, nem uma Mora a mais ou a menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110610,
					"content": "Você pode voltar e visitá-la pessoalmente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "O Sr. Vsevolod daria um chute para longe. Nem pensar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110612,
					"content": "E eu não tenho coragem de mandar uma carta diretamente também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
