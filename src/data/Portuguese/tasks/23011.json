			"dialogs": [
				{
					"id": 230110301,
					"content": "Mas que azar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110302,
					"content": "Sobre o lote de madeiras de Viktor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Oh, você está falando da madeira que aquele Fatui pediu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "*Suspiro* Eu sabia que fazer negócios com os Fatui não seria bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Monstros atacaram enquanto estávamos transportando. Conseguimos voltar com vida, mas nossa carroça foi destruída. Fomos forçados a deixar a madeira pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "Se vocês estão com pressa, podem ir lá para procurarem pessoalmente. Eu que não me atrevo a ir, nem encontro ninguém para eliminar esses monstros por mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "#Eu não sou {F#uma}{M#um} Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "#Você não é {F#uma}{M#um} Fatui? Então por que está ajudando um?",
