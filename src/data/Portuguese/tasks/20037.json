				"points": []
			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "Olá... Eu conheço essa voz... Viajante! É você! Não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370302,
					"content": "O que traz você aqui hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370303,
					"content": "Alguém me pediu para trazer essa carta para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "Uma carta para mim? Quem faria isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370305,
					"content": "...Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370306,
					"content": "Você tem visto ele? Isso quer dizer que ele está bem. Ele disse quando que voltava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370307,
					"content": "Desculpe, ele agora está muito ocupado. Esqueça o que eu falei agora há pouco, não dê pressão a ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370308,
					"content": "Mas você poderia ler a carta para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370309,
					"content": "#Em voz baixa... Ninguém precisa ouvir, exceto nós {F#duas}{M#dois}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370310,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "Você leu muito bem, você já leu carta para outras pessoas antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370312,
					"content": "Este é o final da carta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Porto de Liyue... Uau, o Godwin realmente foi para um lugar muito longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370314,
					"content": "Obrigada, eu vou guardar bem esta carta. A próxima vez que ver o <color=#00E1FFFF>Godwin</color>, diga a ele que estou pensando nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Glory"
				}
			]
		},
