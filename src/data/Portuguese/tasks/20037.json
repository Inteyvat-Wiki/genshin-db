			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Godwin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "...Ugh, estou louco para voltar a Cidade de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "Oh, Viajante! Oi! Posso lhe pedir um favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Como você pode ver, estou com os Cavaleiros, e estou de patrulha no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Eu contei a minha namorada que eu enviaria uma carta, antes que fosse tarde demais, para que ela possa saber que estou são e salvo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Mas estava tão ocupado, e me esqueci totalmente! Hahaha... Poderia entregar esta <color=#00E1FFFF>carta</color> a ela por mim? O nome dela é <color=#00E1FFFF>Glory</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Espere, Glory?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "A garota cega... a que estava coletando Sementes de Dandelion...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Ahá! Você deve ser o Godwin? A Glory falou de você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Ei, como você conhece a Glory?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Ela nos pediu um favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Ela... ela procurou vocês por ajuda? É para fazer algo perigoso? Vocês...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Ela só nos pediu para coletar algumas Sementes de Dandelion. Ela disse que se jogarmos ao vento, poderíamos transmitir nossos desejos para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Ah, Dandelions... Realmente é algo que a Glory faria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Você saiu de Mondstadt faz muito tempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Sim, bem, esse era o pla... Bem, deixe-me contar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Você ouviu falar daquela vez que o Grande Mestre de Mondstadt levou consigo quatro dos cincos cavaleiros com ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "Bem, certo, eu era um dos designados para a expedição. Mas, infelizmente... Quando estávamos preparados para partir, eu percebi que eu perdi o amuleto que a Glory me deu. Naquele tempo eu procurei por tudo que é canto, quando encontrei, eles já tinham partido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Eu ainda não descobri como alcançá-los e, ao mesmo tempo, tenho só andando por aqui..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Não consigo voltar à Cidade de Mondstadt. Eu apenas consigo imaginar que os Cavaleiros iriam pensar de mim se eu voltasse me arrastando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "Além disso, prometi a Glory que enviaria cartas e presentes do mundo inteiro. Eu disse que daria o mundo para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Se ela percebesse que eu ainda não saí de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "Você não vai querer passar vergonha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Por favor, entregue esta <color=#00E1FFFF>carta</color> para a <color=#00E1FFFF>Glory</color>, pode ser? Eu aposto que ela está preocupada comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "Muito obrigado, Viajante. Por favor, mantenha em segredo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Por que não tenta usar Dandelions?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Tem muita coisa que quero dizer para Glory, muito mais do que se espera poder carregar de Sementes de Dandelion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Obrigado por me ajudar a entregar a carta. E lembre-se, não fale nada sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
