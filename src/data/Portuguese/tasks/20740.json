			"dialogs": [
				{
					"id": 207400401,
					"content": "Sobre aquelas flores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "Você terminou de pegar as flores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400403,
					"content": "Coletei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "Elas estão todas tão fresquinhas... Muito obrigada. Com estas flores na vitrine, com certeza elas irão atrair muitos clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400405,
					"content": "Se eu pudesse fazer um outro pequeno pedido... O vento também soprou todos os Dandelions que eu tinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400406,
					"content": "Ainda que Dandelions sendo levadas pelo vento não seja uma coisa ruim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400407,
					"content": "Ainda seria estranho que um florista de Mondstadt não tenha Dandelions.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400408,
					"content": "Dandelions não podem simplesmente ser arrancados e trazidos de volta - eles precisam brotar novamente, do início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400409,
					"content": "Então, você poderia me ajudar a conseguir um pacote de sementes de Dandelion para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400410,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Estou contando com você, então. Se me lembro bem, existem vários Dandelions logo do lado de fora de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400412,
					"content": "Onde eu devo começar a procurar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "Existem vários Dandelions fora da cidade. Você deve ser capaz de consegui-los facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
