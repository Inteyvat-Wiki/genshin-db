				},
				{
					"id": 207400502,
					"content": "Você conseguiu pegar os Dandelions?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400503,
					"content": "Eu tenho eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Obrigada. Isto deve ser suficiente. Irei plantar estas sementes nestes vasos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "... Junto com aquelas flores que você encontrou para mim mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah sim, eu tenho que te agradecer, não tenho? Isto é uma lembrancinha, por favor, pegue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Agora, tenho que colocar estas flores dentro destes vasos aqui. Então estas sementes de Dandelion vão aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
