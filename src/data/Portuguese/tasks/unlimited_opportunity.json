			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "Outras pessoas também podem ter a mesma ideia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "Oh, é claro, é porque devemos ir o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310303,
					"content": "Viajante, se você quiser, vamos partir imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310304,
					"content": "Estamos perdendo tempo e Mora ficando aqui conversando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310305,
					"content": "... Uau... Parece que não tem nenhum jeito de convencê-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310306,
					"content": "Talvez possamos convencê-lo que não vai ganhar dinheiro com isso... Ou que os meteoritos são muito perigosos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
