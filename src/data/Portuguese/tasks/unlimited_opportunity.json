	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "Hmm... Eu poderia fazer um bom dinheiro com esse negócio. Mas ainda tem um pequeno problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310102,
					"content": "Que problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "Hum? Oh... Viajante, você veio no momento certo! Você tem interesse em participar de uma... Uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310107,
					"content": "Uma forma de ganhar dinheiro... Misteriosa... Enorme... Nunca antes vista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310108,
					"content": "Só preciso que você me ajude um pouco. Nós ganharemos um bom dinheiro com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310104,
					"content": "O Banco do Norte é uma local de segurança máxima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "Ah, sim, claro. Todos os guardas são de Snezhnaya. Eu... Não! O que você está pensando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310106,
					"content": "Parece que suas viagens abriram suas perspectivas, seus pensamentos são realmente fora do comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310112,
					"content": "Desta vez, meu plano de negócios é bem realista, pé no chão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310113,
					"content": "Você sabe sobre aquela chuva de meteoritos recente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310114,
					"content": "Eu quero achar um daqueles meteoritos, quebrar umas peças e trazer elas de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310115,
					"content": "Depois, achar um artesão talentoso para transformá-las em joias e ornamentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310116,
					"content": "Objetos feitos de meteorito... Independentemente de serem anéis, colares, pulseiras ou brincos, só importa que vão deixar as pessoas ricas com vontade de gastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310117,
					"content": "Viajante, o que você tem que fazer é muito simples, só precisa garantir que os monstros não me interrompam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310118,
					"content": "Então, o que você acha? Temos um acordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310119,
					"content": "Você não pode, de jeito nenhum, se aproximar dos meteoritos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "O quê? Por quê? Eu não posso perder essa oportunidade de fazer um bom negócio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310109,
					"content": "Você descobriu algo novo nos códices legais de Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "Um, na verdade, os códices legais de Liyue são muito estritos, quase não possuem lacunas, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310111,
					"content": "Mas... Mas o que quero fazer definitivamente está dentro dos limites da lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "Ivanovich"
				}
			]
		},
		{
