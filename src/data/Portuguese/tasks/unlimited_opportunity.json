					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310501,
					"content": "Você tem certeza de que consegue achar ornamentos que combinem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310502
					]
				},
				{
					"id": 411310502,
					"content": "Oh, não se preocupe com isso, eu vou encontrá-los de um jeito ou outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310503
					],
					"speakerTitle": "Ivanovich"
				},
				{
