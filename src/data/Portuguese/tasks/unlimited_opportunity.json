			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "Se você tocar o meteorito, vai desmaiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "Uh? Ah... Eu ouvi essas histórias, isso é um problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310403,
					"content": "Mas, estou convencido de que máquinas podem resolver esse problema... Devem conseguir, eu acho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 411310404,
					"content": "Ooh, parece que ele está cedendo. Será que... Está considerando os custos desse plano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411310405,
					"content": "Vamos continuar tentando convencê-lo, diga que ele com certeza não fará dinheiro, e que... Que os meteoritos são muito perigosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4113105,
			"completionStepIds": [
				4113105
			],
			"beginWay": "TALK_BEGIN_NONE",
