			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour! Faz tanto tempo! E Maime também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Haha, Seymour não parava de me dizer o quanto sentiu sua falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540503,
					"content": "Positivo. Nunca parei de pensar na Srta. Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "E obrigada, Srta. Sandrone, por organizar este chá. É tão bom podermos nos reunir e conversar sobre nossas viagens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Não precisa agradecer. Sinto que todos nós somos uma família, de certa forma, com uma longa história em comum. Uhm, pelo menos é assim que eu vejo. Então não há problema algum em nos reunirmos quando todos estiverem livres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540506,
					"content": "Família? Não sei por quê, mas ouvir você dizer isso me enche de alegria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Então isso faz da Srta. Sandrone nossa... irmãzinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Uhm... Talvez a gente possa pular essa coisa de mais velho e mais novo por enquanto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540509,
					"content": "Positivo. Como o protótipo criado pelo Sr. Alain, a Srta. Sandrone deveria me chamar propriamente de \"Irmão Mais Velho\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Tsc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540511,
					"content": "Que adorável. Será que eu também posso fazer parte dessa família?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540512,
					"content": "Claro! De toda forma, já não é exatamente uma família convencional — incluir uma Melusine nessa mistura parece até natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540513,
					"content": "Positivo. A Srta. Maime já é minha família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Hehe. Isso me deixa tão feliz! Que tal eu pintar um retrato de família de todos nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540515,
					"content": "Um retrato de família? Faz muito tempo que não poso para um desses...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Certifique-se de me fazer parecer impressionante! Como a irmã mais velha da família!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Isso aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Maime"
				},
				{
					"id": 742540518,
					"content": "Hah... Por que não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
