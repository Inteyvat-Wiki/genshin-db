				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Que ótimo! Era isso mesmo, me espere um pouco, vai ficar pronto em um instante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Um momento depois...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Eu estava certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "O Barro molhado tem uma boa aderência, mas se quebra facilmente quando seca. Depois que são misturados ao barro da raiz da Flor Gigante, o barro se torna mais flexível após secar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "É que a mistura não pode ser moldada antes de começar a se solidificar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Porém, quando adicionamos o barro com o Condensado de Slime, esse barro se torna muito mais fácil de ser moldado antes de secar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "Não sei o motivo, mas se for para descrever, seria como se o barro tivesse virado um Slime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "Então, acho que podemos chamar de \"Barroslime\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Alguma propriedade dos Slimes parece ter afetado a mistura de alguma forma. É por isso que eu queria saber se adicionar Condensado de Slime o tornaria mais eficaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "E como pode ver, a plasticidade e a estabilidade da mistura mudaram com a quantidade de Condensado de Slime adicionado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Em outras palavras, não é apenas um material de construção, ele pode ser usado para cerâmica e muito mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "Parabéns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Obrigado. Suponho ser isso que aqueles \"especialistas\" querem dizer quando falam que \"De pedra em pedra se constrói um castelo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Não subestime este simples barro, ele poderá construir uma torre que tocará os céus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "Eu decidi chamar esta mistura de \"Barro Misto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "Então agora vou me dedicar a testar os possíveis usos para o Barro Misto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Ah, parece que uma possível solução para os problemas que assolaram as casas das pessoas recentemente está à vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "Obrigado, Viajante. Aqui está sua recompensa, fique com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "Seus esforços foram finalmente recompensados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Você gostou, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Eca! Paimon não pode comer barro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
