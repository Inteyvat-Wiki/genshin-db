			"dialogs": [
				{
					"id": 230080101,
					"content": "Acho que estou prestes a ter sucesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080102,
					"content": "Viajante! Espere um pouco, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080103,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "Eu preciso de Condensado de Slime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080106,
					"content": "A questão é que, nos últimos dias, tenho feito experiências, misturando o barro que você me trouxe em várias proporções diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080107,
					"content": "Foram muitos fracassos... Mas finalmente encontrei uma proporção de mistura utilizável!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080108,
					"content": "Falta plasticidade no Barro Misto com esta proporção antes de endurecer, mas depois disso, torna-se forte e durável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080109,
					"content": "Talvez eu precise adicionar mais barro com Condensado de Slime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080110,
					"content": "Por favor, Viajante! Você poderia trazer mais três Condensados de Slime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080111,
					"content": "Tendo estes Condensados de Slime, com certeza poderei fazer o barro perfeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080104,
					"content": "O que você precisa desta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
