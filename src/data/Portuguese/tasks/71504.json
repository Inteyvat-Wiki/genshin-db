				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "*Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040102,
					"content": "Hosseini, o que aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040103,
					"content": "Para encontrar uma maneira de transportar a Ponta de Pursina para a boca da Linha Ley na mina, fiquei na mina tempo demais e acabou me afetando um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040104,
					"content": "Mas não é nada sério, depois de descansar um pouco, já recuperei bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040105,
					"content": "Ao mesmo tempo, consegui pensar em uma solução, encontrar uma maneira de transportar a Ponta de Pursina, como pode ser mais difícil do que encontrar uma desculpa para atrasar o envio do relatório de pesquisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040106,
					"content": "Se a Lama Preta cobriu o chão, então basta flutuar um pouco usando um balão de ar quente para transportá-la até o túnel da mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040107,
					"content": "Assim dizendo, o balão de ar quente é realmente uma boa solução.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040108,
					"content": "É claro que, embora possa resolver o problema da Lama Preta até certo ponto, quando houver excesso de Lama Preta bloqueando o túnel, isso ainda afetará a movimentação do balão de ar quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040109,
					"content": "E, haverá monstros ao redor da Lama Preta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040110,
					"content": "Temo que isso tenha que ser deixado em suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040111,
					"content": "#Não se preocupe, {NICKNAME} e eu conseguiremos afastar todos os monstros que se aproximarem do balão de ar quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040112,
					"content": "Dependeremos de você então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "Eu... eu tomarei a responsabilidade principal de torcer por você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 715040115,
					"content": "Hahaha, ah... *Cof, cof* *Cof, cof*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040116,
					"content": "Tossindo tanto rindo assim... De qualquer forma, Lao Tu e Hao estão ajudando a embalar a Ponta de Pursina e preparando o balão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040117,
					"content": "No começo eu queria embalar as pontas de Pursina sozinho, mas ficar de pé me faz tossir muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040118,
					"content": "Que vergonha, parece que no futuro não farei apenas pesquisas acadêmicas, mas também precisarei fortalecer meu corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040119,
					"content": "Vá encontrá-los rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hosseini"
				},
				{
					"id": 715040113,
					"content": "Irei te emprestar a espada em minhas mãos por um tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
