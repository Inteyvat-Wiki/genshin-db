			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#Ei, {NICKNAME}, acabamos de terminar de embalar e você apareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040202,
					"content": "Aquele cara de Sumeru já deve ter lhe dito para usar este balão de ar quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040203,
					"content": "Que cara de Sumeru? Hosseini está aqui para nos ajudar a lidar com essa Lama Preta, um grande estudioso de Sumeru, respeite os outros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040204,
					"content": "O que você sabe? Este título também é uma forma de expressar familiaridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040205,
					"content": "Está bem, o balão de ar quente com certeza pode ser usado, e o dispositivo para limpar a Lama Preta também está pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}, se você precisar da minha ajuda, a Estrela da Mineração... *Cof, cof*... *Cof, cof*... Esqueça, acho que não serei de muita ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "Tu"
				},
				{
					"id": 715040207,
					"content": "Que bom que você sabe, é melhor você ir descansar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 715040208,
					"content": "*Suspiro* De qualquer forma, se você planeja iniciar o transporte, basta ativar o balão de ar quente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tu"
				}
			]
		},
