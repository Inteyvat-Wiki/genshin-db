			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"O Príncipe\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "#Miau! (Incrível! Parabéns por passar no julgamento e avançar seu nível de jogador! Agora você se tornou {M#um jogador}{F#uma jogadora} mestre!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680202,
					"content": "Miau. (Chegar ao nível de Mestre significa que a sua habilidade ultrapassou a de muitos especialistas. Não é possível chegar a esse nível sem ter muita dedicação.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680203,
					"content": "(Claro, quem não está disposto a se esforçar nunca entenderá porque passamos incontáveis horas jogando um jogo que para eles é só diversão...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680205,
					"content": "\"Se os jogadores que você convidar souberem que você é mestre, vão jogar com muito mais empenho contra você.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680206,
					"content": "(Talvez alguns jogadores só aceitarão seus desafios depois de saberem que seu nível é mestre... Aqui mesmo na taverna tem gente assim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680207,
					"content": "#Miau... (Então, {NICKNAME}...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "\"O Príncipe\""
				},
				{
					"id": 706680208,
					"content": "(Divirta-se com o Chamado Sagrado dos Sete!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"O Príncipe\""
				}
			]
		},
