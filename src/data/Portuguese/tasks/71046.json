			"dialogs": [
				{
					"id": 710460101,
					"content": "Alto! O Despenhadeiro é um local muito importante. Ninguém não autorizado pode entrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soldado Millelith"
				}
			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "#Alto! O Despenhadeiro está fechado. Se você é {M#um forasteiro}{F#uma forasteira}, então... Oh, é você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Oh não, corra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Paimon, se acalme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Hahaha! Desculpe te assustar. É claro que eu lembro de você. Como eu poderia ter esquecido da pessoa que salvou a minha vida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Só fui transferido para cá recentemente... Não imaginava que te encontraria aqui. Parece que sou sortudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "Salvar você? A gente fez isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Ah, qual é! Eu estava na Câmara de Jade quando lutamos contra aquele monstro marinho juntos. Fiquei levemente ferido e só voltei ao meu posto recentemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Você pode não se lembrar de mim, mas eu jamais esquecerei de você. Todos os meus camaradas que lutaram naquele dia presenciaram o que você fez por Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Você poderia me contar mais sobre o Despenhadeiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Dois anos atrás, um incidente desconhecido aconteceu nas profundezas das cavernas, e os Qixing deram ordens de fechar o local. A maioria dos mineradores foram evacuados em segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "Só é uma pena que uma mina tão grande dessas tenha parado sua produção. Os trabalhadores pegaram seus pagamentos e deram no pé... Uma vez que tanta gente assim tenha se dispersado, temo que seja bem difícil conseguir juntá-las novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "...Hã, desculpe ter saído do assunto. Imagino que você esteja aqui por algo importante, então não irei te incomodar mais. Se você tiver alguma pergunta, pergunte diretamente ao Muning. Ele deve estar no acampamento na entrada da mina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "E, bem, não é que eu não confie em você nem nada, mas é meu trabalho te lembrar para não fazer nada que viole as leis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Não se preocupe, você pode confiar na gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "Você me reconhece?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "#Fomos descobert{M#o}{F#a}s! Hora de correr!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}