			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Ei, quem colocou esta mesa aqui? Eles até a preparam para o jantar, há uma jarra de vinho e tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Ooh, eles até têm os nomes dos convidados esculpidos nos assentos! \"Aqui se senta a Retentora...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "\"Aqui se senta Guizhong...\" \"Aqui se senta Rex...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "Talvez \"Rex\" seja a abreviação de \"Rex Lapis\"? Mas Paimon não tem ideia sobre \"Guizhong\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "Quanto à \"Retentora\", Hmm... É isso! Quando o Escultor da Lua estava vasculhando os nomes de seus amigos Adepti, ele disse que havia uma chamada \"Retentora de Nuvem\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "Portanto, aqui deve ser onde a Retentora de Nuvem e os outros Adepti têm suas festinhas do jantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "*Risadinha* Que tal cozinharmos alguns pratos extraespeciais para os Adepti? Com certeza vamos conseguir a atenção da Retentora de Nuvem dessa maneira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Mas... O que é que os Adepti comem, afinal? Paimon não faz ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Hmm, as pessoas devem fazer ofertas aqui o tempo todo. Acho que tudo que podemos fazer é procurar na área por qualquer sobra, talvez isso nos dê algumas ideias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "Você acha que talvez seja possível que os Adepti gostem de experimentar algumas... Carnes Fritas com Cenoura e Mel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
