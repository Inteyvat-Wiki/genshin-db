			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Uau... O chão está coberto de farinha. Tsc, tsc. Que chef descuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "O que temos nesta panela... Hmm, é carne. mas Paimon não sabe dizer de qual tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Você acha que seja lá quem cozinhou isso, fez uma oferenda ao Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Hmm... Paimon não consegue imaginar exatamente uma oferenda feita de farinha e carne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Ué? Nosso chef descuidado parece ter deixado um pedaço de papel no chão... Eca, tem uma enorme pegada nele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "Mas pegada à parte, talvez tenha algo a ver com este prato misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
