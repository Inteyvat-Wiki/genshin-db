				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "Aqui está bem limpo. Quem cozinhou aqui por último obviamente gosta de manter as coisas limpas e organizadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090402,
					"content": "Paimon acredita que estavam fazendo uma oferenda aos Adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090403,
					"content": "Parece que temos um pouco de Matsutake e Carne Crua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090404,
					"content": "E olha só, a receita está bem aqui. Esse chef era uma pessoa super organizada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
