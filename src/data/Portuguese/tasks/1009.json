			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Alguém definitivamente já cozinhou aqui antes. Você acha que eles estavam fazendo uma oferenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Parece que eles não usaram todos os ingredientes. Vejamos aqui... Temos algumas Flores-de-Crânio-de-Dragão, Cabeças de Lótus, alguns Tofus... O que quer que seja que eles estavam cozinhando, parece complicado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Ei, olha ali... Eles também deixaram algumas anotações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "Sim, é uma loucura! Paimon não se surpreende que eles tiveram que escrever tudo, é muito para se lembrar... Deveríamos ler com atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
