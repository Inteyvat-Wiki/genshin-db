			"dialogs": [
				{
					"id": 762020201,
					"content": "#Sejam bem-vind{F#a}{M#o}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Olá, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Uau, sua casa é tão bonita! Paimon adora o que você fez com ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Hehe, eu sabia que você ia gostar, Paimon. Ouvir isso faz tudo valer a pena, mesmo tendo que fazer isso no meu tempo livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Tudo começou no dia que eu terminei de construir essa casa secreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Eu planejava continuar o ritmo e construir mais algumas, mas não tinha ninguém para me inspirar. Então, após um tempo, meu entusiasmo só meio que... desapareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "\"Não tem como eu me divertir, aproveitar e me sentir como se tivesse conquistado algo tudo ao mesmo tempo?\" Então a resposta apareceu na minha cabeça de repente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Espera, pulamos direto pra parte da resposta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Vamos lá, Paimon, o tempo não para. Olha, tá bem na frente dos seus olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Depois dessa porta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "#Bem, não só essa porta, mas você não tá errada. Tudo tem que começar em algum lugar, que lugar melhor do que aqui? Pront{M#os}{F#as}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "E-Espera um minuto, você tá indo rápido demais! Paimon não consegue acompanhar... A gente devia tá se preparando pra quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Ah, não se preocupe com isso. Você não precisa se preparar para nada, é só uma expressão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Baseado em minhas observações e compreensão... Você não é fã de instruções e explicações complexas. Você prefere encontrar a diversão no calor da aventura, estou certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Bem, errada não tá...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Haha, fico contente em ouvir isso! Nesse caso, se preparem, não planejo me segurar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}, você sabe como nós, anjos, somos. Aquela sensação de satisfação ao guiar alguém para encontrar um tesouro sempre foi algo do qual não conseguimos nos desprender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "#Bem, considerando que o objetivo é ser gentil e ajudar outros a encontrarem a felicidade, por que eu não deveria começar dando algumas dicas {M#aos meus próprios amigos}{F#às minhas próprias amigas}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Então, tive uma ideia de gênio! Transformei minha casa num lugar onde você pode relaxar e se divertir. Eu até escondi tesouros em cada cômodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Para dizer a verdade, até comparada a outros anjos, sou uma especialista quando o assunto é esconder coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Se eu fosse enterrar um baú na natureza e não te mostrasse o caminho, receio que você não conseguiria encontrar nem mesmo após meses de procura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "*Cof cof*... Enfiiiim... Me desviei um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "Não quero dificultar as coisas deliberadamente, nem preciso que vocês saiam correndo pela natureza só para me entreterem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Tudo que vocês precisam fazer é encontrar três plumas, bem aqui nesse cômodo! E quando vocês fizerem isso, me avisem para eu poder ver vocês abrindo sua recompensa, um belo baú do tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Aah, então vamos numa caçada ao tesouro! Paimon mal pode esperar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Exatamente! Uma caça ao tesouro. Vai ser tão divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Mas eu ainda gostaria de uma explicação dessa vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "É uma honra tá aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
