			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "Uma rajada de vento chegou.\\nQue estranho... tinha gosto de Enroladinho Duplo de Fruta, Torta de Veraneio, Assado Crocante e Doce de Ervas Frutado...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Ugh! Uma lufada de vento super doce foi direto na garganta de Paimon! *Cof*... Ei! Onde a gente tá? Aquele bule e as xícaras parecem bem grandões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Espera um segundo... A gente encolheu?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "Isso parece coisa da magia de Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Perdão, eu esperava convidar animais atores mas, infelizmente... Tô mais acostumada a lidar com atores com a \"cara de pedra\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Hã? Nicole, você encolheu também? Paimon achava que você ia ser grandona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Nicole, a Maga Magnificamente Massiva, tocando no céu ao se agachar para conversar? Não, valeu! Tô muito feliz com meu tamanho atual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Eeenfim... Boas-vindas à Festa do Chá da Grande Bruxa! Agora, ponham um pouco de chá para vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620204,
