			"dialogs": [
				{
					"id": 762020601,
					"content": "Eita! Por que deslizou pra baixo assim do nada? E aquilo é uma... Estátua de Mandrágora gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
