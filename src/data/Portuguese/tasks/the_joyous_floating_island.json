					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "Clunk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Examinar a porta"
				},
				{
					"id": 762020603,
					"content": "Espera um momento. Desculpe, só um probleminha técnico. Deixa eu dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "Click... Clack...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Examinar a porta"
				},
				{
					"id": 762020605,
					"content": "Tá se mexendo! Ei! Essa coisa tá atacando a gente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Aha, muito melhor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "O que você quer dizer com muito melhor?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
					"content": "#Hã? Esse tipo de ataque não é nem dor nem coceira, né? Agora é a hora de {NICKNAME} mostrar serviço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
