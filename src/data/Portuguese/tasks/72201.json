			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Ei... Senhores e senhoras... Preciso da sua ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "O que está acontecendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Muito obrigado pela sua disposição para ouvir as histórias tristes de um velhote... Venha cá e eu te conto tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Na minha vida inteira, nunca tive um dia com sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "No dia do meu nascimento, o sacerdote derrubou acidentalmente a lamparina a óleo e acabou queimando todo o cabelo da minha tia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Oh, não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "E depois, eu peguei uma doença estranha, e meus movimentos nunca mais foram equilibrados. Outro dia eu caí do berço, quebrando seis costelas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Quando eu cresci, o meu tio se engasgou com um cogumelo e ao tentar salvar meu tio, meu pai acabou batendo com a pá na minha cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "E uma outra vez, o meu pássaro amado foi comido por um pelicano, que também depois foi derrubado por um javali cego e acabou caindo da montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "E a garota que eu gostava acidentalmente sacrificou o sacerdote à Pássaro do Trovão e acabou sendo expulsa da ilha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "E quando eu cresci, a minha avó morreu de angústia por não ter uma boa aparência, e meu avô também pouco depois se foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "E depois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "De qualquer maneira, a família era um lar que te dava suporte, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Já que estamos falando da família... No dia em que eu cheguei à maioridade, o médico me disse que não poderia ter filhos, pois eu tinha um... Espere... vou lhes mostrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "Não!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "*Suspiro* Peço que vocês me ouçam mais um pouco... E espero que vocês possam me dar o último favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Por favor, vá direto ao ponto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Há um tempo atrás, enquanto eu estava enterrando a minha mulher, meu anel de ouro caiu na tumba e acabou sendo enterrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Era a minha última propriedade... Mas eu não me atrevo a desenterrá-lo, pois isso incomodará o espírito dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Então você quer que eu faça isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "#Como você é {M#um forasteiro}{F#uma forasteira}, tudo o que você faz é estranho, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "#Ah, não, não! Quero dizer, como você é {M#um forasteiro}{F#uma forasteira}, não vai incomodar os espíritos locais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Você pode ir ao Santuário Chirai, onde se encontra a sua tumba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "Chega de falar de assuntos estranhos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Já chega! Pare de falar sobre esse assunto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Precisa de alguma ajuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
