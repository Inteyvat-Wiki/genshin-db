			"dialogs": [
				{
					"id": 726680101,
					"content": "Isso é ótimo. De certa forma, todos que perseguiram o \"Leviatã Lunar\" tiveram seus desejos realizados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Tudo pronto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Veja, Jiawei não arrumou uma esposa rica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Nantuk também se tornou um autor de renome por causa do livro sobre o \"Leviatã Lunar\", embora seu conteúdo esteja errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Kujirai Momiji se tornou a pescadora mais conhecida de Inazuma e fez o que seu pai não foi capaz de fazer, ela pescou o \"Leviatã Lunar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#Então Paimon acredita que o desejo de {NICKNAME} se tornará realidade também! Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "O que Paimon desejava agora há pouco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Não posso dizer! Não posso dizer! Se Paimon disser em voz alta, não se tornará realidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "O \"Leviatã Lunar\" não será tão mesquinho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Hmmm. Ok, ouça com atenção! Paimon só vai dizer uma vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "O desejo de Paimon é que o seu desejo se torne realidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Eu não ouvi, o que você disse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Hmph, Paimon não vai repetir! Paimon quer comer alguns doces ~ Lalala",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
