				{
					"id": 750530301,
					"content": "Sem mais prêmios sobrando. Sem mais prêmios, sem mais desafios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530302,
					"content": "Mais alguma pergunta?",
