			"dialogs": [
				{
					"id": 4260101,
					"content": "Descanse um pouco. Qual é o seu plano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260102,
					"content": "Estava pensando em fazer uma missão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "Isso é fácil! Apenas clique na marca de exclamação no canto superior esquerdo da tela e você poderá ver as missões que você aceitou até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260104,
					"content": "Algumas missões são muito difíceis e algumas delas você não poderá fazer até que atinja o nível requerido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260117,
					"content": "Mais alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260105,
					"content": "Talvez você devesse dar mais uma olhada ao redor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "Algumas áreas são muito mais poderosas que outras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260107,
					"content": "Você deve treinar em algumas áreas mais fáceis primeiro para que não façam picadinho de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260108,
					"content": "Alfry da Guilda de Aventureiros conhece Teyvat na palma de sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260109,
					"content": "Ela vive no centro de Mondstadt, não muito longe do portão. Você devia perguntá-la quais áreas são mais adequadas para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260110,
					"content": "Eu acho que preciso ficar mais forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "Bem, você não conseguirá ficar mais forte sem armas ou artefatos raros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260112,
					"content": "Eu ouvi falar muito das masmorras, mas elas são locais perigosos. Você provavelmente pode se machucar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260113,
					"content": "Mas... se você não tiver coragem para conquistá-los, você pode comprar aqui em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260114,
					"content": "As Armas e os Artefatos podem ser fortalecidas ou avançadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260115,
					"content": "#Mas você terá que descobrir o resto sozinh{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260116,
					"content": "Ah sim, suponho que o seu próprio nível também seja importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260118,
					"content": "Eu não tenho certeza ainda... Eu acho que tenho de pensar um pouco mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "Está certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
