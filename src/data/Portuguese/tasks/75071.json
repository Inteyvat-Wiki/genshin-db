			"dialogs": [
				{
					"id": 750711321,
					"content": "Você derrotou o inimigo e destruiu a gaiola que aprisionava o pobre pequeno Animal de Carga. Ele sai correndo da gaiola e grita para você.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Uau... ufa! Bem, acabou. Que emocionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Shh—! Olhe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "*Click*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Uau, eles estão se dando tão bem... E cá estava Paimon pensando que os Animais de Carga poderiam ser comidos ou algo do tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Hehe, calma, calma. Os Tepetlissauros podem parecer vorazes, mas eles são, na verdade, bem gentis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "Bem, a foto foi tirada e aqui está sua cópia. Ah, sim, e seu pagamento... hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "*Suspira* Cá estava eu pensando que iríamos capturar um momento íntimo entre um filhote de Tepetlissauro e um adulto — mas parece que o Animal de Carga estava um passo à frente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Hehe, qual é, Animais de Carga não são tão irritantes assim. Paimon tem certeza que você também pensa assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Bem, não importa o que eu acho — é a opinião do comitê de juízes de fotografia que importa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Mesmo assim... Pode ser muito perigoso para nosso pequeno Animal de Carga sair vagando por Natlan em ambientes desconhecidos. E eu por acaso preciso de um parceiro para me ajudar a carregar algumas coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Oras, acho que terei que ficar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711313,
					"content": "Mas, e quanto ao dono original dele...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Hnf. É culpa dele por deixar essa criaturinha por aí em um lugar tão perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711317,
					"content": "Mas enfim, chega disso! Galeria de fotos de Fontaine, aqui vou eu! Vá visitar quando chegar a hora, ouviu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711318,
					"content": "#Minhas desculpas, mas por ora, preciso deixar essa nação. Adeus, {NICKNAME}, Paimon! Adeus, meu pequeno camarada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711319
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711319,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
