			"dialogs": [
				{
					"id": 750711001,
					"content": "#Haha, {M#meu querido muso}{F#minha querida musa} {NICKNAME} e Paimon, minha... err, pequena musa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711002,
					"content": "#Ah, sim, e {REALNAME[ID(2)|SHOWHOST(true)]}, é claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711003,
					"content": "Hah! Quem é a pequena musa aqui mesmo, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711004,
					"content": "Raaawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Haha, qual é, não se importe com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711006,
					"content": "Hnf. Paimon se importa bastante, bastante mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711007,
					"content": "Teve uma inspiração nova?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "É claro! Porém... Hehe, nova inspiração significa... que precisarei mais uma vez da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711009,
					"content": "Sem problemas! Você sempre paga mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711010,
					"content": "Haha, maravilhoso, minha pequena mercenária!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711017,
					"content": "Sabe, estou tirando uma foto de um Tepetlissauro dessa vez... Shh. Cuidado, não queremos incomodá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711018,
					"content": "Essa é a minha primeira vez interagindo com um Sauriano desses, mas tenho os observados por um bom tempo já... Realmente criaturas bem fascinantes, cada um com personalidades únicas por debaixo de suas couraças duras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711019,
					"content": "Hehe, e esse daqui aprendeu alguns comandos básicos após ser alimentado algumas vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711020,
					"content": "#Mesmo assim, precisarei da sua ajuda, querid{M#o}{F#a}s domador{M#e}{F#a}s de Saurianos, para trazer o Sauriano rebelde conosco e tirar uma foto dele interagindo com seus companheiros Tepetlissauros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711021,
					"content": "Hehe, bem simples, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711022,
					"content": "Sim, bem simples!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711023,
					"content": "(Não é como se fosse você quem se ocupa mesmo, mas enfim...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Haha, sim, esse é o espírito! Então, venha, traga-me o Tepetlissauro e poderemos começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711024,
					"content": "(Não tão simples quanto você pensa...!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "#Então, você precisa da ajuda de {M#seus musos}{F#suas musas} mais uma vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "Mousse... Heh, Paimon já está se sentindo com fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711013,
					"content": "Groo... Groo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Uh, oh, você quis dizer \"muso\", não foi? Isso não é de comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711015,
					"content": "Bem, desde que você esteja pagando, essa Mora logo vai se tornar comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711016,
					"content": "O que você quiser, Paimon... Mas eu realmente tenho dinheiro, então você não terá que se preocupar com trabalhar de graça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				}
			]
		},
