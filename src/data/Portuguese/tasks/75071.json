			"dialogs": [
				{
					"id": 750711101,
					"content": "Você percebeu? Nosso pequeno amiguinho parece ter notado algo... Talvez, família?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711102,
					"content": "Está andando por conta própria! Vamos lá, vamos seguir — não podemos perdê-lo de vista!",
