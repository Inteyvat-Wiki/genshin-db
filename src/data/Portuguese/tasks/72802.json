			"dialogs": [
				{
					"id": 728020601,
					"content": "Para onde será que nossa filha foi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020602,
						728020603
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020602,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				},
				{
					"id": 728020604,
					"content": "Mesmo que tenha que trabalhar no outro dia, Atsuko costuma falar algo para nós antes de sair. Mas hoje ela saiu sem dizer nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020605
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020605,
					"content": "Depois que você saiu ontem, Atsuko disse que estava cansada e foi logo dormir em seu quarto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020606
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020606,
					"content": "Quando acordamos no dia seguinte, já não estava mais na sua cama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020607
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020607,
					"content": "Procuramos por ela em todos os cantos. Meu marido foi até lugares muito longes em sua busca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020608
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020608,
					"content": "Mas mesmo depois de meio-dia, não conseguimos encontrar vestígio algum de nossa filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020609
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020609,
					"content": "*Suspiro* Será que aquela criança partiu para outra jornada de novo? Que problemática...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020610
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020610,
					"content": "Se acalme, querida. Eu procurarei por ela de novo. Primeiro dê uma varrida no quarto de Atsuko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020611
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020611,
					"content": "Depois que ela saiu, ela não fechou a janela corretamente. Muitas folhas acabaram soprando para dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020612
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020612,
					"content": "Oh, sim, antes que eu esqueça, Viajante, aqui está seu pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020613
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020613,
					"content": "*Suspiro* Essa Atsuko... Para onde será que ela saiu correndo agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020603,
					"content": "Atsuko saiu para trabalhar de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020604
					]
				}
			]
