					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Não vamos pensar demais sobre isso, deve ser só um mal-entendido. Será melhor se você me ajudar a pensar o que fazer para almoço amanhã.",
					"roleType": "TALK_ROLE_NPC",
