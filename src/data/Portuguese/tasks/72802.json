			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Atsuko deve ter voltado, vamos bater na porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Eles parecem estar falando sobre algo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Dito isso, imagino sobre o que pode ter acontecido com o Tanuki que resgatamos anteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Você é muito gentil. Aquele Tanuki só tinha alguns arranhões na perna. Se tivesse deixado nos arbustos, teria se recuperado sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Eu não podia ficar ali parada. Estava olhando para mim com lágrimas nos olhos, tive pena. Minha consciência não conseguiu evitar em ajudá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Bem, deixe para lá. Nunca é algo errado fazer coisas boas. É só que ele comia demais, tanto quanto eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "Bater na porta",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Quem é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "#Eu sou {F#a}{M#o} Viajante que veio aqui anteriormente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "Oh, eu me lembro de você, Viajante, espere um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "Olá! Eu sou Atsuko, é a primeira... Não... É um prazer lhe ver de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Me desculpe, eu estava com saudades de minha casa. Depois que lhe dei a carta, mudei de ideia e simplesmente peguei um navio de volta para Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Hahaha... Me desculpe por não ter esclarecido as coisas antes e ter feito você viajar de tão longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Como que você voltou para Inazuma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "... Ah, bem, eu tenho meus próprios meios, não precisa se preocupar com isso, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Uh, tenho seu pagamento pronto aqui comigo. Aqui está ele. Obrigada pela sua ajuda. Vá... Hã, vá logo e aproveite o resto do seu dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Como que as coisas que Atsuko está nos dizendo agora são diferentes do que ela nos disse antes? Se retornar para Inazuma era tão fácil, por que será que nos pediu para ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "E o que aconteceu com seus negócios em Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "Meus negócios? Que negócios? Eu tinha negócios em Liyue?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "... Ah, isso não tem relevância. Nada é mais importante que família. Eu confiei isso tudo para outras pessoas, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "Espere um pouco, a Atsuko de verdade tinha dificuldade de encontrar trabalho em Liyue, não há como ela se tornar tão rica abruptamente assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Afinal de contas, quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "Eu... Eu sou Atsuko, é claro! Eu pareço Atsuko, e soo como Atsuko, o que é que há de suspeito nisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "Olhe, deixe de ser tão persistente! Deixe para lá... Eu não falarei mais com você, tenho trabalho para fazer amanhã, tenho que ir indo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "Ei, Atsuko! Essa criança... Por que será que ficou irritada do nada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "Me desculpe, Viajante. Ela só deve estar muito cansada por causa do trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Mas como você mesmo viu, ela é nossa filha, e quanto a essa carta... Ela só deve ter se esquecido a seu respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Mas de qualquer maneira, nós ainda queremos nos desculpar pelos problemas que causamos. Você poderia esperar mais um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Tem algo de errado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Não, nada disso. Nós ainda podemos fazer o pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "Sabe como falamos para você que Atsuko vai para o trabalho durante o dia? O pagamento que ela recebe sempre foi estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Ela sempre traz de volta algumas sementes estranhas ou frutas selvagens, mas nunca nenhuma Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Apesar de coisas como essas terem algum valor, nós temos que vender elas primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "#Mas para {F#uma}{M#um} Viajante como você, creio que Mora seja mais conveniente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Por favor, venha aqui amanhã novamente. Devemos ser capazes de lhe dar Mora até lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Se houver algum problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "E quanto a sua mansão em Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Mansão? Que mansão? Eu tinha até mesmo uma mansão em Liyue?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
