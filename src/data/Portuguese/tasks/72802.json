			"trigger": {
				"objectNames": [
					"Michiru",
					"Yoh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Quantos pratos nós deveríamos fazer para o almoço de amanhã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "Nossa filha está comendo cada vez mais. Vamos só cozinhar mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Hã? E quem é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Com licença, esta é a casa de Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Sim, somos nós. O que posso fazer por você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Atsuko me pediu para trazer essa carta para vocês.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Carta? Por que será que aquela criança quer do nada escrever uma carta para nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "A carta é bem grande... Bem, ela já está de volta em casa, se ela quiser dizer algo, poderia falar para nós diretamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "...O quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "#... Viajante, você parece surpres{F#a}{M#o}? Enquanto que é verdade que Atsuko esteve viajando fora do país, ela agora voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Por que ela quer enviar uma carta para nós quando na verdade já voltou para casa? Será que você nos confundiu com outras pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Espere um momento, jovem. Olhei a carta brevemente. A caligrafia e o estilo com certeza são de nossa filha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "A carta também diz que ela não pretende voltar tão cedo, e diz para nos cuidarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "#O que isso tudo significa? Será que ela voltou sozinha e pediu para ess{F#a}{M#e} Viajante nos entregar essa carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Acho que há um mal-entendido. Depois que aquela jovem voltar para casa, nós perguntaremos a ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "Viajante, infelizmente Atsuko tinha outros problemas para lidar hoje. Quando ela voltar, pediremos que esclareça a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Se não for um problema para você, venha nos encontrar amanhã à tarde. Pediremos que aquela criança explique tudo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Onde ela está agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "Ela disse que está ocupada com o trabalho. Depois do café da manhã, saiu da casa apressada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Sim, todo dia ela sai cedo e volta tarde. Nós só conseguimos ver ela durante a tarde, por isso não sabemos o que realmente está fazendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Enfim, venha amanhã à tarde. Se ela fez algo de errado, vamos garantir que ela se desculpe para você pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Realmente lamentamos que você teve que viajar um caminho tão longo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Essa Atsuko... Ah, se ela fosse mais bem educada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Por que somente à tarde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "Ela disse que estava ocupada trabalhando, e fica fora de casa o dia inteiro depois do café da manhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko... Voltou para casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Com licença, vocês são os pais de Atsuko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
