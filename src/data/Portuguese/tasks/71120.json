			"dialogs": [
				{
					"id": 711209101,
					"content": "Vocês de novo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711209102,
					"content": "#Parem de ficar metendo o nariz onde não foram chamad{F#as}{M#os}. Só finjam que não viram a gente, e a gente vai fingir que não vimos vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711209103,
					"content": "O que vocês tão protegendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Advinha o que estamos sendo pagos para fazer, colega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711209105,
					"content": "Quê!? Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "*Cof, cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711209107,
					"content": "#(Só vou contar para vocês {M#dois}{F#duas}, não é pra contar para ninguém... Venham cá, preciso falar baixo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711209108,
					"content": "(Claro, Paimon quer saber!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "É para se livrar de pessoas como vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711209110,
					"content": "Aaaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Acabei de ouvir um barulho estranho vindo de dentro da caverna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Eu peidei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711209113,
					"content": "Ah... é. Ele peidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711209114,
					"content": "E-Então tá tudo nos conformes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
