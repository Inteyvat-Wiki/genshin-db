			"dialogs": [
				{
					"id": 711200101,
					"content": "Ei, sai pra lá! Isso aqui é território do chefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200102,
					"content": "Nossa, quanta raiva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Quem são vocês?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Depende de como vocês tratarem a gente. Se vocês forem gente boa, poderemos ser amigos. Mas se vocês forem ficar xeretando, teremos que tomar alguma atitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711200105,
					"content": "Você devia aprender a olhar melhor, e voltar pelo caminho que veio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200109,
					"content": "Vocês são muito suspeitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Suspeitos? Calma lá... Nós somos apenas os vigias desse lugar. Se alguém tá agindo de forma suspeita são vocês, com toda essa curiosidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Serpente Enrolada"
				},
				{
					"id": 711200111,
					"content": "Mas tanto faz, não temos nada a dizer para vocês! Só nos deixem em paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200106,
					"content": "Quem é esse chefe que você tá falando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Quem é o chefe? Há! Se eu dissesse, você ia se ajoelhar de medo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Tigre Sentado"
				},
				{
					"id": 711200108,
					"content": "É para o seu próprio bem, colega! Para de meter o nariz onde ninguém te chamou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Serpente Enrolada"
				}
			]
		},
		{
