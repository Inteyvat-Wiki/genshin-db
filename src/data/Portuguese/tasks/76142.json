			"dialogs": [
				{
					"id": 761420401,
					"content": "Não tenha medo. Patoli e eu vamos tirar você daqui. Fique firme — segure essa lâmina como um verdadeiro Portador da Lâmpada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420402,
					"content": "Eu... eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filyaev"
				},
				{
					"id": 761420403,
					"content": "Que plano? Que plano poderia existir, Patoli? Se este for o fim, então lutarei até o último instante, aqui mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420404,
					"content": "Vocês são o melhor esquadrão que já tive. Aconteça o que acontecer... foi uma honra lutar ao lado de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420405,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "Filyaev"
				},
				{
					"id": 761420406,
					"content": "A honra é toda nossa, Capitão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "Filyaev"
				},
				{
					"id": 761420407,
					"content": "Vamos lá, preparem-se para defender! Que essas malditas criaturas testemunhem a fúria do Corcel do Gelo Invernal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
