			"dialogs": [
				{
					"id": 761420301,
					"content": "Ei, Chinnov, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Ainda empunhando essa lâmina... Capitão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chinnov"
				},
				{
					"id": 761420303,
					"content": "Schonovich, Filyaev... estão bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ugh... tenho quase certeza de que quebrei a perna, mas ei, ainda estou respirando. Está contando? Quantos eu derrubei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Schonovich"
				},
				{
					"id": 761420305,
					"content": "Q–Quantos monstros existem? Nós... nós vamos morrer aqui fora, Capitão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filyaev"
				},
				{
					"id": 761420306,
					"content": "Que bobagem é essa, garoto? Vamos sair daqui em segurança, com certeza! Não se preocupe, o batedor já deve ter voltado para a cidade para avisar o velho, nossos reforços estão a caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "...Lá vêm eles de novo, essa Caçada Feroz não nos dá um respiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "Certo! Armas em punho, lanternas firmes. Mais uma horda se aproximando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
