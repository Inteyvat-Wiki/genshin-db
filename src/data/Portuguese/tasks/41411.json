		{
			"id": 4141113,
			"completionStepIds": [
				4141113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141113",
							"2"
						],
						"stepId": 4141113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "O que é isso? Abra para ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111303,
					"content": "Eu... Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111304,
					"content": "Que caixa de presente tão refinada, num lugar desses, que interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111305,
					"content": "... Que?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 414111306,
					"content": "Uau! Que linda grinalda de Margaridas Voadoras e estrelinhas de papel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111307,
					"content": "Isso é uma brincadeirinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "Parece que o suposto \"criminoso\" é um fã da Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111310,
					"content": "Tem também uma nota. O que tem escrito? Vamos ver... Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111311,
					"content": "\"Peço desculpa por usar essa forma para chamar sua atenção. Aceite essa Flor do Vento como um símbolo de minha sincera admiração por sua virtude e beleza.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111312,
					"content": "Ah? Então, é uma intimidação falsa, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111313,
					"content": "Independentemente de ser oferecida a deuses ou a alguém especial, as flores devem ser oferecidas da forma mais sincera possível. Essa é a cerimônia mais importante do Festival da Brisa Florescente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111314,
					"content": "Flores de amor e bênçãos, oferecidas em uma ocasião especial como essa... A pessoa deve se esforçar para que seja algo maravilhoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111315,
					"content": "Parecia ameaçador, mas no final das contas era apenas um presente preparado com muita dedicação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111316,
					"content": "Ah? Isso é ridículo! Para Paimon parece que é coisa feita por alguém meio doido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111317,
					"content": "Hahaha, realmente... Só consigo me lembrar de uma pessoa que faria algo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111318,
					"content": "De quem você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111319,
					"content": "(Acho que também sei a resposta.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "Shh! Não fale nada, deixe a Paimon adivinhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111321,
					"content": "Ah! Você é tão irritante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111308,
					"content": "É uma forma de chamar sua atenção?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
			"completionStepIds": [
				4141114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4141114",
							"2"
						],
						"stepId": 4141114,
						"stateName": "QUEST_STATE_UNFINISHED"
