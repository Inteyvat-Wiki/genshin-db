					"nextDialogs": [
						414110712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110712,
					"content": "Lisa, os \"funcionários simples\" não dominam o Electro como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110713,
					"content": "Mas não se preocupem, eu irei supervisionar Lisa. Especialmente por ela gostar de atacar as pessoas com choques elétricos para separar brigas ou eletrocutar bêbados até eles implorarem perdão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110714,
					"content": "Mas se a Jean não gosta, eu não faço mais isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110715
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 414110715,
					"content": "Ah, é? Então melhor assim! Caso contrário irei ponderar se realmente preciso de uma bibliotecária para me acompanhar na patrulha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 414110716,
					"content": "Paimon não sabia que a patrulha era assim tão emocionante! Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
