				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "*Suspiro* O que vou fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111402,
					"content": "Você é Nimrod? Kaeya disse que você precisa de ajuda, mas ele agora está muito ocupado e pediu para nós lhe ajudássemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111403,
					"content": "Ah? Oh, Viajante. Não sabia que era você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111404,
					"content": "Bom. Eu estou pensando em dar um presente do Festival da Brisa Florescente para minha esposa e queria pedir uma sugestão para Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111405,
					"content": "*Suspiro* Eu sou um pouco bêbado, estou quase sempre na Taverna. Minha esposa detesta isso e nós estamos sempre brigando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111406,
					"content": "Ah, você também é um bêbado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111407,
					"content": "Eu sei que o vinho é algo bom! Mas você parece beber demais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111408,
					"content": "Eu sei disso, por isso eu sinto que devo compensar ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111409,
					"content": "Viajante, poderia me ajudar a coletar alguns materiais? Quero fazer um presente para a minha esposa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111410,
					"content": "Deveria fazer a preparação pessoalmente, mas bebi demais nesses dias e acabei dormindo. Quando acordei, as celebrações já tinham começado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111411,
					"content": "Esse moço é um desastre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111412,
					"content": "Os solteiros em Mondstadt nunca pediram ajuda a alguém durante o Festival, ainda bem que você é casado, Nimrod!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111413,
					"content": "É mesmo... Peço desculpa, estou sendo ridículo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111414,
					"content": "Não tem outro jeito. Pode falar. Do que você precisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111415,
					"content": "Vou procurar madeira na cidade e vou precisar de plantas para colocar lá dentro. Essas flores só crescem no campo, então podem coletar 2 Lâmpadas de Grama para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111416,
					"content": "Lâmpadas de Grama e madeira... O que você vai fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111417,
					"content": "Quero construir uma casinha de madeira, com flores brilhantes e mobílias feitas manualmente, para ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111418,
					"content": "Que presente bonito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414111419,
					"content": "É apenas um presentinho! Quando conheci ela, eu costumava fazer presentinhos manualmente para ela. Ela gostava muito, e dizia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111420,
					"content": "Ah! *Cof* Me desculpem. Não quero falar do passado. Obrigado pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414111421,
					"content": "#Você teve muita sorte em encontrar assistentes tão {M#bondosos}{F#bondosas}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111422,
					"content": "Vamos! Vamos procurar o que ele pediu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
