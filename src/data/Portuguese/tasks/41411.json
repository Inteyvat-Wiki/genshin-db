			"dialogs": [
				{
					"id": 414111501,
					"content": "Venti já deve ter chegado, vamos entrar e dar uma olhada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111502,
					"content": "#Esperem! {M#Cidadãos}{F#Cidadãs}, qual o assunto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111503
					],
					"speakerTitle": "Arto"
				},
				{
					"id": 414111503,
					"content": "O Kaeya está aqui? Nós estamos procurando ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111504,
					"content": "O Capitão Kaeya está trabalhando no escritório da Mestre Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111505
					],
					"speakerTitle": "Arto"
				},
				{
					"id": 414111505,
					"content": "Ei, por que ele está no escritório da Mestre Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414111506,
					"content": "O Festival da Brisa Florescente sempre foi organizado pelos Cavaleiros de Favonius e, durante o festival, a Mestre Jean sai pessoalmente para cuidar dos assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111507
					],
					"speakerTitle": "Arto"
				},
				{
					"id": 414111507,
					"content": "O Capitão Kaeya substitui ela para cuidar dos assuntos administrativos durante esse período.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111508
					],
					"speakerTitle": "Arto"
				},
				{
					"id": 414111508,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
