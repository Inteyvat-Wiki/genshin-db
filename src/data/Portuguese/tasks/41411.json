					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110301,
					"content": "Obrigado, obrigado! Com isso, posso começar meu trabalho já.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110302,
					"content": "Não se esqueça que mais importante que um presente é tratar bem sua esposa sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110303,
					"content": "Certamente, sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110304,
					"content": "*Suspiro* Mas espero que ela goste desse presente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 414110305,
					"content": "Todos gostam de um presente feito com o coração, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110306,
					"content": "Faça bem, não desperdice esses materiais que foram tão difíceis de achar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
