			"dialogs": [
				{
					"id": 414110501,
					"content": "Voltamos! Kaeya, você terminou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110502,
					"content": "Hora de entregar seu poema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110503,
					"content": "Bem-vindos de volta, estou terminando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110504,
					"content": "Vai, termina logo! Está na hora de entregar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110505,
					"content": "Aqui está. Não riam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110506,
					"content": "Hum... Hum? Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110507,
					"content": "Bardo Desafinado, algum comentário?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110508,
					"content": "Kaeya, posso ler seu poema em voz alta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110509,
					"content": "Sim, pode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110510,
					"content": "*Cof, cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110511,
					"content": "\"Mi muhe ye\\nSignifica eu te amo\\nEm Hilichurlês.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110512,
					"content": "Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110513,
					"content": "Terminei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110514,
					"content": "Não tem mais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110515,
					"content": "Coerente e direto. Acho que está bom assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110516,
					"content": "Aaaah?! Por acaso isso é um livro de frases em Hilichurlês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110517,
					"content": "Ridículo! Não tem romance.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "Hahaha. Os poemas devem refletir o estilo do seu escritor, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110520,
					"content": "Parece que você não está levando isso a sério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110521,
					"content": "Kaeya, você sabe Hilichurlês? Que estranho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110522,
					"content": "Haha. Não subestime os conhecimentos do Capitão da Cavalaria dos Cavaleiros de Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110523
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110523,
					"content": "Pronto, está na hora de ir coletar outro poema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110524
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110524,
					"content": "... !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110525
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110525,
					"content": "Vi uma sombra estranha, há pouco, preciso ir investigar. Viajante, tem mais uma coisa que preciso pedir para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110526,
