			},
			"dialogs": [
				{
					"id": 414110101,
					"content": "Oi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110102,
					"content": "Viajante, Paimon, vocês vieram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110103,
					"content": "Estava justamente pensando em vocês, que coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110104,
					"content": "Kaeya, você fez o poema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110105,
					"content": "Temo desapontar você, pois ainda não comecei a escrever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110106,
					"content": "Alunos que não fazem os trabalhos de casa não são bons alunos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110107,
					"content": "Qual o motivo para você não ter escrito o poema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414110108,
					"content": "Hum... Como estão vendo, estou ajudando Jean a tratar desses assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110109,
					"content": "Durante o Festival, Mondstadt fica muito animada e há muitos mais assuntos para tratar, por isso estive muito ocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110110,
					"content": "Viajante, posso pedir um favor para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110111,
					"content": "Um amigo me pediu ajuda, mas estou muito ocupado. Você pode ajudar ele por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110112,
					"content": "Um amigo? Daqueles que você conheceu na Taverna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 414110113,
					"content": "Sim. Depois do trabalho, vou sempre beber um copo na Taverna, e lá fiz muitos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110114,
					"content": "Seu nome é Nimrod. Ele está sempre perto da Taverna. Nesse momento, ele deve estar sem nada para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110115,
					"content": "Preciso ficar aqui escrevendo o poema. Por isso, vou deixar o assunto de Nimrod com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 414110116,
					"content": "Kaeya, boa sorte!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "Tudo bem. É uma forma de me integrar nesse Festival.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
