		},
		{
			"id": 201901,
			"completionStepIds": [
				201901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201901",
							"2"
						],
						"stepId": 201901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Signora",
					"Paimon",
					"Shogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "O jeito que as pessoas entram aqui como bem entendem, nada civilizado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190102,
					"content": "Se eu não soubesse que era Tenshukaku, poderia ter confundido com um mercado de rua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190103,
					"content": "Você aprendeu sua lição agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190104,
					"content": "Oh não, o que ela fez com Kujou Sara...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "O direito de punir os habitantes de Inazuma por seus crimes é só meu. Não seu, Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190106,
					"content": "...Então eu peço desculpas, Toda-Poderosa Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190107,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Eu sei, eu sei, você não consegue me tirar da sua mente. Mas não precisa chamar meu nome o tempo todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190109,
					"content": "#Não pense que estou surpresa em vê-l{M#o}{F#a} aqui. Estou bem ciente de que você me odeia, pelo jeito que me segue como uma sombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190110,
					"content": "Você está distribuindo Ilusões secretamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "Ah, então você veio expor meus crimes na frente da Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190113,
					"content": "Hehehe... Eu sou apenas uma diplomata de Snezhnaya. Não faço ideia do que você está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190114,
					"content": "Ela não nos leva mesmo a sério...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Por todos os que perderam suas Visões...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "Pare de falar sobre pessoas e coisas com as quais não me importo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190118,
					"content": "Para começar, eles não eram ninguém, e seus nomes serão esquecidos. Mas agora, pelo menos, eles serão os blocos de construção na grande revolução para chegar na eternidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190119,
					"content": "Não é essa a maior honra que eles poderiam esperar em suas vidinhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190120,
					"content": "Toda-Poderosa Shogun... me corrija se eu estiver errada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190122,
					"content": "Pela Gnosis de Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "Isso é uma história antiga. Você certamente adora guardar rancor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190125,
					"content": "O sonho da Tsaritsa é a coisa mais nobre e pura do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190126,
					"content": "Esses outros detalhes mundanos que você insiste em mencionar... eles são apenas sacrifícios necessários. Isso é tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190127,
					"content": "É hora de eu dar um fim nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "Você? Dar um fim em mim? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190129,
					"content": "#Sinceramente, também cansei de ver você por aí. Mas não acreditei que você fosse tão audacios{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190130,
					"content": "#Antes de dizer algo que não pode ser retirado, lembre-se de que você é {F#a}{M#o} criminos{F#a}{M#o} mais procurada de Inazuma... Sugiro que considere suas circunstâncias com muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190131,
					"content": "#Entrar em Tenshukaku sem ser convidad{F#a}{M#o} e me dar um sermão na frente da Shogun não foi a jogada mais brilhante. Você não acha que é hora de parar de se intrometer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190132,
					"content": "Não tenho certeza se você percebe a diferença que existe entre nós, tanto em status... quanto em força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190133,
					"content": "Eu desafio você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "...A um duelo perante o trono!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190136,
					"content": "Prossigam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 20190137,
					"content": "#Ai, ai, você está chei{M#o}{F#a} de surpresas hoje... Então você aprendeu a fazer a lei da terra funcionar para você também, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190138,
					"content": "#Admito que nunca esperei estar em uma situação em que nós {F#duas}{M#dois} estivéssemos em pé de igualdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190139,
					"content": "#Você sabe... Que {F#a}{M#o} {F#perdedora}{M#perdedor} deve morrer? Tem certeza que é isso que você quer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Hehehe... Então concederei a honra de compartilhar esta última dança com você... Até que a morte nos separe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora"
				},
				{
					"id": 20190123,
					"content": "E pelo povo de Liyue que você pôs em perigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Por todos os que foram prejudicados por Ilusões...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Você está tentando tomar o controle de Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}