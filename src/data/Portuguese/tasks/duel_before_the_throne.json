			"dialogs": [
				{
					"id": 20185301,
					"content": "Enquanto tivermos a Musou no Hitotachi, o povo de Inazuma não tem nada a temer. Um fato evidente, mas a Sara está cega a ele... Hnf.",
					"roleType": "TALK_ROLE_NPC",
