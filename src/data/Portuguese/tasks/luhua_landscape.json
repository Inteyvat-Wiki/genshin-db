			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "Você encontrou minhas ferramentas de pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Achei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Assim como eu pensava, eu os deixei no lugar onde eu estava usando como referência. Eu tendo a colocar as coisas que usei no chão enquanto pinto, por hábito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Quando estou com muita pressa para sair, acabo deixando muitas coisas para trás. Se não fosse por você, eu teria que ter voltado à cidade para comprar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "Você vai continuar pintando aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Nem mencione isso. Eu tinha ouvido as pessoas dizerem que estas duas estátuas têm olhos que podem se iluminar, e que se pode ver isso de longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Estátuas gigantes com olhos brilhantes, erguidas ao lado de uma montanha... Certamente daria uma excelente pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "Mas quando cheguei aqui, as estátuas até estavam aqui, mas não tinham olhos brilhantes em lugar nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Pensei que talvez eu tivesse perdido algum momento em especial, ou que meu ângulo estivesse errado, e é por isso que tenho andado por aí de um lado a outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Mas parece que não importa onde eu esteja, o cenário não muda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "A única coisa que consegui de tudo isso foi que encontrei isso - encontrei-o no lago lá embaixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "Não tenho ideia do que é, mas quanto mais olho para ele, mais me lembra um olho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Mas se isto é um olho, então pode haver outra rocha semelhante por perto. As pessoas têm dois olhos, afinal de contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "*Suspiro* Foi o que eu imaginei, de qualquer forma. Não pense muito sobre isso. Esta pedra é de pouca utilidade para mim, de qualquer forma, então por que você não fica com ela? Considere isso como um agradecimento por me ajudar a encontrar minhas ferramentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Estátuas com olhos brilhantes... Que segredos se podem desvendar no Lago Luhua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
