			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Você encontrou minhas ferramentas de pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Achei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Assim como eu pensava, eu os deixei no lugar onde eu estava usando como referência. Eu tendo a colocar as coisas que usei no chão enquanto pinto, por hábito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Quando estou com muita pressa para sair, acabo deixando muitas coisas para trás. Se não fosse por você, eu teria que ter voltado à cidade para comprar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Você vai continuar pintando aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Nem mencione isso. Eu tinha ouvido as pessoas dizerem que estas duas estátuas têm olhos que podem se iluminar, e se pode ver isso de longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Estátuas gigantes com olhos brilhantes, erguidas ao lado de uma montanha... Certamente daria uma excelente pintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Mas quando cheguei aqui, as estátuas até estavam aqui, mas não tinham olhos brilhantes em lugar nenhum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Pensei que talvez eu tivesse perdido algum momento em especial, ou que meu ângulo estivesse errado, e é por isso que tenho andado por aí de um lado a outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Mas parece que não importa onde eu esteja, o cenário não muda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "A única coisa que consegui de tudo isso foi que encontrei isso - encontrei-o no lago lá embaixo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Hmm, eu encontrei um também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Você encontrou? Deixe-me dar uma olhada. Nossa, eles são idênticos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Estranho. Há algumas palavras esculpidas na parte de trás. Agora, o que eles dizem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "\"As sentinelas de pedra seguram o portão como tal, contra aqueles que não dão um toque final...\" O que isso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Bem, esta pedra é meio inútil para mim, de qualquer forma. Então por que não fica com você? Considere isso como um agradecimento por me ajudar a encontrar minhas ferramentas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "Na verdade, eu tenho uma ideia. É apenas um palpite, mas você não acha que estas duas pedras se parecem um pouco com olhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Se eles realmente são olhos, você acha que o \"toque final\" tem algo a ver com estas duas pedras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Bem, é apenas um palpite de qualquer forma, então não pense muito sobre isso. Vou procurar outros pontos de vista, agora - obrigado por encontrar minhas ferramentas para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
