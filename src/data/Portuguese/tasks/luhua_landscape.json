			"dialogs": [
				{
					"id": 710060801,
					"content": "Isso não está certo... Não pode estar certo. Os olhos das estátuas não brilham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060802
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060802,
					"content": "A minha técnica de busca de ângulos perfeitos está errada de alguma forma? Não, não pode ser isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060803
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060803,
					"content": "Olhos... Que olhos? Essa estátua não tem nenhum.",
					"roleType": "TALK_ROLE_NPC",
