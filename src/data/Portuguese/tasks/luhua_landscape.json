			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Oh, isso é terrível. Como irei pintar desse jeito...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "Você... Oh, é você, viajante. Bem, eis o problema: tenho procurado inspiração em torno do Lago de Luhua e queria pintar alguns quadros para trazer comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Mas eu não consegui encontrar um bom ângulo, portanto, nenhuma das minhas pinturas me satisfez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Estava tão concentrada em capturar a paisagem, que só percebi que a maioria dos meus pincéis e tintas tinham desaparecido quando cheguei aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Devo tê-los deixado no último lugar que pintei os outros quadros. Você poderia me ajudar a procurá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "Onde você pintou os outros quadros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Err... Na verdade, não me lembro muito bem. Porque eu sempre estava focado em pintar, e não prestei muita atenção ao meu redor, portanto, não me lembro da localização exata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Mas eu só pintei dois quadros nesta área, portanto, só pode ser nesses dois lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Eu lhe darei estes dois quadros. Tenho certeza de que devo ter deixado minhas ferramentas nas áreas que eu estava <color=#00E1FFFF>utilizando como referência</color> para essas pinturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Quando você os tiver encontrado, por favor, traga-os de volta para mim. Vou continuar procurando por aqui... Tenho certeza de que há um angulo melhor para capturar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Mas por onde eu começo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Eu estava tão absorvido em minha pintura, que nem prestei atenção a minha volta, por isso não consigo me lembrar de nenhum detalhe específico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Mas eu só pintei dois quadros nessa área, portanto, só pode ser nesses dois lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7100602,
