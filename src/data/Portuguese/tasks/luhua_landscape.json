						710060703
					]
				},
				{
					"id": 710060703,
					"content": "Sobre a pedra? Por que você está interessado nisso de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "Eu peguei enquanto procurava uma boa vista no <color=#00E1FFFF>Lago de Luhua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "Você gostaria de ir até a <color=#00E1FFFF>Lago de Luhua</color> dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Então você tem que prestar mais atenção. O lago está cheio de todos os tipos de coisas, e não sei quem foi que jogou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
