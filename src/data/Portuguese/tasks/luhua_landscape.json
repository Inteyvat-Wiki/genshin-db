	"talks": [
		{
			"id": 7100601,
			"completionStepIds": [
				7100601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
