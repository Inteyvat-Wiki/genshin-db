				{
					"id": 413380201,
					"content": "Estamos no ponto de partida da primeira rota. Veja, montei bem as Lanternas Celestes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380202,
					"content": "#Quando você estiver pront{F#a}{M#o}, podemos começar. Colete Lanternas Celestes e voe até o ponto de chegada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
