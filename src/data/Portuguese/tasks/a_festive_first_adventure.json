			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "Aqui é o ponto de chegada. Você é muito hábil com o Planador. O que você achou dessa rota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380302,
					"content": "Ela tem a atmosfera do festival...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "Claro, eu planejei tudo dessa forma de propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380305,
					"content": "Vamos seguir para a próxima rota então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 413380303,
					"content": "As Lanternas Celestes são muito bonitas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
