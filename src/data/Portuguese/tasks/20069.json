			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Estas flores também não estão parecendo muito boas. Que pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Bem, muitas pessoas tendem a comprar flores individuais para dar presente, então eu geralmente corto algumas flores especificamente para este propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Mas essas flores que eu corto não permanecem frescas por muito tempo. Se elas não forem vendidas, murcharão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "Eu tentei muitos métodos no passado, mas as flores se degradam ao final do dia de qualquer forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Me pergunto se existe alguma forma de preservar essas flores por mais tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Preservação, você diz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Ouvi a Sara do Caçador de Cervos dizer que quando eles possuem ingredientes que não foram utilizados, colocam eles em um lugar fresco, ou os preservam usando blocos de gelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Eu também tentei estes métodos, mas as flores armazenadas usando blocos de gelo sempre acabam ficando estranhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Elas não terão murchado, mas eu também não as chamaria de frescas... E de qualquer forma, elas não estariam mais apresentáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Perguntei a muitas pessoas, e ao Sr. Sayid... Você sabe quem é ele, certo? Ele é aquele pesquisador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Um dia, quando ele veio comprar flores, ele me disse que uma vez leu sobre colocar flores em câmara fria, em um livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Especificamente... Envolve o uso de um recipiente para armazenar a flor, e depois colocar esse recipiente perto de blocos de gelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Ele também mencionou que, se eu quisesse fazer algumas experiências, o lugar mais adequado seria o ambiente de baixa temperatura na Espinha do Dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Mas ouvi dizer que a Espinha do Dragão é um lugar muito perigoso e não consegui encontrar aventureiros dispostos a me ajudar em tão pouco tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "Viajante, você poderia me ajudar a enterrar estes três recipientes de flores na neve da Espinha do Dragão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Obrigada por decidir ajudar, deixe-me pensar... A Montanha Nevada é muito grande, e também possui locais muito diferentes, o efeito de conservação deve ser diferente em cada um deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Talvez uma comparação possa estar em ordem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Por favor, me ajude a colocar estas flores <color=#00E1FFFF>ao lado da Estátua dos Sete</color>, <color=#00E1FFFF>ao lado da água</color>, e em <color=#00E1FFFF>uma entrada de caverna</color>, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Onde eu deveria enterrá-los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "É melhor vender todas em um único dia, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Claro que se fosse assim era melhor. Mas sempre tem uma ou outra flor que não é vendida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "Sei que é apenas uma ou duas, mas não quero simplesmente deixá-las murchar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
