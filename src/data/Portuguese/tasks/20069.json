			"dialogs": [
				{
					"id": 200690201,
					"content": "Como as flores estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690202,
					"content": "Já cuidei delas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "Obrigada. Vamos deixá-las lá na montanha por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690204,
					"content": "Obrigada pela sua ajuda, por favor, fique com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "Flora"
				}
			]
