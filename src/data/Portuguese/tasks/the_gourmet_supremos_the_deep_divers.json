				{
					"id": 721700301,
					"content": "Ervas Marinhas... Peixe... E arroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700302,
					"content": "Deve ser assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700303,
					"content": "Sim, deve ser isso! Apresento a todos vocês, Onigiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Quão simples. Bem, eu fico com este. Duvido que eu pudesse comer mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Bem, eu digo que é tudo bom desde que tenha bom gosto! Vou querer este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "Este é para você, Viajante. E, claro, aqui está uma cópia da receita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Ele parece ser a coisa mais simples do mundo, este Onigiri, mas há alguma técnica para fazê-lo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "Bem, então. Eu mesmo deveria comer alguns também. Todo esse trabalho me deu fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Ei, Parvaneh, não foi você que disse que não conseguiria terminar!? Deixe um pouco para mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
