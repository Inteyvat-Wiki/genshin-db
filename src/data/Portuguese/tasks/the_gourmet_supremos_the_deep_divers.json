					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700702,
					"content": "Sim, as marcas da água são óbvias. Esse lugar com certeza estava inundado até não muito tempo atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700703,
					"content": "Mas por que é que a água recuou de repente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700704,
					"content": "Ugh, este lugar está todo molhado, e a água vai entrar nos meus sapatos...",
