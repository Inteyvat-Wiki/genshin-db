					"nextDialogs": [
						721700402
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700402,
					"content": "Não podemos ir para um outro lugar para coletar Ervas Marinhas? Por que temos que nos limitar aqui mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700403,
					"content": "Por que será que aquele mecanismo tem que estar dentro da barreira?",
