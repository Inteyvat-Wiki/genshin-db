			"dialogs": [
				{
					"id": 721700101,
					"content": "Não podemos descer simplesmente assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "Viajante, nos encontramos novamente. Desta vez, estamos pensando em como podemos entrar nessa água...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700104,
					"content": "Para que possamos pegar uma Erva Marinha Fresca e fazer um prato chamado Onigiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700105,
					"content": "Não pode pegar uma que já está na praia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "Essas Ervas Marinhas que estão na praia não são tão frescas. Creio que não darão um bom sabor ao serem cozinhadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700109,
					"content": "Fiz algumas perguntas às pessoas na cidade. As Ervas Marinhas que crescem submergidas aqui são de qualidade excelente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700110,
					"content": "Mas assim que cheguei hoje... Vi que todas estavam inundadas pela água do mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700111,
					"content": "Além disso... Nenhum de nós três somos capazes de mergulhar, só podemos olhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700112,
					"content": "Há mecanismos nas proximidades?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Tem um por ali, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700114,
					"content": "Mas, está preso dentro daquela barreira de novo, por isso não podemos entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700115,
					"content": "Hmm, vamos continuar por aqui pensando um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700116,
					"content": "Viajante, se você souber de algo sobre como resolver esse problema, conte para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700117,
					"content": "E se você puder trazer aquelas Ervas Marinhas diretamente para nós, melhor ainda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700118,
					"content": "Senhor Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700119,
					"content": "*Cof*! Se você puder trazer aquelas Ervas marinhas diretamente para nós, lhe darei uma boa recompensa, além de uma grande refeição com Onigiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700120,
					"content": "Como é que um Onigiri pode ser chamado de grande refeição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700121,
					"content": "Bem, se a quantidade deles for grande o suficiente, pode-se dizer que sim... *Cof* Vamos continuar pensando mais um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700107,
					"content": "É realmente necessário entrar na água?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Essas Ervas Marinhas que estão na praia e podem ser pegas logo não são tão frescas. Creio que não darão um bom sabor ao serem cozinhadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				}
			]
		},
