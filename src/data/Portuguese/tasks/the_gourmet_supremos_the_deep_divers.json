			"dialogs": [
				{
					"id": 721700201,
					"content": "Viajante, você coletou as Ervas Marinhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700202,
					"content": "Ah sim, é isto mesmo. Agradeço a ajuda, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Bem, começarei a fazer os Onigiris agora... Ouvi dizer que são bem simples...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Preciso de um pouco de tempo para preparar os ingredientes. Por favor espere um pouco.",
					"roleType": "TALK_ROLE_NPC",
