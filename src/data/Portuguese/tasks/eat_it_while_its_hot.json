			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Este Ensopado de Creme é para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Ah, Harris deve ter enviado você, obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "É melhor eu não me acostumar demais à sua comida deliciosa, ou nunca mais poderei voltar àqueles substitutos de refeições desidratadas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Haha, estou só brincando. Como uma aventureira, eu sei quando sorrir e suportar quando se trata de comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Você irá mais longe nas montanhas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Mas é claro, este acampamento é só uma parada. Vou esperar por uma boa oportunidade e depois ver se consigo montar o acampamento um pouco mais adiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "É seguro dizer que não haverá comida quente após esse ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "No entanto, não vou avançar antes que seja seguro fazer isso. Depois de um pouco mais de observação aqui, voltarei ao acampamento, elaborarei um plano de ação e depois tomarei minha decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Obrigada por ter vindo até aqui só para me trazer um pouco de comida. Aqui, leve estes em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
