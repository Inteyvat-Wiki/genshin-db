			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Como ela pode se aventurar sem seu combustível de aventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "\"Combustível de aventura\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Oh, quero dizer, comida quentinha. Eu estava falando de Iris, a exploradora - ela realmente deveria comer uma comida quentinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Ela quer organizar uma expedição para as montanhas com uma equipe de exploradores. Mas ela planeja ir sozinha primeiro, acampar um pouco e observar as condições antes de chegar a um plano definitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "O acampamento não é tão longe assim, e ainda é bem fácil de conseguir que os suprimentos sejam entregues lá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Mas, mesmo assim, acampando na montanha, na neve... Sinto que uma refeição quente lhe daria a energia extra que ela precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Eu, entretanto, não ousaria fazer a viagem por mim mesmo... E você? Você poderia entregar este Ensopado de Creme para a Iris por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Esse prato foi feito fresquinho e continua quente. É melhor levá-lo para Iris rapidamente. Nestas condições, ele esfriará rapidamente e não valerá a pena comer se isso acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Dito isto, na pior das hipóteses, se você tiver problemas pelo caminho e os alimentos se tornarem danos colaterais, basta voltar aqui e eu lhe cozinharei um novinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Onde ela está?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Ela disse que o acampamento é no meio do caminho até a montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "Ela é uma aventureira experiente e sabe ter cuidado. Ela não deve ter se desviado muito do acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
		{
			"id": 2052102,
