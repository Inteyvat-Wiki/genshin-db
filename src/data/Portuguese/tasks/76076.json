			"dialogs": [
				{
					"id": 760761101,
					"content": "#Olá, amig{M#o}{F#a}. Um prazer te encontrar de novo no meio dos túmulos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761102,
					"content": "Você descreve a \"Lanterna do Juramento\" que viu e as palavras incompreensíveis inscritas nela.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "\"Os ventos despertam, as folhas rodopiam\"... Esse é o juramento que os novos membros dos Portadores da Lâmpada fazem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761104,
					"content": "Geralmente, cada um de nós carrega nossa própria lanterna, só quando não há escolha nós desistimos de cuidar dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761105,
					"content": "Cada lanterna sem portador, portanto, é um marcador do azar, uma tragédia que me enche de tristeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761106,
					"content": "Mas eles sabem que esse seria o destino inevitável deles a partir do momento que fazem o juramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761107,
					"content": "Se houvesse alguma coisa que pudéssemos fazer por eles, seria lembrar os juramentos que fizeram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761108,
					"content": "Carregar e defender \"lanternas acesas com esperança eterna\"... Foi o maior desejo deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		}
	]
