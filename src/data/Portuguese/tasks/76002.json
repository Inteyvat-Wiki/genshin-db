			"dialogs": [
				{
					"id": 760020501,
					"content": "Haha! Finalmente resolvido. Esses estrangeiros falam um monte de baboseiras, e ficam dizendo que está quente, mas agora que foram congelados, não estão mais quentes, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Isso... Com isso, deveríamos conseguir impedir que os produtos proibidos cheguem à Cidade de Nasha, certo? Ah, e não se esqueçam da nossa recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hmph, antes de qualquer coisa, deixe-me inspecionar a mercadoria primeiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Hã? Inspecionar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "Bem, é claro! Se algo der errado, não só vocês não receberão Mora, como meus irmãos aqui também não receberão nenhuma recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Tsc, esses arranhões... até tem ferrugem! O Fleuve Cendre está realmente cheio de lixo ultimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Ei, isso não é um Mecautômato de Fontaine? Mas, olhando assim, a tecnologia de Fontaine é realmente impressionante. Ainda está se movendo mesmo depois de ser transportado para cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Movendo? Mas o sistema de energia desta coisa já deveria ter sido desativado há muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
					"content": "AVISO. Modo de inicialização <color=#FF5E41FF>ANÔMALO</color>. Módulo de energia <color=#FF5E41FF>ABx5F02&#5E38Normal</color>. Falha na verificação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020510
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020510,
					"content": "Falha na verificação. <color=#FF5E41FF>Falha na verificação</color>. <color=#FF5E41FF>Falha na verificação</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar Aniquilar Aniquilar</color>,",
