			"dialogs": [
				{
					"id": 760020301,
					"content": "Ufa... acabamos deixando eles escaparem. Esses idiotas realmente não têm noção, como se atrevem a se meter com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Agradeço pela ajuda. Quando os irmãos levarem a \"Mademoiselle Belleville\" para a Cidade de Nasha, certamente vocês não ficarão sem sua parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Hum, hum, desde que lembrem da recompensa, está tudo bem... Ei, espera um pouco, vocês são traficantes de pessoas?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Haha, não entenda mal, garotinha. Não fazemos negócios de sequestrar pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "\"Mademoiselle Belleville\" é o nome desse objeto de metal. Foi transportado do Fleuve Cendre para cá, e custou muito esforço. Se deixarmos alguém roubar, os irmãos vão ter um grande prejuízo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Oh, então é um Mecautômato de Fontaine... Mas, olhando assim, a tecnologia de Fontaine é realmente impressionante. Ainda está se movendo mesmo depois de ser transportado para cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Você só pode estar brincando, garotinha. O sistema de energia desse painel de metal foi desmontado há muito tempo. Como ele poderia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "AVISO. Modo de inicialização <color=#FF5E41FF>ANÔMALO</color>. Módulo de energia <color=#FF5E41FF>ABx5F02&#5E38Normal</color>. Falha na verificação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020309,
					"content": "Falha na verificação. <color=#FF5E41FF>Falha na verificação</color>. <color=#FF5E41FF>Falha na verificação</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar</color>. <color=#FF5E41FF>Aniquilar Aniquilar Aniquilar</color>,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Mademoiselle Belleville"
				},
				{
					"id": 760020310,
					"content": "#Eita! Cuidado, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
