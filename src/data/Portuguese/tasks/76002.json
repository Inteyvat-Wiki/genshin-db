			},
			"dialogs": [
				{
					"id": 760020101,
					"content": "#Ei, você aí, {M#maninho loiro}{F#maninha loira}! Chegou na hora certa, esse malandro quer arrumar briga. Dê uma mãozinha aqui, que eu garanto que você vai receber sua parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "#Que palhaçada é essa, não consegue brigar sozinho e quer chamar ajuda? Tudo bem, se você pode fazer isso, eu também posso. {M#Rapaz}{F#Moça}, escuta, me ajude a acabar com esse cara e, quando a Mora estiver nas minhas mãos, eu divido metade com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "Hã? A gente só estava de passagem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
