			"dialogs": [
				{
					"id": 120190101,
					"content": "Hmm? Tinha algo mais sobre o qual você queria falar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190102,
					"content": "Sobre Leite de Dango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "Não tenho dúvidas de que ela gostou imensamente daquela bebida. Tenho certeza de que ela estava muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "O que ela realmente quis dizer era: \"Em quanto tempo você acha que poderia abrir uma filial no Plano da Eutimia?\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Sobre a Shogun Raiden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "O fantoche, sim. Também ouvi dizer que mudar as regras de funcionamento de um fantoche são extremamente difíceis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "É provavelmente a primeira vez na história que alguém enfrenta esse problema. Você pode imaginar como deve ser difícil, visto que confundiu com sucesso a sábia e poderosa Ei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Esse é um problema que nem Musou no Hitotachi conseguirá resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "Sobre Light Novels...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Você não acha que é uma ideia divertida alguém renascer como a Shogun Raiden? Isso é tudo que as Light Novels deveriam ser — um pouco de diversão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Para ela, porém... sim, provavelmente um pouco vanguardista demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Ooh, talvez eu devesse encomendar uma sequência: Renascer como Guuji Yae. O que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190113,
					"content": "Não tenho mais nada a dizer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}