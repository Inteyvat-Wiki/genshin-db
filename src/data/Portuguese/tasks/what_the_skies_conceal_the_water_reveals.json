					"Gao, o Sexto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411131101,
					"content": "Uff! Isso me trouxe de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131102
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131102,
					"content": "Com licença, você teve sonhos enquanto dormia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131103,
					"content": "O sonho mais exaustivo da minha vida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131104,
					"content": "Que sonho pode deixar uma pessoa cansada assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131105,
					"content": "Você sonhou que estava escalando uma montanha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "Como você sabe disso? Ela era enorme, uma montanha fria coberta de neve... Nunca vi uma montanha tão alta como aquela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131109,
					"content": "O que você foi fazer na montanha coberta de neve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131110,
					"content": "Não sei exatamente, parecia que eu estava possuído, só queria subir na montanha, tinha que chegar no topo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131111,
					"content": "O que tinha de tão interessante no topo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131112,
					"content": "E quem sabe? Parece que eu me tornei uma pessoa totalmente diferente, não faço ideia porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131113,
					"content": "Não era você mesmo que queria subir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "Como posso explicar... Era como se uma pessoa me controlasse, como se tivesse criado a ideia de subir na minha cabeça, eu sei o quão estranho isso parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131115,
					"content": "Será que foi um intruso que foi até os cantos escuros da sua alma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131116,
					"content": "Não foi espontâneo, foi como se o subconsciente tivesse criado essa ideia. Os sinais realmente indicam que minha mente foi controlada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411131117,
					"content": "Embora já tenha ouvido várias vezes, ainda assim quero dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "Todas as outras vítimas falam sobre o frio e como precisavam descansar... Será que todos eles estavam escalando a montanha também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131120,
					"content": "Todos tiveram o mesmo sonho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "Inimaginável... Devemos ir contar para <color=#00E1FFFF>Mona</color> imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131118,
					"content": "O que vocês falaram não é nem remotamente similar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "No seu sonho, você estava em um campo nevado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "Não era um campo nevado, era uma montanha coberta de neve. Muito alta, e muito fria... Assim que dormi, sonhei que estava no pé da montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "Gao, o Sexto"
				}
			]
