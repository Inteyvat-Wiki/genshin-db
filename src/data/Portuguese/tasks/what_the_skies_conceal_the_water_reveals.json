					"content": "O que ele falou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131206,
					"content": "\"Que frio\"... \"Não consigo mais me mover\"... Coisas desse tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "Huaqing"
				},
				{
