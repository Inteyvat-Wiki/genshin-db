				"points": []
			},
			"dialogs": [
				{
					"id": 411130715,
					"content": "Qualquer adivinho iniciante poderia ter dito isso para você, mas... Aquele homem era um Mensageiro dos Fatui! Muito perigoso, como é que vocês conseguiram se envolver com um cara como ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130716
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130716,
					"content": "O quê? Aquele homem é um Mensageiro dos Fatui? Que pessoa má!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130717
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130717,
					"content": "Um Mensageiro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130718
					]
				},
				{
					"id": 411130718,
					"content": "Ele estava se aproximando de você, certamente tinha algum plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130719
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130719,
					"content": "E ele é muito forte! Fui capaz de sentir isso vendo ele apenas uma vez, o poder dele está além da imaginação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130720
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130720,
					"content": "Apesar de eu não querer admitir, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130721
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130721,
					"content": "Será que ele é ainda mais forte que a gênio astrológica do século, Ast Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130722
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130722,
					"content": "Eu nunca disse isso! A força dele talvez supere a minha, mas em astrologia, ele sequer chega perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130723
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130723,
					"content": "Sim, sim, nós também encontramos um Fatui perto do Albergue Wangshu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130724,
					"content": "Por que os Fatui estão interessados na chuva de meteoritos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130725,
					"content": "Como de costume, eles devem estar planejando algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130726
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130726,
					"content": "Huum... Será que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130727
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130727,
					"content": "Ah! Eu já sei! Foram os Fatui que causaram essa chuva de meteoritos, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130728,
					"content": "Paimon! Você roubou minhas palavras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130729
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130729,
					"content": "Hahaha... Me desculpe, é que minha boca é meio rápida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130730,
					"content": "Mas, há alguma técnica que permita invocar uma chuva de meteoritos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130731
					]
				},
				{
					"id": 411130731,
					"content": "É... De onde eles tomaram o poder para puxar as estrelas do céu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130732,
					"content": "Ozvaldo Hrafnavines, qual é sua opinião?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130733
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130733,
					"content": "Eu acho que tudo é possível, minha princesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130734
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130734,
					"content": "Então desde que o custo não seja tão alto, eles nunca pararão de plantar suas sementes de destruição pela terra... Fatui, seus pecados não serão esquecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130735
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130735,
					"content": "Ha, milagres também podem acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130736
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130736,
					"content": "Emissário das estrelas, você agiu admiravelmente como um membro de minha comitiva! Designarei forças para lhe proteger, e eles garantiram que a escuridão nunca lhe faça mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130737
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411130737,
					"content": "No caso, eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130738
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130738,
					"content": "Não, não, não, nós achamos que assim está bom, vamos continuar assim que é melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411130739,
					"content": "Fischl, você por acaso está me subestimando? Eu sou muito forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130740
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130740,
					"content": "Não existe ninguém mais confiável que você, ela só está preocupada com sua segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130741
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 411130741,
					"content": "Não tem necessidade disso. Você está em uma posição mais perigosa que minha, na verdade, eu quero proteger vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130742,
						411130744
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130742,
					"content": "Mona, você é uma boa pessoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130743
					]
				},
				{
					"id": 411130743,
					"content": "Por que... Por que você está dizendo isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130746,
					"content": "Primeiro resolva o novo problema, o astrolábio diz que um <color=#00E1FFFF>meteorito gigante</color> caiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 411130744,
					"content": "Fischl, você é uma boa pessoa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130745
					]
				},
				{
					"id": 411130745,
					"content": "Mas... Mas é claro que sou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130746
					],
					"speakerTitle": "Fischl"
				}
			]
		},
