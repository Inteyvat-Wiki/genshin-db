						411131406
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 411131406,
					"content": "Ai... Que fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131407,
					"content": "Você está bem? Parece que você está faminto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131408,
					"content": "Ai... Ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131409,
					"content": "O que você quer comer? Só dizer o nome da comida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "Quero comer... Comida... Caseira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "Gao, o Sexto"
				},
				{
					"id": 411131412,
					"content": "O prato da Vila Qingce, deve ser o <color=#00E1FFFF>Prato Rústico de Qingce</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 411131410,
					"content": "Eu posso cozinhar para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
		},
		{
