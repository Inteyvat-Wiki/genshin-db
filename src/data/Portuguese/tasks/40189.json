			"dialogs": [
				{
					"id": 401891601,
					"content": "Ufa... Isso deve ser tudo. Parece que você praticamente dominou como gerenciar esse parque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "Huh? É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "Pensando nisso... Aprendemos bastante, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "Só mostra o quão bem você explicou tudo, Navia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Nada disso. Eu não diria que te ensinei muito. Sua intuição tem praticamente guiado tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "Imagino que \"operações de longo termo\" parecia um pouco assustador na primeira vez que mencionei, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "Mas não deixe isso te afetar! Apenas divida as coisas em pequenos passos e lide com eles um por vez. Mesmo se você não for um gênio ou naturalmente talentoso, vai acabar conseguindo no final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "Uau, ver seu próprio progresso realmente animou Paimon! Na verdade, ela vai anotar suas palavras de encorajamento, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "#De agora em diante, estaremos gerenciando o Mundo Fantástico Chevalmarin Filmes junt{M#o}{F#a}s — vamos torná-lo um grande sucesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "Não teríamos conseguido sem sua ajuda, Navia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
