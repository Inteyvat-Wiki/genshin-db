			"dialogs": [
				{
					"id": 401891001,
					"content": "Bem, os números podem não parecer incríveis, mas considerando que estamos começando agora, eu diria que não foi um começo ruim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Aproveitando este impulso, devemos considerar a implementação de estratégias de negócios mais exclusivas durante o próximo ciclo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "Para chamar a multidão, convidei uma chef renomada de Fontaine — minha boa amiga Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "Ela estará se \"apresentando\" bem aqui no restaurante do parque de diversões. Portanto, vamos falar com ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "Então, o restaurante também é parte da nossa estratégia de negócios? Há tantas camadas nessa operação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4018911,
