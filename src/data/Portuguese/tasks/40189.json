			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "Vamos lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "#É hora, {M#querido parceiro}{F#querida parceira} e Paimon, de voltarmos nossa atenção para o Mundo Fantástico Chevalmarin Filmes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Como mencionamos anteriormente, o parque foi criado por entusiastas, que trouxeram a Spina di Rosula para cuidar do planejamento, da construção e das operações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Claro, os entusiastas não costumam ser especialistas em todas as áreas. Eles geralmente se limitam a criar os estandes de eventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Lidamos com operações de longo prazo e desenvolvemos guias de estratégias padrão para as diferentes atividades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Longo prazo... Operações... Parece tão complicado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "Passamos a maior parte do nosso tempo nos aventurando e que não temos experiência gerenciando uma barraca... Você acha que a gente consegue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "Nem todo chefão estudou em uma escola de negócios, sabia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "#Esse é o espírito! Você já viu de tudo, não é, {M#parceiro}{F#parceira}? Eu diria até que você moldou alguns dos maiores negócios de Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "Enfim! Primeiramente, vamos ter uma visão geral de como o festival inteiro será organizado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Ah, Paimon acha que ela quase entendeu. {NICKNAME}, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Haha, parece ser bem a minha praia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Sim! Vamos lá, nós vamos conseguir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "Você mencionou um \"guia de estratégias padrões\" agora há pouco... Isso significa que tem maneiras não padronizadas de participar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Claro! Filmes e entretenimento podem significar coisas diferentes para pessoas diferentes, então terá uma variedade enorme de atividades emocionantes para as pessoas testarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Alguns visitantes podem se distrair e acabar saindo completamente fora da pista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "Outros podem acabar pegando adereços perigosos por engano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Para evitar confusão, precisamos criar um guia estratégico padrão para cada atividade. Apenas pense nisso como um passo a passo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "Entendo, você quer que eu seja sua cobaia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Agora que você falou isso, Paimon consegue imaginar todo tipo de \"surpresas divertidas\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "Se a gente acabar em uma situação complicada, teremos que confiar em nossas habilidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "#Claro, eu nunca colocaria {M#meu parceiro}{F#minha parceira} em perigo. Eu cuidadosamente verifiquei todas as atividades existentes antes de vocês chegarem, e posso te garantir que todas elas são perfeitamente seguras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "Também quero que você experiencie as atividades antes de qualquer outro. Gostaríamos de ouvir seus pensamentos e sugestões!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "#Hehe, essa é a Navia — sempre se certificando que estamos {M#seguros}{F#seguras} e nos divertindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "Sua opinião é super importante para mim, entendeu? Mal posso esperar para ouvir o que você acha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "Certo então, vamos começar com a Jornada Intrépida e montar nosso primeiro guia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "Entendi, você quer que eu estabeleça um ponto de referência.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Uau... Acho que vamos aprendendo enquanto trabalhamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "#Nós mesm{M#o}{F#a}s já fizemos um monte de negócios lucrativos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
