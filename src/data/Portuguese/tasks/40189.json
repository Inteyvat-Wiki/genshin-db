			"dialogs": [
				{
					"id": 401890801,
					"content": "Parece que essa funcionária em particular tá realmente se dedicando à função...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Desejo sucesso no trabalho!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "Hahaha, vocês não são nada mal! Se parecem mais como um chefe do que eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "Com isso, o Mundo Fantástico Chevalmarin Filmes agora está oficialmente aberto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Gerenciar um parque de diversões é um projeto de longo termo. Você não vai fazer muito se tentar apressar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Estamos quase terminando nossa organização atual do trabalho, então vamos fazer uma pequena pausa e aguardar a chegada do relatório de faturamento desse ciclo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Estarei monitorando de perto a presença deles!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
