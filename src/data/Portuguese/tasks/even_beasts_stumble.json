			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "Uf...Uf... Obrigado, viajante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850102,
					"content": "Fico feliz que você está bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "Meu nome é Elber, sou um comerciante, estava apenas descansando aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850105,
					"content": "Mas não pensei que de repente seria atacado por aqueles Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850106,
					"content": "Não havia nenhuma escolta com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "Nós ouvimos na cidade que geralmente comerciantes contratam os Eremitas para escoltar os carregamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850109,
					"content": "Bem, isso custa Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850110,
					"content": "Os membros dos Eremitas cobram preços muito altos e um pede mais que o outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850111,
					"content": "Sou apenas um pequeno comerciante, como poderia pagar uma quantia tão alta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850112,
					"content": "Eu pensei, bem, sei um pouco sobre artes marciais e a rota de transporte não é longa, então fui embora sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850113,
					"content": "Mas eu não esperava que o ataque dos Hilichurls assustasse meus dois Animais de Carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850114,
					"content": "Antes que eu pudesse fazer qualquer coisa, fui derrubado por um Animal de Carga e, após me levantar, fui chutado pelo outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850115,
					"content": "Ih...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850116,
					"content": "Então os dois Animais de Carga escaparam e eu fui atacado pelos Hilichurls... Mas felizmente vocês me ajudaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850117,
					"content": "Mas todos os meus pertences estão nas costas desses dois Animais de Carga... Viajante, você poderia me ajudar a encontrá-los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850118,
					"content": "#Eu... Eu não quero ser chutad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Não, está tudo bem, não se preocupe. Eles são realmente muito dóceis, é só que os Hilichurls derramaram o alimento deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850121,
					"content": "Eles andaram muito com mercadorias nas costas e estavam com muita fome, então quando derrubaram o alimento deles, eles ficaram muito inquietos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850122,
					"content": "Então eles foram perturbados na hora de comer e a comida deles estava bagunçada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850123,
					"content": "Uh, só de pensar nisso Paimon fica brava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850124,
					"content": "Paimon entende as coisas muito rápido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Tudo bem então... Vou deixar esses alimentos com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850126,
					"content": "Quando você encontrar os Animais de Carga, alimente-os com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850127,
					"content": "Enquanto houver alimento, eles não ficam bravos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850128,
					"content": "Se me lembro bem, um Animal de Carga derrubou os Hilichurls e fugiu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850129,
					"content": "O outro parece ter sido levado pelos Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850130,
					"content": "Vou marcar as localizações aproximadas em que os Animais de Carga desapareceram... Estou contando com você, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850131,
					"content": "Contanto que eu tenha meus bens de volta, eu lhe darei uma grande recompensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850119,
					"content": "#Eu... Eu tenho medo de ser derrubad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "Ninguém estava te protegendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "Não foi nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
