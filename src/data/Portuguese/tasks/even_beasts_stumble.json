			"dialogs": [
				{
					"id": 731850501,
					"content": "Este Animal de Carga... Ele parece estar irritado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850502,
					"content": "Uau, olhe para os cascos dele, eles parecem tão fortes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850503,
					"content": "Se alguém fosse chutado por ele, poderia desmaiar imediatamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850504,
					"content": "Paimon, você pode alimentar ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "Não, você vai! Rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850506,
					"content": "Bom apetite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "Sem ofensa aos seus cascos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "O Animal de Carga engoliu lentamente o alimento. Parece menos inquieto agora...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Ele parece menos bravo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850509,
					"content": "#Vamos levá-lo de volta rapidamente, e tenha cuidado! Não seja atingid{F#a}{M#o} por ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850511,
					"content": "Você voltou para Elber com o Animal de Carga...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "Ufa... Achei que tinha perdido o Animal de Carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850513,
					"content": "Obrigado Viajante, não consigo expressar minha gratidão o bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850514,
					"content": "Devo verificar o seu estado. Espero que não tenha se machucado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850515
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850515,
					"content": "Viajante, por favor, ajude-me a encontrar o outro Animal de Carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850516
					],
					"speakerTitle": "Elber"
				}
			]
		},
