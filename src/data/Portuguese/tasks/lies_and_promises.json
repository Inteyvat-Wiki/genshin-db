			"dialogs": [
				{
					"id": 750220404,
					"content": "Eehh, não vai acordar? Urg, tão irritante! Você não acha que só está fingindo estar dormindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220405,
					"content": "Ehrrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "Parece estar dormindo mesmo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "(Você diz o que ele disse enquanto dormia...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "Tá falando que ele tá bloqueando o caminho intencionalmente só para conseguir comida? Então tá só enganando as pessoas pela comida delas... Paimon sente que a gente caiu feito patinhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220410,
					"content": "#Hunf! Mas se é assim que as coisas são, então não temos que ser {M#bonzinhos}{F#boazinhas}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220411,
					"content": "#Vamos só pedir para {REALNAME[ID(2)|SHOWHOST(true)]} cavar um túnel e pegar aquele baú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220412,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "Se ele vai sacanear a gente, não espere que a gente jogue justo também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220407,
					"content": "E falando durante o sono...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
			]
		},
