			"dialogs": [
				{
					"id": 750220606,
					"content": "O que vocês estavam resmungando agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220607,
					"content": "*Rooonc*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Yumkassauro Estranho"
				},
				{
					"id": 750220608,
					"content": "Ei, será que tá mesmo com fome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "Um Sauriano aqui sozinho, sem nenhum mestre por perto... Provavelmente nem consegue encontrar a própria comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#Vem, {NICKNAME}, vamos achar um pouco de comida para ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Quando estiver cheio, vai ser legal e vai sair do caminho, então o tesouro será todo nosso! Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Mas o que a gente dá de comer a ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Deixa Paimon pensar por um segundo! Saurianos aqui tendem a comer um pouco de tudo, e Paimon não tem certeza do que Yumkassauros comem... Olhando para a cor dele, parece que devia comer folhas e grama, esse tipo de coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Vamos achar isso e dar para ele experimentar primeiro! Barrigas famintas tendem a não ser tão exigentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
