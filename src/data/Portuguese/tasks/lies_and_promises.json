			"dialogs": [
				{
					"id": 750220703,
					"content": "O Yumkassauro devora a comida em um lampejo.\\nVocê quase não consegue ver como ele conseguiu...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "T-T-Tá só inalando a comida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Paimon, você tem competição agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Só uma porção... não parece ser suficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Ei, tá querendo dizer o quê! Paimon é uma gourmet de verdade, especialista em comida, nunca ia engolir as coisas assim... Se você sugar sua comida assim, dá nem pra sentir o gosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#É-É! Paimon não conseguiria perceber, esse carinha é, na verdade, um \"Megalanchauro\"... Ainda bem que {REALNAME[ID(2)|SHOWHOST(true)]} não consegue comer tanto assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Mesmo assim, talvez o pobrezinho só tivesse morrendo de fome! Coitado, vamos dar outra porção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Rawrrrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#Nosso {REALNAME[ID(2)|SHOWHOST(true)]} também quer comer? Primeiro vamos alimentar esse outro Saurimigo, então a gente te dá alguma coisa deliciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "O Sauriano faminto come tudo em sua frente de uma vez só.\\nVocê pisca, como se a cena acontecesse duas vezes...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Ok, deve tá de barriga cheia agora pelo menos—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "Ei! Espera aí, como você tá sentando de novo? Duas porções não foram suficientes?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Eita, você vai só dormir bem na frente da caverna depois de comer? Ele não parece nem um pouco interessado em sair do caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#O que a gente faz, {NICKNAME}? Paimon não entende esse cara... Mesmo que você queira tirar um cochilo depois de comer, pelo menos não bloqueie o caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Acho que ele nunca concordou em sair do caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Parece mesmo que a gente caiu num golpe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Aaaaaaaarrrrrghhhh! E ele comeu tanto da nossa comida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Até mesmo {REALNAME[ID(2)|SHOWHOST(true)]} não consegue aturar! Vem, {NICKNAME}, a gente tem que tentar acordar ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
