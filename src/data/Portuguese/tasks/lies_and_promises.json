			"dialogs": [
				{
					"id": 750220801,
					"content": "Rawr! Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Hehe, muito bem! Agora vamos ver as belezinhas escondidas naquele baú!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Hã? Nadinha? Só uma nota?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "#Ah, então quem deixou essa nota foi o mestre dele de verdade? Então não fomos enganad{M#os}{F#as} pelo Sauriano, mas pelo mestre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Totalmente irresponsável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "É! Mesmo se ele estivesse bem doente, como ele pôde deixar o Yumkassauro dele num lugar como esse?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "E ele até queria usar a ganância das pessoas para... Não, espera, ele queria tirar vantagem da empatia das pessoas pelo Sauriano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "*Suspiro* Enfim, não é como se a gente só pudesse deixar ele ficar aqui enganando as pessoas por comida. Vamos até o chefe dos Descendentes das Copas contar a ele sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Você explica a situação a Wayna, chefe dos Descendentes das Copas e o traz até aqui.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "Oh, céus, tive um pressentimento sobre isso quando vocês vieram me procurar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Quem imaginaria que foi aquele salafrário que deixou essa criatura para trás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "Aquele salafrário?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Foi ele que errou, então com medo da punição, abandonou a tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Mas não vejo benefício em divulgar o nome do criminoso. Talvez ele mesmo esteja ciente de que fez algo muito ruim. Veja — ele nem deixou o nome do final da própria carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Então o Sauriano dele escolheu se juntar a ele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "Não, não podemos dizer que ele \"escolheu\". Saurianos são simples criaturas que não conseguem distinguir facilmente entre o certo e o errado. Na maioria das vezes, eles simplesmente seguem suas emoções e confiam em seus companheiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "...Como suspeitei, ele não mudou mesmo em seu coração. Ele faz o que for necessário para aplicar seus golpes e enganar os outros, até seu próprio Sauriano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Vamos enviar pessoas para alimentarem esse Yumkassauro regularmente. É uma criança da tribo, afinal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "Quanto ao salafrário... *Suspiro* É um fim realmente trágico, mas me recuso a ter empatia. As pessoas devem ser responsabilizadas por seus atos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Então aqueles que comem demais estão destinados a serem abandonados pelos amigos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Ei! Nem brinque com coisas assim! Além disso, o Sauriano é inocente nisso tudo, talvez só esteja esperando aqui o retorno do mestre, que é por isso que ele se recusa a se mexer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
