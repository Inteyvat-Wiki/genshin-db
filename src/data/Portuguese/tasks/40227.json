			"dialogs": [
				{
					"id": 402270201,
					"content": "Vocês levam Aino e Ineffa para o local.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Hmm... Esse parece um bom local para a plataforma de demonstração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Esse robô novo parece bem interessante, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "Hehe. Deem uma passada aqui, podem experimentar quando quiserem! Vocês não vão acreditar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Agradeço pela ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "Não tem problema! Oh, e para o registro, serão só vocês duas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Hmm... Eu participarei, mas não é necessário registrar Aino. Ela não gosta de ficar ao redor de pessoas. Quando a exposição começar, ela retornará para a oficina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Faz sentido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
