					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Isso é simplesmente porque o Arconte Geo é a pessoa mais rica do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
