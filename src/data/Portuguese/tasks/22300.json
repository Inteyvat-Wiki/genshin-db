		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Aha, minério das minas! Então você entende uma coisa ou outra sobre o significado de Geo afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Para os primeiros antepassados de Liyue, o minério teve um papel essencial, mas antes disso, os minérios possuíam outro uso muito mais importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "Quando os ancestrais chegaram aqui e começaram a cavar, eles construíram um forno de pedra, que eles acenderam quando duas pedras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Com fogo, eles poderiam cozinhar. E com comida cozida, eles tinham forças para trabalhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "Tudo isso veio das rochas da terra, que foram um presente do Senhor Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "Daí, o Arconte Geo começou a ter um título de \"Deus do Fogão\" em alguns documentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Restaurantes e tavernas recém-abertos queimam incenso para o Arconte Geo e rezam para que o fogo em seus fogões perpetue, para que os negócios possam florescer para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "Da próxima vez que você visitar um dos restaurantes em Liyue, não se esqueça de fazer uma oração silenciosa ao Senhor Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Ah, você deve ter percebido isso em algum lugar do interior? Você fez um grande esforço para conseguir isso. Bom trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Você viu? O Porto de Liyue é enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Até mesmo as maiores cidades foram construídas de tijolo por tijolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Quando nossos antepassados chegaram a esta terra, não era chamada de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Através do suor e do trabalho, esses bravos colonos cultivaram a terra, pouco a pouco, e finalmente construíram esta grande cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Como você sabe, o terreno ao redor do Porto de Liyue é rochoso e montanhoso, o que dá muita dificuldade em cultivar. Mas essas plantas tenazes crescem desafiadoramente nessas montanhas e rochas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Cada uma dessas plantas também possui propriedades que as tornaram imensamente úteis para os primeiros colonos. Eles tomaram isso como a providência divina do Arconte Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Histórias das realizações dos colonos sempre foram populares no porto de Liyue. Ainda hoje, muitos dos aventureiros de Liyue são inspirados pelos feitos de seus antepassados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Além de vincular o espírito dos ancestrais de explorar novos caminhos, eles tratam o Arconte Geo por Deus do Desenvolvimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Ser aventureiros, resistentes como rocha, é uma exigência deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Interessante... Agora, onde você encontrou isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Eu ouvi dizer que estes dias só se vê no Terraço de Yujing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Parece que você também está interessado em ouvir as histórias do Senhor da Rocha. Uma ótima escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "Este Lírio de Vidro é a essência da origem do Porto de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "Não entendeu? Pense comigo. Qual é a caraterística do Lírio de Vidro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "Precioso! Sim. Você pode vendê-lo por um preço muito bom e ganhar muito Mora.",
