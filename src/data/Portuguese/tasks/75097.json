			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "Hehe, é assim que as coisas devem ser! Essa é a conexão estável com a Estátua dos Sete que estávamos procurando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970302,
					"content": "Então, aquele problema anterior foi por causa daquele vilão no Reino da Noite, né? A Estátua dos Sete deve ter tido um grande trabalho naquela época... Bom trabalho, Estátua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970303,
					"content": "Bem, não é como se você pudesse ter concedido o poder de ressonar com Pyro, mesmo que quisesse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970304,
					"content": "É, isso aconteceu enquanto eu lutava ao lado da Arconte Pyro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "Paimon tava com um medão naquela vez... Mas parece que você era forte demais para aquilo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970306,
					"content": "De toda forma, é ótimo que conseguimos nos livrar de todos aqueles monstros do Abismo e recuperar as Estátuas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
