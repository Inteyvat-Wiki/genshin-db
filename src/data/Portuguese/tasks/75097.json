				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "...É, definitivamente está estranho. Você ainda não consegue tirar poder elemental da Estátua dos Sete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "Caramba! Qual é a dessas Estátuas dos Sete, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "Talvez só seja antiga e precisa de manutenção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "Mas ela totalmente brilhou quando você tocou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "Ei! Qual é, Estátua dos Sete... Você está fazendo seu trabalho direito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "Paimon não faz ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "Talvez Natlan só seja especial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Agora que você comentou, parece que Natlan estava constantemente sendo influenciado pelo Abismo... Poderia esse ser o motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
