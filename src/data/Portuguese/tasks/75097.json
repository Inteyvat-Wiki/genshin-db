			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Hã? É só Paimon, ou as Estátuas dos Sete de Natlan são meio estranhas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "Não deveria ser mais... intenso, na primeira vez que você toca? Tipo, tem um sonzinho com uma sensação mais de sacudir, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Eh, até que me parece normal...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Mas realmente é meio estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Hmm, como Paimon pode dizer... Bem, ela sempre sentiu isso antes, uma conexão mais forte poderia ser estabelecida ao tocar as Estátuas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Dessa vez, pareceu mais como tocar um interruptor. Apenas se acende quando você toca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "Certo, certo! Antes, quando você tocava as Estátuas, você podia sentir o poder Elemental. Mas, dessa vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Tem aquela sensação de Pyro, todo vivo e intenso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Você cuidadosamente busca dentro de si...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Hã... Nadinha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Parece meio estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(Não há nenhuma sensação de calor intenso que você esperava...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "Na verdade, essa sensação de sacudir de antes fui eu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Oh! Então você esqueceu de sacudir essa vez? Bem, da próxima vez, tente prestar mais atenção...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "ATÉ PARECE! É bom você adicionar seu próprio efeito sonoro sempre que tocar uma Estátua dos Sete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
