				"points": []
			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "Ah, você não poderia ter chegado em um melhor momento, Viajante! Os dados foram quase todos coletados, e agora é hora de pegar nossos sinalizadores de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Não tem problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "#Então vou deixar isso com você. É melhor ser rápid{M#o}{F#a} e tome cuidado também. Não deixe que aqueles Fatui {M#o}{F#a} vejam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Como você chegou a saber disso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Estes sinalizadores geralmente vêm com manuais de instruções muito detalhados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Estes descrevem várias circunstâncias diferentes e o tempo necessário para a coleta de dados em cada circunstância.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "E quanto a energias desconhecidas, como as do Tatarigami, simplesmente considero que elas precisam da maior duração. De qualquer maneira, a tarefa de trazer aqueles sinais de volta é sua responsabilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
