			"dialogs": [
				{
					"id": 721170301,
					"content": "Como foi? Você pegou todos os nossos sinalizadores?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170302,
					"content": "Peguei todos bem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "Maravilha! Agora, me dê apenas um momento para modificar este dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170304,
					"content": "Mas igual, as recentes ações dos Fatui se tornaram cada vez mais estranhas. Todos eles estão se reunindo em torno do núcleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170305,
					"content": "Esperemos que não estejam criando outra conspiração traiçoeira. Ou devo dizer, tentando fazer algo que não possamos mitigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
