			"dialogs": [
				{
					"id": 761180501,
					"content": "Chegamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180502,
					"content": "Você pode abrir os olhos agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180503
					]
				},
				{
					"id": 761180503,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180504
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180504,
					"content": "(Ela realmente abriu os olhos!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(Eu só falei isso sem pensar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "É lindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180507,
					"content": "Este par de asas faz com que tudo pareça ainda mais completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180508,
					"content": "Este é um presente que nós, Filhos da Lua Gelada, gostaríamos de oferecer a você, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Para celebrar nossa deusa que agora pode voar livre, cujos dedos enfim podem tocar o lugar que ela chama de \"lar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "...A eu de antes só era lembrada da confusão que senti ao nascer sempre que olhava para essa estátua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180511,
					"content": "Mas agora, o que eu sinto é o calor de um \"lar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180512,
					"content": "Talvez, assim como esta estátua, eu tenha escolhido permanecer aqui mesmo tendo asas agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180513,
					"content": "...Obrigada, pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180514,
					"content": "Temos outro presente preparado, mas você terá de caminhar um pouco mais comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Hã? Tem outra surpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Eu e meus companheiros dos Filhos da Lua Gelada organizamos um banquete de boas-vindas simples na floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "A partir de agora, este também será o seu lar, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Sempre que sentir saudades de casa, por favor, sinta-se à vontade para permanecer aqui e aproveitar nossa hospitalidade, por mais modesta que seja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Claro. Eu irei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180520,
					"content": "Ora, veja só. A lua já apareceu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Então vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "Espero que todas as noites possam ser tão maravilhosas quanto aquela Noite da Oração Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Bem-vinda ao lar, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		}
