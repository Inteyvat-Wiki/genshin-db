			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180102,
					"content": "Será que só Paimon ou você também tá sentindo esse cheirinho delicioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180104,
					"content": "Columbina tá fazendo um banquete só pra ela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180106,
					"content": "Parece que alguém tá se divertindo bastante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Gostariam de provar um pouco também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180108,
					"content": "Não, não, pode ir em frente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Nós não costumamos ver você comendo aqui! Você saiu só para comprar isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Lauma me deu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180111,
					"content": "Uau, ela cuida muito bem de você, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "Com a condição de que eu não saia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180113,
					"content": "Espera, o quê!? Isso não é só um suborno para você aceitar prisão domiciliar? E dos baratos, ainda por cima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Ela também me trouxe alguns livros interessantes e brinquedos feitos com primor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180115,
					"content": "Hum, agora isso parece mais uma mãe saindo em viagem de negócios e a filha que ela tá deixando em casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Lauma explicou o motivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Ela só me disse para não sair por enquanto, e para ter muito cuidado em evitar os Filhos da Lua Gelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180118,
					"content": "Perguntei aos animais que vieram entregar minhas refeições, mas Lauma tinha instruído todos a permanecer em silêncio, então foi isso que fizeram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180119,
					"content": "Uh, isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Se eu tivesse que adivinhar, ela está preparando algo que tem a ver comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180121,
					"content": "Não se preocupe. Eu nunca considerei ficar aqui entediante. A comida aqui é boa e muito do meu agrado. Não sair está ótimo para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180122,
					"content": "E se os Filhos da Lua Gelada realmente estiverem se preparando para algo... Bem, é mais um motivo para não interrompê-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180123,
					"content": "Quer que a gente vá perguntar por aí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "É! Paimon também ficou curiosa agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "#Vocês podem... mas devem estar preparad{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180126,
					"content": "Ela provavelmente sabe que vocês virão me ver, então talvez não conte nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
