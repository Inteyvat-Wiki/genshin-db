							2136.298,
							108.658,
							11196.91
						],
						"pointId": 360300084
					}
				]
			},
			"dialogs": [
				{
					"id": 761180401,
					"content": "Ah, você voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180402,
					"content": "Adivinha, Columbina? Você tinha razão, a Lauma não nos contou nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "Ela parece bem ocupada, no entanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Então vamos fazer companhia para você nos próximos dias. Fique tranquila e mantenha essas expectativas lá no alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "Expectativas para... o quê, exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180406,
					"content": "Éééé...! Ah! Uh, n-nada não! Nós não sabemos de nada, de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Hehe... Muito bem, então. Estou ansiosa para passar os próximos dias com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Íbis"
				},
				{
					"id": 761180409,
					"content": "Aah, aí vem nossa comida... Espera aí. Cadê a comidinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Íbis"
				},
				{
					"id": 761180411,
					"content": "Está escrito: \"Chegou a hora.\" Você sabe o que isso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180412,
					"content": "Ahhhhh, agora a Paimon entendeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Sim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180415,
					"content": "Você normalmente usa uma venda, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Sim. Algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180417,
					"content": "Mas você ainda consegue usar o Kuuvahki para observar o mundo lá fora, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "Certo. Na verdade, assim eu até percebo as coisas com mais clareza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180419,
					"content": "Então, hum, podemos pedir que você, de propósito, não perceba nenhuma mudança lá fora por enquanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "Para que isso possa ser uma \"surpresa agradável\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761180421,
					"content": "...Pelo visto você já adivinhou do que se trata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Tudo bem. Entendi. Nesse caso, você me dá a mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
