			"dialogs": [
				{
					"id": 101200301,
					"content": "#Oi, Cavaleir{F#a}{M#o} Honorável! Estava pensando em ir investigar, e não esperava encontrar você por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200302,
					"content": "#Você parece estar angustiad{M#o}{F#a}, aconteceu alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200303,
					"content": "A Mestre Jean nos pediu para resolver um problema, e parece que esgotamos todos os esforços dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200304,
					"content": "É uma longa história.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "#Não fique decepcionad{M#o}{F#a}. Os esforços nem sempre dão frutos. Além disso, nem eu posso garantir que encontrarei informações úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200307,
					"content": "Então, se anime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200308,
					"content": "#Obrigad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "Hehe. Bem, deixe-me pensar, talvez eu possa ajudar vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200311,
					"content": "A Mestre Jean nos pediu para nos aproximar do Schubert Lawrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200312,
					"content": "Assim que o encontramos, percebemos que ele é uma pessoa bastante peculiar, e não é fácil lidar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200313,
					"content": "Eu conheço essa pessoa! Ele deve ter dito que vocês não entendiam nada de cortesia, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200314,
					"content": "Isso! Então você já está sabendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "Haha. Eu passei pela mesma coisa. As pessoas do clã Lawrence sempre seguem alguma etiqueta esquisita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200317,
					"content": "Ei? Todos são assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200318,
					"content": "Para eles, a cortesia nobre deve ser muito bem preservada. Hmm, isso é compreensível, mas ao mesmo tempo eles precisam acompanhar os tempos modernos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200319,
					"content": "Mas entre essas pessoas peculiares, tem um caso excepcional, e ela é a minha boa companheira, Eula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200320,
					"content": "Com... Companheira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200321,
					"content": "Sim! Ela é do clã Lawrence, e também é a Capitã da 4ª Equipe dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200322,
					"content": "A Mestre Jean disse que o clã Lawrence considera os Cavaleiros de Favonius como inimigos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "É porque a Eula é uma pessoa muito especial e muito diferente dos seus familiares de Lawrence. Ela tem as suas próprias ideias e seus princípios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200325,
					"content": "Melhor dizendo, ela não fica presa sob os regulamentos da família.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200326,
					"content": "Mas quanto a como lidar com as pessoas do clã Lawrence, ela sabe melhor do que ninguém. Basta encontrar com ela, vocês perceberão logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200327,
					"content": "Então a Paimon está confusa. Como a Eula é do clã Lawrence, por que a Jean procurou nós em vez da Eula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200328,
					"content": "Hum... Não é fácil explicar isso com poucas palavras. Resumindo, como ela se juntou aos Cavaleiros, os familiares da Eula não gostam dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200329,
					"content": "Diante de seus olhos, a Eula é uma traidora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200330,
					"content": "Ela realmente é muito especial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "Hehe... Mas ela é uma boa garota, e vocês vão se dar bem com certeza. Podem contar a sua angústia a ela, e ela vai ensinar vocês como lidar com o Schubert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200333,
					"content": "Ela foi patrulhar na natureza, talvez possam encontrá-la na Montanha do Precursor do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200334,
					"content": "Muito obrigada, Amber! Vamos lá então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200335,
					"content": "Boa viagem! O meu dever está me chamando também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200331,
					"content": "Isso é compreensível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "Como uma pessoa do clã Lawrence poderia se juntar aos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "Sim, parece que você também passou pela mesma situação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "É bem o estilo da Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "A culpa não é nossa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
		{
			"id": 1012004,
			"completionStepIds": [
				1012009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012009",
							"2"
						],
						"stepId": 1012009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200401,
					"content": "#Vocês foram rápid{M#os}{F#as}!... Vocês têm ideia de quanto tempo tenho rastreado esses alvos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200402,
					"content": "Agora você quer levar todo o crédito? Droga! Ouça bem, a vingança está por vir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200403,
					"content": "O... O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200404,
					"content": "Vingança??",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "Sim. Assim que escutei o barulho de luta, corri para cá. Vi que você e os Fatui estavam lutando e você até ficou com vantagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200406,
					"content": "Se eu não tivesse ajudado, você não teria levado o crédito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200407,
					"content": "#Mas ainda bem que vocês não saíram ferid{M#os}{F#as}. Sabe, é muito perigoso lutar com tantos soldados Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200408,
					"content": "Eu já me acostumei a lutar contra os Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "A Paimon não está entendendo. Mas a Paimon sabe que você está preocupada conosco. Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200411,
					"content": "#Ah? Eu? Preocupada com vocês, {M#meus}{F#minhas} inimig{M#os}{F#as}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200412,
					"content": "#Mas você não acabou de dizer \"ainda bem que nós não saímos ferid{M#os}{F#as}\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200413,
					"content": "#Oh! O que eu quis dizer era que se vocês tivessem saído ferid{M#os}{F#as}, além de não poder levar o crédito, eu teria que levá-l{M#os}{F#as} de volta à Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200414,
					"content": "Sendo assim, vocês me incomodariam ainda mais! E isso causaria uma vingança ainda maior!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200415,
					"content": "É assim que você interpreta a situação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200416,
					"content": "Você... É a Eula?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "Sim, sou eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200418,
					"content": "Faz sentido! Ela realmente é muito peculiar! Mas ainda dá para conversar com ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200419,
					"content": "Ainda não nos conhecemos, né? Você não acha que é um pouco mal-educado chamar uma desconhecida de \"peculiar\", não apenas entre os nobres, mas também entre os plebeus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200420,
					"content": "Falando nisso, como vocês sabem o meu nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200421,
					"content": "#Acertamos por causa das cortesias da nobreza. {NICKNAME} é {F#a}{M#o} Cavaleir{F#a}{M#o} Honorável dos Cavaleiros de Favonius, e estamos investigando um nobre chamado Schubert Lawrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200422,
					"content": "#Ele não quis conversar com a gente e achou a gente mal-educad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200423,
					"content": "Hahaha. Eu entendi. Ele é o meu tio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200424,
					"content": "Mas por que vocês estão investigando ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200425,
					"content": "Porque ele talvez esteja conspirando alguma coisa com os Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "Entendi! Hahaha, mas sabia que você está falando mal de um parente meu na minha frente? Mais um motivo para a vingança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200427,
					"content": "Não, não! É apenas um pedido da Mestre Jean! Aliás, é apenas uma afirmação sem prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200428,
					"content": "Você não está curiosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "Aos olhos dos habitantes de Mondstadt, todas as pessoas do clã Lawrence são malfeitoras, e os rumores nunca pararam. Então quanto a isso, não fico nem um pouco surpreendida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200431,
					"content": "Hum! Certo! Afinal de contas, eram governantes tiranos e não têm uma boa fama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200432,
					"content": "Você também acha isso? Bom! Então, podem tomar nota, minha vingança será...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200433,
					"content": "Foi você que disse isso primeiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200434,
					"content": "Hahaha! Que engraçado! Mesmo no primeiro encontro, já tenho três motivos para fazer minha vingança! Já faz muito tempo que não encontro uma pessoa tão interessante como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200435,
						101200436
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200435,
					"content": "Você acabou de dizer \"interessante\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200437,
					"content": "Vocês me procuraram para eu ensinar a etiqueta dos nobres, e assim poderem conversar com o meu tio, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200438
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200438,
					"content": "Certo! Foi a Amber que nos disse que você poderia nos ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200439,
					"content": "Sem problemas! Mas é melhor voltarmos primeiro a Mondstadt, porque é mais fácil treinar com pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200440,
					"content": "Mas você não é uma pessoa vingativa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "Vamos deixar a vingança de lado primeiro. A Mestre Jean me pediu e a Amber me recomendou, então não posso decepcioná-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200441,
					"content": "Você não está querendo fazer a sua vingança agora, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200436,
					"content": "Você parece estar muito alegre...",
					"roleType": "TALK_ROLE_PLAYER",
