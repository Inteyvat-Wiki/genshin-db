	"talks": [
		{
			"id": 1012001,
			"completionStepIds": [
				1012001
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012001",
							"2"
						],
						"stepId": 1012001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "#Cavaleir{F#a}{M#o} Honorável, muito obrigada pela sua ajuda, você deve estar muito ocupad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200102,
					"content": "Bom, não vou enrolar. Tenho que te pedir um favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200103,
					"content": "Os Cavaleiros de Favonius têm estado sempre ocupados.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "Estamos em caos, e tanto eu quanto outros Cavaleiros de Favonius não temos como baixar a guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200107,
					"content": "Recentemente vários Cavaleiros de Favonius vieram me reportar que as pessoas do clã Lawrence estão envolvidas com os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200108,
					"content": "Fatui? De novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200109,
					"content": "Mas... Quem são as pessoas do clã Lawrence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200110,
					"content": "Mondstadt passava um período sombrio sob a ditadura dos antigos nobres. A liberdade recuperada do tirano Decarabian da torre foi novamente esmagada, e a escravidão voltou a predominar em toda a sociedade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200111,
					"content": "A primeira Cavaleira de Dandelion Vennessa provocou uma revolução que derrubou a aristocracia e fundou a Guilda dos Cavaleiros de Favonius. Por causa disso, Mondstadt está prosperando como agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200112,
					"content": "E foi exatamente o clã Lawrence que trouxe a miséria para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200113,
					"content": "Ah... A Paimon entendeu. Seus descendentes agora querem repetir a miséria junto com os Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200114,
					"content": "Agora é apenas uma afirmação sem prova, razão pela qual estou aqui pedindo a sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200115,
					"content": "Por que eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "*Suspiro* Porque os velhos nobres e os Cavaleiros de Favonius eram inimigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200118,
					"content": "E os Cavaleiros de Favonius fizeram o que podiam para melhorar a relação com eles. Mas mesmo assim, os descendentes ainda estão muito hostis contra nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200119,
					"content": "Não importa o que façamos para nos aproximarmos deles, nunca dá resultado nenhum. Pior ainda, eles sempre nos levam a mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200120,
					"content": "Embora possamos resolver esse problema como uma \"investigação de rotina\", perderemos totalmente a sua confiança se o resultado não for o que imaginamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200121,
					"content": "E todos os esforços feitos antes serão em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200122,
					"content": "#Mas eu sou Cavaleir{F#a}{M#o} Honorável dos Cavaleiros de Favonius...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "Você tem razão. Mas você é a pessoa mais adequada para tratar desse assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200124,
					"content": "#Não é preciso mencionar o seu título como {M#um}{F#uma} Cavaleir{F#a}{M#o} Honorável, pois você vem de longe, e Mondstadt é apenas uma das suas paradas da jornada. Eu suponho que você possa se aproximar daquele nobre dessa maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200125,
					"content": "Após estabelecer uma boa relação com ele, você deve obter algumas informações sobre os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200126,
					"content": "Só a Mestre Jean pensaria em um bom plano como esse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200127,
					"content": "Obrigada! São experiências acumuladas ao tratar de assuntos diplomáticos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200128,
					"content": "Aquele cara do clã Lawrence se chama Schubert, e ele tem vagado ao redor dos muros no norte de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200129,
					"content": "Dizem que não é fácil lidar com ele. Mas se você conversar com ele com mais calma, talvez dê certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200130,
					"content": "Deixe comigo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "Muito obrigada pela sua ajuda! Se precisarem de assistência, vocês já sabem onde me procurar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200131,
					"content": "Espero que tudo corra bem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "Não é uma responsabilidade dos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "É bem o estilo da Jean.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "Gostaria de ficar conversando mais com você, mas no momento a segurança é a nossa prioridade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012003",
							"2"
						],
						"stepId": 1012003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "Hã? Quem está aí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200202,
					"content": "Olá, nós viemos para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200203,
					"content": "Olá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200204,
					"content": "O... Olá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "Olá? Eu não ouvi errado, ouvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200208,
					"content": "Uma pessoa rude e grosseira. Cumprimenta sem saber com quem está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200209,
					"content": "#Você realmente é {M#um}{F#uma} forasteir{M#o}{F#a}, pois você não me conhece! Eu sou o Schubert Lawrence, descendente do clã Lawrence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200210,
					"content": "Se quiser me cumprimentar, tome cuidado com as palavras. Suas maneiras indiferentes são inadmissíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200211,
					"content": "Se você entendeu, agora deve se ajoelhar e se apresentar. Aliás, deve pedir desculpas pela sua falta de educação. Isso sim são modos apropriados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200212,
					"content": "Modos apropriados? A Paimon nunca ouviu isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200213,
					"content": "Na época em que todo mundo ainda seguia a cortesia, isso era um comportamento básico entre os nobres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200214,
					"content": "Qualquer falta de cortesia levava a pelo menos uma chicotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200215,
					"content": "E agora não existem mais cortesias nem regras básicas, e toda a sociedade está bem corrompida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200216,
					"content": "Isso soa muito complicado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "Você está questionando a dignidade dos antigos nobres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200219,
					"content": "Vou deixar isso bem claro: Embora o clã Lawrence tenha decaído, eu, descendente do clã, estou sempre fazendo o meu melhor para recuperar sua glória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200220,
					"content": "Quanto mais indiferentes as pessoas ficam, mais elegante fico! Afinal de contas, somos diferentes desde nosso nascimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200221,
					"content": "...Bom, eu nem disse nada ainda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "#Não é preciso dizer nada. O seu comportamento e as suas palavras me incomodaram bastante, e não tenho nada mais a dizer para {F#uma}{M#um} civil como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200223,
					"content": "Aliás, não é o meu dever ensinar etiqueta a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200224,
					"content": "Tenho coisas para resolver, vou indo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200217,
					"content": "Isso talvez explique a decadência dos velhos nobres.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "O que foi? Eu não ouvi errado, ouvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Schubert"
				}
			]
		},
