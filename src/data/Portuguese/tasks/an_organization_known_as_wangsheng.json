			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Bem vind{M#o}{F#a}, {NICKNAME}, amig{M#o}{F#a} do Childe. Espero que você tenha uma carreira brilhante em Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Eu não considero Childe um amigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "Somos mortais comuns em vez de a Imperatriz do Gelo. As nossas ideias são como água. Só a Tsaritsa é firme como o gelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Desculpe. Vamos voltar diretamente para o assunto. O Childe disse que a promessa entre ele e vocês já foi concluída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "Já? Quer dizer, ele vai nos ajudar a procurar alguém?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Correto. Childe prometeu que encontraria alguém para quebrar o impasse. E os Mensageiros dos Fatui não quebram suas promessas tão facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Então, onde ele está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "O Childe está no <color=#00E1FFFF>Pavilhão de Liuli</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Pavilhão de Liuli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "Ohh, a Paimon já ouviu falar desse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "Tem dois estilos culinários em Liyue, o estilo de Li, e o estilo de Yue. Eles têm competido há uns séculos, mas ainda não chegou à conclusão de quem é ganhador.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "O principal restaurante do estilo Li é o Pavilhão de Liuli. O proprietário escolheu especificamente abrir o restaurante na Encosta de Feiyun para que eles pudessem competir cara a cara com o Quiosque Xinyue, que é o principal restaurante do estilo Yue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Só em um momento assim a Paimon é uma guia útil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#Não diga isso. Enfim, lá tem gastronomia boa. {NICKNAME}, vamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Você fica assim toda vez que falamos de comida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "Não pretendo me juntar aos Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "Oh, vocês vieram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100302,
					"content": "Então a promessa já está concluída. Já encontrei aquele que pode ajudar a resolver o mistério de porque a Qixing escondeu o corpo do Arconte Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100303,
					"content": "Então, onde ele está? Será no <color=#00E1FFFF>Pavilhão de Liuli</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Isso mesmo, venha comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100305,
					"content": "Como o costume de Liyue, eu preparei um jantar de negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Deixe-me apresentar. Este é o Senhor Zhongli, consultante de uma organização conhecida como Wangsheng, e um associado aos Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100502,
					"content": "Associado aos Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Em Liyue, a indústria de Wangsheng pode ser... Um pouco sensível às vezes. Digamos apenas que eles entendem quando é necessário discrição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100505,
					"content": "E nós, Fatui, gostamos de fazer negócios com os amigos que andam na sombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100506,
					"content": "Hum... Andam nas sombras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "#É uma honra conhecê-l{F#a}{M#o}. Tenho escutado rumores de você em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "Discrição... Sombra... Ah! Wangsheng tem a ver com os mortos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "Isso. Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "Ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "A Funerária de Wangsheng organiza os funerais, e se visa garantir que os mortos vão para céu em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "Haha! Pensaram que o Zhongli era o assassino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100514,
					"content": "O Fatuus tem muitos amigos assassinos, mas Funerária de Wangsheng não tem esse negócio... pelo menos ostensivamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100515,
					"content": "Ostensivamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "#Bom, eles ainda são... Não posso dizer mais... Olhe, eu {F#as}{M#os} trouxe para encontrar com o Senhor Zhongli porque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100517,
					"content": "Porque posso levar vocês a ver o corpo de Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "O quê?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "Oh, não comece. Embora o corpo do Arconte Geo tenha sido esquecido por ordem do Tianquan Ningguang... Bem, vamos ouvir o que o Sr. Zhongli tem a dizer, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100520,
					"content": "O Rex Lapis é o primeiro dos Adepti, mas no fundo é um Adeptus. Muitos Adepti já foram embora durante milênios, que já é uma tendência inabalável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "Porque a era já é diferente. Você deve já sentir essa mudança no Relevo de Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "Realmente, os Adepti estão indo embora de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "Como você já viu, a era dos Arcontes já foi, e a era dos seres humanos está a chegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Em anos passados, a tradição de Liyue era de que um enorme serviço fúnebre fosse realizado para marcar o falecimento de cada Adeptus. Mas desta vez, os Qixing não fizeram qualquer tentativa de respeitar essa tradição. É um sacrilégio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Bem, eles têm um deicídio para lidar com...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Sim, o verdadeiro assassino ainda não foi capturado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "Deicídio ou não, a preocupação da Funerária de Wangsheng é essa: Quando o ritual para receber a um deus é tão grandioso é ainda mais grave que sua última despedida seja feita sem a presença de ninguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "Viajante, Childe me falou muito sobre você. Desde que você teve relações com o Arconte Anemo, posso pedir que me ajude a preparar os últimos rituais do Arconte Geo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Eu preciso pensar melhor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#Bem... Se você realmente pensar sobre isso, {NICKNAME}, não temos outra escolha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Isso mesmo, por mais que pense, o resultado será o mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100539,
					"content": "Tianquan, Ningguang está impedindo todo mundo de ver o corpo do Rex Lapis. Então se quiser atingir o seu objetivo de encontrar todos os Sete, essa a única maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100540,
					"content": "É assim. Somente assistindo o Ritual de Ascensão será possível ver Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Parece que não há outra escolha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "Se estivermos de acordo, venha comigo. Falaremos dos detalhes enquanto caminhamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(E a tela escurece, e Zhongli saiu pela porta)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Bom. A minha missão como intermediário já está concluída. Que tal? Está bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100545,
					"content": "Você pode ir se quiser, não se preocupe comigo. Talvez eu tome mais algumas bebidas... E me familiarizar com essas coisas que eles chamam de \"pauzinhos\" nesse meio tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100534,
					"content": "Aceito o seu convite...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Uma sábia decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100536,
					"content": "O Childe fala demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "Oh? Em nossa linha de trabalho, isso significa que você quer me silenciar... Que interessante. Saque sua espada. Nós vamos-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100538,
					"content": "Brincadeira. Haha vamos voltar ao assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 10100523,
					"content": "O Arconte Geo também é um Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "O Arconte Geo tem muitos títulos. O Deus do Contrato, o Deus do Comércio, o Deus da Guerra, Morax, Rex Lapis... A ideia de que ele também tem o título de Adeptus é tão estranha assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "Funerária de Wangsheng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
