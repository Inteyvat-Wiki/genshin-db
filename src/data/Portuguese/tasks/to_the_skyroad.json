			"dialogs": [
				{
					"id": 751350101,
					"content": "Esse é o Altar? Parece difícil de alcançar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350102,
					"content": "#Nós podemos voar, mas e quanto a {REALNAME[ID(2)|SHOWHOST(true)]} e Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350103,
					"content": "Você esqueceu que sou uma aventureira do Clã das Plumas de Flores? Tenho bastante experiência em voar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350104,
					"content": "#Eu posso voar até lá com facilidade, mesmo levando {REALNAME[ID(2)|SHOWHOST(true)]} junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350105,
					"content": "Eu também tenho uma Licença de Planagem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "Isso serve. Paimon vai liderar o caminho, então apenas sigam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350107,
					"content": "Isso vai ser uma corrida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Este não é o momento para ser competitivo! Paimon vai liderar o caminho, então apenas sigam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350109,
					"content": "#Isso parece que pode ficar super perigoso, e não sabemos o que pode acontecer, então se segure firme, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350110,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
