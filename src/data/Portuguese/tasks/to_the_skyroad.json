			"dialogs": [
				{
					"id": 751350201,
					"content": "Ei, Bona, você tá voando muito rápido! Não conseguimos acompanhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Haha, desculpa. Eu não consegui evitar depois de ver o Altar do Fogo Original ali em frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "Tudo que temos que fazer é usar esse altar, e assim vamos poder ir para o Tonatiuh? Mas mesmo que uma corrente de vento enorme nos levasse pra lá, quanto tempo íamos ter que voar até chegar lá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Urgh, só de pensar Paimon já tá preocupada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "Não tenha medo, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "Bem, já que você tá dizendo. Mas não fique muito longe da Paimon, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Enfim, a gente vai oferecer Pyrofosforita para o Altar, né? Mas temos duas rochas, então... vamos colocar elas lá, só pra garantir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "Que emocionante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Certo? Paimon tá super animada. Nenhum aventureiro de verdade iria querer perder um desafio como esse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
