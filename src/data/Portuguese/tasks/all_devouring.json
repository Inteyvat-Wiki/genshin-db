					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Parece que é um beco sem saída. Chegamos no esconderijo dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "Ugh, essa névoa tá deixando impossível ver qualquer coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "Esse deve ser o lugar que você sofreu o ataque, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "A parte faltando da sua alma deve estar próxima. Consegue sentir onde está?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(Se eu fechar meus olhos e me concentrar na luz que veio da minha ferida daquela vez... Sim, consigo sentir uma coisa e tá perto. Mas não consigo dizer o local exato.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Nada exato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "Hmm. Nosso oponente deve ter coberto os próprios rastros para garantir. Caso contrário, você deveria ter sentido muito mais intensamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Espera, olha! Os espinhos voltaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Tenha calma. Vamos nos segurar um pouco, dar um pouco de espaço para nosso inimigo para vermos o que estamos enfrentando. Se formos imprudentes, podemos cair bem na armadilha dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "Nosso inimigo tomou parte da sua alma por um motivo — é provável que ele a integrou em seus ataques de alguma maneira. Talvez a gente consiga rastreá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "Mas sei que está perto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
