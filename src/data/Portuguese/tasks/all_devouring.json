			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Skirk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365001,
					"content": "Ele sabe algo sobre meu mestre, tenho certeza... Na próxima vez, preciso estar pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "Como tá o ombro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "Tudo bem. Foi só um arranhão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "Ainda vai demorar até eu recuperar minha força, claro, mas me adaptar a situações assim não é nada novo para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "Sua roupa parece diferente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "Ah, isso? É um \"Traje Cristelar\". Energia Abissal é escassa em Teyvat. Usar isso me ajuda a acessá-la mais livremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "Ele armazena energia Abissal concentrada que posso usar quando precisar. Quando a energia acaba, ela volta à sua forma original.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Vamos nessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "Ah, encontrou um lugar para descansar? Bem, vá na frente então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
		{
			"id": 1503651,
			"completionStepIds": [],
