			"dialogs": [
				{
					"id": 150360101,
					"content": "Espera... Isso é perto do Despenhadeiro, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360102,
					"content": "Sim. Se entrarmos daqui, poderemos chegar àquele lugar do seu sonho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360103,
					"content": "Você tem alguma experiência com domínios do Abismo agora, mesmo assim, esse é o território de outra pessoa. É melhor seguir com cautela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360104,
					"content": "Não se preocupa! Paimon é especialista em se esconder atrás dos outros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360105,
					"content": "#Ah, mas, hmm... Isso quer dizer que você tem que ficar em segurança, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360106,
					"content": "Vou sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "Muito bem. Lembre do seu treinamento. Hora de colocá-lo em prática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360107,
					"content": "Vamos dar uma lição naquele bandido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
