			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baizhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "Você parece muito melhor, Viajante. Devo assumir que seus problemas de saúde estão resolvidos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Hmm, seu caso foi complicado. Parece um pouco cedo demais para comemorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "É verdade, Changsheng. Mais tempo de observação é preciso, acredito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365104,
					"content": "Não tivemos muitos pacientes recentemente, então temos vários quartos livres. Fiquem à vontade para ficar alguns dias se precisarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365105,
					"content": "Maneiro! Obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
