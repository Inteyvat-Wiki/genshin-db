						110120902
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120902,
					"content": "Isso mesmo. Mas me dê um momento aqui, Teucer. Preciso ter certeza de que tudo está seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120903,
