						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "Você acha que está pronto para voltar para Snezhnaya agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Hehe... Não se preocupe, eu sei que não posso ter tudo do meu jeito o tempo inteiro. Isso só seria irritante para todo mundo.",
