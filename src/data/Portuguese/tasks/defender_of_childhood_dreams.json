			"dialogs": [
				{
					"id": 110121101,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121102,
					"content": "Childe? Então você estava aqui este tempo todo. Por que você está se escondendo? E por que você não veio se despedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "A despedida é muito importante. Estou muito fraco agora... Não posso deixar essa memória para Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121104,
					"content": "É mesmo uma pena que não possa me despedir de meu irmãozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121105,
					"content": "*Suspiro* Quem deveria proteger e levar ele até casa era eu. Apesar de ter alguém cuidando dele, eu não fico descansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121106,
					"content": "Você gosta muito dele, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Haha... Não sei explicar, mas me senti aliviado quando o deixei com vocês. E pensar que há pouco tempo, nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121108,
					"content": "Ah, sim, quase me esquecia. Não podia ter feito isso bem sem vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121109,
					"content": "Uau! No final das contas você tem um bom coração!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "E mais uma coisa: não se esqueça de nossa promessa. Vamos ter uma revanche quando tivermos uma nova oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121111,
					"content": "Desta vez, com minha honra de Mensageiro em jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121112,
					"content": "#Estou ansios{F#a}{M#o} por isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "É melhor você ir descansar um pouco primeiro! Depois não venha chorar para nós quando você perder tudo de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "#Hahaha... Independentemente de quem ganhar ou perder nosso próximo combate, eu também gostaria de convidá-l{M#o}{F#a} a vir até minha casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121116,
					"content": "#Vou apresentá-l{M#o}{F#a} aos meus outros irmãos, Tonia e Anthon. Eles são ótimos, e estou muito orgulhoso de ambos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121117,
					"content": "Aceitaremos essa sua oferta! Principalmente porque já fizemos uma promessa de dedinho com o Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Haha, tenho certeza de que ele também ficará muito entusiasmado em vê-lo. Bem, então está resolvido. Mal posso esperar, agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121119,
					"content": "Adeus, meus amigos - até nos encontrarmos novamente, em Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121113,
					"content": "Não perderei para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
