	"talks": [
		{
			"id": 1101201,
			"completionStepIds": [
				1101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101202",
							"2"
						],
						"stepId": 1101202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Chegamos, bem-vindos ao Instituto de Brinquedos de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120102,
					"content": "Chegamos! Chegamos! Eu estou escutando os sons dos robôs lá dentro, que legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "Que lugar é esse, e como você sabe sobre ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Baseado no pouco que sei, aqui deve ser o Instituto de Brinquedos do Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120105,
					"content": "O Dottore é um outro Mensageiro dos Fatui. O seu passatempo é montar e desmontar coisas... É uma paixão dele. Ele transformou essas ruínas em um laboratório para pesquisar os Guardas das Ruínas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120106,
					"content": "Eh? Então os Guardas das Ruínas são construídos por vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "Não, eles têm mais relação com o Abismo, falando mais estritamente, eles também são nossos inimigos... Nós estamos apenas realizando pesquisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120108,
					"content": "Quanto ao porquê de os Guardas das Ruínas estarem saindo daqui recentemente... Deve ser porque ele se cansou deles, perdeu o interesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120109,
					"content": "Que Mensageiro mau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Mas ao menos explica por que você não viu problemas em trazer Teucer para cá. Parece que fez sua tarefa de casa antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Bem... Eu não iria tão longe. Na verdade, não faço ideia de como é este lugar por dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120112,
					"content": "Então você não está preocupado com a segurança de seu irmão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "É claro que sou... Mas não importa qual seja o perigo, eu o impedirei. Não é isso que qualquer irmão mais velho faria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120114,
					"content": "Até mesmo o Teucer entende isso, agora ele sabe pelo que está lutando... A mesma razão que se apoderou de meu coração há tantos anos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120115,
					"content": "Sobre o que vocês estão conversando? Vamos lá, vamos entrar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Haha, tudo bem. Siga-me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Childe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "É muito bom que vocês me encontraram primeiro... Parece que usar a Transformação do Legado do Mal enquanto eu ainda estava ferido exigiu mais de mim do que eu imaginava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120202,
					"content": "Não tenho ideia do que eu faria se o Teucer me visse assim - olhe para mim, tão murcho quanto um balão estourado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120203,
					"content": "Não teme que eu te derrote?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "Haha! Se me lembro bem, você também tem irmãos, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120205,
					"content": "Eu imaginei que você provavelmente não me derrotaria na frente do meu irmãozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120206,
					"content": "Mas não pensei que você fizesse isso dessa forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Como disse... Não consigo passar uma oportunidade de testar meus limites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120209,
					"content": "É por isso que eu, Tartaglia, estou sempre ficando mais forte. Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120210,
					"content": "De qualquer forma, os sonhos da infância são quebrados com muita facilidade. Mesmo se você simplesmente os deixar em paz, eles cairão em mil pedaços sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120211,
					"content": "Então, alguém tem que protegê-los, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120212,
					"content": "Se você faz uma promessa, você a cumpre, se você comete um erro, você se desculpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120213,
					"content": "E se você dá a alguém um sonho, você o protege até o fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120214,
					"content": "É isso que significa uma família, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Aha... Por acaso, isso te fez lembrar de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120217,
					"content": "Cof, cof. Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120218,
					"content": "Pare com essa atuação de durão, agora mesmo! Você precisa ver um médico imediatamente, senhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "Realmente uma boa sugestão, mas primeiro... Tenho uma coisinha para o Teucer. Por favor, dê isso a ele em meu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120220,
					"content": "Hã, isso é... Um boneco de ação do Sr. Ciclope?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "De fato. Mandei fazê-lo sob medida em um ferreiro há algum tempo atrás. Eu tinha a intenção de entregá-lo no meu retorno a Snezhnaya, mas parece que, neste momento, ele serviria melhor como uma lembrança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120222,
					"content": "Uau... Agora que Paimon está pensando sobre isso, a família do Childe tem muita sorte em tê-lo, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Hah. Também vou precisar que você explique minha partida abrupta para o Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120224,
					"content": "Você vai me ajudar, não vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120225,
					"content": "\"Você faz uma promessa de dedinho, você a mantém por toda a vida...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
