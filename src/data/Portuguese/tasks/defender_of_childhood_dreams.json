				"points": []
			},
			"dialogs": [
				{
					"id": 110121001,
					"content": "Ufa, juntos finalmente. Você não está ferido, está, Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121002,
					"content": "Ferido? Não mesmo. Isso foi muito divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Divertido para você, talvez - todos nós estávamos completamente assustados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "O que tem ali... Uau, esta sala é enorme! É aqui que o Sr. Ciclope leva seus amigos quando eles vêm visitar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "É sim. Incrível, não é mesmo? Agora, que tal um pequeno joguinho de esconde-esconde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121006,
					"content": "Hã... Agora? Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Hehe... Eu tenho uma surpresa para você, sabia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121008,
					"content": "Uma surpresa!? Que tipo de surpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "Não se preocupe, você terá a chance de procurá-lo mais tarde. Mas antes disso, você tem que fechar seus olhos, dar meia volta e contar a partir do 60.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110121010,
					"content": "Está bom... Mas 60 é muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
