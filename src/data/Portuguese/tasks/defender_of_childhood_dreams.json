				{
					"id": 110120803,
					"content": "Sim, eu sabia que eles estavam mentindo, de qualquer forma. O Sr. Ciclope está aqui para derrotar os bandidos e proteger o mundo. Ele é meu brinquedo favorito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Certo. Com o Sr. Ciclope por perto, os bandidos nunca vão te pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120805,
					"content": "Hehe, isso mesmo! Certo, irei brincar com o Sr. Ciclope agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Ei, Teucer, espera aí...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Childe"
				},
				{
					"id": 110120807,
					"content": "A porta está fechada! Teucer vai ficar bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "Tem um outro caminho por aqui - vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Childe"
				}
			]
		},
		{
