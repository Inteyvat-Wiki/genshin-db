			"dialogs": [
				{
					"id": 240140601,
					"content": "Você me ajudou a colocar alevinos na água?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140602
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140602,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Muito obrigada. Quando eu consertar meu traje de mergulho, voltarei e continuarei meu trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "Espero que esses peixes cresçam bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "Não se preocupe, eu preparei muitas espécies de alevinos para todos os tipos de águas e ambientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "O lote que você colocou mais cedo foi escolhido especificamente para essa região.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "Eu colocarei mais alguns lotes, e então os aventureiros que contratamos virão e eliminarão os Mecapeixes na área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Acredito que este lote crescerá com saúde e vai restaurar o ambiente ecológico nesta área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Quando corpos de água suficientes forem recuperados, vou escrever uma reportagem longa. Eu direi ao público o que o Instituto de Pesquisas de Fontaine fez com nosso ambiente natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Só aguarde, Damzel. Eu não vou deixar você me impedir de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
		},
