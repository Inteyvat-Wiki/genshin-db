					"nextDialogs": [
						240140207
					]
				},
				{
					"id": 240140207,
					"content": "Espera, vocês conhecem Semaine? Vocês... Oh, foram vocês que ajudaram ele trazendo aqueles presentes? Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140208
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140208,
					"content": "Semaine só me falou sobre aquilo depois que terminei de assistir à ópera e voltei para casa. Sinceramente, eu estive querendo convidar vocês para uma refeição na minha casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140209
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140209,
