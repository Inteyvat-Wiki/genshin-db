			"dialogs": [
				{
					"id": 240140101,
					"content": "O número de peixes aqui diminuiu de novo. Os Mecapeixes estão agitados de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Preciso ir para águas mais profundas... Ugh, por que meu traje de mergulho tinha que me deixar na mão agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Olá. Prazer em te conhecer. Sou Linorea, uma jornalista especializada em reportar problemas ambientais. Estou... colocando alevinos nestas águas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Uma jornalista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "Isso mesmo, do tipo que você conhece. Mas eu não sou como aqueles que publicam fofoca sobre figuras públicas ou regurgitam notícias tediosas o dia todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Aquilo que me preocupa é um problema sério e em andamento que ameaça a segurança do público geral aqui na Corte de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "E é por isso que estou aqui colocando alevinos nestas águas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "Você sabe sobre os Mecapeixes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Não, não sei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Isso é uma espécie de peixe única de Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "E por que exatamente você está fazendo isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
