			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "Você viu isso? Aquele Hilichurl fugiu enquanto segurava algo que se parece com um livro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120502,
					"content": "Isso não é... Nada bom. Aquele era o meu caderno de rascunhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120503,
					"content": "Talvez ele sonhe em um dia se tornar um grande mestre artista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "Paimon acha que é apenas um típico ladrão de rua, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120506,
					"content": "E pensar que ele se atreveu a roubar meu caderno de rascunhos. Muito ousado, esse aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120507,
					"content": "Parece que o Albedo está com um temperamento gélido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120508,
					"content": "Vou te dar uma mão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "Talvez ele queira aprender alquimia também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
