					"nextDialogs": [
						412120303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120303,
					"content": "Bem, então você gostaria de dar um rápido passeio antes que eles apareçam, ou devemos esfriar nossos pés aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120304,
					"content": "Que tal um descanso e uma conversa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "Exatamente o que eu estava pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120309,
					"content": "Então, estamos tendo uma conversa agora? Paimon quer participar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120310,
					"content": "Eu sei que você deve ter perguntas, seja sobre mim ou sobre toda esta situação. Como disse antes, vou respondê-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120311,
					"content": "Mas não vou enganar você. Há algumas coisas que não posso revelar. Nelas, você terá que permitir meu silêncio, por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120312,
					"content": "Hum. Acho que o Albedo pode ser bastante direto quando quer ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120313,
					"content": "Mais sincero do que eu esperava, com certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120316,
					"content": "Errr... O quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "???"
				},
				{
					"id": 412120318,
					"content": "Você que está fazendo esses barulhos estranhos, Albedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "Você acha que isso é possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120322,
					"content": "Ah! É um Hilichurl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "Você que está fazendo esses barulhos estranhos, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "O que você acha? E por que você não está perguntando isso ao Albedo, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412120314,
					"content": "Mais despreocupado do que eu esperava, com certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "Isso é bom - eu tenho algumas perguntas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412120308,
					"content": "Muito bem. O que você gostaria de perguntar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
