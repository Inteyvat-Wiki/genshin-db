			"dialogs": [
				{
					"id": 741660501,
					"content": "Esse é o local da Trupe Tri-Coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660502,
					"content": "Hã? Essa foi toda a apresentação?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Você não conseguiu associar isso com nada? Onde existe uma trupe, existe drama! Onde há drama, há romance! E onde há romance, há amor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660504,
					"content": "Eles dizem que desde que você venha aqui e assista às apresentações todos os dias, você encontrará o verdadeiro amor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660505,
					"content": "Realmente existem boatos assim? Então, todos não estariam reunidos aqui todos os dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "Realmente, mas para isso se tornar realidade, você não pode ser um prisioneiro ou um guarda da Fortaleza Meropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660507,
					"content": "Então ninguém jamais vai encontrar seu verdadeiro amor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Talvez esse seja o maior problema. De qualquer forma, vamos para nosso próximo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pessoa Estranha"
				}
			]
		},
