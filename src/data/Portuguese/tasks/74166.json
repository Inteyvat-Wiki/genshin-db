			"dialogs": [
				{
					"id": 741660601,
					"content": "Esse é... o elevador para a área de produção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660602,
					"content": "Esse lugar não tem boatos estranhos também, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "Não, nada disso. É só que eu realmente odeio esse lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660604,
					"content": "Oh? E por qual motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Pois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660606,
					"content": "Pois...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Pois eu não quero trabalhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660608,
					"content": "Só estou aqui por que eu não queria trabalhar, então roubei pão para me alimentar, pois eu estava faminto, e por conta disso, fui sentenciado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660609,
					"content": "Então, por que você precisa trabalhar na Fortaleza Meropide!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660610,
					"content": "\"Qualquer mínimo trabalho acaba comigo!\" É o meu lema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Pessoa Estranha"
				},
