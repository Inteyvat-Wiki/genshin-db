			"dialogs": [
				{
					"id": 741660401,
					"content": "Esse é o Refeitório Coupon, e cada pessoa pode pegar uma Refeição Social por dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660402,
					"content": "O único problema é que, o que você come, depende totalmente do destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660403,
					"content": "Hmm, é só isso? Isso é o tipo de coisa que todo mundo aprende no primeiro dia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Se acalme, se acalme, também tenho algumas informações secretas. Existe um código secreto que você pode dizer ao Bran quando for pegar sua Refeição Social, que permitirá que você receba a misteriosa e lendária refeição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660405,
					"content": "Ah, sério? Qual código?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Infelizmente, eu não sei. Quanto a isso, eu espero pelo dia que vocês explorem por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660407,
					"content": "Ei, essa é a fala da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Não se preocupem com detalhes tão triviais! Nossa próxima parada, a Trupe Tri-Coupon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pessoa Estranha"
				}
			]
		},
