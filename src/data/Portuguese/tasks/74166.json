			"dialogs": [
				{
					"id": 741660301,
					"content": "E então? Chegaram a uma decisão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660302,
					"content": "Você mesmo disse, deve ser totalmente grátis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "É claro, é claro, será totalmente \"de graça\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660304,
					"content": "Venha, venha, venha, agora eu irei te mostrar tudo sobre a Fortaleza Meropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pessoa Estranha"
