			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "Com licença, jovem, por aqui, sim, sim, você! Você aí, venha, venha aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660202,
					"content": "Hã? Você está falando com a gente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "#Oh, {M#meus amigos}{F#minhas amigas}, eu imediatamente percebi que vocês são nov{M#o}{F#a}s aqui. Vocês ainda não devem estar familiarizad{M#o}{F#a}s com a Fortaleza Meropide, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660204,
					"content": "Parabéns por se depararem comigo hoje! Eu sou o residente mais legal de toda Fortaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660205,
					"content": "Hoje, permita-me te ajudar a se familiarizar com a Fortaleza. É claro, será tudo \"de graça\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660206,
					"content": "Na verdade, eu já conheço o lugar muito bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Oh, não diga isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660208,
					"content": "#Talvez você acha que já esteja situad{M#o}{F#a}, mas com minhas instruções, acredito que você descobrirá todos os tipos de coisas que nunca percebeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660209,
					"content": "Existe mesmo algo como um almoço grátis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Claro, claro! É como eu disse, sou o residente mais gentil de toda Fortaleza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660211,
					"content": "Errr, esse sujeito é meio estranho. Acabamos de nos conhecer e ele já ta todo amiguinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "#Haha, não é nada, {M#meu amigo}{F#minha amiga}! Que tal assim, vocês conversem entre si, e eu esperarei aqui para ouvir sua decisão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660213,
					"content": "Quando tiverem feito sua escolha, venham falar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pessoa Estranha"
				}
			]
		},
