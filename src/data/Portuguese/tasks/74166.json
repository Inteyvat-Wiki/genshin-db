			"dialogs": [
				{
					"id": 741660701,
					"content": "#Certo, amig{M#o}{F#a}s! Finalmente estamos na minha instalação favorita: O Ringue de Pancrácio! Esse lugar é o nosso paraíso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660702,
					"content": "Esse lugar... é realmente tão bom assim? Parece bem diferente do que Paimon ouviu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Claro, mas não escute esses boatos por aí. É apenas uma imagem que colocaram para enganar os olhos e ouvidos dos outros. Venha, venha, venha, eu tenho um formulário de consentimento bem aqui, se você puder apenas, assiná-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660704,
					"content": "Ei! É você de novo! Enganando as pessoas fazendo elas assinarem formulários de consentimento para se registrarem na competição de novo! Você não vai fugir dessa vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Guarda"
				},
				{
					"id": 741660705,
					"content": "#Vocês {M#dois}{F#duas} são bem sortud{M#o}{F#a}s que percebi antes que assinassem o formulário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Guarda"
				},
				{
					"id": 741660706,
					"content": "De qualquer forma, ignorem esse trapaceiro. Ele e a organização por trás dele são especializados em enganar as pessoas a participarem de competições perigosas e lucram com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Guarda"
				},
				{
					"id": 741660707,
					"content": "#Não invente essas coisas! Eu não enganei ninguém! El{M#e}{F#a}s são {M#meus amigos}{F#minhas amigas} e estão se registrando por vontade própria depois que eu recomendei, como um amigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Pessoa Estranha"
				},
				{
					"id": 741660708,
					"content": "Sim, tenho certeza disso. Conheço um lugar melhor para você falar suas asneiras. Comigo, agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Guarda"
				},
				{
					"id": 741660709,
					"content": "A pessoa estranha foi escoltada pela guarda...",
