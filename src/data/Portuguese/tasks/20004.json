			},
			"dialogs": [
				{
					"id": 200040701,
					"content": "Obrigado, isso é o suficiente. Vou levar para o carpinteiro... Certo, tenho que ir cobrar os aluguéis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040702,
					"content": "Me pergunto se aquela astro... astrolo... astrolo não sei quê... Aquela tal de Mona... estará em casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040703,
					"content": "Se diz Astrologist Mona Megistus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "Isso mesmo! Ai... Nunca consigo me lembrar desse nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040705,
					"content": "Hm? Mona ainda não pagou o aluguel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040706,
					"content": "O que você acha? Todos os outros inquilinos já pagaram seu aluguel, só falta ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040707
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040707,
					"content": "Procurei por ela muitas vezes, mas ela nunca está em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040708
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040708,
					"content": "Viajante, poderia me ajudar a ir a sua casa para pegar o aluguel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
