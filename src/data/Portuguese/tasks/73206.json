					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪Ó, rosa bela rosa, a meu desejo realizar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Hã? Ainda estão por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Por que você mora aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Haha, eu sou só um velhote estranho, e velhotes estranhos fazem coisas sem sentido. Poucas pessoas me fazem perguntas como as que você me fez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Eu... Nessa vida, sempre tive vontade de sair vagando, por aí, querendo aproveitar a oportunidade de fazer alguma coisa com minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Pouco depois de casado, por pouco não debandei com os Eremitas. Mas, pensei melhor, e não podia simplesmente sair e deixar a minha esposa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Depois conheci um comerciante itinerante. Tive vontade de acompanhá-los em suas viagens de negócios. Ao fim, como não tinha um tostão no bolso, não me atrevi a prosseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "E no final, minha mulher faleceu. Apesar de não precisar mais me dedicar do nosso relacionamento, eu já estava velho demais para partir para outro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "Até hoje, empurro muitas coisas com a barriga, também cometi erros demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Refletindo, descobri que não pertenço nem a essa vila, nem a outros lugares.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "No final das contas, me mudei, sozinho, para a margem da vila, assim minha vida é mais confortável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "E assim as décadas voaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Assim que essas flores desabrocharem, eu chamarei vocês para ver. Amanhã, ou depois de amanhã, pode ser que abram. Vocês têm um tempinho para vir vê-las, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Ok, ok, Paimon sabe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪Ó, rosa bela rosa, a meu desejo realizar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Sobre o Velho Fantasma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Apenas as pessoas de fora da vila se atentam, desse jeito, às suas histórias. Por aqui, até as crianças conhecem esse nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "As crianças levadas ouvem de seus pais: \"O Velho Fantasma vai vir te pegar!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Esses jovens, ah, claro que nenhum deles conhece o Velho Fantasma. O seu nome é apenas usado para meter medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Nos meus tempos de criança, eu vi o Velho Fantasma, em pessoa. É fato que ele não gostava de crianças, mas não tinha aparência aterrorizante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Não sei como lhe botaram esse apelido, \"Velho Fantasma\". Devem ter sido um bando de desocupados que falavam bobagens pela suas costas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Vocês não eram amigos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Quando eu era pequeno, ia brincar em seu jardinzinho. Assim que ele descobria, me expulsava de lá com sua enxada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Ele provavelmente me achava uma criança levada procurando confusão. Por que lembraria de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Apesar de não estar certo se ele sabia, ou não, quem eu era, sigo com as memórias dele e de seu jardim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Se eu disser que ele é meu amigo, também não está errado, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Eu quero cultivar as mesmas flores, apenas para recriar aquele pequeno jardim em minha memória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
