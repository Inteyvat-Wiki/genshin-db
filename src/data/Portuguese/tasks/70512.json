			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120701,
					"content": "A luta acabou. Diluc acabou com eles... Acho que algumas coisas nunca mudam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120702,
					"content": "Mas há algum perigo real aqui? Parece que isso são apenas ilusões do passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120703,
						705120704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120703,
					"content": "Diluc deve ter passado aqui antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				},
				{
					"id": 705120705,
					"content": "Então isso quer dizer que Diluc já terminou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120706,
					"content": "Se formos até aquela concentração das Linhas Ley, mais monstros aparecerão? E quanto ao jovem Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120707,
					"content": "Se for como as outras concentrações de Linhas Ley que vimos antes, ele deveria ter desaparecido já que derrotou todos os monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120708,
						705120709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120708,
					"content": "Você está curiosa sobre o jovem Diluc?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120710,
					"content": "Não, não, hehe, Paimon só está um pouco preocupada, é isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120711,
					"content": "Imagina se alguém passando aqui fica curioso, se aproxima para checar e do nada \"Aaah!\", um monstro aparece e o golpeia na cabeça com um \"Bonc!\"? Isso seria terrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120712,
					"content": "... Os efeitos sonoros eram necessários?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120713
					]
				},
				{
					"id": 705120713,
					"content": "Assim soa mais perigoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120714,
					"content": "De qualquer forma, viemos aqui para ajudar o Diluc, não foi? Vamos ficar mais um pouco para garantir que este lugar esteja completamente seguro antes de voltarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120715,
					"content": "Você está muito responsável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120716
					]
				},
				{
					"id": 705120716,
					"content": "Hehe... Não, não. Paimon só quer o suco de uva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120717,
					"content": "#Vamos, {NICKNAME}, é hora de terminar o que viemos fazer. Quando conseguirmos o suco de uva, poderá tomar um pouco da metade de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120709,
					"content": "Ou você do nada tem interesse em desordens das Linhas Ley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120710
					]
				},
				{
					"id": 705120704,
					"content": "No máximo, devem haver alguns resquícios sobrando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120705
					]
				}
			]
		},
