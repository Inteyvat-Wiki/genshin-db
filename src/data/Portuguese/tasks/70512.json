			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "#Bom dia! Há quanto tempo! Vocês parecem estar bem animad{F#as}{M#os}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120202,
					"content": "Olá, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120203,
					"content": "Estou honrada em receber vocês aqui. Têm assuntos importantes para discutirem com o mestre Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120204,
					"content": "Só queríamos suco de uva...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "Isso mesmo. Adelinde, já que cruzamos com você, não poderia nos ajudar com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120207,
					"content": "Nós sempre perdemos a promoção de suco da Adega, por isso desta vez decidimos vir antecipadamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120208,
					"content": "Você pode reservar uma garrafa para nós? Pagaremos adiantado, só precisa dizer o preço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120209,
					"content": "Claro que sim, e não precisam pagar nada adiantado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120210,
					"content": "Mas vocês terão que esperar bastante. O suco de uva com desconto da Adega do Alvorecer toma muito tempo para ser feito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120211,
					"content": "Todo verão, o mestre Diluc seleciona pessoalmente dois barris das melhores uvas para transformá-las em suco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120212,
					"content": "O quê? Mas por que vender os melhores produtos com um preço baixo? As melhores uvas não deveriam ser as mais caras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120213,
					"content": "O mestre nunca explicou sua lógica. Se eu tivesse que adivinhar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120214,
					"content": "A promoção pode ser uma estratégia de marketing. Promoções sempre tendem a atrair clientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120215,
					"content": "Talvez o mestre queira popularizar o suco com as promoções, assim as pessoas terão mais opções para escolher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120216,
					"content": "É a alternativa ideal para aqueles que costumam beber além da conta, pois não ficarão bêbados e começarão a criar problemas. Ao mesmo tempo, aqueles que não bebem álcool possuem a chance de provarem algo novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120217,
					"content": "Mas isso não afetaria o negócio da Adega?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "Nem tudo se trata de dinheiro para o mestre Diluc. Eu acho que ele prefere ver as pessoas bebendo moderadamente do que fazer lucro a qualquer custo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120220,
					"content": "Imaginem se todos pudessem apreciar uma taça de vinho e se divertirem sem criar problemas... Isso não seria ótimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120221,
					"content": "Uau, o mestre Diluc parece ter um coração enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120222,
					"content": "Então, Diluc está selecionando as uvas deste ano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120223,
					"content": "Ainda não. Ele tem que resolver algumas coisas primeiro. Ele começará assim que terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120224,
					"content": "#Se vocês estiverem interessad{M#os}{F#as}, tenho certeza que o mestre Diluc ficaria muito feliz em lhes ver e ouvir suas opiniões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120225,
					"content": "Que problemas ele tem que resolver?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "Como vocês sabem, quando o mestre Diluc descobre sobre algum visitante que não é bem-vindo em Mondstadt, ele decide, hã... \"cumprimentá-lo\" pessoalmente. Hoje é a mesma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120227,
					"content": "Ele deve estar em algum lugar perto da Costa do Falcão. Mas eu não faço ideia quanto tempo ficará lá... Por que vocês não entram e sentam enquanto esperam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120228,
					"content": "Eu tenho que ficar aqui e esperar por outros convidados, mas Hillie e Moco cuidarão bem de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120229,
					"content": "Visitantes que não são bem-vindos? O que você quer dizer com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120230,
					"content": "Acho que tem algo a ver com o trabalho de meio-expediente de Diluc...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "Hã? Você está falando do...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120232,
					"content": "Hã... Oh, a Ordem do Abismo está aprontando de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120233,
					"content": "#Nesse caso, o mestre Diluc é nosso amigo, não podemos ficar aqui parad{F#as}{M#os} sem fazer nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120238,
					"content": "Se vocês querem ajudar, será ótimo. Afinal, o mestre confia em vocês, e vocês também são bem capazes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120239,
					"content": "Tenho certeza que ele apreciará a ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 705120240,
					"content": "Não é nada demais! Quanto mais rápido Diluc estiver livre, mais cedo poderemos provar esse delicioso suco de uva, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120241,
					"content": "#Venha, {NICKNAME}, vamos para a Costa do Falcão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120234,
					"content": "Certo, vamos esperar lá dentro até o Diluc chegar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "#Hmm... Mas Paimon vai se sentir mal se ficarmos parad{F#as}{M#os} na casa de Diluc enquanto ele está se encarregando de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120236,
					"content": "É melhor darmos uma olhada na Costa do Falcão e ajudar o Diluc a resolver os problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120237,
					"content": "Apesar de Diluc ser super forte, ele gostaria do apoio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120218,
					"content": "Não parece como o investimento mais lucrativo por aí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "Não é tão importante assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "Parece que essa tenda daqui não é do Diluc. Talvez seja o acampamento de um aventureiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120402,
					"content": "Oh, tem uma folha de papel e um caderno ali. Vamos dar uma lida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120403,
					"content": "\"Caro Herói Obscuro, estamos passando pelo mesmo fenômeno de muitos anos atrás.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120404,
					"content": "\"Apesar de você ter resolvido o problema da última vez, as Linhas Ley parecem ter sido estimuladas de alguma forma, e estão deixando escapar monstros que registraram no passado de novo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120405,
					"content": "\"Tenho certeza que você quererá lidar com o que é uma ameaça imediatamente.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120406,
					"content": "\"Por isso, estou notificando indivíduos essenciais, de acordo com os procedimentos de operação.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "Investigar"
				},
				{
					"id": 705120407,
					"content": "Hmm... Ao julgar pelo tom, parece que isso foi escrito por alguém que o Diluc conhece bem. Vamos chamá-lo de \"amigo do Diluc\" por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120408,
					"content": "Ele viu algo ruim acontecer, escreveu essa nota para o mestre Diluc e então partiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120409,
					"content": "Que irresponsabilidade! E se alguém mais tivesse visto? Além disso, deixou seu caderno para trás...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120410,
					"content": "Agora que Paimon pensa melhor... Sabe aquela concentração estranha de Linhas Ley na praia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120411,
					"content": "Aposto que esse deve ser o \"fenômeno\" estranho que ele estava falando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "Fora isso, tudo aqui parece normal... Não há um monstro sequer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, você quer ler as notas do amigo do Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120414,
					"content": "Se não, vamos ir dar uma olhada na concentração das Linhas Ley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7051205,
			"completionStepIds": [
				7051205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051205",
							"2"
						],
						"stepId": 7051205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "Uau! De onde todos esses monstros saíram?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120502,
					"content": "Espera... É o Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120503,
					"content": "Algo está diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120504,
					"content": "Olha só para ele! Está tão focado e cheio de energia! Então esse é o Capitão Pyro em ação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120505,
					"content": "Deve ser o Diluc que lutou aqui no passado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "Ei, você tem razão! Agora que Paimon está vendo melhor, esse Diluc parece mais novo que o normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120508,
					"content": "Mas o que aconteceu? Por que ele estava lutando aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120509,
					"content": "Hmm, acho que podemos perguntar para ele na próxima vez que o virmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120510,
					"content": "#{NICKNAME}, o que vamos fazer agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120511,
					"content": "Não podemos agir precipitadamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "Certo, vamos ver como o jovem Diluc lutava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705120512,
					"content": "Vamos observar primeiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "As Linhas Ley estão mostrando a cena que registraram na época.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
		{
			"id": 7051207,
			"completionStepIds": [
				7051207
			],
