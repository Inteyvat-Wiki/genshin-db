					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Não é tão fácil, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "Nosso capitão ficaria furioso se ficassem sabendo que membros do esquadrão voador podem ser superados por qualquer aventureiro de passagem. Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "#Tudo bem, não precisa ficar chatead{M#o}{F#a}. Eu deveria era te agradecer por manter meu orgulho intacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "Você voou bem, mas ainda é muito cedo para você me superar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "Se você acha que consegue fazer melhor, por que não tenta de novo? Você jamais deve parar de tentar enquanto ainda é jovem. Perder nem é grandes coisas mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
