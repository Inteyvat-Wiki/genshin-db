			"dialogs": [
				{
					"id": 3720101,
					"content": "Ah, vocês são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "Rapaz de Verde"
				},
				{
					"id": 3720102,
					"content": "Oh, isso mesmo! Vocês são aqueles que assustaram Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "Rapaz de Verde"
				},
				{
					"id": 3720103,
					"content": "Dvalin? Quem é esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720104,
					"content": "O verdadeiro nome do Stormterror.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "Hum? Ah, sim. A maioria das pessoas o chamam de \"Stormterror\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720107,
					"content": "Por que você chama ele assim? Vocês se conhecem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720108,
					"content": "Adivinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "Rapaz de Verde"
				},
				{
					"id": 3720109,
					"content": "#Ei, {NICKNAME}, eu acho esse cara um pouco estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720110,
					"content": "Desculpe incomodar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "Bom dia, forasteiro. Nós já nos encontramos antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "Rapaz de Verde"
				},
				{
					"id": 3720113,
					"content": "Eu sou Venti, o Bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720114,
					"content": "Tricampeão do Bardo Mais Popular de Mondstadt, para ser mais preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720115,
					"content": "O que vocês precisam de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720116,
					"content": "Já que você nos reconheceu, Paimon acha que não precisamos dar mais explicações, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720117,
					"content": "É sobre o Stormterror, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720118,
					"content": "Hum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720119,
					"content": "Não finja que perdeu a memória!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}, você poderia mostrar a ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720121,
					"content": "Oh! Isso é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720122,
					"content": "O quê? O cristal foi purificado? Desde quando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720123,
					"content": "Não tenho certeza de quando isso aconteceu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "Dvalin, ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720126,
					"content": "É uma lágrima de sofrimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720127,
					"content": "Lágrimas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720124,
					"content": "A última vez que o vi, estava cheio de impurezas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "Desculpe, mas quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "Lisa nos disse já, você não estava ouvindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
