			"dialogs": [
				{
					"id": 3720501,
					"content": "Quêêêêê!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720502,
					"content": "Você... Realmente tem umas habilidades incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720503,
					"content": "Uma pessoa como você vai acabar aparecendo em algum poema de um bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720504,
					"content": "#{M#Um herói} {F#Uma heroína} deve estar do lado da luz, porque se estiver do lado escuro, o desastre será de grande magnitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720505,
					"content": "Ah... Eu realmente não tenho tempo para compor uma melodia para você neste momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720506,
					"content": "Mesmo se Dvalin não for derrotado, sua vida irá desaparecer na brisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720508,
					"content": "Eu também sinto compaixão por Dvalin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "Posso ajudar de alguma maneira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "Como um cavaleiro, eu sugiro que você se entregue juntamente com o dragão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "Ele vai queimar de fúria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720509,
					"content": "Obrigado, e também agradeço por purificar o Cristal da Lágrima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720510,
					"content": "Agora é a minha vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720512,
					"content": "Você já ajudou muito purificando o Cristal de Lágrima. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720513,
					"content": "Mas agora, eu já tenho os meus próprios planos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720515,
					"content": "Uau, precisa mesmo falar assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720516,
					"content": "Não tenho interesse em me entregar agora... Tenho outros planos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720517,
					"content": "Hum? E qual é o plano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720518,
					"content": "Ao ver esta lágrima, me trouxe uma recordação de um velho amigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720519,
					"content": "Amigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720520,
					"content": "Hehe, eu tenho que ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720521,
					"content": "Ei! Aonde você vai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720522,
					"content": "Para a \"Um Símbolo do Herói de Mondstadt\". Tchau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720524,
					"content": "É um sujeito estranho, temos que ficar de olho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#Hum... {NICKNAME}, o que você acha que devíamos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720526,
					"content": "Sabe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "Para ele, você também é um sujeito estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720528,
					"content": "Sua voz me parece familiar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "Sabe, o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "Paimon"
				}
			]
		}
