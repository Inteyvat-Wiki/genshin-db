			"dialogs": [
				{
					"id": 750280101,
					"content": "Ugh, você é... mais durão do que parece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Rato"
				},
				{
					"id": 750280102,
					"content": "Argh. Quem a gente ofendeu, quem enviaria alguém neste dia de todos os dias para nos dar uma surra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Coruja Noturna"
				},
				{
					"id": 750280103,
					"content": "#Por favor, {M#maninho}{F#maninha}. Como a gente te ofendeu? Só... diga pra gente. Não vamos fazer de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Coruja Noturna"
				},
				{
					"id": 750280104,
					"content": "Ei, seu pestinha! Você vai mesmo se rastejar assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Rato"
				},
				{
					"id": 750280105,
					"content": "O quê, fingir ser durão vai botar comida na nossa mesa? Ah, não comece, já entendi. Só estamos vivendo como ladrões e bandidos. Não tem nada especial em traficar Saurianos, tem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Coruja Noturna"
				},
				{
					"id": 750280106,
					"content": "É melhor do que ser roubado por um bandido mais forte, por que eu não deveria ir com eles, ao invés disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Coruja Noturna"
				},
				{
					"id": 750280107,
					"content": "#Agora, sem querer me gabar, {M#maninho}{F#maninha}, mas tenho certeza que tem um jeito de eu ser mais útil do que esses dois aí. Vou resolver, bem direitinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Coruja Noturna"
				},
				{
					"id": 750280108,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Bem, por acaso estou procurando um ajudante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Tá falando sério?! Sem chance! Paimon veta isso aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "Além disso, somos gente do bem. Sem chance da gente se unir a traficantes de Sauriano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "É, não tem gente mais do bem do que eu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Ahem! Enfim, independentemente do plano que vocês têm para os Saurianos, melhor parar agora, ou vamos... Bem, {NICKNAME} vai acabar com a raça de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "Os dois traficantes saem com uma nuvem de ressentimento pairando sobre as próprias cabeças...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Paimon queria saber como aquele Qucussauro tá. Vamos ver ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Bem, sempre tem espaço para mais um.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Ei, você vai ser uma influência ruim para {REALNAME[ID(2)|SHOWHOST(true)]}! Não se preocupe, carinha, não tem como a gente se unir com uma cambada dessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Rawr... Rawrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Agradeço a consideração, mas não precisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
