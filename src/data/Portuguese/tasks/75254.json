			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Oh? Você quer saber sobre meus olhos? Hehe, bem, há três coisas que qualquer homem treina bem em sua vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Primeiro! Um corpo experiente deve carregar pelo menos uma cicatriz. Caso contrário, não tem como dizer quais provações e testes o homem enfrentou, e sua vida em si seria menos significativa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "Segundo! Cicatrizes devem ser cobertas com roupas ou acessórios, mas apenas parcialmente... Caso contrário, ninguém saberia que esse homem é especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "E terceiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Espera um segundo. Eu nunca nem perguntei sobre seus olhos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Exatamente! Se outros não perceberem como ele é especial, o homem deve FAZÊ-LOS perceber mencionando o assunto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
