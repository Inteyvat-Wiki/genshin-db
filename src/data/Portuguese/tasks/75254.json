					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "Onde foi que vimos isso antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "#{M#Meu amigo}{F#Minha amiga}, essa é a marca do destino para pessoas extraordinárias. Nosso primeiro encontro parece uma reunião de vidas diferentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Ao ver o meu tapa-olho, você deve ter percebido que eu também sou extraordinário, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
