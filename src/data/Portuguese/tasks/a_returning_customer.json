			"dialogs": [
				{
					"id": 207010101,
					"content": "Como que eu já estou com fome de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010102,
					"content": "Oh, é você! Maravilha. Você ainda se lembra de mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010103,
					"content": "Do duelo de cozinha, com Xiangling? Fui eu, Siegfria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010104,
					"content": "Hehe, você se lembra agora? De qualquer forma, você veio num bom momento. Eu poderia... Pedir sua ajuda com algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010105,
					"content": "Do que você precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "Você ainda lembra daquelas Porções de Jade que você me fez da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010107,
					"content": "Estava tão gostoso, eu consigo sentir o gosto até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010108,
					"content": "Então eu queria tentar fazer por mim mesma, mas... Sempre falha, como se estivesse alguma coisa faltando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010109,
					"content": "Eu sinto que se eu pudesse tentar mais algumas vezes, eu consigo recriar aquele sabor também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010110,
					"content": "Então, eu poderia te pedir para me fazer algumas Porções de Jade para experimentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
