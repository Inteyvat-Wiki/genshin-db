			},
			"dialogs": [
				{
					"id": 750110201,
					"content": "Ufa, esse deve ser o último mecanismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110202,
					"content": "Esse não é diferente dos outros. Chicoa, tem certeza que você não caiu em algum tipo de truque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110203,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "É claro que não! Quando se trata de decifrar pergaminhos antigos, eu tenho total confiança... alguma confiança... bem, um certo grau de confiança em minhas habilidades!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110205,
					"content": "Sua confiança está diminuindo por segundo! Arg, socorro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110206,
					"content": "Enfim, tenho certeza que esse não é o último mecanismo. Se me lembro bem, deveria ser maior e... mais completo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110207,
					"content": "\"Ilhas flutuantes\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "Jovem, independentemente do grande potencial que você demonstrou, ninguém vai te entender se você não falar frases completas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110209,
					"content": "...Quanto a se o tesouro é real, e se o elixir realmente existe... Bem, você só saberá quando tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110210,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "Se não funcionar dessa vez, funcionará na próxima; e se não for aqui, então em outro lugar. Desde que você continue tentando, um milagre acontecerá em algum momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110212,
					"content": "Seu otimismo é realmente inacreditável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "Levarei isso como um elogio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110216,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Hehe, viu, {REALNAME[ID(2)|SHOWHOST(true)]} também está bem animado. Vamos então, {NICKNAME}, use o Flogisto para ativar o mecanismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chicoa"
				},
				{
					"id": 750110214,
					"content": "Se conseguirmos nos motivar para continuar tentando, isso em si será um milagre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "Não queremos nada dessa negatividade por aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chicoa"
				}
			]
		},
