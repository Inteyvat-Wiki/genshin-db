			"dialogs": [
				{
					"id": 100100101,
					"content": "Hmm... Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100102,
					"content": "Olá, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100103,
					"content": "#{M#Sr.}{F#Srta.} {M#Cavaleiro}{F#Cavaleira} Honorável! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100104,
					"content": "Dodoco precisa de ajuda! Mamãe disse que vocês estavam vindo, mas eu não sabia que ia ser tão rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100105,
					"content": "Dodoco... precisa de ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100106,
					"content": "Ah, pelos Arcontes... Isso é uma tarefa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100107,
					"content": "O quê? Não, é por Klee! E por Dodoco também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100108,
					"content": "Não, Paimon sabe disso. Paimon só tava perguntando sobre a tarefa. Você sabe o que isso é, né? É tipo uma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100109,
					"content": "Uma tarefa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100111,
					"content": "#...Obrigada, Cavaleir{M#o}{F#a} Honorável de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100112,
					"content": "Enfim, hmm... Uma tarefa é... Argh, por que é tão difícil descrever?! É tipo... ajudar Dodoco! É! Isso é uma tarefa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100119,
					"content": "Ah! Obrigada, Paimon. Isso faz um pouco mais de sentido, mas não muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100120,
					"content": "Enfim, vamos ajudar Dodoco agora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100121,
					"content": "Espera. Que tipo de ajuda Dodoco precisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100122,
					"content": "Ah, certo. Bem, toda Dodoco tem que achar um trevo-de-quatro-folhas vermelho para virar uma Dodoco super especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100123,
					"content": "Então, Dodoco precisa virar amiga de um montão de gente e terminar o julgamento do Rei-Dodo. Quando isso terminar, ela vai virar uma super incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100124,
					"content": "Dodo-Maga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100125,
					"content": "...Foi isso que mamãe disse, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100126,
					"content": "Hmm, Rei-Dodo encarregado de uma Dodo-Maga... Faz sentido, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100127,
					"content": "Hmm, mas especificamente, o que a gente precisa fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100128,
					"content": "Klee não faz ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100129,
					"content": "Mas mamãe disse que vocês iam me dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100130,
					"content": "C-Certo... Bem, vamos dar uma olhada nesse livro então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100131,
					"content": "Ah! Tem um bilhete dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100132,
					"content": "Hmm, vamos ver o que diz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100133,
					"content": "...Na primeira fase do julgamento, Dodoco chegou na floresta de folhas sussurrantes. Lá, após camadas e camadas de obstáculos, um segredo estava enterrado, aguardando ser descoberto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100134,
					"content": "Parece uma parte de uma história sobre Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100135,
					"content": "Ah, Klee sabe onde fica essa floresta! É onde eu vou explodir— Ahem, onde Klee vai brincar bem muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100136,
					"content": "Vamos, pessoal! Me sigam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100137,
					"content": "Tudo bem, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100113,
					"content": "É uma coisa que precisa ser feita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "Isso, algo que precisa ser feito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100115,
					"content": "Ah! Então, tipo... a minha Pesca Explosiva com Bomba Saltitante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100116,
					"content": "Não, não! Uma \"tarefa\" não é só uma coisa que você quer fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100117,
					"content": "Klee tá confusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100118,
					"content": "*Suspiro* É tipo... Quando sua mãe diz pra você fazer alguma coisa! Isso é uma \"tarefa\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
