				},
				{
					"id": 100100805,
					"content": "Ah, é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100806
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100806,
					"content": "Um chapéuzinho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100807,
					"content": "Um chapéu para Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "No Clã Dodo, só os Dodocos mais incríveis e extraordinários de todos podem receber o reconhecimento do Rei-Dodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "O trabalho deles é ajudar e proteger todos os outros Dodocos, então o Rei-Dodo dá um chapéu especial para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "Assim, os outros Dodocos os reconhecem e sabem a quem recorrer quando precisarem de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100811,
					"content": "Ah! Então agora o seu Dodoco é um desses Dodocos especiais com chapéu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100812,
					"content": "Exatamente! O chapéu faz da Dodoco uma Dodo-Maga agora! Ela pode usar uma magia de faíscas especial pra ajudar ainda mais pessoas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100813,
					"content": "Klee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100814,
					"content": "Os Cavaleiros me informaram sobre explosões sendo ouvidas na floresta fora da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#Ahm, {M#Sr.}{F#Srta.} Cavaleir{F#a}{M#o} Honorável, Paimon... Uma ajudinha, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "Ah, é que a gente acabou com um acampamento de Hilichurls lá, e também com um monte de Slimes. Além disso, estávamos trabalhando na tarefa da Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100817,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "E quanto a esses peixes aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "E-Eu... pode ser que eu tenha explodido eles. Mas é por causa dos monstros no lago! Eu não fiz de propósito! Não é como nas outras vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "Entendi. Então quer dizer que das outras vezes foi de propósito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100821,
					"content": "Hããã... n-não foram d-de propósito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100822,
					"content": "*Suspiro*... Eu vi o acampamento destruído no caminho para cá, e vi os monstros fugindo do Lago Estelar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100823,
					"content": "#Se estou certa, esse deve ter sido todo o estrago. Não é, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100824,
					"content": "O resto foi tudo culpa da Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "...Isso aí! Você conhece a Paimon, derrotando todos aqueles monstros com um só soco! Ela é simplesmente incrível assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100827,
					"content": "Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100828,
					"content": "Venha comigo, vamos voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100829,
					"content": "Ahhh, Klee vai ficar em confinamento solitário de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100830,
					"content": "#Bem, como {NICKNAME} falou em seu favor, acho que dessa vez a sua punição será... Uma refeição no Caçador de Cervos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100831,
					"content": "Você correu por aí o dia todo. Tenho certeza que deve estar faminta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100832
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100832,
					"content": "Você é a melhor, Mestre Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100833
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100833,
					"content": "#Vocês estão mais do que convidad{M#o}{F#a}s para se juntar a nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100834
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100834,
					"content": "Hehe, demais! Paimon estava morrendo de vontade de comer um Frango Assado com Mel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100835,
					"content": "Jean convida você, Paimon e Klee para uma refeição no Caçador de Cervos... \\nAh, e claro, com Dodoco, a recém-coroada \"Dodo-Maga\". \\nCom isso, a provação chega a um fim bem-sucedido.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 100100826,
					"content": "Esse foi todo o estrago.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100827
					]
				}
			]
