			"dialogs": [
				{
					"id": 100100801,
					"content": "Ufa, pronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100802,
					"content": "A nota dava a entender que as coisas não seriam tão simples assim. Paimon acha que era por causa daqueles monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100803
