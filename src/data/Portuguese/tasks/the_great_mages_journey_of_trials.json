			"dialogs": [
				{
					"id": 100100501,
					"content": "Beleza, cuidamos de todas as barreiras dos Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100502
					],
					"speakerTitle": "Paimon"
