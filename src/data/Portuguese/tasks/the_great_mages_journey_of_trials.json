				},
				{
					"id": 100100803,
					"content": "Mas isso significa que... passamos na provação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100804
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100804,
					"content": "Hehe, é isso mesmo! Agora então, vamos ver o que tem dentro dessa caixa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100805
					],
