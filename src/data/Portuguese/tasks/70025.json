			"dialogs": [
				{
					"id": 700250101,
					"content": "#Olá, Aventureir{F#a}{M#o}! Já estamos cientes sobre as missões completas, e a Guilda de Aventureiros agradece pelo seu apoio! Aqui está sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250102,
					"content": "Apesar de não ter capturado aquele Hilichurl Estranho, nem encontrado a causa para essa situação caótica atual, pelo menos a segurança das áreas próximas foi garantida. Bom trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250103,
					"content": "Por falar nisso, Ella Musk está esperando por você na Biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
