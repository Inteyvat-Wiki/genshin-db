			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu... Mimi tomo... Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250202,
					"content": "Olá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika! Ah... São vocês... Quase que me matam de susto... Por favor, não me interrompam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250204,
					"content": "Uh, mas você não nos chamou para vir até aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250212,
					"content": "Uh? Oh... São vocês! Muito obrigada pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250205,
					"content": "Será que as minhas anotações são precisas? Será que são suficientes para se comunicar pacificamente com os Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250206,
					"content": "Mamão com açúcar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Hmph, o trabalho em meu dicionário teve um enorme progresso! Ele aumentou a base para que os humanos e Hilichurls possam conviver em paz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250209,
					"content": "Mas é uma pena que não serviu para se comunicarem com aquele Hilichurl Estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250210,
					"content": "Do ponto de vista de minha pesquisa, talvez ele só queira fazer novos amigos nesta terra estranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250213,
					"content": "É uma pena, realmente não conseguimos nos comunicar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250214,
					"content": "De qualquer maneira, fique com isso como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250215,
					"content": "Já pedi muito sua ajuda, peço desculpas. Se houver a chance, gostaria de trabalhar junto a você novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250211,
					"content": "O quê? Então ele sabia falar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250207,
					"content": "Eu ainda prefiro a minha própria maneira.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
