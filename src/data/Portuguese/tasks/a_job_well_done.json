			"dialogs": [
				{
					"id": 401540101,
					"content": "Você continua a cuidar da loja de poções. Graças a seu trabalho duro, seus ganhos superam as expectativas...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "Uau, tenho que dizer, fofuras. Nunca imaginei que vocês seriam capazes de trazer tanta Mora em tão pouco tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "#Vocês são praticamente gêni{M#o}{F#a}s quando se trata de negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "É tudo graças a sua ajuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Hehe, sempre tão humilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Embora, com resultados assim tão impressionantes, eu diria que você deveria aceitar mais créditos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Se eu tivesse sua ajuda o tempo todo, aposto que eu poderia tirar o dobro de folgas sem nem me importar com nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "Com todo seu trabalho pesado até então, já coletamos dados de venda o suficiente para nossa pesquisa. Muito obrigada pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "#É claro, se você estiver interessad{M#o}{F#a} em continuar a cuidar da loja, você me faria muito feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "De qualquer forma, eu já devo ter mais do que suficiente para reportar para a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, já faz um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Oh, você está aqui! Acabei uns trabalhos com minhas fofuras, e estava prestes a ir reportar para você na sede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Não precisa. Eu já falei com outros cavaleiros, então acho que tenho um bom entendimento da situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Parece que você incomodou {NICKNAME} para te ajudar de novo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "#Hehe, como eu não poderia? Quando se trata de um trabalho tão importante assim, {M#um companheiro}{F#uma companheira} inteligente e capaz é algo extremamente necessário — principalmente se queremos bons resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Veja o sucesso da loja! Eu jamais teria feito esse tipo de resultado por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Bem, eu realmente tenho que admitir, seu sucesso é incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "Eu tenho pensado em vir te ver já faz um tempo, mas o trabalho não parava de ficar no caminho e eu simplesmente não consegui encontrar um tempo... Independentemente, eu sabia que tinha que vir te agradecer em pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Deveríamos te agradecer pelo seu apoio também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "É realmente reconfortante ter membros tão incríveis entre nossos ranques.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Hehe, quando tudo isso acabar, acredito que eu mereço umas férias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Perdi alguns fios de cabelo por conta do estresse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Claro. Obrigada a todos pelo seu trabalho duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Te vendo enfurnada naquela biblioteca o tempo todo, eu estava preocupada de que você ficaria entendiada. Então pensei em te dar a oportunidade de usar realmente os seus talentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Talvez eu tenha colocado muito no seu prato de uma só vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#Não foi assim tão ruim. Afinal de contas, não é como se eu estivesse sozinha. Toda a ajuda dos cavaleiros e {M#do}{F#da} {NICKNAME} ajudou muito em diminuir a carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Além disso, foi divertido voltar a pesquisar. É bom poder reviver aqueles dias de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Fico feliz de ouvir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#Obrigada novamente pela sua ajuda, {NICKNAME}. Por favor, fique com isso como uma compensação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Ah, falando de compensação, eu também preparei uma lembrancinha para você. Aqui, espero que goste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "Foi um trabalho em equipe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "Apenas pegamos o jeito ao longo do caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Hmm, uma prova de sua habilidade de aprender durante o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}