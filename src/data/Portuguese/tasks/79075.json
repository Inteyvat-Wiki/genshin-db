			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Ufa... O vento finalmente parou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Nos escute, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "Tudo bem. Vou escutar o que você tem a dizer. Mas antes disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "#Veja o quão chocad{M#o}{F#a}s vocês estão! Certamente estão louc{M#o}{F#a}s para perguntar, \"Como uma flor pode falar?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "Ou talvez, \"Como você se transformou em uma flor no vaso?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "As pessoas normalmente perguntam isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Lá fora, sim, muitos. Após eu ter voltado para casa... Não, ninguém perguntou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "Por \"lá fora\", você quer dizer, fora deste mundo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Ouvi dizer que você apenas ficou assim após se aventurar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "#Ora, ora, veja só quem está bem informad{M#o}{F#a}! Imagino que Panuelle deve ter te contado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "Isso mesmo. Eu fiquei assim enquanto me aventurava. Hehe, como diria Rozel... Essa é a \"mudança\" que eu escolhi fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Paimon entende de mudança... Mas, por que mudar para uma flor no vaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "Poderia ser, pois você realmente gosta muito de plantas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "Não. Eu apenas... queria encontrar meu \"lugar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "Conheci muitas pessoas fora deste mundo. Alguns eram chefs, outros eram floricultores, alguns eram professores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Quase todo mundo tinha um \"lugar\" que os faziam sentir seguros. Foi assim que todos conseguiram se estabelecer na vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "E eu? Tudo que podia fazer era me aventurar. Eu nunca pensei em encontrar um \"lugar\" estável para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "Esse \"vaso de planta\" é o seu \"lugar\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "Exatamente. Você entendeu rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "Como uma flor em um vaso, eu sempre terei um \"lugar\" que me deixa em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Mas... *Suspira* Já que eu já tenho um vaso, e um \"lugar\" que me pertence, por que ainda quero sair e me aventurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "Sou um aventureiro, afinal de contas. Sem me aventurar, existe mais algo de valor que eu possa fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Eu não entendo. Quanto mais do mundo exterior eu vejo, menos eu compreendo... Entre ter um \"lugar\" e me \"aventurar\", qual é o mais importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Quanto mais penso nisso, mais minha cabeça dói... E quando falo com Panuelle, sempre esquivo de suas perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "Tenho medo de enganar ele. Se ele amasse se aventurar, ele começaria a odiar após me ver assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "Ele é meu amigo, e sempre será. Preciso ser honesto com ele, e respondi tudo que ele perguntou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Incluindo... Que o motivo que me tornei uma flor foi para ter um \"lugar\" que me deixasse em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Talvez minha resposta o chateou... Ou talvez, é porque ele não gosta de como estou agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Estamos nos afastando, mas eu sou apenas uma planta em um vaso, não posso ir por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "Mas, provavelmente é para o melhor, tenho certeza de que Panuelle não quer me ver. Ele deve estar com raiva de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Oh... Então é isso que está acontecendo! Vocês dois acham que um está com raiva do outro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "E então não estão dispostos a se encontrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "O quê!? V-Você quer dizer que, Panuelle não está chateado comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "Vocês dois estão pensando exatamente a mesma coisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Você conta a Chauvigne tudo que Panuelle está pensando...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Pelos céus, como eu poderia pensar algo assim? Eu nunca quis ver ele chateado, e se sequer os cantos de sua boca tremessem para baixo, meu coração ficaria totalmente devastado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "#{M#Queridos convidados}{F#Queridas convidadas}! Preciso pedir que vocês me levem lá em cima, eu imploro! Eu preciso vê-lo urgentemente! Não posso esperar nem mais um minuto, não, nem mesmo mais um segundo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750341,
					"content": "Eu esperava que você dissesse isso, meu amigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Hehe, Paimon também estava esperando por isso! Vamos lá, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750337,
					"content": "Ele, na verdade, acha que é você quem está com raiva dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "Seu sonho é de se tornar um botanista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "Panuelle tem algo que ele gostaria de te dizer.",
					"roleType": "TALK_ROLE_PLAYER",
