			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! V-Você veio. Por favor, me escute, eu nunca fiquei com raiva de você e nunca quis te deixar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Eu só me preocupava em você não querer ser meu amigo... Eu sei que alguns aventureiros mudam, e fiquei preocupado que você também mudasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Eu orei para a deusa, mas... Mas não consegui encontrar um presente bom suficiente para oferecer, então ela me ignorou, naturalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "Não! Panuelle, tal coisa jamais poderia acontecer. Eu sempre, sempre serei seu amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Te devo desculpas! Eu fiquei tão focado em meus próprios pensamentos que falhei em ouvir o que você estava dizendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "Eu assumi... assumi que você nunca mais queria me ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Parece que resolvemos esse mal-entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "É! Paimon pensava que vocês tinham um problemão e estavam com tanta raiva que nem queriam tentar se entender!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Não que fosse um probleminha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "#Agradeço a vocês, {M#caros convidados}{F#caras convidadas}, eu ainda estaria enfurnado lá, me recusando a sair sem vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Mas agora eu posso finalmente compartilhar o que está em meu coração com Panuelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Estou sempre disposto a ouvir tudo que você tem a dizer, Chauvigne. Caso você deseje se aventurar ou cuidar de flores... Está tudo bem comigo agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "#Certo, {M#caros convidados}{F#caras convidadas}. Por favor, aceitem isso. Reuni especialmente para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Que a deusa abençoe vocês, que vocês nunca briguem com seus amigos e que alguém sempre esteja disposto a ouvir seus pensamentos mais íntimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "Mas pelo menos está resolvido agora.",
					"roleType": "TALK_ROLE_PLAYER",
