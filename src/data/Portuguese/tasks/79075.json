			"dialogs": [
				{
					"id": 790750201,
					"content": "Eu... Eu preciso organizar esse lugar, e encontrar um bom lugar para Chauvigne ficar no sol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "#Deixarei a questão de persuadir Chauvigne em suas mãos, {M#queridos convidados}{F#queridas convidadas}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "Se eu visse ele, ele certamente acharia que sou grudento e ficaria ainda mais irritado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
