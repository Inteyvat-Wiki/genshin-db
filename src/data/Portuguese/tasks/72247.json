				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "Parece que você tem força o suficiente para escoltar as ofertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470202,
					"content": "Assim eu poderei ficar mais descansado... Por favor, estas ofertas terão que chegar em segurança... para eu poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470203,
					"content": "Para você poder fazer o quê...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470204,
					"content": "Para eu poder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470205,
					"content": "Ah não. Voltou a quebrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470206,
					"content": "Mas as ofertas que ele estava falando são provavelmente estas... Parece que elas também estão um pouco gastas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224703,
			"completionStepIds": [
				7224705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
