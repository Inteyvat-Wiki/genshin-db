				"points": []
			},
			"dialogs": [
				{
					"id": 722470301,
					"content": "Veja... tem algo saindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470302,
					"content": "Parece ser uma sombra também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470303,
					"content": "Meu nome é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470304,
					"content": "Aberaku, criador de Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470305,
					"content": "Eu entendi a frase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470306,
					"content": "Significa que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470307,
					"content": "O seu nome é Helios, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470308,
					"content": "Por acaso você estava o ouvindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "Ah, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470311,
					"content": "O nome dele é Aberaku. Que nome estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470312,
					"content": "Mas, já que o nome dele é Aberaku, então o que é Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470313,
					"content": "Ah, Helios! Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470314,
					"content": "A minha própria criação... Helios! Quando terminou, sua luz se espalhou de horizonte em horizonte, e assim o povo foi poupado do flagelo do dragão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470315,
					"content": "Como as pessoas o contemplavam então! Como choravam lágrimas quentes, levantavam os braços com gritos de alegria, incapazes de conter suas emoções intensas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470316,
					"content": "Não... espera! Por... por que estou aqui? Por que minha alma se perdeu no reino dos sonhos, incapaz de descansar em paz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470317,
					"content": "Paimon, você entendeu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "Sim, a Paimon entendeu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470319,
					"content": "Este é um espírito perturbado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470320,
					"content": "Eu me lembrei agora! Minha alma está incompleta! Só quando todos os pedaços de minha alma estiverem juntos, poderei descansar em paz de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470321,
					"content": "Em um momento desses, você que desempenha um papel muito importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470322,
					"content": "A Paimon está sentindo que os problemas estão chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470323,
					"content": "Uma parte de meus ossos deveria ser guardada neste lugar, mas eles apodreceram há muito tempo... Por favor, eu lhe imploro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470324,
					"content": "Pegue essas oferendas que contêm meus sentimentos... No entanto, você encontrará monstros que mantêm minha alma trancada. Quando sentirem que o objeto que contém minha alma está sendo levado... Vão sair para atacar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470325,
					"content": "#Este é um assunto perigoso. Viajante, diga-me quando estiver pront{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470309,
					"content": "O nome dele é Aberaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
		},
