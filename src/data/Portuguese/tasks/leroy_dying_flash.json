				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "Camiseta de Atos, 1.000 Mora... Colar de Morticia... Tsc, tsc. Jovens de hoje sabem mesmo como gastar Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490202,
					"content": "Olá, Sr. Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Olá! Euphrasie nos enviou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Vocês contam ao Sr. Leroy porque estão aqui.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Haha, isso faz meio ano, não? Eu não achava que Euphrasie tinha segurado a comissão que eu postei na época.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490206,
					"content": "É verdade — eu realmente pensei em contratar trabalhadores horistas. Afinal, até os trabalhadores mais capazes envelhecem e precisam que outros cuidem deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490207,
					"content": "Eu passei muito da minha vida trabalhando para ter essa casa, mas em minha idade avançada, descobri que não tinha com quem compartilhá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490208,
					"content": "Isso me entristeceu muito por um tempo — então é algo bom, no fim das contas, que minha filha e genro tenham vindo cuidar de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490209,
					"content": "Eles são boas crianças, eles se amam muito e me fazem companhia. Não há nada mais que eu possa querer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490210,
					"content": "Tudo isso para dizer, jovem, que não estou mais contratando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490211,
					"content": "Ah, que pena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Ora, não fiquem tão para baixo. Não é assim que jovens deveriam ser. Vocês têm que aproveitar ao máximo a vida com um sorriso no rosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490214,
					"content": "E também, já que vocês vieram até aqui, e já que Euphrasie recomendou vocês, de fato tenho um trabalho para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490215,
					"content": "#Coincidentemente, as crianças estão fora e não posso lidar com tudo aqui. Claro, vocês serão pag{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490216,
					"content": "Ooh, legal! Você é um cara bem legal, Sr. Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Hahaha, você está me bajulando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490218,
					"content": "Tudo bem, então, me ajudem a limpar as manchas perto da porta e atrás da casa — e deem um pouco de peixe a Nana enquanto fazem isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490219,
					"content": "Certo, esqueci de mencionar, mas Nana é minha gata — sabem, aquela perto da porta. Obrigado antecipadamente em nome dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490220,
					"content": "Bem, isso parece bem simples. Sem problema! Deixa com a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Sério, aquela Euphrasie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
			"completionStepIds": [
				7414905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
