			"dialogs": [
				{
					"id": 741490701,
					"content": "Vocês esqueceram o que pedi para fazerem?... Ah, crianças e suas memórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490702
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490702,
					"content": "A primeira coisa que pedi sua ajuda foi para limpar a porta e a parte de trás da casa. Depois alimentar Nana, minha gata, com um pouco de peixe.",
					"roleType": "TALK_ROLE_NPC",
