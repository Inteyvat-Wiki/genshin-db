				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "Você tem algum novo trabalho para fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "Oh? Acho que nossas comissões aqui na Contos da Humanidade não são um desafio para você... Ou você está precisando urgentemente de Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Bem, Mora nunca é demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Uhum. Um sentimento muito comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Se há algo que não falta aqui, é trabalho a ser feito. Na verdade, eu acreditaria que somos o maior centro de distribuição de trabalho fora da Guilda de Aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Bem, eu digo isso, mas não precisamos mesmo assumir essa responsabilidade de serviço social.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Independentemente do caso, já que você precisa de Mora, deixe-me recomendar um certo trabalho de longo prazo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Essa é uma nota que o Sr. Leroy deixou conosco há mais de meio ano — a maioria de nós que vive nessa rua o conhece bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Embora ele tenha tido uma má reputação quando era mais jovem, eu não ouvi nenhum rumor negativo relacionado a ele recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Ele esteve sozinho pela maior parte de sua vida, e com sua única filha não estando ao lado dele, não há ninguém para cuidar dele... Acho que é aí que uma pessoa poderia ter a ajuda de um trabalhador horista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "#Pelo que sei, Mora não é um problema para ele, então você será bem-pag{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Duvido que o trabalho seja muito arriscado também, então você deveria considerá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Então a gente só precisa ajudar ele com uns afazeres domésticos, né? Paimon acha que isso vai servir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Por gentileza, me dê o endereço dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Claro. Só vire duas esquinas e dê a volta... Na verdade, esqueça. Vou te dar um mapa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Lembre de dizer a ele que eu apresentei vocês a este serviço, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Um pouco disso e um pouco daquilo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "#Um{F#a} jovem diligente, então. Bem, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7414902",
							"2"
						],
						"stepId": 7414902,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7414901",
							"3"
						],
						"stepId": 7414901,
						"stateName": "QUEST_STATE_FINISHED"
