					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "Hmm... Parece uma lápide de Ratnik. Será que é daqueles Ratniki que vimos no desfiladeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650102,
					"content": "Eles continuam aparecendo e desaparecendo, surgem num instante e somem no outro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650103,
					"content": "Hmm, Paimon ainda não entendeu o que está acontecendo. Vamos perguntar em Piramida da próxima vez! Talvez alguém lá saiba algo sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "Ah, saudações. Sou Patolichev, intendente dos Portadores da Lâmpada. Em que posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "Você é o Patolichev do Corcel do Gelo Invernal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "Corcel do Gelo Invernal... Ah, você se refere àquelas sombras estranhas que vimos mais cedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "Sim, esse foi o esquadrão ao qual servi. O Corcel do Gelo Invernal... Faz muito tempo que não ouço esse nome. Nunca imaginei ouvi-lo vindo de outra pessoa... Posso perguntar como você...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "Já estivemos ao pé do Penhasco Kipumaki antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "Sim! E nós cuidamos da Caçada Feroz que estava causando problemas por lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "Até vimos os Ratniki do Corcel do Vento Gélido... suas sombras ainda pairando após a luta contra a Caçada Feroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "Não consigo acreditar que era real...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "Claro que era! A gente viu com nossos próprios olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "Ah... Com os anos, as pessoas me contaram de tempos em tempos que viam as silhuetas de companheiros mortos no Penhasco Kipumaki. É por isso que até agora, ainda vou lá com frequência... e cuido dos túmulos deles enquanto estou lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "Mas nem uma vez... nem uma única vez, eu mesmo os vi. Já faz tanto tempo... Achei que essas histórias eram apenas mentiras bondosas para me confortar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "E ainda assim, vocês realmente os viram... Por que será que, sempre que vou lá, eles nunca aparecem para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "Talvez... a hora certa ainda não tenha chegado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Talvez... Ainda assim, saber que eles realmente estão lá, mesmo que apenas como sombras ou memórias passageiras, já é o bastante para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "#De qualquer forma, obrigado, {M#senhor}{F#senhorita}, obrigado por estar dispost{M#o}{F#a} a me contar. Isso significa muito para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "É graças a eles que ainda posso estar de pé hoje. E, mesmo assim... como eu queria poder estar com eles mais uma vez, ao pé do Penhasco Kipumaki, lutando lado a lado outra vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "...Um dia. Um dia, tenho certeza de que voltarei a encontrá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "Talvez eles simplesmente não queiram que você recorde a dor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "*Suspiro* Dor? Não... Aqueles últimos dias, lutando lado a lado com eles até o fim... como algo assim poderia ser doloroso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "Vimos os Ratniki do Corcel do Gelo Invernal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Sim... e mesmo que restem apenas sombras, elas ainda os mostram travando batalha contra a Caçada Feroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}