				},
				{
					"id": 205140602,
					"content": "Anna está no topo de um moinho de vento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140603
					]
				},
				{
					"id": 205140603,
					"content": "Um moinho de vento? Como aquela garota subiu em um? Eu vou subir lá agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140604
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140604,
					"content": "O quê? Ela quer tentar virar uma aventureira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140605
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140605,
					"content": "Ela está se adiantando, ela nem sequer se recuperou completamente ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140606
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140606,
					"content": "Não me entenda mal. Uma vez que ela esteja bem, não tenho nenhum problema que ela saia para ver o mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140607
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140607,
					"content": "Obrigado, vou procurar por ela. Correndo assim quando ela acabou de se recuperar... Talvez eu vá dar-lhe uma lição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
