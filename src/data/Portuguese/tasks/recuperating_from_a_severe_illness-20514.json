			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "Como isso aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "Oh, é você. Bem na hora certa, também. Anna tem ficado melhor desde que ela começou a tomar o remédio prescrito pelo médico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140104,
					"content": "Quando ela não estava bem, ela precisava de bastante repouso, então passava muito tempo convalescente em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140105,
					"content": "Agora que ela está melhor, ela tem me incomodado todos os dias para sair e brincar com ela, e eu não poderia recusar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140106,
					"content": "Mas agora, eu não consigo de jeito nenhum achá-la. Eu não faço ideia onde ela foi. Por favor, me ajude a encontrá-la!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140107,
					"content": "Eu... Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "Eu vou ficar esperando aqui. Por favor, se apresse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140109,
					"content": "Ela acabou de melhorar, e agora está correndo por aí. O que irei fazer se algo acontecer a ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140116,
					"content": "Eu já venho procurando há algum tempo. Ainda não procurei nas proximidades da Guilda de Aventureiros, mas estou totalmente destruído a este ponto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140117,
					"content": "Você deveria começar sua busca por lá. Quem sabe, talvez Cyrus tenha notado alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140118,
					"content": "Eu espero que você consiga achá-la, ou terei que sair novamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140110,
					"content": "Você parece bem feliz com isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "Feliz? Isso não tem graça. Ela acabou de melhorar, e agora ela está voando por aí que nem uma pipa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140112,
					"content": "Quando ela voltar, eu vou dar-lhe uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140113,
					"content": "Ela vai voltar quando ficar faminta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "Você por acaso pensa que a minha irmã é um gato? E ela acabou de se recuperar. Como que podemos deixá-la ficar com fome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140115,
					"content": "Tudo bem, tudo bem. Por favor, me ajude a achá-la, estarei esperando por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051402,
