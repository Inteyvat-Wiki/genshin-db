						205140503
					]
				},
				{
					"id": 205140503,
					"content": "Ahhh! Como você chegou aqui em cima, e ainda mais sem fazer barulho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140504,
					"content": "E como você me achou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Ah, eu sei. O senhor Cyrus deve ter contado para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "Ele sempre cuidou de mim e meu irmão, então eu falei com ele enquanto eu passava. Ele pareceu tão surpreso também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Talvez eu deveria tentar entrar para a Guilda de Aventureiros e me tornar uma Aventureira. Seria legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "O quê? Meu irmão tem me procurado? Hm. Já tem um tempo, não tem? Eu nem notei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140509,
					"content": "Entendido. Vou voltar logo por mim mesma, só me deixe ficar aqui por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
