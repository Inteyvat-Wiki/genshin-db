			"dialogs": [
				{
					"id": 205140401,
					"content": "Oh? Você está aqui? Isso é incomum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140402,
					"content": "Por acaso você viu uma garota?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Uma garota? Oh, você quer dizer a Anna? Eu vi ela. Ela estava indo em direção ao moinho de vento ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "Eu mesmo ainda estou bastante intrigado com isso. Pensei que ela não estivesse bem. De onde ela tirou toda aquela energia de repente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "Ela falou comigo e passou direto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "Essa criança... Você tem alguma ideia de quando ela se recuperou de sua doença?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
