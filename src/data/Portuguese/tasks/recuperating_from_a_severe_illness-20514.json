			"dialogs": [
				{
					"id": 205140301,
					"content": "Você já encontrou a Anna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "Anna está no topo de um moinho de vento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Um moinho de vento? Como aquela garota subiu lá? Eu vou chamar os Cavaleiros de Favonius agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Ela disse que retornaria logo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "A-ah... Sério? Bem, se ela está bem é o que importa. Você me assustou por um momento. Pensei que ela estava presa em cima do moinho de vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Obrigado, vou atrás dela agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Fugindo assim quando ela acabou de se recuperar... Talvez eu vá dar-lhe uma lição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
