				{
					"id": 721780501,
					"content": "Aqui também tem um santuário. Parece familiar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780502,
					"content": "(Parece um santuário comum. Não há nenhum traço de elementos estranhos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780503
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780503,
					"content": "Investigar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780504
					]
				},
				{
					"id": 721780504,
					"content": "(Estes templos parecem muito dilapidados. A fachada de madeira está marcada e desvanecida, revelando traços perigosos de vermelho escuro.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780505
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780505,
					"content": "Este santuário... É assustador, estou ficando toda arrepiada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780506,
					"content": "Vamos sair daqui!",
					"roleType": "TALK_ROLE_NPC",
