			"dialogs": [
				{
					"id": 721780101,
					"content": "(Parece um santuário comum. Não há nenhum traço de elementos estranhos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780102,
					"content": "Investigar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Este santuário parece estar em boas condições e parece ter sido mantido com bastante cuidado nos últimos dias. A pessoa que fez isto deve ser de fato conscienciosa).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780104,
					"content": "(Mas além disso, não há sinais de alguém ter estado aqui).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780105,
					"content": "Que estranho, né? Parece que alguém esteve aqui antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217802,
			"completionStepIds": [
				7217803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
