			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721780201,
					"content": "Tem um outro santuário ali. Vamos dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(Parece um santuário comum. Não há nenhum traço de elementos estranhos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780203,
					"content": "Investigar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Esse templo está limpo e organizado e tem um aroma leve de Sakura Sagrada, Alguém pulverizou ela há pouco tempo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780205,
					"content": "(Para além disso, não tem novos rastros.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780206,
					"content": "É o aroma da... Sakura Sagrada! Será que a mãe de Chouji veio até aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "E deve ter sido bem recentemente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217803,
