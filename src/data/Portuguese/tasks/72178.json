			},
			"dialogs": [
				{
					"id": 721780401,
					"content": "Este é o santuário que Chouji mencionou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(Parece um santuário comum. Não há nenhum traço de elementos estranhos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780403,
					"content": "Investigar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(O santuário é simples, mas elegante. O nicho de madeira cintila levemente, saudando os convidados com um silêncio solene.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780405,
					"content": "(Existem muitas pétalas de Sakura Sagrada espalhadas ao redor do santuário. Não parece que aconteceu naturalmente. Parece mais que alguém espalhou as flores de Sakura aqui de propósito.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780406,
					"content": "Bem, também não tem nenhum traço por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Veja, são Pétalas da Flor de Sakura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Oh, certo. Chouji mencionou que sua mãe fazia estas oferendas ao santuário!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "Há tantas pétalas por aqui... Isso não pode ser uma coincidência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Vamos voltar e contar para ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "É a oferenda da mãe do Chouji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
		},
