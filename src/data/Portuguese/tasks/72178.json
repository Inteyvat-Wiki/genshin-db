			},
			"dialogs": [
				{
					"id": 721780301,
					"content": "Esse santuário parece muito novo! Vamos dar uma olhada mais de perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780302,
					"content": "(Parece um santuário comum. Não há nenhum traço de elementos estranhos.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780303
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780303,
					"content": "Investigar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(A madeira deste tempo é velha, mas uma boa manutenção irá tornar ela menos delapidada e mais encantadora.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Altar"
				},
				{
					"id": 721780305,
					"content": "Parece que alguém vem aqui frequentemente para cuidar do santuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217804,
