			},
			"dialogs": [
				{
					"id": 413130801,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130802,
					"content": "Gostaríamos que você viesse ao Ritual de Lanternas conosco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "#...Já conversamos sobre lugares lotados. Não me faça repetir. Melhor você ir sozinh{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130804,
					"content": "Eu não disse que você tem que ir para o Porto de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "... O que isso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130806,
					"content": "Você não vai ao festival, então trouxemos o festival para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "Vocês \"trouxeram o festival para mim\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130808,
					"content": "Resumindo: Imagine seu próprio Ritual de Lanternas aqui mesmo no albergue! Pilhas de comida gourmet meticulosamente preparadas pelo nosso famoso chef, todas as Lanternas Celestes que você quiser e acesso VIP à nossa barraca sem se preocupar com as multidões!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130809,
					"content": "Tem até Tofu de Amêndoas e Peixe Tigre Frito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "Melhor se apressar ou a comida vai esfriar. Vamos descer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131314",
							"2"
