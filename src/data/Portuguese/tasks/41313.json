				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130201,
					"content": "Então, o assunto já está resolvido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130202,
					"content": "Já já, mas-",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "Ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130204,
					"content": "Você realmente não vai ver a Lanterna Mingxiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "Não. Como eu disse, não gosto de lugares lotados. Principalmente nesta época do ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130206,
					"content": "A Lanterna Mingxiao deste ano é um Mestre dos Céus Transcendentes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "Sim, é um cervo gigante e super impressionante, vamos dar uma olhada juntos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130208,
					"content": "\"Mestre dos Céus Transcendentes\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130209,
					"content": "Não deixa de ser uma Lanterna Mingxiao. Uma criação humana fugaz. Não significa nada para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413130210,
					"content": "Está bem! Se vocês quiserem, vão à cidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 4131303,
			"completionStepIds": [
				4131303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131303",
							"2"
						],
						"stepId": 4131303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130301,
					"content": "Parece que você e Xiao cuidaram dos negócios novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130302,
					"content": "A notícia se espalhou e chegou até nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130303
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130303,
					"content": "E, no entanto, mais um Ritual de Lanternas chegará ao fim e ele não participará...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130304,
					"content": "*Suspiro* ...Todos esses longos anos e eu nunca o vi participar do Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130305,
					"content": "Digo mais, seria mais fácil trazer o festival até ele do que o contrário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130306,
					"content": "Trazer o festival até ele... Hmm..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130307,
					"content": "Boa ideia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130308
					]
				},
				{
					"id": 413130308,
					"content": "Sim! Se Xiao não vai ao Ritual de Lanternas, então vamos levar o Ritual de Lanternas até ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130309,
					"content": "... Como assim? Você deve ter percebido que eu estava brincando... Como vamos \"levar o Ritual de Lanternas até ele\", exatamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130310
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130310,
					"content": "Quando estávamos na cidade conferindo as festividades, aprendemos a fazer Lanternas Celestes. Até encontramos uma barraca de comida servindo iguarias locais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130311,
					"content": "Tantas comidas saborosas, tantas Lanternas Celestes bonitas, sem falar de... O que mais... Oh, os heróis do passado, seus velhos amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130312,
					"content": "Esses não são o coração e a alma do Ritual de Lanternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130313,
					"content": "#Você não está errad{M#o}{F#a}, mas onde poderíamos organizar tudo isso...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130314
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 413130314,
					"content": "Agora que você disse, deixe-me pensar... Precisamos de espaço suficiente para montar nossa própria barraca. Hmm... Deve haver espaço suficiente <color=#00E1FFFF>abaixo do albergue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130315
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130315,
					"content": "Vamos dar uma olhada e escolher um espaço. Acho que sei o tipo de barraca que você quer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130316
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130316,
					"content": "Hmm, deve haver alguns estilos que podemos usar como referência, deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 4131307,
			"completionStepIds": [
				4131307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4131307",
							"2"
						],
						"stepId": 4131307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130701,
					"content": "Aqui não é ruim... e está bem longe do fluxo de pedestres. Uma escolha adequada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130702
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130702,
					"content": "Eu tive uma ideia e sei mais ou menos como colocá-la em prática.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130703
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130703,
					"content": "Se me derem licença por um momento, tentarei descobrir por onde começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130704
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130704,
					"content": "E funcionou! Um pouco rústica, mas deve nos servir bem. O que vocês acham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130705
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130705,
					"content": "Acho que você encontrou sua verdadeira vocação! Que carpintaria trabalhada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130706
					]
				},
				{
					"id": 413130706,
					"content": "Imagina! São apenas algumas coisas que aprendi anos atrás. Eu esqueci quase tudo, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130707
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130707,
					"content": "Podemos tirar a barraca da nossa lista de tarefas. A decoração ficou bem com aquela Lanterna Celeste, não acham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130708
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130708,
					"content": "Você também sabe fazer Lanternas Celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130709
					]
				},
				{
					"id": 413130709,
					"content": "Bem, sim, mas isso é normal para todos da minha geração que cresceram em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130710
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130710,
					"content": "Enfim, por falar em festividades... Nenhuma celebração está completa sem um banquete. Já sabem o que querem comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130711
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130711,
					"content": "Tofu de Amêndoas, com certeza! Preparamos para Xiao uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413130712,
					"content": "E Peixe Tigre Frito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130713
					]
				},
				{
					"id": 413130713,
					"content": "Tofu de Amêndoas e Peixe Tigre Frito, hmm... Que combinação de sabores interessante! Vou falar com Yanxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130714
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130714,
					"content": "Ele deve conseguir prepará-los em um instante. Felizmente, a despensa do albergue contém todos os ingredientes necessários.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130715
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 413130715,
					"content": "É hora de chamar nosso convidado de honra. Você poderia buscá-lo? A comida deve estar pronta quando vocês descerem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
