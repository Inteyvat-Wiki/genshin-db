			"dialogs": [
				{
					"id": 413131101,
					"content": "Isso é o mais longe que irei. Divirtam-se na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131102,
						413131104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131102,
					"content": "Espere um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131103
					]
				},
				{
					"id": 413131103,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131105
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131105,
					"content": "Você obviamente é um dos heróis do festival... Por que você não quer participar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131106,
					"content": "Eu... Detesto multidões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131107
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131107,
					"content": "As pessoes são tão pacíficas e tão alegres... Elas não são como eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131108
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131108,
					"content": "Passei muito tempo em combate, aguentando o fardo do sofrimento causado por isso. Estar entre toda aquela gente jubilosa só vai me fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131109,
					"content": "... Isso é tudo o que tenho a dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131110,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131111
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131111,
					"content": "Tem certeza de que não quer ir conosco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131112
					]
				},
				{
					"id": 413131112,
					"content": "Vocês realmente gostam dessas diversões triviais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131113,
					"content": "O que você acha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131114
					]
				},
				{
					"id": 413131114,
					"content": "Ei! Este é um festival legítimo, não uma diversão trivial!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 413131115,
					"content": "...Legítimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131116
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131116,
					"content": "Basta. Vão ver suas lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131117
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131117,
					"content": "#Mas fiquem atent{M#os}{F#as}. Mantenham os olhos abertos para qualquer ameaça. Se entrarem em apuros... Digam meu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131118
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131118,
					"content": "Tem certeza de que você chegaria na cidade a tempo de nos resgatar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131119
					]
				},
				{
					"id": 413131119,
					"content": "Em qualquer lugar. A qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413131120
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131120,
					"content": "Não importa se é você ou Liyue. Eu ouço todos os gritos de ajuda, e todos os desejos carregados pelas lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 413131104,
					"content": "(...Deixa pra lá, nós podemos ver daqui.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413131105
					]
				}
			]
		},
