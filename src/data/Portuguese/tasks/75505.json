			"dialogs": [
				{
					"id": 755050301,
					"content": "Ufa! Conseguimos! Apesar desse insetão ser grande, foi fácil de pegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050302,
					"content": "Não é perigoso, nem um pouquinho. Ele só gosta de fugir. Essa rede e as frutinhas paralisantes foram uma graça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050303,
					"content": "Hehe, mas, como esses Afídios estão contaminados pelo Abismo, eles podem atrair monstros. É melhor não baixar a guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050304
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050304,
					"content": "Sim, você tá certa! E como essas frutinhas convenientes tão por aqui... se fosse a Paimon, ela ia ficar longe de qualquer inimigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050305,
					"content": "#Ficar perto de frutinhas como essa não é normal ou natural, {NICKNAME}! Vamos ficar com os olhos abertos. Tem algum pelo nesse ovo aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050306,
					"content": "Você é que tá procurando pelo em ovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050307
					]
				},
				{
					"id": 755050307,
					"content": "Hehe, Paimon aprendeu com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050308,
					"content": "Ha~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050309
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050309,
					"content": "Enfim, obrigado por virem comigo. Lidamos com a área, por isso vamos dar uma pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050310
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050310,
					"content": "Afinal, vou precisar da ajuda de vocês nos próximos dias também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
