					{
						"sceneId": 3,
						"position": [
							-1342.486,
							198.978,
							7179.928
						],
						"pointId": 350400245
					}
				]
			},
			"dialogs": [
				{
					"id": 755050201,
					"content": "Chegamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050202
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050202,
					"content": "Tá vendo aquilo? É um Afídio contaminado com poder Abissal. É bem maior que os Afídios normais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050203,
					"content": "Uau, que insetão... é perigoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050204,
					"content": "Relaxa, ele pode ter sido contaminado pelo Abismo, mas o seu comportamento não parece ter mudado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050205
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050205,
					"content": "Ainda assim, preparei uma rede de insetos grande para garantir que vai tudo correr bem. Aqui, vai ser útil para vocês pegarem eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050206
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050206,
					"content": "Ah, sim! Falando nisso, Kinich mencionou algo inusitado. Ele descobriu que há uma frutinha especial que sempre cresce perto de onde esses Afídios Abissais estão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050207
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050207,
					"content": "A frutinha contém uma toxina que pode paralisar os Afídios, por isso, se a gente espalhar elas na rede, eles vão parar de resistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050208
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050208,
					"content": "Hã? Por que os Afídios iam viver ao redor de uma frutinha que paralisa eles? Não faz sentido pra Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050209,
					"content": "Pra mim também. Primeira vez que ouço falar de animais viverem perto de algo que é perigoso para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050210
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050210,
					"content": "É muito anormal! Espera... será que alguém está por trás deles serem contaminados pelo Abismo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050211,
					"content": "Paimon tá com umas ideias, ó...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050212
					]
				},
				{
					"id": 755050212,
					"content": "Ei! Até a guia mais burra cresce! E Paimon nunca foi burra pra começo de conversa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050213,
					"content": "O único problema é que procuramos por todo lugar, e não encontramos nenhum sinal de atividade humana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050214,
					"content": "Por isso, vamos supor que isso é só um comportamento natural, mas inusitado dos Afídios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050215,
					"content": "Tá bom, mas não importa como, a gente tem que pegar eles primeiro! Não queremos nada que deixa as pessoas doentes zanzando por aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050216,
					"content": "Esquadrão Caça-Insetos, partiu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
