						"position": [
							-1373.609,
							169.233,
							7665.231
						],
						"pointId": 350400243
					}
				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "Oi, Xilonen! Paimon não esperava te ver aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050102,
					"content": "Olá, Viajante, Paimon! Ué, o que há de tão estranho em me ver na porta de casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050103,
					"content": "Bem, nada... mas Paimon achou que você teria encontrado uma linda árvore para repor uns dias de sono depois daquele problemão que resolvemos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050104,
					"content": "Haha, eu adoraria, mas todos estão ocupados com as reconstruções. Me sentiria mal de ficar de bobeira em um momento como esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050105,
					"content": "Então foi aqui que você decidiu contribuir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "Aqui, deixe-me te mostrar algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050107,
					"content": "Uau! Que joia linda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050108,
					"content": "Parece bem valiosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "Sim, mas não só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050112,
					"content": "Essa é uma Pérola de Mel de Flogisto com padrões peculiares que tem circulado pelo mercado. Geralmente, elas são produzidas pelos Afídios de Flogisto. Na verdade, são até comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050113,
					"content": "Mas essas com padrões estranhos são tanto novas quanto escassas, então elas são bem caras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050114,
					"content": "Paimon sabe como é! Assim como a gente gosta de baús do tesouro com padrões incríveis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050115,
					"content": "Hehe, então... eu comprei algumas para minha coleção, e olha só. Após alguns dias, a planta no vaso que coloquei por perto murchou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050116,
					"content": "No início não pensei muito sobre isso. Digo, não faço ideia de como cuidar de uma planta. Porém, um tempo depois, ouvi a Kachina dizer que algumas pessoas ficaram doentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050117,
					"content": "A maioria delas eram clientes da loja de joias de Cheven. E a própria Cheven também não foi exceção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050118,
					"content": "Hã? Espera... Então tudo isso teve a ver com essa joia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050119,
					"content": "Também pensei nisso, então quebrei uma... e descobri que possuia um pouco de energia Abissal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050120,
					"content": "De baixa concentração, é claro, e isolada pela própria pérola de mel — que tornou quase indetectável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050121,
					"content": "E quanto às vítimas? Como estão agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "Relaxa. A baixa concentração resultou em aflições bem pequenas, com a maioria ficando sonolentos ou com tendências à exaustão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050123,
					"content": "Não teve nenhum efeito nas pessoas que estão mais em forma, como eu ou Kachina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050124,
					"content": "Ufa... E cá estava Paimon achando que isso seria uma daquelas situações pegajosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050125,
					"content": "Pegajosa? Como o mel nas pérolas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050126,
					"content": "Aposto que Paimon tava pensando algo como \"pagajosas como Slimes\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "Hehe, você conhece Paimon! Ainda bem que esse problema é só uma ameaçazinha para pessoas comuns, tipo Slimes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050128,
					"content": "#Hehe, vocês são {F#boas amigas}{M#bons amigos}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050129,
					"content": "Com certeza! Ainda assim, conhecemos algumas pessoas que ficaram tremendo na base por causa dos Slimes, por isso não podemos ignorar essa situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050130,
					"content": "Exato. Eu expliquei a situação para o chefe, perguntando se ele podia coletar e destruir todas as Pérolas de Mel estranhas no mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050131,
					"content": "Precisamos acabar com a origem dessa coisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "Exatamente como eu pensei. Como eu disse, as Pérolas de Mel de Flogisto são produzidas por Afídios de Flogisto. Aposto que a fonte do problema são eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050133,
					"content": "Eu fui procurar pelo Kinich, já que ele tem mais experiência com investigações. Ontem, ele disse que encontrou Afídios com contaminação Abissal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050134,
					"content": "Também há traços de sua presença perto dos Descendentes das Copas e Povo das Termas. Ah, Kinich também notificou Mualani sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050135,
					"content": "Entretanto, eles não são entusiastas de gemas, por isso o problema não os afetou tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050136,
					"content": "Hmm, parece que há vários tipos de broncas relacionadas ao Abismo, né? Parece que vamos ter que ser pacientes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050137,
					"content": "Como você planeja lidar com os insetos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "Vamos pegar eles primeiro. Podemos purificar esse nível de contaminação Abissal. Não quero machucá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050139,
					"content": "Kinich marcou os lugares que eles se reúnem, e eu estou indo para um local perto de nossa tribo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050140,
					"content": "Você gostaria de vir junto? Capturar insetos parece divertido, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050141,
					"content": "Eu teria convidado Kachina, mas ela tá ocupada com outra coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050142,
					"content": "A gente vai pra lá pra você poder esticar as pernas e fazer nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "#Haha! Eu tenho cara que vou ficar deitada e assistir vocês de cima de uma árvore? Vamos trabalhar junt{M#os}{F#as}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050144,
					"content": "Tô só tirando. Simbora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "É ótimo ter você. Caso contrário, isso ia ser maçante pacas. Vamos nessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050146,
					"content": "Tô dentro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "É ótimo ter você. Caso contrário, isso ia ser maçante pacas. Vamos nessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050148,
					"content": "Tô fora, ver grama crescer é mais divertido que isso aí.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "Urgh, parece que vou sofrer com o tédio sozinha... tem certeza que não quer vir? Eu estava pensando em dar algo a você em troca do seu tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050150,
					"content": "Ooh! Tem pagamento? O que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050151,
					"content": "Coisinhas brilhantes e bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050152,
					"content": "#Mora! Só pode ser Mora! {NICKNAME}, a gente vai mesmo deixar passar uma chance de ganhar grana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755050153,
					"content": "Certo, eu tava só de zoeira. Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050154
					]
				},
				{
					"id": 755050154,
					"content": "Ótimo, vamos nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050155,
					"content": "Bem, acho que pela Mora vale a pena...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050156
					]
				},
				{
					"id": 755050156,
					"content": "Ótimo, vamos nessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755050110,
					"content": "Algo parece estranho por aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050111
					]
				},
				{
					"id": 755050111,
					"content": "Haha, perspicaz como sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "Xilonen"
				}
			]
		},
