			"dialogs": [
				{
					"id": 240100301,
					"content": "Não podemos ser tão restritos pelas formas concretas... precisamos extrair a beleza e usar métodos simbólicos também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100302,
					"content": "Não, não... ainda não. Essa composição é muito proposital...",
