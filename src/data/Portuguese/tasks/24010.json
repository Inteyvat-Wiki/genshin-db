			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "Isso é uma boa ideia... mas será que realmente pode ser feito desta forma...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Como vai o desenho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ah, é você! Obrigado pela sua ajuda de antes com as fotos! As vistas que elas demonstravam eram realmente inspiradoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "Eu já tenho uma pequena ideia, e já fiz alguns rascunhos, mas... bem, eles não são exatamente bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Não me entenda mal — não significa que pintei um lixo qualquer com nenhum valor estético, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "Sinto que está faltando algo especial, algo que poderá ajudar a transcender o ordinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "Existe algo muito... concreto, sobre as coisas que tenho em mente. Se eu transmiti-la diretamente para minha pintura, a beleza que desejo transmitir certamente será danificada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "*Suspira* Temo que isso é um problema que todo artista precisa enfrentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Talvez você possa tentar desenhar outra coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Obrigado pela sugestão, mas temo que esse problema não será resolvido com apenas uma mudança de tópico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Sejam montanhas ou rios, pássaros ou bestas, ou quem sabe o mundo da humanidade... nenhum deles foge desse problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "É precisamente em sua busca por solução que alguns de meus colegas decompuseram e transmutaram as paisagens que viram usando seus sentimentos mais internos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Tal arte enfatiza, acima de tudo, os sentimentos mais internos das pessoas, e o resultado na tela é... como posso explicar, é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Bem, sejam personagens ou cenários... até mesmo a luz consegue carregar uma sensação estranha que nenhum senso de estética tradicional consegue capturar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Com um olhar simplístico, levaria a maioria a acharem que essas pinturas foram concebidas pelos analfabetos em arte ou loucos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Mas se você acalmar o seu espírito e entrar em sintonia com a obra de arte à sua frente, você a ouvirá rugir pelo artista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Esse rugido vem do coração e alma do artista, falando seus sentimentos em voz alta... e esses sentimentos, normalmente, são mais intensos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Entretanto, suas vozes não podem ser escutadas pelos ouvidos, mas pelo coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Quanto a mim... eu ainda não desejo desistir do concreto, então pensei em outra forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "Decidi focar na cor, então preciso encontrar cores mais intensas e pinceladas mais simples, porém poderosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "Ao mesmo tempo, preciso enfraquecer a iluminação e composição de cena tradicional... essas coisas afetarão minha expressão, então eu preciso pedir a eles que temporariamente saiam de cena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Mas o problema é que as cores intensas e fortes ditam o uso de muita tinta, e por isso preciso espremer a tinta diretamente na tela para conseguir o efeito necessário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Então, eu... uh, acabei ficando sem tinta. Porém, não posso apenas mover o meu cavalete no momento. Isso certamente afetaria meu trabalho criativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "Viajante, eu poderia te incomodar em pedir para visitar Boucicaut? Encomendei um lote de ótimas tintas com ele, e a essa altura já devem estar prontas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Ou, talvez... você poderia me ajudar a pegar um pouco de Néctar da Flor Gigante? Dessa forma, eu poderia fazer um lote de tintas por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Você pode usar néctar para fazer tinta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Hahaha, é claro que pode. Alguns de meus companheiros artistas até usam Ovos de Passarinhos para isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "Ouvi dizer que tintas desse tipo possuem cores delicadas, porém camadas bem ricas, perfeito para o uso na representação de cenários resplandecentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Você é uma boa alma, não é? Você recusaria o pedido de um artista necessitado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Tá bom, tá bom...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Certo, muito obrigado! Esperarei bem aqui. Apenas as traga direto para mim assim que você conseguir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Você é terrível... deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Você mesmo faz suas tintas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Haha, é claro! Essa é a primeira coisa que você deveria aprender como um pintor — é assim que você mantém o controle das imagens que você cria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Por que você não experimenta um estilo de pintura diferente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Isso mesmo. Alguns dos meus colegas também pensaram assim, e no momento estão tentando usar algum tipo de método \"figurativo\" de pintura para produzir algo mais abstrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "Os mais radicais entre eles deseja até mesmo desistir de retratar objetos concretos e simplesmente usar manchas de tinta para se expressarem... eles se chamam de \"Neodescricionistas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Mas devo dizer que até mesmo eu não consigo compreender seus trabalhos. No máximo, consigo sentir a beleza do ritmo contido nas manchas coloridas e as linhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Quanto ao o que cada pintura realmente expressa... eu só consigo pedir ao pintor que explique para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
