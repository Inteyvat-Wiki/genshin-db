			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230310101,
					"content": "#Hmm, pela sua aparência... Você é {F#a}{M#o} Viajante? Quanta elegância da sua parte vir até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310102
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310102,
					"content": "#Será que você é {F#outra}{M#outro} pescad{F#ora}{M#or} que está de olho nessa área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310103,
					"content": "Mandou bem! Esse daqui é o melhor ponto de pesca da região.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310104
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310104,
					"content": "Uh, você tem certeza? Não tem ninguém pescando aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310105,
					"content": "Mas é claro, eu posso ver o que os outros não veem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310106,
					"content": "Eu sou o melhor pescador daqui, é óbvio que vou prestar muita atenção na hora de escolher um ponto de pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310107,
					"content": "... Mesmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310108
					]
				},
				{
					"id": 230310108,
					"content": "Cadê seus peixes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310109,
					"content": "Oh, não digam mais nada. Eu mostrarei o que significa ser o \"Anzol Supremo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310110,
						230310111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310110,
					"content": "Anzol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				},
				{
					"id": 230310112,
					"content": "Me tragam alguns materiais. Com minhas iscas artesanais, eu pescarei peixes que vocês nunca imaginaram que existiam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310113
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310113,
					"content": "Isso parece meio suspeito... Essa sua isca artesanal realmente vai funcionar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310114,
					"content": "Bem, não custa nada tentar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310115
					]
				},
				{
					"id": 230310115,
					"content": "#Isso aí! Você é bem decidid{F#a}{M#o}! Gosto disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310116
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310116,
					"content": "Minha isca artesanal é baseada em Fruto do Pôr do Sol e Trigo, mas também um outro material que a deixa ainda melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310111,
					"content": "... Supremo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310112
					]
				}
			]
		},
