			"dialogs": [
				{
					"id": 230310601,
					"content": "Excelente, tenho todos os materiais. Agora, testemunhe a criação da minha isca incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310602,
					"content": "Kayvan habilmente prepara a isca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Certo, hora de pescar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310604,
					"content": "O anzol está numa boa profundidade... O fluxo da água está adequado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310605,
					"content": "Façam silêncio. Os peixes daqui são muito sensíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310606,
					"content": "Até o som de passos na margem pode assustá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310607,
					"content": "#Estou parad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "#Então sejam calm{F#as}{M#os} e esperem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310610,
					"content": "Kayvan fisgou algo encharcado.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "O que é isso? Isso aqui não é peixe nenhum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310612,
					"content": "Eu realmente nunca vi \"peixe\" como esse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "Isso aconteceu de novo. Como eu esperava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "#Ahem! Forasteir{F#as}{M#os}, fiquem tranquil{F#as}{M#os}. Não se preocupem tanto com esses detalhes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "Tudo que é fisgado por um anzol pode ser considerado um \"peixe\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "E falando a verdade, meu título de melhor pescador daqui não saiu do nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "Afinal, fisgar algo que não tem vida e nunca poderia morder uma isca é algo especial, não acham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Outros pescadores até mesmo elogiaram minhas habilidades únicas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
					"content": "Eu acho que eles estavam confortando você...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310621,
					"content": "Em outras palavras, você consegue fisgar qualquer coisa, menos peixes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310622,
					"content": "Ahem! Não me importo com o que eles pensam! Ao menos nunca volto de mãos vazias para casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310623
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310623,
					"content": "Se eu não me der bem hoje, eu volto amanhã. Eu um dia certamente fisgarei um peixe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310624
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310624,
					"content": "Obrigado por ter me ajudado a encontrar os materiais. Essa recompensa é para você. Vou continuar pescando em outro lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310625
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310625,
					"content": "Da próxima vez... Da próxima vez, com certeza vou pegar um peixão! Estou certo disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310620,
					"content": "Acho que estavam zombando da sua cara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310621
					]
				},
				{
					"id": 230310608,
					"content": "Paimon nunca pisa no chão.",
					"roleType": "TALK_ROLE_PLAYER",
