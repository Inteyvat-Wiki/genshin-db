				{
					"id": 760710301,
					"content": "Maravilhoso, obrigada! Com esse trigo fresco, finalmente posso fazer pão quente e reconfortante de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710302
