			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Se eu pudesse fazer um pão delicioso, tenho certeza de que isso animaria todo mundo. Mas, do jeito que as coisas estão, não é tão fácil assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710102,
					"content": "Está com algum problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Estou tentando recriar um tipo de pão que minha mãe costumava fazer para mim quando eu era pequena. Ele tinha um formato meio parecido com um cogumelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710106,
					"content": "Pelo que me lembro, primeiro se cozinha cogumelos e frutas silvestres até virar um recheio espesso, depois se envolve tudo em uma massa recém-amassada e se assa junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710107,
					"content": "A parte mais importante é usar farinha feita de trigo recém-colhido. É isso que dá ao pão aquele sabor acolhedor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710108,
					"content": "Vim até aqui esperando conseguir um pouco de trigo, mas parece que ninguém teve tempo de cuidar dos campos ultimamente. Agora, há todo tipo de criaturinhas estranhas vagando por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710109,
					"content": "Se o Sr. Valdis estivesse aqui, tenho certeza de que ele saberia lidar com elas. Mas eu realmente não sou bom nesse tipo de coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710110,
					"content": "Então, hã... você poderia me ajudar a colher um pouco de trigo? Só preciso de um pouquinho. Em troca, posso te ensinar a fazer pão quente de cogumelo. Por favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				},
				{
					"id": 760710103,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Ei, não vá ainda. Poderia me dar uma mão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratniki"
				}
			]
		},
