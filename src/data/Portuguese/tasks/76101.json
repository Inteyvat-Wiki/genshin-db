			"dialogs": [
				{
					"id": 761010301,
					"content": "Vovô, voltamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Estou vendo que voltaram em segurança. Como está a situação no Penhasco Kipumaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Você conta o que aconteceu...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Como eu imaginei... Está claro aqui. O Pilar de Embla caiu para o Abismo... e chamam esse inimigo imortal de o Professor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Dito isso, a situação está calma tem um tempo. Imagino que a Srta. Alia está lutando para controlar ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Ela está segurando a linha para nós, devemos aproveitar ao máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "E graças a Flins e os demais, os preparativos estão quase completos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "E agora que você trouxe de volta a Lâmina Espiral, a Flecha de Terpikeraunas finalmente está pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Hã, o que é a Flecha de Terpikeraunas? É outra relíquia super poderosa, como o Pavio de Prata e a Lâmina Espiral?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Haha, é ainda melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Cinco séculos atrás, o Iluminador não tinha forças para eliminar o inimigo imortal, conseguindo apenas selá-lo sob o Penhasco Kipumaki. Ainda assim, ele não fraquejou. Junto com a primeira Emissária da Canção Lunar, eles avançaram na esperança de uma vitória futura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Eles forjaram esse arco com uma técnica antiga, e quando chegou o dia de acabar com esse inimigo imortal, estavam prontos. Desde então, ela foi passada de geração em geração dos Portadores da Lâmpada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Agora, finalmente, chegou a hora dela cumprir seu destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Uau, isso parece incrível! O que ela faz? Podemos ver?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "Vocês já viram. Na verdade, estamos dentro dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "O quê!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "Você não vai disparar a gente ou algo do tipo né? Né?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Esse grande salão de malte foi construído para abrigar a Flecha de Terpikeraunas, e a Lâmina Espiral recuperada por vocês é a ponta que há muito estava faltando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Assim que a Lâmina Espiral estiver posicionada, a Flecha estará pronta para ser disparada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "Mas essa coisa é uma lareira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "De fato, é mesmo! Mas também serve como um mecanismo que molda a Lâmina Espiral em uma ponta de flecha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Precisamos agir antes que o Ovo do Cataclismo choque. Este arco e flecha foram passados de geração em geração para este momento — para acabar com a ameaça de uma vez por todas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Enquanto você prepara o tiro, aquele inimigo imortal provavelmente atacará uma última vez. Seja lá o que for que venha em nossa direção, vamos impedi-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "O disparo da Flecha de Terpikeraunas está nas suas mãos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "#Eu vou ser disparad{F#a}{M#o} junto com a flecha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Então, {NICKNAME} é a nossa arma definitiva! Espera, isso tem que ser uma brincadeira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
