					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#Espera, {NICKNAME}, Nikita... não é aquele velhote que nos pediu para procurar pelo Pavio de Prata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
