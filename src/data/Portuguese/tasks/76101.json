			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Hehe, parece que chegamos na hora! Esse lugar tá bombando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Todo mundo tá trabalhando duro ultimamente. Agora que as coisas se acalmaram, pudemos ter um momento para reunir todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Não deve ter sido fácil para você também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "Eu apenas fiz o que era esperado de mim. Mas... se você não interviesse naquela hora, as coisas poderiam ter acabado de forma bem diferente. Talvez ainda teríamos vencido... mas não sem pagar um preço muito mais caro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Vamos lá, estamos nisso juntos, não é? Não precisa ser tão sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Sim, você tem razão. Oh, parece que o Vovô está prestes a falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "A todos os nossos companheiros e familiares — isso não é apenas uma celebração. É um momento para honrar a luta por trás de nosso triunfo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "Ao celebrarmos essa vitória, não vamos nos esquecer daqueles que deram tudo para tornar ela possível. Com o seu sangue, eles cumpriram a promessa que todos nós fizemos um dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "Durante essa batalha, o pelotão de investigação \"Pássaro da Noite Assombrada\" liderado por Illuga, estava na missão mais perigosa de todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#Especialmente, {NICKNAME} e sua companheira avançaram sem hesitação em um momento de crise, ficaram conosco, cumprindo um papel vital no sucesso da operação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "#El{F#as}{M#es} enfrentaram todos os perigos, seguiram em frente apesar da tempestade e abriram o caminho para a vitória em meio das profundezas do desespero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "O legado de seus feitos, e de todos que lutaram pelos vivos e pelos que virão será escrito na história, e nunca desaparecerá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Sim, fomos vitoriosos! E essa vitória veio com um preço, e agora que façamos um momento de silêncio para os mortos, para lembrar os que caíram... mas que não sejamos destruídos pelo luto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "O futuro que lutamos está no alcance de nossas mãos, e carregamos o fogo daqueles que o acenderam antes de nós. Sua luz deve continuar brilhando, e nós devemos continuar avançando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Mas hoje, vamos erguer nossos copos, para a vitória, para as almas corajosas que nunca serão esquecidas, e para o futuro que juramos proteger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
