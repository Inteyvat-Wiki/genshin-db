			"dialogs": [
				{
					"id": 741890501,
					"content": "Um momento, por favor. Você gostaria de saber um segredo sobre o tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Que segredo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "Tem a ver com o tesouro e a chave para abrir o portão. Como isso soa? Interessado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Você não tá me pedindo para lutar contra monstros de novo, tá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Claro que não! Não sonharíamos em pedir que clientes da taverna fizessem serviços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "Vê essa artilharia naval ao meu lado e os entulhos na direção dela??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Ative o canhão e exploda essas pedras, qualquer tesouro que você descobrir é seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Quem em Tevyat deu nome a esse canhão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "O timoneiro. Não tenho certeza de onde ele tirou isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Pode falar. Quais componentes estão faltando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "#Acho que você entendeu errado, amig{M#o}{F#a}. O canhão está inteiramente intacto e totalmente energizado. Cuido dele todo dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "Mas antes que você ative o canhão, eu gostaria que você respondesse várias perguntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "É a pedido do timoneiro. Ele disse que era uma boa fonte de diversão para os clientes da taverna, algo para frear a bebida deles e mantê-los aqui por mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Não tenho certeza disso, mas pode perguntar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Pergunta 1: Quantas mesas existem no Leme Enferrujado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "Pergunta 2: Quantos trabalhadores temos no Leme Enferrujado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Pergunta 3: O que não é servido no Leme Enferrujado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "É isso. Você só precisa responder essas três perguntas corretamente para ativar o canhão, explodir os entulhos e pegar o tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "O que vai acontecer depois que eu pegar o tesouro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "Em seguida, vou achar o momento certo para colocar outro prêmio adequado na caverna e selá-lo com entulho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "O tesouro está aguardando para ser reivindicado quando nosso próximo convidado ativar a artilharia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "Isso é muito trabalho para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "Isso é tudo. Vocês podem procurar as respostas agora. Enquanto isso, ficarei aqui esperando vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Pense num chefe terrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "Eu acho difícil descordar de seu comentário, mas ainda tenho que encontrar um jeito de apontar o canhão ao timoneiro sem que ele perceba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "Além disso, disparar na direção errada pode prejudicar outros clientes na taverna, entrando em conflito com meus princípios morais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Pode falar. Como ele é energizado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "Você não tá me pedindo para encontrar algo ou alguém para você de novo, tá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
