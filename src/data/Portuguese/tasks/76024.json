						"pointId": 360700070
					}
				]
			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Sabe, a Paimon acabou de notar que todos os Furões Ladrões fugiram naquela direção, praquela colina ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "É, e foi algo que os grandalhões que treinaram os Furões Ladrões trouxeram. O Chefão Furão Ladrão usou isso pra dar uma surra nos grandalhões — fez eles saírem rolando e engatinhando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Difícil de imaginar essa cena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Eeeenfim, de qualquer forma, vamos pra aquela colina investigar. Fica de olho pra ver se tem emboscada de Furão Ladrão, {NICKNAME} — Paimon prefere não ter que sair rolando... ou engatinhando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "Agh, se ao menos eu estivesse lá na hora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "Espera, você teria tentado ajudar? ... Não, você só ia ficar assistindo a confusão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
