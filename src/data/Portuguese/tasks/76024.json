			"dialogs": [
				{
					"id": 760240101,
					"content": "Hehe. É o fim da linha pra vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Huh. É a primeira vez que vejo o Chefão Furão Ladrão de perto... Ah, é mesmo. Você também tem que chamá-lo de Chefão, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "Como é... Sem chance de Paimon chamar um Furão Ladrão qualquer de \"Chefão\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Você tem razão. Crianças ruins não podem ser chefões, né? Ninguém vai pros funerais deles também... mesmo que eles tenham um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Ah, certo! Ouvi Helka dizer que tem umas pessoas estranhas que comem carnes estranhas, tipo a de Furão Ladrão. E tem gente que gosta de colecionar espécimes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "De todo jeito, não vai precisar de funerais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Hmm, Auni... Você tá dizendo mesmo essa coisa assustadora toda com a cara limpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Esse aqui parece aterrorizado...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Chefão Furão Ladrão"
				},
				{
					"id": 760240136,
					"content": "Parem! Não ousem sair correndo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Hã? Não tá correndo... tá esperando por nós? Então vamos lá ver o que tá acontecendo, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602402,
