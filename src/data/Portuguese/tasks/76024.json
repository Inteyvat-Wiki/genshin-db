							9656.33
						],
						"pointId": 11564
					},
					{
						"sceneId": 3,
						"position": [
							1651.032,
							213.487,
							9656.428
						],
						"pointId": 360700011
					},
					{
						"sceneId": 3,
						"position": [
							1650.233,
							213.48,
							9657.646
						],
						"pointId": 360700069
					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#Hmm, você era bem mais forte do que aqueles grandões, {NICKNAME}. Acho que tamanho não é tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240202,
					"content": "#Hehe, não é mesmo? {NICKNAME} não é a pessoa mais alta de todas, mas {M#ele}{F#ela} acaba com monstros dez vezes maiores que {M#ele}{F#ela} facinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240203,
					"content": "Ah, imagina, eu só tento. Paimon que se garante de verdade aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "Hã?! Hmm, ficar elogiando não vai te... E-Espera, talvez te dê... metade do pedaço de Paimon da próxima vez que a gente comer uma coisa legal, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240206,
					"content": "#Então você pode expulsar os Chefões Furões Ladrões do Vale Toupeirado, né, {NICKNAME}? Essa não é a casa deles, mas eles sempre bagunçam tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240207,
					"content": "Funerais que deviam acontecer não acontecem, e o Vovô Toupeirinha pode ter sido morto por causa deles também. Mas se vamos fazer novos funerais, vamos ter que encontrar todos primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240208,
					"content": "Hã?! Os Furões Ladrões... Além disso, Paimon pode saber... Quando você mencionou funerais antes, você tá dizendo que as pessoas fazem eles mesmo aqui? Por que aqui de todos os lugares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240209,
					"content": "Claro. Já fiz todos os preparativos e pensei em quais canções cantar também. Aqui, dá uma olhada, mas fique em silêncio. Deixe ele descansar em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240210,
					"content": "Auni pega uma caixa de fósforos pequena do bolso e abre. Um besouro colorido muito bonito repousa sobre um tecido florido dentro. Tem até algumas pétalas enfeitando a cena...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "Ele foi ao seu descanso eterno, então temos que fazer um funeral pra ele. Mas todos os lugares que escolhi são morros com máquinas neles, e foram todos ocupados por aqueles Furões Ladrões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240212,
					"content": "Se a família do Vovô Toupeirinha não tivesse fugido, eles estariam provavelmente mortos. A destruição da casa deles pelos Furões Ladrões foi nesse nível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240213,
					"content": "#({NICKNAME}, você acha que esse \"Vovô Toupeirinha\" que ela fala é, na verdade...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240214,
					"content": "(Algum tipo de animal pequeno, eu acho.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "(É, a Paimon também acha. Provavelmente é um amigo animal dela.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240218,
					"content": "Hmmm. Sabe de uma coisa? Que tal a gente te ajudar a pegar esses Furões Ladrões malvados e sem-vergonha? E quanto à família do Vovô Toupeirinha... A gente pode procurar por eles depois que esses ladrões forem levados à justiça. Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240219,
					"content": "Poxa. Vocês são gente boa de verdade, hein. Vou convidar vocês pro funeral, com certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240220,
					"content": "Bem, isso não é exatamente necessário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240221,
					"content": "Tá bom. Nesse caso, podem ficar com a escultura de açúcar que comprei mais cedo— Hã. Parece que acabou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240222,
					"content": "Mas ainda tenho o dinheirinho que a Jurva me deu — vocês podem pegar e comprar umas esculturas de açúcar pra vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240223,
					"content": "Se você pede ajuda pras pessoas, tem que retribuir, e tem que agradecer. É assim que as coisas devem ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240224,
					"content": "Ah, Paimon. Pensar que você pegaria doce das mãos de uma criança...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "Ei, por que tá fazendo parecer que Paimon é algum tipo de vilã? Ainda assim, você é muito educada pra uma criança, Auni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240227,
					"content": "Valeu! Mas cada um só vai ganhar Mora suficiente pra uma escultura de açúcar. Me elogiar não vai fazer vocês ganharem mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240228,
					"content": "E aí você surpreende sendo tão prática nessas horas... Mas parece que estamos lidando com mais de um Furão Ladrão, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240229,
					"content": "Isso mesmo. Aquele que fugiu agora há pouco não é o Chefão dos Furões Ladrões que eu vi antes. Na verdade, não faço ideia de quantos irmãozinhos ele tem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240230,
					"content": "Mas dá pra encontrar as mesmas garras robóticas que disparam projéteis lá também, então talvez a gente encontre mais Furões Ladrões por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240231,
					"content": "Certo. Não vamos deixar esses Furões Ladrões escaparem dessa vez. Vamos dar uma lição neles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240226,
					"content": "Um senso de decoro admirável mesmo, Auni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "(Pode ser alguém que morava aqui antes.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "(Hã? Mas esse lugar nem parece ter sido lar de ninguém por muito tempo... É mais provável que seja um dos amigos animais dela mesmo! Ela até faz funerais pra insetos, afinal.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240205,
					"content": "Eu também não pego leve com monstro pequeno!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
		{
			"id": 7602403,
