			"dialogs": [
				{
					"id": 760241501,
					"content": "Ah, olha. É a família Toupeirinha toda. Vovó, Papai, Mamãe, Toupeirita e Toupeirinhazinha... e o resto todo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "Ah, então você tava falando de Toupeiras Cheiradeiras! Espera, como você sabe a diferença? Elas todas parecem iguais pra Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "As personalidades, claro! Você vai entender se passar tempo suficiente com elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Mas todas têm o mau hábito de implorar por coisas dos humanos. *Suspiro* Pobres bichinhos. Se a gente entrasse em extinção, o que aconteceria com eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "...Humanos? Extinção? E as Toupeiras Cheiradeiras iam tá vivas depois disso? Provavelmente não, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Mana Linnea diz que animais entram em extinção por vários motivos. Isso significa que humanos podem entrar em extinção também. Como você não sabe disso, Paimonzinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "Acho que eu duraria mais do que uma Toupeira Cheiradeira, pelo menos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Bem, isso não responde à pergunta de Auni, né? Hmm... Pensando nisso, humanos tão mesmo num lugar assustador com todas essas coisas ameaçando eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Mas enfim, de volta ao assunto, o que vamos fazer com esses três Furões Ladrões agora que encontramos nossas toupeiras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Se a gente não sabe, vamos só levar eles para o pessoal no Navio-Chefe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "Tesouro! Ou devemos chamar de suborno nessa situação? Ah, que seja. Já que eles tão dando, é melhor pegar logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#Bem, eles parecem arrependidos, pelo menos. Vamos deixar passar dessa vez, {NICKNAME}. Mas claro que não é por causa do tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Dizem que os insetos precedem os humanos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "É bem provável que eles vão resistir quando a gente se for.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "Espera, então a gente vai perder pros insetos?... Ugh, Paimon tá meio abalada com isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
		}
