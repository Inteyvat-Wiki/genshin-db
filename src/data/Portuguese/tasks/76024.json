			},
			"dialogs": [
				{
					"id": 760240801,
					"content": "Ah, certo. Ainda preciso fazer aquele funeral. Será que eu deveria convidar os outros da Gangue da Concha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240802,
						760240805,
						760240808
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240802,
					"content": "Me fale um pouco da Gangue da Concha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "Ah, não quer se juntar a nós? Se quiser, fale com Jurva. Ele tá no \"Speranza\". Mas Helka não tá aqui pra votação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Ah, de boa. Tenho certeza que Jurva dá um jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "Me fale um pouco das Toupeiras Cheiradeiras...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Eu acho que eles começaram a pegar hábitos humanos vivendo perto deles por tanto tempo. Furões Ladrões fazem isso também, e ouvi dizer que os Saurianos de Natlan também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Mas não tenho certeza se isso é bom ou ruim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
					"content": "Até depois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "Cuide-se na estrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
