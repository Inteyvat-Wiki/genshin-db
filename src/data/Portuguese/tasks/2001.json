			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rongshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "Você suou muito, isso é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010602,
					"content": "Reconheço a minha derrota, você que é melhor, ainda preciso praticar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010603,
					"content": "Você também é muito forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "Sim, eu escapei por pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010606,
					"content": "Se você possuísse uma Visão, com certeza seria ainda mais incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010607,
					"content": "Quando eu era pequeno, eu também queria uma Visão. Diziam que só precisava ser forte que eu teria uma chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010608,
					"content": "Mas eu não consegui uma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010609,
					"content": "Com o tempo eu perdi o interesse. Não se pode depender de uma Visão como se depende do próprio corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010610,
					"content": "Eu também venci muitas pessoas que tinham Visões. Eu não cobiço esse tipo de poder dado pelos deuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010611,
					"content": "Uh? Então você não veio aqui pela aquela Visão sem mestre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010612,
					"content": "Não, eu só queria participar do Torneio para ver quem era mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010613,
					"content": "Apenas derrotas fazem perceber a diferença, daí vem o crescimento de verdade. Portanto, fico feliz, pois não é fácil para eu perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010614,
					"content": "Uau... Isso sim é a força falando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010615,
					"content": "Se tivermos outra chance no futuro, gostaria de lutar contra você novamente. Eu continuarei a ficar mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010616,
					"content": "Eu também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "Oh, sim. Você sabe quem participará da final do Torneio? Aquela pessoa é ainda mais forte que você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010618,
					"content": "Não sei se há alguém mais forte do que eu. Mas ouvi dizer que ele é muito rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010619,
					"content": "Não baixe sua guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010604,
					"content": "Você tem o potencial para se tornar o Campeão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
		{
