			},
			"dialogs": [
				{
					"id": 20011301,
					"content": "Sua força na batalha é realmente incrível, ainda que seu oponente seja rápido, não deve ser capaz de vencer você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011302,
					"content": "Aquele competidor da rodada final do torneio é um especialista em ajustar sua respiração, em conservar seu equilíbrio. Ele faz movimentos que são difíceis para uma pessoa comum realizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011303,
					"content": "Ele depende inteiramente do ataque surpresa para derrotar seus oponentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011304,
					"content": "Em outras palavras, contanto que você preste atenção à habilidade dele de detectar pontos fracos, seus ataques não serão uma ameaça para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011305
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011305,
					"content": "#Obrigad{F#a}{M#o}, não o subestimarei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011306
					]
				},
				{
					"id": 20011306,
					"content": "Por favor, não precisa agradecer. Eu que devo ficar grato pela oportunidade de testemunhar seu controle dos elementos que desafia todos os princípios conhecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011307,
					"content": "O mundo é um lugar verdadeiramente misterioso, ao que parece, e sempre haverá algo desconhecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011308,
					"content": "Você parece meio obcecado pelas Visões... mas você já não tem a sua? Por que está tão empenhado em explorar a conexão entre as Visões e os elementos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011309,
					"content": "Desejo saber que significado as Visões têm para os deuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011310,
					"content": "E o que influencia a decisão dos deuses de conceder aos humanos essas Visões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011311,
					"content": "#Peço desculpas, você deve estar completamente perdid{F#a}{M#o} em relação a esses assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011312,
					"content": "Por me permitir a honra de testemunhar seus atos místicos, estou disposto a responder a quaisquer perguntas que você possa ter sobre Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011313,
					"content": "#Realmente estou perdid{F#a}{M#o}, então me oriente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011314
					]
				},
				{
					"id": 20011314,
					"content": "#Então é sobre isso que você está curios{F#a}{M#o}? Haha, deixe-me contar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011315,
					"content": "Vocês também devem saber que Inazuma proclamou o Decreto de Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011316
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011316,
					"content": "As Visões originalmente eram presentes dos deuses. As pessoas as recebiam, mas agora inexplicavelmente elas estão sendo recolhidas, e às vezes elas também estão trazendo a morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011317,
					"content": "Supondo que cada um dos Sete Arcontes tivesse seus critérios para conceder Visões aos seres vivos - então a atual Arconte Electro duvida das razões deles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011318,
					"content": "Sem nenhuma nova Visão Electro sendo concedida por um longo tempo, talvez isso represente a atitude da Shogun Raiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011319,
					"content": "Ela soa menos como uma Arconte e mais como... Uma tirana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011320,
					"content": "Pelo que eu sei, ela é uma Arconte que busca a eternidade. Ela fará implacavelmente o que quiser, sem levar em conta o que os outros pensam ou sentem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011321
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011321,
					"content": "Os \"contratos\" de Liyue visam beneficiar todos os que residem em Liyue. Mas como a busca de Inazuma pela \"eternidade\" beneficiaria seu povo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011322,
					"content": "...Nem é preciso dizer que as pessoas presas em Inazuma não estão nada bem hoje em dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011323,
					"content": "Parece muito com algo que a deusa que você encontrou no início faria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011324,
					"content": "Oh? Você já encontrou a Arconte Electro antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011325,
						20011326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011325,
					"content": "Não tenho certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				},
				{
					"id": 20011327,
					"content": "Apenas nós mudamos com o tempo, e não a Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011328,
					"content": "Se você quiser encontrá-la, ela estará para sempre lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011329,
					"content": "Chegará o dia em que eu também desejarei conhecer as respostas dela para a \"eternidade\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011330,
					"content": "Ah, está chegando a hora do seu combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011331
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011331,
					"content": "Oh, certo! Ficamos tão distraídos conversando sobre Inazuma que Paimon se esqueceu completamente do torneio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011332,
					"content": "Se você não tem outros assuntos para tratar, podemos voltar juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011333,
						20011335
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011333,
					"content": "Claro, vamos juntos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011334
					]
				},
				{
					"id": 20011334,
					"content": "Muito bem, vamos embora. Quero ver quem ganhará a Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011335,
					"content": "#Voltarei sozinh{F#a}{M#o} daqui a pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011336
					]
				},
				{
					"id": 20011336,
					"content": "Muito bem. Apenas certifique-se de não se atrasar para a partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011326,
					"content": "Isso foi há muito tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				}
			]
		},
