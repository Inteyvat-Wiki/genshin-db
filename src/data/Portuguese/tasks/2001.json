			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "Agora que estamos sozinhos, vou direto ao ponto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011102,
					"content": "Você é hábil em manipular os elementos. E não apenas um único elemento, mas múltiplos. Estou certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011103,
					"content": "Ah, então você já sabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "Paimon sabia que você estava insinuando algo desde o momento em que nos conhecemos. Você sempre soube.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011106,
					"content": "Uh, isso não é algo que eu podia mencionar na arena. Se os outros competidores soubessem que você pode utilizar Energia Elemental, acabaria atraindo atenção desnecessária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011107,
					"content": "Se não me engano, você pensa da mesma forma, dada sua relutância em usar habilidades elementais mesmo no calor de uma partida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011108,
					"content": "Sim, mas como você soube?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "Hehe quando falo sobre o que vejo ou ouço em você, isso não é um simbolismo poético. Digo essas coisas no sentido mais verdadeiro possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011110,
					"content": "Desde muito jovem, estou em sintonia com os sinais da natureza. Ouço o sopro do vento e os sussurros das folhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011111,
					"content": "São coisas desse tipo que também ouço vindo de você, nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011112,
					"content": "Por mais louco que pareça, de alguma forma Paimon ainda acredita em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011113,
					"content": "Minhas habilidades humildes são insignificantes em comparação com seus feitos incríveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011114,
					"content": "E pensar que um humano poderia dominar os elementos sem uma Visão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011115,
					"content": "E sem falar na sua criatura misteriosa com cheiro incrivelmente complexo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011116,
					"content": "Ei, pare de avaliar Paimon com base em meu cheiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011117,
					"content": "Por acaso poderia esclarecer como conseguiu obter suas habilidades elementais combinadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011118,
					"content": "Também não sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "Hmm, extraordinário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011121,
					"content": "Posso ser ousado e perguntar como exatamente você aprendeu a canalizar a Energia Elemental e até mesmo manipulá-la em combate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011122,
					"content": "Tudo graças ao conhecimento de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "#Hehe, não se preocupe. Paimon só falou o que pensou para {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011125,
					"content": "#Foi uma longa jornada, e muitas coisas aconteceram no caminho. De alguma maneira, {F#ela}{M#ele} naturalmente aprendeu a utilizar os elementos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011126,
					"content": "Sinceramente, nem a Paimon entende como tudo isso funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011127,
					"content": "Talvez essas coisas inimagináveis sejam a essência dos deuses e das Visões que eles concedem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011128,
					"content": "No entanto, ainda quero ter a honra de ver como você manipula os elementos. Talvez isso ainda me revele algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011129,
					"content": "Claro, eu também compartilharei com você tudo o que aprendi. Será uma troca justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011130,
					"content": "Combinado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "Então, que tal testarmos suas habilidades agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011131,
					"content": "Finalmente, uma verdadeira batalha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "Tudo graças à companhia de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "Tudo que fiz foi tocar uma Estátua dos Sete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "Não surpreende você não querer falar na arena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
		{
			"id": 200113,
