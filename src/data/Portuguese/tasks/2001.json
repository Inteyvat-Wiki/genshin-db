	"talks": [
		{
			"id": 200103,
			"completionStepIds": [
				200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200103",
							"2"
						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "#Hahaha, eu sabia que não me arrependeria de apresentar você como {F#a}{M#o} favorit{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010302,
					"content": "#Você também viu, Kazuha! {F#Ela}{M#Ele} não teve nenhum problema ao lutar, venceu fácil e rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010303,
					"content": "#Impressionante. Mas também observei que noss{F#a}{M#o} favorit{F#a}{M#o} se conteve, como se fosse para proteger o adversário de sérios danos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010304,
					"content": "#Eu já lutei em todos os tipos de batalha incontáveis vezes, mas somente aqui eu pude sentir claramente o poder real {F#dela}{M#dele}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010305,
					"content": "#Vamos lá, todos sabemos que você tem um amplo vocabulário - não poderia dizer uma ou duas palavras para parabenizar noss{M#o}{F#a} campe{M#ão}{F#ã} em ascensão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010306,
					"content": "Tudo bem... Deixe-me pensar em como expressar adequadamente um elogio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010307,
					"content": "...Você lutou muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010308,
					"content": "Ugh, tudo bem então. Pensei que seu poeta interior poderia se juntar à diversão, mas... Acho que não deveria colocar você em uma situação difícil assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010309,
					"content": "#Sabe, muitos competidores me procuraram dizendo que estavam surpresos com a participação d{M#o}{F#a} {M#herói}{F#heroína} de Liyue no torneio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010310,
					"content": "...E desde que você se inscreveu, muitos outros fizeram o mesmo, incluindo alguns lutadores de alto nível. Tenho certeza de que muitos deles estão aqui para descobrir como se sairiam contra você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010311,
					"content": "Não sabia que eu era tão popular...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "#Haha. Bem, já que todo mundo quer derrotar você, acho que devo começar a tratá-l{F#a}{M#o} dessa forma também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010314,
					"content": "#Não queremos que você desperdice toda sua energia nas primeiras rodadas lutando contra pessoas que estão bem abaixo do seu nível. Sem falar que... você deve estar ansios{F#a}{M#o} para lutar contra alguém à sua altura, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010315,
					"content": "Então vou mandar você direto para as semifinais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010316,
					"content": "Hã? Mas acabamos de começar as eliminatórias... Seria meio maluco pularmos direto para as semifinais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010317,
					"content": "Esse é o jeito da Capitã Beidou. Você não vai convencê-la do contrário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010318,
					"content": "Além disso, com seu nível, você chegaria às semifinais de qualquer maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010319,
					"content": "Sinceramente, Paimon estava pensando isso também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010320,
					"content": "Tudo bem, vou assistir mais um pouco do torneio. Se houver algum candidato em potencial para você, quero saber quem ele é e o que pretende fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010321,
					"content": "Finalmente estamos aqui, pessoal! O verdadeiro show está prestes a começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010322,
					"content": "Hehe, a Capitã parece ter grandes esperanças para este torneio. Eu não a vejo tão animada há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010323,
					"content": "Seu oponente lutou muitas rodadas para chegar às semifinais. Isso faz dele um guerreiro experiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010324,
					"content": "Talvez ele não seja tão forte como você, mas você também não vai baixar a guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010325,
					"content": "Não irei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "#Muito bem. Mostre-me que você está pront{F#a}{M#o} para enfrentar a tempestade que está por vir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010328,
					"content": "Tudo bem, já chega de conversa fiada. O público está esperando. Procure a tripulante que fez sua inscrição. Ela levará você até a arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010326,
					"content": "Não esqueci porque estou aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "Não vejo motivos para fazerem isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
			"id": 200106,
			"completionStepIds": [
				200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
