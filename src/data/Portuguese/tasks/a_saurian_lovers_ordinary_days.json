						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "\"...Hoje é um dia chuvoso. Eu preparei para \"Ondinha\" seu <color=#00E1FFFF>Ceviche</color> favorito. Sua expressão satisfeita fez tudo valer a pena...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240202,
					"content": "\"...Mesmo se ele estiver nadando despreocupadamente, é só oferecer um pouco daquele <color=#00E1FFFF>Ceviche</color>, e vuush! Ele pula da água, e de forma bem adorável...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240203,
					"content": "\"...Eu jamais duvidaria do seu carinho por mim. Apenas, talvez, que ele ame <color=#00E1FFFF>Ceviche</color> bem mais...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240204,
					"content": "Então... Ondinha é o nome desse Koholassauro, né? Acho que o Ceviche no pote no acampamento deve ter sido preparado para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "\"...Olhos grandes e redondos, rabinho enrolado e voz alegrinha... Jade, oh, Jade, existe uma Sauriana nesse mundo mais fofinha do que você...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240206,
					"content": "\"...Você nunca foi enganada, nem nunca duvidou, como se toda vida existente pudesse se tornar sua amiga e aproveitar bons momentos brincando com você...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240207,
					"content": "\"...Se eu não fosse tão ocupado, eu adoraria brincar com você o dia inteiro, te assistir correr pela floresta, banhando-se pelos raios de sol, como uma criança do vento, um espírito tão livre!...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240208,
					"content": "#Ah, então aquele pequeno Yumkassauro se chama \"Jade\". Pelo visto, rapazinho bem brincalhão. Talvez vocês dois poderiam ser amigos, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "\"...Atravessei montanhas e vales para encontrar seu paradeiro. Se você realmente desejava não me ver, você poderia ter partido...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240211,
					"content": "\"...Mas você teve consideração pelo meu ritmo, parando de vez em quando, até mesmo coletando diversas frutas para mim, sem falar naquelas pedras brilhantes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240212,
					"content": "\"...Ó, Calêndula, minha doce Calêndula, apenas eu conhecia o coração tenro debaixo dessa sua casca dura. Ser uma guerreira destemida nunca foi sua intenção...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240213,
					"content": "Err, então, Calêndula é aquele Tepetlissauro emburrado? Chame Paimon de cega, mas ela não consegue mesmo ver como isso conta como \"tenro\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Enfim, de volta ao assunto. Então, esses três Saurianos são... amigos dele? Por que eles o deixaram inconsciente e o cercaram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Vamos tirar ele primeiro e perguntar depois.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "É, é verdade. Se pelo menos conseguíssemos fazer eles saírem... Espera aí, o diário não disse que Ondinha gosta de Ceviche? Tem um pouco no acampamento, aí talvez a gente consiga atrair ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#Quanto a Jade... Vamos mandar {REALNAME[ID(2)|SHOWHOST(true)]} para fazer amizade, que tal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Boa ideia! Jade é do tipo que gosta de diversão, então {REALNAME[ID(2)|SHOWHOST(true)]} só precisa atrair ela para algum lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "Rawr! Rawr rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#Viu, {REALNAME[ID(2)|SHOWHOST(true)]} também tá animado com o plano! Mas talvez a forma mais simples e com menos desperdício seria de usar o Ceviche, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "Poderíamos duelar com Calêndula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Errr, vamos resolver isso de forma mais pacífica, que tal? Tipo, fazer {REALNAME[ID(2)|SHOWHOST(true)]} atrair a brincalhona Jade para longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
