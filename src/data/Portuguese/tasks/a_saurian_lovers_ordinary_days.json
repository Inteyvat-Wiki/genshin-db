					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240904,
					"content": "Legal! Então vou deixar com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240905,
					"content": "#Vamos checar o sujeito e ver se ele está bem assim que {REALNAME[ID(2)|SHOWHOST(true)]} atrair Jade, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
