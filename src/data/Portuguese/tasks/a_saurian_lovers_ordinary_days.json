			"dialogs": [
				{
					"id": 750240101,
					"content": "Minha nossa, seu entusiasmo é... bem avassalador. Ufa... Um pouco de gelo para esfriar a cabeça, e então falaremos sobre isso mais tarde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Ikayo"
				},
				{
					"id": 750240102,
					"content": "Shrawrr—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "\"Calêndula\""
				},
				{
					"id": 750240103,
					"content": "Você primeiro escuta um grito, seguido de uma batida de algo pesado caindo no chão. Então, tudo que restou são os gritos dos Saurianos...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "Hã!? Aquela pessoa está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Uh, ele está cercado... Não conseguimos ver o que está acontecendo de jeito nenhum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "Que tal tentarmos ver de cima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#Hmm. Parece que {REALNAME[ID(2)|SHOWHOST(true)]} quer tentar — pode ir então, amiguinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "Grawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "#Uh, algo não está certo. Aquela pessoa está morta? Urg, não, não! Talvez ele só esteja desmaiado. Mas, mesmo assim, não podemos só ficar parad{M#o}{F#a}s aqui sem fazer nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Uh, vocês três poderiam nos dar licença?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "Rawr! Grawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "\"Calêndula\""
				},
				{
					"id": 750240113,
					"content": "Mmrawr...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "\"Ondinha\""
				},
				{
					"id": 750240114,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "\"Jade\""
				},
				{
					"id": 750240115,
					"content": "Eita, eles não vão deixar a gente passar de jeito nenhum... O que está acontecendo? Considerando o que aquela pessoa disse antes, ele deve conhecer esses Saurianos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Se pelo menos tivéssemos mais pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "...Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#Hmm? Você descobriu algo, {REALNAME[ID(2)|SHOWHOST(true)]}? Vá, então, a gente te segue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502402",
