			"dialogs": [
				{
					"id": 750240901,
					"content": "Hehe, parece que ela foi atraída pelo cheiro da comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240902,
					"content": "#Mas a abertura não é larga suficiente. Você poderia nos ajudar a atrair Jade para longe, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240903,
