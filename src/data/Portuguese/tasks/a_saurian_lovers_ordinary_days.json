					"content": "Shrawrr—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "\"Calêndula\""
				},
				{
					"id": 750240602,
					"content": "Não fique tão agoniado, só estamos checando para ver se o carinha lá não está machucado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Parece que é hora do duelo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "Qual é, não desista tão rápido! Veja, nem queremos fazer mal nenhum, e nós... Bem, temos certeza que você não é do tipo brigão por natureza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Rawr! Grawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "\"Calêndula\""
				},
				{
					"id": 750240607,
					"content": "Oh, não... Está ficando mais bravo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "\"Oh Calêndula, minha doce Calêndula\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
			"id": 7502407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
