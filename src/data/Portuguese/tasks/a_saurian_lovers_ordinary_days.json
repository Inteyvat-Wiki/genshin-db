			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750240701,
					"content": "(Tem um diário bem aqui...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240702,
						750240706,
						750240710,
						750240714
					]
				},
				{
					"id": 750240702,
					"content": "(Ler a primeira parte.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240703
					]
				},
				{
					"id": 750240703,
					"content": "\"...Hoje é um dia chuvoso. Eu preparei para \"Ondinha\" seu <color=#00E1FFFF>Ceviche</color> favorito. Sua expressão satisfeita fez tudo valer a pena...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240704
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240704,
					"content": "\"...Mesmo se ele estiver nadando despreocupadamente, é só oferecer um pouco daquele <color=#00E1FFFF>Ceviche</color>, e vuush! Ele pula da água, e de forma bem adorável...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240705
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240705,
					"content": "\"...Eu jamais duvidaria do seu carinho por mim. Apenas, talvez, que ele ame <color=#00E1FFFF>Ceviche</color> bem mais...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240706,
					"content": "(Ler a segunda parte.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240707
					]
				},
				{
					"id": 750240707,
					"content": "\"...Olhos grandes e redondos, rabinho enrolado e voz alegrinha... Jade, oh, Jade, existe uma Sauriana nesse mundo mais fofinha do que você...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240708
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240708,
					"content": "\"...Você nunca foi enganada, nem nunca duvidou, como se toda vida existente pudesse se tornar sua amiga e aproveitar bons momentos brincando com você...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240709
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240709,
					"content": "\"...Se eu não fosse tão ocupado, eu adoraria brincar com você o dia inteiro, te assistir correr pela floresta, banhando-se pelos raios de sol, como uma criança do vento, um espírito tão livre!...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240710,
					"content": "(Ler a terceira parte.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240711
					]
				},
				{
					"id": 750240711,
					"content": "\"...Atravessei montanhas e vales para encontrar seu paradeiro. Se você realmente desejava não me ver, você poderia ter partido...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240712
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240712,
					"content": "\"...Mas você teve consideração pelo meu ritmo, parando de vez em quando, até mesmo coletando diversas frutas para mim, sem falar naquelas pedras brilhantes...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240713
					],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240713,
					"content": "\"...Ó, Calêndula, minha doce Calêndula, apenas eu conhecia o coração tenro debaixo dessa sua casca dura. Ser uma guerreira destemida nunca foi sua intenção...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diário de alguém"
				},
				{
					"id": 750240714,
					"content": "(Certo, hora de parar de ler...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
