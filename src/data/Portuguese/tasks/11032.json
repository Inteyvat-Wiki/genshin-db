			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin",
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "#Ganyu, obrigada por aceitar meu convite. E vocês {M#dois}{F#duas} - sua presença é muito bem-vinda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320202,
					"content": "Claro, claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320203,
					"content": "Quanta gentileza sua, Huixin. Você se esforçou muito para organizar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320204,
					"content": "Hehe, na verdade... Ganyu, para além de agradecer a vocês a ajuda, eu queria falar de outra coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320205,
					"content": "Ah? Você precisa de ajuda com algo mais? Você pode falar conosco diretamente, não hesite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320206,
					"content": "Ah, não é isso. Na verdade, não é ajuda... Hmm... Vocês podem me ouvir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320207,
					"content": "Sim, claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320208,
					"content": "Hehe... Desde pequena que eu ouvi meu pai contar histórias sobre Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320209,
					"content": "Apesar de eu ter o máximo respeito por meu pai, eu sempre admirei o quão gentil e confiável você é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320210,
					"content": "Eu apenas decidi trabalhar no Pavilhão Yuehai porque eu via você como meu ídolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320211,
					"content": "Eu não sabia que você gostava tanto assim de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320212,
					"content": "Porém, o fato é que trabalhar no Pavilhão Yuehai se revelou uma tarefa árdua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320213,
					"content": "Minha capacidade de trabalho não é excelente, por isso, duvido muitas vezes de mim própria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320214,
					"content": "Eu acho que você tem feito tudo muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320215,
					"content": "Hehe, muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320216,
					"content": "Esses anos, eu também tive uma filha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320217,
					"content": "Ah! Então o Tio Tian já é avô!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320218,
					"content": "Influenciada por mim, minha filha seguiu meus passos e se tornou uma secretária do Pavilhão Yuehai também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320219,
					"content": "No início, eu estava preocupada, pois o trabalho não é fácil. Ainda hoje não sei se ela tem capacidade suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320220,
					"content": "Mas, depois do que houve... Agora estou decidida a apoiá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320221,
					"content": "Ah, o que fez você mudar de ideias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320222,
					"content": "É porque ela irá ter você, Ganyu, como sua colega de trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320223,
					"content": "Eu sei que você irá ajudá-la de forma gentil e falar para ela: \"Sua mãe também costumava fazer isso assim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320224,
					"content": "Seria um lindo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320225,
					"content": "Por isso, se não for pedir muito, gostaria que ela tivesse sua ajuda daqui a 20 anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320226,
					"content": "Huixin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320227,
					"content": "....E-Eu nunca pensei que minha existência tivesse tanto sentido para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320228,
					"content": "Hehe, é como quando você me mostrou o truque do meu pai. Quando você é \"testemunha\", as pessoas ficam mais relaxadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320229,
					"content": "\"Testemunha\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320230,
					"content": "...Eu de fato testemunhei muitos acontecimentos no Porto de Liyue. Tantas mudanças aconteceram, as histórias das pessoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320231,
					"content": "Porém, eu pensava que isso apenas me traria solidão e nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320232,
					"content": "Huixin, você não sabe o quão importante suas palavras são para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320233,
					"content": "Isso me permitiu perceber que eu tenho uma outra ligação com o povo do Porto de Liyue, para além da minha promessa com Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320234,
					"content": "O povo depende de mim, me aceita e espera que eu seja testemunha de suas histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320235,
					"content": "É claro, você é insubstituível para nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320236,
					"content": "Hehe... Sim. É por isso que não posso desiludir vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320237,
					"content": "Isso mesmo! Ganyu, você finalmente ficou mais animada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320238,
					"content": "Mesmo se eu for substituída por outra pessoa, eu espero poder lutar por meu lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320239,
					"content": "Não irei desiludir vocês. Também quero cumprir minha promessa e continuar sendo secretária dos Qixing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320240,
					"content": "Ah, eu disse logo que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "Não importa. Eu vou voltar e dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320243,
					"content": "Receio que isso possa ter ficado uma confusão durante a minha ausência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320244,
					"content": "Não há tempo para desperdiçar - vamos voltar ao trabalho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320245,
					"content": "Boa sorte, senhorita Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "Huuuuh!? Nós já estamos saindo? Paimon ainda está com fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320241,
					"content": "Você não foi demitida. Isso foi um mal-entendido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baixiao",
					"Baishi",
					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "Ahhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320302,
					"content": "Baishi, você está bem? Você adormeceu em pé?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320303,
					"content": "Olhem... Olhem quem está de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320304,
					"content": "Você teve tempo suficiente para lazer? Parece que vocês três são substitutos adequados para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320305,
					"content": "De modo algum! Nós apenas... Estamos trabalhando há muito tempo. Se não tivéssemos feito uma pausa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320306,
					"content": "Não teríamos sobrevivido tempo suficiente para voltar a vê-la, senhorita Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320307,
					"content": "Senhorita Ganyu, nós sentimos sua falta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320308,
					"content": "Hmm. Isso é muito gentil de todas vocês. Pelo que eu me lembro, só nos encontramos uma única vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320309,
					"content": "Nós estivemos rezando dia e noite para que você retorne e assuma suas tarefas novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320310,
					"content": "Para nós, você é como uma Adeptus vindo ao mundo humano para salvar nossas vidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320311,
					"content": "Esqueça todas as nossas queixas invejosas de antes - apenas nos liberte deste trabalho exaustivo, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320312,
					"content": "Tudo bem, tudo bem. Eu entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320313,
					"content": "Por favor, divida os assuntos em mãos em assuntos governamentais, assuntos comerciais e assuntos civis. Marque as tarefas que ainda não foram iniciadas e as que estão em andamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320314,
					"content": "Eu tomarei conta do resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320315,
					"content": "Claro! Nós vamos fazer isso agora mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320316
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320316,
					"content": "Finalmente... Estamos salvas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320317
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320317,
					"content": "Ah, sim, ainda há mais uma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320318
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320318,
