				},
				{
					"id": 760000202,
					"content": "Provavelmente não é nada importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "É, dado o lugar onde ela está, não parece ser o tipo de lugar onde teria algo importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000206,
					"content": "De qualquer forma, temos que encontrar um jeito de entrar e dar uma olhada! Caso contrário, isso vai ficar martelando na cabeça da Paimon como se ela tivesse comido um monte de Cachorros-quentes de Nod-Krai que não descem nunca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000207,
					"content": "A porta pode estar trancada, mas talvez haja outro caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000204,
					"content": "Talvez esteja rolando algum experimento maligno lá dentro...",
