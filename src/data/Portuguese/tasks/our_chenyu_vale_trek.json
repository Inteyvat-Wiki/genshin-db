			"dialogs": [
				{
					"id": 711100101,
					"content": "Você veio participar do concurso de fotografia cênica \"Caminhada pelo Vale Chenyu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100102,
					"content": "Concurso de fotografia cênica? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "É exatamente como o nome implica. É um concurso criado para promover a bela paisagem do Vale Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100104,
					"content": "Anteriormente, fizemos uma pesquisa com os moradores do vale para coletar opiniões sobre os pontos cênicos mais cativantes. Agora, estamos encarregando os participantes de ir até esses locais e capturar imagens usando seus Aparelhos Fotográficos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100105,
					"content": "Por fim, escolheremos algumas excepcionais para usar como exemplos promocionais, que serão exibidos na rua fora do Posto Hezhe. E então? Que tal, pessoal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100106,
					"content": "Sou uma pessoa prática. Tem algum prêmio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "Claro que sim. Se suas obras forem escolhidas, haverá uma surpresa especial só para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100110,
					"content": "Uau! Uma surpresa!? Então é melhor darmos o nosso melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "Hehe, ainda preparamos uma pequena recompensa pelo seu tempo e esforço, mesmo que sua obra não seja selecionada. Esperamos que seja do seu agrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100112,
					"content": "Então por onde começamos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Dê uma olhada neste guia. Estes são os pontos cênicos recomendados pelos moradores do Vale Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100115,
					"content": "Hã? Por que alguns locais estão riscados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Hehe, isso é porque esses locais já receberam inscrições suficientes. Esperamos proporcionar uma exibição mais abrangente da beleza do Vale Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100117,
					"content": "Estes quatro locais restantes continuam disponíveis para inscrição. Você pode selecionar um ou vários deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100118,
					"content": "#Paimon entendeu agora... {NICKNAME}, que tal nos inscrevermos em todos os locais restantes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Se a nossa chance de ganhar o prêmio é de uma em quatro, então temos garantia de vitória se tirarmos quatro fotos! Dessa forma, a surpresa definitivamente será nossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "Provavelmente não é assim que funciona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Não é? Mas um quarto multiplicado por quatro não equivale a quatro quartos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Isso é verdade, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Hehe! Então o que estamos esperando? Vamos lá! Essa surpresa vai ser nossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Boa conta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Ótimo. Não há ninguém melhor em fotografia do que eu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Parece que você mal pode esperar para começar a tirar algumas fotos. Permita-me acrescentar que, se suas obras forem escolhidas, haverá uma surpresa especial só para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fanju"
				}
			]
		},
