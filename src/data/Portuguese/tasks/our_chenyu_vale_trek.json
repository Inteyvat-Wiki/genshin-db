			"dialogs": [
				{
					"id": 711101101,
					"content": "Esse pelicano aqui é seu, garota? A gente pode fotografar ele com a Vila Qiaoying?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Hree hree! Hree hree anng anng hree hree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "Hã? O que você tá dizendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "É língua de pelicano, quer dizer \"ótimo, ótimo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Você entende a língua deles?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Só um pouco... porque eu percebi que quando eles comem, não param de falar \"hree hree! Hree hree anng anng hree hree!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Tenho certeza que eles estão alegremente dizendo que está \"ótimo, ótimo\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Então eu também aprendi a chamá-los assim. Eles vêm logo que ouvem, provavelmente porque pensam que tem comida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Se quiserem fotografar um, talvez vocês pudessem tentar chamar um! É uma pena que eu tenho que voltar pra casa agora, se não eu podia ensinar mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Sem bronca, mocinha! A gente vai tentar! Valeu, chegue bem em casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, vamos tentar ali! Se a gente conseguir atrair um pelicano, vai aumentar nossas chances de sucesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
