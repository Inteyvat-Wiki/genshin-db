			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "Calma! Não chegue mais perto! Vocês... são gente boa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Chijing"
				},
				{
					"id": 711101302,
					"content": "Ei, fomos nós que acabamos de te salvar! Você bateu a cabeça ou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "Ah! Tem razão... Sinto muito mesmo por isso. Minha \"Caminhada pelo Vale Chenyu\" não tem sido nada além de azar enlouquecedor... Obrigado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Chijing"
				},
				{
					"id": 711101304,
					"content": "Então você está participando do concurso de fotografia também?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "Vocês também? Que coincidência! Mas sou apenas um turista qualquer... então eu não poderia fazer nada em relação àqueles Hilichurls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Chijing"
				},
				{
					"id": 711101306,
					"content": "Eu encontrei esses trastes na estrada, eles me capturaram e me trouxeram de volta para cá sem nenhuma palavra. Hilichurls não cobram pedágio, cobram? Absurdo... Felizmente, encontrei vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Chijing"
				},
				{
					"id": 711101307,
					"content": "Ah... Hoje foi um dia difícil mesmo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Não só hoje! Ontem também foi terrível. Eu comprei um Aparelho Fotográfico bem caro de um comerciante de Fontaine, mas ele quebrou logo depois de alguns usos. Quando voltei para achar ele, ele já tinha ido embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Chijing"
				},
				{
					"id": 711101309,
					"content": "Que trambiqueiro... Não deixem de ficar de olho na sua carteira enquanto estiverem por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Chijing"
				},
				{
					"id": 711101310,
					"content": "Ah, perdão. Me deixei levar um pouco. Já que vocês também estão participando da competição, vocês devem estar aqui para fotografar o Monte Xuanlian, certo?",
					"roleType": "TALK_ROLE_NPC",
