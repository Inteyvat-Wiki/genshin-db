			"dialogs": [
				{
					"id": 711101001,
					"content": "Ah, vocês conseguiram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101002,
					"content": "Vocês viram as obras exibidas? Um total de oito foram selecionadas para essa iteração de nossa \"Caminhada pelo Vale Chenyu\", e metade delas são suas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101003,
					"content": "Parabéns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101004,
					"content": "Uau! Isso é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#Viu, {NICKNAME}? Paimon tava certa sobre conseguir quatro das quatro! Paimon se garante mesmo na matemática!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "São quatro das oito, na verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Heh, os juízes também mostraram grande apreço pelas suas outras duas obras, assim como eu disse ontem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101009,
					"content": "Então, por favor, aceitem esse álbum de fotos comemorativo de edição limitada da \"Caminhada pelo Vale Chenyu\". Ele apresenta todas as obras selecionadas dos concorrentes. Vocês mereceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101010,
					"content": "Essa era a surpresa? Ooh, parece incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Se estiver tudo bem com vocês, também tenho um pouco de Mora para entregar. Por favor, aceitem. Eu gostaria de agradecer vocês novamente por participar, dessa vez pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101012,
					"content": "Essa é minha terra natal, e vocês capturaram a beleza desse lugar para sempre. Essas obras certamente farão mais pessoas se apaixonarem por ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101013,
					"content": "#Obrigad{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711101007,
					"content": "Uau! A gente é praticamente uma calculadora, né?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
