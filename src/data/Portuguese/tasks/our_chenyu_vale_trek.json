			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "#{M#Meu querido amigo}{F#Minha querida amiga}, você também está aqui para participar do concurso de fotografia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "Como um fotógrafo de Fontaine, o berço dos Aparelhos Fotográfico, deixe-me dar um conselho: a essência da fotografia, na verdade, está no próprio Aparelho Fotográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Então, deixe-me apresentar alguém a vocês. Na minha cidade natal, ninguém reclama dos Aparelhos Fotográficos que ele produz, são a preços acessíveis, e eu tenho um canal para comprá-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Ei, ei... não faça essa cara de desinteresse, vou tentar conseguir um desconto extra para vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Ei, ei... não vá embora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
