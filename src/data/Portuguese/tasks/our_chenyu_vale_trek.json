			"dialogs": [
				{
					"id": 711100801,
					"content": "Hum... estas fotografias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100802,
					"content": "O que houve? Nossas fotos não se garantem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "Pelo contrário... Embora eu já tenha visto muitas obras excelentes nos últimos dias, as obras de vocês ainda conseguem me surpreender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100805,
					"content": "Essa foto da Vila Qiaoying, por exemplo. O pelicano adiciona um toque de vivacidade à tranquila vila, contrastando a quietude e o movimento... Uma abordagem realmente única.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100806,
					"content": "Se dependesse só de mim, suas obras seriam certamente selecionadas para uso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100807,
					"content": "Uau! Que elogio! Você está deixando Paimon sem graça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Sem graça? Mas nem foi você quem tirou as fotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "#Paimon só está sem graça por você! Paimon sabe como você é modest{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Bem, de qualquer forma, nosso processo de seleção será concluído antes de amanhã de manhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100812,
					"content": "Das oito da manhã às seis da noite, exibiremos as obras selecionadas na rua, fora do Posto Hezhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100813,
					"content": "Obrigada por participar do concurso de fotografia cênica \"Caminhada pelo Vale Chenyu\". Não se esqueça de voltar amanhã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fanju"
				},
				{
					"id": 711100814,
					"content": "Pode apostar! A gente não vai perder a surpresa final!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Agora eu estou ficando um pouco sem graça também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
