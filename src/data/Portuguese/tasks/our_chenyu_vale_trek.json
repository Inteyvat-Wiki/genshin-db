			"dialogs": [
				{
					"id": 711100701,
					"content": "#Vendo como você está relaxad{M#o}{F#a}, suponho que deva estar aqui para entregar suas fotos. Pode deixá-las comigo.",
					"roleType": "TALK_ROLE_NPC",
