			"dialogs": [
				{
					"id": 760470101,
					"content": "Ahm... Então, eu estive observando vocês já faz um tempinho e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Ooh. Espionando a gente, é isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "Ah, não, eu só... Geralmente venho aqui procurar por livros e notei, por acaso, que vocês se interessaram muito em investir. Eu... desaconselho vocês a fazerem isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "#Bem, é verdade que a gente não tá ficando ric{M#o}{F#a}... mas por que dizer pra gente não fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Porque suspeito que não exista nenhum \"retorno generoso\". O chefe ainda tem muitas dívidas a pagar e provavelmente não vai correr o risco de ter prejuízo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Um amigo meu já caiu num golpe parecido, então é melhor vocês não continuarem com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Espera... será que é mesmo um golpe...? {NICKNAME}, precisamos encontrar aquele cara e descobrir a verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
