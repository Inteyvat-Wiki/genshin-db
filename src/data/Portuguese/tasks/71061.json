			"dialogs": [
				{
					"id": 710610201,
					"content": "Você divide a energia do Condutor com Xamaran.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Uau! Cabeça de Cogumelo está brilhando! Será que Paimon devia chamar ele agora de Cabeça de Cogumelo Fluorescente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610203,
					"content": "#Obrigado, {NICKNAME}, Obrigado, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610204,
					"content": "#Foi graças a {NICKNAME} e Paimon que Xamaran recuperou seu brilho vital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610205,
					"content": "Mas não baixe sua guarda ainda. Xamaran sabe que a energia maléfica ainda não foi erradicada. Ela pode contra-atacar a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610206,
					"content": "Hã? Então o que devemos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Uau! De onde essa lama escura saiu? É a energia maléfica que Cabeça de Cogumelo falou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
