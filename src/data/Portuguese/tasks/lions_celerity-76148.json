				]
			},
			"dialogs": [
				{
					"id": 761480701,
					"content": "Voltamos aqui de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "Da última vez que viemos, em termos de vidas humanas, já deve ter sido... muitas, muitas, muitas... gerações atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Parece que todos nós fomos jogados de volta no Intervalo Apático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "Então como vamos fazer para sair?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "O jeito normal é por meio da meditação, aprender a controlar sua mente e pensamentos e depois deixar para trás todo e qualquer desejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "Manter um estado de vazio completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Parece simples de dizer. Mas, dependendo da natureza da pessoa e da força dos seus desejos, isso pode levar de alguns anos a vários séculos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Para alguém como você, carregando o destino do mundo nos ombros, esses desejos provavelmente não podem ser deixados de lado... nem deveriam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Então o que fazemos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Vamos encontrar Zeitlind e descobrir a partir daí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "O que você pegou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Espera, Dex também foi envolvido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "Nesse caso, pode haver ainda uma chance de virar o jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Já que Dex também é um Guardião, ele pode conseguir usar o poder contido nos fragmentos para forçar a abertura de um caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Nós vamos precisar dar um nome a esses fragmentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "Eu ouvi falar desses caixões exagerados. Eles foram colocados por uma das irmãs da senhora do templo... Caixões Maranasati, acredito que era o nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "Nesse caso, vamos chamar os fragmentos de Fragmentos do Pesar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
