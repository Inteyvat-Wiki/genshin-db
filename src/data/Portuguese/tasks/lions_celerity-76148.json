			"dialogs": [
				{
					"id": 761480101,
					"content": "Ugh! Onde foi que vocês dois foram agora há pouco? A Paimon quase teve um treco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480102,
					"content": "A Paimon ficou te chamando o tempo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480103,
					"content": "Hmm? Por que a Paimon não foi arrastada para o Intervalo Apático?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480104,
					"content": "Bem... talvez porque, além de comer e dormir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "Ela não pensa muito em mais nada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480107,
					"content": "Parece que Melanta ficou mesmo com raiva agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480108,
					"content": "#Mandar {NICKNAME} para cima para encarar ela se tornou urgente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480109,
					"content": "Vamos conversar em outro lugar. Este lugar já não parece tão seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480110,
					"content": "Hã, bem, eu sei que ninguém perguntou, mas... Olá, pessoal. Meu nome é Alara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alara"
				}
			]
		},
