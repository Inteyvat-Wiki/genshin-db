				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "Devo dizer que alguém como você é definitivamente mais adequado para fazer esse tipo de pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030402,
					"content": "Você tem bastante experiência em se aventurar, e está em boa forma também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030403,
					"content": "E mais importante, você consegue controlar os elementos mesmo sem o uso de uma Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030404,
					"content": "Os elementos... Existe de fato alguma pesquisa neste continente que possa desvendar seus segredos? Para um pesquisador, a capacidade de usar uma Visão ou a falta dela é realmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030405,
					"content": "Ah, eu me perdi no assunto novamente... Desculpe, não leve isso pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		},
