						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Ótimo, estou contando com você então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030303,
					"content": "Você pode ver os elementos, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030304,
					"content": "Eu lembro que você só precisa seguir a trilha do \"vento\" e procurar por aquele caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030305,
					"content": "Estarei te esperando debaixo da árvore. Se você encontrar qualquer coisa, apenas o traga para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		},
