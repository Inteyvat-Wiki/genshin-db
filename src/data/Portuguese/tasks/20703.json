					"Dra. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "Você encontrou algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030502,
					"content": "Temos algumas folhas aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "... Folhas? Deixe-me ver, por favor. Hm, você até colocou elas em uma caixinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030504,
					"content": "Quando você segura em sua mão, estas folhas permitem que você possa sentir o \"vento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030505,
					"content": "E pensar que essa árvore tivesse todo esse poder. Se eu tivesse uma Visão, então eu não teria que ter perdido todo esse tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030506,
					"content": "Obrigada. Esse realmente é um recurso muito precioso, e eu irei usá-lo de acordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030507,
					"content": "Ainda assim, eu não tenho nenhuma forma de preservar estas folhas. É totalmente possível que o \"vento\" nelas possa se dissipar muito rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030508,
					"content": "De qualquer forma, pegue isto como recompensa pelos seus esforços. Quem sabe, talvez eu precise te chamar no futuro para me ajudar com mais material de estudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		}
