			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dra. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "Que pena, eu não posso usar este material também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Eu gostaria de escrever um novo livro sobre a história de Mondstadt que seja focada no \"vento\", então estou procurando por inspiração aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030104,
					"content": "Se você pensar bem, este é o lugar ideal para isso - tem uma Estátua dos Sete que representa o Anemo, e também uma árvore que está ligada à lenda da grande heroína, Vennessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030105,
					"content": "Ainda assim - sei que isso pode soar engraçado - procurar e recolher os ventos sem uma Visão, que eu não tenho, é muito difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030106,
					"content": "E essa tão chamada procura por inspiração? Bem, eu só estou encarando o vazio aqui. A maioria dos meus materiais são resumos de recursos de terceiros, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030107,
					"content": "Essa é a vida de uma pessoa sem Visão neste continente - fazer tanto, e ainda assim conquistar tão pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030108,
					"content": "Não se pode usar os poderes dos elementos sem uma Visão. Seja para investigar ou para viver, aqueles sem isso vivem como forasteiros em seu próprio mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030109,
					"content": "Hahaha. Talvez, aos olhos dos deuses aqueles que têm Visões sejam os personagens principais deste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030110,
					"content": "Desculpe, falei demais, e enquanto eu falei tudo isso, ainda assim não desistirei de minha procura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030111,
					"content": "Eu não tenho uma Visão, mas eu não vou perder em termos de escolaridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030112,
					"content": "Eu também ouvi que você pode usar os elementos mesmo sem uma Visão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030113,
					"content": "Se você pudesse me ajudar em conseguir alguns objetos impregnados com Anemo, isso realmente me ajudaria com minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dra. Edith"
				},
				{
					"id": 207030114,
					"content": "Você poderia me ajudar a subir nesta árvore e dar uma olhada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dra. Edith"
				}
			]
		},
