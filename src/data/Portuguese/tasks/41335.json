			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "Não está certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "Olá, estou aqui buscando algumas inspirações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "Agora estamos no Ritual de Lanternas, e estou pensando em arranjar uma maneira para pintar essa vista tão boa do Ritual de Lanternas e do Porto de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "*Suspiro* Não sei se meus métodos não são bons, ou é outro motivo... Não consigo desenhar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "Portanto, estava pensando que podia ter inspirações diferentes em lugares diferentes... Todavia, não estou conseguindo encontrar esse tipo de lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "Viajante, você conhece um lugar bom para pintar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "Então vamos dar uma olhada aqui perto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Boa! Então vamos juntos. Talvez possamos encontrar um lugar bom!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Aqui tem uma boa vista... Ei? Você é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350302,
					"content": "#Meu nome é Qingzhou, {M#caro senhor}{F#cara senhorita}. Você é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350303,
					"content": "Haha. Você é poeta? Eu sou um artista, estou buscando inspirações nas redondezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350304,
					"content": "Buscando inspirações? Que coincidência! Também estou fazendo o mesmo. Por que você procura inspirações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350305,
					"content": "#Hum... Eu quero fazer um desenho do Ritual de Lanternas e do Porto de Liyue e estou procurando a mais bela paisagem com {M#o}{F#a} Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350306,
					"content": "Ah, sim! Por que você está aqui procurando inspiração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350307,
					"content": "Hum... É realmente uma coincidência. Eu quero escrever um poema descrevendo o Ritual de Lanternas e o Porto de Liyue e estou buscando inspiração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350308,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350309,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350310,
					"content": "Um poema... É bem simples. Como você pode descrever o Ritual de Lanternas e o Porto de Liyue em apenas algumas palavras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350311,
					"content": "Haha! Eu acho que apenas com um desenho é possível descrever todas as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350312,
					"content": "Um desenho? Hehe. Eu acho que assim é um desperdício de tinta. Ficaria apenas a essência do Ritual de Lanternas e perderia o espírito do Porto de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350313,
					"content": "Além disso, Liyue é enorme, como pode registrar tudo em apenas uma pintura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350314,
					"content": "Haha. Eu acho que o melhor é desenhar mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350315,
					"content": "Hehe. Eu acho que o melhor é um poema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350316,
					"content": "Se acalmem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "Essa discussão não tem sentido. Vamos fazer assim, cada um vai criar o que quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350318,
					"content": "Quando terminarmos, vamos exibir nossas obras e procurar alguém para avaliar. Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350319,
					"content": "É uma boa ideia. Depois de você terminar seu desenho, me procure no Albergue Wangshu e procuraremos uma pessoa para avaliar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350320,
					"content": "Está bom. Combinado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350321,
					"content": "Combinado. Vou me despedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350322,
					"content": "Esse poeta é muito convencido de si mesmo. Pensa que com algumas palavras pode representar a grandeza de Liyue e do Ritual de Lanternas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350323,
					"content": "Espere eu terminar essa pintura. Esse Poeta com certeza vai admitir sua derrota.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350324,
					"content": "Farei uma ótima pintura... Mas uma pintura como esta precisa de ótimos materiais também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350325,
					"content": "Viajante, você pode me ajudar e coletar alguns materiais especiais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350326,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Obrigado. Agora, deixe-me pensar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350329,
					"content": "Hmm... Colete o Néctar Ardente da Flor Gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350330,
					"content": "Com ele, eu com certeza farei um excelente pigmento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350328,
					"content": "Quais materiais você quer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
