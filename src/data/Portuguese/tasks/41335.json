			"dialogs": [
				{
					"id": 413350701,
					"content": "Então? Você trouxe o Néctar Ardente da Flor Gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Deixe-me dar uma olhada... Esse daqui está ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Agora só preciso preparar os pigmentos, depois encontrar uma boa paisagem para então começar a pintar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "Hmph, espere aquele poeta ver minha pintura, ficará sem palavras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "Ah, sim! Lembrei que no Ritual de Lanternas de Liyue se costumam soltar Lanternas Celestes, e também escrever seus desejos em cima dela, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350707,
					"content": "Também preparei uma Lanterna Celeste, e o meu desejo... Bem, não posso lhe contar, ou então ele não se realizará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350708,
					"content": "Oh, quase esqueci. Fique com isso, é sua recompensa por ter me ajudado. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350709,
					"content": "O poeta aceitará a derrota quando ver minha pintura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
