					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "Oh, você pensou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710203,
					"content": "Comprarei por 80.000 Mora e 5 Abundâncias Anuais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710204,
					"content": "É sua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Obrigado. Aqui está sua Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710206,
					"content": "Se você voltar a encontrar alguma relíquia semelhante, não hesite em regressar à loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710207,
					"content": "Eu preciso pensar mais um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
					"content": "Sem problemas. No final, você sempre deve checar os preços no mercado quando está pretendendo vender relíquias preciosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710209,
					"content": "Se você tiver pensado bem o suficiente, pode vir procurar mim novamente.",
					"roleType": "TALK_ROLE_NPC",
