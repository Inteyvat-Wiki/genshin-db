				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "...Assim como eu disse antes, querido Gestionnaire, o procedimento é assim e não há nada que eu possa fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "O Sr. Roialte enviou a lista dos documentos necessários e eu já estou com eles prontos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Porém, você não pode vir e simplesmente levar os documentos. Isso não está de acordo com as nossas regulamentações de entregas de cartas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "Hã? Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Olá, Iaune. Você parece bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Você também. É tudo graças a ajuda que recebi do Sr. Roialte e Sr. Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#Você conhece {M#o}{F#a} {NICKNAME} também, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Claro. {NICKNAME} me fez um grande favor antes. Sem {M#ele}{F#ela}, eu não estaria trabalhando na Maison Gestion ainda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#Sério? Não é surpresa que {NICKNAME} seja um{F#a} Pesquisador{F#a} Sênior Honorári{M#o}{F#a} para o Instituto, hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "Eu me garanto em oferecer apoio moral.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "De qualquer forma, sem seu apoio, tenho certeza... Não teria conseguido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "#Acredito que ouvi o Sr. Choiseul te chamar de Pesquisador{F#a} Sênior Honorári{M#o}{F#a} ainda agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Isso aí! Tenho até o certificado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "E uma foto! Paimon também tá nela, mas Paimon não ganhou um certificado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#Sim, reconhecendo os méritos e conquistas {M#do}{F#da} {NICKNAME}, o Instituto concedeu a {M#ele}{F#ela} o título de Pesquisador{F#a} Sênior Honorári{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "#Quanto ao que são essas \"conquistas\"... Deixarei {M#ele}{F#ela} falar por si mesm{M#o}{F#a}. Vamos falar de negócios primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "Eu realmente não posso te dar esse documento no momento, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Mas como você disse antes, você gostaria que um pesquisador te guiasse para tirar fotos perto do Instituto... isso não é nenhum problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Eu acho que {M#o}{F#a} {NICKNAME} está totalmente dispost{M#o}{F#a} a isso. {M#Ele}{F#Ela} conhece a área tão bem quanto qualquer um, e é totalmente competente para fazer essa tarefa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#O que me diz, {M#Sr.}{F#Srta.} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "Sem problemas. Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "Você é tão gentil. Desde que você esteja lá, deve estar tudo bem. Quando eu vim, tudo que vi foram mecas descontrolados e monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "Mas tirar fotos não é o ponto. Para ser sincero, Sr. Choiseul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Eu adoraria te ajudar também, Iaune, mas procedimentos são procedimentos e minhas mãos estão atadas. Por favor, não torne isso difícil para meros oficiais públicos que só sabem estampar documentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Muito bem, discutirei isso com o Sr. Roialte mais tarde, depois que eu voltar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Adeus, Sr. Choiseul. Tenha um bom dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Obrigado. Espero que você aproveite seu tempo no Instituto de Pesquisas de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#É a sua vez de ser {M#o}{F#a} guia agora, {NICKNAME}. Por que não vamos para o Parque Memorial Mary-Ann primeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "Fico feliz em ajudar o Iaune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Tudo que eu fiz foi consertar a Autocarimbadora 3000.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Então eu voarei até aqui mais tarde com você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}! Estou tão feliz em te ver. Que sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
