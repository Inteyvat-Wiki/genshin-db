			"dialogs": [
				{
					"id": 741270301,
					"content": "Esse é o Pavilhão Acadêmico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "Admito, a estrutura realmente se parece com um pavilhão, mas o que há de acadêmico nele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "A parte acadêmica são as cabeças dos pesquisadores.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Muito bem, ainda bem que eu não vim por nada acadêmico hoje. Enfim, a construção parece relativamente... intacta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Intacta é tudo que sobrou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Ahem! Vamos, vamos olhar esse lugar. Acho que ele é perfeito para uma foto em grupo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "Eu deveria encontrar uma boa vista, para não ser total desperdício se o Sr. Roialte brigar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#Por favor, também tire algumas fotos para mim, {NICKNAME}. Ouvi dizer que você é {M#um ótimo fotógrafo}{F#uma ótima fotógrafa}, certamente melhor do que eu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "As pedras não são acadêmicas, isso eu sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
