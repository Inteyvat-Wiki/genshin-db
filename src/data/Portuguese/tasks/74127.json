			},
			"dialogs": [
				{
					"id": 741270501,
					"content": "Ó, arcontes, me abençoem, que não apareça mais nenhum meca criando problemas... o que você está fazendo aqui, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "O Sr. Roialte me enviou para conduzir inspeções, então pensei em dar uma passada e te trazer um café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "Mas tenho que dizer que seu ambiente de trabalho é mesmo... bem difícil. Eu pensava que esse \"escritório\" teria pelo menos uma sala de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Obrigado pelo café, meu querido Iaune. Quanto ao ambiente... estou feliz com o que eu tenho. Olhe em volta, pelo menos estou trabalhando debaixo de um teto intacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270505
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270505,
					"content": "Você ainda é responsável pelas revisões de qualificações?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#{NICKNAME}! Não... eu deveria te chamar de Pesquisador{F#a} Sênior Honorári{M#o}{F#a}! Bom te ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Que olhar triste é esse, Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "*Suspira*... É o seguinte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "Com muita tristeza, Iaune conta tudo que aconteceu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "Hmm... essa correspondência é algum tipo de documento classificado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "Não deve ser. Respostas deste tipo normalmente são coisas como \"entendi\", \"não tenho mais perguntas\", \"eu não sei\", ou similares...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "No máximo, foi copiado para diferentes departamentos para avisá-los de que é algo que eles deveriam ligar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Oh, não é à toa que eu também tenho uma cópia dessa carta... dê uma olhada, é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "O quê!? Mas o Sr. Choiseul claramente disse que ele não enviou ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "...Oh, ele provavelmente quis dizer que a resposta externa ainda não foi enviada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Mais uma vez, ele não conseguiu dizer a história toda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "As pessoas do Instituto realmente são boas em irritarem os outros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "Ao julgar pela sua reação, esse deve ser o documento que você queria. Eu já li ele várias vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "Esse é idêntico ao documento que você queria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#Bem astuto da sua parte, {NICKNAME}. Tenho certeza de que todas as cartas que Choiseul enviou são as mesmas, Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "Por que você apenas não leva minha cópia com você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "Espera, o quê? Se o Iaune pegar a sua, então você não ficará sem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Hahahahaha, olhe para mim! Ninguém vai se importar se alguém na minha posição acidentalmente perder uma carta sem sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Não é uma má ideia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "Viu, Iaune, não estou só me aproveitando dos seus cafés!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "Não, Monsieur, eu não posso fazer isso. É contra os regulamentos. Voltarei e esperarei pela carta oficial ser entregue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "Meu querido Iaune, pense fora da caixa, não seja um idiota! Por que você insiste em tornar as coisas mais difíceis para você mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "Quem sabe quando essa carta vai chegar até você! Quanto mais cedo você conseguir, mais cedo você poderá começar a trabalhar e resolver essa bagunça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "Não, Monsieur. Obrigado, mas eu não irei violar os regulamentos. Meu dever como um funcionário público exige isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#{NICKNAME}, Sr. Desnos e Paimon, preciso ir agora. O Sr. Roialte ainda está esperando pelo meu retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune vai embora com passos solenes e pesados...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "*Suspira* Iaune consegue ser um idiota tão grande. O cérebro dele já está todo podre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Todo mundo tenta tornar as coisas mais simples para si mesmo, porém, ele insiste em passar pelos procedimentos, mesmo para coisinhas pequenas como essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "É apenas a personalidade dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Admirável, porém assustador ao mesmo tempo. Não é à toa que ele tem poucos amigos no Maison Gestion, além de Roialte e Semaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "#Também sou amig{M#o}{F#a} dele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "Paimon também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270540,
					"content": "Isso é bom. Você deveria estar perto dele mais vezes. Sinto que os nervos do Iaune estão ficando cada vez mais fritos conforme os dias passam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270541
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270541,
					"content": "Quanto às cartas, verei o que posso fazer. Verei o Sr. Choiseul em breve e pedirei a ele para me deixar enviá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270542
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270542,
					"content": "Se ele concordar, enviarei uma para Iaune o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270543
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270543,
					"content": "*Suspira* É preciso de muito esforço para ser amigo de um idiota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270536,
					"content": "É apenas quem Iaune é.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270525,
					"content": "Isso realmente resolve o problema, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				}
			]
		},
