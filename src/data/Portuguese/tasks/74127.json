					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Hmm, esse é o Parque Memorial Mary-Ann? Não dá nem para dizer que é um parque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Sr. Roialte ficará desapontado. Ele queria que alguém fizesse um discurso aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Olhando em volta, um discurso está fora de questão. Não tem nem sequer uma área icônica por aqui, e não é bom para fotos em grupo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "Você pode levar alguns mecas de volta com você como lembrança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "#Engraçadinh{M#o}{F#a}, mas não há espaço no Maison Gestion para coisas assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "E mesmo que eu pudesse, eu ainda teria que levar o meca para ser avaliado, reportado, categorizado e então armazenado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "Ei! Só estamos brincando. Não precisa ficar tão focado no trabalho assim do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Falando em reportar... eu ainda não consegui pegar aquele documento. O Sr. Roialte vai ficar desapontado de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Choiseul está tornando as coisas difíceis para você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Não exatamente. Meu pedido não foi exatamente formal, então não é surpresa ele ter rejeitado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "Como você deve saber, o Instituto está fazendo planos para reconstrução, certo? Certos arranjos de recursos e funcionários precisam ser feitos através da Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "O Maison Gestion leva esse assunto muito a sério, então fizeram o Sr. Roialte escolher uma equipe para conduzir estudos de campo por volta da área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Assim, o Sr. Roialte ficou para trás no Maison Gestion para contabilizar, enquanto eu devo visitar o Instituto para coordenar a recepção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Acontece que o Instituto tem uma carta para o Maison Gestion, então eu pensei que, já que eu já estou aqui, posso muito bem levar de volta comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Mas o Sr. Choiseul insiste que isso é uma violação dos procedimentos padrões e simplesmente não quer me entregar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Violação de procedimentos? Quais procedimentos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "Existem procedimentos para pegar documentos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "Uau, então é mais como sair correndo por todo lado tentando conseguir aprovações, assinaturas e escutar burocratas falando sem parar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "Resumindo, a maior parte das correspondências oficiais dentro da Maison Gestion devem ser enviadas por correio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "O quê? Então... e se o departamento que está enviando a carta está na mesma rua, ou até mesmo de frente um pro outro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "Sim, você ainda teria que enviar por correio. Isso é pelo propósito de poder ser \"rastreável\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "O pessoal do Gestion realmente não teme trabalhar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Acho que, a essa altura, todo mundo só já se acostumou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Esqueça, vamos para o próximo lugar. Deixe-me ver a anotação que o Sr. Roialte deixou para mim... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "Esse lugar é chamado de Pavilhão Acadêmico. Estranho. Eu não vi nenhuma construção com uma placa quando entrei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "Eu sei onde está, só me seguir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "Sabia que podia confiar em você! O que eu faria sem você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Vamos nos apressar, então. Podem haver mais mecas descontrolados por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "O que você e Choiseul estavam discutindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
