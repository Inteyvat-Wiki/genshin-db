			"dialogs": [
				{
					"id": 741270401,
					"content": "Minha nossa... tão alto, alto demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "Você está descrevendo o nível dos acadêmicos do Instituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "Não, estou surpreso com a altura desse lugar! Embora os acadêmicos do Instituto certamente também estejam tão alto quanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "Mas agora... *Suspira* Quem poderia ter previsto tantas dificuldades para o Instituto? E quem sabe o quão tranquila a reconstrução será...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "A última parada é... o Escritório Representativo do Departamento de Revisão de Qualificações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "Tudo em um único suspiro, incrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Obrigado. Mas onde ele está? Eu não percebi um escritório desses no Instituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "Desnos está encarregado do escritório?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "#Sim! Isso mesmo! Você conhece até esse lugar? Eu não ficaria surpreso se {M#o}{F#a} Pesquisador{F#a} Sênior Honorári{M#o}{F#a} soubesse tudo sobre o Instituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "Oh, agora Paimon se lembra! É aquele escritório em ruínas? Se é que dá para chamar aquilo de escritório...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Talvez o Sr. Desnos reduziu o nome para ser mais fácil de entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "Por favor, lidere o caminho. Tenho que pegar alguns documentos do Sr. Desnos também. Quando eu tiver eles, poderei voltar para o Maison Gestion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "Hoje foi um dia sem problemas nenhum. Eu devo poder voltar e relaxar logo. O Instituto de Pesquisas de Fontaine realmente faz as coisas bem diferentes do... ahem, eu não disse nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
