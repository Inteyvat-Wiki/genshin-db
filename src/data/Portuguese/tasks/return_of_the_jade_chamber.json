			"dialogs": [
				{
					"id": 718130401,
					"content": "A Pérola Preciosa... Como é que começa... Ah sim, \"Comércio e trocas, como fontes e rios, começam nas montanhas e terminam nos mares...\"",
					"roleType": "TALK_ROLE_NPC",
