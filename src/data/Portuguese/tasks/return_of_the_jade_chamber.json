			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "\"Esse grande plano mapeia o curso que nos guiará, devagar mas certamente para a longevidade de Liyue e a prosperidade do povo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "Ah, você voltou. Um momento, ainda estou escrevendo as últimas linhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Hmm... Pronto. Isso deve bastar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Aqui suas Tiras de Três Sabores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Ha, sem pressa, sem pressa. Veja se o livro é do seu agrado primeiro - embora eu deva dizer que acredito que minha caligrafia seja bastante satisfatória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "Então esta é a habilidade de um poeta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "Hahaha, você me elogia demais, majestade. Este livro é para você. Não o perca, hein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
