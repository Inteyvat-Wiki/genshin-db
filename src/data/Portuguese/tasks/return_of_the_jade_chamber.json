			"dialogs": [
				{
					"id": 718130701,
					"content": "Então, você já expulsou aqueles javalis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130702,
					"content": "Todos eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Isso serve. Irei em breve para coletar os bambus. Uma vez que os ornamentos estejam prontos, farei com que sejam entregues diretamente no Pavilhão Yuehai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130704,
					"content": "Este pedido é realmente grande. Tem um bom dinheiro a ser feito aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mestre Lu"
				}
			]
		},
