			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
