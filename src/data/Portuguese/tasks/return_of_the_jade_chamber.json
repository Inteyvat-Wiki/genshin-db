			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Olá. Você gostaria de comprar alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "Gostaríamos de uma cópia da \"Pérola Preciosa\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "\"Pérola Preciosa\"? Não a temos em estoque aqui. Você precisa dela urgentemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Bem, eles estão reconstruindo a Câmara de Jade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Estão mesmo? Bem, isso realmente exigiria uma preparação adequada. Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Talvez você possa procurar por Qingzhou em vez disso. Ele é extremamente bem informado - talvez ele possa saber onde uma cópia da \"Pérola Preciosa\" pode ser encontrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Se minha memória não me falha, Qingzhou muitas vezes se hospeda no Albergue Wangshu. Você pode tentar procurá-lo lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
