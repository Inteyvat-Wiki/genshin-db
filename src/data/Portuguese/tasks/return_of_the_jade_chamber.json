							"7181306",
							"2"
						],
						"stepId": 7181306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mestre Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Hmm? Você precisa de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130602,
					"content": "Gostaria de encomendar alguns pequenos ornamentos feitos de bambu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Pequenos ornamentos de bambu, você diz? Eu poderia fazer isso, mas posso saber de onde vem esta encomenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130604,
					"content": "É desta lista da Baiwen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Ohh... É um pedido do Pavilhão Yuehai, não é? Bem, então suponho que eu deveria completá-lo o mais rápido possível, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130606,
					"content": "Mas tem um problema: A floresta de bambu da qual eu recolho frequentemente materiais tornou-se subitamente ocupada por um grande número de javalis, por razões desconhecidas por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130607,
					"content": "Embora não seja um grande problema, muitas vezes tenho que andar ao redor deles para coletar bambu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130608,
					"content": "Se você pudesse expulsar esses javalis, eu poderia ir buscar um pouco de bambu agora mesmo, e poderíamos começar a trabalhar imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Mestre Lu"
				},
				{
					"id": 718130609,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Então, esperarei por você aqui. Depois de perseguir aqueles javalis, volte e me dê um grito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mestre Lu"
				}
			]
		},
		{
			"id": 7181307,
			"completionStepIds": [
				7181310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
