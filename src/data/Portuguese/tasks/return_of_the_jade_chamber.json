			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Um enigma. O mais irritante, de fato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Então, uh, você sabe alguma coisa sobre a \"Pérola Preciosa\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "A \"Pérola Preciosa\", você diz? Sim, eu me lembro desse livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "Uma vez eu fui aqui e ali em busca de material com o qual escrever um poema sobre os comerciantes e me deparei com este livro no processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Eu não compreendi completamente o que li naquele tomo, mas algumas de suas anedotas se revelaram muito inspiradoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Deixe-me tentar lembrar o nome desse poema. Me dê um momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Você se lembra onde encontrar aquele livro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Vocês procuram aquele livro? Eu não me lembro onde podemos encontrar aquele livro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "Mas, se vocês estiverem com pressa, eu posso escrever manualmente um livro para vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Escrever manualmente um livro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "*Suspiro* O texto do livro nem é assim tão longo, não é difícil me lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Além disso, o colecionador de livros não me deixou emprestá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "E ainda assim, simplesmente não se escreve um poema em um dia - então eu escrevi apenas uma cópia para mim mesmo. O conteúdo do livro também não era muito longo, portanto, já os tenho mais ou menos memorizados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "Então esta é a habilidade de um poeta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "Ah, é apenas um assunto insignificante, majestade. Ainda assim, talvez você possa me fazer um favor em troca do texto escrito à mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "Embora me envergonhe de admitir isso, tenho estado tão ocupado recolhendo inspiração aqui que me esqueci de tomar uma refeição. Sinto muita fome no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Você poderia me ajudar a conseguir uma porção de Tiras de Três Sabores? Em troca, eu lhe escreverei uma cópia da \"Pérola Preciosa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "Acredito que já deve estar pronto quando você retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "Você se lembra de tudo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
