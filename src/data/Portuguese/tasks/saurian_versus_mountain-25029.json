				},
				{
					"id": 250290302,
					"content": "H-Heh, não saiu tão bem quanto eu gostaria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290303
					]
				},
				{
					"id": 250290303,
					"content": "#Sério? Você quer dizer que poderia ter sido ainda mais rápid{M#o}{F#a}? Uau. Então você é realmente {M#um aventureiro}{F#uma aventureira} especialista, hein...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290306,
					"content": "Se colocarmos esse tempo como nosso objetivo... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290307
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290307,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290308
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290308,
					"content": "...É, eu sei, vai ser meio difícil para você, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290309
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290309,
					"content": "Acho que vou falar com Mayta sobre esse tempo. Talvez ele consiga pensar em... um plano de treinamento mais razoável para nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290310
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290310,
					"content": "Enfim, agradeço demais sua ajuda. Aqui, fique com esses Cacahuatls!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290311,
					"content": "Nós mesmos colhemos eles, então são super frescos e vão fazer um chocolate bem delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290312
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290312,
					"content": "Rrarr, rrarrr!",
