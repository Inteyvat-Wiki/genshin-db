			"dialogs": [
				{
					"id": 250290101,
					"content": "Vamos lá, não perca a coragem. Só melhore e... continue tentando! Você vai chegar ao topo rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290102,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290103,
					"content": "Tá com fome? Hmm... Então que tal eu arranjar algo para você comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290104,
					"content": "Rawr... Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290105,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "Estou brincando com meu amigo, Jika. Ele ainda é pequeno, mas a mamãe disse que ele será igual a qualquer outro Yumkassauro quando ele crescer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290107,
					"content": "Oh... *Choro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290108,
					"content": "Não fique triste. Seu corpo só está muito frágil no momento, e você ainda esteve machucado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290109,
					"content": "A mamãe diz que você certamente vai ficar melhor. Você só precisa comer bem e treinar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290110,
					"content": "Rawr? Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290111,
					"content": "(Acariciar Jika)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290119,
					"content": "Haha. Bem, olha as horas. Temos um treinamento chegando em breve, então vamos comer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290120,
					"content": "A mamãe fez essas frutas secas, sabe! Assou elas em uma panela gigante antes de adicionar vários condimentos com cheiro bom...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290121,
					"content": "Certo, e ela também colocou algumas boas pitadas de açúcar e pétalas... De qualquer forma, tem um gosto ótimo! Só um momento, te darei um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290122,
					"content": "Espera. Para onde minhas frutas secas foram? Tenho certeza de que coloquei elas em minha bolsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290123,
					"content": "...Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290124,
					"content": "Uau! Jika! Você comeu tudo? Qual é, eu te disse para não ser avarento... Você vai ter problemas para se mover se comer tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290125,
					"content": "...Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290126,
					"content": "Bem, é bom ter apetite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "Rwar! Rawrrrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290129,
					"content": "É mesmo? Nesse caso... Quero ser como Jika. Quero comer muito, crescer rápido e ajudar a mamãe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290130,
					"content": "Muito bem então, Jika! Vamos treinar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290131,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290132,
					"content": "Vamos ver... Que tal se praticarmos alpinismo hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290133,
					"content": "R-Rwarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290134,
					"content": "Ah qual é, levanta a cabeça! Faremos isso assim como da última vez. Não será nem um pouco difícil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290135,
					"content": "...Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290136,
					"content": "Certo, tio Yawar me disse da última vez que teremos que encontrar \"objetivos de treinamento\" razoáveis se quisermos treinar direito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290137,
					"content": "Agora, se pelo menos eu pudesse encontrar um aventureiro incrível, e pedir que ele ajudasse a montar alguns alvos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290138,
					"content": "#Sou {M#um aventureiro}{F#uma aventureira} bem decente até...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "Sério? Uh, então... Você se importaria de me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290141,
					"content": "Quer eu te leve para fazer alpinismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "#Não, não, espere. Se você é tão {M#bom}{F#boa}, de jeito nenhum vamos conseguir te acompanhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290144,
					"content": "Então o que faremos é cronometrar enquanto você sobe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290145,
					"content": "Muito bem, então. Suba aquela montanha o mais rápido que você conseguir. Estamos contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290146,
					"content": "Roar—!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290142,
					"content": "Muito bem, então. Siga-me, vamos começar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "#Você disse, aventureir{M#o}{F#a} incrível? Não precisa procurar mais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "Quem come mais, cresce mais rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "Como ele se machucou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "Eu não sei... mas talvez a mamãe saiba. Jika já estava doente quando a mamãe trouxe ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290115,
					"content": "Ele não conseguia comer, e ele não tinha força alguma para se mover. Tudo que eu podia fazer era dissolver um pouco de remédio na água e fazer ele beber todo dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290116,
					"content": "No fim ele se recuperou, mas seu corpo... continua bem fraco, o que o impede de escavar pelos penhascos assim como outros Yumkassauros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290117,
					"content": "Ele anda bem chateado com isso, então estou tentando ajudá-lo a ficar em forma... mais forte do que qualquer outro Yumkassauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290118,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Jika"
				}
			]
		},
