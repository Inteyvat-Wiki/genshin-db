			"dialogs": [
				{
					"id": 250290201,
					"content": "Bom garoto, bom garoto! Comeu o bastante hoje? Pronto para treinar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290202,
					"content": "Roar~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290203,
					"content": "Você está bem enérgico hoje, não é? Maravilha! Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290204,
					"content": "É, vamos lá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "Hã? Oh, olá! Estamos fazendo um pouco de treinamento de alpinismo no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290207,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290208,
					"content": "Rawwr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290209,
					"content": "Como está indo o treinamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Bem... estamos \"progredindo\". Jika subiu bem mais alto dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290211,
					"content": "É só que Jika não é muito familiar com como você escala montanhas, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290216,
					"content": "A propósito, você poderia demonstrar para a gente de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290217,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "Muito obrigado! Tenho certeza que serei capaz de captar seus movimentos dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290219,
					"content": "Também fique de olhos abertos, tudo bem, Jika?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290220,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290223,
					"content": "Estamos contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290224,
					"content": "Então o que faremos é cronometrar enquanto você sobe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290225,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290221,
					"content": "Assista com atenção dessa vez, tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "É claro! Jika e eu não vamos perder nadinha dessa vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290212,
					"content": "Parece que ele está se recuperando bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "Isso mesmo. A mamãe disse que estou ficando muito bom em cuidar dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290214,
					"content": "Jika melhorou muito. Ele consegue subir bem mais alto do que podia da última vez.",
