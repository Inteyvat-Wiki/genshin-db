					"nextDialogs": [
						250290313
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250290313,
					"content": "Nesse caso, estamos indo. Me pergunto se Mayta voltou ao povoado. Ele não saiu para escalar de novo, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250290304,
					"content": "Quem é Mayta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290305
					]
				},
				{
					"id": 250290305,
