			"dialogs": [
				{
					"id": 752630501,
					"content": "A corrida acabou! Que reviravolta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#E noss{M#o}{F#a} grande vencedor{F#a} deste torneio é... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "#Uau! {M#Ele}{F#Ela} é incrível! {M#Ele}{F#Ela} realmente conseguiu derrotar tanto \"Vem Fácil\" quanto \"Vai Fácil\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "#{M#Ele}{F#Ela} é como um relâmpago dourado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Oh, qual é, e quanto a esse relâmpago de prata? Ninguém viu o relâmpago de prata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Uma derrota desastrosa... Duvido que jamais conseguirei esse tipo de velocidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "Vendaval Feroz Nanasian"
				},
				{
					"id": 752630507,
					"content": "Não desista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Eu... Eu vou te considerar como meu exemplo de vida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "Vendaval Feroz Nanasian"
				},
				{
					"id": 752630509,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "Por favor, aceite o grande prêmio que preparamos para o campeão deste torneio. E você merece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630512,
					"content": "Seu nome entrará para a história do Torneio de Campeões da Velocidade da Brisa Tranquila para sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
