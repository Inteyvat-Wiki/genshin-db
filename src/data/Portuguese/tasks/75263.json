			"dialogs": [
				{
					"id": 752630301,
					"content": "Inacreditável! Alguém realmente venceu Vendaval Feroz Nanasian!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "#{F#A}{M#O} desafiante de hoje venceu o torneio com seus movimentos velozes. Vamos parabenizá-l{F#a}{M#o}! Uhul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "Eu perdi?! Não acredito! Isso é impossível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "Vendaval Feroz Nanasian"
				},
				{
					"id": 752630304,
					"content": "#{M#Ele}{F#Ela} é incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Mas! Nossos fãs de longa data devem saber que Vendaval Feroz Nanasian não foi a competidora mais forte que esta pista presenciou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Antes dela, outras duas lendas locais dominaram a pista. E hoje, estão de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Vamos receber... Vem Fácil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "E Vai Fácil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫, ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "Desafiante, esses dois são os oponentes que você deveria temer. Com o que vimos de você... derrotá-los deve ser quase impossível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "#Preparad{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "Manda ver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "A equipe monta a arena, e a multidão se reúne. Vocês estão na linha de largada...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
