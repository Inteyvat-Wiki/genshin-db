				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Atenção, turistas! O Torneio de Campeões da Velocidade da Brisa Tranquila está para começar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Quem vencer nosso campeão, o \"Vendaval Feroz Nanasian\", vencedor por três dias seguidos, ganhará o prêmio surpresa de hoje! Essa é sua última chance de se inscrever para o torneio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hunf! Não há ninguém querendo desafiar a mim, \"Vendaval Feroz Nanasian\"? Todos estão com medo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*Suspiro* Não há ninguém à altura de \"Vendaval Feroz Nanasian\". Ela já venceu três vezes consecutivas. Ninguém pode vencê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Awrrrh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Oh, você quer experimentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hunf. Então vamos deixar Saurianos participarem? Tudo bem! Mande todas as bestas que puder, eu vou mostrar o que é velocidade de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Que torneio único! Será que os poderosos companheiros Saurianos derrotarão nossa tricampeã invicta, a \"Vendaval Feroz Nanasian\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinowa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Eu também quero me inscrever.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "#Uma reviravolta inesperada, {M#um bravo}{F#uma brava} desafiante apareceu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Hã? Você acha que tem alguma chance contra mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Quantas reviravoltas hoje... Quem será o vencedor? Venha, vamos descobrir juntos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "A equipe monta a arena, e a multidão se reúne. Vocês estão na linha de largada...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
