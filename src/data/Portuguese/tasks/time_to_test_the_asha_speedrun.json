			},
			"dialogs": [
				{
					"id": 150480101,
					"content": "...Não podemos deixar você se arriscar assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Mas isso não foi o que você disse antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Nossas mais sinceras desculpas. Podemos realmente estar com tempo limitado, mas a segurança de nossos visitantes vem em primeiro lugar. Esperamos que você entenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "Ah, momento perfeito! Será que você pode me ajudar a convencer esse cavalheiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Eles precisavam de alguém para o teste e eu consegui provar minha experiência em aventuras e esclarecer que estava disposto a aceitar qualquer risco. Tudo estava indo tão bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Mas assim que ele soube de todas as minhas experiências difíceis que tive no passado, ele recusou imediatamente que eu participe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Senhor, agradeço seu entusiasmo, de verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Mas se você tem uma tendência a cair em rios mesmo ao atravessar pontes rígidas de pedra, pode ser melhor tentar algo um pouco mais... tranquilo? Por exemplo, que tal se deitar em uma daquelas espreguiçadeiras ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*Suspiro* Mas... Eu sou mesmo um aventureiro, e tô qualificado para os testes também! É só que... Tive um pouco de azar no passado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Eu quero mesmo ajudar. Por favor, acredite em mim quando digo que você pode confiar em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Eu dou um voto de confiança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "#Bem, se {M#o maior salvador}{F#a maior salvadora} de Natlan diz... Que tal isso — estaria tudo bem se seu companheiro Asha concluísse a primeira rodada de testes no seu lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Você pode observar do lado e se familiarizar com a rota. Se tudo correr bem, você pode se juntar à segunda rodada de testes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Asha, tudo bem por você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "Beleza, então! Vou deixar contigo, parceiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Ele tem minha confiança plena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
