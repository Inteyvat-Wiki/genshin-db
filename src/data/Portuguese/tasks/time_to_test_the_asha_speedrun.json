					"nextDialogs": [
						150480815
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480815,
					"content": "Hehe, não... Na verdade, eu que deveria estar confortando você aqui! Como líder dessa equipe de aventura, é meu dever cuidar de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480816
					],
					"speakerTitle": "Bennett"
				},
				{
