			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "Honestamente, é apenas uma coisa atrás da outra por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "Ainda está reparando as escadas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Ah! Você veio na hora certa. Mais uma vez obrigado pela última vez... Agora é hora da segunda rodada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Este é um pouco maior e não tenho tábuas de madeira suficientes para isso. Enviei um dos carregadores para buscar um novo lote, contudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "Ele foi atacado por monstros no caminho de volta, entrou em pânico e fugiu, abandonando as pranchas de madeira no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Isso lhe deu um susto de verdade. Consegui fazê-lo apontar onde estão as tábuas de madeira, mas simplesmente não consegui convencê-lo a voltar para lá para buscá-las...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "#Você é {M#o único}{F#a única} que pode ajudar. Você pode ir buscar as tábuas de madeira de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Perfeito. Eu vou esperar por você aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "A rachadura é muito grande...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "Não se assuste... Você não está achando que foi um monstro que fez isso, certo? Teria que ser um monstro muito grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Foi o que aconteceu: na estalagem havia dois convidados em uma briga. Um estava perseguindo o outro, e o outro estava escondido, e eles nunca se encontraram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Mas então... Ambos decidiram passar a noite e esbarraram um no outro no caminho de cima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "Assim que se viram, começaram a trocar socos... Durante a briga, eles conseguiram quebrar as escadas. Levei uma eternidade para separá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "Eu estava furioso... e cobrei o dinheiro de três dias extras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Enfim, chega de fofoca! Ajude-me a buscar essas pranchas de madeira para que eu possa consertar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Se algo assim acontecer novamente, acho que não vou me incomodar em pedir que eles paguem uma indenização... Mas vou absolutamente insistir que eles mesmos consertem isso imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
