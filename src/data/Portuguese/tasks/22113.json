				"points": []
			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "Já arrumei tudo! Que tal? Parece muito bom, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "Assim, também facilitará os hóspedes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
					"content": "De qualquer forma - aceite isto por seu trabalho. Muito obrigado, mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130504,
					"content": "Faça uma pausa para um copo de chá ou um pouco do que você quiser. As habilidades culinárias do nosso chef são as melhores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
