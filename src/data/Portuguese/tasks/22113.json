			"dialogs": [
				{
					"id": 221130201,
					"content": "Você já conseguiu levar as tábuas de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130202,
					"content": "Ainda não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Ugh, vamos lá, eu não tenho o dia todo... Estou esperando para começar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
