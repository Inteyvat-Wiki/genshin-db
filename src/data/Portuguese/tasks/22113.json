				{
					"id": 221130301,
					"content": "Você já conseguiu levar as tábuas de volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130302,
					"content": "Aqui está.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Ótimo! Os monstros são muito irritantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130304,
					"content": "Já são suficientes. Muito obrigado, começarei já o trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
		{
			"id": 2211305,
			"completionStepIds": [
				2211305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
