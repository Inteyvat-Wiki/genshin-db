			"dialogs": [
				{
					"id": 761200101,
					"content": "...Aqui. Isto é para você. Minha parte está feita, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200102,
					"content": "Ei, é uma tela de desenho. Espere, isso significa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah. Chegaram bem na hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Ora, se não é a Maalaus, o nossa Grande Pintora! Há quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "Então, chegamos \"bem na hora\" do quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Eu acabei de levar a Maalaus até a lua por um instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200108,
					"content": "A Paimon está com tanta inveja de como você simplesmente... disse isso, como se estivesse visitando o jardim ao lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "E então, por que vocês foram até lá? Procurando inspiração?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "Acertou pela metade. Também escolhemos um local para uma \"exposição\". Você se lembra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200111,
					"content": "Paimon lembra! A exposição da Deusa da Lua da Maalaus! Não esqueça de convidar a gente quando chegar a hora, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Sim, claro. Além disso, Maalaus parece ser capaz de perceber mudanças sutis ao seu redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200113,
					"content": "Ela me disse que eu mudei muito desde que voltei da lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200114,
					"content": "Foi por isso que ela quis que eu a levasse até lá, para ver se havia algo de especial naquele lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200115,
					"content": "Heh! Isso sim é coisa de artista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Então, essa coisa especial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Não tenho certeza também. Levei Maalaus a muitos lugares, mas nenhum a satisfez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200118,
					"content": "Isto é, até eu trazê-la perto da sua nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200119,
					"content": "Nossa nave espacial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Mas depois de aproximá-la, percebi que ela não estava interessada na nave em si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200122,
					"content": "É? O que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "~!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Hã, ela está voando ao seu redor, Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha. Ela fez isso naquela época também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200126,
					"content": "Suspeito que o verdadeiro interesse dela esteja em como eu fiquei depois de ver a nave espacial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200127,
					"content": "Como você... ficou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Sim. Isso me fez lembrar de quando {NICKNAME} e eu fomos lá junt{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200129,
					"content": "#Sentamos no topo da nave, olhando para Teyvat. {M#Ele}{F#Ela} encontrou a verdade sobre o passado, e eu encontrei o meu \"lar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200130,
					"content": "Só de pensar nisso já senti uma paz... ou talvez, felicidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200131,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Sim, você está certa. Essas não são coisas que eu teria sentido antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200133,
					"content": "Então, contei para Maalaus a nossa história, incluindo o que aconteceu depois que chegamos à lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200134,
					"content": "Ela pareceu muito satisfeita depois disso, como se tivesse encontrado a inspiração que tanto desejava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200135,
					"content": "Ah. Então agora é hora da grande artista fazer sua mágica, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Heh, você não levou a Paimon lá em cima daquela vez, então ela está bem curiosa para saber o que a Maalaus vai pintar também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "E o que vamos usar como tinta desta vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Desta vez é algo especial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200139,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus diz que quer tintas que pertençam somente a nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200141,
					"content": "E... o que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Acredito que ela queira coisas que façam vocês se lembrarem desta jornada, do que ganharam com ela e da alegria que ela trouxe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200143,
					"content": "Não se preocupem. Maalaus só quer ver esses objetos e senti-los. Ela não usaria nada tão precioso como tinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200144,
					"content": "O que você deu para ela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Solo da lua, e o cartão que vocês me deram na Noite da Oração Lunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761200146,
					"content": "#Ah, então basicamente tem que ser algo que represente essa aventura, né? Beleza, então. {NICKNAME}, você escolhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Bem, isso com certeza é bem especial...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
