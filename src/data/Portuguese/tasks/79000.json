			"dialogs": [
				{
					"id": 790000401,
					"content": "Encontrei! Tesouro, tesouro... Quero saber o que vamos encontrar dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000402,
					"content": "Eh? Há uma fechadura nele. E também está codificada... Parece que precisaremos do código para abri-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000403,
					"content": "Não podemos apenas quebrá-la?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "Espera! O que acontecerá se o que tem dentro também quebrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000406,
					"content": "Em vez disso, vamos encontrar uma maneira de destravá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000410,
					"content": "Mas como esta caixa contém \"relíquias de família\" e está trancada com um código...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000411,
					"content": "Isso deve significar que a pessoa que a trancou usou um código que é fácil de lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000412,
					"content": "Parece que nossa única chance são aquelas conchas que armazenam sons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000413,
					"content": "Vamos ouvir os sons dentro dessas conchas novamente. Espero que possam nos dar algumas dicas sobre o código...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000404,
					"content": "Parece que teremos que encontrar uma maneira de destravá-la.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "Mas não tem nada por aqui que parece uma placa de pedra, pintura, pedaço de papel, entalhador ou caderno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000408,
					"content": "Não há estudiosos, Ladrões de Tesouro e Aventureiros por perto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Sim. Hmm ... Este é um teste sem precedentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				}
			]
		}
