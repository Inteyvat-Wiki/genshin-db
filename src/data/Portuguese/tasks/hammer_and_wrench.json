						413421003
					]
				},
				{
					"id": 413421003,
					"content": "O que posso estar, senão bem, eh? Não é nada, não é nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421004
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413421004,
					"content": "Eu deveria voltar ao trabalho agora. Quando terminarmos... *Suspiro* Bem, pensarei sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421005
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413421005,
					"content": "Então vou ajudar vocês também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421006
					]
				},
				{
					"id": 413421006,
					"content": "Oh? Que bom. Então pode por favor me passar aquelas tábuas de madeira?",
