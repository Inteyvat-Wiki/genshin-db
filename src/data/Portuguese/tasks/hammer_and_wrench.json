			"dialogs": [
				{
					"id": 413421202,
					"content": "Hmm, isso deve ser suficiente. Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413421203,
					"content": "Ainda há algumas coisas e afins a serem resolvidas. Posso te incomodar em ir ao cais e fazer um inventário de algumas mercadorias recém-chegadas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413421204,
					"content": "Deve haver um total de três caixas empilhadas no cais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413421205,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "Vou deixar com você. Eu tenho que acabar esse trabalho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang, a Chave Inglesa"
				}
			]
		},
