			"trigger": {
				"objectNames": [
					"Siyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "Acho que devo enviar a ele uma Lanterna Celeste no fim das contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420102,
					"content": "Enviar uma Lanterna Celeste para quem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "Oh, Viajante, é você. Bem, Wang, A Chave Inglesa, sempre cuidou bem de mim. Mesmo agora, ele me ajuda o tempo todo - ele é quase como um irmão de verdade para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420104,
					"content": "Isto deveria ser um festival, e mesmo assim ele continua trabalhando sem parar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420105,
					"content": "Eu quero dar a ele uma Lanterna Celeste. Nós dois brincamos juntos desde que somos pequenos. Quando ele era uma criança, o que mais gostava de ver era elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420106,
					"content": "Se ele ganhar uma, com certeza ficará feliz. Viajante, você pode me ajudar a entregar essa Lanterna Celeste para ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420107,
					"content": "Você não entrega pessoalmente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "Eu gostaria de entregar pessoalmente, mas ainda tenho muitas coisas para fazer em casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420110,
					"content": "Saí para fazer compras, entretanto, o meu marido fica sozinho em casa tratando dos negócios. Eu tenho que voltar para casa para ajudá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420111,
					"content": "Então vou deixar o negócio de Lanternas Celestes para você. Quando estivermos mais livres, eu e o meu marido visitaremos o Wang, a Chave Inglesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420112,
					"content": "Aí espero que ele também possa ficar mais livre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siyu"
				},
				{
					"id": 413420108,
					"content": "Seria melhor você entregar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
