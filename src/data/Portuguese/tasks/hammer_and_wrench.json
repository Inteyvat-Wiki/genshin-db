			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang, a Chave Inglesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "Siyu? Ela... Ela me mandou uma Lanterna Celeste? De-Deixe-me ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420502,
					"content": "Hahaha, ela escreveu este desejo para mim, não foi? Eu me lembro de querer realizá-lo acima de tudo quando eu era criança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420503,
					"content": "Tantos anos se passaram num piscar de olhos. O tempo realmente voa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420504,
					"content": "Mesmo assim, como ela chegou a lhe pedir para entregar esta lanterna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420505,
					"content": "Ela tem coisas para tratar em casa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "Ah, entendo... Bom, bom. Isso é realmente bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420508,
					"content": "Siyu deve estar bem... Fico muito feliz por ela... Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420509,
					"content": "Está bem... Eu tenho muitas coisas para fazer... Vou me embora agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420506,
					"content": "Ela precisa voltar para casa para ajudar seu marido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
