			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "Siyu enviou a ele aquela Lanterna Celeste, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420603,
					"content": "Você nos ouviu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "Ha, eu só o conheço muito bem. Nem era preciso adivinhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420606,
					"content": "Ele foi assim no último ano... Depois de sair da casa, ficou sozinho lá perto do barco",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420607,
					"content": "Eu sei o seu motivo para fazer isso... Mas... Ugh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420608,
					"content": "Viajante, você poderia ir ajudá-lo? Estamos em um festival, não é bom que ele fique se estressando em uma época dessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420609,
					"content": "Está bem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "*Suspiro* Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420611,
					"content": "Aposto que agora ele já está trabalhando no barco... Vá lá rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420612,
					"content": "Vou preparar algum lanche... Quando terminarem, venham para cá e comemos juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hammer Li"
				},
				{
