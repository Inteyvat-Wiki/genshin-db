			},
			"dialogs": [
				{
					"id": 413420901,
					"content": "Está feito. Espero não ter te feito esperar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420902,
					"content": "Oh, você já resolveu tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420903,
					"content": "#Sim. Foi um problema pequeno e, além disso, eu tive a ajuda dest{M#e}{F#a} viajante, por isso foi fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420904,
					"content": "Você... *Suspiro*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420905,
					"content": "Ah, vamos lá. É uma época festiva, não tem necessidade de ficar de cara fechada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420906,
					"content": "Ok! Você que sabe! A Lanterna Celeste já está pronta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420907,
					"content": "A Lanterna Celeste... Eu me esqueci totalmente! Peço desculpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420908,
					"content": "Tudo bem, tudo bem. É só uma Lanterna Celeste, não é nada demais se eu não a soltá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "Wang, a Chave Inglesa"
				},
				{
					"id": 413420909,
					"content": "Para com isso! Você não está realmente sugerindo que celebremos o Ritual de Lanternas sem uma lanterna, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420910,
					"content": "Viajante, você poderia fazer uma Lanterna Celeste para o meu amigo também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "Hammer Li"
				},
				{
					"id": 413420911,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "Obrigado! Então vamos ficar guardando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hammer Li"
				}
			]
		},
