			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "Ugh! Que dor de cabeça! O que devo fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "Estou praticando para as provas dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530104,
					"content": "*Suspiro* Mas eu não sou tão forte quanto a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530105,
					"content": "Creio que seja melhor me concentrar nas técnicas em vez da força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530106,
					"content": "Por exemplo, eu estava pensando como eu poderia quebrar todos estes manequins de madeira com um golpe só.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530107,
					"content": "Se você estiver com tempo, venha pensar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530108,
					"content": "Deixe-me pensar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "Claro, vá com calma. Não é como se esses espantalhos fossem fugir sozinhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530111,
					"content": "Nem a minha vida vai para algum lugar enquanto estiver presa resolvendo isso, ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530114,
					"content": "A essa distância, talvez a melhor solução fosse eu lidar com um lado e soltar uma bomba para lidar com o outro lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530115,
					"content": "Hahaha... Estou brincando, as coisas como bombas, não é nada fácil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530109,
					"content": "#E se nós tentarmos junt{M#os}{F#as}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "Você gosta de combate em equipe então? Tudo bem para alguns... Sempre tem alguém para ajudá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200530113,
					"content": "Para pessoas como eu, só me resta aprender por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
