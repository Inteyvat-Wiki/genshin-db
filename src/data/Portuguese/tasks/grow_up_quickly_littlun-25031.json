					}
				]
			},
			"dialogs": [
				{
					"id": 250310501,
					"content": "Então, como foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani está sã e salva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "Ufa... Eu estava morrendo de preocupação. Se você tivesse demorado um pouco mais, eu mesma teria saído para procurar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310505
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310505,
					"content": "Aquela tola não poderia ter escolhido um tópico mais simples? Com a habilidade dela, tenho certeza que ela ainda teria conseguido uma nota alta suficiente para se formar.",
					"roleType": "TALK_ROLE_NPC",
