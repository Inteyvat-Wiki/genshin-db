						"position": [
							-1546.831,
							56.704,
							8112.335
						],
						"pointId": 350400120
					}
				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "Obrigada, obrigada pela sua ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Se eu pudesse ter me livrado daquela maldita sacola mais cedo, eu teria lidado com eles por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "De jeito nenhum! Teríamos vindo para Natlan por nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Espera aí, você é... Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Hã? V-Você é, {NICKNAME}, não é? É mesmo você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Essa senhorita ao seu lado, certamente não é...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Narzam, dos Ladrões de Tesouro. Nos conhecemos antes. Você não esqueceu, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "Ufa... Você é realmente minha salvadora! Quantas vezes você já me salvou mesmo? Uma, duas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Espero que não esteja contando aquela vez que você estava comigo. Isso foi porque você insistiu em ficar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "É claro que não estou contando aquela vez. E o que você quer dizer com \"eu insisti em ficar\"? Eu já te paguei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "É, só o suficiente para cobrir a comida e bebida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Não me diga que você está aqui pela sua tese de novo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Hehe, bem... Considerando quantas infinitas horas de trabalho duro eu coloquei nisso, eu não poderia apenas deixar ser desperdiçada, não é...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Apliquei para receber financiamento especial da Academia dessa vez, e até decidi um tópico de pesquisa sem encontrar nenhuma resistência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Além disso, tenho Narzam comigo como minha guarda. Ela espantou todos os malvadões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Provavelmente mais o fato de que não estamos carregando nada valioso o suficiente para fazer valer o tempo deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Mas no fim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "...Esse caminho todo, bem desde que saímos dos Filhos dos Ecos, essa garota está segurando essa sacola com todos os seus documentos dentro, como se fosse um bebê.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "Para ser sincera, até para mim, ela se parece com uma tola se agarrando a algum tipo de tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "E alguém carregando um tesouro, andando pela natureza vazia com apenas uma única guarda para protegê-la... Quem não tentaria algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Bem, você está certa sobre algo... Minha bolsa está realmente cheia de tesouros! Não apenas contém todos os meus registros de entrevistas de campo, mas cópias de vários documentos também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Cheia de tesouros como esse, não terei problemas em escrever minha tese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "E meu tópico escolhido — a \"Peregrinação do Retorno da Chama Sagrada\". É um assunto de grande importância, então certamente conseguirei me graduar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Oh, e é claro, eu não conseguiria ter feito isso sem Tahmures. Em primeiro lugar, isso foi ideia dela! Ela realmente é uma ótima amiga, hehee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Muito obrigada novamente, {NICKNAME}. Se não fosse por você, esses malvadões não apenas teriam acabado com meus livros, mas teriam roubado meu dinheiro também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Um tempo atrás, eu finalmente consegui ganhar um pouco de dinheiro ao ajudar a organizar alguns livros e materiais. Se tivesse sido roubada, eu não teria conseguido arcar com nenhum material novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "Verdade, mas você acabaria gastando todo seu dinheiro em livros mesmo assim. Se eu não tivesse confiscado sua carteira, teríamos certamente ficado com fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "E-Eu não compro tantos livros assim... compro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "Enfim, chega de falar por ora. Ainda precisamos ir para o Povo das Termas para pegar materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "Então, adeus! Te garanto que da próxima vez que nos encontrarmos, minha tese estará terminada! E quando esse momento chegar, te pagarei um delicioso jantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "Você ainda acabou se deparando com problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
		{
			"id": 2503105,
