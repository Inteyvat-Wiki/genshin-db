					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "Vocês tiraram as fotografias que pedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Oh, suas fotografias estão ótimas. Minha pesquisa com certeza usará elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Que paisagem bonita... Lembrou-me dos festivais de minha terra natal de Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "Sumeru tem quais festivais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Você não sabia? Festejamos o Festival Sabzeruz para comemorar o nascimento da Lorde Kusanali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "Mas se estamos falando da atmosfera do festival, há algumas diferenças com o Festival da Brisa Florescente de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Falando nisso... Não consegui ir ao Festival Sabzeruz deste ano! Já passou muito tempo e não sei como é que está a situação na Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Mas, já falei muito. Muito obrigado pela sua ajuda, por favor, aceite isso como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
	]
