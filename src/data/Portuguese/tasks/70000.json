			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "Que costume romântico! Isso realmente merece ser pesquisado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "Oh, é você, Viajante! Você está aqui também por ter interesse nos cantos românticos de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Podemos ler os registros escritos a qualquer hora, mas perdemos com facilidade os momentos históricos que estão acontecendo ao nosso redor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "As pessoas de Mondstadt têm costumes especiais durante o romântico Festival da Brisa Florescente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "As suas formas e as histórias por trás desses costumes são a minha área da pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "Estou escrevendo um relatório sobre isso. Apenas uma descrição em texto não é o suficiente. Você pode ajudar a tirar uma foto do Festival da Brisa Florescente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "Obrigado por me ajudarem com minha investigação científica. Viajante, escreverei seu nome em meu relatório.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "O que mais vale a pena registrar são as <color=#00E1FFFF>flores de decoração suspensas na Praça da Fonte</color>, a<color=#00E1FFFF> estátua decorada com flores em frente da Catedral</color> e <color=#00E1FFFF>a dona da Loja de Flores</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Ajude-me a registrar essas paisagens. Depois de tirar as fotografias, traga elas até mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "É melhor que você vá por si mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "Não! Eu não posso sair porque preciso terminar meu relatório. Se eu sair agora, esquecerei todas as minhas ideias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "Ainda tenho algo a lhe pedir, Viajante. Apesar de não ser muito, posso lhe dar uma recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
