				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "#Bem-vind{M#o}{F#a} ao Suspiro das Flores. Você precisa de alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "Sobre a fotografia de Sayid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Na verdade, o Festival da Brisa Florescente é um feriado tradicional de Mondstadt. Mas as pessoas de Sumeru não o celebram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "Você quer tirar fotos de mim com as minhas flores? Sem problemas! O senhor Sayid é uma pessoa muito especial, e talvez isso seja uma característica dos estudiosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
