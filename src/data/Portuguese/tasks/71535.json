				]
			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#Que surpresa te encontrar por aqui, {NICKNAME}. Você deve estar aqui para o Ritual de Lanternas também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Você está tentando fazer um envelope de presente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Isso, tô tentando fazer um para Candace, mas não tô gostando do resultado até agora. Eu estava prestes a começar do zero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Candace não veio contigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Ainda não, mas ela vai vir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Ela não concordou em vir comigo para Liyue de primeira. Ela disse que tinha que ficar para trás para proteger a vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Eu disse a ela que todos merecem se soltar no fim do ano. Eu tive que escoltar uma caravana até Liyue de todo jeito, então ela deveria ter vindo também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Eu até ofereci alguns dos meus homens para cuidar a vila enquanto isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Mas não consegui convencê-la. No fim, ela só mudou de ideia porque as pessoas na vila ficaram atazanando ela para tirar uma folga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Mesmo assim, ela ainda insistiu que tinha trabalho a terminar primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Mas a caravana não aguarda ninguém... Então aqui estou sozinha por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "Foi tão difícil escolher um presente — tem tantas coisas legais para escolher aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Acabei comprando um colar para ela, mas aí eu soube da tradição de envelope de presente durante do Ritual de Lanternas, então decidi tentar fazer um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "E, bem... Como eu disse, não tem ido muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Tenho certeza que você sabe mais sobre isso do que eu, {NICKNAME}. Pode me dar umas dicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Sem bronca, me deixa dar uma olhada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
