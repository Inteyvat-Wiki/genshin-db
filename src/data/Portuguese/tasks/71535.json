			"dialogs": [
				{
					"id": 715350401,
					"content": "Eita! Parece que você tem talento para artesanato, hein? Esse envelope de presente é lindo, valeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "Acho que esse é como seu presente para mim! Eu não tenho nada comigo agora, mas quando voltar a Sumeru, pode ter certeza que te mando alguma coisa como retribuição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Agora, só preciso fazer um para Candace para eu poder dar a ela com o colar. Tenho certeza que ela vai amar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Ah, isso me lembra, me pergunto se ela já chegou... Faz um tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
