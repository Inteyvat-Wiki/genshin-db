				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "Os negócios estão realmente péssimos ultimamente... Talvez eu devesse juntar algum dinheiro e tentar alugar uma barraca na Cidade de Nasha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450113,
					"content": "Tem alguma coisa boa aí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "Só alguns enfeites que trouxe de Natlan, fique à vontade para dar uma olhada se algo chamar sua atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450102,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "Ora, ora, um cliente! Olá! Sou Kuzmich, um comerciante viajante de Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450104,
					"content": "Bem, é assim que gosto de me apresentar, mas na verdade só faço uns pequenos negócios durante as viagens para ganhar um dinheiro para o caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450105,
					"content": "Mas, quando passei por Natlan, o povo de lá era entusiasmado demais, acabei entrando no clima e... Agora, se eu não vender toda essa mercadoria, não vou ter dinheiro nem para a passagem de volta para casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450106,
					"content": "Você está voltando para Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Sim, assim que eu vender este lote de mercadorias, vou comprar uma passagem de trem e voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450108,
					"content": "Embora neve o ano todo lá e tudo esteja coberto de gelo e neve, você só pode ficar preso na cidade todos os dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450109,
					"content": "Mas depois de tanto tempo longe, estou começando a sentir falta dos dias em que podia dormir o dia inteiro em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450110,
					"content": "Os negócios parecem bem parados por aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "É... mas se eu quiser uma barraca decente na cidade, vou ter que pegar dinheiro emprestado do Banco do Norte. Ouvi dizer que o da Cidade de Nasha não tem uma reputação muito boa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450112,
					"content": "Ah, tanto faz. Pelo menos o movimento aqui é bom. Enquanto as pessoas continuarem passando, as mercadorias vão acabar vendendo, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450115,
					"content": "Desculpe, eu tenho que ir agora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "Ei, por que já está indo embora? Não vai dar uma olhadinha...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "Ora, não acredito que já esgotaram! Parece que eu tenho talento para os negócios, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450302,
					"content": "A seguir, pedirei aos Portadores da Lâmpada para me guiarem pelo Pântano dos Pesadelos. Depois, seguir para o norte deve ser tranquilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450303,
					"content": "Talvez eu encontre algumas oportunidades de negócio no caminho de volta... Bem, é aqui que nos separamos. Até a próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "Que coincidência, nos encontramos de novo! Gostaria de comprar algo? Meu novo estoque não está vendendo nada... por favor, me ajude aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450407,
					"content": "Deixe-me ver o que você tem de bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "São todos produtos típicos da região. Não se preocupe, vou te fazer o melhor preço!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450402,
					"content": "Por que você fez outro reabastecimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Ah, você sabe como é — negócios são negócios. É preciso aproveitar enquanto o ferro está quente, certo? Encontrei uma boa oportunidade em Piramida, alguém precisava vender suas mercadorias com urgência e me fez um bom preço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450404,
					"content": "Acabei me empolgando demais e esqueci que devia estar voltando para casa... então comprei tudo. E agora, aqui estou eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450405,
					"content": "Adivinha por que ele estava com tanta pressa para vender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "Ah, por favor, não joga isso na minha cara... Que tal dar uma olhada em vez disso? Talvez encontre algo útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450409,
					"content": "Desculpe, estou de saída.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "Ei... não vá embora ainda! Tenho certeza de que há algo de que você precisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614506",
							"2"
						],
						"stepId": 7614506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "Ótimo! Finalmente vendi tudo. Parece que a velha estratégia de \"lucro pequeno e giro rápido\" realmente funciona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450602,
					"content": "Tecnicamente, eu deveria estar voltando para Snezhnaya... embora, no momento, eu mal tenha conseguido o suficiente para a viagem. Cheguei aqui de mãos vazias e preferia não voltar do mesmo jeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450603,
					"content": "*Suspiro* De qualquer forma, obrigado por apoiar meus negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "Ora, ora, o destino realmente age de maneiras misteriosas — encontrar você aqui de novo! Quer dar uma olhada? Desta vez eu tenho umas mercadorias bem boas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450709,
					"content": "Deixa eu ver o que você tem de bom.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "Ei, tudo isso são equipamentos desativados pelos Fatui. Você não vai achar em nenhum outro lugar, então pegue o que quiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450702,
					"content": "Você não tinha voltado para Snezhnaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "Pra ser sincero, minha casa fica em Novokitezhgrad, e toda a minha família trabalha nas minas. Eles são mais teimosos que anões, e quando eu disse que queria abrir meu próprio negócio, ficaram totalmente contra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450704,
					"content": "Então, antes de sair, prometi que ia fazer uma grande fortuna... Mas quem diria que eu acabaria mal conseguindo juntar dinheiro suficiente para a viagem de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450705,
					"content": "Ficar rico já não é mais possível, mas pelo menos quero ganhar um pouco — algo para mostrar quando eu voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450706,
					"content": "Por que você está no território dos Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "Ora, qual é! Eu sou um cidadão de Snezhnaya que respeita a lei, e estar perto dos Fatui aqui é praticamente como estar em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450708,
					"content": "Todas as minhas mercadorias são equipamentos desativados pelos Fatui, e eles mesmos me pediram para cuidar disso. Você não vai encontrar nada igual em nenhum outro lugar, só aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450711,
					"content": "Não, valeu, já estou indo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "Ah, que pena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "Muito obrigado, de verdade... obrigado mesmo! Graças a você, não vou precisar voltar com essa cara de fracasso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450902,
					"content": "Desta vez é mesmo uma despedida. Você comprou tanta coisa de mim — acho que isso faz de nós amigos agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450903,
					"content": "Se um dia tiver a chance de ir para Snezhnaya, me procure em Novokichevgrad. Até a próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		}
	]
}