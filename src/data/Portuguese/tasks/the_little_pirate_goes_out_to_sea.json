			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "#Oh, se não é {M#o}{F#a} Viajante e o Pequeno Meng! Vocês precisam de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270202,
					"content": "Hã? Eu, uh, hmmm... Viajante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270203,
					"content": "Gostaríamos de pegar sua cozinha emprestada, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Claro, mas isso é tão repentino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270205,
					"content": "Oh. Se é assim... tudo bem, use a vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270206,
					"content": "Pequeno Meng, lembre-se de não ser muito exigente com sua comida quando estiver viajando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270207,
					"content": "E–Eu entendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270208,
					"content": "#{NICKNAME}, me ensine a fazer um prato delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270209,
					"content": "Eu gostaria de dar uma surpresa ao meu pai enquanto estivermos no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270210,
					"content": "Pode apostar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#Então, {NICKNAME}, o que deveríamos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
