			},
			"dialogs": [
				{
					"id": 210270601,
					"content": "Uau, essa receita é tão detalhada... Tantas palavras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270602
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270602,
					"content": "Hmm. Sabe de uma coisa? Paimon acha que não vai ser tão satisfatório se for algo tão simples.",
