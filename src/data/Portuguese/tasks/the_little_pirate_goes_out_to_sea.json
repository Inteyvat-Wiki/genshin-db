					"Pequeno Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{NICKNAME}, você veio na hora certa, eu estava a sua procura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270102,
					"content": "Hã? Qual o problema, Pequeno Meng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "Você se lembra quando te pedi que me ajudasse a enviar uma garrafa rio abaixo com minhas preocupações nela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270104,
					"content": "Honestamente eu não tinha muita esperança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270105,
					"content": "Mas então, um dos parceiros comerciais do meu pai veio procurá-lo há alguns dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270106,
					"content": "Ele disse que eles estão atualmente procurando entrar no ramo dos cogumelos, e estão planejando ir à Sumeru para pesquisar o mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270107,
					"content": "Então eles queriam perguntar ao meu pai se ele gostaria de ir com eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270108,
					"content": "E até disseram que poderiam me levar junto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270109,
					"content": "Meu pai não concordou no início, mas um de seus amigos puxou uma carta e pediu para falar em particular com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270110,
					"content": "Eles conversaram um pouco e, depois disso, meu pai disse que eu poderia ir com ele para Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270111,
					"content": "Bem, não sei porque ele mudou de ideia tão de repente assim, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270112,
					"content": "Eu já posso ir a Sumeru viajar! Estamos indo a Sumeru! Uhuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270113,
					"content": "Parabéns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#Com certeza a garrafa deve ter funcionado! Tudo graças a você, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270117,
					"content": "Meu pai disse que uma vez em Sumeru, eles também irão a um lugar chamado Vila Qiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270118,
					"content": "Vila Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Sim. Papai disse que é uma aldeia de chá onde eles plantam muitas árvores que produzem folhas de alta qualidade. O nome é um pouco complicado, porém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270120,
					"content": "Bem, vamos deixar isso de lado por agora. Precisamos ir para Sumeru primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270121,
					"content": "É realmente bem longe daqui, então vai levar um tempo até chegarmos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270122,
					"content": "Mas ouvi as pessoas dizerem que viajar requer bastante preparação, já que você pode se deparar com todos os tipos de situações no caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270123,
					"content": "#{NICKNAME}, você que está sempre viajando por aí, não poderia compartilhar comigo algumas dicas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270124,
					"content": "Tipo, uhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270125,
					"content": "Tipo, o que você normalmente come quando está viajando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270126,
					"content": "Meu pai diz que eles sempre comem coisas que eles mesmos fizeram. Mas eu só conheço alguns pratos simples, e não sei se consigo fazê-los bem ou não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270127,
					"content": "#Ohohoho! Cozinhar! Isso sim é algo que somos especialistas, não é mesmo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Isso mesmo, eu posso te ensinar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Bem, então Paimon acha que devemos procurar por um fogão em algum canto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "...Hmmm, por que não pegamos emprestado a cozinha do Chef Mao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Chef Mao? Uhh... ele não é super assustador na maioria das vezes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270133,
					"content": "Chef Mao? Assustador? Ele é uma pessoa incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "S–Sério? Mas sempre que eu e meu pai comemos lá, ele levanta as sobrancelhas sempre que tiro as flores Qingxin do meu prato e não como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pequeno Meng"
				},
				{
					"id": 210270129,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Sabe, eu devo ir para Sumeru também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Sério? Vamos nos encontrar lá então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Pequeno Meng"
				}
			]
		},
