			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue",
					"Swan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705140101,
					"content": "O entusiasmo que reina em Mondstadt está além da minha imaginação... Nem mesmo os Hilichurls são tão vivazes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140102,
					"content": "Enfim... Sr. Yogue, por favor, não saia sozinho de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140103,
					"content": "O quê? E a minha máquina? Eu ainda preciso de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140104,
					"content": "Um, dois, três... dezoito... dezenove componentes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140105,
					"content": "Alguns aventureiros já os estão procurando para você. Por favor, espere aqui na cidade, é mais seguro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140106
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140106,
					"content": "Mas sem esses dispositivos, minha... minha inspiração, sabe? O que eu farei quando minha inspiração aparecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140107,
					"content": "A inspiração vem e vai... Como um soluço depois de uma bebida, é passageira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140108,
					"content": "Ah, essa é uma boa metáfora, vou anotar. Xavier vai adorar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140109,
					"content": "Você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140110
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140110,
					"content": "#Hã? Cavaleir{F#a}{M#o} Honorável... Excelente, por favor, venha aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140111,
						705140112
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140111,
					"content": "O que está acontecendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				},
				{
					"id": 705140113,
					"content": "Permita-me apresentar-lhe um cortesão de Fontaine, ele é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140114
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140114,
					"content": "Eu sou um sonhador! É assim que nos nomeamos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140115
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140115,
					"content": "#...Sr. Yogue, {M#este é o nosso}{F#esta é a nossa} Cavaleir{F#a}{M#o} Honorável de Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140116
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140116,
					"content": "#Yogue! Félix Yogue. Saudações a você, Cavaleir{F#a}{M#o} Honorável! Já conheço seus grandes feitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140117
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140117,
					"content": "Você me conhece?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140118
					]
				},
				{
					"id": 705140118,
					"content": "#Claro! É claro que eu lhe conheço. Você é conhecid{F#a}{M#o} por todo mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140119
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140119,
					"content": "Suas façanhas na batalha contra Dvalin em Mondstadt estão na capa da \"Pássaro a Vapor\" por três semanas inteiras!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140120
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140120,
					"content": "Hahaha, se aqueles repórteres soubessem que eu estava falando com você, morreriam de inveja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140121,
						705140124
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140121,
					"content": "O que é \"Pássaro a Vapor\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140122
					]
				},
				{
					"id": 705140122,
					"content": "Você não sabe? O \"Pássaro a Vapor\" é um periódico bem conhecido na Corte de Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140123
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140123,
					"content": "E foi você quem ajudou eles a atingir um recorde de vendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140125,
					"content": "Manchetes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140126
					]
				},
				{
					"id": 705140126,
					"content": "E foi você quem ajudou eles a atingir um recorde de vendas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140127
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140127,
					"content": "Manchetes de primeira página, edição completa, entrevistas exclusivas e as melhores ilustrações desenhadas à mão. Eles ganharam muita Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140128
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140128,
					"content": "Então, Viajante e Sr. Félix Yogue, vou deixar vocês conversarem. Eu... errr... eu vou fazer outra coisa, então me desculpem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140129
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 705140129,
					"content": "Swan saiu rapidamente...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705140130
					]
				},
				{
					"id": 705140130,
					"content": "Está bem, pelo que ouvi parece que os Cavaleiros de Favonius estão sobrecarregados de tarefas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140131
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140131,
					"content": "Então, por que você está aqui em Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140132
					]
				},
				{
					"id": 705140132,
					"content": "Eu? Na verdade, meu plano é visitar todos os cantos de Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140133
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140133,
					"content": "E o objetivo da minha viagem é promover esse \"Núcleo Cinético\" que fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140134
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140134,
					"content": "Em poucas palavras, um Núcleo Cinético é um tipo de dispositivo como um relógio. Se você der corda em sua mola periodicamente, esses núcleos poderão fornecer força motriz por um longo período de tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140135
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140135,
					"content": "Eu até mesmo criei um brinquedo de movimento perpétuo energizado por esse Núcleo Cinético para demonstrar suas capacidades. Eu o chamo de Pintura Mecânica de Movimento Perpétuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140136
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140136,
					"content": "Eu adoraria mostrar para vocês, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140137
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140137,
					"content": "Ele é muito chamativo, incluindo para os monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140138
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140138,
					"content": "A essa altura, eles devem ter desmontado meu mecanismo em inúmeras peças de forma pouco amigável, brincando com cada componente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140139
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140139,
					"content": "Embora eu já tenha pedido ajuda à Guilda dos Aventureiros, ainda não tive notícias deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140140
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140140,
					"content": "#Cavaleir{F#a}{M#o} Honorável, se você estiver {M#interessado}{F#interessada}, pode me fazer um favor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140141
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140141,
					"content": "Acredite, nem meu mecanismo ou meu pagamento lhe desapontarão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140142
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140142,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140143
					]
				},
				{
					"id": 705140143,
					"content": "#Ótimo, você é tão incrível quanto os jornais dizem, {M#um}{F#uma} forte aventureir{M#o}{F#a} de bom coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140144
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140144,
					"content": "É uma pena que estamos em Mondstadt agora, se estivéssemos na Corte de Fontaine, eu definitivamente traria um repórter do \"Pássaro a Vapor\" para uma entrevista exclusiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140145
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140145,
					"content": "Eles ficariam tão impressionados com seu carisma que apareceria nas manchetes por mais três semanas! Isso sem falar nos direitos autorais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140124,
					"content": "Manchetes de primeira página, edição completa, entrevistas exclusivas e as melhores ilustrações desenhadas à mão. Eles ganharam muita Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140125
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140112,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705140113
					]
				}
			]
		},
		{
