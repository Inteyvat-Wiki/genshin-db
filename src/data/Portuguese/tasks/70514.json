			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "#Cavaleir{F#a}{M#o} Honorável! Você está de volta! Como está indo sua busca por componentes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705140302,
					"content": "São estes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7051404,
			"completionStepIds": [
				7051404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
