				},
				{
					"id": 700800102,
					"content": "Ah. Não sabia que você apreciava tanto assim suas bebidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800103
					],
					"speakerTitle": "Kshama"
				},
				{
					"id": 700800103,
					"content": "Naquela época, quando entregávamos tijolos ao Mausoléu do Rei Deshret, ganhávamos duas grandes canecas de cerveja de graça todos os dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800104
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800104,
					"content": "Falando nisso, Maukie estava entre aqueles que foram restaurados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800105
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800105,
					"content": "Não. Suspeito que os figurões pretendem lidar com ele... violando as regras.",
