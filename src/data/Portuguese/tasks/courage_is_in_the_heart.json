			"dialogs": [
				{
					"id": 730670301,
					"content": "Bem... este Arashakun é o Aranara que escreveu esta nota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Por que a escrita nas notas às vezes é tão grande e outras tão pequena, a grande é tranquila, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "As letras pequenas fazem os olhos de Paimon doerem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Paimon não se sente confortável em ler letras pequenas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "É sempre difícil ler letras pequenas quando Paimon está acostumada com as letras normais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Bem, este Arashakun não voltou depois de escrever as últimas páginas de suas anotações...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Vamos dar uma olhada nessa caverna. As notas dizem que a \"coragem desapareceu\"... Dá para coragem desaparecer mesmo? Paimon está curiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
