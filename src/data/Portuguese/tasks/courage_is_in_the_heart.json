			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(As primeiras páginas estão escritas em letras muito pequenas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670202,
					"content": "\"Oh, não posso acreditar que Nara está disposto a ser amigo de Arashakun... Que Nara bom! Não se importa com o covarde Arashakun e até ensinou Arashakun a escrever as palavras de Nara...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670203,
					"content": "\"Bom Nara confortou Arashakun quando se assustou com uma folha que caiu sobre sua cabeça, e Nara do bem é o melhor amigo de Arashakun!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670204,
					"content": "(A caligrafia se torna pequena e afobada nas páginas que se seguem...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670205,
					"content": "\"Amigo Nara foi levado pelo \"Rei Demônio de Máscara Peluda\", com suas longas mãos, tão assustadoras...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670206,
					"content": "\"Mas... mas temos que salvar Nara...*sniff*\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670207,
					"content": "(Nas páginas que seguem, em letras muito grandes e marcadas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670208,
					"content": "\"O Rei Demônio de Máscara Peluda foi derrotado! Resgatei amigo Nara, que deu a Arashakun sua \"coragem\", e ele deixou de ser Arashakun covarde que já foi um dia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670209,
					"content": "\"Com a \"coragem\", Arashakun lutou bravamente contra os monstros de máscara peluda, para que mais nenhum Nara tenha que se preocupar em ser perturbado pelos monstros de máscara peluda de novo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670210,
					"content": "(Nas últimas páginas, as letras voltam a ser muito pequenas...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670211,
					"content": "\"*sniff*... Como isso aconteceu? A coragem que Nara deu Arashakun a desapareceu... Deve ter sido roubada pelo Rei Demônio de Máscara Peluda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				},
				{
					"id": 730670212,
					"content": "\"O Rei Demônio de Máscara Peluda tem garras longas e é terrivelmente astuto, mas Arashakun não tem 'coragem' para fazer qualquer coisa... Aah, Arashakun deve procurar na <color=#00E1FFFF>caverna ao leste</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nota com Caligrafia Inconsistente"
				}
			]
		},
