			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Embora Paimon tenha adivinhado vagamente... que o \"Rei Demônio de Máscara Peluda\" é realmente um Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Sim, o \"Rei Demônio de Máscara Peluda\" é um Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Todos os \"Hillychuchu\" são \"Reis Demônio de Máscara Peluda?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Não, não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Você pode entender desse jeito, Arashakun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Sim, Arashakun entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Ah, com a ajuda de Nara {NICKNAME} e Paimon, Arashakun lidera o ataque e é invencível! Nem mesmo o astuto Rei Demônio de Máscara Peluda foi páreo para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Hoje o Arashakun deve voltar e fazer uma grande anotação disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Uma grande anotação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Isso aí! Escrever uma grande nota, em palavras bem grandes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Paimon sente que Arashakun com \"coragem\" e Arashakun sem \"coragem\" são como dois Arashakuns diferentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Sem coragem, Arashakun tem mãos e pés fracos e não consegue fazer nada certo. Com coragem, Arashakun pode fazer todos os tipos de grandes coisas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "Portanto, a coragem não é apenas o melhor presente que o amigo Nara deu para Arashakun, é também a coisa mais importante para Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670715,
					"content": "Então guarde-a bem, não deixe os Hilichurl a roubar novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670716,
					"content": "Arashakun sabe, não deixará a \"coragem\" ir embora de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				}
			]
		}
	]
