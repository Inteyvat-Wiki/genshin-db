				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "Caramba, esses Hilichurls parecem ter deixado cair uma coisa estranha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "Parece que é feito de flores. Estranho que obviamente são apenas flores comuns que foram colhidas há muito tempo... e ainda assim não murcharam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Paimon pode sentir que aquela coisa está cheia de energia Dendro... E foi deixada aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "Deve pertencer a um Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Sim, com certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Bem, essa coisa de flores tem tanta energia Dendro que não murchou nem mesmo nas mãos dos Hilichurls...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Talvez eles carregaram com eles o tempo todo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Bem, vamos devolver isto ao Aranara o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Vamos entrar e dar uma olhada, {NICKNAME}. Talvez quem perdeu esteja triste com isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Talvez seja algo muito valioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Pode ser de Hilichurls Dendro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Como é? Deve ser de um Aranara que mora por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306702,
			"completionStepIds": [
				7306705
			],
