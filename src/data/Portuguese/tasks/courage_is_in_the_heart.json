			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "É isso! É isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "Este é o \"Amuleto da Coragem\" de Arashakun, depois de ficar longe de Arashakun por uns dias, a cor das flores ficou um pouco opaca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Mas não importa, Arashakun irá protegê-lo bem no futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "\"Arashakun é um Aranara corajoso e bom! Não é um Aranara medroso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Muito obrigado, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "O atual Arashakun é Arashakun que encontrou sua coragem e nada pode me parar. Eu derrotei o \"Rei Demônio de Máscara Peluda\" e o farei de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Oh uau, parece que o tom de voz está diferente do que era antes).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#O Rei Demônio de Máscara Peluda fez muita coisa ruim. Por favor, venham comigo, Nara {NICKNAME} e Paimon, juntos poderemos acabar com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun pode sentir que hoje... é o dia que vamos à caverna dele e damos um fim a tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Oh, {NICKNAME}, vamos junto também... e ver o que é realmente aquele \"Rei Demônio de Máscara Peluda\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
