				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Você é Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "Snif... Sim, Arashakun é o meu nome, não se aproxime tão de repente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Agradeço por me tirarem de perigo, mas Arashakun pede que mantenham distância...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Desse jeito deixam Arashakun mais tranquilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Quê? Mas fomos nós que te tiramos de lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Ahhhh, desculpe, foi Arashakun que foi longe demais com pedido... deixou vocês com raiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Mas Arashakun estava preso e em estado de choque. Espero que me perdoem por ter sido rude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Está tudo bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Que bom então, podem dizer a Arashakun como se chamam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Paimon se chama Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Eu sou {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#*Soluço* Hmm... Por que Nara dourad{F#a}{M#o} {NICKNAME} e Paimon sabem o nome de Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Nós vimos as notas na casa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Nara {NICKNAME} leu o diário e veio à procura de Arashakun? E daí resgatou Arashakun que estava preso? Nara é {M#bondoso e poderoso}{F#bondosa e poderosa}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "Se Arashakun não tivesse perdido a sua \"coragem\", não teria ficado preso desse jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Ah sim, Paimon leu isso nas notas... Arashakun, o que você quer dizer exatamente sobre perder sua \"coragem\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "É uma história muito antiga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Muitas luas atrás, Arashakun era, como é agora, um Arashakun sem \"coragem\"... Naquela época, até mesmo o som de um galho quebrando manteria Arashakun acordado à noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "#Mas o covarde Arashakun tinha um amigo Nara que queria acompanhá-lo. Mesmo que aquele amigo não fosse como {M#a}{F#o} grande Nara Varuna, ele era um bom Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Ele nunca zombou Arashakun por ser tímido, e se ofereceria para segurar a mão do Arashakun quando me sentia assustado... um amigo que Arashakun nunca irá esquecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Mas um dia, Nara foi capturado pelo Rei Demônio de Máscara Peluda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Espere, esse \"Rei Demônio de Máscara Peluda\" é o quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "O \"Rei Demônio de Máscara Peluda\" é um rei demónio, mascarado e com a cara felpuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "...hã, claro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Já sabe o que é, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Sabe que é estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Basicamente, esse \"Rei Demônio de Máscara Peluda\" pegou o amigo de Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "O \"Rei Demônio de Máscara Peluda\" é tão sinistro e astuto que só de pensar nisso o corpo inteiro de Arashakun começa a tremer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "Embora Arashakun tivesse medo que o Rei Demônio de Máscara Peluda lhe batesse, ele tinha ainda mais medo de nunca mais ver o seu amigo Nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Então Arashakun se esforçou muito! Fechou os olhos, cerrou seus dentes e usou as mãos para bater, e bater, e bater! E assim o amigo Nara do Arashakun foi resgatado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Depois disso, o amigo Nara fez um \"Amuleto da Coragem\" com flores e disse a Arashakun: \"Arashakun é um Aranara bom e corajoso! Não um Aranara covarde!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "E então Arashakun ganhou \"coragem\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "Hã, mas de acordo com isto, seu \"Fechou os olhos! Cerrou os dentes e saiu batendo!\" foram atos muito corajosos, não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "Não, não, não. Foi somente depois disso que Arashakun ganhou coragem do seu amigo Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Mas você foi corajoso o suficiente para salvar seu amigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "Não, não, Arashakun tinha muito medo quando salvou amigo Nara, mãos e pés tremendo. Mas depois que ganhou sua \"coragem\", as mãos e os pés de Arashakun não tremeram mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Hm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "O amuleto é apenas um símbolo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#As palavras de Nara {NICKNAME} são tão complicadas... Tudo o que Arashakun sabe é que tem coragem só quando tem o \"Amuleto da Coragem\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Quando a \"Coragem\" de Arashakun foi roubada, Arashakun foi à caverna do \"Rei Demônio de Máscara Peluda\" para procurá-la em segredo, esperando encontrar pistas da \"Coragem\" de Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Como resultado, acabei ficando preso na caverna por causa de alguns Slimes... Felizmente, o \"Rei Demônio de Máscara Peluda\" não me encontrou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#Ah, sim {NICKNAME}, lembra daquela coisa que encontramos com os Hilichurls? Será que é o amuleto de Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Arashakun, podemos ter encontrado a \"coragem\" que você perdeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Sério?! Nara {NICKNAME} e Paimon realmente acharam a \"coragem\" de Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "A coragem sempre esteve dentro de você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Essa resposta é bem Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Sim, não há como adivinhar o que é o \"Rei Demônio de Máscara Peluda\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
