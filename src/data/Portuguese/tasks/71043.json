	"talks": [
		{
			"id": 7104301,
			"completionStepIds": [
				7104305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710430101,
					"content": "\"...Sargento Anthon descobriu um sino enorme ao sudeste. Nas paredes de pedra está escrito 'deles'...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430102
					],
					"speakerTitle": "Diário dos Fatui"
				},
				{
					"id": 710430102,
					"content": "\"Isso é muito parecido com o grande sino que o Capitão viu nas ruínas do noroeste, talvez...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430103
					],
					"speakerTitle": "Diário dos Fatui"
				},
				{
					"id": 710430103,
					"content": "\"...Enviamos Snezhevna e Fadeyka para tocarem ambos sinos em seus respectivos lados...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430104
					],
					"speakerTitle": "Diário dos Fatui"
				},
				{
					"id": 710430104,
					"content": "\"...Conforme os terríveis gritos de lamentos reverberaram por toda a pedra, a névoa preta se dissipou. Que fenômeno estranho... é como se os sinos estivessem anunciando a chegada de alguém...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430105
					],
					"speakerTitle": "Diário dos Fatui"
				},
				{
					"id": 710430105,
					"content": "\"...Dez foram perdidos, dois esquadrões da vanguarda sofreram danos tremendos. O capitão ordenou uma retirada...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710430106
					],
					"speakerTitle": "Diário dos Fatui"
				},
				{
					"id": 710430106,
					"content": "(Um mapa simples cai do diário. O mapa marca os dois sinos ao norte e sudeste, com duas caveiras assustadoras junto deles.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diário dos Fatui"
				}
			]
		},
