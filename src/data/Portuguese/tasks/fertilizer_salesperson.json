					"Kaushik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "O significado desse totem... Hã? Viajante? Você precisa de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Sobre Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Você disse que Alrani está aqui na Ilha Watatsumi? Isso é estranho. O que ela está fazendo aqui? Ela não ia para Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Ela foi presa pelos soldados...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "O quê? *Cof* Mas é claro, vir para a Ilha Watatsumi nas circunstâncias atuais... Era de se esperar que suspeitariam dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Mas isso não importa. Vamos logo para ajudar essa garota... Ela nunca pensa direito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
