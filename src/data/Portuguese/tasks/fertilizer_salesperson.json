				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "Obrigado, Viajante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130302,
					"content": "Estava preparando o fertilizante quando os monstros apareceram do nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130303,
					"content": "É algo inexplicável... Mas ainda bem que você veio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130304,
					"content": "Talvez a causa seja aquela pilha de fertilizante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "Será? Mas, eu ouvi dizer que esse cheiro é um sinal de sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130306,
					"content": "Vamos deixar isso por enquanto. Venha aqui e dê uma olhada no fertilizante. Vou explicar enquanto abro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130307,
					"content": "Espere um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130308,
					"content": "Hã? General Gorou, o que o traz aqui, estando tão ocupado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130309,
					"content": "Você está numa patrulha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "Eu estou... Hã... Talvez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130311,
					"content": "Essa pilha de... Alguma coisa... Foram vocês que fizeram?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130312,
					"content": "#Hahaha, isso mesmo. Fui eu e ess{F#a}{M#e} Viajante aqui que fizemos essa pilha de fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130313,
					"content": "Sr. Gorou, você veio aqui para ver o fertilizante também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130314,
					"content": "Hehe, você chegou na hora certa, nós estávamos prontos para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130315,
					"content": "Espere! Eu não quero ver isso. Eu na verdade vim ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130316,
					"content": "Gorou está com uma expressão de quem não está aguentando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130317,
					"content": "Vamos nos afastar dessa pilha de fertilizantes um pouco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "Certo, vamos continuar a falar ali do lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130319,
					"content": "General Gorou, afinal de contas, o que você veio fazer aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130320,
					"content": "Recentemente, muitos moradores falaram que sentiram um cheiro anormal e assustador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130321,
					"content": "Para ter certeza, vim investigar e acabei seguindo o cheiro até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130322,
					"content": "E depois, encontrei vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130323,
					"content": "Iwata, ouvi dizer que você esteve pesquisando como fazer fertilizantes, mas essa maneira de fabricá-los é muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130324,
					"content": "Perturbadora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "Isso mesmo. De qualquer maneira, Iwata, se livre logo dessa pilha de fertilizantes. Posso pensar em alguma outra maneira sobre como fazê-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130327,
					"content": "General! General Gorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130328,
					"content": "Aqui! O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130329,
					"content": "General. Nós capturamos uma pessoa suspeita aqui nas redondezas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130330,
					"content": "Essa pessoa suspeita disse que era algo... Parece que um vendedor de fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130331,
					"content": "Nós não achamos que isso estava correto e a prendemos. Por favor, venha logo dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130332,
					"content": "Mais fertilizantes? Hoje parece que todos os meus problemas envolvem isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130333,
					"content": "Está bem, irei imediatamente. E quanto a você, proteja a ordem por ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130334,
					"content": "Iwata, livre-se primeiro dessa pilha de fertilizantes, e depois nós conversaremos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130335,
					"content": "Viajante, venha junto comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130336,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "Alguém vendendo fertilizante? Paimon está com uma sensação familiar... Mas não consegue se lembrar do que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130339,
					"content": "Não importa, vamos logo ver esse problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130337,
					"content": "Vendedor de Fertilizantes...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "Provocadora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
