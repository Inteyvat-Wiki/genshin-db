					"content": "Bem, de qualquer forma, o General Gorou pediu que eu lhe ajudasse com sua pesquisa de fertilizantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "É um prazer trabalhar com você de agora em diante.",
