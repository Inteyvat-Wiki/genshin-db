				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "Alrani! Realmente é você! Por que você está aqui em Inazuma? Você não deveria estar em Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130802,
					"content": "Oh... É uma longa história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130803,
					"content": "Senhor Kaushik, você conhece Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130804,
					"content": "Você é o General Gorou, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130805,
					"content": "Sim, você está certo. Eu e Alrani somos pesquisadores da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130806,
					"content": "Depois disso, saímos da Academia para estudar tópicos diferentes. Mas não imaginei que a encontraria aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130807,
					"content": "Mas vocês pesquisadores podem sair livremente da Academia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130808,
					"content": "Eu não diria que podemos \"sair livremente\". Eu e Alrani somos Driyosh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130809,
					"content": "Para nós, viajar e aprender são parte de nosso processo de pesquisa. Dessa forma, nos permitem sair da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130810,
					"content": "General Gorou, posso garantir que Alrani está falando a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130811,
					"content": "Tudo bem, já que é assim, não há problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130812,
					"content": "Ufa... Estou salva... Muito obrigada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130813,
					"content": "Hiroyuki, Ookubo, esse problema está resolvido. Retornem para seus deveres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130814,
					"content": "Sim, general.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130815,
					"content": "Sim, general.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130816,
					"content": "Me desculpe, Senhorita Alrani. Nós lhe confundimos com alguém suspeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130817,
					"content": "Dito isso, nós limpamos o seu nome, mas você entrar na Ilha Watatsumi dessa forma nos criou muitos problemas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130818,
					"content": "Hã? Vocês me aplicarão uma multa? Mas eu não tenho muita Mora assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130819,
					"content": "Bem, você alegou ser uma vendedora de fertilizantes anteriormente, e também é uma pesquisadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130820,
					"content": "Bem, há algo que você pode fazer por nós. Há um homem que mora aqui chamado Iwata que está pesquisando como fazer fertilizantes. Senhorita Alrani, por favor, ajude-o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130821,
					"content": "Se você o ajudar a fazer um fertilizante que também não seja um perigo ao povo, estará livre para fazer sua pesquisa aqui, assim como o Senhor Kaushik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130822,
					"content": "Fertilizante? Não, eu sou apenas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130823,
					"content": "Ela ficará bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "Alrani, essa é uma boa oportunidade para você reunir materiais para sua pesquisa. Já que você está aqui em Inazuma, isso quer dizer que sua tese ainda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130826,
					"content": "Hã... Bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130827,
					"content": "Você sabe quais são os padrões para se graduar na Academia. Se você não puder se graduar após muitos anos consecutivos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130828,
					"content": "Eu farei! Eu farei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130829,
					"content": "Eu aprendi sobre o fertilizante junto com Vahid.... Eu farei isso de uma vez só!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130830,
					"content": "A graduação realmente lhe faz amadurecer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "Bem, acho que está tudo resolvido. Senhorita Alrani, o fertilizante está em suas mãos. Eu tenho outras questões para resolver, com sua licença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130833,
					"content": "Ah sim. Por favor, lembrem Iwata para mover, uhm... seu fertilizante para um pouco mais longe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130834,
					"content": "Está bem. Eu continuarei com minha pesquisa agora. Alrani, se você tiver qualquer pergunta, fique à vontade para me perguntar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130831,
					"content": "A graduação é a melhor motivação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "Deixarei isso com você, Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
