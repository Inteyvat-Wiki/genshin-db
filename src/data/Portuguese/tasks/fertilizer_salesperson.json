					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
					"content": "Eu farei o meu melhor. Isso é por causa de minha tese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130906,
					"content": "É uma especialista de Sumeru em fertilizantes.",
