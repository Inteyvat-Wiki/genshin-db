			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Hmm... Paimon se pergunta que tipo de tesouros encontraremos aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "#Os armários estão cheios de livros e você olha através deles. Parecem ser documentos hospitalares, como prontuários médicos ou registros contábeis. \\nVocê fechou o armário decepcionad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Hmm, Paimon pensou que havia algum tesouro especial dentro... Até os barris e caixas de madeira que costumamos ver quando estamos em nossas aventuras são melhores! Há pelo menos repolho ou carne de ave neles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Hã, o que é isso? Parece ter caído daqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Deixa Paimon ver... Pode haver pistas para o tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Uh... Essa tal de Eleazar é assustadora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "O que estava escrito no outro documento...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Hmm... Paimon não entendeu nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Também não entendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Paimon só entendeu a parte que dizia: \"A voz do deus me guia\"... mas vozes estranhas realmente falam para guiar as pessoas por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Talvez sejam só \"fontes de água subterrânea ou atividades de criaturas\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Sim! Quem sabe, podem existir algumas ruínas subterrâneas! Vamos ouvir os sons e checá-los quando pudermos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "#Sendo honest{M#o}{F#a}, acho que a ignorância é uma bênção nesse caso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Hã? Você entendeu? Paimon só entendeu a parte que dizia: \"A voz do deus me guia\"... mas vozes estranhas realmente falam para guiar as pessoas por aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
