			"dialogs": [
				{
					"id": 752250101,
					"content": "Ah, que pista de desafio adorável. Uma pena que não a gente não consiga ela fora das \"erupções\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250102
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250102,
					"content": "#Oi, {M#guerreiro forasteiro}{F#guerreira forasteira}. Você tem belos olhos. Posso ver a determinação neles! Então! Quer tentar essa pista com pedregulhos? As regras são simples! Chegue ao final da pista passando pelos pedregulhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250103
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250103,
					"content": "É bem desafiador, se me perguntar — então, o que me diz? Quer tentar?",
