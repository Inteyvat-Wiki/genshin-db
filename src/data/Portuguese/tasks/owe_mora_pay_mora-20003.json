						200030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030502,
					"content": "Mona, você tem que pagar o aluguel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030503
					]
				},
				{
					"id": 200030503,
					"content": "Eh... Parece que Mona não está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030504,
					"content": "Que estranho, ela não costuma estar em casa? Talvez saiu para fazer outras coisas hoje?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030505,
					"content": "Tal-talvez Mona tenha desmaiado de fome dentro de sua casa e não tenha forças para abrir a porta?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030506,
						200030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030506,
					"content": "Acho que não foi isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
					]
				},
				{
					"id": 200030508,
					"content": "Hmm. É sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030509,
					"content": "Mas aonde deveríamos ir para encontrar a Mona...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200030507,
					"content": "Ela disse que tinha pensado numa maneira de ganhar dinheiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030508
