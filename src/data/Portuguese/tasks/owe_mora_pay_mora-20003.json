			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "*Suspiro* Parece que vou ter de ir eu mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030102,
					"content": "Os meus pobres e velhos ossos não vão aguentar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030103,
					"content": "É uma emergência?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "Viajante? Ai... Não se pode dizer que seja uma emergência, mas realmente não sei como resolver isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030105,
					"content": "Como sabe, os Fatui tomaram conta de meu hotel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030106,
					"content": "Depois disso acontecer, como proprietário do Grand Hotel Goth, naturalmente a responsabilidade de cuidar do problema ficou para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030107,
					"content": "Tive que contatar os fornecedores de ingredientes, consertar as coisas que foram quebradas, e outras tarefas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030108,
					"content": "Recentemente, quebraram as mesas e cadeiras de vários quartos, por isso também tive de contatar um fornecedor para que enviasse madeira para o carpinteiro consertar elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030109,
					"content": "Além disso, ainda tenho o aluguel de algumas casas na cidade para cobrar, e agora não encontro meu colega Marvin em canto algum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030110,
					"content": "Infelizmente, não sei se este velho corpo aguenta muito mais. Me pergunto quando será que Marvin se tornará mais responsável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030111,
					"content": "Eu vou te ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "#V-Você está mesmo dispost{M#o}{F#a} a me ajudar? *Suspiro* Não queria dar trabalho a você... Se Marvin fosse sequer um pouco como você, eu não precisaria estar tão cansado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030114,
					"content": "Então, por favor, me ajude a conseguir madeira de abeto e vidoeiro. Tenho que entregá-las ao carpinteiro o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030112,
					"content": "Fique descansando um pouco aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
