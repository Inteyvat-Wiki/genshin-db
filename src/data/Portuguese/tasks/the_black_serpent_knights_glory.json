				"points": []
			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Aquela era a alma do Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "Vários poderes misteriosos estão reunidos por aqui. Não é nada de estranho se você vir um fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Mas, se vocês querem continuar em frente explorando, tenham cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "*Cof* *Cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "Sim, nós vamos tomar cuidado! Oh, sim! Dain, por que você não vem junto conosco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Aquele dispositivo de agora há pouco me feriu fortemente, preciso me recuperar por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Oh, certo... Bem, na verdade Paimon já sabia disso. Você deve ter suportado a dor por todo esse tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "É hora de descansar, Dain! Por que não tira férias por alguns dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "Tirar férias? Férias não é uma palavra que existe no meu dicionário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "Eu ainda tenho algo muito importante para fazer. O Plano do Tear do Destino ainda está em andamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "Eu até pensei que o dispositivo de amplificação também tinha a ver com aquele plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Eu também prestarei mais atenção.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "Obrigado pela sua compreensão, chefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "Só espero que da próxima vez que nos encontrarmos, você saiba de qual lado está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "Parece que Dain ainda guarda um pouco de rancor... Aquilo que ele falou no final...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "#Bem, uma pena que não pudemos encontrar {M#sua irmã}{F#seu irmão} de novo, mas pelo menos aprendemos algumas informações úteis, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "Desde que nós continuemos viajando, vocês se encontrarão e então tudo será como era antes, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "Oh, vocês ainda se lembram do nosso objetivo? A gente veio até aqui para investigar os rastros peculiares dos Hilichurls, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "A gente pode reportar tudo o que a gente descobriu ao minerador, só que é meio difícil de explicar. Tudo está acontecendo por aqui é definitivamente complicado para as pessoas comuns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Enfim, só não vamos nos esquecer dessa Comissão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Esperarei você se recuperar e então conversaremos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
