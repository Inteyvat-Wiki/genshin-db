			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Achei que ele teria se tornado cinzas em um instante... A alma do Halfdan é extraordinariamente resiliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Saia do meu caminho! Não nos atrapalhe mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Sacerdote do Abismo"
				},
				{
					"id": 80070103,
					"content": "Para onde você está olhando? Esta é uma oportunidade de ouro, afinal você tem chance de me eliminar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "... Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Sacerdote do Abismo"
				},
				{
					"id": 80070105,
					"content": "Elimine-o e desative o dispositivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
