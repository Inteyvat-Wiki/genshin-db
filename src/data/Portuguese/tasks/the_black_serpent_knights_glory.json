					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "O que faremos agora? O Sacerdote do Abismo se foi, mas o dispositivo não para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "E o Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Deixe-me ficar em seu lugar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "#Não! Desde que o dispositivo ainda esteja habilitado, nós, que estamos sob o efeito da maldição, não temos nenhum poder! Você é {M#o único}{F#a única} que é capaz de enfrentar o Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Se você valoriza seu sacrifício, então não perca mais tempo aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Você vê aqueles raios e o portal? Eles com certeza colocaram o dispositivo de energia em outros lugares. Vamos dar uma conferida, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "A gente tem que atravessar o portal do Abismo? Ei!! Espere por Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "#Eu não serei afetad{M#o}{F#a} pelo efeito da purificação da maldição.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
