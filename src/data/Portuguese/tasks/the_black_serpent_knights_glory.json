			"dialogs": [
				{
					"id": 80070901,
					"content": "Agora o dispositivo pode ser considerado desativado por completo, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070902,
					"content": "A sensação de ardor desapareceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070903,
					"content": "A gente parou com sucesso o plano do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070904,
					"content": "Mas... Halfdan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070907,
					"content": "Deixe-me confirmar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070908,
					"content": "O Dain, na verdade, talvez esteja muito triste, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070909,
					"content": "De todas as formas para finalmente se reencontrar com seus antigos companheiros depois de tanto tempo... isso é difícil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070911,
					"content": "...Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070905,
					"content": "Parece que ele não está com nenhum sinal de vida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				}
			]
		},
		{
