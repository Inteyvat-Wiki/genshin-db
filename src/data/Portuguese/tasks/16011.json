			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "Isso é... o coração do lobo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "...! Roland!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "...Farei como desejar, Cavaleiro de Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Hah, você não é bem como eu imaginei. Você não parece nem metade do que os relatos contidos no Espírito do Lobo dizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Em nenhum momento me desviei do caminho justo. Mas, quando olho para você... não vejo um herói capaz de abater dragões. Só uma alma perdida, que vagou longe demais. Uma sombra do cavaleiro que você já foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Acho que temos isso em comum. Nenhum de nós está no auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "As forças do Vingador da Lua foram derrotadas, e o Roland que você vê é apenas uma imagem imperfeita projetada pelo Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Eu empunho o poder que Roland tinha no auge, mas meu coração e minha mente continuam congelados naquele momento ensanguentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Portanto, eu, na minha forma atual, sou falho... Um cavaleiro não pode suportar a própria estagnação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Depois de redimir você da injustiça e conduzir sua rendição ao Abismo, vou me corrigir e continuar a trilhar o caminho da cavalaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Hah! O mundo lá fora não aguenta mais o seu tormento. Sua obsessão, ao que parece, continua exatamente como eu imaginava. Imagino que não haja chance de fazer você enxergar a luz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Nenhuma palavra pode fazer um cavaleiro duvidar das próprias convicções, por mais nobres que possam soar. Nenhum de nós vai convencer o outro... mas você já conhece essa verdade há muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Caso contrário, por que depositaria todas as suas esperanças no único pensamento de Boreas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Mas agora a lâmina que um dia abrigou o Espírito do Lobo foi estilhaçada, e tudo o que você tem é um fantasma que carrega sua forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Você não tem mais como mudar a situação, e ninguém virá ao seu resgate... Este lugar será o seu cemitério, guerreiro solitário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "É, talvez você esteja parcialmente certo... Mas acho que eu ainda posso ter uma chance de resgatar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "...O que você quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Só há uma pessoa cuja mente eu preciso mudar, e não é a sua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Esqueceu onde estamos? Este é o coração de Andrius, o Arconte do Vento do Norte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "Andrius! Você consegue me ouvir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Acorde! Você é o grande Arconte do Vento do Norte! Por quanto tempo você vai permitir que o Abismo continue dominando seu sofrimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "...Se esta é a sua jogada final, estou profundamente decepcionado, Cavaleiro de Boreas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "Grandes demonstrações de desejos sinceros não podem invocar milagres. Este mundo não demonstra tal misericórdia para com seus habitantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "...Volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "...Volte para... as Linhas Ley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "...Esta é a minha escolha... a minha memória...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "...Esta é a resposta que encontrei... ao fim da minha jornada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "\"An{RUBY#[S]Boreas}drius\"... Sua carta, eu a entreguei direitinho de volta ao \"seu\" coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Heh... Um Cavaleiro de Boreas? Observe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "...Isto é tudo o que um lo{RUBY#[S]Eu}bo pode esperar fazer pela human{RUBY#[S]Você}idade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "...Em nome de toda a humanidade, agradeço, Senhor dos Lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas... está retornando às Linhas Ley? Mas por quê? Sua espada está quebrada, você não tem mais como abrigar a alma dele... A menos que... Não pode ser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Implorar por milagres é uma tentativa inútil. Eu sei melhor do que isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "...Mas uma espada é só um tipo de recipiente. Há outras formas de armazenar uma alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "O Dominador dos Lobos já concedeu o poder de sua alma à sua alcateia, fortalecendo seus corações e afiando suas garras e presas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "...Mesmo que não seja minha intenção, a alma de Lupus Boreas inevitavelmente devastará, devorará e assimilará um coração mortal... Como se humano e lobo fossem forçados a se fundir em um só ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "...Se um coração mortal deve abrigar a alma de um Arconte... este é um caminho sem volta. Ainda assim, não vou dissuadir um cavaleiro de embarcar na missão que ele mesmo escolheu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "\"Capitano\""
				},
				{
					"id": 160110939,
					"content": "Seu coração, sua alma... estão desmoronando? ...Ah, agora entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "Você estava se perguntando como um cordeiro poderia domar o coração de um lobo... não estava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Aqui está minha resposta: faça o lobo engolir o coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "O Espírito do Lobo dentro da espada era apenas uma isca... os verdadeiros pensamentos e memórias estavam em seu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Para evitar despertar minha suspeita, você deliberadamente deixou a alma de Lupus Boreas assimilar a sua, para então ser devorada por mim... Mas... como você teve força para lutar carregando um fardo tão grande...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "Comparado à decisão de Lupus Boreas... meu sacrifício não é nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Você tem uma determinação teimosa e empregou uma estratégia excepcional... mas este não é o jeito que um verdadeiro cavaleiro luta. A escolha que você fez é falha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Sua alma agora está fundida à de Andrius. Quando ele se unir por completo às Linhas Ley, você também cairá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "#Nem Barbatos nem {M#o}{F#a} Viajante serão capazes de ancorar sua alma de dentro das Linhas Ley, muito menos de resgatá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Você perdeu, e eu também. Infelizmente, não posso mais lhe oferecer salvação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "...Que sua alma descanse em paz com Boreas, guerreiro solitário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "...Haha, solitário...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Desculpe desapontar você, mas... Por mais que parecesse o desfecho perfeito, de nós dois voltarmos juntos às linhas ley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "O fato é que, diferente do verdadeiro Roland do passado, eu ainda tenho um bom vinho e bons amigos esperando por mim. Eles estão ansiosos pelo meu retorno triunfal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Então, eu ainda não estou pronto para aceitar meu destino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Ding-dong! Você tem uma mensagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1601111,
