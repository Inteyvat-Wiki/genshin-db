						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "...Caminhe em frente e não olhe para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "\"Varka... Agora eu entendo o significado do meu nome.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "\"...Depois de fazer todo mundo passar por tudo isso por sua causa, é bom você garantir que vai agradecer a todos direito quando voltar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "\"Você sabe, eu tenho um monte de coisas para te atualizar... mas pode esperar até você voltar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "\"Eu não tenho intenção de voltar para os Cavaleiros de Favonius... Mas confio que você vai encontrar um jeito de se virar sozinho.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "\"...Grande Mestre, estamos todos esperando por você.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "Hmm? ...Oh. Heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "Eu... não estou fazendo um trabalho tão ruim como Grande Mestre, estou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "...Vou considerar esse silêncio como sua aprovação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Tudo o que vocês juraram proteger com suas vidas... Ainda está tudo aqui, seguro e intacto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "Os Cavaleiros de Favonius, Mondstadt... e o juramento feito por cada cavaleiro. Vou proteger tudo com a minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "E então... entregarei aquela carta em seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "...Eu sei que é só uma sombra do verdadeiro Roland, mas... se você tiver tempo, poderia ler para ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam e Arundolyn... eles nunca se esqueceram de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "Ufa... essa expedição foi longa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "De agora em diante, acho que vou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "...Deixar o vento me guiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "...Ei, pessoal. Faz tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Eu... estou muito feliz em ver vocês de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Bem-vindo de volta, Grande Mestre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "É, eu estou em casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
