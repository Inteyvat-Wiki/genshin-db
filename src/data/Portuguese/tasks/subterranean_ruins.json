			"dialogs": [
				{
					"id": 50220701,
					"content": "(No momento em que atravessei a parede de luz, meu corpo pareceu congelar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Acho que a proteção da Dama da Noite não alcança este lugar. O frio e a escuridão são sufocantes, e tudo o que ouço são gritos de exaustão e dor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Quanto tempo essas almas têm existido em tormento? Quanto mais tempo isso vai durar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Hã? Tem alguém aqui...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Embora nossa terra natal tenha se tornado uma lembrança distante, as chamas da guerra continuam a arder. Há muito derramamos a última gota de nosso sangue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "\"Capitano\""
				},
				{
					"id": 50220706,
					"content": "Mantenham-se firmes, meus soldados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "\"Capitano\""
				},
				{
					"id": 50220707,
					"content": "(O que o Capitão está fazendo aqui? E o que ele está dizendo...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "Um dia, eu os levarei ao lugar prometido.",
					"roleType": "TALK_ROLE_NPC",
