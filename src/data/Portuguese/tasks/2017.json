				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, o que você está fazendo aqui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "Vocês se encontraram com a resistência? Como está indo a batalha? Já é seguro para eu sair?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Ainda não... vimos pessoas patrulhando em nosso caminho para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "Então ainda não acabou... Acho que você veio aqui porque tem algo a discutir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Vou pedir a alguém para chamar a Srta. Kamisato, espere um momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Você conta à Ayaka e Thoma o que aconteceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Entendi, então vocês já passaram por muita coisa desde nosso último encontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Eu entendo, você precisa de provas de traição da Comissão Tenryou. Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Agora que você mencionou, há uma coisa que sempre me preocupou. O Exército do Shogunato está em guerra com a força da resistência há muito tempo, mas a Shogun nunca perguntou sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Eu costumava pensar que ela simplesmente não se importava, mas olhando agora, talvez o problema tenha sido sempre com o <color=#00E1FFFF>Relatório da Comissão Tenryou</color> para a Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "O que você quer dizer com isso, Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "A Comissão Tenryou é responsável pelos assuntos militares domésticos. Se eles tivessem alguma vez a intenção de ocultar informações em seus relatórios, não teríamos como saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Enquanto isso, a Shogun concluiria incorretamente que o Decreto de Caça à Visão não representa nenhuma ameaça, e se manteria fiel a sua decisão. Se tivéssemos acesso aos relatórios deles, tudo seria confirmado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Mas, pelo que me lembro, a única pessoa autorizada a acessar esse tipo de documentação oficial é Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "Mas o local é fortemente vigiado. Mesmo com a ajuda de Sayu, roubar um documento debaixo dos seus narizes não é algo fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
					"content": "Se ao menos houvesse uma maneira de distrair os guardas apenas por tempo suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Sim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "A maneira de distrair os guardas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "O fogo de artifício de Yoimiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170423,
					"content": "Essa é uma sugestão bem ao seu estilo, Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Faz sentido. A Estátua da Deusa Onipresente fica ao lado da Comissão Tenryou. Se alguém soltasse fogos de artifício perto da estátua, certamente não ignorariam isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Enquanto eles estiverem preocupados com isso, Sayu poderia infiltrar-se na Comissão Tenryou e pegar o relatório, bem como qualquer outra prova que ela pudesse encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "Ótimo! Parece que estou cada vez mais perto de ser um homem livre novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170427,
					"content": "Ah... Parece que já passou uma eternidade desde a última vez que nos sentamos e conversamos assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170428,
					"content": "Na verdade, não passou tanto tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "#Certamente me pareceu que sim... Desde que cheguei aqui, tenho esperado ansiosamente para vê-l{M#o}{F#a} novamente todos os dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170430,
					"content": "Esta Casa de Chá costumava ser meu esconderijo favorito, mas agora... Sinceramente, perdi a noção de quanto tempo passou desde a última vez que pus os pés fora daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170431,
					"content": "Droga! Eu quero tanto ir para as fontes termais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170432,
					"content": "Pobre Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Vamos nos concentrar no assunto em questão. Quanto mais cedo o Decreto de Caça à Visão for abolido, mais cedo Thoma estará livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Esta foi uma reunião boa, mas não há tempo para conversa fiada. Celebraremos apropriadamente quando tudo tiver terminado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "Vamos jogar shabu shabu de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170436,
					"content": "Você ainda está pensando nesse jogo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "A Comissão Tenryou é fortemente protegida. Tenha cuidado ao chegar perto. Vamos nos encontrar aqui depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Bem, {NICKNAME}, vamos primeiro procurar por <color=#00E1FFFF>Yoimiya</color> em<color=#00E1FFFF> Hanamizaka</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Já fizemos isso antes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
		{
			"id": 201707,
