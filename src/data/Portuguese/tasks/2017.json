					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170701,
					"content": "É exatamente o que eu pensava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170702,
					"content": "Há muitas, muitas pessoas... Se alguém me ver, serei pega...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "Precisamos nos livrar deles, ou não vou conseguir entrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "Teremos apenas que confiar em Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Depois que pegar o documento, vamos nos encontrar na <color=#00E1FFFF>Casa de Chá Komore</color>, está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Além disso, se eu for pega... Por favor, venha me resgatar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "Será que isso é realmente uma boa ideia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "#Bom... De qualquer maneira, vamos até à <color=#00E1FFFF>Estátua da Deusa Onipresente</color>. Tome cuidado, preste atenção aos guardas e não seja peg{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201709,
			"completionStepIds": [
				201709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
