			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon. Vocês estão aqui também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "Também viemos encontrar ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Se ele soubesse que vocês vinham, ele ficaria calado, mas isso ia deixar ele feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Vocês ficam ao lado de Illuga na frente do túmulo por um tempo...\\nIlluga falou do companheiro falecido, recontando eventos grandes e pequenos que aconteceram em Piramida recentemente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Sabendo que todos em Piramida estão bem, ele pode descansar finalmente, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "Sim. Ele concluiu a missão dele. Nós continuaremos com a nossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "E após nós, haverá outros que continuarão cuidando dessa terra. Como o Capim de Gelo Invernal, eles resistirão a tempestades e ao frio, ficando cada vez mais fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
