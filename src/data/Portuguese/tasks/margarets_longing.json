			"dialogs": [
				{
					"id": 4870101,
					"content": "... Então aquele gato que tinha desaparecido era seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti! Você veio ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Eu? Te ajudo? Pelo contrário, sou eu que preciso de ajuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Mas acabei de ver você conversando com a Margaret sobre o Príncipe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Aha! Então, o nome do gato que roubou as minhas <color=#00E1FFFF>cordas de ferro astrais</color> sobressalentes é Príncipe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Embora alegre meu coração ver que o espírito livre de Mondstadt está vivo e bem em criaturas grandes e pequenas... Ainda assim, é um pouco audacioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870108,
					"content": "Falou como um parente que escolhe mimar seu filho malcriado!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870107,
					"content": "Haha, Príncipe é um pequeno patife impertinente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870109,
					"content": "Muito parecido com o Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Hahaha, pois é! Vamos primeiro procurar o Príncipe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Eu tenho uma apresentação hoje à noite, e sem minhas cordas sobressalentes, terei que decepcionar minha audiência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "O que um gatinho quer com cordas de lira, afinal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Todos sabem que os gatos adoram um rolo de lã!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Quê?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Essas cordas de lira são feitas de ferro astral, que contém energia Anemo. Isso os torna extremamente duráveis, então eu normalmente os enrolo para facilitar o transporte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "Isso é um pequeno truque de um bardo viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "As cordas possuem a energia Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Isso vai nos ajudar! {NICKNAME} é hora de usar a sua <color=#00E1FFFF>Visão Elemental</color> de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Tenho certeza de que há pegadas elementais ou algo do tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870120,
					"content": "Eu vou deixar o trabalho para vocês. O Príncipe deve estar em algum lugar na zona comercial e residencial. É um gato preto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Ah. Levem isto, este <color=#00E1FFFF>Peixe</color> é o favorito do Príncipe, e talvez isso ajude um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		},
