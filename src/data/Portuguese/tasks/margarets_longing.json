				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "Príncipe! Onde você foi! Graças a Deus, você está vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870302,
					"content": "Ele fez com que eu procurasse por todos os lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870303,
					"content": "Ei, Príncipe, como você pode me abandonar dessa maneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870304,
					"content": "Parece que esses dois precisam de algum tempo sozinhos mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870305,
					"content": "Aqui estão as suas cordas de ferro astral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870306,
					"content": "Você encontrou! Incrível! Eu não tinha tantas esperanças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870307,
					"content": "Me atrevo a dizer que uma apresentação privada, tocada usando os mesmos acordes, não é o suficiente para demonstrar minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870308,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870309,
					"content": "Atchim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870310,
					"content": "*Cof cof* Haha, desculpa. Nessa distância, minha alergia contra gatos está piorando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870311,
					"content": "Oh, agora entendo por que você não foi buscar sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870312,
					"content": "Hehe, de qualquer forma, obrigado pela ajuda. Irei agor-a-atchimmm!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
