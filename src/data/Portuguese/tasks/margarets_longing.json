			"dialogs": [
				{
					"id": 4871001,
					"content": "Príncipe! Bom garoto! Sabia que você voltaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871002,
					"content": "Ah! Depois de tanta procura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871003,
					"content": "Ei, Príncipe, como você pode me abandonar dessa maneira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871004,
					"content": "Parece que esses dois precisam de algum tempo sozinhos mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871005,
					"content": "Parece que você o perseguiu aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871006,
					"content": "Hehe... Anime-se, mesmo se você não tenha o pego, ele voltou aqui graças a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871007,
					"content": "E ele ainda tem as cordas de ferro astral com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871008,
					"content": "Me atrevo a dizer que uma apresentação privada, tocada usando os mesmos acordes, não é o suficiente para demonstrar minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871009,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871010,
					"content": "Atchim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871011,
					"content": "*Cof cof* Haha, desculpa. Nessa distância, minha alergia contra gatos está piorando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871012,
					"content": "Oh, agora entendo por que você não foi buscar sozinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871013,
					"content": "Hehe, de qualquer forma, obrigado pela ajuda. Irei agor-a-atchimmm!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
