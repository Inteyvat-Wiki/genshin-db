			},
			"dialogs": [
				{
					"id": 4870501,
					"content": "Uau! O Príncipe está alerta, e fugiu com facilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "Vamos arranjar uma maneira de <color=#00E1FFFF>aproximá-lo por trás</color> e com passos bem suaves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "É um grande problema que não sabe voar. Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Se não der, convém usar <color=#00E1FFFF>Peixes</color> para atrair o príncipe. Todos os gatos gostam do peixe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "Se acabar os <color=#00E1FFFF>peixe</color>, podem pegar mais no lago ao lado. Vamos lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
