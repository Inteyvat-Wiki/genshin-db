			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Hã? Que luz era aquela saindo da Estátua dos Sete agora mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Que esquisito! Alguma coisa assim já aconteceu antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "As Estátuas dos Sete brilham normalmente, não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}, você não se sentiu nem um pouco desconfortável?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Hã? Eu acho... que a água está falando comigo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Aham, seria incrível se falasse! ...Se você consegue fazer piadas assim, deve estar bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Mas, depois de brilhar daquele jeito, o ar parece mesmo mais úmido. Talvez seja por que toda aquela energia Hydro foi liberada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Hehe, Paimon ouviu dizer que em Fontaine, se você souber usar energia elemental direito, dá até para nadar debaixo d'água! Quem sabe você possa achar tesouros afundados, que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "A parte de mergulhar fica com você, e Paimon... Paimon fica na costa te esperando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "#Vai ser solitário ir para a água sozinh{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Ah! Mas... mas... ficar na água dá medo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "E se Paimon for levada acidentalmente na corrente e ficar tonta de tanto balançar, até não conseguir voar para escapar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Igual quando Paimon te conheceu, lá em Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "Então eu te pesco de novo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "...Sério? E-Então talvez Paimon pode tentar ir para debaixo d'água com você. Hunf! É melhor cumprir a sua palavra, viu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Você podia fazer alguma coisa para variar, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Uau, sinto como se tivesse usando guelras para respirar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "#Bom pra você!! Mas primeiro cresça essas guelras pra mostrar a Paimon! Hunf! Você está tranquilinh{M#o}{F#a}, né? E Paimon aqui morrendo de preocupação por você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Apareceu água?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Bom, aqui é a nação da Arconte Hydro, não é? Até as Estátuas dos Sete são fontes de água... É VERDADE! Aquela luz não era nada normal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}