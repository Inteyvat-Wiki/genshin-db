			"dialogs": [
				{
					"id": 200140201,
					"content": "Você derrotou todos os monstros, incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Parece que o manual de aventura está mesmo certo, você usou vários métodos dele para derrotar os monstros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Mas... para ser sincera, ainda fico assustada quando chego perto desses monstros... Felizmente, você estava comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Você ainda tem que treinar muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Sim, eu sei. Se tornar uma aventureira não é fácil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "Obrigada, Viajante, agora vou para casa. Já estou aqui na natureza há tanto tempo, meu irmão já deve estar preocupado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Depois do treinamento de hoje, entendi que ainda tenho que trabalhar mais duro para ser uma boa aventureira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
