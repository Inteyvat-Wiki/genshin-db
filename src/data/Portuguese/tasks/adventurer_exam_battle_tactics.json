			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, é melhor pensar neste assunto a longo prazo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Ai! Não se preocupe, não vai haver problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Anna, você está se sentindo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "Viajante! Você chegou na hora certa! Pode me ajudar a convencer a Anna? Ela quer ser uma Aventureira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "Por que eu não posso ser uma Aventureira? Agora estou saudável, e o Cyrus também disse que sou muito esperta, e que tenho talento para ser uma Aventureira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Faz quanto tempo que você se recuperou da doença? Se você se tornar uma Aventureira agora e voltar a ficar doente, o que vai acontecer? Além disso, nossos pais também não vão concordar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Eu já disse para eles que quero ser uma Aventureira. E eles me disseram que basta eu passar no teste da Guilda de Aventureiros, que eles concordarão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "Ah... AHHH?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Calma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "O Cyrus me ajudou a bolar plano de treinamento há uns dias. Estou treinando já tem tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "No entanto, os treinamentos são todos sobre reconhecimento, procura de alimentos de emergência, sobrevivência na natureza, etc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Mas eu ouvi que os aventureiros costumam lutar com monstros na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Gostaria de aprender a lutar contra eles, mas não conheço ninguém que possa me ajudar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Além disso, meu irmão também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "Nem pensar! Aqueles monstros são muito perigosos, mesmo que você queira ir, tem de encontrar um aventureiro experiente que acompanhe você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Eu já tinha falado com o Jack, ele aceitou me ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Eu conheço o Jack muito bem... Aquele cara nem de si sabe tomar conta quando sai por aí, quanto mais de você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Não consigo encontrar nenhum aventureiro experiente na associação que queira me acompanhar, e também não tenho dinheiro para publicar uma missão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "Eu acompanho você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Hã? Você quer me ajudar? Ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Irmão! Parece que você pode finalmente ficar descansado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "E-eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "#Bom... Eu sei que {M#o}{F#a} Viajante é experiente, se {M#ele}{F#ela} acompanhar mesmo você, eu fico um pouco mais descansado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "No entanto! Você tem de prestar atenção quando sair à natureza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "...É para lembrar de tudo o que eu lhe disse certinho, ouviu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Sim, sim... Irmão, você fala tanto que já estou ficando tonta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "Viajante, não há tempo a perder, vamos partir em nossa aventura. Já perguntei a Jack sobre a localização do acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Também tenho alguma experiência em luta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "Então, e como está indo seu treinamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Anthony, o que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
