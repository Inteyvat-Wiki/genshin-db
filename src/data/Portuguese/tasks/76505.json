			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}? Paimon? Que coincidência! Ouvi dizer que vocês tinham ido para Nod-Krai, mas eu não esperava que nos encontraríamos novamente tão cedo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Sim! Paimon também achou que estava vendo coisas! A propósito, por que você está tão longe de casa? Você também está viajando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Hehe, pode-se dizer isso! Estou aqui para comprar um lote de máquinas agrícolas para o nosso pomar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Meu pai disse que Nod-Krai tem um produto muito bom que pode fazer nossas frutas crescerem melhor e me poupar algum esforço. Assim terei mais tempo para dormir... e para fazer exercícios, claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "E quando cheguei aqui, encontrei tantas coisas deliciosas que não encontram em Natlan! Então, além dos assuntos oficiais, tenho passado a maior parte do tempo comendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "...Honestamente, agora que está quase na hora de partir, eu não quero muito ir embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Então, vou passear enquanto ainda posso - vou experimentar tudo o que ainda não experimente, e ver tudo que ainda não vi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#Deixe-me adivinhar... {M#Nosso herói}{F#Nossa heroína} {NICKNAME}, está defendendo a justiça em uma nova terra. Estou certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Nós só estamos dando uma olhada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Ooh, eu sei bem como é! Chegar a um lugar novo significa ter um monte de coisas novas para ver — dá vontade de registrar tudo com o Aparelho Fotográfico, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Por falar nisso... Ah! Eu também deveria tirar mais fotos das comidas incríveis que tenho comido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Dessa maneira, talvez eu consiga que o tio Atolli recrie esses pratos a partir das fotos quando eu voltar para casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "E quem sabe, uma carreira na fotografia de alimentos pode estar esperando por você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Ehe, você acha mesmo? Eu, uma fotógrafa de comida... Para ser sincera, isso parece incrível! Entrar em contato com comidas deliciosas todos os dias e depois tirar fotos delas no seu momento que dá mais água na boca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Mas antes que você saia para tirar fotos de comidas deliciosas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Eh? Você quer tirar uma foto minha? Você realmente quer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "E—Espere. Meu cabelo não está todo bagunçado, está? Eu ainda tenho molho na minha boca? Ohh, se eu soubesse que eu te encontraria aqui, eu teria colocado algumas das coisinhas que comprei no mercado ontem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Você está ótima do jeito que é!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "Certo! V—Vou deixar isso com vocês, então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Seu rosto feliz é mais do que o suficiente para uma foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Podemos tirar uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "E procurando algum material para fotos enquanto estamos nisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
