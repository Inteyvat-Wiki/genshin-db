			"dialogs": [
				{
					"id": 705450101,
					"content": "Miau, miau miau-miaaauuuu~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Miau! Miau miau miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Coelhinho"
				},
				{
					"id": 705450103,
					"content": "Hmm... Tanto Coelhinho e Amber tem um bom ponto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Oh, então é isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Uma observação astuta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Na verdade, Paimon também não entende, mas ela consegue perceber que Amber e Coelhinho chegaram a um acordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, Paimon! Vocês estão aqui! Eu estava pensando em voltar para procurar vocês!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Eu já ouvi tudo sobre como você está ajudando Valerina com a Fortaleza Felina Fofinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#Ess{M#e}{F#a} é {M#o}{F#a} Viajante e a Paimon! No segundo que voltaram a Mondstadt, já começaram a ser uma grande ajuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "#Eu, {M#o}{F#a} Cavaleir{F#a}{M#o} Honorável, irei honrar minha missão, não importa como.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Falando nisso, o que você e Coelhinho estavam discutindo agora há pouco? Vocês pareciam estar tendo uma conversa bem divertida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Miau, miau miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Coelhinho"
				},
				{
					"id": 705450115,
					"content": "Oh! Eu só estava perguntando ao Coelhinho sobre o tempo, e se ia ou não chover.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Hã? Gatos sabem desse tipo de coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Hehe, Lisa disse algo sobre isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Segundo o livro que ela leu, gatos são muito sensíveis à umidade e não gostam da sensação de estar molhados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Então, se eles perceberem um aumento na umidade, vão começar a esfregar o rosto e se lamber repetidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Quando um gato faz algo assim, é um sinal que uma chuva forte está provavelmente a caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Eita, Paimon não fazia ideia, isso é tão legal! Paimon acha que acabamos de aprender uma coisa maneira por acaso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#Nesse caso, {NICKNAME}, vamos prestar mais atenção durante nossas viagens! Assim, a gente não... vai ficar encharcad{M#o}{F#a} com as grandes chuvas daquelas nuvens pretas gigantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Acho que teremos que prestar mais atenção no futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Vim aqui originalmente perguntar uma coisa a Valerina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Mas enquanto estava falando com ela, esse gatinho se deitou pertinho de mim e bocejou tão alto! Foi fofo demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Já que ela foi tão carinhosa comigo, então... Bem, então preciso mostrar como sou amigável também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "Foi aí que lembrei do que Lisa me disse, então perguntei a Coelhinho sobre o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Mas ela respondeu esfregando a cara, balançando o rabo, então se deitou no chão se esfregando na minha mão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*Suspiro* Então vai chover ou não nos próximos dias...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Desde quando eu não presto atenção em gatinhos fofinhos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "A defesa dos gatos de Mondstadt é uma de minhas muitas responsabilidades.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "#Espera aí, estou um pouco perdid{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}