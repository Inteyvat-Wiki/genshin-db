			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya",
					"Rosaria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040101,
					"content": "Bem, bem, que surpresa. Não esperava ver vocês atrás do balcão hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040102,
					"content": "Nesse caso gostaria pedir uma Morte Após o Meio-...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040103,
					"content": "Só podia ser o Kaeya para fazer as coisas difíceis para nós desde o momento que abre a boca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040104,
					"content": "Ai, eu só queria ver a reação de vocês. Admito que não esperava vê-la aqui hoje, Irmã Rosaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040105,
					"content": "#A taverna é frequentada por clientes muito exigentes. Simplesmente quis ajudar {M#o}{F#a} Viajante a ganhar alguma experiência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040106,
					"content": "Lá vem o Kaeya com sua eloquência novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040107,
					"content": "Não me interpretem mal, apenas estava tentando ser útil! Você deveria me agradecer! Que tal começarmos com um Beco Iluminado Pelo Luar, que é bem simples?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040108
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040108,
					"content": "Oh, em um copo grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040109
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040109,
					"content": "Deixarei minha bebida contigo. Apenas faça algum tipo de chá, e não muito grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040110,
					"content": "Entendido. Já está indo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040111
					]
				},
				{
					"id": 705040111,
					"content": "Tome seu tempo. Esperar ansiosamente é parte da diversão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 7050402,
			"completionStepIds": [
				7050404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050404",
							"2"
						],
						"stepId": 7050404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosaria",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705040201,
					"content": "Hmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040202
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040202,
					"content": "O que foi, Rosaria? Você não gostou da bebida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040203,
					"content": "Posso te fazer outra se quiser...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040204
					]
				},
				{
					"id": 705040204,
					"content": "Não, a bebida que você fez está boa. É só que eu raramente bebo chá. O gosto sempre me lembra de certas... coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040205
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040205,
					"content": "Ah, imagino que você esteja se referindo à igreja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040206,
					"content": "Sim. Uma vez a igreja fez um evento que não pude participar, mas a Irmã Bárbara ainda assim guardou um pouco de chá e sobremesas para mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040207
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040207,
					"content": "As sobremesas já tinham estragado, então ela só jogou fora enquanto eu não estava olhando, mas o chá tinha o mesmo gosto desta bebida que você preparou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040208
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040208,
					"content": "Hã, é raro te ver agindo desta forma, Rosaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040209,
					"content": "Me parece que Mondstadt ganhou mais uma amante de chá preto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040210
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040210,
					"content": "Heh, eu ainda prefiro algo mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040211
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040211,
					"content": "E quanto a você, Kaeya? Como está sua bebida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040212
					]
				},
				{
					"id": 705040212,
					"content": "Isso depende. Se eu apontar alguns defeitos, você vai me fazer outra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040213,
					"content": "Hahahahaha, estou brincando. Jamais te faria passar por algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040214,
					"content": "Minha nossa, o Kaeya é realmente muito chato, você não sabe o que ele vai dizer em seguida. Como você aguenta beber com esse sujeito, Rosaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040215,
					"content": "Hmm? Eu não ligo para o que quer que seja que está se passando na cabeça dele, desde que estejamos apenas falando sobre bebida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040216
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040216,
					"content": "Além disso, o Kaeya só está interessado em pessoas ou coisas que o intrigam, seja você, o estalajadeiro, ou qualquer um aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040217
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040217,
					"content": "Ei! Como você pode revelar tanta informação sobre seu querido companheiro de bebida, hmmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040218,
					"content": "Você acha que estou falando muito? Heh, supere, não é nada demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040219
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040219,
					"content": "Urg, estou constantemente rodeada de puritanos todo santo dia. Prefiro o ambiente relaxado da taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040220
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040220,
					"content": "Ooh, estamos fofocando sobre as pessoas que são sérias demais, agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040221,
					"content": "Falando nisso, conheço alguém que poderia muito bem ficar na lista de \"Três Pessoas Mais Sérias de Mondstadt\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040222,
					"content": "Quanto ao seu nível de seriedade... Bem, digamos que, eles provavelmente nem se importariam se eu falasse isso na cara deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040223,
					"content": "Realmente existe uma classificação para pessoas assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040224,
					"content": "Mas é claro. Logo assim de cabeça, tem uma lista de bebedores mais consistentes, trabalhadores mais dedicados, piores cozinheiros, ou até mesmo... os maiores acumuladores de segredos obscuros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040225,
					"content": "Para Paimon parece que o povo de Mondstadt tem muito tempo livre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040226,
					"content": "Realmente existe tanta gente assim que não precisa trabalhar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040227,
						705040228
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040227,
					"content": "Não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				},
				{
					"id": 705040229,
					"content": "#Aww, mas e quanto a Paimon? Tem alguma categoria que a Paimon está tão no topo quanto {M#o}{F#a} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040230,
					"content": "Ora, mas é claro. Que tal, \"Melhores Bartenders\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040231
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040231,
					"content": "S-Sério!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040232,
					"content": "#Isso é ótimo, {NICKNAME}! Nossos nomes vão ser lembrados juntos aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040233,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040234
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040234,
					"content": "Bem, devo admitir, a atmosfera que você emana não é nada ruim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040235
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040235,
					"content": "#Nem me fale. Só de olhar para {M#esses dois}{F#essas duas} coloca um sorriso em meu rosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040236,
					"content": "#Uma atmosfera tão aconchegante e convidativa é algo importante para qualquer boa taverna. Parece que vocês {M#dois}{F#duas} merecem o título de \"Melhores Bartenders\" afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040237,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705040238,
					"content": "Heh, que nada. Obrigado pela hospitalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040239
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040239,
					"content": "É, preciso ir andando também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040240
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040240,
					"content": "A propósito, esse chá preto estava muito bom. Tentarei fazer algum para mim no futuro... se eu conseguir acordar cedo pela manhã, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040241
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705040241,
					"content": "Até a próxima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705040242
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 705040242,
					"content": "Volte sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705040228,
					"content": "Acho que sei de quem ele está falando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705040229
					]
				}
			]
		}
	]
}