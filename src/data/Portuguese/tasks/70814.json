			"dialogs": [
				{
					"id": 708140201,
					"content": "E mais alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140202,
					"content": "Você já encontrou aquela espada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "Graças a Deus, você ainda se lembra. Mas infelizmente, ainda não encontrei novas pistas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140204,
					"content": "Parece que ainda estou na estaca zero, esperando que as coisas aconteçam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 708140205,
					"content": "Se eu tiver algo novo, posso chamar os seus serviços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
