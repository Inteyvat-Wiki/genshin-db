			"dialogs": [
				{
					"id": 708140401,
					"content": "Todos os aventureiros fazem essas coisas perigosas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
