			"dialogs": [
				{
					"id": 700650101,
					"content": "Algumas pessoas simplesmente não sabem escutar. Eu já disse, agora não é hora de subir a montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Calma lá, Velho Mann. Vamos nos acalmar e conversar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "A gente estava se dando muito bem mais cedo na Infusão Noturna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Liebhart"
				},
				{
					"id": 700650104,
					"content": "No momento em que eu mencionei que estava indo para o Pico do Repouso do Vento, ele me agarrou e começou a me arrastar. Acabamos vindo parar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Liebhart"
				},
				{
					"id": 700650105,
					"content": "Ah, é o Huffman. O que está acontecendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Como pode ver, o Velho Mann está fazendo de tudo para manter as pessoas longe do Pico do Repouso do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Deixe-me apresentar. Esta é Liebhart, uma aventureira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "O que eu vivi foi aterrorizante. Tem certeza de que quer ouvir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Bom, parece que não vou chegar a lugar nenhum hoje. Certo, vamos ouvir. Considere isso como uma extensão da nossa bebedeira e das fanfarronices de mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Liebhart"
				},
				{
					"id": 700650110,
					"content": "Vamos ver o quão perigoso isso é.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Liebhart"
				},
				{
					"id": 700650111,
					"content": "Tem mesmo fantasmas no sanatório! Eu vi com meus próprios olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "Uau, fantasma?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "Então, foi isso que aconteceu ontem à noite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
	]
