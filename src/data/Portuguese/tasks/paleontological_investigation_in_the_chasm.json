			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Sobre a pedra estranha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Então, você tirou foto de uma pedra estranha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "Mostre-me, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "Aqui está...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Ah! Olhe só para esta foto! Esta tudo tão claro — parece que os modelos novos do Aparelho Fotográfico feitos em Fontaine realmente são tão bons quanto dizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "Uma vez comprei alguns protótipos, mas as imagens que ele tirava não eram tão claras. Além disso, era muito difícil de uma só pessoa lidar com ele. Então acabaram por ficar mofando em algum canto da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Acumulando poeira..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Sim, me custou um jantar inteiro em Mora. Hm... Parece que está na hora de eu comprar alguns Aparelhos Fotográficos novos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Desculpe, acabei divagando. Deixe-me ver. Esta pedra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Sim, é um fóssil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "Fóssil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Sim, e você consegue ver várias criaturas marinhas fossilizadas nele... que interessante! Em Liyue tem um ditado para algo assim — não sei exatamente como se diz, mas é algo tipo \"florestas e campos, eventualmente serão engolidos pelo vasto oceano\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "O fato de que estes fósseis apareceram no Despenhadeiro, prova que essas criaturas foram enterradas em um instante. Caso contrário, seus esqueletos não estariam tão perfeitamente preservados assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "A propósito, ouvi dizer que este lugar tem bastantes terremotos. Faz sentido, já que um dos pré-requisitos para a formação de fósseis são movimentos geológicos ativos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Esta descoberta certamente irá trazer uma nova luz ao nosso entendimento das antigas criaturas que outrora habitaram este lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Mas eu acho que precisarei de mais fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Se você se deparar com mais fósseis desses, por favor, tire algumas fotos para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "Quantas você precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Deixe-me ver. Eu preciso de 4 ou 5 para colocar no meu relatório... Certo, 5 então. Me traga 5 fotos de rochas parecidas com essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Pagarei um bom preço já que é uma grande descoberta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "Isso é um desperdício...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
		{
			"id": 7105009,
			"completionStepIds": [],
