			]
		},
		{
			"id": 7105016,
			"completionStepIds": [
				7105209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105209",
							"2"
						],
						"stepId": 7105209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Ótimo, essas fotos estão muito boas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "Certamente vale a pena gastar com uma equipe de exploração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "Veja, tudo isso são ossos de criaturas marinhas antigas. Você consegue ver suas estruturas claramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "Significa uma coisa: este local era abaixo da superfície do oceano, antes de ter se tornado o Despenhadeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "Uma pena não estarmos em Sumeru. Caso contrário, eu teria levado eles de volta para a Academia e começado a estudá-los imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "Não podemos deixar que os mineradores sem querer acabem estragando os fósseis. Preciso contratar pessoas para cuidar disso. Falarei sobre isso da próxima vez que me encontrar com as pessoas do Ministério dos Assuntos Civis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "Mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "Mas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Eu... vou me contentar com estas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "Mas como eu disse, esses fósseis estão perfeitamente preservados, com suas estruturas intactas. E isso significa uma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "Que eles foram enterrados em um instante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "Quase todos os fósseis que você encontrou no Despenhadeiro estão localizados em uma mesma altitude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "Altura fixa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "Bem, geologicamente falando, a diferença entre as alturas é minúscula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "Isso significa que foi um processo rápido — e quase todos os fósseis foram formados ao mesmo tempo. Dito isto, algo deve ter radicalmente alterado o ecossistema daqui em questão de segundos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "Eu diria algo como uma enorme onda de choque, ou coisa do gênero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500917,
					"content": "Hmm, o que pode ter acontecido no Despenhadeiro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500919,
					"content": "Mas não é uma altitude tão idêntica assim, é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "Você vai me dizer que precisa de mais fotos, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
