			"dialogs": [
				{
					"id": 722030501,
					"content": "Haha, você me encontrou de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Sabe, eu sentirei sua falta, mas... Desta vez tenho que me despedir. O tio dourado disse que nós temos que ir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Mas não se preocupe comigo! Há muitas pessoas que podem brincar disso comigo no lugar que estou indo! Gostaria que você pudesse vir também, mas o tio dourado disse que ainda não é essa hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Mas não se preocupe. Eu ficarei esperando você. Se um dia eu me cansar de esperar, eu me tornarei em pedacinhos de luz brilhante e entrarei nos seus sonhos para lhe procurar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Boa Viagem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Fiquei muito feliz de brincar com você, obrigado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Nunca ficarei sozinho de novo... Que ótimo!",
