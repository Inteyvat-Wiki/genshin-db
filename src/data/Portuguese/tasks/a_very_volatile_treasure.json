			"dialogs": [
				{
					"id": 102020401,
					"content": "Adivinha quem sou eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "Ah! É a voz da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102020403,
					"content": "Precisa de nossa ajuda para escapar daí?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Ooh, ooh, sim, por favor! Espere - não, eu... Eu não posso. Klee precisa ser uma boa garota e pensar no que ela fez... Pare de me tentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102020406,
					"content": "De qualquer forma, enquanto estou de castigo, estou criando um novo tesouro extra especial... A versão do Ludi Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102020407,
					"content": "Quando você diz \"tesouro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Tee-hee... Eu o transformei na forma de um Harpastum e tudo! Fica tão bonito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102020409,
					"content": "Você disfarçou uma bomba como um Harpastum!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Apenas espere por Ludi Harpastum, ah sim... Todo mundo vai adorar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102020412,
					"content": "Imagina se a Mestre Jean tivesse ouvido isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Klee pode se encontrar de castigo por muito mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Então... Outra bomba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Precisa de algo para comer ou algo assim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
