			"dialogs": [
				{
					"id": 718110412,
					"content": "Sobre o Aparelho Fotográfico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "Você conseguiu enviar as fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Entreguei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Obrigado, obrigado. Desculpe por te incomodar, mas mal estamos mantendo nossas cabeças acima da água por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Ah, sim. Por favor, aceite este Aparelho Fotográfico como agradecimento por sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "Eu não poderia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "Não tem problema. Você nos ajudou, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Este também não é um objeto extremamente caro. É apenas uma amostra que nossos parceiros de Fontaine nos deram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "Tem algumas diferenças entre ele e o modelo oficial... Mas as funções básicas estão todas lá. Com certeza será o suficiente para suas necessidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "E se você gostar, também pode nos ajudar com alguma publicidade aqui e ali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "Cof... De qualquer forma, obrigado por sua ajuda, e por favor, leve este Aparelho Fotográfico com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Isto deve ser muito caro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
