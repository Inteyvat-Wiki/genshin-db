					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "Aparelho Fotográfico... Ah, sim, eu fui a Guilda de Comerciantes de Feiyun alguns dias atrás - pedi-lhes que viessem aqui para tirar uma foto para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Vovó Shan"
				},
				{
					"id": 718110504,
					"content": "Você veio apenas para entregar essas fotos? Minha nossa, muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vovó Shan"
				}
			]
