			"dialogs": [
				{
					"id": 221080301,
					"content": "Você derrotou todos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080302,
					"content": "Já!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Trabalho eficiente! Estou impressionada. Você tem a habilidade de um aventureiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080304,
					"content": "Aqui está sua compensação. Graças a você, as coisas estarão muito mais seguras por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080305,
					"content": "Você encontrou algo relacionado com espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080306,
					"content": "Entendi. Mas não se preocupe, não está fora da minha expectativa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080307,
					"content": "Agradeço o seu esforço. Aqui está sua recompensa. Você já pode ir resolver seus assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
