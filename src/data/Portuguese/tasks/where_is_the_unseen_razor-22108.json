				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Não encontramos nada, não tem pistas suficientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "O que traz você aqui? Se quiser saber mais sobre a guilda, fale com Katheryne por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "#... Oh, você já é {F#uma}{M#um} aventureir{F#a}{M#o}? Por favor, aceite minhas desculpas. Posso ser a Mestre da Filial, mas não estou familiarizada com os negócios do dia a dia da Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "#Então, eu realmente não conheço nenhum dos recém-chegados... Dito isso, você não é {F#uma}{M#um} novat{F#a}{M#o}, não é? Você parece {F#uma}{M#um} aventureir{F#a}{M#o} experiente para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "Nesse caso, talvez haja algo que você possa me ajudar. Devo enfatizar, porém, que essa não é uma missão da guilda, mas uma missão pessoal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "Tudo bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Eu agradeço o seu entusiasmo, mas não é muito sábio aceitar uma missão sem examinar os detalhes primeiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Sua missão, se você aceitar, é derrotar dois Hilichurls Fortes que carregam escudos gigantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Seus escudos estão infundidos com energia Geo. Não é muito perigoso, mas você deve tomar cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "Tudo o que eu preciso que você faça é derrotá-los. Volte e me encontre depois que irei dar uma boa recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Oh, se você encontrar algo relacionado a espadas, traga para mim, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "Caso contrário, não importa. Contanto que você derrote os Hilichurls, receberá sua compensação. Isso é tudo. Vou deixar você se preparar agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Por favor, dê-me mais detalhes, e vou pensar melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "Uma resposta cautelosa. Tenho certeza de que você aprendeu o valor da cautela da maneira mais difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
