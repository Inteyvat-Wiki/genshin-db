			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "Obrigado! Conseguiremos fazer uma Lanterna Celeste agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370402,
					"content": "Está pronta, Que'er. Escreva nossos desejos nesta lanterna, se quiser, já que sua caligrafia sempre foi muito boa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370403,
					"content": "Claro, claro. Eu vou escrever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370404,
					"content": "Que'er... Você está... chateada, por acaso? Qual é o problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370405,
					"content": "Oh não, não estou nem um pouco chateada. Na verdade, eu não poderia estar mais feliz em ajudar a lançar esta lanterna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370406,
					"content": "*Cof* Aonde vocês vão com essa lanterna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "Sim, correto. Nós devemos nos preparar para soltar as lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370409,
					"content": "Então, acho que é bom você ir indo. Não irei, escalar montanhas é muito cansativo. Não tenho essa força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370410,
					"content": "Mas nós acabamos de descansar agora há pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370411,
					"content": "Minha cabeça está doendo. Talvez seja por causa do vento da montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370412,
					"content": "Isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370413,
					"content": "Ajudarei vocês a soltar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "Preciso de sua ajuda mais uma vez. Antes eu estava planejando ir a um local especial soltar as Lanternas Celestes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370416,
					"content": "Entretanto, quando o Clã de Guhua ainda existia, em todos os Rituais de Lanternas o mestre nos levava para soltá-las.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370417,
					"content": "É uma pena que devido a sua decadência ninguém mais do Clã de Guhua soltou lanternas naquele lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370418,
					"content": "Mas como você quer ajudar, por favor, vá até lá e solte uma Lanterna Celeste por mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370419,
					"content": "Marcarei as coordenadas em seu mapa. Agora tenho que ir indo cuidar de minha colega discípula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370414,
					"content": "Vim ajudar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370407,
					"content": "*Cof* Vocês deveriam soltar as lanternas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				}
			]
		},
		{
			"id": 4133706,
			"completionStepIds": [
				4133706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
