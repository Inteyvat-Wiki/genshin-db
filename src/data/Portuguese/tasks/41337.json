			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370601,
					"content": "Vocês estão aqui... Para lançar lanternas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370602
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370602,
					"content": "Apenas os membros do Clã de Guhua conhecem este lugar, e não me lembro de ter visto vocês antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370603
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370603,
					"content": "Estou aqui a pedido de alguém.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370604
					]
				},
				{
					"id": 413370604,
					"content": "Há membros do Clã de Guhua que ainda se lembram deste lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370605,
					"content": "Não vi ninguém quando cheguei, e admito que isso me entristeceu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370606
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370606,
					"content": "Mas agora sei que ainda há pessoas do Clã de Guhua que se lembram desse lugar. Me sinto melhor em saber isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370607,
					"content": "Antigamente as pessoas do Clã de Guhua soltavam lanternas aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370608
					]
				},
				{
					"id": 413370608,
					"content": "Naquela época, depois de terminarem de fazer suas lanternas, o mestre nos trazia até aqui. Ele ia em frente, e nós seguíamos trazendo as Lanternas Celestes conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370609
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370609,
					"content": "Naquela época, era possível ver as Lanternas Celestes subindo e descendo a montanha, era lindo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370610
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370610,
					"content": "Mas hoje em dia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370611
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370611,
					"content": "Mas vamos primeiro soltar essas lanternas. Quanto às coisas do passado, se você não se importar, podemos ir conversando enquanto caminhamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133707,
			"completionStepIds": [
				4133713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133713",
