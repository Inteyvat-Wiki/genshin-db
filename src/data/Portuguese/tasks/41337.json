				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370901,
					"content": "Quando deixei o Clã de Guhua, quase não havia mais discípulos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370902
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370902,
					"content": "O Mestre não me culpou. Ele apenas me desejou uma vida boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370903
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370903,
					"content": "Mas não sei se eu tive uma vida boa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370904
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370904,
					"content": "Ou talvez... Conseguiu lidar com a vida, mas sem ter muito sobre o que se falar dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370905
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370905,
					"content": "Já ouvi dizer que um Discípulo de Guhua chamado Sun Yu está atualmente visitando a montanha, e que ele procura reviver o clã de Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370906
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370906,
					"content": "Se ao menos eu tivesse sua coragem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370907
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370907,
					"content": "Desculpem, estou tagarelando, eu... É bom sair de vez em quando, tomar um pouco de ar fresco e tirar algumas coisas do meu peito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370908
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370908,
					"content": "Você parece meio triste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370909
					]
				},
				{
					"id": 413370909,
					"content": "Oh... Estou bem. É só que... Nesta época do ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370910
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370910,
					"content": "#De qualquer forma, está ficando um pouco tarde. Feliz Ritual de Lanternas, e... Por favor, você poderia passar uma mensagem para aquele que {F#a}{M#o} enviou com a lanterna? A mensagem é esta:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370911
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370911,
					"content": "...A mensagem é... Errr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370912
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370912,
					"content": "...Uhh, err... \"Feliz Ritual de Lanternas, de Zhiruo\", eu suponho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370913
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370913,
					"content": "Feliz Ritual de Lanternas para você também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370914
					]
				},
				{
					"id": 413370914,
					"content": "Obrigada. Cuide-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
