				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370201,
					"content": "Se eu lançar uma lanterna por aqui, os Adepti poderiam ver, certo? Mas com esses materiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370202,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370203
					]
				},
				{
					"id": 413370203,
					"content": "Ah, desculpe, minha companheira e eu estávamos pensando em lançar uma Lanterna Celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370204,
					"content": "O problema é que não temos materiais suficientes disponíveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370205,
					"content": "#Se ess{M#o}{F#a} amig{M#o}{F#a} quiser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370206,
					"content": "É Clã de Guhua isso... Clã de Guhua aquilo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370207
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370207,
					"content": "Estamos no Ritual de Lanternas novamente, mas seu único desejo é sobre o Clã de Guhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370208
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370208,
					"content": "Somos sucessores do Clã de Guhua, e é o nosso dever de erguê-lo de novo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370209
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370209,
					"content": "Sim. Claro! Você tem razão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370210
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370210,
					"content": "#Ugh... Amig{M#o}{F#a}, se você quiser, poderia procurar alguns materiais de Lanternas Celestes para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370211,
						413370213
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370211,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370212
					]
				},
				{
					"id": 413370212,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370216,
					"content": "Cof... Eu acabei de contar, parece que ainda falta uma Qingxin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370217
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370217,
					"content": "As últimas que escolhemos secaram e ficaram quebradiças desde então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370218
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370218,
					"content": "As Flores Qingxin também podem ser usadas para fazer Lanternas Celestes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370219
					]
				},
				{
					"id": 413370219,
					"content": "Heh, é um método pouco ortodoxo que eu e meus companheiros discípulos de Guhua uma vez inventamos quando estávamos entediados e não tínhamos mais nada para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370220
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370220,
					"content": "Mas há algo bastante agradável nas Lanternas Celestes perfumadas com flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370221
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370221,
					"content": "Ficarei aqui lhe esperando. Quando encontrar os materiais, traga-os logo, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413370213,
					"content": "Parece que a sua colega discípula tem alguma coisa para dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370214
					]
				},
				{
					"id": 413370214,
					"content": "Não é nada, você tem razão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370215
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413370215,
					"content": "*Suspiro* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370216
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
