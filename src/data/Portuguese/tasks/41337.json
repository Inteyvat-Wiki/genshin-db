			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370801,
					"content": "Uma vez também tive um vislumbre de esperança. Era um jovem que acabara de se juntar ao Clã de Guhua. Ele era bonito, muito educado e excepcionalmente talentoso. Parecia que ele seria o único capaz reviver a tradição.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370802
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370802,
					"content": "Mas era difícil encontrá-lo, e ficávamos longos períodos sem vê-lo... *Suspiro* Acho que nunca deveria ter colocado minhas esperanças nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370803
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370803,
					"content": "É melhor deixá-lo ir, e não esperar pelo seu retorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133709,
			"completionStepIds": [
				4133715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
