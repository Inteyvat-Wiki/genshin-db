			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370701,
					"content": "Uma vez, ao lançarmos nossas lanternas, um veterano arrogante me desafiou para um duelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370702
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370702,
					"content": "Antes da minha resposta, uma companheira fiel furtivamente derramou água no chão onde ele estava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370703
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370703,
					"content": "O chão estava molhado e escorregadio. Um dos discípulos mais velhos não havia sequer desembainhado sua espada antes de dar um passo, escorregando e caindo com seu traseiro no chão. Eu ri tanto que imediatamente segui o exemplo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370704
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370704,
					"content": "Ele não estava bravo, apenas apontou para mim e riu. Todos os outros se reuniram e riram junto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370705
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 413370705,
					"content": "Eu não sei onde ele está hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
		{
			"id": 4133708,
			"completionStepIds": [
				4133714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133714",
