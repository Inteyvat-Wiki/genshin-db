			"dialogs": [
				{
					"id": 413371001,
					"content": "Você voltou. Já lançou a Lanterna Celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371002
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371002,
					"content": "Sobre o que aconteceu quando soltamos as Lanternas Celestes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371003
					]
				},
				{
					"id": 413371003,
					"content": "Entendido. Sim, Zhiruo... Eu me lembro dela... Ela me cuidava muito tempo atrás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371004
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371004,
					"content": "E ela ainda se lembra do Clã Guhua. Estou muito feliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371005
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371005,
					"content": "Sobre Que'er...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413371006
					]
				},
				{
					"id": 413371006,
					"content": "Ah, sim! A dor de cabeça da Que'er está melhorando... Talvez ela tivesse apanhado um gripe, agora estou preparando ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371007
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371007,
					"content": "Sobre a Zhiruo que você acabou de falar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371008
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413371008,
					"content": "Ela também era uma do Clã Guhua? Ela era linda? Vocês se conheciam bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371009
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413371009,
					"content": "Oh. Bom, eu não posso dizer que eu conhecia ela muito bem... Mas a Zhiruo era muito boa em curar feridas. Porém, sempre que alguém se feria, íamos direto a ela",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371010
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371010,
					"content": "Hahaha, por falar nisso, provavelmente havia muita gente que gostava dela no Clã de Guhua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371011
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371011,
					"content": "E você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371012
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413371012,
					"content": "Ah... Ah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371013
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371013,
					"content": "Você e a Zhiruo... Que tipo de relacionamento vocês realmente tinham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371014
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413371014,
					"content": "Errr... Não éramos muito próximos, sério! Poderia dizer que somos companheiros do clã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371015
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371015,
					"content": "E a relação entre você e eu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371016
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413371016,
					"content": "Hahaha, esta deve ser uma irmandade predestinada, então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371017
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 413371017,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413371018
					],
					"speakerTitle": "Pequena Que'er"
				},
				{
					"id": 413371018,
					"content": "Que'er? Está... está tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
