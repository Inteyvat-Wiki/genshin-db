			"dialogs": [
				{
					"id": 745260401,
					"content": "#Ah, {NICKNAME}. É você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Você está praticando, Nilou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Não, não. Eu só estou preparando uma dança nova inspirada pelas Padisarahs que tomam banho no sol, e com o orvalho caindo das pétalas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Ainda estamos nos estágios de planejamento inicial, e muitos dos movimentos ainda estão bem primitivos. Sinto que estou faltando algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Até a descrição é bela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Você quer tirar uma foto minha? Hmm, como eu disse, esses passos de dança ainda não estão prontos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Ensaiar antes da dança é que dá sua forma final...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Sim, eu entendi! Nesse caso, vou dar tudo de mim para esses movimentos... capture bem a hora que as flores desabrocham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "Isso também é parte da arte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Você se importaria se eu tirasse uma foto sua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Eu não estou incomodando, estou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
