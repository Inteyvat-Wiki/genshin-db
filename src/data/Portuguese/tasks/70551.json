						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#Boa tarde, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510102,
					"content": "... Eu não esperava ter a honra de testemunhar seus talentos de harmonização aqui em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510103,
					"content": "Emilie, você está de férias?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "As duas coisas, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510106,
					"content": "Uma moça que se diz uma bruxa pediu para eu cuidar de sua loja de flores. Ao mesmo tempo, a Cauda do Gato me pediu para criar uma nova fragrância para seu estabelecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510107,
					"content": "E encerrar o dia com uma bebida sua é uma recompensa mais do que merecida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510108,
					"content": "Então vou me certificar de não medir esforços!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "Confio na sua escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510111,
					"content": "(Emilie é mais sensível para aromas que a maioria das pessoas. Se eu criar uma mistura desequilibrada, ela ficará desconfortável...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(De qualquer forma, eu posso usar os ingredientes com aromas secundários, e tentar dar um toque de um sabor de Fontaine no meio.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(Vamos começar com um Crepúsculo Lumidouce.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "Vou fazer uma surpresa especial!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "Emilie, você está numa viagem de negócios?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7055106",
							"2"
						],
						"stepId": 7055106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Emilie"
				],
				"points": [
					{
						"sceneId": 51206,
						"position": [
							2192.554,
							230.089,
							-777.292
						],
						"pointId": 1
					},
					{
						"sceneId": 51206,
						"position": [
							2195.024,
							230.219,
							-779.316
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "Que tal provar isso aqui, Srta. Emilie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "Suas obras são um deleite de assistir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510203,
					"content": "Hmm... Isso tem o gosto de uma variante local do Crepúsculo Lumidouce, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510204,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "Esse gosto gentil e elegante, com suas camadas distintas, combinadas com um toque do aroma característico de Mondstadt, dão um sabor de boas-vindas, e evitam aromas que potencialmente discordem entre si...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510207,
					"content": "Mas, na realidade, você não precisa ser tão conservador. Eu tenho uma tolerância alta para sabores que extrapolam o senso comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510208,
					"content": "Então essa foi muito tradicional?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "Sua bebida foi boa, mas seria perfeita se você pudesse fazer uma mais... profunda. Um coquetel que mostra seu entendimento único e que realça minha impressão de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510211,
					"content": "Se você precisar de tempo para pensar melhor nisso, talvez você encontre sua inspiração com uma conversa descontraída?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510212,
					"content": "Você acabou de comprar essas flores?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "Elas são parte de minha recompensa da dona da loja. São ingredientes importantes para fazer perfumes. Graças a elas, eu fui capaz de completar minha comissão na Cauda do Gato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510214,
					"content": "Eu estudei as Cecílias de Mondstadt muitos anos atrás. Na verdade, a fragrância da Mondstadt, em alguns campos, é sinônimo de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510215,
					"content": "Entretanto, esse é um caso especial. Alguns gatos detestam o aroma da Cecília, e precisamos ter as preferências deles em mentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510216,
					"content": "Então o que você usou como aroma dessa vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "Margaridas Voadoras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510219,
					"content": "As partes das Margaridas Voadoras podem ser moídas e suas essências extraídas. Eu então misturei os aromas de suas pétalas e olhas. O resultado final é uma doçura inebriante do prado, mas também enfatizando os tons frescos contidos no caule e folhas da flor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510220,
					"content": "Eu levei o aroma para um teste na Cauda do Gato, e os gatos gostaram muito, os clientes também acharam ela confortante e revigorante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510221,
					"content": "Extrair fragrâncias refinadas de ingredientes ordinários e subestimados me traz muita alegria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510222,
					"content": "O tempo está ótimo hoje...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(Então é assim que se inicia uma conversa pra quebrar o gelo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "Sim! Um tempo atrás, eu assisti um monte de nuvens passarem, fofinhas como travesseiros... Não está úmido demais também, e o vento também está gentil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510225,
					"content": "Em tais condições, o olfato da pessoa fica mais sensível, mas não a um ponto exagerado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510226,
					"content": "Quando os aromas se misturam bem, eles combinam naturalmente com o ambiente, deixando impressões fortes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510227,
					"content": "Eu nunca imaginei que aromas fossem tão impactados pelo tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "Parece que algo similar também faz parte do preparo de bebidas. Desde que você escolha uma base de força apropriada, os sabores se misturarão sem dificuldades...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510230,
					"content": "Ao ser misturado adequadamente, todos os ingredientes funcionam como um para criar uma sinfonia poderosa para suas papilas gustativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510231,
					"content": "Entendo, então a combinação de sabores é a chave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "Sim, isso! Agora que estou pensando mais, estratificar sabores distintos não combina com minhas preferências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510234,
					"content": "O que você costuma beber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "Geralmente, hmm... Depois do trabalho, meus amigos da Maison Gardiennage às vezes me pagam algumas bebidas. Eu geralmente fico com chá de frutas, aí posso voltar ao trabalho assim que nossos encontros acabam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510236,
					"content": "Se for antes de um feriado e meus amigos estiverem animados, peço um copo pequeno de vinho de fruta gaseificado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510237,
					"content": "Tinha uma oficial chamada Turenna que costumava me levar para beber vinho Corte envelhecido. Mas como ela foi transferida para a Patrulha de Segurança e Monitoramento Especial, não tivemos mais essa chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510238,
					"content": "Oh, então você bebe álcool às vezes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "No mundo da ciência, álcool é um solvente comum. Eu já me acostumei com o cheiro dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510241,
					"content": "Além disso, quando estou levemente bêbada, minha mente muda, que por sua vez muda minha abordagem para perfumes... Não importa se o resultado é bom ou ruim, o que importa é se experimentar algo novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510242,
					"content": "Por isso, não me importo com um pouquinho de álcool, mas, ainda assim, não gosto de nada muito forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510243,
					"content": "Como está a sua perfumaria ultimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "Ah, obrigada por perguntar. Está bem, mas essa viagem para Mondstadt me trouxe alguns desafios inesperados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510245,
					"content": "Quando cheguei aqui, estava contando com uma cópia de \"Uma Visão Geral das Substâncias Aromáticas e os Sentidos Humanos\" para identificar os ingredientes locais promissores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510246,
					"content": "Para minha surpresa, minha fragrância de teste, que usou Valberry como base, acabou saindo muito doce para uma taverna, relaxando as pessoas ao ponto delas ficarem sonolentas. Aquela bartender com orelhas lindas caiu no sono em cima do balcão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510247,
					"content": "Eu nunca imaginei que Valberries pudessem ter esse efeito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "Bem, vamos dizer que doçura nem sempre é um caso de quanto mais, melhor. Manter um equilíbrio é bom tanto para a mente como para o corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510250,
					"content": "Mesmo na vida cotidiana, eu raramente como coisas doces, e tento evitar frutas como bagas que têm muito açúcar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510251,
					"content": "No final, eu eliminei completamente a Valberry como um ingrediente, e usei as Margaridas Voadoras. Com certo sucesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510252,
					"content": "Acho que sei como melhorar sua bebida. Espere um pouco enquanto mudo a receita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "Hmm? Você já conseguiu pensar em algo novo só com essa conversa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510254,
					"content": "Talvez você possua um talento natural para esse tipo de trabalho criativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510248,
					"content": "Acho que isso quer dizer que perfume de Valberry não serve...",
