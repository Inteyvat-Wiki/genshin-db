			"dialogs": [
				{
					"id": 711630201,
					"content": "Não parece que Zibai tá aqui... E bem depois que ela convidou a gente pra entrar! Para onde ela pode ter fugido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630202,
					"content": "Hmm! Esse parassol parece familiar... A gente já viu isso em algum lugar antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630203,
					"content": "Talvez pertença a ela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Você deve ter razão... Mas por que ela ia deixar o parassol dela na porta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630205,
					"content": "Ela tem mesmo uma memória terrível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "O que a gente vai fazer? Do jeito que as coisas tão, Paimon tá preocupada que ela vai tá na metade do prato e esquecer como segurar os pauzinhos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630207,
					"content": "*Suspiro* Nós deveríamos ir encontrar ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630208,
					"content": "Espera um minuto... Não tenho certeza que isso é realmente um guarda-sol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Hã? O que é isso então? Hum... Deixa a Paimon dar uma olhada mais de perto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630210,
					"content": "Uau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
