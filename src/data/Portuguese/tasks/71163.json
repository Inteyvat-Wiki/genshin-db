			"dialogs": [
				{
					"id": 711630301,
					"content": "O que está acontecendo? Como a gente veio parar aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630302,
					"content": "Então, o que vocês acharam do presentinho que fiz para vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630303,
					"content": "Então é aqui que você está, Zibai! O que é esse guarda-sol? De repente, ele fez um \"vuuush\" e trouxe a gente até aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630304,
					"content": "Parece que não sou a única que tem dificuldade em se lembrar das coisas. Vocês já se esqueceram de ter andado nele comigo antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630305,
					"content": "Isso refresca suas memórias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630306,
					"content": "Oh! É... é a carruagem lunar! Não é à toa que parecia tão familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630307,
					"content": "Haha, é só uma réplica criada de minhas memórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630308,
					"content": "E é tudo graças ao amuleto de jade quebrado que você me devolveu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630309,
					"content": "Ah! Então esse era o item que você tava planejando fazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630310,
					"content": "Precisamente. Essa carruagem feita do amuleto de jade pode transportar você rapidamente aonde desejar ir, o que deve ajudar suas viagens a serem mais tranquilas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630311,
					"content": "#Por favor, aceitem, {M#meus devotos}{F#minhas devotas} guias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630312,
					"content": "Uau, isso é incrível... Paimon achava que você tava falando aquela coisa toda de \"fazer item\" pra ser legal, Paimon nunca esperava que você fosse fazer mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630313,
					"content": "Eu esperava que fosse tomar um tempo, considerando o estado que o amuleto estava, a energia espiritual dele estava completamente esgotada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630314,
					"content": "Mas felizmente para nós, aqui é o Vale Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630315,
					"content": "Hã? O que tem de tão especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630316,
					"content": "Você sabe exatamente onde estamos no vale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630317,
					"content": "Hmm... Porto Yilong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630318,
					"content": "Hehe, você tem muito a aprender sobre este lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630319,
					"content": "O chão abaixo de nossos pés é, na verdade, um das interseções-chave nas Linhas Ley de Liyue. Há oito nódulos como esse ao todo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630320,
					"content": "Vida, Morte, Repouso, Ocultação, Iniciação, Terreno, Terror e Ferimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "Você é mais familiar com esse lugar do que eu esperava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630322,
					"content": "Ah! Agora Paimon lembra. Vocês tão falando dos oito portões!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630323,
					"content": "Correto. Estamos agora no centro do mais auspicioso desses portões, o Portão da Vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630324,
					"content": "O Portão da Vida simboliza crescimento, prosperidade e revitalização. Assim, eu consegui recuperar a energia espiritual do amuleto de jade tão rapidamente e fabricar essa carruagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630325,
					"content": "Uau, isso que é potência! Paimon acha que o Vale Chenyu é uma terra de maravilhas mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630326,
					"content": "De fato... É um bom lugar para vocês criarem raízes em paz e prosperidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630327,
					"content": "Hã? Como assim \"vocês\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630328,
					"content": "Não é nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630329,
					"content": "Tudo bem, fiz o que desejava fazer. Vocês podem continuar seus assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630330,
					"content": "Planejo dar um passeio do topo dessa montanha. É aqui que nos separamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630331,
					"content": "Valeu, Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "Não precisa me agradecer. Você me despertou do meu sono, sou eu que estou em dívida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630333,
					"content": "Foi tudo coisa de Zhongli, sério.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "E eu disse a ele o mesmo que disse a você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630335,
					"content": "Ele mencionou que você está numa longa jornada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630336,
					"content": "A sua próxima parada é aquela terra distante de neve, por acaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630337,
					"content": "Sim, vamos pra Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Snezhnaya... Hmm, embora eu não saiba nada daquele lugar, nenhuma jornada pelo gelo e neve é isenta de perigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630339,
					"content": "Caso se vejam precisando de ajuda, sabem onde me encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630340,
					"content": "Pode deixar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "Cuidem-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zibai"
				}
			]
		}
	]
}