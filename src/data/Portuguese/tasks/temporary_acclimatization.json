			},
			"dialogs": [
				{
					"id": 711140901,
					"content": "*Suspiro* Talvez a gente devesse ter feito tomadas da Vila Qiaoying primeiro no fim das contas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140902,
					"content": "Tá tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#Ah, {NICKNAME}, Paimon! Graças a vocês, conseguimos recuperar todas as nossas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140905,
					"content": "Mas eu acho que, se fôssemos retornar àquela área no futuro, vamos ter que levar aventureiros conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140906,
					"content": "Então, hmm, sobre seu filme sobre chá... Como vão as gravações?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Bem... atualmente nós temos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140908,
					"content": "Uma boa sequência de abertura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "E uma boa visão artística.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Então... Vocês não gravaram quase nada?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "Bem, sabe... Estamos atualmente com pouco dinheiro. Como um mestre cineasta, o valor dos serviços do Sr. Renault não são exatamente baratos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140912,
					"content": "Apesar de já termos feito alguns filmes menores, e ganhado alguma Mora com eles, um longa-metragem queima seu orçamento como se fosse nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140913,
					"content": "Especialmente porque a Chefe também recusou alguns investidores potenciais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "E recusou muitos convites para colaborações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Ei, o que vocês sabem?! Isso foi tudo para que pudéssemos criar um filme excelente que reflita nossos padrões e visão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140916,
					"content": "Mas Chefe... A gente começou essa produtora de filmes porque a gente queria ganhar dinheiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Eu... Parem de se preocupar com isso agora! Só vão e preparem o equipamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, essa é sua recompensa. Obrigada por sempre me oferecer seu apoio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140919,
					"content": "Quando tiver feito o filme dos meus sonhos, com certeza te convido para a estreia e te levo para tomar chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, garantam pegar o melhor ângulo para nossa iluminação! Vamos pegar isso em uma tomada, tão me ouvindo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140921,
					"content": "Mas Chefe, a gente nem tem nenhum ator aqui com a gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Não fica tudo ao acaso se a gente consegue pegar a paisagem em uma tomada...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "S-Só se apresse e prepare o equipamento! Então espere aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Srta. Qiu"
				},
				{
					"id": 711140903,
					"content": "Parece que vocês não perderam nenhum equipamento, pelo menos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
