						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "...Esses ajustes devem resolver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "Ah, vocês já instalaram os instrumentos? Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Quando eu terminar de colocar esse, entregarei a recompensa de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Você podia ter só me dado com o resto do lote.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "Obrigada pela sua gentileza. Infelizmente, esse instrumento é um tanto especial. Ele requer ajustes e calibragens adicionais, e eu não queria incomodar tanto assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Vamos colocar ele naquele penhasco, aí entrego a recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Isso parece bem difícil... Você sempre trabalhou assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Haha, pelo menos agora, só preciso colocar meus instrumentos no chão. Em uma expedição anterior, eu tive que literalmente descobrir um jeito de colocar um no meio de um rio caudaloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Não dava só pra pegar um barco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Digo, se tudo que eu precisasse fosse soltar o instrumento, então beleza, eu podia só ter pegado um barco, soltado ele no meio do rio e saído...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Mas eu tava tentando medir a intensidade do fluxo da água, então tive que manter o instrumento especializado parado no centro do fluxo, para impedir ele de afundar ou boiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Felizmente, tinha uma ponte suspensa sobre aquele rio. Se não tivesse uma ponte, eu teria que pedir para alguém me ajudar a puxar uma corda entre as duas montanhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Então pendurar o dispositivo em uma das cordas, antes de usar outra corda para mover ele até o centro do rio e jogá-lo na água.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Enfim... Não tem motivo para falar disso agora. Não é como se isso fosse algo que teremos que resolver... Dito isso, ainda vamos passar por uma ponte suspensa no caminho ao nosso destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Venham por aqui. Aquela ponte não tá longe daqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
