						718120203
					]
				},
				{
					"id": 718120203,
					"content": "Isso... Eu nunca vi algo assim, onde você descobriu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120205,
					"content": "Perto das Ruínas de Dunyu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "Ruínas de Dunyu? Como tem coisas dessas ali também...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120207,
					"content": "Obrigada pela sua ajuda em decifrar as pistas. De acordo com os costumes dos Aventureiros, essas coisas agora lhe pertencem, e aqui está sua recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120208,
					"content": "Eu organizarei pessoas para irem para as Ruínas de Dunyu fazer uma investigação mais profunda o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120209,
					"content": "Que estranho... Toda a região das Ruínas de Dunyu já foi explorada várias vezes, como é possível que haja um local que foi esquecido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
