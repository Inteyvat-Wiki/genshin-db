			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Bem... Liloupar, você está bem? Por que está tão quieta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Shhh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Espera... Viu? Ela está brilhando. Que diferente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "A garrafa de Jinni está brilhando e parece estar em sintonia com a vibração da peça de xadrez.\\nVocê ouve o passar do tempo, como gotas de água em uma prisão... Parece durar uma vida inteira, ou um momento.\\nMas Liloupar não está falando.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "E então, além da névoa, você vê uma grande cidade. Imensa, inchada e fria.\\nA terra abriu uma fenda e engoliu toda Gurabad...\\nE lá estavam seus portões, encostados na parede da colina. Era tão feio que parecia conter toda a sujeira do velho mundo, mas não foi feito para ser visto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "Então essa é a Cidade de Gurabad. Agora eu me lembro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "Minha cabeça está doendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Nossa, qual é o problema de vocês... Deixem a Paimon avisada da próxima vez! Paimon não gosta de ficar chocada o tempo todo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Desculpe, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Bem, Paimon está brava mesmo assim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#Heh... Vocês crianças são todas iguais. Está tudo bem, não se preocupe. Eu vou devolver el{M#e}{F#a} a você, pode ter certeza disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "#Quando o momento chegar, {M#ele}{F#ela} irá lhe compensar com muita comida boa... E \"Mulah\", a sua moeda, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "É \"Mora\"... Espera, por que eu estou te corrigindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Isso mesmo... Eu vou anotar! Comida deliciosa e Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "#Certo, chega de brincadeira. Vamos para Gurabad, {M#meu}{F#minha} Mestre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Por que temos que ir para lá?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "#Por quê? Não sei... Talvez a razão sequer importe, mas eu preciso estar lá. Então vamos, {M#meu}{F#minha} Mestre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "Se houver uma razão, é o fato de que quero que você testemunhe meu passado e minhas lições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "Não parece existir um começo ou um fim... Paimon não entendeu direito, mas Paimon acha que entendeu que você está se despedindo. É isso mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "#Haha, não se preocupe... É que eu gostaria que vocês {M#mesmos}{F#mesmas} vissem algumas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "Quê? Você está falando de um jeito muito confuso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "Em resumo, por favor, me sigam. Eu vou mostrar a vocês a localização de Gurabad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad... O que há ali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "Não há nada. Não sobrou nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "Sobraram apenas memórias de fantasmas, sonhos partidos sem chance de recuperação e o doce gosto da vingança... Eu diria que é só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "Parece pedir muito... mas eu espero que você consiga testemunhar meu passado e minhas lições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Não decida coisas por mim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "Estou bem, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "Você sempre diz isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
