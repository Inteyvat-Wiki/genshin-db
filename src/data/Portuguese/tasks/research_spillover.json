			"dialogs": [
				{
					"id": 761380101,
					"content": "Srta. Nefer! Que coincidência, você chegou bem na hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Então você se decidiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Hã? Decidi...? O-o que você quer dizer, será que...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "Eu sei que você sempre quis visitar os Filhos da Lua Gelada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Você espera conhecer Lyylikki primeiro e usar essa amizade como seu trampolim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Você... você sabia o tempo todo? Mas eu mantive isso trancado no meu coração e mal contei a alguém...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Bem, Sr. Zompaynco, quando você guarda um segredo, também deve aprender a esconder o fato de que está guardando um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Caso contrário, não importa quão alta seja a muralha que você erga em seu coração, mais cedo ou mais tarde o vento encontrará suas rachaduras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "*Suspiro* Eu nunca fui bom em guardar meus sentimentos, mesmo quando ainda estava na minha cidade natal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Bem, agora que você sabe, poderia me ajudar a fazer uma apresentação? Sou um forasteiro, e não quero incomodar a Srta. Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Fique tranquilo. Os Filhos da Lua Gelada são excepcionalmente gentis — seja alguém um estranho ou esteja em uma forma não inteiramente humana, eles oferecerão uma recepção calorosa e cortês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Hã? É mesmo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Mas ainda assim, não seria adequado simplesmente aparecer sem avisar. Srta. Nefer, poderia me apresentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Certo. Pelo horário, eles devem ter acabado de distribuir as refeições — momento perfeito para uma conversa. Vamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "Ah, e desta vez não cobrarei nada. Eu só estava de passagem, afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Oh, muito obrigado! Vou pegar minhas coisas imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
