			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "E aí? Conseguiu derrotar aquele monstro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300602,
					"content": "Com certeza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "Ótimo... Acho que agora finalmente podemos relaxar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300604,
					"content": "Obrigado pela sua ajuda, Viajante. Por favor, aceite isso como nosso agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300605,
					"content": "Mas por que tal monstro apareceu do nada nos arredores da Vila Qingce? Que estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300606,
					"content": "Não tem importância, de todo jeito, eu devo reportar isso para o Ministério dos Assuntos Civis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300607,
					"content": "Espero que o Ministério dos Assuntos possa transferir algumas pessoas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		}
