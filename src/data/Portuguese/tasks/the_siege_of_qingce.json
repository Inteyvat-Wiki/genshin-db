				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "Viajante, aqui! Aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "É um assunto da Vila Qingce! Os meteoritos caídos inquietaram os monstros ao redor da vila. Agora eles estão dispersados na vila como uma ameaça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300106,
					"content": "Apesar de nenhum mal afligir a Vila Qingce enquanto a protegermos, nossos suprimentos precisam vir de fora dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300107,
					"content": "Essa situação, o Ministério dos Assuntos Civis não pode mandar muitas tropas para fazerem uma escolta... Se encontrarem um grupo grande de monstros, as provisões estarão em perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300108,
					"content": "Olhe, nós pensamos assim... Mesmo que não possamos ir muito longe, podemos pelo menos derrotar os monstros perto da Vila Qingce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300109,
					"content": "Desta maneira, nós podemos ajudar aqueles que estão escoltando nossos suprimentos. Entretanto, nossos batedores falam que existem alguns pontos de concentração de monstros nos arredores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300110,
					"content": "Apenas com o nosso esforço, é um pouco difícil derrotar todos os acampamentos. Se demorarmos mais um pouco, talvez apareçam mais problemas na Vila Qingce também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300111,
					"content": "Viajante, você pode nos ajudar a nos livrarmos dos monstros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinglun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "Não é suficiente... Precisamos de reforços...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300202,
					"content": "Já destruí o acampamento dos monstros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "Ótimo, muito obrigado. Mas agora há pouco aconteceu outra coisa inesperada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300204,
					"content": "Originalmente eu achava que os monstros nos arredores da Vila Qingce eram criaturas comuns...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300205,
					"content": "Liderei algumas pessoas para destruir o acampamento, e estávamos nos preparando para descansar um pouco para depois continuar em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300206,
					"content": "Mas perto da floresta, surgiu de repente um Lawachurl da Pedra Oculta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300207,
					"content": "Nós não tivemos tempo de reagir, ele nos atacou de surpresa, muitos foram feridos... Nós tivemos que bater em retirada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300208,
					"content": "Aquele monstro é uma ameaça muito grande para ser deixado em paz. Mas as outras tropas que partiram para destruir outros acampamentos ainda não retornaram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300209,
					"content": "Viajante, você pode nos ajudar a derrotar esse monstro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300210,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "Muito obrigado. Eu lamento muito... Originalmente, isso era uma responsabilidade nossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300212,
					"content": "Os feridos estão bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "Eles foram tratados bem a tempo, nenhum deles tem um ferimento sério... Mas não poderão se mover bem por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300214,
					"content": "Só posso contar com você para derrotar aquele monstro, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300215,
					"content": "Peço desculpas... Originalmente, isso era uma responsabilidade nossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
