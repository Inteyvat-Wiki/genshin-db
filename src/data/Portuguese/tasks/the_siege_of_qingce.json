			"dialogs": [
				{
					"id": 411300401,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "Ótimo. Vou chamar os outros, vamos partir imediatamente, quanto mais rápido resolvermos isso, melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "Jinglun"
				},
				{
					"id": 411300403,
					"content": "Depois de destruir o acampamento, vamos nos encontrar aqui novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinglun"
				}
			]
		},
