				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "De novo! Nós, novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140102,
					"content": "Viajante, Paimon. Vocês vieram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140103,
					"content": "Nós já nos acostumamos a nos encontrar assim com Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140104,
					"content": "Eu concluí sua missão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "Muito obrigado. Foi uma escolha certa procurar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140107,
					"content": "Consegui ajudar você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "É claro. Você me ajudou muito em minha pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140109,
					"content": "Hehe, que bom ouvir isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140110,
					"content": "Irei me lembrar de sua bondade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140111,
					"content": "Essa espada é para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "Deve ser forte o suficiente, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140113,
					"content": "Sim. Como se sente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140114,
					"content": "Normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "Então, ainda bem. Não tem efeitos secundários, poluição e veneno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140116,
					"content": "Parece que... Estava certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140117,
					"content": "Você pensa que é um profeta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140118,
					"content": "Você gostou da espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140119,
					"content": "É uma arma boa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "Ah, é? Não importa, atingiu o estado que desejada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140122,
					"content": "Pegue na espada... Albedo, você quer usá-la? Não crie problemas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140123,
					"content": "Eu quero extrair a força de vida pura de dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140124,
					"content": "A força existe fora da espada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140125,
					"content": "Talvez seja impossível para alguns, mas eu sou capaz disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140126,
					"content": "... Pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140127,
					"content": "Uou, essa força parece uma bola de luz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140128,
					"content": "Ah! Você a colocou em uma garrafa misteriosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412140129,
					"content": "Essa espada não é uma arma divina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140130,
					"content": "...É uma recordação. Espero que possa ajudar vocês na viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140131,
					"content": "Sério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "Eu precisava apenas para meu estudo. Agora já tenho o que preciso e por isso a espada deve ficar com quem sabe usá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140134,
					"content": "Viajante, obrigado por me ajudar a concluir meu estudo. Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140135,
					"content": "A força de vida desse dragão ressoa comigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140136,
					"content": "Não porque é um dragão, mas sim porque sou eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140137,
					"content": "Rhinedottir... Mestre... Esse é o dragão gigante \"Durin\" que você criou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140139,
					"content": "O meu encontro com ele é realmente algo bom?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412140132,
					"content": "Você não precisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "Não é boa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "Eu cumpri tudo o que prometi para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}