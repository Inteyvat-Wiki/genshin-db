				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "Viajante! Você chegou na hora certa! Pode me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Você deve ter visto. O ambiente na Montanha Nevada é muito severo. Nem mesmo Aventureiros experientes se atrevem a dizer que podem lidar com o que está lá dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "Eu tenho ordens da Grande Mestre Intendente para ficar aqui de guarda e avisar aos moradores de Mondstadt para não subirem na Montanha Nevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "Consegui convencer muitos moradores de Mondstadt, mas não posso dizer o mesmo daqueles Aventureiros...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Você também sabe, mesmo que eu consiga convencer eles que a subida é perigosa, eles não dão ouvidos. Apenas querem subir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Não sei com quantas questões relacionadas a Aventureiros tive que lidar, mas o número deles que querem subir a Montanha Nevada está crescendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Não é possível controlar todos os Aventureiros que vão para a montanha, portanto, decidimos colocar suprimentos em alguns locais da Montanha Nevada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "Desta maneira, os Aventureiros que já estão cansados e querem retornar poderão comer e ter mais oportunidades de sair da montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "No entanto, se algum idiota imprudente, bêbado demais, acabar muito lá em cima, eles só poderão contar com eles mesmos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Resumindo, você pode nos ajudar a colocar esses suprimentos na Montanha Nevada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Você pode contar comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Muito obrigado. *Suspiro* Quem me dera que todos os Aventureiros fossem assim. Que soubessem a hora certa de seguir em frente ou de parar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "Marquei três pontos no seu mapa. Coloque <color=#00E1FFFF>um Presunto</color> em cada local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "*Suspiro* Gostaria que aqueles Aventureiros fossem mais autoconscientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "Eles serão úteis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "Se eles vão ou não... É melhor tê-los do que não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "Neste clima terrível da Montanha Nevada, sempre é bom ter suprimentos a mais. Por favor, peço sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
