					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "Você acabou de usar uma Visão Pyro para disparar fogo das suas mãos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650601,
					"content": "Vamos ver quanto tempo você vai demorar para falar algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Use a <color=#00E1FFFF>Mão Abrasadora</color> de novo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Pare! Pare! Por favor, isso dói, eu lhe imploro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650406,
					"content": "Use a <color=#00E1FFFF>Mão Abrasadora</color> de novo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Uuugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4651403,
					"content": "Fingir-se de morto não vai te ajudar, esse fogo não foi forte o suficiente para... Oh... Parece que ele <color=#00E1FFFF>desmaiou</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "... Ei! Ainda não chegou a hora de dormir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Ah, isso queima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650901,
					"content": "Está bem, eu falo, eu falo! Ahhh... P... Por favor, eu <color=#00E1FFFF>conto tudo</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650902,
					"content": "A Ordem... Ordem de Abismo reuniu todas as forças de ódio ao Herói Obscuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650903,
					"content": "Eles marcharão pelos <color=#00E1FFFF>portões principais</color> de Mondstadt amanhã às 10 da noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650904,
					"content": "Isso é tudo o que eu sei... Por favor... Não me faça sofrer com essas chamas outra vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650905,
					"content": "Isso é tudo? Bem, duvido que você seja tolo o suficiente para manter alguma coisa oculta.",
