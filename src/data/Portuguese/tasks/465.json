			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "Mestre Diluc! Temos algumas notícias terríveis! Estávamos agora mesmo com os Cavaleiros de Favonius e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650202,
					"content": "Suponho que você esteja se referindo à declaração de guerra da Ordem do Abismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650203,
					"content": "Sim, estou sabendo. Obrigado por virem me avisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650204,
					"content": "Quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650205,
					"content": "A rede de inteligência da Adega do Alvorecer se estende além da natureza comercial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650206,
					"content": "Ótimo! Então, qual é o plano, Mestre Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650207,
					"content": "Estou aberto para sugestões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650208,
					"content": "Você realmente devia se juntar às forças dos Cavaleiros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "Não, assim estaríamos entrando no jogo da Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650210,
					"content": "Eles sabem que não estamos exatamente de acordo. Estão usando isso para me obrigar a aparecer em frente deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650211,
					"content": "Se minha identidade for exposta, todas minhas atividades futuras estarão sujeitas a interferências dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650212,
					"content": "Afinal de contas, nenhuma organização poderosa deseja ser liderada por alguém de fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650217,
					"content": "Ugh... A Ordem do Abismo realmente deixou você em maus lençóis desta vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650218,
					"content": "Tem uma maneira, mas para que funcione, preciso de mais informações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650219,
					"content": "Principalmente, preciso decifrar algumas partes obscuras da declaração de guerra da Ordem do Abismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650220,
					"content": "Partes obscuras? Você quis dizer as partes que a Paimon não consegue ler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650221,
					"content": "Deve ser um código que apenas os membros da Ordem do Abismo conseguem entender, utilizado para espalhar as informações dentro da organização.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650222,
					"content": "Por que eles enviaram a você uma mensagem que apenas eles conseguem entender?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "Não é apenas uma declaração de guerra, mas também uma notificação para eles mesmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650225,
					"content": "Quando você escolhe uma postura de que converte você em um herói para uma das partes, você também se converte em um inimigo para a outra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650226,
					"content": "E levando em conta que eu já fui inimigo da Ordem do Abismo por muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650227,
					"content": "Eles me fizeram o alvo em torno do qual eles podem reunir suas tropas e unir suas forças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650228,
					"content": "Uau... Parece que precisa ser muito inteligente para se tornar um super-herói, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650229,
					"content": "Eu apenas conheço bem os meus inimigos. E como eu disse antes, heróis e inimigos são dois lados da mesma moeda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650230,
					"content": "E quanto às informações que não conseguimos decifrar, o que vamos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650231,
					"content": "É simples. Quando você não entende algo, você pergunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650232,
					"content": "Eu já rastreei uma das <color=#00E1FFFF>fortalezas</color> deles... Se você estiver interessado, fique à vontade em vir junto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650223,
					"content": "Se eles sabem que não conseguimos ler, por que teriam escrito isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Fique no Vinhedo até que isso termine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "Isso seria igual a ceder diante dos Cavaleiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650215,
					"content": "Se eles merecessem essa tarefa, as coisas nunca teriam chegado até esse ponto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650216,
					"content": "Em qualquer caso, as circunstâncias não são graves o suficiente a ponto de eu ter que me esconder e deixar os cavaleiros se encarregarem das consequências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				}
			]
		},
