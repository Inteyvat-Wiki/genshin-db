			"dialogs": [
				{
					"id": 4650401,
					"content": "Como você me encontrou aqui? Favonius maldito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650402,
					"content": "Eu não sou um Cavaleiro de Favonius. Agora, comece a contar o seu plano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Então, vocês também já leram a carta... Mas caso achem que vou lhes contar o segredo, estão errados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Interrogar"
				},
				{
					"id": 4650404,
					"content": "Parece que você ainda não entendeu a situação em que você se meteu.",
