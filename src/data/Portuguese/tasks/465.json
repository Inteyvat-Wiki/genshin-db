			"dialogs": [
				{
					"id": 4650501,
					"content": "Se não fizermos contato com o Herói Obscuro em breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "O que devemos fazer em relação ao desafio da Ordem do Abismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "Ah! São vocês! Tenho que admitir que o assunto do Herói Obscuro foi uma dor de cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "Acabamos de realizar uma reunião para decidir sobre um curso de ação apropriado. Você consegue adivinhar o que é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "Enterrar a cabeça firmemente na areia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "Haha... Muito bom, mas não, a ordem não pode se dar ao luxo de simplesmente ficar de braços cruzados enquanto houver a menor suspeita de uma ameaça enfrentada por Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "Se fosse esse o caso, mais e mais pessoas começariam a confiar no Herói Obscuro em vez dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Hum, então qual é o plano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Descobrir a identidade verdadeira do Herói Obscuro, e lhe oferecer a nossa proteção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "\"Proteção\"? Ele parece que está fazendo bem sem a nossa proteção. Sabe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "Tsc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "*Suspiro* Bom, já que vocês ajudaram os Cavaleiros no passado, eu poderia lhes dizer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "A oferta de proteção é apenas uma estratégia dos Cavaleiros de Favonius poderem assumir a responsabilidade total e exclusiva por esse assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "Você não vai deixar o Herói Obscuro ser heroico? Por que não?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "Primeiramente, para mostrar o poder dos Cavaleiros de Favonius. Para provar às pessoas que, mesmo sem o Herói Obscuro, ainda podem confiar na ordem de manter a paz e a harmonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "Em segundo lugar, a Ordem do Abismo não tem piedade em seus corações. Se algo acontecer com o Herói Obscuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "Serviria apenas para promover suas ambições nefastas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "Ugh, nunca pensei que a vida de um Cavaleiro fosse tão angustiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "Mas nada desse plano funcionará se não estabelecermos a verdadeira identidade do Herói Obscuro a tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "Não é preciso ficar desesperado, Huffman. Faça o que digo, e tudo melhorará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Ah, Capitão Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Ultimamente, o Mestre Diluc tem trabalhado na Presentes dos Anjos em todas as noites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "Tudo que eu preciso que você faça é mantê-lo à sua vista. Acha que pode fazer isso para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "Sim, Capitão Kaeya!... Mas, isso significa que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "O Mestre Diluc é o Herói Obscuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650529,
					"content": "Hum? Ninguém sabe, talvez seja apenas uma sensação minha. Eu posso estar errado de vez em quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650508,
					"content": "Juntar forças com o Herói Obscuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650509
					]
				},
				{
					"id": 4650509,
					"content": "Não. Isso enviaria um sinal de que os Cavaleiros são a favor da presença contínua do Herói Obscuro em nossa cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650510
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650510,
					"content": "Incentivar esse tipo de heroísmo individual baixa a autoridade dos Cavaleiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				}
			]
		},
