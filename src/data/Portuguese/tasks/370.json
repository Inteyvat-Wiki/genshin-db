			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3700401,
					"content": "É um cristal imbuído com algum tipo de poder... Lisa, você consegue analisar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700402,
					"content": "Deixe-me dar uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700403,
					"content": "Eu consigo ver impurezas no cristal, mas preciso fazer uma inspeção mais profunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700404,
					"content": "Não, desculpe. Eu não consigo fazer uma análise detalhada neste momento. Me dê um tempo, por favor. Irei dar uma olhada na seção restrita da biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700405,
					"content": "Certo. Vou deixar a análise com você então, Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700406
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700406,
					"content": "Entendido. Irei avisar você se eu descobrir qualquer coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700407,
					"content": "Mas não vou aumentar muito suas expectativas. São textos muito antigos, além disso - ai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700408,
					"content": "Ugh... Isso dói!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700409,
					"content": "As impurezas do cristal... Elas machucam quando eu me aproximo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700410,
					"content": "Sim, parece que elas reagem com as Visões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700411
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700411,
					"content": "O poder dessas impurezas repele a energia elemental de nossos corpos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700413,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700414
					]
				},
				{
					"id": 3700412,
					"content": "#Mas realmente é estranho. {NICKNAME} também possui habilidades elementais, mas não parece ser afetad{F#a}{M#o} da mesma maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700415,
					"content": "Gracinha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700416,
					"content": "Está bem, vamos fazer assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700417
					]
				},
				{
					"id": 3700414,
					"content": "Enfim, seria melhor deixar o cristal nas mãos da minha gracinha. Será apenas um incômodo se deixado conosco, metaforicamente e literalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700415,
						3700416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3700417,
					"content": "Fascinante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700418,
					"content": "Você tem ideia do que te faz tão especial?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700420,
					"content": "Eu também não...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700421
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700421,
					"content": "#Então, {NICKNAME}, os Cavaleiros de Favonius tem outro favor a pedir a você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700422,
					"content": "#Por favor, aceite este título de Cavaleir{M#o}{F#a} Honorável... E a gratidão da Grande Mestre Intendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700423
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700424,
					"content": "#Cavaleir{M#o}{F#a} Honorável... De Favonius?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3700426,
					"content": "Estamos pedindo novamente a você a sua ajuda a investigar os mistérios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700427
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700427,
					"content": "A ira do Stormterror... E os cristais misteriosos. Creio que a paz de Mondstadt depende dessas respostas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700428
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700428,
					"content": "Que o vento abra seus olhos para a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700429
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3700429,
					"content": "Se encontrar algo, nós reunimos aqui novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 4820221,
					"content": "Siga a <color=#00E1FFFF>rota marcada</color> para terminar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}