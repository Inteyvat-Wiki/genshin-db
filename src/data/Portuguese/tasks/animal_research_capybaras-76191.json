			"dialogs": [
				{
					"id": 761910301,
					"content": "É mesmo uma Capivara prateada... Sem tintas, sem truque de luz. Isso é tão incrivelmente raro... absolutamente incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "Procurei Natlan toda e nunca consegui encontrar uma. Na verdade, ela foi sequestrada por contrabandistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Mas não parece estar ferida... Hehe, uma Capivara prateada! Nunca imaginei que eu veria uma com meus próprios olhos! Me deixa só... ah, me deixa sentir ela por um momento, ver se essa prateada parece diferente das outras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "Ai! Tá queimando muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Capivara"
				},
				{
					"id": 761910306,
					"content": "Ah, quase esqueci! Você ainda tá na panela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Será que você se acostumou com o Flogisto Líquido de Natlan, então essa temperatura não é nada demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Enfim, você vai voltar comigo por enquanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪~",
