			"dialogs": [
				{
					"id": 700070801,
					"content": "Sobre o barulho na Biblioteca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "Entendo... Bem, você pode usar \"aquele método\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070803,
					"content": "Lisa disse que se houver pessoas que não estão seguindo as regras da Biblioteca, elas precisam ser punidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070804,
					"content": "Por favor, vão até à Biblioteca e transmitam isso para Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070805,
					"content": "Páginas rasgadas, flores dentro dos livros, livros colocados de qualquer jeito nas prateleiras... Realmente estão violando as regras da biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070806,
					"content": "Vamos indo. Temos que passar a mensagem de Lisa para essas pessoas que não vieram para a Biblioteca para ler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
