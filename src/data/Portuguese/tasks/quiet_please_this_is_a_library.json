			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jovem Apaixonado",
					"Jovem Apaixonada"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "É realmente uma história que emociona as pessoas, é uma pena que o final não é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Jovem Apaixonado"
				},
				{
					"id": 700070202,
					"content": "Nós não nos tornaremos assim, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Jovem Apaixonada"
				},
				{
					"id": 700070203,
					"content": "Mas é claro, ainda que nós fiquemos separados, pensarei em uma maneira de trazer você de volta para meu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Jovem Apaixonado"
				},
				{
					"id": 700070204,
					"content": "A Biblioteca deve ser um local quieto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "Uh? Eu devo controlar minha voz então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Jovem Apaixonada"
				},
				{
					"id": 700070207,
					"content": "Talvez isso seja para atrapalhar o nosso amor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Jovem Apaixonado"
				},
				{
					"id": 700070208,
					"content": "Depois de terminarem de ler o livro, coloquem ele no lugar correto de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Veja essa bagunça. Quem for arrumar as prateleiras terá uma dor de cabeça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "Eu entendo, por favor, nos deixe em paz. Estamos em um momento importante aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Jovem Apaixonado"
				},
				{
					"id": 700070211,
					"content": "Momento importante...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "Não importa quantos empecilhos existam no caminho, você promete nunca mudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Jovem Apaixonada"
				},
				{
					"id": 700070213,
					"content": "Sim, juro pela minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Jovem Apaixonado"
				},
				{
					"id": 700070214,
					"content": "Não precisa desse exagero... Não sei o que seria de mim se eu perdesse você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Jovem Apaixonada"
				},
				{
					"id": 700070215,
					"content": "Ah, você é tão delicada, estou ficando ainda mais apaixonado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Jovem Apaixonado"
				},
				{
					"id": 700070216,
					"content": "Acho que tudo que falamos está entrando por um ouvido e saindo pelo outro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Há pessoas dizendo que vocês estão fazendo muito barulho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
		{
			"id": 7000703,
