						700071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071002,
					"content": "Se ela souber que há pessoas que estão colocando os livros de qualquer jeito nas prateleiras e rasgando páginas, ficará furiosa, não acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071003,
					"content": "Sim, o que podemos fazer? É realmente terrível.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "O que fazer? Se começarmos a arrumar agora, talvez possamos resolver a situação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071005,
					"content": "Não imaginei que vocês pensariam em uma maneira de resolver isso.",
