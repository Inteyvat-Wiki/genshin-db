				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "Uh? Vocês precisam de alguma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Jovem Perdidamente Apaixonada"
				},
				{
					"id": 700070302,
					"content": "A Biblioteca deve ser um local quieto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Desculpe, prestarei mais atenção, mas às vezes não consigo evitar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Jovem Perdidamente Apaixonada"
				},
				{
					"id": 700070305,
					"content": "Por exemplo, enquanto você não prestava atenção, eu tirei essa rosa de uma página do livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Jovem Mágico"
				},
				{
					"id": 700070306,
					"content": "Essa rosa que floresceu no livro é como você, cheia de delicadeza, sabedoria e beleza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Jovem Mágico"
				},
				{
					"id": 700070307,
					"content": "Uh? Que legal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Jovem Perdidamente Apaixonada"
				},
				{
					"id": 700070308,
					"content": "Que barulho! E pare de usar o livro para fazer truques de magia! Vai rasgar as páginas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "Paimon, sua voz também está muito alta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Oh, desculpem a Paimon, se não tomarmos cuidado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "Vocês entenderam, às vezes isso é imprevisível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Jovem Perdidamente Apaixonada"
				},
				{
					"id": 700070312,
					"content": "Vou prestar atenção para controlar minha voz, me desculpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Jovem Perdidamente Apaixonada"
				},
				{
					"id": 700070313,
					"content": "Parece que eles não prestaram atenção em nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070303,
					"content": "Há pessoas dizendo que vocês estão fazendo muito barulho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
		{
			"id": 7000704,
			"completionStepIds": [
				7000704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
