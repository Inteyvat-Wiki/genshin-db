			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jovem Cético",
					"Jovem Cética"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "A sua afirmação \"A mudança emocional pode afetar a precisão da análise das pesquisas\" não está bem fundada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Jovem Cética"
				},
				{
					"id": 700070402,
					"content": "Uh, eu entendo, mas creio ter encontrado um empecilho estranho em minha pesquisa agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Jovem Cético"
				},
				{
					"id": 700070403,
					"content": "Vocês chegaram na hora certa. Eu tenho uma ideia mirabolante que outras pessoas precisam ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Jovem Cético"
				},
				{
					"id": 700070404,
					"content": "Se eu quiser provar que minha teoria está correta, preciso garantir que não tenho oscilações emocionais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Jovem Cético"
				},
				{
					"id": 700070405,
					"content": "Mas eu não consigo fazê-lo, principalmente quando discuto com ela. Não consigo pensar calmamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Jovem Cético"
				},
				{
					"id": 700070406,
					"content": "Também acho um pouco estranho. Será que é por causa de não dormir bem? Ou ter bebido demais ontem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Jovem Cética"
				},
				{
					"id": 700070407,
					"content": "Resumindo, não se pode fazer barulho na biblioteca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "Resumindo, falem mais baixo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Desculpe, mas continuarei persistindo enquanto não descobrir como resolver isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Jovem Cético"
				},
				{
					"id": 700070410,
					"content": "Realmente não entendeu nada do que dissemos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "Você não pode ficar incomodando outras pessoas! Além disso, depois de ler um livro, não pode enfiar ele em uma prateleira desajeitadamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Está bem... Parece que eles não estão prestando atenção em nós...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
