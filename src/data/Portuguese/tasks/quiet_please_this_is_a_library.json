					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "Foi graças a Lisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Se Lisa tivesse visto a situação, ficaria furiosa. Isso aqui é uma Biblioteca, um local onde as pessoas deveriam estudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071009,
					"content": "Finalmente, agora eu posso pesquisar em paz. Obrigada pela ajuda de vocês, aqui está sua recompensa.",
