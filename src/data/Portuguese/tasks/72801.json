			"dialogs": [
				{
					"id": 728010201,
					"content": "#Bem-vind{F#a}{M#o} à Casa de Chá Komore, como posso lhe ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010202,
					"content": "Sobre Ramsay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "Oh, aquele comerciante... Ele está aqui, mas ultimamente tem estado bem estressado. Não sei o que aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010204,
					"content": "Se quiser encontrá-lo, pode entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kozue"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
