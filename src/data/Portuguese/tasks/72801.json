			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "#Você é {F#uma}{M#um} Viajante? Em que posso lhe ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010302,
					"content": "Sobre seu Diário de Viagem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "Oh, você está falando do Diário de Viagem que escrevi para Midori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010304,
					"content": "Estive muito ocupado para continuar a escrevê-los... Ela deve estar ficando ansiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010305,
					"content": "Seus Diários de Viagem são reais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Hahaha, o que você acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010307,
					"content": "Não parecem reais para mim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Hahaha, posso ver que você já viajou muito, percebeu tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010311,
					"content": "Isso mesmo. Na verdade, nada que está nos Diários de Viagem é real.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010312,
					"content": "Apesar de alguns lugares e personagens serem baseados na realidade, a maioria do conteúdo são de minha própria imaginação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010313,
					"content": "Claro, partes dele não são completamente de minha imaginação. Por exemplo, nos diários de viagem que estou escrevendo, alguém fez um super balão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010314,
					"content": "Então ele convocou seus amigos e planejou viajar ao redor Teyvat em seu balão em 80 dias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010315,
					"content": "Além disso, esse balão não necessita de uma Visão para ser operado. Somente algum conhecimento técnico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010316,
					"content": "Essas pessoas viajam ao redor do mundo no balão, e elas encontram várias coisas e fenômenos estranhos ao longo do caminho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010317,
					"content": "Eu estava para escrever isso para Midori. Mas por alguma razão, eu sequer tive o tempo de terminar um parágrafo curto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010318,
					"content": "Qual motivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Você está vendo aquele cara ali no corredor? Ele se chama Heihachi. Não faço ideia de há quanto tempo ele está me encarando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010320,
					"content": "Eu ia sair para procurar por inspiração para meu diário de viagem. Mas aquele cara estava me perseguindo para todo canto. Não sei o que ele quer fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010321,
					"content": "Estou preocupado que ele tenha más intenções para comigo. Eu não me atreveria a sair por aí assim. É por isso que o diário de viagens foi atrasado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010322,
					"content": "Mas, felizmente você está aqui agora. Viajante, você poderia me acompanhar para procurar por inspiração lá fora? Com você aqui, creio que ele não se atreverá a fazer nada contra mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010323,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010327,
					"content": "É como o ditado diz: \"Um deve se guardar contra outros\". Se há alguém me encarando por detrás, eu tenho que me proteger contra ele a todo custo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010328,
					"content": "Por isso, enquanto eu estiver procurando por inspirações, por favor, Viajante, me proteja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010329,
					"content": "Na verdade, eu já tenho alguns locais em mente. Vamos até eles agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010330,
					"content": "O primeiro é próximo da praia. Vamos logo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010325,
					"content": "Por que ele faria isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Eu não sei. Mas pessoas não precisam de uma razão para serem maliciosos com outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010309,
					"content": "Eu espero que sejam de verdade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Hahaha, eu também desejaria que as coisas que escrevi pudessem se tornar realidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				}
			]
		},
