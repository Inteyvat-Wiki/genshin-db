			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "A água nessa praia é cristalina, e a cor da areia é tão branca, é muito diferente do mar aberto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Seria um bom lugar para se zarpar até ele, ou de se zarpar até outro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "*Cof* O cenário aqui é muito bom, deixe-me escrever ele em minhas notas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "Viajante, por favor, espere um momento. Preciso pensar em como escrever meu diário de viagem. Você pode dar uma caminhada e aproveitar a paisagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "Mas, por favor, não se afaste muito de mim. Aquele cara, Heihachi, está me seguindo. Ele está ali perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
