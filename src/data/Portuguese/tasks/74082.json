			"dialogs": [
				{
					"id": 740820101,
					"content": "(A maioria da inscrição foi removida, mas você consegue entender: \"... orvalho claro... canta no Caminho da Floresta Nevoenta...\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Placa de Pedra Entalhada"
				},
				{
					"id": 740820102,
					"content": "Uau! Tantas tiveram as inscrições removidas! Parece que são apresentações para atrações, né? Bah, alguns turistas são tão grossos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Os turistas normalmente apenas escrevem coisas, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Hmm... isso é verdade, como escrever \"{NICKNAME} e Paimon estiveram aqui\" e tal... Não! Espera! Somos boas pessoas, não faríamos isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "Então é estranho, não é? Por que eles arranhariam as palavras? E deixar apenas um pouquinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Até essa sentença foi quase toda arranhada! Paimon aposta que eles não conseguiram tirar tudo! Floresta Nevoenta sortuda, você não foi muito astuta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Então, o que é essa Floresta Nevoenta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Hmm... será que querem dizer que a floresta é super cheia de névoa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Paimon gostaria de dar uma olhada! Sabe, parece o tipo de coisa que levaria a um tesouro secreto, não é? Pelo menos é assim que é nos livros. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "De qual banca você pegou esse livro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Ei! Paimon não só come o dia todo! Paimon tem uma forte sensação de que há um tesouro escondido nessa Floresta Nevoenta, e é por isso que foi escondida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#Esqueça isso, {NICKNAME}! Está na hora da caça ao tesouro, com sua melhor amiga, Paimon, e seus sentidos superdetectores de tesouros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "De qual biblioteca você pegou esse livro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
