			"dialogs": [
				{
					"id": 740820701,
					"content": "Uma pérola brilhante de água aparece no altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "Hmm, aquela gota d'água... Não pode ser um tesouro, pode?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820703,
					"content": "Não parece um tesouro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "Isso que Paimon pensou. Não pode ser tão fácil. Mas o que é, então?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820705,
					"content": "Talvez seja a chave para conter o Rei Demônio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "O quê? Mas isso quer dizer catástrofe! Rápido, devolve. Paimon espera que não seja tarde demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820707,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820708,
					"content": "Oh não! É o Rei Demônio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820709,
					"content": "Rei Demônio? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820715,
					"content": "Você assustou Paimon... Então você é a Melusine... O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820716,
					"content": "Chave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820717,
					"content": "Q-Qual chave? Essa gota de água é a chave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820718,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820719,
					"content": "Hã? Essa gota de água se chama Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820720,
					"content": "Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820721,
					"content": "Ah! O que você quer dizer? Essa gota de água é a Melusine? Paimon está ficando tonta, o que está acontecendo? Você não era a Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820722,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820723,
					"content": "Hmm... você é Pahsiv? Ou você quer dizer que seu nome é Pahsiv? Espera aí! Paimon acha que vai ficar ainda mais confusa com a sua resposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820724,
					"content": "Paimon decidiu chamar você de Pahsiv, tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820725,
					"content": "Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}... O que devemos fazer? Paimon realmente não entende o que ela está tentando dizer, o que será que ela quer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820727,
					"content": "Você consegue entender o que estamos dizendo, não consegue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820729,
					"content": "Essa gota de água é a chave, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820731,
					"content": "Você não é uma pessoa, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820733,
					"content": "Hmm... ofender alguém do nada é uma péssima ideia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820734,
					"content": "Eu não sou uma pessoa, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "M-Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820736,
					"content": "Ah! Espere um minuto, Paimon acha que entendeu um pouco... \"Pahsiv\" significa afirmativo, \"Melusine\" significa negativo, será que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820738,
					"content": "Então você não se chama Pahsiv... Desculpe, Paimon confundiu seu nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820739,
					"content": "Pahsiv... gosta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820740,
					"content": "Você gosta desse nome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820742,
					"content": "#Ótimo! É isso que Paimon vai te chamar, hehe. Ess{F#a}{M#e} é {NICKNAME}. É um prazer conhecer você, Pahsiv. Paimon nunca viu uma Melusine como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820743,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820744,
					"content": "Erinnyes... Melusine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820745,
					"content": "... Você quer dizer Erinn-não? Ou, hã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820746,
					"content": "Algo errado com Erinn-sim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Erinnyes, Melusine, agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820748,
					"content": "Pahsiv, Erinnyes, proteger...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820749,
					"content": "Então, algo ruim está acontecendo com Erinnyes e você quer protegê-la?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820750,
					"content": "#Paimon, {NICKNAME}, Erinnyes, pow, pá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820751,
					"content": "#Err... agora foram quatro palavras. Então... você quer que Paimon e {NICKNAME} dê um soco em Erinnyes? Tipo, POW!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820752,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820753,
					"content": "Você quer que a gente ajude?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820755,
					"content": "Certo, ela quer nossa ajuda. Isso é bom. Paimon não sabia como que daríamos um soco em Erinnyes, considerando que é uma ilha e tal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820756,
					"content": "Pow, pá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820757,
					"content": "A gente vai ganhar recompensas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "Re... compensas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820759,
					"content": "#Oh, qual é {NICKNAME}! Pahsiv mal consegue falar! Ela não vai conseguir encontrar mais ninguém para ajudar ela, a gente devia só fazer isso logo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820760,
					"content": "O que precisamos fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "Chave, chave, chave, número.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820763,
					"content": "E então? Quantas chaves são mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820764,
					"content": "Chave! Chave! Chave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820765,
					"content": "Três chaves?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Pahsiv! Chave, caminho névoa, sul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820767,
					"content": "Chave, nascente, norte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820768,
					"content": "Chave, salgueiro chorão, leste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820769,
					"content": "Oh, é isso que você quer dizer... vamos anotar rapidinho... Três chaves ao todo, uma ao sul pelo caminho nevoento, uma na nascente ao norte, e uma nos salgueiros-chorões ao leste... Paimon está certa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820770,
					"content": "Chave, chave, chave, praça, oeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820771,
					"content": "E existem três chaves na praça ao oeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820772,
					"content": "Coletar três chaves e ir para a praça?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820774,
					"content": "#Ah qual é, Pahsiv, você sempre tem que fazer parecer que {NICKNAME} é mais inteligente do que Paimon? Claramente temos mais ou menos a mesma inteligência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820775,
					"content": "Enfim, já conseguimos uma chave, então tudo que precisamos é ir encontrar as outras duas que sobraram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820776,
					"content": "Erinnyes, Melusine... Pahsiv, proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820777,
					"content": "Relaxa. Paimon não sabe o que aconteceu, mas vamos te ajudar a proteger Erinnyes com toda certeza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820778,
					"content": "Mas se Paimon pudesse adicionar um pequeno ponto, Pahsiv, Paimon gostaria de dizer que se por acaso você vir algo brilhante, redondo e que ninguém quer, ou um baú com aparência cara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820779,
					"content": "Bem, seria maravilhoso se você pudesse nos avisar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv coça sua cabeça conforme ela tenta entender, então dá mais dois pulinhos felizes e sai apressada.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#Oh, ela saiu correndo. Acho que ela deve ter algo urgente para resolver. {NICKNAME}, vamos ir procurar por essas duas chaves?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820761,
					"content": "O que precisamos fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "Talvez outra pessoa tenha colocado aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "#O quê? Ah não, isso faz da gente {M#ladrões}{F#ladras}. Ooh, Paimon se arrependeu... Vamos devolver, rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820712,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820713,
					"content": "Oh não! O chefe voltou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820714,
					"content": "O chefe? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				}
			]
		},
