			"dialogs": [
				{
					"id": 740820401,
					"content": "(A maioria da inscrição foi removida, mas você consegue entender: \"...orvalho claro... três...\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Altar Misterioso"
				},
				{
					"id": 740820402,
					"content": "Urgh! As palavras foram raspadas! Alguém deve tá escondendo algo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "\"Orvalho claro\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "O que o orvalho claro representa? Orvalho cristalino? Tem água pra todo lado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Já a palavra \"três\", representa três gotas d'água? Urgh, que dor de cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Vamos, Paimon, pergunte aos seus sentidos super aguçados de encontrar tesouros!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Paimon já fez isso!...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Enfim, diz que a resposta está conectada a três e água, então vamos procurar por aí!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Três?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Será que representa três coisas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "E quanto ao orvalho claro, será que representa o orvalho cristalino? Tem água pra todo lado! Urgh, que dor de cabeça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
