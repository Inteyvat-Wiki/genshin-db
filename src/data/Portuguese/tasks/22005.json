			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "Oh! Onde está...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "#Uau! De onde você veio? Por que assim tão silencios{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "Eu? Eu sou uma pesquisadora, estou pesquisando a arquitetura antiga e as ruínas das Planícies de Guili. Pode me chamar de Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "Mas estava tão concentrada na minha pesquisa que perdi um pacote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "Aí dentro estão os tesouro... as relíquias históricas. Você pode me ajudar a procurar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Que bom! Deve ser aqui perto... ou talvez um pouco mais longe. Enfim, por favor procure com mais atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "Que tipo de pacote?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "É um pacote comum e quadrado, todo mundo usa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "Mas por que você colocou as relíquias aí dentro? Porque assim é mais conveniente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "Aliás, eu coloquei algumas roupas dentro do pacote também, para protegê-lo do nenhum dano. Por favor, ajude-me a procurá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "Que tipo de relíquias históricas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "De fato, são relíquias bem preciosas. *Suspiro* Você não consegue entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Só os peritos como eu conseguem entender o seu valor! Por favor, encontre o mais rápido possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
