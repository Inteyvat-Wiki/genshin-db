			"dialogs": [
				{
					"id": 230050601,
					"content": "Esta é a Sidra de Maçã do magnata? Bem, há um aroma incrível que limpa a mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Muito bem! Isso é de fato coisa boa. Certamente trará uma mudança para o mercado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "Não vou esquecer da ajuda que me deram! Vamos nos encontrar novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
