			"dialogs": [
				{
					"id": 200160101,
					"content": "Pedir para viagem",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "Viajante! Você chegou na hora certa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Desculpe, sei que você deve estar com fome - mas será que você poderia fazer uma coisa para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "Houve um aumento considerável de pedidos recentemente. Eu estou dividindo por regiões e então colocando etiquetas em cada prato com o mesmo nome da pessoa que pediu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Mas eu perdi a etiqueta desta <color=#00E1FFFF>Sopa de Lótus de Leite e Frutos do Mar</color>. Tudo o que eu sei é que é para alguém do Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Posso pedir um favor que você entregue essa <color=#00E1FFFF>Sopa de Lótus de Leite e Frutos do Mar</color> ao Vale Termal, e depois tenta descobrir quem pediu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Pode ser, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Quando você voltar, você será recompensado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Conto com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Eu apenas vim aqui para comer. Eu estou morrendo de fome!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Quando você fizer o que eu pedir, eu vou preparar um prato especial do Caçador de Cervos para você! Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
