					"nextDialogs": [
						200160204
					]
				},
				{
					"id": 200160204,
					"content": "Deixe-me ver... Sim, tudo certo, obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160205,
					"content": "E esse <color=#00E1FFFF>Caranguejo, Presunto e Vegetais Assados</color>, que acabou de sair do forno, é para você. Coma antes que esfrie.",
					"roleType": "TALK_ROLE_NPC",
