				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "Ai... Por que essa caixa é tão pesada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "Você tá bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "#Nos encontramos novamente, Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}. Sinto muito, minha costas estão feridas, isso dói muito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Eu planejava mover esta caixa para cá e organizar os materiais dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Eu... nunca imaginei que a caixa seria tão pesada e não conseguia ficar firme quando a levantava, e toda a carga foi direto para a minha cintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Agora eu... sinto que minha cintura está quebrada, ai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Quer que eu te leve ao médico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "Não, não precisa... já machuquei a cintura antes, só preciso descansar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Quantos arquivos tem dentro para ela ficar tão pesada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "Deve ter... Bem, uma tonelada de arquivos, afinal, o Instituto já promoveu um estilo de trabalho chamado \"Documente Tudo\" por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "Basicamente, significava que absolutamente cada coisinha no Instituto tinha que ser documentada fisicamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Depois de começarem a promover essa política, o uso de papel do Instituto aumentou em cinco vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "E porque havia tantos documentos, cada escritório foi forçado a criar uma posição de \"gestão de documento\" só para categorizar e organizar toda a documentação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Tudo tinha que ser escrito? Parece muito chato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Era sim! Depois, esse estilo gradualmente ficou para trás e só foi implementado de maneira limitada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "#Mas não vamos discutir isso agora... Pesquisador{F#a} Sênior {M#Honorário}{F#Honorária}, pode me ajudar a lidar com essa caixa de arquivos? Apesar de minha cintura estar machucada, eu ainda preciso organizar os arquivos dentro dela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Só se recupere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Não precisa se preocupar, só preciso das minhas mãos para organizar documentos, não vou machucar minha cintura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Posso chamar alguém para você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
