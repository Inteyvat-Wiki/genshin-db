					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Hahaha, claro que não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402008,
					"content": "Mais ou menos, mas ainda não encontrei nenhuma pista da minha mãe...",
