			"dialogs": [
				{
					"id": 721401701,
					"content": "#Olá, {NICKNAME}, como você tem estado?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401703,
					"content": "A Paimon roubou minhas palavras!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "Estou bem, e você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401705,
					"content": "Paimon, você quer uma refeição extra, não é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "#Haha, você é muito lent{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401707,
					"content": "Quero dizer, você é a refeição extra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "Claro, eu quero todos os dias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401708,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401709,
					"content": "Pff, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401710,
					"content": "Está bem ,está bem, parem de brigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401712,
					"content": "Diga, o que é?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "Verei o que posso fazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "Estou bem, mas gostaria de lhe pedir um outro favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401714,
					"content": "#Bem, não é nada demais. Eu só preciso de sua ajuda para me trazer mais alguns cristais, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401716,
					"content": "Eu acredito em você, mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "#Acredite em mim, vou recompensá-l{M#o}{F#a} por sua ajuda... Contanto que você confie em mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401718,
					"content": "Por quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "Você prometeu me dar uma explicação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "Mas...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401720,
					"content": "Sim. Nós ainda não sabemos porque você precisa de tanta Medula de Cristal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401722,
					"content": "Mas o Shogunato monopolizou o mercado de cristal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "Você sabe que o cristal não é fácil de vender, não sabe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "Bem... preciso de dinheiro para viajar e encontrar minha mãe. Posso trocar o minério por dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401725,
					"content": "Você está fazendo algo muito perigoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "#Estou preocupad{M#o}{F#a} com sua segurança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "Eu sei, eu vou procurar o meu próprio caminho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401727,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401728,
					"content": "Chouji, somos amigos, não somos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401729,
					"content": "Talvez dessa vez, possamos lhe ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401731,
					"content": "Que filosofia filistina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "Além disso, você prometeu que nos recompensaria. Portanto, temos o direito de saber sobre coisas que podem colocar você em perigo e afetar nossa recompensa, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401732,
					"content": "Pff... A Paimon está certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401733,
					"content": "Eu não coleto cristais apenas por dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401734,
					"content": "Tenho pensado... No caso de mamãe e papai pegarem a doença causada pelo Tatarigami como todo mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401735,
					"content": "Talvez esses cristais possam ser usados na medicina. Porque eles cresceram dos ossos da serpente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401736,
					"content": "E Matsumoto mencionou que estes cristais podem ser úteis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401737,
					"content": "Mas você não tem certeza dessa hipótese, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401738,
					"content": "Talvez não, mas também não temos outra hipótese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401739,
					"content": "Quando eu encontrar minha mãe... ou talvez até meu pai, vou levá-los para Sumeru. As pessoas disseram que têm a cura para essa estranha doença.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401740,
					"content": "Mas antes disso, não posso perder a esperança de encontrar um tratamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401742,
					"content": "Você precisa mesmo perguntar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "Espero que você possa fazer bom uso dos cristais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "Bem, eu já disse o suficiente. Você gostaria de me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401744,
					"content": "Obrigado, eu não esquecerei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
