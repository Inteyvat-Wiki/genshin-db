					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "\"Preciso deles com urgência, buááá...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402007,
					"content": "Como está indo sua viagem?",
