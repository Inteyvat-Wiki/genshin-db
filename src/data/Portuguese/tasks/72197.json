						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Há quanto tempo! Como está o mundo fora da Ilha Yashiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "É muito mais rico do que minha cidade natal. Eles têm muita comida boa e coisas divertidas para fazer. Mas... eu não gosto muito disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Oh? Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "As pessoas parecem ter perdido alguma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Quando morávamos na Ilha Yashiori, Vossa Excelência era uma presença distante, mas calmante para nós ... Não nos importávamos onde ela estava, mas acreditávamos que ela estava ali, nos observando, nos protegendo, decidindo como deveríamos viver nossas vidas e que tipo de pessoas devemos nos tornar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Mas aqui, Vossa Excelência cobre tudo e oprime tudo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "Bem, eu não sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "Ainda estamos tentando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "A propósito, você descobriu alguma coisa sobre minha mãe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
