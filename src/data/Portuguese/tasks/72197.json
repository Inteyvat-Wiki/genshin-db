			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME}, você voltou! Você trouxe algum cristal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721971802,
					"content": "Sim, eu trouxe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "Eles estão a caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "Não tenha pressa, você pode descansar aqui.",
					"roleType": "TALK_ROLE_NPC",
