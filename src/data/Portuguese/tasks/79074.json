					}
				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "#Ah, mais {M#dois guerreiros}{F#duas guerreiras} surgem para o desafio! Estão aqui para jogar Explosão Boreal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Venham, então, por aqui! Estou ansioso para testemunhar seus poderes incomparáveis de voo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "Eita, calma aí!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "#Não é necessário manter a calma para voar, {M#querido convidado}{F#querida convidada}, nem um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Uma cabeça calma vai apenas embaçar seu sentido do vento — apenas aquele que enfrenta o vento selvagem totalmente despreparado pode descobrir seu verdadeiro potencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Esquilos voadores hoje em dia são muito tímidos! Eles esqueceram completamente as lições ensinadas pelo \"Vento Corajoso do Norte\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Eles ficam em locais seguros e declamam a coragem das folhas que dançam no vento, porém, estão amedrontados demais para se jogar no seu abraço por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Como pode proteger o reino junto de Vossa Alteza se as coisas continuarem dessa forma? Um absurdo! Absurdo, eu disse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Caramba, esse esquilo voador certamente é do tipo energético...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Parece que ele realmente adora voar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "E é por isso que encontrei uma passagem para mim com uma corrente de vento especialmente intensa, e montei todo tipo de dispositivos dentro dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Somente os mais corajosos, os mais ousados e os mais beligerantes ao voar serão os melhores neste percurso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "#Vocês possuem a coragem necessária, {M#queridos convidados}{F#queridas convidadas}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Eu adoraria experimentar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Excelente! Então, siga-me! A passagem não está longe daqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Bem... Tenho outras coisas para fazer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Oh? Então, ainda precisa de um tempo para se preparar? Não tema, esperarei aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Volte a qualquer momento que quiser enfrentar essa passagem de vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Eu não disse nada ainda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}