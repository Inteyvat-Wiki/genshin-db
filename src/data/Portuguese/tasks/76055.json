				},
				{
					"id": 760550304,
					"content": "(Hã? Por que você não tá girando a roleta? Vai lá, gira. Comida boa aguarda!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550305
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550305,
					"content": "Um cachorrinho...? Você está pedindo para eu girar a sua roda por você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550306
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760550306,
					"content": "(Olá, visitantes! Podem falar comigo! Mas, por favor, girem a roda, ou eu não terei nada de delicioso para comer!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550307
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550307,
					"content": "Você está com fome? Acabei de comprar alguns lanches. Aqui, pegue um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550308
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760550308,
					"content": "(Hã? Você não tá girando a roleta, mas quer me dar comida... Hmm, tá bom. Vou comer um pouco primeiro. Por que não?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550309
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550309,
					"content": "(Obrigado, visitante. Pavlov é o meu nome, e obrigado pela comida! Estava deli-ciosa! Mas ainda assim, você não girou a roda.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550310
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550310,
					"content": "Esses lanches são bem bons. Mas... essa roda de que você falou... o que exatamente ela faz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550311
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760550311,
					"content": "(Se a roleta for girada, então parada, comida boa vai aparecer. Sempre foi assim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550312
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550312,
					"content": "(Você não vai girar a roleta, caro cliente? Todos ficam felizes depois de girar a roleta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550313
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550313,
					"content": "Se eu girar a roda... você vai ficar feliz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550314
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760550314,
					"content": "(Claro, claro! As pessoas brincam comigo, a roda brinca comigo, e tem comida boa... a comida é a melhor parte!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550315
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550315,
					"content": "Entendo... Sim, boa comida é importante. Aqui, pegue o resto também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550316
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760550316,
					"content": "Preciso comprar mais. Até mais, Pavlov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550317
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760550317,
					"content": "(Hmm... nham, nham! Adeus, visitante! Volte sempre!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
