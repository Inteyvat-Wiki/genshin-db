			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Lauma</color> parece ter ouvido algo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "...Estranho. Tenho certeza que acabei de ouvir algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(Ah, clientes! Venham, venham! Girem a roleta, então parem a roleta, daí haverá boa comida!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Hã? Por que você não tá girando a roleta? Vai lá, gira. Comida boa aguarda!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "Isso parece... um filhotinho de cachorro? Gire a roleta para comida boa... O que isso significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Olá, clientes! Vocês podem falar comigo! Bem, por favor, girem a roleta, senão não vou ter nada delicioso para comer!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "Então você tá com fome? Trouxe uns biscoitos. Aqui, coma um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Hã? Você não tá girando a roleta, mas quer me dar comida... Hmm, tá bom. Vou comer um pouco primeiro. Por que não?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Gratidão, cliente. Meu nome é Pavlov, agradeço o biscoito. Estava delicioso! Mesmo assim, você não girou a roleta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Não há de quê... Mas se eu puder perguntar, o que você quer dizer com \"gire a roleta\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Se a roleta for girada, então parada, comida boa vai aparecer. Sempre foi assim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "#(Você não vai girar a roleta, car{M#o}{F#a} cliente? Todos ficam felizes depois de girar a roleta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Acho que não vou. Parece... que você tá vivendo bem aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Claro, claro! As pessoas brincam comigo, a roleta brinca comigo e tem comida boa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Então tá tudo bem. Dê oi ao seu tutor por mim. Vou embora agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Aah... Tchau, cliente! Volte sempre!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
