			},
			"dialogs": [
				{
					"id": 722391901,
					"content": "Após o sol, a escuridão começa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391902
					]
				},
				{
					"id": 722391902,
					"content": "Mas a verdadeira luz se esconde em nossos corações...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391903
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391903,
					"content": "...Faz tanto tempo que não ouço essa frase que quase a esqueci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391904
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391904,
					"content": "Diga-me, camarada, quem lhe enviou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "O Mestre Spartacus?! O Mestre lhe enviou?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Onde ele está?! Eu somente sabia que ele foi capturado durante a revolta pelos lacaios do Filho do Sol! Perdemos todo contato com ele após isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "Ele está trancafiado no altar no Coração da Serpente, e a julgar pela situação atual, ele não tem como sair. É por isso que ele nos enviou para procurar por vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Aquele maldito Filho do Sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Quais instruções o Mestre lhe deu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391911
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391911,
					"content": "Ele apenas pediu para lhe transmitir uma mensagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391912,
					"content": "\"Crianças, nunca desistam. A esperança do Reino de Byakuya vive entre vocês\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391914
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391914,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391915
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391915,
					"content": "Me... me desculpe! Mestre, nós falhamos com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391916
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391916,
					"content": "O que houve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391917
					]
				},
				{
					"id": 722391917,
					"content": "A resistência já não existe mais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391918
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391918,
					"content": "Hã?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391919,
					"content": "Após o mestre ter sido capturado, a coluna vertebral da resistência colapsou completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391920
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391920,
					"content": "Apenas nós, os estudantes que o seguiam comumente escaparam, graças a estarmos longe do centro dos eventos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391921
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391921,
					"content": "Após isso, aqueles de nós que tiveram sorte de escapar fugiram para nossos esconderijos predefinidos na esperança de recuperarmos nossa força.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391922
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391922,
					"content": "Nós temos estrategistas excelentes, eruditos profissionais, místicos habilidosos, bem como médicos confiáveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391923
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391923,
					"content": "Uau, isso parece promissor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391924,
					"content": "Isso também era o que pensávamos. Com o tempo, acreditávamos que seríamos capazes de revitalizar o movimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391925
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391925,
					"content": "Mas todas essas coisas precisam de fundos... E nós não temos nada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391926
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391926,
					"content": "Até que finalmente, alguém sugeriu que vendêssemos Pérolas Osso de Dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391927
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391927,
					"content": "O que é uma Pérola Osso de Dragão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391928
					]
				},
				{
					"id": 722391928,
					"content": "É um fruto maravilhoso que as Flores Osso de Dragão produzem sob circunstâncias especiais, é extremamente raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391929
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391929,
					"content": "Sua fragrância pode relaxar a mente e acalmar os pensamentos ansiosos, varrendo todas as preocupações de alguém. Como tal, ela pode ter um preço muito alto no mercado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391930
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391930,
					"content": "É realmente tão místico assim? Você tem certeza que isso não é um golpe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391931,
					"content": "Oh, queria eu que fosse tudo uma mentira... Ingênuo como eu era, não percebi seus perigos pelo caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391932
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391932,
					"content": "Eu não sei de onde a fórmula saiu, mas sei que ela nos rendeu muito capital.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391933
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391933,
					"content": "Tudo estava indo tão bem... Mas logo descobrimos que alguns de nossos camaradas de repente começaram a evitar conflitos e a rejeitar a ideia de ir para a batalha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391934
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391934,
					"content": "O número dessas pessoas aumentava todos os dias, a ponto de pedir para deixar nossas posições. Não consegui detê-los...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391935
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391935,
					"content": "Como isso aconteceu? Será que isso aconteceu por conta das pérolas renderem tanto dinheiro que a maioria das pessoas perdeu a vontade de lutar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391948,
					"content": "Você quer dizer a sedução corruptora do dinheiro? Não... eu.... eu não sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391949
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391949,
					"content": "Eu só sei que quando pessoas oprimidas ficam satisfeitas com suas vidas, eles deixam de resistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391936
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391936,
					"content": "Foi aí que nosso colapso começou, e quando isso aconteceu, não conseguimos mais o parar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391947
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391947,
					"content": "Às vezes, me pergunto se essa fórmula não foi vazada para nós por esses tiranos desprezíveis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391950
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391950,
					"content": "Às vezes me pergunto se o valor dessas pérolas não foi tudo uma falsa pretensão criada por aqueles governantes desprezíveis...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391937
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391937,
					"content": "*Suspiro* Se o Mestre estivesse aqui, tenho certeza que ele seria capaz de controlar a situação. Talvez ele até mesmo teria cortado esse problema pela raiz desde o início.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391938
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391938,
					"content": "Me desculpe, Mestre, nós não pudemos virar a esperança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391939,
						722391940
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391939,
					"content": "Sinto muito por ouvir isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391941
					]
				},
				{
					"id": 722391941,
					"content": "Eu não posso encará-lo assim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391942
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391942,
					"content": "Entretanto, te agradeço por ter trazido notícias dele para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391943
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391943,
					"content": "Não tenho mais nada com que lhe agradecer, então, se não se importar, permita-me compartilhar o segredo da Pérola Osso de Dragão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391944
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391944,
					"content": "Elas só podem ser criadas usando as águas de Tokoyo Reisen, isto é, Águas de Lethe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391945
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391945,
					"content": "Talvez você consiga trocá-lo por algum dinheiro, ou guardá-lo para si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391946
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391946,
					"content": "Mesmo assim, tenha cuidado. Mantenha seu desejo de seguir adiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391940,
					"content": "Você deseja ver o seu mestre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391950
					]
				}
			]
		},
		{
			"id": 7223924,
			"completionStepIds": [
				7223903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722392401,
					"content": "(Há duas linhas de texto sobre esta lápide. A primeira linha está na língua do Reino de Byakuya e é ininteligível.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392402
					],
					"speakerTitle": "Placa de Pedra Antiga"
				},
				{
					"id": 722392402,
					"content": "(A segunda linha é uma escritura comum, e diz o seguinte:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392403
					],
					"speakerTitle": "Placa de Pedra Antiga"
				},
				{
					"id": 722392403,
					"content": "\"Aqui jaz Spartacus, o Justo, conhecido agora como Supada no Hiko. Embaixo está localizada uma lista de seus crimes. Leia-os e lembre-se de nossa história.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722392404
					],
					"speakerTitle": "Placa de Pedra Antiga"
				},
				{
					"id": 722392404,
					"content": "\"Supada no Hiko, o notório fora-da-lei, mestre dos grandes crimes, e a raiz da agitação. Agora, em nome de Tokoyo Ookami, que sua visão seja arrancada, e que sua alma seja esmagada. Que ele seja jogado em uma prisão profunda, agora e para sempre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Placa de Pedra Antiga"
				}
			]
		}
	]
}