			},
			"dialogs": [
				{
					"id": 722391301,
					"content": "Uuh, tem aqui uns nomes escritos: \"O Bandido, Supada no Hiko\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391302,
					"content": "Oh, não... Deveria ser apenas \"Supada no Hiko\". É esse o nome daquele cara! Vamos voltar e contar para ele, rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
