			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390101,
					"content": "Crianças, nunca desistam. A esperança está entre vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390102
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390102,
					"content": "Crianças, são vocês? Vocês tiveram sucesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390103
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390103,
					"content": "Não... Posso sentir, vocês não são...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390104
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390104,
					"content": "#{NICKNAME}, essa pessoa parece ter ficado cega antes de se tornar uma sombra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390105,
					"content": "Quem quer que você seja, por favor, pode me ajudar? Ajude-me a encontrar minhas crianças! Tenho algo a dizer para elas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390106
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390106,
					"content": "Mas, quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390107
					]
				},
				{
					"id": 722390107,
					"content": "Eu... Eu sou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390108
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390108,
					"content": "Eu... Esqueci meu nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390109
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390109,
					"content": "Eu só me lembro... Só me lembro que uma vez defendi o Reino de Byakuya e lutei pela paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390110
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390110,
					"content": "Até hoje, eu sou um membro da resistência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390111
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390111,
					"content": "Mas o que você estaria resistindo aqui embaixo no Reino de Byakuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390112,
					"content": "Aqueles nojentos e desprezíveis nobres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390113
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390113,
					"content": "Eles alegam terem recebido alguma ordem divina, e erguem a bandeira dos deuses, mas no fundo eles apenas querem saciar seus sujos desejos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390114
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390114,
					"content": "Aparentemente, eles são os guardas do Filho do Sol. Mas na verdade, são os governantes da nação — são vermes parasitas que sugam o sangue do povo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390115
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390115,
					"content": "Eles devem ser destruídos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390116
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390116,
					"content": "Você lembra disso muito bem, mas sequer lembra do seu nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390117,
					"content": "Isso só serve para mostrar quão cruéis os métodos deles são!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390118
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390118,
					"content": "Eu fui capturado após o nosso fracasso anterior, e então fui preso aqui neste altar e torturado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390119
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390119,
					"content": "Essa prisão é uma coisa maligna. Posso sentir minha alma ser destruída, e minhas coisas mais valiosas extirpadas de mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390120
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390120,
					"content": "Por favor, nobre alma, te imploro! Enquanto eu lembrar, me ajude a encontrar minhas crianças!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390121
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390121,
					"content": "Diga a elas para nunca desistirem, pois a esperança vive entre elas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390122
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390122,
					"content": "Suas crianças?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390123
					]
				},
				{
					"id": 722390123,
					"content": "Há um grupo de jovens promissores que me seguem de livre e espontânea vontade. São meus estudantes, e nossa força reserva. Vejo eles como se fossem meus próprios filhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390124
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390124,
					"content": "Essas pessoas más no topo fizeram de tudo para que eu abrisse minha boca e desistisse desses meus filhos, mas eu não fiz isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390125
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390125,
					"content": "Porque eu sei que, no fundo, a esperança reside entre eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390126
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390126,
					"content": "Eles provavelmente já foram embora a essa altura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390127,
					"content": "Não, nunca! Eles são todos boas crianças. Com certeza manterão nossos ideais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390128
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390128,
					"content": "Eu não desisti... E tenho certeza que eles também não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390129
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390129,
					"content": "Como os encontraremos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390130
					]
				},
				{
					"id": 722390130,
					"content": "Eu lembro disso. Eu com certeza lembro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390131
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390131,
					"content": "Deixe-me lhe contar onde eles estão se escondendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390132
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390132,
					"content": "Mas se nós os encontrarmos, como nos explicaremos para eles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390133,
					"content": "\"Nós viemos aqui porque um integrante da resistência que esqueceu seu nome nos disse para vir\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390134,
					"content": "Não, isso não será suficiente. Eu os ensinei bem. A não ser que vocês provem suas identidades, eles não confiarão em vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390135
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390135,
					"content": "Mas eu sequer consigo lembrar meu próprio nome... Maldição!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390136
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390136,
					"content": "#{NICKNAME}, esse cara daqui parece que já foi um criminoso procurado no Reino de Byakuya. Daquele tipo que você escreveria nos livros de história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390137,
					"content": "Paimon acha que não deve ser muito difícil para encontrarmos alguma informação sobre ele. Talvez encontremos algo aqui perto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390138,
					"content": "Se a história lembrar de meu nome, espero que ela seja escrita por aqueles que herdem nossos valores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				}
			]
		},
