			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220101,
					"content": "Monte Tianheng... Mestre dos Céus Transcendentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220102,
					"content": "No que você está pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220103
					]
				},
				{
					"id": 718220103,
					"content": "Ah, estou atualmente pesquisando a história e as lendas do Ritual de Lanternas de Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220104,
					"content": "Ouvi dizer que a Lanterna Mingxiao deste ano foi modelada baseada na imagem de Adeptus chamado Mestre dos Céus Transcendentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220105,
					"content": "Pelo que pude colher das lendas, este Adeptus também lutou ao lado de Rex Lapis por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220106,
					"content": "Os tempos exatos e os inimigos que enfrentaram foram diferentes de texto para texto antigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220107,
					"content": "Mas todas as fontes concordam que o Mestre dos Céus Transcendentes já faleceu, e foi declarado que este Adeptus uma vez segurou o Monte Tianheng com seus próprios chifres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220108,
					"content": "Foi por isso que vim ao Monte Tianheng para ver por mim mesma, pensando que se eu tivesse sorte, talvez poderia encontrar algo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220109,
					"content": "Mas, ao que parece, o Monte Tianheng está repleto de monstros. Depois de verificar o local para minhas investigações, descobri que estava tão cheio de monstros que ficou intransitável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220110,
					"content": "#Viajante, se você estiver dispost{M#o}{F#a}, você poderia me ajudar a investigar e recolher algumas amostras de solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220111,
					"content": "Amostras... De solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220112
					]
				},
				{
					"id": 718220112,
					"content": "Bem, isso é o que nós dizíamos na Academia, mas o que realmente queremos dizer é algum solo da área em questão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220113,
					"content": "Lendas locais afirmam que o Mestre dos Céus Transcendentes segurou o Monte Tianheng com seus próprios chifres...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220114,
					"content": "De um ponto de vista acadêmico, é evidente que o terreno aqui pode ter uma composição incomum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 718220115,
					"content": "Então, por favor, ajude-me a ir até lá e a recolher uma amostra de solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 7182202,
