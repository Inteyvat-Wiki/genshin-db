						220150602
					]
				},
				{
					"id": 220150602,
					"content": "Liyue não precisa tanto de detetives. Também ouvi falar da importância que dão a contratos por lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150603,
					"content": "Além disso, não importa quão grande ou pequeno seja o problema, eles são rapidamente resolvidos pelos Millelith...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150604,
					"content": "Mesmo que exista uma agência de detetives por lá, creio que seus negócios fossem a falência rapidamente por não ter demanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
