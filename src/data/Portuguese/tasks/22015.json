					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Mondstadt? Oh, você está falando dessa cidade? Já ouvi falar dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "As especialidades mais famosas de lá são vinho e liberdade, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Hahaha, essas especialidades realmente se complementam... Se existem detetives em Mondstadt, com certeza o negócio deles deve ser próspero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
