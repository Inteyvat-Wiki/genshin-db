				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "A hora está quase chegando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150102,
					"content": "#Oh, bem-vind{F#as}{M#os}. Você está com algum problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150103,
					"content": "Entendo... Vocês não encontraram problema algum, só estão dando uma olhada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150104,
					"content": "Esta aqui é a Agência de Detetive Bantan Sango. É um lugar bem comum, e eu... Bem, sou uma detetive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150105,
					"content": "Quem é você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "Meu nome é Sango. Sou a diretora desta Agência de Detetives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150107,
					"content": "Mas, apesar de sermos uma agência, só temos dois membros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150113,
					"content": "Bem, essa é sua primeira vez aqui na Agência de Detetives?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150108,
					"content": "O que detetives fazem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "Uh, isso é uma boa pergunta... Do ponto de vista das pessoas comuns, ser um detetive é uma profissão particularmente misteriosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150110,
					"content": "Mas para mim, ser uma detetive é só uma profissão comum de se ganhar dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150111,
					"content": "Apesar do meu trabalho às vezes não envolver coisas tão ordinárias, e meus clientes serem um pouco especiais...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150112,
					"content": "Mas, no final, continua sendo uma forma de ganhar dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
