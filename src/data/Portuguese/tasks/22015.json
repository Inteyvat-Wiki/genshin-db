					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "#Pela sua aparência, você parece interessad{F#a}{M#o} na Agência de Detetives, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "#Também posso ser {F#uma}{M#um} detetive?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "#Você quer ser {F#uma}{M#um} detetive? Isso é muito difícil, não é como nos livros de ficção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "Durante a investigação de um caso, não há uma perseguição eletrizante, e também não há momentos decisivos de vida ou morte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Na verdade, é um trabalho que se entra em salas empoeiradas cheias de pergaminhos, ou caminha-se por estradas lamacentas de montanhas na busca de um suspeito... Isso é o que o verdadeiro trabalho de um detetive se parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Mas, você não vai entender se eu ficar falando desse jeito... Por puro acaso, tenho aqui um pequeno caso. Por que você não lida com ele pessoalmente? Talvez assim possa entender o trabalho de um detetive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Meu assistente, Ryuuji, saiu pouco tempo atrás para procurar algumas pistas, e não voltou até agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "Ele já deve ter encontrado pistas suficientes a essa hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "Gostaria que você fosse até Ryuuji e trouxesse ele de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "Será que ele encontrou algo de perigoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Eu já expliquei tudo para ele. Ainda que tenha encontrado algo de errado, ele deve ser capaz de resolver sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "O que estou mais preocupada é se ele consegue encontrar o que quero facilmente ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Bem, obrigada pela sua ajuda. Eu lhe prepararei uma boa recompensa e assim você poderá entender pessoalmente o trabalho de um detetive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "Será que ele sofreu algum acidente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Que acidente poderia acontecer? Já expliquei tudo para ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "Ainda que ele tenha encontrado algo inesperado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "Ele deve ser capaz de resolver sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "O que estou mais preocupada é se ele consegue encontrar o que quero facilmente ou não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "Parece bem problemático...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Claro que sim. Mas o trabalho de um detetive são para pessoas especialistas em lidar com problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "Perseguições eletrizantes, momentos decisivos de vida ou morte... Isso são cenas que só acontecem nos livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "Na verdade, é um trabalho que se entra em salas empoeiradas cheias de pergaminhos, ou caminha-se por estradas lamacentas de montanhas na busca de um suspeito... Isso é o que o verdadeiro trabalho de um detetive se parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "Mas há coisas que essas histórias escreveram corretamente. Por exemplo, todo detetive possui seu assistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "Então você também tem um assistente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "Claro que tenho. No momento, meu assistente está ocupado, e por isso, eu preciso de outro assistente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "O que acha de me ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				}
			]
		},
