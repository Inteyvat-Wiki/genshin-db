			"dialogs": [
				{
					"id": 220150701,
					"content": "Bem, eu conheci uma Consultora Jurídica lá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "Consultora Jurídica? Ah, já ouvi falar nisso. São pessoas difíceis de se lidar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "Essas pessoas são especialistas em pegar problemas simples e complicarem eles, pegar o que está complicado para ser formalizado, e então os transformar em um contrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
					"content": "Se possível, nunca quero conhecer uma pessoa assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
