			"dialogs": [
				{
					"id": 741560401,
					"content": "Paimon tá tão nervosa! Baseado no que aquele bilhete disse, a gente só deveria precisar esperar por ele aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Então a gente espera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Ok, é contigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "Após esperar silenciosa e pacientemente por um tempo, a janela abre com um rangido e um rosto familiar aparece. Benoit olha o ambiente cuidadosamente e após ver vocês lá, sai dela.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoit, o que é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Rápido, rápido! Se eu for descoberto, vai tá tudo acabado para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "Tenho algumas perguntas para ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
