					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Deixa eles cuidarem disso. Não vou interferir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Oh, minha querida Autumn, você quer mesmo fazer isso comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "Que criança no Fleuve Cendre teve sorte como você? Os doces que come, seus vestidos de seda, os romances que adora, tudo isso requer dinheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "Enquanto outros persistiram à fome e ao frio, você estava vestindo colares nos seus cães de estimação e usando vestidos bonitos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "Eu conquistei essa vida para você, não acha que devia me retribuir? Se você não pagar o preço, como espera que eu colha as recompensas? Uma carona grátis não existe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "Eu sou cruel com você? Eu fui generoso suficiente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Autumn, pense com cuidado. Que parte da sua vida eu não te preparei cuidadosamente para? Toda vez que você desviou do caminho e teve azar, foi por suas decisões.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Benoit aqui é simplesmente incrível em distorcer palavras até que a própria lógica seja completamente invertida. Proclamar generosidade e bondade enquanto busca apenas seus próprios objetivos egoístas. No fim, é tudo sobre ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561109,
					"content": "Sua tão chamada bondade foi apenas uma tentativa de me engordar como um cordeiro para o abate. Me poupe das mentiras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "A extensão da minha pena e compaixão por você agora é para te livrar dessa dor. Mas antes disso, me conte, onde está minha filha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Seja na casa antiga ou na casa que você vive agora, não há um rastro do paradeiro dela. Aonde foi que você a mandou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Se eu disser, você me deixa ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "Não, mas eu deixo você morrer menos dolorosamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "...Se eu não te contar, eu morro. Se eu te contar, eu morro também. Hehe, se não vou ganhar nada, então por que eu facilitaria as coisas para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "*Suspiro*... Autumn, você nunca conta uma mentira mesmo, né? Agora nunca vamos descobrir para onde ela foi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561116,
					"content": "Eu sei onde ela está, hehe! Mas eu não vou contar a vocês, não, eu nunca vou contar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "Vocês nunca vão encontrá-la, vocês nunca, jamais vão encontrá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "Eu vou levar ele daqui. Vou levar ele de volta à casa dele, vocês têm alguma objeção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Por favor. A gente não vai interferir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "V-Vocês podem cuidar disso. Não é da nossa conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit continua repetindo as palavras \"Vocês nunca, jamais vão encontrá-la\" sem parar enquanto a silenciosa Autumn o leva embora.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Eu não estava planejando deixar mais ninguém saber disso. Afinal, ela tem um mandado de prisão em seu nome. É provavelmente importante mencionar que eu também sou sujeito a tal mandado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561123,
					"content": "Se vocês forem à Maison Gardiennage agora e prestarem uma queixa, devem conseguir uma boa quantia de grana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561124,
					"content": "Mas eu recomendaria que não fizessem isso. Se fizerem, nossos amigos não esquecerão. Sintam-se à vontade para tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561125,
					"content": "Não vou denunciar nada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, foi o que pensei que diria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561128,
					"content": "Então aqui, esta Rosa Arco-Íris é para você. A gente gosta desse tipo de flor porque é rica em simbolismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561129,
					"content": "Nesse momento, ela simboliza um aviso. Um aviso para não mudar de ideia do que acabou de falar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561130,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Atos"
				},
				{
					"id": 741561131,
					"content": "Então... Foi isso que aconteceu. Que família complicada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon não sabe o que dizer disso tudo! É bom que a gente não denunciou nada à Maison Gardiennage antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Mas Paimon se sente mal por Autumn, ela nunca conseguiu encontrar a filha no fim de tudo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "No começo, Paimon achava que Benoit era um cara legal também! Hmm... Você acha que é fácil enganar Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "Você só tá percebendo isso agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "Ei! Você tá indo longe demais! Zombar de Paimon em um momento assim... Hunf! Paimon não vai te perdoar a não ser que pague um jantarzão para ela no Hotel Debord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Os neurônios de Paimon são tão solitários.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Não preciso do dinheiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
