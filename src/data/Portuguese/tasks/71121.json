			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "#Por favor, me poupem, magnânim{F#as heroínas}{M#os heróis}... espera, são vocês?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711210302,
					"content": "Você?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Hehe, que coincidência, né? Hehehe, por que vocês não voltam a fazer o que estavam fazendo? Com sua licença...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711210304,
					"content": "Sugiro você dar uma olhada no que eles deixaram de valor para trás. Oh, não se preocupem comigo, já fiz notas de tudo... vou devolver tudo que precisa ser devolvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711210305,
					"content": "Espere...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Não precisa, afinal, com certeza nos encontraremos novamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Comerciante Estranho"
				}
			]
		},
