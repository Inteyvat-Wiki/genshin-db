			"dialogs": [
				{
					"id": 711210201,
					"content": "Muito obrigado, muito mesmo! Se não fossem vocês, todo o lote de mercadorias teria sido perdido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711210202,
					"content": "Não tenho muita Mora comigo, mas por favor, fique com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711210203,
					"content": "Uau, você é muito gentil!",
