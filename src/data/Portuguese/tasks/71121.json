			"dialogs": [
				{
					"id": 711215101,
					"content": "#G-Grande {M#cavaleiro}{F#cavaleira}! Tenha piedade! Eu não estou com eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711215102,
					"content": "E quem é você!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Eu!? Eu sou... Hmm... É uma longa história...? Eles roubaram algumas coisas, e meu mestre me pediu para registrá-las e devolvê-las, só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711215104,
					"content": "Bem, já que você espantou todos os ladrões e meu trabalho aqui está feito, vou dar o fora agora, se você não se importar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Comerciante Estranho"
				},
				{
					"id": 711215105,
					"content": "Um momento...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "Não precisa, afinal, com certeza nos encontraremos novamente!",
					"roleType": "TALK_ROLE_NPC",
