					}
				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Não faz sentido... como que você fez isso?! Minha... minha reputação foi destruída!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "Foi uma honra batalhar com você, bom senhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665003,
					"content": "Mas o que... Que educada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Haha! Estava ocupado perdendo enquanto a gente tava fora, J{RUBY#[D]Verdadeiro Rei das Batalhas de Besouros}oga-boi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Eu não vejo assim. Exceto caso o Verdadeiro Rei das Batalhas de Besouros esteja pronto para desistir agora, ele ainda não perdeu para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665006,
					"content": "Na batalha e na vida, é normal encontrar barreiras ocasionalmente. Mas uma barreira só se torna em uma falha se você decidir parar de tentar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665007,
					"content": "Pode crer! Mandou bem! Não tô pra admitir a derrota ainda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Mesmo assim, não há nada a ser ganho em dar desculpas constantemente. Não coloque toda sua energia em falar besteira — gaste ela lutando um pouco mais duro ao invés disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665009,
					"content": "Eita, que fora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "#Rei Oni, esse tipo de inimigo não parece sua área de especialidade. Eu aconselho que você envie {M#outro de seus generais}{F#outra de suas generais} e observe o duelo em detalhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716665011,
					"content": "Assistir outros batalharem também é uma parte crucial do treinamento de um guerreiro. Algumas habilidades se aprendem fazendo. Outras se aprendem observando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Grande Mestre Hanakado"
				},
				{
					"id": 716665012,
					"content": "#Tem razão, Grande Mestre! E que momento foi esse, hein, {M#meu consagrado}{F#minha consagrada}! Mão Direita do Rei Oni, estou passando a luta para você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Haha! Finalmente é nossa vez! Faça valer, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Hehe! Mamão com açúcar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Então eu vou enfrentar {M#o lendário}{F#a lendária} {NICKNAME}? Acho que é melhor ficar alerta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665015,
					"content": "Uh-oh! Que medo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
		{
			"id": 7166651,
