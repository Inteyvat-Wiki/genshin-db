					}
				]
			},
			"dialogs": [
				{
					"id": 716665101,
					"content": "Muito bem. Você me derrotou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665102,
					"content": "#Eu diria até que foi uma honra perder para {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "Substância sobre Estilo"
				},
				{
					"id": 716665103,
					"content": "Ahhh, então é assim que se faz! Eu nunca pensaria nisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "É! Quando você está contra um inimigo inteligente, você tem que ser criativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "Quando suas táticas falharem, você tem que mudar sua perspectiva. Em nossas jornadas por todo lugar, geralmente temos que pensar rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Se agarrar a métodos antigos jamais solucionará o problema, não importa o quanto tente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Acho que Shinobu disse algo assim antes também. Acho que tá certo então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Mas penso nisso alguma outra hora. Agora meu foco é na tarefa do momento, mais Batalha de Besouros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
