			"dialogs": [
				{
					"id": 210030111,
					"content": "Ugh, se tivesse mais gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "Às vezes, eu gostaria de ir exterminá-los, mas me preocupo que outros monstros aproveitem a oportunidade para atacar os viajantes quando eu sair do meu posto, então eu me sinto sem esperança, preso aqui todos os dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Muito obrigado. Você pode me ajudar a resolver o problema de monstros? Assim posso me aliviar para tratar dos outros assuntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
