				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "O que eu posso fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Hum? Quem é você? Quem passa por esta ponte é sujeito a interrogatório. É a nossa regra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "Mas, olhando para as suas roupas exóticas, você definitivamente não é alguém com quem eu preciso me preocupar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Pense comigo. Um criminoso deve ter se vestido mais discretamente, você, pelo contrário, se veste ostensivamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Eu sou Millelith, responsável por esta zona. Aqui é uma estrada importante para a Ilhota de Dihua, quer os comerciantes, quer os viajantes, passam por aqui. Por isso me mandaram para guardar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Alguns dias atrás, vi alguns monstros... Parece que eles já montaram um acampamento. Mesmo que não esteja fazendo muitas atividades, tenho que fixar os meus olhos neles por causa de razões de segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "Às vezes eu gostaria de ir eliminá-los, mas agora estou preocupado que outros monstros se aproveitem para atacar os viajantes quando eu saio do meu posto, então eu me sinto sem esperança, preso aqui todos os dias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "Já eliminei todos os monstros.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Já? Ah... Nada seria melhor que isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Bom trabalho. Devia ter sido o meu trabalho, mas você acabou fazendo por mim... Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "*Suspiro* Não sei o que os superiores estão pensando, eles deviam ter mandado mais gente! Esta zona é tão grande para uma pessoa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "Eles vão ter um relatório de situação atual, quando eu tiver oportunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Muito obrigado, tome isto como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
