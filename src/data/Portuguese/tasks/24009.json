				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Deixe-me ver... meus amigos me deram algumas sugestões e eu as anotei em meu caderno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Plantas aquáticas... balançando... luz e sombra... mudança... O que eu estava escrevendo mesmo? Será que bebi demais? ...É, deve ter sido isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Ahem. Por favor, me ajude indo debaixo d'água e tirando algumas fotos de algumas plantas aquáticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Me parece que eu estava bem interessado na luz e sombra dessas plantas aquáticas quando eu escrevi essas anotações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400904,
			"completionStepIds": [
				2400904
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
