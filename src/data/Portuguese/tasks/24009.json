			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Falta tensão... o que está acontecendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Sinto como se estivéssemos esquecendo algo... decisivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Tirando fotos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Isso mesmo — esse Aparelho Fotográfico é o mecanismo de inspiração para as minhas pinturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Meu nome é Depierris, sou um pintor — é um prazer conhecer você, realmente um grande prazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Ah... claro. Igualmente...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "#Agora, eu normalmente convidaria {M#um novo amigo}{F#uma nova amiga} para um café, mas, infelizmente, não há nenhum café por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Hmm. Bem, por que você não pega essa Fonta — vamos brindar, e então nos consideraremos como formalmente conhecidos! ...A propósito, você já esteve em Fontaine antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "Estou visitando pela primeira vez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ah, então você vai se divertir bastante! Vá para a cidade e veja as vistas — tipo as Hidrovias se estendendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Então você pode ir para as ruas e ver as máquinas requintadas, mesmo que nem todas elas possuam valor estético — bem, pelo menos na opinião deste humilde pintor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "E finalmente, você pode se sentar em um café e apreciar uma bela xícara de café.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "Quem sabe, talvez alguém venha para conversar enquanto você faz isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Mesmo assim, se a pessoa que vier até você insistir que é de algum tipo de \"Clube de Fotografia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Então fique de guarda para suas palavras estúpidas... pelo menos alguns deles costumam falar coisas bem estúpidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "E o que esses elementos estão fazendo, exatamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Oras, o quê? Nada menos do que colocar a vida cultural da nossa grande Fontaine em direção à aniquilação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Agora, veja bem, isso não é puramente terrorismo. Você consegue imaginar sobre o que eles falam nesse clube?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "\"Se falarmos apenas de imagens, então aquelas que são tiradas por Aparelhos Fotográficos são muito superiores a pinturas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Digo, escuta só isso \"se falarmos apenas de imagens\" bobagem — e realmente *é* bobagem, não importa o quão alto eles insistam que é a verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Se apenas apresentarmos as imagens como elas são, onde estaria o espaço para a estética?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Bem, é realmente verdade que alguns de nós estão tentando aprender como desenhar de forma ainda mais natural... mas até isso é baseado em seu sentido estético.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "Estética! Estética é a chave — você compreende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "N-Na verdade, não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "A observação do mundo através dos olhos de um artista é apenas o primeiro passo. Precisamos explorar a sensibilidade e beleza através do pincel para criar uma obra-prima do coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Ou devemos permitir que aqueles que amam os Aparelhos Fotográficos sejam reduzidos a nada mais do que imbecis grosseiros, desprovidos de qualquer senso artístico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Tenho muitos amigos que amam Aparelhos Fotográficos, e eu amo falar com eles. Às vezes, suas fotos me inspiram, e por sua vez, minhas pinturas os inspiram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Aqueles que não sabem nada sobre a arte e apenas sabem tocar suas próprias trombetas... Oh, como eles fazem meu sangue ferver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Eles sujam o nome daqueles que gostam tanto de fotografia quanto de pintura! Eles realmente são... *Cof*... *cof*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Se acalme, beba um pouco de água.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Ah, obrigado... eu não consigo evitar de perder a cabeça sempre que falo nesse assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Dessa forma, eu e alguns amigos decidimos usar esse Aparelho Fotográfico para tirar fotos que podem ser usadas como material para criar diversas pinturas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Em seguida, colocaremos essas pinturas ao lado das fotos usadas para criá-las em uma exibição — e então, todos verão a diferença entre pintura e fotografia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Porém, *Suspira* eu vejo pouco significado nas várias fotos que tirei. Meus amigos me dizem que as melhores vistas podem ser encontradas nas terras mais distantes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Debaixo d'água, por exemplo, ou em precipícios, ou quem sabe nas profundezas das florestas onde poucas pessoas vão... mas eu não ouso em ir a tais lugares sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "E contratar aventureiros pode levar muito tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#Hmm... {M#Caro senhor}{F#Querida senhorita}, você se importaria de ser contratad{M#o}{F#a} por um artista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Desde que você não me faça pintar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Não precisa se preocupar! Ambos apenas faremos o que somos bons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Você também não precisa se preocupar quanto ao pagamento. Eu costumo contratar aventureiros para serem meus guardas em viagens em busca de inspiração, então eu conheço as regras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "É só que esse assunto era muito urgente, e eu não consegui contratar ninguém a tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Bem, então está decidido. Com sua ajuda, fico ainda mais confiante nas minhas chances de criar um bom trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "#Sou realmente muito {M#bom}{F#boa} em coisas relacionadas a aventura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "U-Um pouco...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Esses... elementos, farão algo comigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Assim como fizeram em Fontaine — eles irão destruir a vida cultural da qual você poderia ter participado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Você é um entusiasta de Aparelhos Fotográficos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "O Aparelho Fotográfico, meu passatempo? Não, não, é apenas uma ferramenta de referência — gosto muito mais do meu pincel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
