			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "Você me ajudou a tirar aquelas fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090802,
					"content": "Aqui estão.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Deixe-me ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090804,
					"content": "#Ah! Perfeito! Perfeito! Jamais imaginei que você seria {M#um fotógrafo}{F#uma fotógrafa} tão incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090805,
					"content": "Com essa imagem eu filtrarei o melhor material possível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090806,
					"content": "Muito obrigado. Deixe-me ver... Onde está minha Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090807,
					"content": "Certo, aqui estão. Por favor, aceite! Se tiver a oportunidade mais tarde, me ajude a tirar mais algumas fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090808,
					"content": "Agora... quanto à composição...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
				2400901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2400901",
							"2"
						],
						"stepId": 2400901,
