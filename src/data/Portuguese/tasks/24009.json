			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "Viajante! Você chegou bem na hora, acabei de encontrar um lugar perfeito para ser fotografado, faltava só você para me dar uma mãozinha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Você ainda está procurando por inspiração?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Mas é claro, isso está longe de ser o suficiente! Uma foto não é o bastante para que eu crie uma pintura inteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Geralmente, se eu decidir usar imagens como referência, posso precisar de algumas dezenas de imagens, ou até mesmo centenas delas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "Precisa de tudo isso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Como mencionei anteriormente, o foco da pintura está na \"criação\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Se apenas apresentarmos minuciosamente tudo o que vemos em uma tela... isso não é chamado de \"pintura\", é chamado de \"fotografia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "O que um pintor realmente deve fazer é examinar os objetos que vê com sua própria estética e espiritualidade, selecionando, transformando e moldando esses objetos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Até que ele extraia a parte mais \"bonita\" de cada objeto, abstrai-a e a grave na tela, somente assim é possível concluir uma obra de arte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Não entendi nada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Bem... em resumo, eu só uso as partes mais bonitas como referência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Por exemplo, se a iluminação e sombras dessa pintura forem muito boas, mas a paisagem em si não for tão boa, eu só vou me referir à iluminação e sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "Em outra pintura, há um pedestre com uma pose muito interessante, enquanto na próxima pintura, a arquitetura é imponente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "É como se você estivesse jogando um jogo de quebra-cabeça em sua mente, e o resultado final, seja bonito ou feio, depende puramente de sua estética pessoal e conhecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Eu realmente estou sendo impreciso ao dizer isso, porque também faremos distorções e abstrações nas paisagens e nos elementos do material de referência... mas isso é tudo que você precisa entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Por isso, você ainda precisa da minha ajuda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "#Ah... com certeza! Suas habilidades de fotografar são realmente incríveis. Meus amigos estão tão impressionados com as fotos que você tirou para mim que eles estão ansiosos para conhecê-l{M#o}{F#a} pessoalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Com sua ajuda, certamente conseguirei criar pinturas excepcionais e extraordinárias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Ah, para o bem do meu senso estético e com todos esses materiais que eu já preparei, por favor, me ajude mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Por isso, preciso continuar ajudando você a procurar por inspiração.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Não tem um jeito mais fácil de explicar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Essas fotos têm efeitos diferentes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
