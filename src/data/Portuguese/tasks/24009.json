					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "Obrigado pela sua ajuda! Isso deve ser o suficiente para encher minha barriga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Aqui, você merece isso. Agora, tirar algumas mordidas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "Talvez valha a pena trazer alguns biscoitos que podem ser guardados em minha sacola da próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400911,
