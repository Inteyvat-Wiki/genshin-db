			"dialogs": [
				{
					"id": 225010601,
					"content": "Não precisa ser o melhor poema do mundo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010602
					]
				},
				{
					"id": 225010602,
					"content": "#Você está cert{F#a}{M#o}. Em relação à poesia, quanto mais se esforça, mais artificial. Uma poesia engenhosa é encontrada sem querer. Mas, não tenho uma ideia para esse verso há muito tempo, quero acabar essa poesia...",
