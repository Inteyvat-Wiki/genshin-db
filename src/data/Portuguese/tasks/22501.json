			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Hm... Essa frase não é boa. Não é boa, eu sei que não deveria, mas quero ir ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010102,
					"content": "O que aconteceu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "#Olá, olá. Meu nome é Qingzhou, {F#minha senhorita}{M#meu cavaleiro}. Posso acrescentar que me considero um poeta, se me permite a ousadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010104,
					"content": "Recentemente eu pensei acidentalmente em algumas frases boas, mas não sei como continuar com ela, do começo ao fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010105,
					"content": "Nesses últimos dias o céu estava com um aspecto diferente, e muitos meteoritos caíram dele, isso não é uma coisa comum de se ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010106,
					"content": "Eu acho que... Se pudermos ir dar uma olhada de perto, e obtermos mais umas inspirações, o próximo verso poderá sair com facilidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010107,
					"content": "Não, não é muito apropriado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Não é muito apropriado? De onde você tirou isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250101",
