			"dialogs": [
				{
					"id": 750701601,
					"content": "*Suspira* Como pode ver, os resultados são... pouco ideais. Simplesmente sem sucesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701602,
					"content": "Ah... Minha família sempre me disse que até pequenas árvores podem criar sombras enormes... Mas é besteira! Besteira! Eles só querem me humilhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701603
					],
					"speakerTitle": "Magnifico"
				},
				{
