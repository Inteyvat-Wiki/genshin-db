			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha! Perfeito! Aqui, pegue uma cópia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Uau, isso *é* incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Aqui está sua recompensa. Isso é a segunda... Não, a terceira vez que você me ajudou. Se não fosse por você... Ora, eu duvido que eu conseguiria sequer terminar minha jornada de fotografia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "#Meu próximo destino é... Aqui. Marquei no seu mapa. De novo, se estiver {M#interessado}{F#interessada}, estou ansioso para trabalhar com vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Ah! Está quase na hora. Tenho que ir agora. Até mais, e boa sorte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico termina de fazer suas malas e pula alegremente dentro do seu balão de ar quente.\\nÀ medida que o balão desaparece lentamente, sua risada estridente é reduzida a nada além de um eco na distância...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
