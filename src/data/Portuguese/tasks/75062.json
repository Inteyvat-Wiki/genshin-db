						],
						"pointId": 10046
					}
				]
			},
			"dialogs": [
				{
					"id": 750620201,
					"content": "Ah, este lugar realmente é amaldiçoado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620202,
					"content": "Não permaneça aqui por muito tempo. Você deve partir, e rapidamente... Sim, você deve ir antes da chegada da maré negra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620203,
					"content": "Sim, a maré negra. Sua vasta sombra está quase sobre nós. Nós devemos... Devemos garantir que todos cheguem em segurança. Que todos... sejam evacuados com segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506203,
