					}
				]
			},
			"dialogs": [
				{
					"id": 750620101,
					"content": "#Essas criaturas desumanas são verdadeiros adversários difíceis... monstros desumanos, eu diria. Saudações, {M#bravo guerreiro}{F#brava guerreira}... Eu sou Quenin, um membro desta equipe de aventura. Meu dever é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620102,
					"content": "#Meu dever... é eliminar esses monstros. Sim, eu sou um guerreiro da equipe de aventura. Tome cuidado, {M#bravo guerreiro}{F#brava guerreira}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620103,
					"content": "Esses monstros... eles são extremamente astutos — capazes de se disfarçar em diferentes formas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620104,
					"content": "Toda noite, antes de adormecer, eu ouço... os sons que eles fazem de seus esconderijos nessas ruínas antigas. Isso... é o motivo pelo qual não consigo dormir no acampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750620105,
					"content": "Este lugar está cheio desses monstros. Você... também deve ter cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506202,
