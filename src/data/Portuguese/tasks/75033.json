					"nextDialogs": [
						750330605
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330605,
					"content": "Vocês são todas minhas boas crianças, ótimos guerreiros também — e todos os guerreiros devem enfrentar diferentes desafios em momentos diferentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330606
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330606,
					"content": "E tá tudo bem. Contanto que suas consciências estejam limpas, estou orgulhoso de vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
