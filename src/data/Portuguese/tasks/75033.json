			"dialogs": [
				{
					"id": 750330601,
					"content": "#Ah, perdi de novo. Até depois de todo aquele treino, ainda perdi para {M#ele}{F#ela}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330602,
					"content": "Eu disse isso há muito tempo. Não há fim para o desejo de vitória. Mas tenho que admirar sua determinação de seguir em frente sem medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330603
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330603,
					"content": "Bem, você era assim quando era mais jovem também, me seguindo todo dia, falando como queria virar um mestre domador de Sauriano...",
