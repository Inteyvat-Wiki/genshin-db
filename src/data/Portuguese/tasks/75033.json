			"dialogs": [
				{
					"id": 750330101,
					"content": "Por que tenho que continuar insistindo? Por que não posso apenas desistir...? Esqueça, desisto! Me ajude, Manyoya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330102,
					"content": "Que vergonha! Pare de agir como criança e desistir quando as coisas não saem como esperado. Como você pode se chamar de guerreiro? Tenho vergonha de chamar você de irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330103,
					"content": "E você tá me dizendo que nunca teve um momento de dificuldade e precisou de ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330104,
					"content": "Tive, é por isso que estou aqui para pedir a opinião de pai e Manyoya sobre os frutos do meu treinamento especial. Não sou um covarde feito você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330105,
					"content": "Acomitl, me lembro que o capitão rejeitou sua resignação, para que você pensasse melhor. Não tome decisões importantes no calor do momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330106,
					"content": "Se acalme e faça suas próprias escolhas. A coisa mais importante é que você não acabe se arrependendo depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330107,
					"content": "Estou aposentada, e até mesmo eu não sei o que o futuro reserva para mim, então temo não ter o direito de te dar nenhum conselho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330108,
					"content": "Eita! Então vocês três são irmãos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330109,
					"content": "Não esperava por essa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "São vocês!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330112,
					"content": "#Minhas desculpas, {M#meu querido benfeitor}{F#minha querida benfeitora}. Meu plano de fuga falhou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330113,
					"content": "Como esperado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "Não há nenhuma forma de eu escapar dessa dor? Ser um guerreiro é tão exaustivo. Por que as coisas não podem ser mais simples?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330116,
					"content": "Ainda preocupado com pensamentos sobre o esquadrão voador?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330117,
					"content": "Desculpe, Acomitl. Baseado em minha experiência, as coisas não ficam mais simples assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330118,
					"content": "#Mesmo assim, acabei de reparar as braçadeiras Matahga. Manyoya, as suas também precisam de reparos? Hmm? Oh, temos convidad{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330119,
					"content": "#Ah, {M#eles são aventureiros}{F#elas são aventureiras} que conhecemos durante nosso treinamento longe de casa, pai. {M#Eles}{F#Elas} até ajudaram Acomitl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330120,
					"content": "#Então, saudações, {M#caros amigos}{F#caras amigas}. Sou Xueyoni, um mestre treinador e o pai deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "Xueyoni",
					"speakerSubtitle": "Mestre Treinador do Clã das Plumas de Flores"
				},
				{
					"id": 750330121,
					"content": "Acomitl parece estar muito mal, então, nos avise se precisar de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330122,
					"content": "Obrigado pela oferta, mas acho que Acomitl está totalmente bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330123,
					"content": "Hã? Você pretende só deixar ele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330124,
					"content": "#Haha! O que estou tentando dizer é que... Vamos colocar dessa forma. Vocês são aventureir{M#o}{F#a}s, então devem ter se juntado à Guilda de Aventureiros, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330125,
					"content": "Essa é uma organização incrível. Vocês, aventureiros, desejam explorar o mundo, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330126,
					"content": "Mesmo assim, imagino que cada aventureiro tenha suas motivações. Alguns exploram por dinheiro, outros desejam conhecimento, e alguns só estão entediados de não ter nada para fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330127,
					"content": "Então, a Guilda de Aventureiros ter unido todas essas pessoas em um só lugar é um feito incrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330128,
					"content": "Veja eu, por exemplo. Sou um velhote que se aposentou após servir como um montador Sauriano em um esquadrão voador e me tornei um mestre treinador em nossa tribo. Mesmo assim, eu não consigo imaginar como seria uma Guilda contendo os mestres treinadores de todas as seis tribos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330129,
					"content": "Uh... O que isso tem a ver com Acomitl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330130,
					"content": "É assim que nosso pai explica as coisas. Na época que ele ainda estava no esquadrão voador, todos por lá, até mesmo os Qucussauros, ouviam sua opinião de boa vontade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330131,
					"content": "Agora ele é um mestre treinador para nossa tribo, e qualquer um que deseje se tornar um guerreiro vem procurar seus conselhos, então, relaxa — por enquanto só escute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330132,
					"content": "Heh, isso tudo ficou no passado, Manyoya. Mas, mesmo assim, vou terminar o conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330133,
					"content": "Nós, mestres treinadores, aspiramos pelo \"guerreiro\" ideal. Isso é que nos inspira a tomar nosso tempo e dedicação para desenvolver nossos conjuntos de programas de treino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330134,
					"content": "Todos nós temos um \"guerreiro dos sonhos\" que desejamos ver aparecer, mas nenhuma pessoa consegue dizer como um guerreiro assim deveria ser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330135,
					"content": "Nós, mestres treinadores, percebemos que concordar em algum princípio e regulamentos é impossível, quem dirá formar uma Guilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330136,
					"content": "Esse \"melhor guerreiro\" possui infinitos rostos e personalidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330137,
					"content": "Às vezes eles são determinados, mas, às vezes, sofrem de duvidar muito de si — sem falar como envelhecerão e morrerão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330138,
					"content": "Os guerreiros devem ser imunes ao esgotamento? Eu posso te mostrar vários pergaminhos tecidos que mostram como dúvida e exaustão é uma praga que aflige a todos igualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330139,
					"content": "Os guerreiros precisam ser enormes? Sei de muitos que pareciam gigantes, porém eram totalmente desprezíveis. Isso também está registrado nos pergaminhos tecidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330140,
					"content": "E é claro, guerreiros vão decair, assim como a lei da natureza dita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330141,
					"content": "Meus filhos me chamam de guerreiro, mas, olhe só para mim. Sou um pássaro velho que não voa mais — não tenho mais força para isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330142,
					"content": "Um guerreiro com um rosto perfeito, uma pessoa que se conforma com qualquer mínimo padrão entediante, não será reconhecida como um herói aqui em Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330143,
					"content": "Manyoya, Acomitl, Matahga, trouxe vocês aqui, pois vocês são os heróis do Clã das Plumas de Flores, olhando para baixo de uma grande altura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330144,
					"content": "Suas preocupações e desejos são estados passageiros na longa jornada de um herói, não problemas que precisam ser resolvidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330145,
					"content": "Sair do esquadrão voador significa que não sou mais um guerreiro? Me juntar a um esquadrão voador automaticamente me torna um guerreiro? Não existem essas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330146,
					"content": "É normal ter ambições, hesitar e se sentir perdido. Você é um guerreiro, e um guerreiro deve passar por desafios para se tornar um herói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330147,
					"content": "Aceitar como você é agora, aprender a viver com esse estado e superá-lo. Nunca deixe isso te controlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330148,
					"content": "É assim que Natlan é — o método dos heróis. Você entende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330149,
					"content": "Entendo, pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330150,
					"content": "Acomitl, você ainda está hesitando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330152,
					"content": "Sermões constantes não é o método de nossa família. Vá voar com seus irmãos e irmãs, assim como quando você era pequeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330153,
					"content": "Deixe sua mente e corpo te ajudar a decidir. Ficar preso dentro de casa e pensando demais nas coisas não vai levar a nada bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330154,
					"content": "Entendi, pai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330155,
					"content": "#Os mestres treinadores sempre falam de forma tão abstrata? Paimon meio que não entendeu nada. Você entendeu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330156,
					"content": "Sim. Basicamente, isso envolve o Desafio de Voo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "#Aventureir{M#o}{F#a}, ouvi sobre você de meus filhos. Você é {M#um}{F#uma} jovem fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330159,
					"content": "#Ter a coragem de competir com Manyoya, ajudar o pequeno Acomitl... e você até ganhou o reconhecimento de Matahga você é — {M#um verdadeiro guerreiro}{F#uma verdadeira guerreira}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330160,
					"content": "Eu gostaria de te convidar para voar com essas crianças. Que tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330161,
					"content": "Manda brasa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "Haha, tudo bem. Quando você tiver decidido, venha e nos avise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330164,
					"content": "Todos os meus três filhos são os melhores voadores do Clã das Plumas de Flores. Vocês vão se divertir bastante voando juntos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330162,
					"content": "Deixe-me pensar sobre isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "Não. Técnicas de educação familiar são muito profundas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "(Dar de ombros)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "Estava bem óbvio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
