			"dialogs": [
				{
					"id": 60080201,
					"content": "Ela não parece tão bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "Com licença, você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080204,
					"content": "Sua doença piorou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "...Tonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080206,
					"content": "...É como se... eu estivesse retornando... para a lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080207,
					"content": "Espera, não é tão ruim assim, é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Hmmm... Eu sinto o poder da lua... em você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080209,
					"content": "Nós roubamos a Medula Lunar dos Fatui. Isso pode ajudar você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Hmmm... o que vocês precisam dessa vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080211,
					"content": "Qual é, nem pense nisso. Agora, você tem que focar em ficar melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080213,
					"content": "(Espera... isso já se tornou habitual para ela? Depois de todo esse tempo de relações de benefício mútuo...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Eu talvez precise de sua ajuda no futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "...Oh Muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080216,
					"content": "Me dê sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080217,
					"content": "Ufa... De volta à terra. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080218,
					"content": "Seus pés nunca saíram do chão... Mas, você tá se sentindo melhor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Muito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080220,
					"content": "O que você fez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "A lua no seu corpo está... silenciosa como um reflexo na água... Fascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080223,
					"content": "Eu apenas puxei um raio de luz da água. O suficiente para me manter presa ao chão por um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080224,
					"content": "Eu também senti outras mudanças...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "Essa é a Graça da Deusa da Lua. Tudo que eu entro em contato possui essa marca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080226,
					"content": "É inofensiva e desaparecerá com o tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080227,
					"content": "Falando nisso, você quer ser a protetora da Medula Lunar, agora que recuperou seus poderes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "E isso é algo que pertence a uma deusa de qualquer forma, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Esses são os resquícios de Aria, a Deusa da Lua Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080230,
					"content": "Então tem a ver com... Espera, o quê?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Vocês não sabiam disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080232,
					"content": "Lauma disse que era diferente de outros fragmentos, e que ela podia sentir poder divino nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "E ela está correta. Quando eu puxei aquele raio de luar da Medula Lunar, também puxei as memórias nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080234,
					"content": "Foi assim que passei a saber que pertence à Deusa da Lua Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080235,
					"content": "Mas Lauma também vislumbrou a história usando a Medula Lunar. Por que ela não viu isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma disse que ela podia vislumbrar pedaços borrados... talvez isso seja algo que só uma Deusa da Lua possa ver...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Havia três luas no céu, cada uma pertencendo a uma deusa que a governava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080238,
					"content": "Mas depois da guerra da chama funerária, todas as três foram derrotadas, e duas das três deusas foram derrotadas no conflito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080239,
					"content": "Depois da morte de Aria, seu poder coalesceu nessa Medula Lunar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080240,
					"content": "Os restos da Lua Iridescente jamais foram encontrados, e enquanto a deusa da Lua Gelada está morta, a lua dela nunca foi quebrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080241,
					"content": "Como dizia a profecia, essa lua daria luz a uma nova divindade cedo ou tarde, a entidade que os Filhos da Lua Gelada chamam de \"Kuu{RUBY#[S]Dama da Lua}tar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080242,
					"content": "Posso sentir que meu poder pertence à Lua Gelada. Mas ela está localizada além do céu falso, distante demais de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080243,
					"content": "Nem falo de \"controlá-la\"... Só \"sentir\" já requer um esforço imenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080244,
					"content": "E—Espera, d—deixa a Paimon contar direitinho... Temos a Medula da Lua Eterna com a gente, ninguém consegue encontrar a da Lua Iridescente... Então você tem a Medula da Lua Gelada dentro de si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "Não. Ela só pode se formar após a deusa da lua morrer. Considere uma forma de núcleo de energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080246,
					"content": "É melhor perguntar logo se há rochas na lua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080247,
					"content": "Ah, então você tá dizendo que você representa o poder da Lua Gelada, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "Sim. Agora, um deus com um Gnosis se chama de Arconte... Já que você carrega a Medula Lunar, isso te torna uma \"Deusa da Lua\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080249,
					"content": "Duvido que seja a mesma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "Você não quer virar uma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080251,
					"content": "Esse não é o problema! Além disso, por que você tá tão ansiosa para passar esse título a outra pessoa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "Enfim, esqueça essa coisa de \"virar uma Deusa da Lua\" por enquanto. Estamos perguntando se devemos devolver essa Medula Lunar para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "Eu não quero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080254,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Nem deseja vir até mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080256,
					"content": "E o que isso significa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Quando entrei em contato com seu poder, senti uma forma de \"rejeição\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080258,
					"content": "Posso apenas supor que seja por eu também ser uma Deusa da Lua. Duas luas não sobem ao mesmo tempo, ainda mais consumir uma a outra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080259,
					"content": "Acho que você tá presa comigo por ora, então.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "Tem certeza que vai ficar bem? Lauma disse que você escondeu aquele poder bem, mas a Damselette sentiu rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "E a Caçada Feroz também não é normal. Se ela detectasse a Medula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "Vocês falam desse fenômeno como se estivessem descrevendo uma pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080263,
					"content": "Bem, parece mesmo que tem uma pessoa por trás, alguém com um objetivo super claro também. Eles estão indo atrás da Medula Lunar sem parar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Me parece familiar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080265,
					"content": "O quê? Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Meus colegas mencionavam alguém enquanto eu ainda estava com os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080267,
					"content": "Ele vinha de Khaenri'ah e ganhou poder do Abismo durante o Cataclismo... E ele tinha uma obsessão em consumir as luas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah? Bem, não sabemos se o fantasma que vimos tem algo a ver com isso, mas os detalhes meio que batem... Qual era o nome dele mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Só sei como os outros o chamam, o \"Vingador da Lua\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080270,
					"content": "Um dos Cinco Pecadores?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah. Ele também tinha esse título, sim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080272,
					"content": "Hã?! Espera... Dain mencionou ele, né? I-Isso quer dizer que nosso inimigo é o Vingador da Lua, um dos Cinco Pecadores?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "Espera. Com certeza ele deveria ser mais forte que isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Ouvi histórias que ele desapareceu logo após o Cataclismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080275,
					"content": "Mas quando perguntei a meus colegas para onde foi, eles responderam, \"Você não sabe mesmo?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080276,
					"content": "Por que eles diriam isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Os contos do seu destino dizem que ele caiu no \"reflexo da lua\", de onde ele não pode retornar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080278,
					"content": "Espera, segura aí, pausa... É... informação demais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "Senti o mesmo. Parecia que esperavam que eu soubesse tudo sobre as luas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080280,
					"content": "Mas como já disse... Meu \"prelúdio\" está além dos céus ilusórios. Nem sequer me lembro do meu nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080281,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "De qualquer forma, a situação da Caçada Feroz piorou drasticamente após sua partida, tornando-se desde então sinônimo de desastre Abissal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080283,
					"content": "O fenômeno atual herdou apenas o nome, superando muito sua encarnação passada tanto em escala quanto em letalidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080284,
					"content": "Argh. E pensar que estamos enfrentando um dos Cinco Pecadores lendários...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "Isso é demais pra gente aguentar! Aquele incidente na Praia da Areia Estelar deve ter sido sorte, então... ou talvez ele não tenha usado todo o seu poder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "E mesmo assim... Ele ainda derrotou a Marionette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "...Ou melhor, o que eu fiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Damselette"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Hmm? O que foi que você disse? Pode repetir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080402,
					"content": "Err... Essa é sua... ex-colega? É, então, nós estávamos juntos na Praia da Areia Estelar, e ela também foi derrotada pela Caçada Feroz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080404,
					"content": "Você... acabou de rir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "...Não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080406,
					"content": "(Você riu sim!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Vocês têm uma relação ruim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "Não. Apenas imaginei a expressão contrariada dela após a tal derrota, e achei interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080409,
					"content": "Ela parecia bem abalada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Ah, ela vai se adaptar logo. Ela é muito boa nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080411,
					"content": "Certo, de qualquer forma, nos desviamos do assunto. Agora que sabemos o quão perigoso é o cara que está atrás da Medula Lunar... Tem certeza de que quer continuar carregando isso com você, Viajante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Se a inteligência da Fatui for confiável, o Vingador da Lua prevaleceria mesmo se toda a Nod-Krai se voltasse contra ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080413,
					"content": "Talvez algo o esteja restringindo, ao menos por enquanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Antes de tomar minha decisão, há um favor que gostaria de te pedir, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "O que você precisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080417,
					"content": "#Acha que conseguiria me mostrar o que aconteceu quando eu e {M#minha irmã}{F#meu irmão} pousamos em Nod-Krai na nossa nave espacial?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080419,
					"content": "Essa foi rápida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Como eu disse, para mim, é apenas uma única Luz do Luar. Nada de mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080421,
					"content": "Dê-me sua mão e prepare-se.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(Isto é o que vimos antes, só que mais nítido...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(Parece que pousamos em segurança, pelo menos...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Parece que se passou bastante tempo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Ainda estamos dentro da nave espacial. Pensar que ficamos lá por tanto tempo... Quando será que {M#Lumine}{F#Aether} saiu?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Espera.  {M#Aquela é... Lumine}{F#Aquele é... Aether}!?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Como isso é possível? Ninguém saiu da nave desde o momento em que pousamos! A porta nem sequer foi aberta!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Onde... estou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Aether}{F#Lumine}! Vamos! Precisamos sair deste lugar!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "E–Ei! Você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Nossa nave espacial... Muito, muito tempo se passou depois que pousamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Ninguém saiu da nave durante esse tempo, mas {M#Lumine}{F#Aether}... me encontrou do lado de fora da nave, de alguma forma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Hã!? Como isso é possível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "Eu não sei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Os segredos escondidos nas memórias são como um biscoito. Dê uma mordida, e ele se esfarela para todos os lados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080439,
					"content": "(Isto... Isto é suspeito demais. Eu preciso chegar ao fundo disso.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Mas como Nefer disse, não haverá nada para investigar se Nod-Krai for destruída antes...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Certo. Vou ficar com a Medula Lunar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "E—É? Bem, tudo bem... Se você diz. Mas esse negócio é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Você vai precisar da minha ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080445,
					"content": "Com o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Eu poderia te ajudar a ocultar a Medula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080447,
					"content": "Sério? Isso seria ótimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "Detectá-la já não é uma tarefa fácil, mas posso te ensinar a ocultar ainda mais sua presença usando kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080449,
					"content": "Assim, ó...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080450,
					"content": "Ooh! Parece um escudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(Isto... é tão suave e delicado... como o luar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Consegue sentir? Agora, tente manter assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Você aprende rápido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080455,
					"content": "Parece bem resistente. Provavelmente daria para usar como defesa pessoal numa emergência, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "#Obrigad{F#a}{M#o} por me ensinar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Você está sempre aqui, Columbina? Lá fora é meio perigoso, claro, mas você já... tipo, deu uma volta lá fora ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "Eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080459,
					"content": "...Não gosto de estranhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080460,
					"content": "E nós, onde estamos nessa escala?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Um pouco melhor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080462,
					"content": "Quando toda essa história da Caçada Feroz acabar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Isso mesmo! Os Filhos da Lua Gelada mudaram desde a última vez que você os viu. Vai saber, talvez até goste deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080466,
					"content": "Vou considerar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080467,
					"content": "Ela parece meio cansada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Provavelmente não fala tanto assim faz tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "De qualquer forma, obrigada por concordar em ajudar a gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "...Não foi nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080471,
					"content": "As flores daqui... gostam de convidados como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 60080463,
					"content": "Vamos dar uma volta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}