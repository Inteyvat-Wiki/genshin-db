			"dialogs": [
				{
					"id": 740120501,
					"content": "Uau! Tão rigoroso! Paimon definitivamente não quer trabalhar para esse sujeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "De onde eles tiram a pouca-vergonha de falar sobre \"um sentido de honra coletiva\"? Onde está a honra em nem deixar ninguém comer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Ele não está totalmente errado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "Que regra absurda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Bem, disciplina é importante, mas... ele certamente não está indo longe demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Né? Quanto mais alguém não sabe como fazer as coisas, mais estranho eles ficam sobre disciplinas e regras...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Hã? Pensando nisso, se nós também causarmos uma comoção, provavelmente poderemos atrair o líder do pelotão, Shumilov até aqui, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#Então, poderemos subir... {NICKNAME}, vamos tentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
