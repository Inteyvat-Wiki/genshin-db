			"dialogs": [
				{
					"id": 732070321,
					"content": "Depois de esperar em silêncio por algum tempo, novos brotos emergem lentamente do solo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Uau, o método da Sabbah funcionou mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "As sementes estão brotando! Finalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "Parece que o desejo que o Sr. Shafaqat fez durante sua vida pode finalmente ser realizado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070304,
					"content": "Sr. Affan, o senhor me disse antes que esta espécie de rosas é aquela que ele cultivava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070305,
					"content": "Para poder cultivar uma nova espécie, ele deve ter sido um pesquisador que foi exilado aqui, assim como eu, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070306,
					"content": "Sim... Ele foi exilado para esta aldeia, e viveu naquela casa atrás de nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "Entendo. É provavelmente assim que todos nós no exílio acabamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070308,
					"content": "Certamente, a criação de novas variedades de plantas é algo que somente os melhores pesquisadores podem fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070309,
					"content": "É uma vergonha que alguém como ele tenha caído no anonimato, fora da Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070310,
					"content": "Sabbah, você parece estar pensando em seu próprio futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Não desanime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Sim, criança. Você ainda tem um longo caminho a percorrer, e muitas coisas a fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "Não fique presa ao sentimentalismo, não quero ver o surgimento de um outro Velho Fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "Você está certo. Eu não posso ser tão triste em um momento feliz como esse. Vamos ao que interessa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070318,
					"content": "Estas Rosas Douradas estão apenas brotando, não floresceram ainda. Quero continuar observando-as até que floresçam. E vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070319,
					"content": "Eu também.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Vamos esperar mais um tempo para que absorvam os nutrientes. Vamos voltar depois para ver elas desabrochando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070314,
					"content": "(Não sei como podemos consolar Sabbah...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Não fique triste. Olhe só, no final das contas, ele nos deixou a Rosa Dourada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "Elas são uma evidência de que o tio Shafaqat existiu neste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
