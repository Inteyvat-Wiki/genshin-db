				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "\"Ó, rosa bela rosa, a meu desejo realizar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "\"Ó, rosa dourada, nas rochas a desabrochar, que para mim cantará.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "\"Ela cantou:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "\"Nesta terra para mim não há lugar, só a música para me sustentar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "\"Meu destino só a música para derrotar, triunfar o meu findar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "\"A eu derrotar, ao tempo conquistar. A predominar sobre o que jamais desaparecerá.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070507,
					"content": "Esta é a canção que o tio Shafaqat nos ensinou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
