				{
					"id": 732030619,
					"content": "Como é a vida na Vila Aaru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "É ok. Tenho o que comer, tenho onde morar. Todos os essenciais já foram lidados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030621,
					"content": "Fui banida, afinal de contas, não espero, de forma alguma, livros e equipamentos de pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030622,
					"content": "Além disso, desde o início, essa vila é o local para onde vão os pesquisadores expulsos da Academia. Não dá para comparar o que temos aqui com a cidade de Sumeru, em termos das condições de vida e pesquisa. Naturalmente, não há lá muito clima para se fazer pesquisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030623,
					"content": "Eu não sou a primeira exilada e, talvez, nem seja a última.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030624,
					"content": "Já estou aqui, agora é só se acostumar. Esse é o único jeito de pensar sobre isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Oh, já falei muito... mas me sinto bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
