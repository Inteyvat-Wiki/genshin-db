							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "Por falar nisso, a qual Darshan você pertencia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "Ah, eu poderia falar disso por três dias sem parar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030607,
					"content": "Pode-se dizer que eu era do Amurta, especializada em evolução de plantas. Podemos dizer que meu trabalho se baseava muito em evidências.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030608,
					"content": "Isto significa que sem novos objetos de estudo, que sejam concretos, é muito difícil tirar novas conclusões. De maneira simplificada: Amostras históricas são necessárias para pesquisar sobre plantas históricas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030609,
					"content": "Mas são poucas as amostras fáceis de se coletar. Na verdade, a maioria já foi coletada e a Academia era limitada em relação ao fornecimento de novas amostras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030610,
					"content": "Estas são as circunstâncias, e ainda assim a Academia exige resultados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030611,
					"content": "Há pessoas que pegam as pesquisas feitas anteriormente e as reexaminam, algo que também conta como um trabalho realizado na área. Isso também não parece certo para você, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030612,
					"content": "Na verdade, nós poderíamos realizar novas descobertas se olhássemos para a história e geografia para novos materiais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030613,
					"content": "Alguns documentos ignorados pelos Amurta também podem ser utilizados, apesar de que isso adentraria as áreas do Vahumana e Haravatat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030614,
					"content": "Eu não tenho conhecimento dessas áreas. Além disso, o procedimento para a solicitar os arquivos relacionados dessas áreas é muito trabalhoso e é ainda mais difícil estabelecer uma parceria com os pesquisadores pertinentes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030615,
					"content": "Porém, eu acredito que se estabelecermos colaboração, muitas questões poderiam ser respondidas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030616,
					"content": "É uma pena que não foi desenvolvido algo nesse sentido. O ponto de vista adotado por aqueles no Vahumana e Haravatat é muito peculiar, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030617,
					"content": "Eu tinha que ser muito cuidadosa com meu fraseamento e escolha de palavras em meus trabalhos para evitar mal-entendidos e interpretações errôneas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030618,
					"content": "Antes de ser expulsa da Academia, eu estava no meio de uma discussão com um membro do Haravatat. Agora não consigo sequer fazer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Oh, já falei muito... mas me sinto bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Antes de você chegar aqui, eu não tinha amigo nenhum. Na verdade, era meio solitária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Poucas pessoas gostam de plantar flores na vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "Bem... Não exatamente, ao norte da vila, há um velhinho que cultivou um canteiro e plantava flores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "Eu fiz uma visita a ele. É um senhor esquisito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "Vi ele plantando pedras, mas ele insistia que eram flores e então me expulsou de lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "Mas eu entendo o sentimento dele, uma vida desse jeito é muito solitária.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "Você me ajudou com a minha Rosa de Sumeru, talvez você também possa ajudá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "Se tiverem a oportunidade, você e Paimon deveriam ir visitá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
