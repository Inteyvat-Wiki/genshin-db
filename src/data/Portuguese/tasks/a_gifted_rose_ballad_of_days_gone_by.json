			"dialogs": [
				{
					"id": 732030602,
					"content": "Essa é a Rosa de Sumeru que eu colhi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "Que flor mais marcante! Também deixei o seu presente pronto. Pode levar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030604,
					"content": "São sementes de plantas que não podem crescer e nem germinam por aqui. Se você tiver um quintal em outro lugar, você pode vê-las crescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
