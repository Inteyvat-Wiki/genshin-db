			"dialogs": [
				{
					"id": 756710101,
					"content": "Chirp chirp! Coo coo! Chirp chirp chirp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710102,
					"content": "Hã... o que você está fazendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Você está mandando... algum tipo de mensagem secreta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Tipo isso! É uma técnica que uso para me comunicar com os passarinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710106,
					"content": "Oh, eu esqueci de cumprimentar vocês. Bem como a frase essencial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710107,
					"content": "Saudações, transeuntes! Eu, Basima a Quinta, pesquisadora Amurta, comerciante em ascensão, e especialista em animais fofinhos, saúdo vocês calorosamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710108,
					"content": "Por favor. Relaxa teu corpo, limpa tua mente e ouça-me atentamente, pois tenho uma questão de suma importância para compartilhar contigo—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710109,
					"content": "Passarinhos são super fofinhos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "Sim! Isso mesmo! Meus parabéns, vocês também foram cativados pelos passarinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710111,
					"content": "Que estranho. Paimon não sabe porque, mas quando viu o jogo nessa mesa, essa frase brotou na cabeça dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#Isso parece familiar para você, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "A gente já conheceu essa senhorita antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "#Exato! E não foi só um breve encontro. É ótimo ver vocês chei{F#as}{M#os} de energia como sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710117,
					"content": "Enfim, você gostaria de experimentar esse jogo? É a 17ª edição, a terceira geração de \"Bola de Passarinho Cling-clang\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710118,
					"content": "Enquanto você relaxa desfrutando o jogo, você também consegue ouvir histórias maravilhosas sobre os passarinhos, e o maior Passarinho Antigo das Penas Escarlates triunfando sobre as gaivotas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710119,
					"content": "Legal! Sempre fomos fãs de jogos relaxantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Vamos com tudo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Certo! Eu espero que vocês encontrem a jogatina que combina melhor com vocês. Assim o jogo será mais divertido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710121,
					"content": "Vamos!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Acho que é hora de começar com aquilo de passarinhos são fofinhos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Sim! E mesmo que você não lembre do passado agora, não tem problema. O que importa é aproveitar o presente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima, a Quinta"
				},
				{
					"id": 756710104,
					"content": "Ou falando em códigos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}