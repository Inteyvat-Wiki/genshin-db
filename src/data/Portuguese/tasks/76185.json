			"dialogs": [
				{
					"id": 761850201,
					"content": "Chá fica muito melhor quando acompanhado de informações...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850204,
					"content": "Oh, se cuide. E lembre-se de passar aqui sempre que estiver livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
