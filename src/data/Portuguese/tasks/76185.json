			"dialogs": [
				{
					"id": 761850101,
					"content": "Hmm, chá delicioso com lanches gostosos. Obrigada pela hospitalidade, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Fico feliz que tenha gostado. Também trouxe alguns lanches para Ashru. Não é, Ashru? Venha aqui. Isso, bom gatinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850103,
					"content": "Miau~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Espero que sua amizade com Nod-Krai e a Curadoria dos Segredos seja benéfica para nossa cooperação futura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Espero que sim. Aqui, Ashru, prove esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850106,
					"content": "Ah, e sobre aquele assunto que perguntei antes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Haha, suas patinhas são tão macias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Srta. Sandrone... Não me diga que você usou esse chá como pretexto para vir aqui e mimar meu gato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Hã? Eu? Nunca! Eu levo meus negócios com a Curadoria dos Segredos muito a sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850111,
					"content": "Ashru, venha aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Miau~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Aww...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850114,
					"content": "Então, vamos falar dos detalhes de nossos negócios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "Hunf. E daí se eu quiser fazer carinho nele? Quem não iria querer?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850116,
					"content": "Animais pequenos geralmente desconfiam de máquinas. Deu bastante trabalho para fazer Ashru confiar em mim quando eu estava aqui trabalhando na matriz numerológica. Qual é o problema de eu querer fazer um carinho nessa barriguinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761850117,
					"content": "Haha... Não precisa ficar tão na defensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Vá em frente, Ashru. Não sou eu quem vai dizer com quem você pode se esfregar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Miau~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Mas quando você terminar de fazer carinho nele, não esqueça que temos negócios a tratar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Eu disse que levo nossos negócios a sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
