			"dialogs": [
				{
					"id": 766500301,
					"content": "Uau, que estátua enoooorme... É, nem uma multidão de pássaros ou furões conseguiria mover isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500302,
					"content": "Eles provavelmente nem conseguiram passar pelo espelho... Então, Lauma, quão valiosa é essa estátua, afinal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500303,
					"content": "Em termos de Mora? Não muito, eu diria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500304,
					"content": "Ela é esculpida grosseiramente, e o tipo de pedra usado na escultura é comum por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500305,
					"content": "Mas para a Emissária da Canção Lunar daquela época, e para os Filhos da Lua Gelada de hoje, é um tesouro inestimável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500306,
					"content": "Se nada mais, agora tenho uma prova concreta de sua existência. Isso já basta para confirmar a veracidade de vários documentos sobre o assunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500307,
					"content": "Para mim, isso torna esta uma viagem muito bem-sucedida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500308,
					"content": "#Obrigada pela sua ajuda, {NICKNAME}. Eu sabia que havia julgado você corretamente — o Espelho da Lua não foi obstáculo para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500309,
					"content": "E nosso amiguinho aqui ficou muito impressionado com suas habilidades de operação de mecanismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500310,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500311
					],
					"speakerTitle": "Furão Ladrão"
				},
				{
					"id": 766500311,
					"content": "O que tá dizendo, Lauma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500312,
					"content": "#Diz que {NICKNAME} é {M#o}{F#a} melhor caçador{F#a} de tesouros que já viu. Ele deseja, se possível, se juntar a {M#ele}{F#ela} numa missão para abrir todos os baús de tesouro no mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500313,
					"content": "#Caramba, isso me faz parecer um{F#a} ladr{F#a}{M#ão}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "Furão Ladrão"
				},
				{
					"id": 766500316,
					"content": "\"A partir de agora, vou chamar você se eu encontrar um baú de tesouro que eu não conseguir abrir!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500317,
					"content": "Hmm... Ok, então tchau... Nem deu escolha pra gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500318,
					"content": "Não se preocupe, ele não vai ir bater na sua janela todo dia com uma moeda de Mora na boca tentando te arrastar para uma caça ao tesouro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500319,
					"content": "Com certeza não vai visitar seu quarto no meio da noite, gemendo sobre trancas que não consegue arrombar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500320,
					"content": "#Eita, é melhor a gente garantir de trancar todas as portas e janelas antes de ir dormir hoje, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500321,
					"content": "Relaxe. É só uma criança, não tem más intenções. É só... mais falante que a maioria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500322,
					"content": "Tudo bem, vamos voltar. Já é quase hora do jantar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500323,
					"content": "Ah, e ainda precisamos descobrir como levar essa estátua de volta à nossa biblioteca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500324
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500324,
					"content": "...Parece que vou precisar de uma ajudinha dos meus amigos, no fim das contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500314,
					"content": "Mas é verdade que eu saio abrindo tudo que é baú por aí...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				}
