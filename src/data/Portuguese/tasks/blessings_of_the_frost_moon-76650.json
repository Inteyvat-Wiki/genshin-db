						766500419
					],
					"speakerTitle": "Papagaio-do-mar"
				},
				{
					"id": 766500419,
					"content": "Pfft... Essa aqui diz para comer o quanto quiser, pois ela é a melhor caçadora de frutas na floresta inteira. Vou pegar mais umas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500420
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500420,
					"content": "Incrível. Valeu mesmo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500421
					]
				},
