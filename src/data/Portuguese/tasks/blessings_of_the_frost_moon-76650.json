					"nextDialogs": [
						766500221,
						766500222
					],
					"speakerTitle": "Furão Ladrão"
				},
				{
					"id": 766500221,
					"content": "Então, como posso ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500223,
					"content": "Para recuperar a Imagem Lunar, precisamos ativar pares de mecanismos em dois locais diferentes. Ou seja, é um trabalho para duas pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500224,
					"content": "Se você for lá e operar o mecanismo naquele lado, vou pegar o desse lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500225,
					"content": "Mas como vamos garantir que sejam ativados ao mesmo tempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "Isso não será um problema. Tenho olhos no céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500227,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500228
					],
					"speakerTitle": "Íbis"
				},
				{
					"id": 766500228,
					"content": "Ele vai me manter informada sobre onde você está e qual mecanismo está à sua frente. Não se preocupe, tudo o que você precisa fazer é seguir minhas instruções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500222,
					"content": "Como vamos abrir esse mecanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500218,
					"content": "Não no cabelo! No cabelo, não...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500209,
					"content": "Esse Furão Ladrão não trabalha de graça...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500204,
					"content": "#Estou acostumad{M#o}{F#a} com isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				}
			]
		},
