					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Furão Ladrão"
				},
				{
					"id": 766500217,
					"content": "Ei, ei, não suba em mim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "#Vamos lá, seja bonzinho com noss{M#o}{F#a}s convidad{M#o}{F#a}s.",
