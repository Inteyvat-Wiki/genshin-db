					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Furão Ladrão"
				},
				{
					"id": 766500215,
					"content": "Hehe, a Paimon você não pega, a Paimon voa! Nyeehh~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500216,
					"content": "!!!",
