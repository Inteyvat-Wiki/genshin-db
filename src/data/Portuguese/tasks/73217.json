			"dialogs": [
				{
					"id": 732170801,
					"content": "O maior hotel do Porto Ormos, oferecemos o serviço mais atencioso aos viajantes de negócios e lazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170802,
					"content": "Descontos especiais estão disponíveis para estudantes e graduados na Academia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170803,
					"content": "Se houver mercadorias que precisem ser armazenadas, entre em contato com o Wikala Funduq.",
