			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Este porto agora está investigando estritamente as atividades de contrabando, e todas as mercadorias que entram e saem daqui devem ser registradas e inspecionadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170602,
					"content": "Quaisquer mercadorias não registradas ou itens ilegais serão confiscados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170603,
					"content": "Todas as consequências resultantes disso são de responsabilidade exclusiva do proprietário da carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
