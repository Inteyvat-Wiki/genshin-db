			"dialogs": [
				{
					"id": 732170701,
					"content": "Monstros marinhos à espreita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170702,
					"content": "Como os monstros marinhos têm estado ativos recentemente, as embarcações que saem do porto são aconselhadas a prestar atenção aos avisos emitidos pelo Farol Pharos ou obter informações antecipadas sobre a área marítima através do Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170703,
					"content": "Em caso de dúvida, consulte o Guardião do Farol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
