			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "Todas as embarcações que entram no porto são obrigadas a registrar as informações do proprietário, o motivo da entrada e outros detalhes junto ao Chefe Portuário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170502,
					"content": "No caso de navios mercantes, também são necessários detalhes das mercadorias transportadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170503,
					"content": "Navios mercantes não podem descarregar ou realizar atividades comerciais por aqui sem registro e, uma vez descobertos, serão severamente punidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
