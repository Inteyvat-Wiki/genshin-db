			"dialogs": [
				{
					"id": 732171901,
					"content": "\"A rota de comercial para as ilhas Ritou foi reaberta. Nós estendemos nosso sincero convite para que você se junte aos nossos negócios.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171902,
					"content": "\"O comércio de cogumelos silvestres entre Sumeru e Inazuma operado por esta associação foi aprovado pelo Chefe Portuário. Os comerciantes que negociarem cogumelos são bem-vindos à nossa associação para discutir assuntos de cooperação.\"",
