			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "\"O serviço que o Hotel Shapur oferece é bom, mas o isolamento acústico do quarto é muito ruim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170902,
					"content": "\"Decidi ficar aqui porque os preços em Porto Ormos eram baixos. Agora eu vou ter que me mudar para a Cidade de Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170903,
					"content": "\"Se eu não passar no exame este ano, terei que voltar para minha cidade natal para trabalhar no campo. Não sei se vou conseguir trazer um pouco da 'Bênção Anahitiana' comigo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "\"Os Mahamata enviados recentemente são inúteis e não sabem de nada. Não conseguem responder uma única pergunta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171002,
					"content": "\"Além disso, agora que temos acesso ao Akasha, esses Mahamata amadores não estão nem no meu nível.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171003,
					"content": "\"Apenas aquele Escriba que não é visto com frequência que nos ajudou a organizar o cronograma para o despacho de navios da última vez é exceção. Aparentemente nem todos na Academia são uns estúpidos burros.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "\"Desde que o Cyno se tornou o General Mahamatra, o meu fardo cresceu, mas tem sido um alívio maior porque não tenho que me envolver em todas aquelas brigas de facções chatas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171102,
					"content": "\"Caso contrário, eu não poderia ficar matando tempo por aqui enquanto estiver em uma viagem de pesquisa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171103,
					"content": "\"Eu não sei onde Cyno tem estado ultimamente, então se eu escrever aqui, acho que ele não vai ver.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171104,
					"content": "\"Eu vi tudo. Por favor, apresente-se a mim antes do meio-dia amanhã para receber a punição.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171105,
					"content": "\"Não desperdice meu tempo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Nosso comércio lida com produtos de gemas e minérios preciosos produzidos em Liyue e tem cooperação de longo prazo com muitas frotas, com suprimento suficiente e canais estáveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171202,
					"content": "Uma pequena seleção de novas sedas e roupas da moda também está disponível para venda. Oferta limitada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171203,
					"content": "Entre em contato se você tiver bons canais para produtos de alta qualidade, como cobertores locais de Sumeru, ervas, gemas preciosas, material de brocado, etc. Vamos negociar e estreitar laços!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "\"Naveguei para um país no mês passado e seu rei nunca havia visto um cavalo. Acredita nisso?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171302,
					"content": "\"Então decidi vender um bando de Animais de Carga e dizer-lhes que são cavalos, haha. Se eu fiz negócio com eles, eu poderia muito bem ser um rei ou algo assim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171303,
					"content": "\"O que é um rei?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171304,
					"content": "\"É uma espécie de alto funcionário que é como um Navbed ou um Vizir, mas mais poderoso que eles. Assim como a lendária aliança dos Vinte e Nove Deys Oceânicos... Ah! É muito difícil descrever isso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171305,
					"content": "\"Você está tirando onda com a minha cara.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "\"Sábios e suas pregações, quem atura tais sermões? Melhor não seria, enchê-los com o vinho das flores e partirmos em uma viagem para conquistar os sete mares?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "A Marinheiros, passageiros, viajantes de negócios e cidadãos locais e estrangeiros: Os regulamentos portuários são anunciados aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171502,
					"content": "No caso de uma disputa, você pode entrar em contato com o xerife Shyam para obter ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "\"Em vez de visitar o Grande Bazar na Cidade de Sumeru, você devia visitar os antigos mercados em Porto Ormos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171602,
					"content": "\"Temos mantido muito mais das características e tradições de Sumeru aqui do que lá no Grande Bazar, que foi bastante bagunçado pelos Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171603,
					"content": "\"Já ia esquecendo! Se você gosta de apreciar uma boa dança, não deixe de ver o Teatro Zubayr.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171604,
					"content": "\"Um camponês nunca deixa de ser um! A estruturação da cidade de Sumeru foi cuidadosamente projetada por pesquisadores, e o zoneamento segue o raciocínio científico sem falhas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171605,
					"content": "\"Tem gente que não entende nada e fica só falando bobagem por aqui, tomando as ruas caóticas do Porto Ormos como um tesouro!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171606,
					"content": "\"O que você tá falando? Não te escuto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "\"É realmente embaraçoso dizer isso. Costumávamos ser trabalhadores encarregados da manutenção de navios mercantes durante todo o ano, e temos dependido das habilidades de manutenção herdadas de nossos ancestrais para comer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171702,
					"content": "\"Mas desde algum tempo atrás, novas tecnologias foram introduzidas no Akasha, de modo que a nossa experiência anterior se tornou completamente inútil. Os jovens ainda podem aprender através do Akasha, no entanto, para aqueles de nós que são mais velhos só nos resta mudar de carreira.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171703,
					"content": "\"Embora o Escriba tenha dito que podemos tentar a sorte no mar, temos que nos preparar um pouco porque realmente não temos dinheiro. Se você tiver algum serviço, por favor, venha até nós.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171704,
					"content": "\"Não ouça aquele Escriba. Conheço uma grande cliente que precisa de artesãos, e estou te recomendando a ela. Pegue este pouco de dinheiro, e esqueça ir para o mar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171705,
					"content": "\"Realmente espero que você não faça mais bobagens. Algumas pessoas são bem-sucedidas, já outras estão em apuros, e é assim que o mundo funciona. Por que se preocupar em interferir nos altos e baixos do mundo só para ser uma boa pessoa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171706,
					"content": "\"Aqui vai o Escriba de volta com suas lições de misticismo. Por que eu fiz isso, você pergunta? Porque me deixa feliz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171707,
					"content": "\"Não ignore que a natureza e a raiva justa de buscar assistência mútua e justiça também são forças motrizes que dirigem o mundo, em vez da falácia da 'sobrevivência do mais forte'!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171708,
					"content": "\"Não interprete de forma errônea, nunca neguei nada do que você está falando, no entanto, você não entendeu nada do que estou querendo lhe dizer. Fim de papo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171709,
					"content": "\"É uma dor de cabeça debater com pessoas tão enérgicas... Então, onde que foi parar seu orçamento? Não me diga que você gastou todo o subsídio da Academia em assuntos tão chatos?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171710,
					"content": "\"'A pobreza dos pobres é maior que a riqueza dos ricos, logo, deveriam espalhar sua boa fortuna com um bom propósito.' Palavras do sábio Zolfikar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171711,
					"content": "\"Ele não disse isso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171712,
					"content": "\"Disse sim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171713,
					"content": "\"Não disse! Esse mês a bebida será por sua conta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171714,
					"content": "\"Não irei debater com vocês, no entanto, me dê um mês! Ele certamente falou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "\"Estamos agora operando um serviço ao Porto Dornman e convidamos você a se juntar a nós no comércio de frutas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171802,
					"content": "\"Espere um minuto, a viagem daqui a Mondstadt é longa... falar em importação de frutas é um absurdo. Eu até me interessaria se você falasse sobre o comércio de bebidas alcoólicas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171803,
					"content": "\"Importação de vinho de Mondstadt, não é o que a maioria das pessoas faz? Agora, importação de frutas? Só eu que faço. Esta é uma oportunidade de negócio! Entendeu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732171804,
					"content": "\"Além do mais, não necessariamente precisa ser importado de Mondstadt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
