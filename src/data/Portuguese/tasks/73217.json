			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "\"Este é um quadro de avisos criado pelo Chefe Portuário do Porto Ormos. Assuntos importantes de dentro e fora do porto são postados aqui. Se você tiver alguma dúvida, pode deixar uma mensagem para nós.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "\"Ainda lutando com a formatação e à procura de ideias para sua tese? É hora de tentar uma nova abordagem!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170202,
					"content": "\"Sou um graduado do Haravata e proficiente tanto no Spantamad e Kshahrewar. Faço aconselhamento de redação de tese e sessões de perguntas e respostas.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170203,
					"content": "\"É hora de parar de passar trabalho, vá ao hotel e entre em contato com o Sr. Amandeep, você poderá negociar o preço.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170204,
					"content": "\"Você pode escrever para mim?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170205,
					"content": "\"Não, o supervisor não permitirá que tal coisa aconteça.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170206,
					"content": "\"Por favor, dedique sua atenção aos seus estudos e não tenha más intenções.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Você já ouviu falar de levitação? Você já viu alguém voar? Quer saber o mistério por trás dos Animais de Carga? Então não perca a primeira apresentação do Grupo de Arte Voadora de Fontaine em Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170302,
					"content": "#Bem-vind{M#os}{F#as}! Não perca a oportunidade de ver esta apresentação artística única! São apenas cinco Mora por um bilhete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170303,
					"content": "\"Foi formidável! Nunca vi uma apresentação tão maravilhosa em Fontaine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321704",
							"2"
						],
						"stepId": 7321704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Um lembrete especial: Toda a indústria mercenária em Sumeru é empreendida pelos Eremitas e ninguém mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170402,
					"content": "Por favor, não confie em estranhos facilmente, de modo a evitar ser enganado por golpistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Quadro de Avisos"
				},
				{
					"id": 732170403,
					"content": "Se você precisar contratar guarda-costas, proteção ou outras incumbências, entre em contato com o Capitão de Equipe da Tropa dos Trinta em Porto Ormos, Feroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quadro de Avisos"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
