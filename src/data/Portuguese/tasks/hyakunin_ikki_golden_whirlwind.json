					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820101,
					"content": "#Olá, Viajante {M#loiro}{F#loira}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820102,
						726820103
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820102,
					"content": "Nos encontramos de novo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				},
				{
					"id": 726820104,
					"content": "Hmm, seu cabelo loiro me parece familiar... você é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820105
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820105,
					"content": "Ah sim! Você é Tornado Dourado do Hyakunin Ikki da última vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820106
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820106,
					"content": "T-Tornado Dourado...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820107
					]
				},
				{
					"id": 726820107,
					"content": "Anteriormente, eu estava assistindo a excelente performance dos participantes de algum canto do torneio, procurando inspiração pelas cenas de lutas mais animadoras. E lá estava você, acabando com seus oponentes feito um turbilhão dourado, destruindo tudo em seu caminho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820108,
						726820109
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820108,
					"content": "Urgh, por favor, me poupe da bajulação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820113
					]
				},
				{
					"id": 726820113,
					"content": "Enfim, algumas pessoas organizaram recentemente outro Hyakunin Ikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820114,
						726820118
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820114,
					"content": "O que é Hyakunin Ikki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820115
					]
				},
				{
					"id": 726820115,
					"content": "É uma luta de todos-contra-todos, onde as pessoas lutam entre si para comemorar, ou para simplesmente acabar com a má sorte. É um festival em que tanto artistas marciais quanto monstros colocam suas desavenças de lado e esquecem suas identidades, apenas para aproveitar o calor da batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820116
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820116,
					"content": "Dizem que aqueles que se sobressaem dentre a multidão, receberão grandes tesouros como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820117
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820117,
					"content": "Porém, a identidade dos organizadores e patrocinadores é um mistério.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820119
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820119,
					"content": "Seja qual for o caso, não é um assunto para ser discutido abertamente. Siga-me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820118,
					"content": "Entendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820119
					]
				},
				{
					"id": 726820109,
					"content": "...Continue, não pare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820110
					]
				},
				{
					"id": 726820110,
					"content": "#Cof... \"Espectadores com o olho aguçado de um espadachim devem ter percebido — {M#o estrangeiro loiro}{F#a estrangeira loira} estava usando a técnica Kouranka Daitatsumaki, uma técnica considerada proibida até mesmo dentre os artistas marciais anciões...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820111
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820111,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820112
					]
				},
				{
					"id": 726820112,
					"content": "Tendo sido inspirado pela sua maravilhosa luta, escrevi essa história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820113
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820103,
					"content": "Você tem uma missão para mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820104
					]
				}
			]
		},
		{
			"id": 7268202,
			"completionStepIds": [
				7268202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268202",
							"2"
						],
						"stepId": 7268202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayabuki Ikkei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726820201,
					"content": "Aqui estamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820202
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820202,
					"content": "Assim que entrarmos nesse portão suspeito, estaremos dentro da área do Hyakunin Ikki da vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820203,
						726820204
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820203,
					"content": "Ooh, isso é animador!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				},
				{
					"id": 726820205,
					"content": "As regras provavelmente não mudaram tanto. Monstros, aventureiros e guerreiros de vários cantos do mundo compartilham um desejo em comum pela batalha e poderão acabar com sua sede neste desafio através de uma batalha acalorada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820206
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820206,
					"content": "Assim como da última vez, sinta-se livre para trazer amigos e companheiros! Afinal de contas, \"Hyakunin\" de \"Hyakunin Ikki\" significa quanto mais, melhor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820207
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820207,
					"content": "Mal posso esperar pela sua performance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820208
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820208,
					"content": "Você também não irá participar dessa vez?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820209
					]
				},
				{
					"id": 726820209,
					"content": "Oh, mas é claro que eu vou - como um espectador, torcendo por você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820210
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820210,
					"content": "#Afinal de contas, o que almejo fazer é escrever romances de ação emocionantes, e não me tornar {M#um guerreiro}{F#uma guerreira} galante feito você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820211
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820211,
					"content": "...E o meu instinto me diz que a sua estrela brilhará mais forte nesta arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726820212,
						726820213
					],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820212,
					"content": "Farei o meu melhor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820214,
					"content": "Sim, tenho certeza que você me mostrará a melhor dança da lâmina novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayabuki Ikkei"
				},
				{
					"id": 726820213,
					"content": "Aguarde e você vai ver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820214
					]
				},
				{
					"id": 726820204,
					"content": "Isso soa muito complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726820205
					]
				}
			]
		}
	]
}