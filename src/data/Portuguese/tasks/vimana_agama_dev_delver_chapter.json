			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "Aquela coisa ali emitindo luz deve ser a tal da Fornalha do Caos que o Jazari tinha comentado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Está selado com galhos e vinhas, mas algo parece estar fluindo para fora dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "Oh, é a coisa suja! Ararycan consegue sentir. Foi isso que deixou a floresta doente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Oh, há muitos Feiticeiros do Abismo fazendo sabe-se lá o quê ao lado daqueles galhos enormes. Paimon está com um mau pressentimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Lembro que o Jazari disse que o selo do núcleo foi destruído. Talvez esses Feiticeiros do Abismo tenham algo a ver com isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Enfim, Ararycan, vá lá fora e encontre um canto para se esconder. Iremos impedi-los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
