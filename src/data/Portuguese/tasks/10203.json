				{
					"id": 102030201,
					"content": "*Choro*... Vou tomar mais cuidado na próxima vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030202
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102030202,
					"content": "Na próxima vez, completarei uma grande aventura heroica sozinha e farei isso com segurança!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "Confinamento Solitário"
				},
				{
					"id": 102030203,
					"content": "Ouvi dizer que a Guilda de Aventureiros tem seu próprio conjunto de regras. Imagino se eu conseguiria fazer com que...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
