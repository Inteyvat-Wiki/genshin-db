			"dialogs": [
				{
					"id": 708250601,
					"content": "Como está sendo o progresso? Já terminou de limpar a área?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250602,
					"content": "Tudo pronto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Fantástico. Você foi de enorme ajuda, quem sabe por mais quanto tempo aquelas coisas horrorosas teriam ficado lá paradas, caso contrário...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250604,
					"content": "#Cavaleir{M#o}{F#a} Honorável, por favor aceite estes como forma de minha gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
