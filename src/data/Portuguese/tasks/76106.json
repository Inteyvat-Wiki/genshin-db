			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "...Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "Tô te dizendo pro seu próprio bem — não fique bisbilhotando o Escritório de Design, especialmente o segundo andar! Exposição demais ao kuuvahki pode causar de dor de cabeça até náusea forte. Depois não diga que eu não avisei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Sério?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Claro! Todo mundo que trabalha lá ganha uma porção extra de Sidra de Maçã. Pensa bem — se não fosse ruim pra saúde, por que eles iam subornar o pessoal com uma coisa tão boa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "Além disso, eu vi com meus próprios olhos entre os Filhos da Lua Gelada! As Sacerdotisas deles criaram chifres — na cabeça! Você acha mesmo que isso é normal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Entendi... Valeu pelo aviso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "Isso parece horrível! P-Paimon também vai virar um monstro...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "*Suspiro* Sempre mandam os novatos fazerem as coisas arriscadas... Só toma cuidado e não fique lá dentro por muito tempo, beleza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
