				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "É só isso que os poderosos Fatui conseguem fazer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "Tsc, por que os novatos hoje em dia são tão cheios de atitude...? Peraí, você não é um dos recrutas novos que a gente acabou de trazer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "Achou que podia se infiltrar com mentiras? Eu saquei sua farsa na hora — peguem eles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610605,
			"completionStepIds": [
