			"dialogs": [
				{
					"id": 761060701,
					"content": "Nem um pouco. Não sou fraco como você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060702
					]
				},
				{
					"id": 761060702,
					"content": "#Hã!? Por que os novatos hoje em dia são tão cheios de atitude...? Pera aí — você não é um{F#a} {M#dos}{F#das} recrutas nov{M#os}{F#as} que a gente trouxe! V-você é um{F#a} espiã{M#o}!? Pessoal, peguem eles!",
