			"dialogs": [
				{
					"id": 761060101,
					"content": "#Hmm? Você parece meio desconhecid{M#o}{F#a}. Você é nov{M#o}{F#a} por aqui, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
