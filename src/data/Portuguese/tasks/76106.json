			},
			"dialogs": [
				{
					"id": 761060501,
					"content": "É nosso primeiro encontro, mas sou seu inimigo de longa data!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060502
					]
				},
				{
					"id": 761060502,
					"content": "Droga, é um ataque inimigo... Todas as unidades — atacar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
