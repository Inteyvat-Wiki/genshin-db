				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "Perfeito, muito lindo! Sua inteligência e habilidade superaram as minhas expectativas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "Haha, eu me lembro que vários artigos do \"Pássaro a Vapor\" lhe descrevem como... Como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "#{F#Uma}{M#Um}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "#Ha... Haha... {M#Um jovem corajoso}{F#Uma jovem corajosa} que... que está {M#pronto}{F#pronta} para convencer as pessoas com sua espada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "#Ah, absurdo! Ridículo! Como esses repórteres puderam falar algo assim? Afinal, você é {F#uma cavaleira astuta}{M#um cavaleiro astuto}, inteligente, humilde e franc{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "Quando eu tiver tempo, eles vão ouvir o que é bom para a tosse, com certeza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "#Ah, sim. Por favor, fique com esse dispositivo. Quando estiver entediad{F#a}{M#o}, pode usá-lo para se divertir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "Quanto a mim, tenho que começar a juntar Mora que preciso para viajar para Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Continue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
