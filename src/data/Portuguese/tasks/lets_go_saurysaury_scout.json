			"dialogs": [
				{
					"id": 706920101,
					"content": "#Uau, jovem cavaleiro, parece que você trouxe noss{F#a heroína}{M#o herói} com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "\"Maníaca do Mural\""
				},
				{
					"id": 706920102,
					"content": "#É noss{M#o}{F#a} Cavaleir{F#a}{M#o} Honorável e sua Ajudante de Branco! Saudações!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920103,
					"content": "Mika e... amigos de Natlan? O que vocês têm feito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920104,
					"content": "Estamos aqui para divulgar o Batedor Saurianinho, achamos que é algo que será útil para os aventureiros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920105,
					"content": "Combina o mecanismo central que Amber trouxe de Sumeru com o brinquedinho Sauriano que meus amigos de Natlan me deram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920106,
					"content": "Mecanismo de Companheiro... Ah, eu lembro disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920107,
					"content": "Mas, igual aos Exploramigos de Sumeru, o Batedor Saurianinho pode ser usado para procurar por monstros, ou para fazer um mapeamento topográfico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920108,
					"content": "Dito isso, como nosso foco é a segunda função, o batedor foi feito com ênfase no seu controle e precisão de movimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920109,
					"content": "#... Você estaria interessad{F#a}{M#o} em fazer um voo de teste, Cavaleir{F#a}{M#o} Honorável?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920110,
					"content": "Uau, olha só, que introdução séria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "Hã, você não tá muito nervoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920113,
					"content": "Sim... você está bem nervoso, precisa relaxar mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920114,
					"content": "É só que eu já ouvi muito sobre você de meus amigos nas outras nações. Você parece estar cada vez mais impressionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920115,
					"content": "Toda vez que penso como posso lhe ajudar e não ficar no seu caminho, acabo ficando nervoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920116,
					"content": "Que lógica peculiar essa de Mika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920117,
					"content": "Você está indo muito bem, jovem cavaleiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "\"Maníaca do Mural\""
				},
				{
					"id": 706920118,
					"content": "#Em Natlan, às vezes quando um guerreiro de nossa tribo cruza com {NICKNAME}, fica tão animado que começa a falar sem pé nem cabeça. Já vi pessoas ficarem tão nervosas que nem mesmo conseguem dizer uma palavra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "\"Maníaca do Mural\""
				},
				{
					"id": 706920119,
					"content": "#Como alguém que trabalha junto com {NICKNAME}, você também é uma lenda. Na verdade, tenho certeza que você pode falar confiantemente e sem medo até mesmo para nosso chefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "\"Maníaca do Mural\""
				},
				{
					"id": 706920120,
					"content": "Isso mesmo, confie mais em si mesmo, Mika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920121,
					"content": "Hmm, pra falar a verdade, eu nunca havia pensado de acordo com essa perspectiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920122,
					"content": "#Enfim, {NICKNAME}, se você ficar satisfeito com o Batedor Saurianinho durante seus testes, isso significa que esse mecanismo confiável e adorável vai ajudar muitos aventureiros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920123,
					"content": "Eu sou especialista nisso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "Claro! Deixa eu só fazer uns ajustes nele, que você poderá ir com tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920124,
					"content": "Vamos ver o que esse Saurianinho pode fazer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "Não precisa ser tão formal comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}