				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marionette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh? Vocês estão aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180102,
					"content": "Oi, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "#Obrigad{M#o}{F#a} pelo convite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Hã? Sua carta não dizia que teríamos um chá da tarde? Como assim não tem nada aqui? Não me diga que é uma reunião sem lanches!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Haha, aposto que você adoraria isso, Paimon? Você acha mesmo que eu esqueceria a comida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180107,
					"content": "Uau! Essa... Essa mesa acabou de aparecer do nada!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Hehe, impressionante, não é? Esta é minha recém-desenvolvida mesa de chá portátil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180109,
					"content": "É fácil de carregar e guardar, e até vem equipada com um dispositivo de levitação, igual ao de Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180110,
					"content": "O que é ainda mais impressionante é... Hmm, deixa pra lá, não quero ficar me gabando e fazer isso parecer propaganda de venda. Vocês podem conferir por conta própria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180111,
					"content": "Aqui, preparei chá e alguns lanches.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180112,
					"content": "Então vou me servir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Mmm...! Está uma delícia! Você é uma ótima cozinheira mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Naturalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180115,
					"content": "Mas o que te inspirou a criar algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Eu queria poder desfrutar de agradáveis festas do chá com minhas amigas onde quer que elas estejam, é claro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180117,
					"content": "Eu já disse isso antes. Agarrar-se ao que você já tem não é a única forma de preservar o que é precioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180118,
					"content": "Ultimamente, tenho sentido vontade de passear e visitar meus amigos com mais frequência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180119,
					"content": "Mas me convidar para a casa dos outros e esperar que preparem chá e lanches, e depois deixar que arrumem tudo sozinhos... Não é exatamente o comportamento adequado para uma dama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180120,
					"content": "Hehe, a Paimon não acha que seus amigos vão se importar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Eu me importo. Além disso, uma invenção simples como essa não é problema nenhum para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180122,
					"content": "Vejo que vocês gostaram. Não se preocupem, posso fazer um para vocês também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180123,
					"content": "Hã!? Tem certeza de que não tem problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Está perfeitamente bem. Como eu te disse, posso fazer algo assim num piscar de olhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180125,
					"content": "#Nesse caso, muito obrigad{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Não precisa agradecer. Você me ajudou muito durante o Festival Fontinalia. Considere isso como um agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180104,
					"content": "Espero que não tenha esperado muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}