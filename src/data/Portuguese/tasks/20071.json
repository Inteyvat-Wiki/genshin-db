			"dialogs": [
				{
					"id": 200710301,
					"content": "Como estão as flores que foram armazenadas mais cedo na Espinha do Dragão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710302,
					"content": "Tenho todos bem aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710303
					]
				},
				{
					"id": 200710303,
					"content": "Você pegou todas elas? Ótimo! Rápido, quero dar uma olhada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710304,
					"content": "Hehe, elas parecem ótimas! Hm... Parece que esse lugar é bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710305,
					"content": "Entretanto, a distância entre Mondstadt e a Montanha Nevada é muito grande. Não posso ficar lhe importunando com isso toda vez. Devo pensar em alguma outra maneira de como resolver isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710306,
					"content": "Enfim, obrigada pela sua ajuda. Por favor, leve isto como agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
