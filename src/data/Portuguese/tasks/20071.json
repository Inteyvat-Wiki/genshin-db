			"dialogs": [
				{
					"id": 200710101,
					"content": "Como estão as flores que foram armazenadas mais cedo na Espinha do Dragão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "Eu trouxe uma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "Não conseguiu trazer as outras flores? Está bem... No final das contas, é muito difícil prever a situação na montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "Mas se só temos uma, então não podemos fazer nenhuma comparação. Suponho que teremos que esperar por outra oportunidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Mas obrigada por se darem ao trabalho. Aqui, eu preparei isto como compensação - talvez eu precise recorrer a sua ajuda também no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007102,
			"completionStepIds": [
				2007109
			],
