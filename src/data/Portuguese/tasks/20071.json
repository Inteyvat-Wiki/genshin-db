					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200710201,
					"content": "Como as flores estão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710202,
					"content": "Me desculpe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "Hmm? Você gostaria de algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710204,
					"content": "Não tomei cuidado o suficiente e acabei estragando as flores...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "Você... Você estragou as flores?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710206,
					"content": "Ugh... Selecionei essas flores tão cuidadosamente, elas eram tão boas. Não são fáceis de encontrar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710207,
					"content": "#A Montanha Nevada é realmente tão perigosa ao ponto de {F#uma Aventureira}{M#um Aventureiro} como você não conseguir botar uma caixa de flores nela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710208,
					"content": "Entretanto, agradeço a sua ajuda. Por favor, fique com isso, vou cuidar aqui das flores da loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710209,
					"content": "*Suspiro* Vou tentar usar o método de Sara de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
