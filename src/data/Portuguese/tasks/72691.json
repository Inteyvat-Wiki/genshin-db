			"dialogs": [
				{
					"id": 726910301,
					"content": "Ah, é você. Você já terminou de tirar as fotos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910302
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910302,
					"content": "Já tirei as fotos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726910303
					]
				},
				{
					"id": 726910303,
					"content": "Maravilhoso! Muito obrigado. Deixe-me ver... Oh, minha nossa, eu nunca vi nada disso! ...Ah, essa foto é incrível! Essa também parece esplêndida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910304
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910304,
					"content": "#Amig{M#o}{F#a}, suas fotos realmente me dão uma grande inspiração! Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910305
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910305,
					"content": "Agora, estou com vontade de escrever diferentes versos de acordo com a inspiração que suas fotos me trouxeram. Estou bem dividido em qual usar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726910306
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726910306,
					"content": "Na verdade, estou bem curioso. Se fosse você, qual delas escolheria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
