			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230201,
					"content": "Ugh... esse cara cheira a álcool...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230202,
					"content": "#Hmm? Espere, espere, não me diga... {M#O Capitão}{F#A Capitã} do Peixe-Espada II! Certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230203,
					"content": "Você realmente voltou. Achei que tivesse abandonado o pelotão e fugido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230204,
					"content": "Não! Nunca fugiríamos de uma luta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230205,
					"content": "Hmph, é mesmo. Tudo o que se fala hoje em dia é de paz e estabilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230206,
					"content": "Você se lembra o que é mais importante para a resistência?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230207,
					"content": "A vontade de um guerreiro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "#Você entendeu direito. Então, vou colocá-l{M#o}{F#a} à prova. É hora de ver se você realmente é {M#um}{F#uma} verdadeir{M#o}{F#a} guerreir{M#o}{F#a} da resistência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230209,
					"content": "Vou responder às suas perguntas — mas apenas se você puder me vencer em um duelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230210,
					"content": "Ugh, esse cara... Ele morreria se tivesse uma conversa normal...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230211,
					"content": "#O que você acha, podemos fazer isso, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230212,
					"content": "Claro. Dificilmente vamos perder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "Hmph... vamos ver isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230213,
					"content": "Em alguns segundos, você estará implorando para falar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
		{
			"id": 1202303,
			"completionStepIds": [
				1202305,
				1202312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202305",
							"2"
						],
						"stepId": 1202305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouzen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "#Você é {M#um lutador}{F#uma lutadora} forte... Não admira que Vossa Excelência {M#o}{F#a} tenha escolhido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Você realmente tem a vontade de um guerreiro... Então, talvez possa nos entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "#{M#Capitão}{F#Capitã}, camarada... você se juntará a nós?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Primeiro você precisa me dizer o que está acontecendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "Nós inventamos. A história sobre a Comissão Tenryou conspirando com os Fatui... não aconteceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "O QUÊ!? A pobre Kokomi está muito preocupada! Você está nos dizendo que inventou tudo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "O que diabos você estava pensando? Isso pode mandá-lo de volta à guerra com a Comissão Tenryou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Sim. É exatamente isso que esperamos alcançar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Conversas de paz? Pfft.. Todos foram atraídos pela ideia. É por isso que o futuro da Ilha Watatsumi está em jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "O que impede a Comissão Tenryou de nos apunhalar pelas costas? E o que impede a Shogun Raiden de emitir outro Decreto de Caça à Visão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Nós somos a resistência! Tudo depende da vontade de nossos guerreiros!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Não podemos confiar na Comissão Tenryou ou na Shogun Raiden. Mas podemos ter fé em nós mesmos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Tem certeza de que concorda com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Seu ponto de vista meio que faz sentido, mas algo não parece certo para Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "Resumindo... você só quer lutar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Sim! Tudo o que você acabou de dizer foi pura especulação, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Você está seriamente disposto a inventar um boato e arruinar a paz pela qual todos trabalharam tanto, tudo por causa de uma situação imaginária que pode nem mesmo acontecer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Não fale nesse tom comigo, agindo como se estivesse acima de tudo isso! O que você poderia saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Para ter a vitória, incorporamos a vontade do guerreiro ao máximo. Entende? Estávamos todos dentro. Agora, de repente, eles estão tentando nos dizer que nada mais importa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Você me faria largar minha arma e começar a viver como uma pessoa comum, mas como poderia fazer isso? Como poderia, quando... quando cada vez que fecho meus olhos vejo os rostos dos amigos que perdemos na batalha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Toda vez que os vejo ali, na minha mente, isso me lembra que eu nunca posso perdoar a Comissão Tenryou, e nunca perdoar o Decreto de Caça à Visão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "#Acho que você não é {M#um}{F#uma} de nós... Bem, tanto faz. Vá em frente e diga à Sangonomiya se você quiser. Mas é tarde demais para nos deter agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Tarde demais? O que você quer dizer com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "Que inferno, não parece que ele vai responder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#O que vamos fazer, {NICKNAME}? Isto é realmente sério! Temos que informar a Kokomi a história completa imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202306",
							"2"
						],
						"stepId": 1202306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "...Então, descobrimos algumas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "Tudo sobre a Comissão Tenryou conspirando com os Fatui é uma grande bobagem! Eles inventaram tudo isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Eles queriam que as conversações de paz se desmanchassem para que pudessem continuar lutando na guerra. E disseram que é tarde demais para tentar detê-los, não importa o que façamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Oh, entendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Kokomi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "Eu estou bem, não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "Isto é culpa minha. Se ao menos eu tivesse percebido o que eles estavam sentindo antes, nunca teria chegado a isto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "Acho que entendo o que Kouzen quis dizer quando ele diz que é tarde demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "As conversações só começam amanhã, mas ambos os lados já enviaram seus guardas para o local. Eles são responsáveis por garantir que a área esteja segura e protegida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Suspeito muito que um dos co-conspiradores pró-guerra de Kouzen tenha se infiltrado nos guardas com a intenção de reacender as hostilidades amanhã durante as negociações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Bem, isso não é bom. Você quer que nos dirijamos até lá agora e troquemos os guardas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "Isso não vai funcionar. Primeiramente, o ato de trazer uma nova equipe de guardas para um local neutro de negociação colocará ambos os lados em alerta máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Isso quase que certamente pressionaria a facção pró-guerra a tomar medidas. Eles atacariam os guardas da Comissão Tenryou, e estaríamos em perigo de guerra mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "Sem contar que não temos ideia de quantos soldados da Ilha Watatsumi estão envolvidos nesta trama. Se mudarmos os guardas às pressas, enfrentamos a questão de não saber em quem confiar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Parece uma situação realmente complicada... Então, não há realmente nada que possamos fazer a respeito disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Não deixe que isso te preocupe, o que está feito, está feito. Mm... Agora cabe a mim elaborar um plano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Estes soldados ultrapassaram uma linha, mas a culpa não é só deles. Aconteça o que acontecer, encontrarei uma maneira de garantir que eles não venham a ser prejudicados...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Vamos nos encontrar aqui novamente amanhã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "Tá tudo bem com você?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
		{
			"id": 1202305,
			"completionStepIds": [
