			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Parece que está tudo pronto para o banquete. Mas ainda preciso fazer um rápido discurso antes do início das festividades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Oh... Quanta energia isso vai consumir? Você acha que tem o suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Não se preocupe, tenho muita. Graças a vocês, me recuperei mais rápido do que o normal",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "Isso é ótimo! Estaremos torcendo por você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Sejam todos bem-vindos. Hoje é o dia em que celebramos nossa vitória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Recentemente, nossa guerra com o Exército da Shogun chegou ao fim e finalmente vimos a abolição do Decreto da Caça à Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Nenhum de nós sabe como será a Inazuma do futuro. Mas amanhã eu me encontro com a Comissão Tenryou para negociações de paz. Dou minha palavra de que lutarei pela paz na Ilha Watatsumi, de uma vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Agradeço a todos por seus valentes esforços. Na verdade, é somente por meio desses esforços que temos sido capazes de prevalecer nesta guerra difícil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Este banquete é realizado em homenagem a cada um de vocês aqui reunidos hoje. Espero que todos possam relaxar e aproveitar nossa vitória arduamente conquistada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Uhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Esta noite parece ter passado sem problemas. Estou feliz que tudo esteja indo bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#As pessoas tendem a ser mais abertas quando estão de bom humor. Posso pedir que você dê uma olhada e veja quais informações consegue reunir, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Ainda não tenho mais pistas sobre a questão do conluio potencial entre a Comissão Tenryou e os Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "E estou preocupada que algo possa acontecer nas negociações de paz de amanhã...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Ok, claro. Vamos perguntar por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202302,
			"completionStepIds": [
				1202303
