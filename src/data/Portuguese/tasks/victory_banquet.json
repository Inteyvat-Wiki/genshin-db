			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "A Ilha Watatsumi está finalmente em paz, e tudo graças a Vossa Excelência, Sangonomiya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "Tem acontecido alguma coisa ultimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Ultimamente? Hum, deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Bem, a melhor coisa para nós é que finalmente podemos voltar ao oceano para pescar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Durante as hostilidades, o mar aberto estava cheio de navios de guerra. Só tínhamos que nos contentar com os pequenos peixes e camarões que podíamos apanhar mais perto da costa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Quando a pescaria não era boa, todos passávamos fome. As pobres crianças choravam dia e noite, mas não havia nada que eu pudesse fazer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Íamos para a cama esfomeados e ficávamos rodando e virando a noite toda - tentando manter-se firme até a manhã. Pelo menos as coisas estão finalmente melhorando agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "#Ouvi dizer que você é {M#o Capitão}{F#a Capitã} do Peixe-Espada II, não é verdade? Bem, obrigado pelo seu serviço. Aqui, coma um peixe! É recém-pescado, então é um pouco, uh, molhado, mas está bom.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Oh... Não, não, não, n-nós não poderíamos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Ah, vamos lá, pegue-o! Sem você, provavelmente ainda estaríamos indo para a cama com fome hoje à noite. Vossa Excelência sempre nos ensina a retribuir a gentileza com gratidão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Ok, bem, obrigada. Vamos, {NICKNAME}, vamos conversar com alguns outros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
