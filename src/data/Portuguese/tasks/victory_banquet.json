				{
					"id": 120230601,
					"content": "Olá, quer frutas e legumes frescos? O remédio da natureza quando você exagera no churrasco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "Tem acontecido alguma coisa ultimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Você está se referindo à coisa sobre a Comissão Tenryou e os Fatui? Ouvi rumores, mas nada muito detalhado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "No entanto, é engraçado que você diga que os soldados parecem exaltados. Tive a mesma sensação. Vê aquele cara ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "Ele tem agido de forma estranha estes dias - sempre gritando e balançando sua lança quando não tem nada para fazer. Ele tem me assustado algumas vezes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Urg... É um milagre que a luta tenha finalmente chegado ao fim. Realmente espero que não causemos mais problemas para nós mesmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "Lamento, mas receio não ter muitas informações. Se você ainda tiver dúvidas, é melhor ir falar com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "#Parece promissor. Vamos ver qual é a desse cara, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
