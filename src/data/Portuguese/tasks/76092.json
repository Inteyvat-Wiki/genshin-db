			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "É melhor continuar correndo, amigão! Este lugar é muito perigoso. Se a Caçada Feroz aparecer, não posso garantir que vou conseguir te proteger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "Como você sabe que a Caçada Feroz vai aparecer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "Como Guardião da Luz, enfrentar a Caçada é meu dever sagrado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "Está vendo aquela Pedra Sela-Maré? Para garantir que a Caçada seja completamente erradicada, preciso montar guarda aqui por três dias e três noites.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Pedra Sela-Maré?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Essas Pedra Sela-Maré são selos colocados por nós, os Portadores da Lâmpada, para dissipar a permeação da Caçada Feroz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Embora eu não saiba exatamente como funciona, se a permeação deixada pela Caçada Feroz não for contida, ela tende a atrair a Caçada de volta para o mesmo local.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "É por isso que normalmente colocamos essas pedras em áreas onde a Caçada Feroz foi rechaçada. Se a Caçada retornar, as pedras também podem nos proteger em batalha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "Eu não tenho medo da Caçada Feroz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "Não sei de onde vem essa sua confiança, mas a Caçada não é um inimigo que se deva subestimar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Deixe-me lhe dar um conselho. Quando encontrar locais com essas Pedras Sela-Maré, é melhor prosseguir com cautela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Não vou mais incomodar você.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Nos vemos. Cuide-se na estrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
		{
			"id": 7609202,
