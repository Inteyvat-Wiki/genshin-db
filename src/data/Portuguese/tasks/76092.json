			},
			"dialogs": [
				{
					"id": 760920201,
					"content": "\"A noite estrelada e a lua, silenciadas serão. Amassamos sangue e osso como combustível, e assim proclamamos: A Longa Noite flui escura e profunda. Com estas lanternas que empunhamos, nenhum espectro despertará de seu sono. Pelos espíritos lunares, este pacto está selado.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verificar"
				}
			]
