			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "Deixa comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740202,
					"content": "Olá, irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740203,
					"content": "Que o Barbatos abençoe você, jovem bardo. Como posso ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740204,
					"content": "Na verdade, eu sei de um segredo que pode ajudar Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740205,
					"content": "Oh, deve ser uma bênção do Arconte Barbatos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740206,
					"content": "Mas você precisa reportar isso aos Cavaleiros de Favonius. Por que você veio até mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740207,
					"content": "Hahaha, porque você, irmã, é quem pode ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740208,
					"content": "Eu queria pegar emprestado... A Lira Sagrada. Com ela eu serei capaz de ajudar o Stormterror...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740209,
					"content": "Retirem-se por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740210,
					"content": "Quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740211,
					"content": "Ele é de fato um dragão malvado, mas a Grande Mestre Intendente é firme em suas decisões. Não há nada que possa impedir o caminho dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740212,
					"content": "Mas desse jeito o Stormterror teria sido morto. Não podemos fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740213,
					"content": "Aquela besta traiu os ventos. Nem mesmo o Arconte Anemo perdoaria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740214,
					"content": "Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740215,
					"content": "Por favor, eu te imploro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740216,
					"content": "Infelizmente não posso, jovem bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740217,
					"content": "(Estranho... Me senti tão mal rejeitando este jovem...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740218,
					"content": "Hum... Acho que só resta um maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740219,
					"content": "Eu não posso esconder mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740220,
					"content": "Meus fiéis discípulos, se regozijem! Eu, <color=#00E1FFFF>o Arconte Anemo, Barbatos</color>, desci dos céus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740221,
					"content": "Vocês estão chocados? Vocês não querem chorar de alegria? Qual é a sensação de encontrar o Deus que vocês têm servido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740222,
					"content": "Se vocês não precisarem de mais nada, eu tenho que voltar aos meus trabalhos da Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740223,
					"content": "Espere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
