			"dialogs": [
				{
					"id": 3740301,
					"content": "Er? Ela nem sequer piscou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Mas de fato, eu já descobri o queria saber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "Pelo menos, ela não negou que a Lira Sagrada se encontra resguardada na Catedral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#Agora, {NICKNAME}, você é a nova estrela dos Cavaleiros de Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "Que tal se você tentar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
