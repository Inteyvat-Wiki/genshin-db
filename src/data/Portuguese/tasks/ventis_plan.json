					"nextDialogs": [
						3740702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740702,
					"content": "Um dos tesouros mais valiosos de Mondstadt. É a lira que o Barbatos costumava tocar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740703,
					"content": "Com ela, talvez eu possa salvar Dvalin dos pesadelos que ele está passando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740704,
					"content": "Isso realmente vai impedir Stormterror de continuar causando mais dano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740705,
					"content": "Claro, eu sou o melhor Bardo do mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740706,
					"content": "Não há uma única música que eu não saiba, não importa se é do passado, presente ou futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740707,
					"content": "Olhe nos meus olhos, você não confia em mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740708,
					"content": "...É um pouco suspeito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "Hahaha, isso não funciona com um Bardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740712,
					"content": "Então, como nós podemos pegar a Lira Sagrada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740713,
					"content": "Dizem que ela foi colocada no local mais profundo da Catedral, um lugar muito seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740714,
					"content": "Eu vou dar uma olhada. Você pode vir, se quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740709,
					"content": "Olhe dentro dos meus olhos. O que você está escondendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "A cor dos seus olhos lembra o céu da minha terra natal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
