			"dialogs": [
				{
					"id": 3740401,
					"content": "Que o Arconte Anemo abençoe você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740402,
					"content": "Olá.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "#Você é {M#o}{F#a} nov{M#o}{F#a} membro dos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740406,
					"content": "Então, o que traz você aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740411,
					"content": "Sim, os Cavaleiros de Favonius precisam da Lira Sagrada emprestada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Isso é verdade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740413,
					"content": "Não é que eu não confie em você, é que um bardo veio pedir a Lira Sagrada emprestada também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740414,
					"content": "Ele falou um monte de coisas, até mesmo se disse ser o Barbatos. Ele deve estar planejando alguma coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740415,
					"content": "Existem algumas regras para o uso da Lira Sagrada. Atualmente só pode ser usada durante o Ludi Harpastum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740416,
					"content": "Além disso, também é preciso de documentos assinados pela Grande Mestre, o Seneschal e o Representante da Comunidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740417,
					"content": "Então, posso ver o documento dos Cavaleiros de Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740418,
					"content": "A Grande Mestre não mencionou nada disso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "Enfim, é necessário um documento assinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740423,
					"content": "Agora, se você me der licença, eu estou muito ocupada ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740419,
					"content": "Desculpe, eu esqueci de trazer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "A Paimon comeu pelo caminho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Ei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Eu sou {M#o}{F#a} {NICKNAME}, Cavaleir{M#o}{F#a} Honorável dos Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "Eu conheço você. Você e a Amber salvaram Mondstadt aquele dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				}
			]
		},
