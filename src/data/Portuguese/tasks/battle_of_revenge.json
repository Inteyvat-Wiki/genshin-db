			"trigger": {
				"objectNames": [
					"\"Kairagi\"",
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "Ei! Por favor, poupe-me! De onde você conseguiu essa ajuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040207,
					"content": "Vigarista! Devolva minha arma imediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Você ainda está tão irritado com isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040209,
					"content": "Eu só estou aqui para pegar minha arma de volta. Diga-me onde ela está que eu lhe pouparei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040211,
					"content": "Pare de falar besteira com ele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "Não, por favor! Pare! Eu não disse que não diria nada! Não precisamos de toda essa violência!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040214,
					"content": "Aquela arma foi pega pelo nosso chefe como parte de sua coleção. Se você quer ela de volta, vá até aquele acampamento e pegue-a com ele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040215,
					"content": "Pelo menos você tem alguma consciência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "Por favor, vocês dois, eu já lhes disse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040217,
					"content": "Vai embora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "Sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040219,
					"content": "Não é tão forte assim, mas corre muito bem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Sem mencionar que ele entregou seus companheiros bem rápido...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Os Kairagis são, no final, um bando de vagabundos que se juntaram para seu próprio ganho. Não há lealdade, nem convicção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "No momento que os problemas surgem no horizonte, eles fogem. Isso é muito comum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Mas, felizmente, eu tinha você aqui para me ajudar. Duvido que tivessem desistido tão facilmente caso contrário.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Mas em seguida, nós precisamos imediatamente atacar o quartel-general dos Kairagis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "Ainda estamos seguindo o mesmo plano de antes, vossa senhoria. Eu atacarei diretamente o líder deles, e deixarei os peixeis pequenos para ti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Então deixarei isso com você, vossa senhoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "#Eu posso derrotar dez sozinh{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Vamos procurar outra pessoa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280405",
							"2"
						],
						"stepId": 7280405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Líder \"Kairagi\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Você? Hahaha, é você de novo, bastardo? Veio me dar outra coisa preciosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040302,
					"content": "Eu estou aqui para recuperar minha arma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "#Bem, pelo menos você tem coragem. Mas trouxe somente {F#uma}{M#um} aliad{F#a}{M#o}, mesmo? Você deve achar que sou um idiota, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040304,
					"content": "Mas, quer saber? Lhe darei uma chance, devido a sua bravura. Venha! Vamos resolver isso noutro lugar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040305,
					"content": "#Ainda assim... Não seria bom deixar meus rapazes aqui com nada para fazer, seria? Já sei! Por que você não pede para ess{F#a}{M#e} assistente {F#sua}{M#seu} divertir eles um pouco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040306,
					"content": "Podem atacar quando quiserem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "#Hahaha, você é muito presunços{F#a}{M#o}! Bem, rapazes, vocês {F#a}{M#o} ouviram, ataquem-{F#as}{M#os}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040309,
					"content": "E quanto a você, vamos até ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040310,
					"content": "Bem, deixarei com você, vossa senhoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Você tem meu mais profundo agradecimento. Derrotarei ele rapidamente e voltarei para lhe ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Que atitude! Fique a vontade para tentar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Líder \"Kairagi\""
				},
				{
					"id": 728040307,
					"content": "Espero que o melhor deles seja aceitável.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280407",
							"2"
						],
						"stepId": 7280407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "Vossa senhoria, pela sua respiração, parece que aqueles Kairagis não foram páreos para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "Parece que você também ganhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Esse é o caso. Apesar de dever admitir que, para minha vergonha, permiti que escapasse com apenas um único golpe de minha lança devido a um plano seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Mas ele foi ferido gravemente. Creio que ele não poderá causar problemas pelos próximos anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "Mais importante, derrotei ele e consegui minha arma de volta. De agora em diante, estou livre da mancha daquela humilhação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Parabéns, Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Estou profundamente agradecido, mais ainda não posso relaxar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "A razão para todo esse incidente foi a minha falta de treinamento. Continuarei a treinar e refinar minhas habilidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "Por isso, peço a vossa senhoria que tenha muito cuidado, para que possa sempre vir duelar junto comigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Oh, sim. Aqui está a sua recompensa, vossa senhoria. Apesar de não ser muito, contém minhas intenções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Mais uma vez, obrigado, vossa senhoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}