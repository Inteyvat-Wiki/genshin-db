					{
						"sceneId": 3,
						"position": [
							-1306.066,
							241.062,
							7740.411
						],
						"pointId": 8923
					}
				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "Hehe, legal! Vencemos! Valeu nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Haha... Uh. Reconheço que nem o melhor guerreiro em nossa tribo pôde derrotar vocês... Essa foi uma derrota justa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "O que acha, hein, amigão? Parece que precisamos treinar mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Raooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchul"
				},
				{
					"id": 750190706,
					"content": "Foi realmente uma batalha fantástica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190707,
					"content": "Palavras bonitas, Manco, mas isso é tudo que você consegue? Quer tentar também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Não, muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190709,
					"content": "#Argh. Que chato. Ah, foi uma ótima partida! {NICKNAME}... Você se garante demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Eu só tava me aquecendo, beleza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Hahaha! E arrogante também! Mesmo assim, admiro isso. Os fortes também devem afirmar um pouco sua dominância! Digo, qual é o propósito de ficar forte senão esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, parece que você é mesmo bem cuidado {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Claro! {REALNAME[ID(2)|SHOWHOST(true)]} é nosso companheiro confiável, sabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Isso é ótimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Como prometido, essa é a prova de sua conquista do nosso chefe tribal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Quanto ao seu nome oficial — bem, Manco, essa é sua deixa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "O Talismã de Waxaklahun Ubah Kan... O Sábio da Chama Roubada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190721,
					"content": "Sim, eu nunca consigo memorizar esse nome, mas lembro que após a morte do Dragão Soberano Pyro, e após a primeira Arconte Pyro ser revivida das chamas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "O Sábio e a Arconte trouxeram cada um um amuleto do vulcão, e quem obtiver ambos pode entrar no fogo purificador dentro do vulcão e expurgar maldições e calamidades.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Mesmo assim, quanto tempo esse Sábio viveu mesmo, Manco? Sinto que há contos dele da era tribal de Ochkanatlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "...E até o Prego das Sombras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Bem, ele foi o primeiro humano a usar Flogisto... e quem sabe qual destino recaiu sobre figuras tão lendárias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190726,
					"content": "Alguns dizem que tanto seu corpo quanto espírito se transformaram em Flogisto, se tornando um com os ventos, terras e flores de Natlan, concedendo a ele o poder de ouvir todas as preces por ajuda direcionadas a ele por todas as tribos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190727,
					"content": "Alguns dizem que cada era possuía seu próprio sucessor ao título de sábio, passando até os dias de hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190728,
					"content": "Mas — perdoe minha franqueza — isso em sua maioria são especulações de contadores de história.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190729,
					"content": "Haha, cuidado com o que diz. Você vai deixar Titu com raiva de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Muito bem. Meus deveres estão cumpridos— oh, espera aí, a tradição exige mais uma coisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Que é conceder a essa corajosa alma viajante e seus companheiros a minha bênção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Ooh, então isso também é um ritual que todos vocês fazem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Heh, é só apoio moral. Não tenha tantas esperanças.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Certo, então, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Aqui estou, chefe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Que você voe pelas montanhas como um pássaro resiliente;\\nQue as marés mais perversas caiam sobre você como se você fosse a pedra mais dura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Que você não tema dificuldades, pois o mundo está repleto disso.\\nQue vocês nunca esqueçam uns aos outros, pois o destino pode trazer um adeus inevitável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "Que você alcance o destino e consiga o que deseja... E mais importante, espero que você retorne com segurança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Irei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Hã? Espera, Paimon recebe alguma bênção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Haha! Quanto a você, pequena Paimon... Que você coma e beba bem, durma bastante e cresça muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "Isso parece ótimo para mim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Enfim, Paimon aceita essa bênção — tudo bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Por mim tudo bem. Nesse caso, o rito de testemunho acabou. Mas antes que você vá, deixe-me repetir novamente: tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
