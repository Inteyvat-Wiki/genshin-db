				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manco"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "De novo, perdoa a franqueza... Mas enquanto estou ciente de sua força, tenha cuidado mesmo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190602,
					"content": "Ele não obteve um Nome Antigo, mas Pacal não deve ser subestimado... Contanto que ele tenha continuado seu treinamento nesses últimos anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190603,
					"content": "#Se estiver pront{M#o}{F#a}, podemos começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manco"
				}
			]
		},
		{
			"id": 7501907,
			"completionStepIds": [
				7501907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
