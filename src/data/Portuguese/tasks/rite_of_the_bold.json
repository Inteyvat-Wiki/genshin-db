			"dialogs": [
				{
					"id": 750190301,
					"content": "...Não podemos discutir sobre isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190302,
					"content": "Manco, olhe para mim. Você não ouviu o que Titu disse? Ninguém tentou esse feito em quase 500 anos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Mesmo que você diga que encontrou uma possível entrada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Bem, e daí? Escute bem — nenhum humano ou companheiro Sauriano que saiu por esse caminho jamais retornou. Nem um único.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Uh, me perdoe a franqueza, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190306,
					"content": "Bem, ali está nosso cara da Associação de Relíquias Saurianas. E ali é... aquele é o chefe tribal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "Ei! Cara das Relíquias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Ah, é você, {NICKNAME}... Paimon e {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190309,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Uh, um Tepetlissauro com um lenço vermelho na cauda! Super energético e se parece diferente logo de cara! Muito bem, rapazinho, manda brasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Nada mal! Então você é {REALNAME[ID(2)|SHOWHOST(true)]}? E imagino que vocês sejam quem ele escolheu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#Não andam falando tanto sobre vocês ultimamente, {NICKNAME} e Paimon? Manco anda falando sobre vocês constantemente, e Titu mencionou sobre você depois que voltou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "#Não seria exagero dizer que seus feitos recentes são \"lendários\", e que você, até então, tem sido {M#um amigo}{F#uma amiga} para nós, Filhos dos Ecos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "Não precisa me agradecer demais.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "Haha, que jovem fenomenal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "E é nessa capacidade, Manco, que estou te dizendo — não é o nosso jeito empurrar convidados a um poço flamejante apenas para provar uma hipótese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "Não é assim que eu trataria meus convidados, pelo menos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "*Suspiro*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190321,
					"content": "O que é isso tudo mesmo, hein? Algo sobre perigo e um poço flamejante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Perdão. Permita-me explicar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190323,
					"content": "Lembra sobre o que falamos mais cedo? Para remover a marca da Bênção do Lorde das Chamas, você precisa levar dois tipos de amuleto necessários ao vulcão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190324,
					"content": "Um dos amuletos está nas ruínas além das terras dos Filhos dos Ecos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190325,
					"content": "Mas há condições para entrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "Baseado nesse costume passado... Que eu apenas descobri em um pergaminho, por sinal, já que fazem eras desde que alguém tentou fazer isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "Se você deseja levar seu companheiro Sauriano ao vulcão para formar um batismo e purificar a Bênção do Lorde das Chamas, você deve ser reconhecido pelo chefe tribal correspondente do dito Sauriano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#Com {REALNAME[ID(2)|SHOWHOST(true)]} sendo um Tepetlissauro, isso significa o chefe dos Filhos dos Ecos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "E não é você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Bem, sim, embora serei sincero, não sei se essa regra se aplica a forasteir{M#os}{F#as}. Mesmo assim, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "Por centenas de anos, muitos daqueles que tentaram liberar seus companheiros Saurianos do que existe em suas linhagens, essa coisa é mais maldição do que bênção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "Mas nenhum sequer teve sucesso... Que é por isso que as tribos gradualmente abandonaram esse costume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "Taxa de sucesso de zero porcento, sério?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Sim, a jornada é perigosa assim. Também dizem que o julgamento antes de se obter o amuleto testará não apenas o guerreiro que o iniciar, como também o Sauriano com ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "Você não é das tribos, mas eu não te deixarei morrer em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#Então, por favor, {NICKNAME}, sugiro que você deixe {REALNAME[ID(2)|SHOWHOST(true)]} aqui conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "Pelo menos, posso garantir que será bem cuidado até o dia que ele entre no Reino da Noite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "Mas... Se a gente fizer isso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#...Como eu disse, {REALNAME[ID(2)|SHOWHOST(true)]} será incapaz de crescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190346,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "Parece que não é isso que ele quer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "Vou tentar mesmo assim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Apesar do imenso perigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "E quanto a você, pequenino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "#Hahaha! Inflexíveis, decidid{M#o}{F#a}s, porém determinad{M#o}{F#a}s. Seus corações queimam como um belo Flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Tudo bem, então. Concederei a vocês o direito de embarcar na peregrinação vulcânica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Beleza! Vamos pegar aquele primeiro amuleto, então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "#Não, ainda não. Agora que estão qualificad{M#os}{F#as}, devem passar num julgamento de testemunhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190358,
					"content": "Costumes antigos ditam que o guerreiro e o Sauriano devem obter a pena de um quetzal verde nas profundezas da floresta e oferecer uma estola de couro de animal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190359,
					"content": "E juntos, vocês devem vencer cinquenta batalhas por nossa tribo e oferecer noventa e seis gemas de alta qualidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manco"
				},
				{
					"id": 750190360,
					"content": "Argh, eu não seria elegível...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Ora, Manco, esqueça. De onde são essas tradições? Alguma idade da pedra pedida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "O propósito dessas formalidades é fortalecer o vínculo entre humano e Sauriano, e melhorar suas habilidades — e já basta para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#Do jeito que vejo, nem {NICKNAME} nem {REALNAME[ID(2)|SHOWHOST(true)]} parecem precisar desse tipo de prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#Para resumir, {NICKNAME}, temos aqui em Natlan uma maneira super simples de lidar com tais situações...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Lute comigo e prove sua força!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "Dale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Espera? Agora? Quer dizer que a gente vai subir no palco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Claro que não, haha, o palco não é lugar para cavar... Nossa área de duelo fica na montanha na parte de trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Venham, vamos para lá — vai ser um bom duelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Dá pra ter um descontinho em Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7501908",
							"2"
						],
						"stepId": 7501908,
						"stateName": "QUEST_STATE_UNFINISHED"
