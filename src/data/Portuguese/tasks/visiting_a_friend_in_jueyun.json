			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "*Suspiro* Por favor diga-me que não perdi no pico da montanha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170102,
					"content": "Oi, vovó. O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Ai! Meus filhos! Que coincidência! Não imaginei que iria os encontrar aqui! Deviam ter usado mais roupas, está ventando ali no pico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170104,
					"content": "Eu fui encontrar com um velho amigo na Montanha Hulao, tivemos uma conversa sobre passado. Estou no caminho de volta para a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170105,
					"content": "Mas no meio do caminho, eu percebi de repente que perdi alguma coisa, talvez tenha sido na Montanha Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170106,
					"content": "Mas não creio que consiga ir duas vezes por dia para uma velhinha fraca, ainda por cima, há monte de âmbares incomodando lá na montanha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170107,
					"content": "Filhos, vocês podem por favor ir à Montanha Hulao por mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170108,
					"content": "Quem é o seu amigo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "*Suspiro* É aquele que mora na Montanha Hulao, vocês devem ter visto. O âmbar dele é um perturbador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170110,
					"content": "A minha memória é mesmo muito má. Sério! Eu até tinha me esquecido de colocar a caixa no bule antes de ir embora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170111,
					"content": "O que você deixou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Uma caixa... acho eu. A minha memória não é o que era... Eu devia ter colocado diretamente no bule, e evitado esse trabalho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170113,
					"content": "Mas se a minha caixa realmente fosse deixada na Montanha Hulao, possivelmente estava retida no âmbar. Então não é tão difícil encontrá-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170114,
					"content": "Filhos, por favor vão lá na Montanha Hulao, e procurem a minha caixa no âmbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170115,
					"content": "Olhe, prestem muita atenção. Ninguém sabe quais coisas foram encaixadas dentro do âmbar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 2211703,
			"completionStepIds": [
				2211703
			],
