				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "#Oh, você devia ter usado mais roupas. Sinto-me culpada se você ficar gripad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170302,
					"content": "Oi, vovó! Isto é o que você perdeu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Deixe-me ver! Sim sim! É isto. Então eu realmente perdi na montanha, que memória...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170304,
					"content": "Não vale a pena ver o interior, são tudo coisas antigas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170305,
					"content": "#Estes, por outro lado, são para você. Obrigado, querid{M#o}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170306,
					"content": "Ugh, tenho que colocá-la já no bule para não esquecer de novo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
