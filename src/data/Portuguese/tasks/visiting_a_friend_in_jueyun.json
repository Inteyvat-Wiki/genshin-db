			"dialogs": [
				{
					"id": 221170401,
					"content": "#Oh, você devia ter usado mais roupas. Sinto-me culpada se você ficar gripad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170402,
					"content": "Por favor diga-me mais sobre o âmbar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "Foi o meu amigo que fez. Ele diz que é para capturar monstros e bandidos no caminho de invasão...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170404,
					"content": "Com tempo... e agora ainda há muitas coisas peculiares dentro do âmbar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170405,
					"content": "Ugh, realmente é uma substância terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170406,
					"content": "E aquela chaleira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Oh. Graças a Deus, o meu bule agora está como se fosse novo. Muito obrigada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170408,
					"content": "De fato, toda a razão pela qual vim até aqui para buscar essa coisa foi abrilhantar o meu bule um pouco mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 221170409,
					"content": "Só quando estiver no estado perfeito, posso convidar os meus amigos para um copo de chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		}
