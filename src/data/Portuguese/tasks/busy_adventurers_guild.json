			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "Desculpa por incomodá-lo novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050102,
					"content": "Não tem problema, estou sendo bem cuidado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "Estou muito feliz ouvindo disso. Vou tentar te dizer de uma maneira mais rápida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050106,
					"content": "Somos muito gratos pela conclusão de sua missão até o momento. A reputação da guilda ficou mais forte como resultado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050107,
					"content": "Mas, outra consequência foi que nós recebemos um número sem precedentes de pedidos - mais do que podemos lidar atualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050108,
					"content": "Você quer que façamos algum recrutamento para você?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050109,
					"content": "Seria fantástico ter alguns novos membros, mas... Não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050110,
					"content": "Mas lutar para encontrar novos recrutas nesse estágio não resolveria realmente nossos problemas imediatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050111,
					"content": "Eu queria perguntar se seus amigos têm tempo para ajudar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050112,
					"content": "Eu preciso confirmar com eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "#Excelente, obrigad{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050117,
					"content": "Agora mesmo, precisamos urgentemente encontrar pessoas para as nossas <color=#00E1FFFF>expedições</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050118,
					"content": "Expedições?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "Organizamos expedições para explorar as áreas da cidade e da região. É uma maneira de nos mantermos informados sobre quaisquer perigos emergentes, atividades incomuns nas ruínas e assim por diante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050120,
					"content": "Não tem um prazo para completar, como não é comissionado por terceira parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050121,
					"content": "Mas se você os ignorar, é por sua conta e risco. Se os problemas se acumularem até ficar sem controle, eles podem ter consequências desastrosas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050122,
					"content": "Então é bastante importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050123,
					"content": "Tenho certeza de que meus amigos vão entender.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "O que precisa fazer é convencê-los a ajudar, tratarei do resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050127,
					"content": "Agora, sem mais delongas, deixe-me mostrar-lhes as expedições disponíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050128,
					"content": "Confirmar as Expedições",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "E quanto a compensação?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "Fique tranquilo. a Guilda não cobrará nada na expedição. Todos vão para você e os seus amigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050114,
					"content": "Você está tentando convencer todos os meus amigos a entrar na Guilda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "Não, não, não foi isso que eu quis dizer. Sei que seus amigos estão ocupados com outras coisas, e pedir que se tornem membros oficiais pode ser impraticável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050116,
					"content": "Meu pedido é do tipo mais presunçoso... A Guilda precisa de um favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050104,
					"content": "Há uma nova recompensa para mim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "#Haha... Bingo! E imagino que você está muito interessad{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "Você pode aceitar missões de expedição a qualquer momento, e os companheiros que realizam as missões também podem se juntar à sua aventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "A duração de uma exploração varia dependendo do seu grau, só venha cá para confirmar o resultado depois de ter a concluído.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "À medida que o seu Rank de Aventura aumenta, mais expedições perigosas ficarão disponíveis para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "Afinal de contas, o grande poder vem com grande responsabilidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "E claro, isso é para a segurança de todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "#Obrigad{M#o}{F#a} novamente por sua ajuda. Espero que você e seus amigos possam ajudar com nossas expedições o máximo possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}