					"speakerTitle": "Damselette"
				},
				{
					"id": 760540302,
					"content": "Hmm, deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540303,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540304,
					"content": "Luas... Luas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540305,
					"content": "Que tal aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540306,
					"content": "Parece que eu venci esta rodada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540307,
					"content": "Minhas três luas estão conectadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540308,
					"content": "Mm, isso deve garantir a vitória.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540309,
					"content": "Mm... As luas crescem e minguam em um ciclo sem fim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540310,
					"content": "Parece que ambos os conjuntos de luas se recusam a ser eclipsados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540311,
					"content": "Será que estamos... caminhando para um empate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540312,
					"content": "Ah, vejo que você pesa bem suas decisões antes de tomá-las. Leve o tempo que precisar. Afinal, temos de sobra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540313,
					"content": "Esqueceu como posicionar suas luas no céu noturno? Quer que eu ajude?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540314,
					"content": "Você não gosta deste jogo? Hm... Eu o acho bem divertido, na verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540315,
					"content": "Mm? Você está me encarando? Seu olhar não é nada sutil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540316,
					"content": "Está me encarando... Será que a verdade das luas está escrita no meu rosto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540317,
					"content": "O tabuleiro está ali, a propósito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540318,
					"content": "Hm, suas luas estão alinhadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540319,
					"content": "O céu noturno é seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540320,
					"content": "Ah... Acho que eu devo ter... cometido um deslize em algum momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540321,
					"content": "Você se divertiu muito jogando com a Columbina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Obrigada, eu gostei bastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540323,
					"content": "Se quiser... sinta-se à vontade para vir me fazer companhia novamente, algum dia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760540324,
					"content": "Aqui, pegue isto como um símbolo da nossa promessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
