			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Talvez <color=#FFCC33FF>Lauma</color> esteja interessada em esculturas de açúcar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Você poderia fazer algumas para mim, por favor, Srta. Hunajatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Sem problema, Srta. Lauma. As crianças gostaram do lote que você levou da última vez?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Hehe, gostaram sim. Na verdade, alguns só foram convencidos a arruinar suas lindas guloseimas quando elas já estavam quase derretendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Entendo... Quer saber? Da próxima vez, vou levar minhas ferramentas e ir até vocês. Montar uma estação ao vivo pras crianças, sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Ah, isso seria adorável. As crianças vão ficar tão felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Ah, e, hã... acho que estamos fugindo do assunto, né? Vou preparar suas esculturas de açúcar. Quando estiverem prontas, vou pedir para alguém entregá-las aos Filhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Mas antes disso... Hehe, tive uma ideia ótima~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Um instante, Srta. Lauma. Vou preparar algo especial para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
