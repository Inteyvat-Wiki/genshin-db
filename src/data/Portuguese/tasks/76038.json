						760380909
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380909,
					"content": "Ficou ótimo. Obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "Damselette"
