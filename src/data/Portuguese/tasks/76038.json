					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380409,
					"content": "(Talvez <color=#FFCC33FF>Flins</color> tenha interesse em esculturas de açúcar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Srta. Hunajatta, se não for incômodo, você poderia fazer uma escultura de açúcar para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Ah, claro. Você é... Flins, o Ratniki, certo? Acho que já te vi na nossa loja antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "De fato. Às vezes passo aqui para comprar suprimentos. É uma honra e um privilégio ser lembrado assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Quanto a hoje, eu simplesmente estava de passagem quando presenciei sua maestria em moldar açúcar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "E após muita consideração, decidi que preciso que você esculpa uma porção para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Ah, por favor, não precisa ser tão formal assim. Você tá me deixando sem graça~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Espere só um instante, uma porção saindo já.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Hmm. Talvez devêssemos fazer algo especial para o nosso bom Ratniki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
