					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380908,
					"content": "Hmm... Terminei. Dá uma olhada, gostou?",
