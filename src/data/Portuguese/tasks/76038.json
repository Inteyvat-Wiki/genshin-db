			"dialogs": [
				{
					"id": 760380201,
					"content": "Uma escultura de açúcar, por favor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "Aqui está. Coma rapidinho depois de abrir, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
