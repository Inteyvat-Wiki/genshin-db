						760380911
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380911,
					"content": "(Sim, meu instinto estava certo, esse estilo leve e etéreo combina mesmo com uma menina tão leve e etérea!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380912,
					"content": "Mmm, também é bem gostoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760380913,
					"content": "Você poderia fazer mais dois? Quero levar para os kuuhenki experimentarem também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760380914,
					"content": "Para... os kuuhenki também? Olha, eu até poderia, mas não tenho ingredientes suficientes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Então, eu volto amanhã e trago eles comigo.",
