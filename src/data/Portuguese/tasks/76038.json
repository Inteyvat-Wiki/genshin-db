					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Oi, Chefe! Uma escultura de açúcar, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Ah, Srta. Aino! Faz um tempinho, né~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Hehe. Passei por aqui pra ajudar a consertar umas coisas. Pensei em dar uma passada e pegar uns docinhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Ah, e como a Ineffa não tá por perto... faz umas porções a mais pra mim? E capricha no doce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Bom, tudo bem... mas tem que escovar os dentes depois que terminar de comer, tá?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Sim, sim, eu sei, eu sei. Eu sempre escovo os dentes depois de comer doce! Meus dentes são super mega ótimos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Aino"
				},
				{
