			"dialogs": [
				{
					"id": 760381109,
					"content": "(Será que <color=#FFCC33FF>Linnea</color> se interessaria por algumas esculturas de açúcar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Ah, olá Srta. Linnea! Veio comprar esculturas de açúcar para Lumi de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Sim, Lumi ama tanto suas esculturas de açúcar, ela não consegue comer elas. Sempre que ela ganha uma, tudo que ela faz é lamber e me entregar de volta para guardar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Mas, já que a escultura de açúcar é feita de açúcar... ela só derrete com o tempo de todo jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Então tenho que incomodar você, Srta. Hunajatta, para fazer outra para Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Sem problema! Só um momento, por favor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Lumi é tão adorável. Eu gostaria de fazer um cafuné nela! Mas fazer isso parece meio mal-educado. Deixa para lá...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Aqui está, Srta. Linnea. Tudo pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "Obrigada! Lumi, sua escultura de açúcar está pronta, você quer... Oh, ela dormiu! Vou dar para ela depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
