					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Negativo. A Aino pediu que eu viesse comprar uma bela escultura de açúcar para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "Segundo ela, isso faz parte do meu treinamento de \"atividade social\", que tornará as compras mais convenientes no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Entendo~",
					"roleType": "TALK_ROLE_NPC",
