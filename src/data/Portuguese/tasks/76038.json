					"nextDialogs": [
						760380702
					]
				},
				{
					"id": 760380702,
					"content": "Chefe, uma porção grande, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Não é sua primeira vez aqui, Jahoda. Você sabe que o tamanho das nossas Esculturas de Açúcar é fixo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Ah, qual é! Eu tive um ótimo dia hoje! Anda, anda, faz uma só um pouquinho maior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "Ótimo dia? Imagino que sua Comissão tenha corrido bem, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Hehehe, claro. Era só uma missão de escolta simples. Moleza, já era.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Nem um fio de cabelo do cliente foi ferido, nem um arranhão na carga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Tá bom, já falei demais. Rápido, faz uma porção maior, vou levar pra comer depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "Sem problema. Me dá um minutinho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
