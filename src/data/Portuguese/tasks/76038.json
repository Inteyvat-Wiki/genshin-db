			"dialogs": [
				{
					"id": 760381001,
					"content": "(Será que <color=#FFCC33FF>Illuga</color> teria interesse em esculturas de açúcar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Bom, já que eu já estou aqui... Olá, uma escultura de açúcar, por favor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Ah! Você pode fazê-la um pouco menor? Tenho medo de que aconteça alguma coisa e eu não consiga terminar tudo de uma vez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "Sem problema nenhum! Fique tranquilo, até as pequenininhas são muito gostosas também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Mesmo assim, vocês, Portadores da Lâmpada, vivem mesmo atarefados... até uma escultura de açúcar pode acabar sem ser terminada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Hum... Ahaha... Bom, não é só por causa das responsabilidades. Às vezes é porque eu esbarro em alguém que precisa de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Você sabe como é, esculturas de açúcar pela metade são difíceis de guardar. Tudo o que eu posso fazer é enrolar em um pano e guardar no bolso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Mas, quando eu termino de ajudar e tiro de novo, ela já derreteu inteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Entendi... Deixe-me pensar. Uma escultura de açúcar pequena... hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Já sei! Posso fazer uma esculturazinha com vários sabores!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Coloco este sabor na base... depois este outro por cima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "Prontinho! Aqui está, uma mini escultura de açúcar com vários sabores! Atende às suas necessidades, caro cliente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Ah, está perfeita! Obrigado, Srta. Hunajatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Ah, não precisa agradecer. Talvez eu não possa ajudar vocês, Portadores da Lâmpada, com o trabalho... mas, se quiserem esculturas de açúcar, posso fazer quantas quiserem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "Esse é o nosso dever. É muita gentileza sua, Srta. Hunajatta... Vou me retirar agora, ainda há tarefas à espera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Certo, cuide-se! E da próxima vez que quiser uma escultura de açúcar, é só vir direto aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
