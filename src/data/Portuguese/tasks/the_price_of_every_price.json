			"dialogs": [
				{
					"id": 401960301,
					"content": "#Oh, {NICKNAME}, Kinich, vocês voltaram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960302,
					"content": "Acabamos de ver Chevreuse levando o criminoso embora. Ela estava bem satisfeita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960303,
					"content": "Bem, foi mais tranquilo do que eu esperava.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "Hehe, depois de correr em círculos por tanto tempo, parece que ele não tinha nenhum poder de luta, não é? Parece que fugir era o único truque na manga dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960306,
					"content": "Oh, falando nisso, Wriothesley quer deixar você ciente que ele já reportou de volta para o Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960307,
					"content": "Ele disse que o Marechalato Fantasma está se preparando para fazer uma investigação minuciosa em apostas ilícitas. Parece que vão estar de mãos cheias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960308,
					"content": "Enfim, isso é problema do Palais Mermonia. Não é da conta da gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960309,
					"content": "A julgar pela velocidade que o Duque foi embora, acho que estava fugindo do meu Aparelho Fotográfico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960310,
					"content": "Acho que já me acostumei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960311,
					"content": "Ei, você não é de desistir tão fácil assim, Charlotte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960312,
					"content": "Hehe, tudo bem. Já consegui vários ângulos. É mais do que o suficiente para a capa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960313,
					"content": "E com isso, essa repórter ocupada precisa partir. Essas fotos não vão se revelar sozinhas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960314,
					"content": "Escolha os melhores ângulos da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960315,
					"content": "Uau, ela já foi embora... Paimon espera que ela tenha ouvido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960316,
					"content": "Você pode confiar no profissionalismo de um fotógrafo, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "Hehe, isso é verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960318,
					"content": "Mas por que vocês demoraram tanto? Algo aconteceu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960319,
					"content": "Ajaw bateu a cabeça e começou a chorar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "Sério!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960321,
					"content": "Ei, fecha essa matraca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960322,
					"content": "Quando foi que eu, o Poderoso Dragão Soberano, me rebaixei a tal nível?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960323,
					"content": "Mais comum do que se imagina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960329,
					"content": "Enfim, qual seu próximo plano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "Hmm, para falar a verdade, ainda não me decidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960331,
					"content": "Não tenho nada urgente pra fazer, e o tribunal ainda precisa que eu compareça como testemunha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960332,
					"content": "A arma ainda é a principal evidência, por isso terei que esperar até que o caso esteja encerrado antes de poder retornar para Natlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960333,
					"content": "Acho que vou ficar por aqui aproveitando a areia e o mar por mais um tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960324,
					"content": "Kinich bateu a cabeça e começou a chorar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "Se você está dizendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960326,
					"content": "Hahaha! Pobre Kinichinho! Não havia ninguém para dar um tapinha na cabeça dele, por isso foi chorar sozinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960327,
					"content": "Sério? O choro de Ajaw parece mais plausível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960328,
					"content": "Ei, sua...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960304,
					"content": "Nosso inimigo era fraco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
}