			"dialogs": [
				{
					"id": 401960201,
					"content": "Essa praia parece cada dia mais animada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960202,
					"content": "(Graças em parte, com certeza, aos agentes disfarçados.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "#{NICKNAME}, hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960204,
					"content": "Ahem! Paimon tá com uma fominha... vamos dar uma olhada no cardápio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960205,
					"content": "(Aquela pessoa com a maleta... deve ser ele.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "(Bem, agora é hora de assunto sério.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "Inacreditável! Você não pode sair arrastando uma pessoa desse jeito! Que desrespeito com a vida humana... vejo você no tribunal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960208,
					"content": "É mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960209,
					"content": "Acho que lhe fiz um favor ao te puxar para longe de sua \"audiência\". Pelo menos poupei você de pagar um mico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960210,
					"content": "Quanto ao que você enfrentou no caminho... bem, foi sua decisão, não foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960211,
					"content": "Oras, seu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960213,
					"content": "Tá bom, tá bom, eu admito que foi minha culpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960214,
					"content": "*Suspiro* Claro que eu sei a diferença entre o certo e o errado... Mas eu não tive escolha! Eu precisava do dinheiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960215,
					"content": "Eu era um especialista em relíquias antigas... não só tive uma carreira de sucesso, mas uma família feliz também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960216,
					"content": "Mas, o meu filho... se eu soubesse que ele ia acabar com o pessoal errado, e cheio de dívida de apostas... tínhamos um dinheiro guardado, mas ele gastou tudo num piscar de olhos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960217,
					"content": "Depois de acabar sobrecarregado de dívidas, seus credores apareciam para ameaçá-lo. Como eu poderia ficar parado e assistir ele sofrer desse jeito, sendo seu pai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960218,
					"content": "*Suspiro* Meu filho tem por volta da sua idade. Ah, se ele pudesse ter crescido como você... foi por isso que eu precisei do dinheiro, você precisa acreditar em mim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960220,
					"content": "Você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960221,
					"content": "Vamos lá, jovem, me ajude!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960222,
					"content": "Nós dois somos de Natlan, não somos? Pelas nossas raízes, me poupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960223,
					"content": "Eu ainda tenho como fazer meu filho voltar para o caminho certo, se eu conseguir voltar. Mas se eu for para a prisão agora, será o fim dele. O fim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960224,
					"content": "E ficar juntos, lutando por um futuro melhor não são coisas que famílias fazem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960225,
					"content": "Nosso destino está em suas mãos, meu jovem. Tenha misericórdia, eu imploro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960227,
					"content": "Haha, o que foi, Kinich? Tá com o coração mole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960228,
					"content": "Hunf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960229,
					"content": "Eu não acredito em palavra alguma sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960230,
					"content": "Wriothesley foi na mosca. Você é um viciado em apostas, nada mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960231,
					"content": "Um apostador? Eu? Como isso seria verdade? Eu disse, meu filho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960232,
					"content": "Primeiro, você é mesmo de Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960233,
					"content": "Você acompanhou o paradeiro das armas o tempo todo. Imagino que você teria reconhecido pelo menos um rosto familiar de sua terra natal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960234,
					"content": "E, além disso, o jeito que você me ameaçou com um tribunal... você tem um jeito com as palavras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960235,
					"content": "Hã? Como isso seria suficiente para...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960236,
					"content": "Eu posso explicar! Eu cresci em...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960237,
					"content": "Tsc, não quero ouvir mais uma palavra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960238,
					"content": "Ajaw, é a sua chance. Cale a boca de outra pessoa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960239,
					"content": "Hahaha, eu tava esperando por essa hora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960240,
					"content": "Toma essa, seu sem vergonha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960241,
					"content": "Ser um mentiroso compulsório é uma das características mais marcantes de um viciado em apostas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960242,
					"content": "Aposto que você é só uma pessoa de Fontaine fingindo ser de Natlan. Ainda que você tivesse amigos ou família, também aposto que cortaram todos os laços com você, culpa de seus caminhos desvirtuosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960243,
					"content": "Claro, eu posso estar errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960244,
					"content": "Mas e daí?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960245,
					"content": "Só estou aqui para prender você. Se você está procurando um advogado, ou um ombro pra chorar, azar o seu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960246,
					"content": "Além disso, tirar toda a verdade da sua boca é o papel da sua amada corte, não é mesmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960247,
					"content": "Isso mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960248,
					"content": "Há quanto tempo, Sr. Kinich. A Patrulha Especial cuidará desse criminoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960249,
					"content": "Muito obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960250,
					"content": "Eu que deveria estar agradecendo toda a sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960251,
					"content": "Eu, eu, eu, e eu?! Hunf, que falta de educação! Vocês não deviam estar se ajoelhando de gratidão para o Poderoso Dragão Soberano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960252,
					"content": "Tudo bem, agradecemos a você e ao Sr. Cacucu por suas performances de tirar o fôlego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960253,
					"content": "Ei, o que você quer dizer com isso?! Paradinha aí...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960254,
					"content": "Kinich, você está bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "Não se preocupe, estou bem. Não fui eu quem foi arrastado até aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960256,
					"content": "Parecia que você estava irritado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "Pff... pequeno Kinich, você está lembrando quando era só o Kinich pequenininho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960258,
					"content": "Não comece a chorar como um bebezinho! Se as pessoas virem que o Poderoso Dragão Soberano tem um servo tão patético, você vai me envergonhar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960259,
					"content": "O que raios tu tá falando...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960260,
					"content": "Ajaw mal-educado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "Não tem sentido esconder isso. Para ser franco, não consigo suportar apostadores.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960262,
					"content": "Eles são as pessoas mais irresponsáveis do mundo todo... não têm respeito nenhum pelo princípio de que você tem que dar para poder receber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960263,
					"content": "São capazes de contar mil mentiras por uma moeda, de se iludirem ao ponto de pensarem que podem apostar seu caminho até ficarem ricos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960264,
					"content": "Mas todos nós sabemos que há um custo escondido em conseguir algo sem esforço ou sacrifício.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960265,
					"content": "Eu acabei pagando um preço pelas apostas de meu pai. Não quero que mais ninguém acabe em uma situação similar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960266,
					"content": "Kinich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "Não sinta pena de mim. Não me sinto assim a meu respeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960268,
					"content": "Dizem que as pessoas são o resultado de seu passado. E como eu cheguei até aqui... devo ter acertado em muitas coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960269,
					"content": "Não devemos nos punir pelos erros de outras pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960270,
					"content": "Ao invés disso, escolho lembrar os momentos que me ajudaram a crescer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960271,
					"content": "Como quando eu aprendi a usar a Corda-gancho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960272,
					"content": "Ou a primeira vez que desejei conhecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960273,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "Sim, acredito em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960275,
					"content": "Vamos. Se não voltarmos, vamos preocupar as pessoas desnecessariamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
		},
