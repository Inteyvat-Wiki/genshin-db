			"dialogs": [
				{
					"id": 230300201,
					"content": "Olha só aquela caixa. Acho que as poções estão lá. Parece que Yasmin já passou por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "Hã? As tampas dessas poções ainda não foram abertas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "Não abra a tampa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300204,
					"content": "Uau! Tem muitos Cogumelos aparecendo atrás de você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "Quê? Não havia nenhum antes? O que está acontecendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#Não dê ouvidos a eles, {NICKNAME}, vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
