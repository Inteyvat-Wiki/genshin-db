			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Uau, que sorte a nossa, né? Ainda bem que o pote não quebrou, ou estaríamos vomitando sem parar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Não está acostumado com o cheiro? Mas não foi você mesmo criou a poção?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Quantas vezes lhe expliquei que estou acrescentando um emético fisiológico, hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Não importa se as você está acostumado ou não, o cheiro faz qualquer pessoa vomitar automaticamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Por que me dou ao trabalho de repetir? Você não entenderia de qualquer forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Mas onde Yasmin se meteu? Nem sequer espalhou a poção hoje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Ela deve ter encontrado outra planta rara novamente e está ocupada coletando espécimes. Típico comportamento Amurta... Ainda não conhece os costumes deles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "Bem, vamos cuidar do pote de poção agora. Obrigado pela sua ajuda, Viajante. Tome, isso é para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Argh... Este grupo dos Amurta... sinceramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
