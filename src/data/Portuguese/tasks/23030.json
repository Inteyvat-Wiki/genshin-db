					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*Cof*, *cof*, *cof*... Devemos ficar bem por aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Oh... Eca... Você... Foi você quem fez isso! Como você está vomitando também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Ahh... *Cof*... *cof*, *cof*...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Quantas vezes expliquei... a você... que acrescentei um emético fisiológico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Não importa se as você está acostumado ou não, o cheiro faz qualquer pessoa vomitar automaticamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Por que me dou ao trabalho de repetir? Você não entenderia de qualquer forma... Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "#Eh? Ladep, Pharez e {F#a}{M#o} Viajante? O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "O pote onde está a poção está quebrado... Vocês foram atacados por algum monstro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "A julgar pelo estado das coisas... Provavelmente é o caso. Você viu algum monstro no caminho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "Não, eu até tirei um tempo para coletar alguns espécimes de plantas por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "Que estranho... Muito estranho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300512,
					"content": "O que tem de estranho nisso? Esses monstros foram atraídos pela poção que você fez, claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300513
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300513,
					"content": "Quê?! Mas isso nunca aconteceu em experimentos de campo anteriores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300514
					],
					"speakerTitle": "Ladep"
