			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Precisamos de mais dados!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Como seus dispositivos podem funcionar corretamente sem dados para dar suporte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Você sugere que eu não faça nada até ter todos os dados?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "Você precisa lançar a rede em todas as ondas ao pescar? Não! Você só precisa observar se há peixes abaixo de você ou não!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "É por isso que você nunca pega nenhum peixe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Qual é?! Você não estudou em Haravatat mesmo! Pode parar com a brincadeira. Temos que ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Não temos tempo a perder. As nossas teses e a de Yasmin podem ser tornar obsoletas se demorarmos muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "O que vocês estão discutindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Você é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "#Você deve ser {F#a}{M#o} Viajante que Yasmin mencionou, você foi de grande ajuda para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "É uma honra conhecer você, Viajante! Uma grande honra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Eu me chamo Pharez, e estou estudando no Darshan Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Meu nome é Ladep, sou um estudante Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "Viajante, um favor seu nos cairia muito bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Você sabe que Yasmin tem espalhado poções ao redor das raízes da Árvore Divina, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Bem... Ehmm... Parece haver um problema causado pelas poções que Yasmin usou ultimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "Nos arredores de onde foi espalhada, todos os tipos de monstros têm aparecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Juro, não mudei nada na fórmula ou dosagem. Deve ter sido... Ehmmm, algo deve ter acontecido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "Se você diz... Enfim, Viajante, venha conosco até o local onde Yasmin espalhou a poção, por favor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Provavelmente há muitos monstros lá, não ousamos ir sozinhos... Precisamos de alguém forte para nos acompanhar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "Além disso, mesmo que esses Cogumelos não sejam tão perigosos, se nosso orientador descobrir que nossa poção causou esses problemas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "O relatório inicial da nossa tese será definitivamente rejeitado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "Especialmente para nós do Spantamad, onde um único erro nos dados leva a muito criticismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Deixa comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Como vocês resolveram problemas similares antes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Geralmente contratamos um aventureiro. Também já pedimos ajuda ao nosso orientador para encontrar alguém confiável entre os Eremitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Mas, os nossos orientadores não têm muita paciência e, nesta situação, não nos atrevemos a pedir ajuda a eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "#Você é {F#a única}{M#o único} a quem podemos pedir isso, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
		{
