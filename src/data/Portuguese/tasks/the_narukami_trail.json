			"dialogs": [
				{
					"id": 220500701,
					"content": "O que foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500702,
					"content": "Sobre Mikoshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Lendas dizem que Mikoshi Nagamasa esteve trabalhando para o Shogunato, e dizem que ele é tão justo e certo até o ponto de ser um fanático.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "Sua linhagem chegou até os dias de hoje. A maior parte das pessoas com o nome Mikoshi na cidade são seus descendentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "Sobre Kamuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "Não há muitos registros sobre ele. Ele voltou para Inazuma após cruzar o mar para aprender o caminho dos Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "E então, ele criou suas própria \"Onmyoudou\" e \"Shiki Taishou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "De acordo com os registros, para trazer paz para Inazuma, ele usou essa técnica para selar o Bake-Danuki, Ioroi, que estava criando problemas por toda Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "Mas depois, ele gradualmente desapareceu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500710,
					"content": "Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500711
					]
				},
				{
					"id": 220500711,
					"content": "Cuide-se. Se precisarem de minha ajuda, podem vir me procurar.",
					"roleType": "TALK_ROLE_NPC",
