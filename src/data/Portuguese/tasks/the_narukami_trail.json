			"dialogs": [
				{
					"id": 220500601,
					"content": "Ufa... Finalmente voltamos. Após ficar muito tempo próxima àquele santuário, o meu pelo está todo arrepiado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500602,
					"content": "#Obrigada por sua ajuda. Você realmente é {F#uma}{M#um} human{F#a}{M#o} únic{F#a}{M#o} e confiável, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "Neko"
				},
				{
