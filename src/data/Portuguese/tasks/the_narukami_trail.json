					"content": "Eu continuarei a cuidar do santuário. Quando Hibiki retornar, eu lhe apresentarei à ela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500604,
					"content": "Miau, miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500605
					],
					"speakerTitle": "Neko"
				},
				{
