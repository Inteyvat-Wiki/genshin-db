			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "Agora pode ir... Obrigado, viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Não temos muito dinheiro, e a doença da Anna não teve melhora, por isso eu sempre venho cá recolher ervas medicinais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "Eu consegui pegar as ervas que eu estava à procura, mas então aquele grupo começou a me atacar de algum lugar. Você veio bem a tempo para me salvar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Isso é para você. Eu fiz um chá para a Anna, vai ajudar a melhorar a tosse dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Você parece uma pessoa que gosta de sair. Tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
