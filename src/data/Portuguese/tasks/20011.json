			"dialogs": [
				{
					"id": 200110201,
					"content": "Obrigado, Viajante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110202,
					"content": "Mas tem esse bloqueio aqui. Eu não consigo atravessar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110203,
					"content": "Hahaha... Eu conseguiria resolver isso sozinho se não fosse por alguns Hilichurls. Agora o meu corpo todo dói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110204,
					"content": "Pelo menos as ervas medicinais que eu peguei para a Anna ainda estão em boas condições.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110205,
					"content": "Sinto muito... Eu sei que estou pedindo demais, depois de você ter me ajudado também, mas você poderia tirar aquele bloqueio de pedras para mim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110206,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "Obrigado! Agora vou descansar um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110207,
					"content": "Eu ainda tenho outras coisas para fazer, sinto muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "Mas a Ana ainda está à minha espera em casa... Por favor, eu realmente preciso da sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
