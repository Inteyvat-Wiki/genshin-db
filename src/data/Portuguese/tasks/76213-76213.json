			"dialogs": [
				{
					"id": 762130201,
					"content": "Sonhos, ilusões, bolhas e sombras, por que se esforçar para alcançá-los? Mesmo que você estude os princípios por mil anos, se mantiver a mente completamente imóvel e \"não nascida\", você simplesmente não vai entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130202,
					"content": "Então... você está procurando um livro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "Você já esteve aqui antes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130204,
					"content": "Hã?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Então você entende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130208,
					"content": "Entende... entende o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "Quando precisar dormir, durma. Quando precisar entender, entenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130211,
					"content": "É melhor você voltar agora. Quando o mundo acabar, apenas acompanhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130209,
					"content": "E como eu poderia entender isso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "Não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "Eu não entendo uma palavra do que você está dizendo. Adeus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "Vá em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		}
