			"dialogs": [
				{
					"id": 762130101,
					"content": "Hã? Parece que os livros estão atrapalhando aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130102,
					"content": "Está procurando um livro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130103,
					"content": "Hm... Não exatamente. Só estamos um tiquinho, tiquinho curiosos sobre o que tem aí dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130104,
					"content": "Acho que dá para a gente entrar por lá, pelo lado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "Vocês não podem entrar aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130106,
					"content": "Eu movo os livros, e movo os livros. Se não fizer isso, ainda não vai estar completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130107,
					"content": "Eu não entendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "Eu movo os livros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130109,
					"content": "E o que você quer dizer com \"mover os livros\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "Se os livros não estão aqui, então devem ter sido movidos. Tudo o que eu faço é bater o olho neles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130111,
					"content": "Então deixa eu tentar com o Dex.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Vá direto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		},
