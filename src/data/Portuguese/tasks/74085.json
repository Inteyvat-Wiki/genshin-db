					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "Uau! Paimon nunca viu uma Melusine como ela. Ou melhor... ela não se comporta como uma Melusine, mas sim como um espírito selvagem.",
