			"dialogs": [
				{
					"id": 250330201,
					"content": "#Você é incrível! Você é quase tão rápid{M#o}{F#a} quanto Mayta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330202,
						250330203
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330202,
					"content": "Eu cometi alguns erros...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "#Heh, você já foi rápid{M#o}{F#a} o suficiente. Jika e eu não nos comparamos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330205,
					"content": "*Suspira* Eu diria que treinaremos por um bom tempo antes de conseguirmos nos equiparar a você...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330206,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330207,
					"content": "Você consegue, Jika!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "Roar? Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330210,
					"content": "Bom garoto, Jika. Lembra do que tio Yawar disse? Ficaremos fortes desde que continuemos trabalhando bastante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330211,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330212,
					"content": "Enfim, muito obrigado pela sua ajuda. Aqui, fique com essa fruta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330213,
					"content": "Jika acabou de colher — e sabe, ele está se movendo mais rápido do que de costume!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330214,
					"content": "Hehe, tenho certeza que ele ficou assim tão bom, pois tinha você como exemplo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330215,
					"content": "Rawr, rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330216,
					"content": "Muito bem, então, vamos voltar e procurar por Mayta. Ele deve ter voltado ao povoado da tribo no momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
