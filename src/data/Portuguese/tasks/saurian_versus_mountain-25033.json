			"dialogs": [
				{
					"id": 250330101,
					"content": "Bom garoto, bom garoto! Comeu o bastante hoje? Pronto para treinar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330102,
					"content": "Roar~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330103,
					"content": "Você está bem enérgico hoje, não é? Maravilha! Vamos lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330104,
					"content": "É, vamos lá!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "Hã? Oh, olá! Estamos fazendo um pouco de treinamento de alpinismo no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330107,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330108,
					"content": "Rawwr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330109,
					"content": "Como está indo o treinamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Bem... estamos \"progredindo\". Jika subiu bem mais alto dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330111,
					"content": "É só que Jika não é muito familiar com como escalar montanhas, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330116,
					"content": "A propósito, você poderia demonstrar para a gente de novo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330117,
					"content": "Claro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "Muito obrigado! Tenho certeza que serei capaz de captar seus movimentos dessa vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330119,
					"content": "Também fique de olhos abertos, tudo bem, Jika?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330120,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330123,
					"content": "Estamos contando com você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330124,
					"content": "Então o que faremos é cronometrar enquanto você sobe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330125,
					"content": "Rawr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jika"
				},
				{
					"id": 250330121,
					"content": "Assista com atenção dessa vez, tudo bem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "É claro! Jika e eu não vamos perder nadinha dessa vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330112,
					"content": "Parece que ele está se recuperando bem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "Isso mesmo. A mamãe disse que estou ficando muito bom em cuidar dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330114,
					"content": "Jika melhorou muito. Ele consegue subir bem mais alto do que podia da última vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "Tlathe"
				},
				{
					"id": 250330115,
					"content": "É só que Jika não é muito familiar com como você escala montanhas, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlathe"
				}
			]
		},
