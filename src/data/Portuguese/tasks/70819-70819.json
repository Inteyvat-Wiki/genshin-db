					"Hannelore"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "Ah... Agradeço sua gentileza. Mas como irmã da Igreja Favonius, não posso aceitar tais presentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Para mim, é suficiente sentir o rastro dessa fragrância enquanto ela flutua pelo mar de vento. Coisas belas pertencem ao vento, não a pessoas. Esse é o caminho daqueles que trilham a fé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "Mesmo assim, sua gentileza, calorosa como a brisa do sul, chegou até mim. Por favor, aceite esse livro como um pequeno presente em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "Que o Arconte Anemo cuide de você. E que a estrada à frente seja cheia, como essa fragrância, de virtude, liberdade e compaixão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
		},
