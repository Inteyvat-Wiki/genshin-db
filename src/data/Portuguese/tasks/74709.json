			"dialogs": [
				{
					"id": 747090101,
					"content": "#Obrigada, {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090102,
					"content": "Agora tenho uma boa compreensão da condição dos nossos pacientes, então preparei um remédio especial das Melusines para eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090103,
					"content": "Adicionar essas ervas especiais ao tanque deve ajudar a acalmá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090104,
					"content": "Então você tá basicamente transformando o tanque inteiro num spa gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090105,
					"content": "Esse é mesmo um plano que só você poderia realizar, Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090106,
						747090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747090106,
					"content": "Mas isso não vai só aliviar os sintomas temporariamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747090108
					]
				},
				{
					"id": 747090108,
					"content": "Você acertou em cheio. Vou precisar convidar uma grande variedade de peixes diferentes aqui para exames físicos antes de poder determinar exatamente qual é o problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090109,
					"content": "Vou montar uma lista de pacientes para examinar com base nas características que preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747090110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090110,
					"content": "Ficaria muito grata se vocês pudessem ficar de olho em qualquer peixe que se encaixe nisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747090107,
