				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710601,
					"content": "Uau... Tantas Flores de Doces!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710602
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710602,
					"content": "Varsha, não corra tão rápido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710603,
					"content": "As flores estão crescendo muito bem aqui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710604
					],
					"speakerTitle": "Varsha"
