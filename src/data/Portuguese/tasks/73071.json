				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "Enquanto houverem sementes, eu posso cultivar mais Flores Doces. Mas pão é diferente, não dá para plantar pão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710202,
					"content": "Se pão pudesse ser partido ao meio e crescesse de novo, ninguém mais passaria fome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "Oi, Varsha. Você ainda está aqui, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710302,
					"content": "#Paimon e {NICKNAME}, que bom ver vocês! Eu estou bem por aqui, não precisam se preocupar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710303,
					"content": "Você persistiu mesmo, hein!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710304,
					"content": "Vocês ainda querem me convencer de voltar? Eu não vou a lugar algum. Não mesmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710305,
					"content": "Bem... Não vamos forçar você a nada. Você se lembra de comentar sobre \"um jardim cheio de Flores Doces\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710306,
					"content": "Ah!... Era só um desejo meu, eu sei que não existe um lugar assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710307,
					"content": "Hmm... Essa maturidade toda continua sendo muito estranha vindo de uma criança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710308,
					"content": "Adivinha só! Nós temos boas notícias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710309,
					"content": "Existe mesmo uma sementeira cheia de Flores Doces.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "Isso mesmo! Acredite ou não, o \"mímico da floresta\" que salvou você é de uma espécie conhecida como Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710311,
					"content": "A gente sabe disso porque ajudamos a plantar muitas Viparyas para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710312,
					"content": "Nós ajudamos a terra a lembrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "Exatamente. De acordo com Aranakula, Vanarana se lembra de tudo. As Viparyas podem germinar na sementeira quando a terra se lembrar delas novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710314,
					"content": "... Eu já ouvi muitas histórias como essa. Só crianças levam elas a sério. Eu sei que você disse isso com boas intenções, Paimon. Eu agradeço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710315,
					"content": "Você não é uma criança também? Espere, não! Paimon não está contando histórias, Paimon está falando sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710316,
					"content": "Bem, isso é o que as pessoas que contam histórias para as crianças sempre dizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710317,
					"content": "Se você não acredita em nós... Bem, é só ver para crer. Venha conosco, e veja por você mesma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710318,
					"content": "Espere, você realmente preparou um lugar só para encaixar com a sua história? Agora estou ficando curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710319,
					"content": "Aff, Paimon está falando a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710320,
					"content": "#Vamos levar ela até a sementeira dos Aranaras, {NICKNAME}. Assim vamos calar as dúvidas dela de uma vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
				7307105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307105",
							"2"
						],
						"stepId": 7307105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710401,
					"content": "#Tudo isso foi preparado por Paimon e {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710402
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710402,
					"content": "Hmm... Sim e não. Aranakula e Arakara cuidam dessa sementeira, juntos. Nós só demos uma pequena ajuda. Ele não foi construído só pelas histórias.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710403,
					"content": "Aranakula e Arakara... Eles são \"Aranara\"? Os mímicos da floresta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710404
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710404,
					"content": "Isso! Você acredita em Paimon agora? Não só ajudamos a cuidar da sementeira, também participamos de muitas aventuras com os Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710405,
					"content": "Os Aranaras são aqueles que levam as crianças raptadas de volta para a Vila Vimara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710406,
					"content": "Ainda é difícil acreditar que todas as histórias de Paimon são reais... Mas se eu ficar aqui, eu vou ter a chance de vê-los também?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710407
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710407,
					"content": "Vanarana não é perigosa de verdade, mas você tem certeza que não quer voltar para a Vila Gandharva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710408,
					"content": "Você tem uma memória ruim mesmo, Paimon. Eu já falei que não quero mais depender dos adultos, eu quero seguir o meu próprio caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710409
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710409,
					"content": "Mas...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710410
					]
				},
				{
					"id": 730710410,
					"content": "Está bem, não se preocupem tanto comigo. Até agora, eu estive muito bem sozinha, lembra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710411
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710411,
					"content": "Além disso, sou boa em cuidar de flores e plantas, então se eu conseguir fazer a sementeira prosperar aqui, os Aranaras também ficarão felizes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710412
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710412,
					"content": "Bem, se você insiste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710413,
					"content": "Você se preocupa demais, Paimon. Não consigo lembrar de ninguém que se importou tanto assim comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710414
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710414,
					"content": "Hmm... Escute aqui, Varsha. Você está segura aqui em Vanarana, mas ainda assim você é uma criança, por favor tenha cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710415,
					"content": "Eu sei, eu sei. Tomem cuidado também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307105,
			"completionStepIds": [
				7307107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307107",
							"2"
						],
						"stepId": 7307107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710501,
					"content": "Que estranho, o que essa criança faz aqui? Ei, o que está fazendo aqui sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710502,
					"content": "Ah! Uma pessoa estranha, e uma pessoa estranha voadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710503
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710503,
					"content": "Que falta de educação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710504,
					"content": "Isso mesmo. Sou muito mal educada. Não tive pais para me ensinarem \"boas maneiras\", tá sabendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710505
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710505,
					"content": "(Parece que há história aí...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710506
					]
				},
				{
					"id": 730710506,
					"content": "Enfim... não somos pessoas estranhas, e com certeza não somos más pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710507,
						730710509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710507,
					"content": "Somos apenas viajantes gentis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710508
					]
				},
				{
					"id": 730710508,
					"content": "Isso mesmo, é por isso que não viramos as costas para as pessoas com problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710511,
					"content": "#A propósito, Paimon se chama Paimon, e {M#este}{F#esta} é {NICKNAME}. Qual é o seu nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710512,
					"content": "... O meu nome é Varsha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710513
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710513,
					"content": "E por que você está sozinha aqui, Varsha? Se você está perdida, podemos levar você de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710514,
					"content": "Não. O passado deveria ficar no passado. Eu decidi seguir em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710515
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710515,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710516,
					"content": "Eu não posso mais depender da ajuda de adultos. Tenho que me virar sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710517
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710517,
					"content": "Que conversa de gente grande é essa, mesmo sendo uma criança...? A floresta pode ser bem perigosa, uma criança não conseguiria lidar com tudo sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710518,
					"content": "Um homem malvado tentou me levar embora antes... Mas tudo bem. Eu serei mais cuidadosa agora. Vou ficar longe do perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710519
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710519,
					"content": "Era um homem da Vila Vimara. Ele até parecia ser legal, mas no fim das contas, não era nada diferente dos outros adultos que eu conheço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710520
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710520,
					"content": "Você quase foi levada por um cara malvado!? Paimon acha que você ainda não aprendeu a sua lição! Espera, como você conseguiu escapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710521,
					"content": "Uma criaturinha me trouxe para esse lugar. Eu nunca vi uma coisa tão pequena na Vila Gandharva, então eu acredito que era um mímico da floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710522
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710522,
					"content": "(Suponho que era um Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710523
					]
				},
				{
					"id": 730710523,
					"content": "(Falando nisso, será que aquele tal \"homem da Vila Vimara\" era...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710524,
					"content": "De toda forma, não é seguro para crianças ficarem sozinhas na floresta. Você pode encontrar todo tipo de perigo. Como, por exemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710525,
					"content": "Encontrar Cogumelos perigosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710526
					]
				},
				{
					"id": 730710526,
					"content": "Isso, isso! E vilões, como Nara Marana. Ai, não, Paimon quis dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710527,
					"content": "Você pode encontrar pessoas malvadas que querem te sequestrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710528
					]
				},
				{
					"id": 730710528,
					"content": "#Ahã, {NICKNAME} tem toda a razão! E você também pode ficar com fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710529,
					"content": "É impossível ficar com fome em uma floresta cheia de presentes da natureza. Cogumelos Estrelares, Flores Doces e Mentas estão por todos os lados. E eu como bem pouquinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710530
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710530,
					"content": "Eu sempre fui ótima em cuidar de plantas, então encontrar algumas Flores Doces ou Mentas para comer não seria um problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710531
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710531,
					"content": "Haha, um jardim cheio de Flores Doces... Seria um paraíso, não seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710532
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710532,
					"content": "Uma sementeira cheio de Flores Doces, hum? Ah! Paimon se lembra que havia muitas na sementeira que cuidamos para os Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710533,
					"content": "Espera. Paimon está dizendo que este lugar paradisíaco realmente existe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710534
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710534,
					"content": "Isso mesmo! Acredite ou não, o \"mímico da floresta\" que salvou você é de uma espécie conhecida como Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710535,
					"content": "A gente sabe disso porque ajudamos a plantar muitas Viparyas para eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710536,
					"content": "Nós ajudamos a terra a lembrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710537
					]
				},
				{
					"id": 730710537,
					"content": "Exatamente. De acordo com Aranakula, Vanarana se lembra de tudo. As Viparyas podem germinar na sementeira quando a terra se lembrar delas novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710538,
					"content": "... Eu já ouvi muitas histórias como essa. Só crianças levam elas a sério. Eu sei que você disse isso com boas intenções, Paimon. Eu agradeço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710539
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710539,
					"content": "Você não é uma criança também? Espere, não! Paimon não está contando histórias, Paimon está falando sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710540,
					"content": "Bem, isso é o que as pessoas que contam histórias para as crianças sempre dizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710541
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710541,
					"content": "Se você não acredita em nós... Bem, é só ver para crer. Venha conosco, e veja por você mesma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710542,
					"content": "Espere, você realmente preparou um lugar só para encaixar com a sua história? Agora estou ficando curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710543
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710543,
					"content": "Aff, Paimon está falando a verdade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710544,
					"content": "#Vamos levar ela até a sementeira dos Aranaras, {NICKNAME}. Assim vamos calar as dúvidas dela de uma vez por todas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710509,
					"content": "#Estamos procurando {M#minha irmã perdida}{F#meu irmão perdido}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710510
					]
				},
				{
					"id": 730710510,
					"content": "#Sim. É claro que ficamos preocupad{M#o}{F#a}s quando vimos uma garotinha como você sozinha aqui! Não podemos deixar você aqui sabendo que pode precisar de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307106,
			"completionStepIds": [
				7307108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
