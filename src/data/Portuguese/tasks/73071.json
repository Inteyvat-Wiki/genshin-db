			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "Que estranho, o que essa criança faz aqui? Ei, o que está fazendo aqui sozinha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710102,
					"content": "Ah! Uma pessoa estranha, e uma pessoa estranha voadora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710103,
					"content": "Que falta de educação!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710104,
					"content": "Isso mesmo. Sou muito mal educada. Não tive pais para me ensinarem \"boas maneiras\", tá sabendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710105,
					"content": "(Parece que há história aí...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "Enfim... não somos pessoas estranhas, e com certeza não somos más pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710107,
					"content": "Somos apenas viajantes gentis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "Isso mesmo, é por isso que não viramos as costas para as pessoas com problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710111,
					"content": "#A propósito, Paimon se chama Paimon, e {M#este}{F#esta} é {NICKNAME}. Qual é o seu nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710112,
					"content": "... O meu nome é Varsha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710113,
					"content": "E por que você está sozinha aqui, Varsha? Se você está perdida, podemos levar você de volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710114,
					"content": "Não. O passado deveria ficar no passado. Eu decidi seguir em frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710115,
					"content": "Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710116,
					"content": "Eu não posso mais depender da ajuda de adultos. Tenho que me virar sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710117,
					"content": "Que conversa de gente grande é essa, mesmo sendo uma criança...? A floresta pode ser bem perigosa, uma criança não conseguiria lidar com tudo sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710118,
					"content": "Um homem malvado tentou me levar embora antes... Mas tudo bem. Eu serei mais cuidadosa agora. Vou ficar longe do perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710119,
					"content": "Era um homem da Vila Vimara. Ele até parecia ser legal, mas no fim das contas, não era nada diferente dos outros adultos que eu conheço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710120,
					"content": "Você quase foi levada por um cara malvado!? Paimon acha que você ainda não aprendeu a sua lição! Espera, como você conseguiu escapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710121,
					"content": "Uma criaturinha me trouxe para esse lugar. Eu nunca vi uma coisa tão pequena na Vila Gandharva, então eu acredito que era um mímico da floresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710122,
					"content": "(Suponho que era um Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "(Falando nisso, será que aquele tal \"homem da Vila Vimara\" era...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710124,
					"content": "De toda forma, não é seguro para crianças ficarem sozinhas na floresta. Você pode encontrar todo tipo de perigo. Como, por exemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710125,
					"content": "Encontrar Cogumelos perigosos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "Isso, isso! E vilões, como Nara Marana. Ai, não, Paimon quis dizer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710127,
					"content": "Você pode encontrar pessoas malvadas que querem te sequestrar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#Ahã, {NICKNAME} tem toda a razão! E você também pode ficar com fome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710129,
					"content": "É impossível ficar com fome em uma floresta cheia de presentes da natureza. Cogumelos Estrelares, Flores Doces e Mentas estão por todos os lados. E eu como bem pouquinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710130,
					"content": "Eu sempre fui ótima em cuidar de plantas, então encontrar algumas Flores Doces ou Mentas para comer não seria um problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710131,
					"content": "Haha, um jardim cheio de Flores Doces... Seria um paraíso, não seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710132,
					"content": "Ela está sonhando mesmo, hein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710133,
					"content": "De toda forma, eu estou muito mais feliz agora do que quando eu estava na Vila Gandharva, e eu nem apanho... Eu agradeço pela sua gentileza, mas agora, eu prefiro que você me deixe sozinha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710134,
					"content": "Hmm... Paimon não sabe o que ela passou, mas parece que vai ser difícil convencê-la a voltar para a cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710135,
					"content": "Para ser honesta, as coisas não parecem muito perigosas por aqui... Vamos voltar para vê-la depois se tivermos chance, talvez ela já tenha mudado de ideia até lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710109,
					"content": "#Estamos procurando {M#minha irmã perdida}{F#meu irmão perdido}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "#Sim. É claro que ficamos preocupad{M#o}{F#a}s quando vimos uma garotinha como você sozinha aqui! Não podemos deixar você aqui sabendo que pode precisar de ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
