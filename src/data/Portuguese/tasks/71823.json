			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiaobai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "Uh, esses Ingredientes Medicinais devem ser tratados juntos. Depois de tratados, você poderá fazer o remédio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718231002,
					"content": "Obrigada. Eu devo pensar em alguma maneira de como fazer o remédio um pouco mais doce, ou então aquelas crianças com certeza não vão querer tomá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231003,
					"content": "Vocês estão sempre tão ocupadas nessa época do ano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "Geralmente sim, afinal de contas, não há tantos jovens na Vila Qingce. Aqueles que podem ajudar como nós devem se esforçar ao máximo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "Xiaobai"
				},
				{
					"id": 718231005,
					"content": "Na verdade, esses dias todos os anos são bastante ocupados. Mas não há o que se preocupar. Além disso, este ano você nos ajudou, e isso acabou nos aliviando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231006,
					"content": "Muitos anos atrás, eu gastava muito tempo para coletar os ingredientes, e muito mais para fazer os remédios...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231007,
					"content": "Muito obrigada pela sua ajuda. Vamos logo arrumar esses Ingredientes Medicinais e depois prepararemos a Lanterna Celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231008,
					"content": "Ano passado eu quase esqueci de soltar a Lanterna Celeste, esse ano não posso esquecer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231009,
					"content": "Que pedido você fará?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "Uh... Que todas as pessoas da Vila Qingce tenham boa saúde? Haha, não sei. Algo como isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231011,
					"content": "Entretanto, se eu falar, o desejo não se realizará, por isso não lhe direi nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "Zhi"
				},
				{
					"id": 718231012,
					"content": "Por favor, fique isso. É um agradecimento pela sua ajuda de hoje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhi"
				}
			]
		},
