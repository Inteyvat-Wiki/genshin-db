				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "Então, uh, o que devemos fazer agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170202,
					"content": "Estamos tirando uma foto sua. Deixe o trabalho duro conosco, tudo o que você precisa fazer é ficar ali e fazer uma pose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170203,
					"content": "Basicamente, uma foto é um registro visual de você neste exato momento, então é uma ótima lembrança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170204,
					"content": "Ok, e o que exatamente é \"fazer uma pose\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170205,
					"content": "A foto é uma representação visual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "Ah, entendo. Em outras palavras, preciso fazer algum tipo de ação visualmente agradável na sua frente, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170207,
					"content": "Quanto mais penso nisso, mais embaraçoso parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170208,
					"content": "Como devo posar? Me ajude aqui. Devo ficar bem, mas não muito exagerado. Isso não me parece nada natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170209,
					"content": "Tente ser graciosa e digna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "Certo... Vou tentar isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170215,
					"content": "Isso serve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "Certo, vamos começar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170219,
					"content": "Vamos escolher um bom ângulo para registrar este momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170216,
					"content": "Talvez tente uma outra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "Muito bem. Vou deixar a decisão contigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170211,
					"content": "Tente com seriedade e severidade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "Isto não me parece muito \"eu\". Desse jeito assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170213,
					"content": "Tente relaxada e casual.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "Casual... Que tal assim? Isto parece bastante natural.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				}
			]
		},
		{
