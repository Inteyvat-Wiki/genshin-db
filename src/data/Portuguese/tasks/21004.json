			"dialogs": [
				{
					"id": 210042201,
					"content": "Hmm... Estou especulando aqui. Mas talvez as quatro Ruínas sejam relevantes para decifrar o significado verdadeiro dos Quatro Mandamentos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "Mas qual papel as ruínas devem desempenhar, bem, isso é outra questão. E... acho que não tenho força física para testar todas as minhas hipóteses na íntegra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "Mas estou com apenas um caminho na minha mente, e talvez essa ideia me leve para um destino errado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
