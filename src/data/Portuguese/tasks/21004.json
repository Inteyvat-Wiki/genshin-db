				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Que tal? Vocês já encontraram o tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Já! Foi na Convergência.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Ah, sério? Então é exatamente igual ao que os Quatro Mandamentos de Guizhong dizem, o tesouro fica na Convergência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Quem projetou esse enigma deve ter realmente muito respeito pela Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Eles preservaram os Quatro Mandamentos de Guizhong para as gerações futuras, mesmo que a Assembleia de Guili tenha sido exterminada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "E em relação a própria Guizhong, quem estabeleceu os Mandamentos, deve ter sido adorado pelo seu povo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Claramente, ela desejava que seu povo tivesse sabedoria, se controlasse com bom senso moral, fosse forte e saudável e encontrasse solidariedade, e juntamente protegesse seu lar, a Assembleia Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Mas ela falhou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Falhou? Supostamente você está certo, ela morreu no final... A Assembleia de Guili foi destruída, e o povo dela ficou sem abrigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Mas agora, os Quatro Mandamentos de Guizhong têm visto a luz do dia de novo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Essas foram as palavras escritas pela Guizhong para servir como máximas e bênção para seu povo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Ela levava o seu povo a avançar para a frente, guiados por esses Mandamentos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Ele não pode estar mais conosco, mas as suas crenças e as coisas que ela defendia, vão durar para sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Aquele que a admirava era muito esperto. Eles usaram o fascínio do tesouro escondido para garantir que os Quatro Mandamentos de Guizhong fossem transmitidos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Mas no fundo, para aquela pessoa, o tesouro verdadeiro era os metais raros e as pedras preciosas ou os Quatro Mandamentos de Guizhong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Haha, pelo menos para mim, o tesouro verdadeiro é os Quatro Mandamentos em vez de um baú cheio de ouros e gemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "... Mas se as pessoas puderem escolher, quantos escolherão uma lista de mandamentos abandonando a riqueza material?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Parece ser um arconte de natureza gentil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Não tenho certeza se \"gentil\" é uma caraterística comum para os deuses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Talvez antigamente, muito tempo atrás, entre os deuses que guiavam o povo no mundo, existiam alguns gentis por natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Aqueles que protegiam os seus povos, caminhou entre eles... Ficou ao lado deles enquanto eles partiam para o mundo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "... Mas foram os deuses gentis que no final ficaram impotentes para proteger os seus povos. Olhe para Guizhong - foi necessário uma caça ao tesouro apenas para preservar os Quatro Mandamentos, que antes eram o sustento de toda a civilização.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Se pudesse conhecê-la!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Você quer conhecer uma arconte? Você tem um pensamento selvagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "O que você faria se você conhecesse a Guizhong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "\"Anime-se, Guizhong, você fez o melhor?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Se fosse eu, ia decorar os Quatro Mandamentos de Guizhong impecavelmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "E diria que as suas crenças e visões ainda estavam vivas e bem, e o povo desta terra ainda se lembra do que ela ensinava aos ancestrais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Para alguém como a Guizhong, que perdeu tudo... Isso seria a única maneira para elevar o espírito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
