			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "\"Quatro Mandamentos de Guizhong\"... O que eles estão realmente tentando nos contar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "#Estou pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "#Haha. Você está muito entusiasmad{F#a}{M#o}. Bom! Vamos começar a ler os Quatro Mandamentos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "\"Ensinar com sabedoria, ser limitado pela virtude, fortificar os ossos, se unir na ambição. A convergência desse Quatro Mandamentos era conhecida como a Assembleia de Guili\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "Na superfície, parece um conjunto de mandamentos. Regras de ouro para a vida cotidiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Mas... supostamente consiste em umas pistas para o tesouro escondido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "...Eu não consigo decifrar, no entanto. Parece que teremos que usar o que os acadêmicos chamam de o bom e velho jeito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Aquelas sete mensagens que encontramos anteriormente estavam todas localizadas em ruínas de diferentes formas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Como não sabemos por onde começar, vamos procurar nas ruínas agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "Onde então?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Hum... Por ora, a área de procura está delimitada nas Planícies de Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "No entanto... Como sou apenas um acadêmico, não há como eu conseguir acompanhá-lo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "Então, deixo em suas mãos a procura das ruínas. Por favor me informe quando encontrar algumas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "Falando nisso, uma vez me deparei com uma placa estranha com alguns escritos em uma das ruínas por aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Mas, só fiz algumas pesquisas isoladas em vez de análises holísticas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Agora quando me recordo, talvez o prato daquela ruína tenha certas relações com os Quatro Mandamentos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Hmm. bom, então vou marcar a localização no mapa, e você vai verificar, talvez encontre algumas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "T... todas as ruínas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Claro que não, apenas nós dois não seríamos capazes de cobrir todas as ruínas em Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Então vamos delimitar o perímetro de busca como o tesouro tem a ver com Assembleia de Guili das Planícies de Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Hum... então o perímetro de busca está delimitado nas Planícies de Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Oh, mais uma coisa. Como sou apenas uma acadêmica, não tem como eu conseguir acompanhar você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "Então, deixo em suas mãos a procura das ruínas. Por favor me informe quando encontrar algumas pistas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "Já vou procurar todas as ruínas de Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Espere! Tranquila! Você tem ideia de quanto tempo demora para procurar em todas as ruínas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Você não pode se dar ao luxo de ficar tão animado toda vez que ouve a palavra tesouro, sabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Que tal fazermos assim: Já que o tesouro tem a ver com a Assembleia de Guili das Planícies de Guili, então vamos delimitar o perímetro de busca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Deixe-me pensar... o perímetro de busca será dentro das Planícies de Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "Ei! Ainda não acabei! Não se esqueça de que procurar com muita atenção. Se encontrar algo interessante, por favor me informe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Lembre-se de procurar dentro das Planícies de Guili, não deixe o seu entusiasmo ilimitado levá-lo mais longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Vamos procurar o tesouro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Falando do tesouro, de repente ficou mais animado... Enfim, vamos ler os Quatro Mandamentos de Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
