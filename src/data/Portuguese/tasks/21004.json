					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "Vou marcar as primeiras ruínas que encontrei no seu mapa. Eu sugiro começar por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "#Se encontrar algo, não fique tão animad{M#o}{F#a}. Sempre se lembre de <color=#00E1FFFF>tomar notas primeiro</color> e ler depois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
