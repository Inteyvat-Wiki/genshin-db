				"points": []
			},
			"dialogs": [
				{
					"id": 200330201,
					"content": "Prontinho! Obrigada, Viajante! Terminamos nossa missão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330202,
					"content": "Mas... todas as missões são assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330203,
					"content": "Existem outros tipos de missões.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "Você não parece muito convincente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200330207,
					"content": "Entendo... Está bom! Vou continuar tentando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330208,
					"content": "Quando eu tiver dinheiro suficiente, vou levar meu irmão e meus pais para uma viagem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330209,
					"content": "Meu irmão sempre quis viajar, mas... como eu fiquei doente, ele teve que ficar para cuidar de mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330210,
					"content": "Agora já me sinto melhor e até me tornei uma aventureira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330211,
					"content": "Hehe, é hora de realizar os sonhos do meu irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330205,
					"content": "Aos poucos você vai perceber...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "Ei, não diga isso com essa cara de cansaço...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003303,
