				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "Viajante, por favor, cuide a Anna. Ela está eufórica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330302,
					"content": "Você não quer que ela seja uma aventureira?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330304,
					"content": "Eu respeito o sonho da minha irmã.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330305,
					"content": "Ela conseguiu se recuperar de sua doença, e agora tem finalmente a oportunidade de perseguir seus sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330306,
					"content": "Como seu irmão, eu... Vou apoiá-la incondicionalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330307,
					"content": "É isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
