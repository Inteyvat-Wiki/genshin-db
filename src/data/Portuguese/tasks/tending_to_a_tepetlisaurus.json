			"dialogs": [
				{
					"id": 250200501,
					"content": "Rawr? Rwarr...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200502,
					"content": "Rawr, rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200503,
					"content": "Com um olhar alegre, Ha'ola pega a Derivabola antes de rolar pela fonte. A água espirra para todo lado, lavando a lama do corpo dele...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Hahaha, parece que o pestinha gosta da bola. Quem diria que ele ia começar a brincar no lago na hora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200505,
					"content": "Vamos até lá agora. Acho que isso conta como uma boa lavagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200506,
					"content": "Rawr...? Rwarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200507,
					"content": "Gostasse, hein? É sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200508,
					"content": "Rrarr, rrarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200509,
					"content": "Colocar você para tomar um banho não foi nada fácil... Haha, mas pelo menos agora eu sei como lidar com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200510,
					"content": "Rawrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200511,
					"content": "Por que você tá tocando minha mão...? Ah, são apenas alguns arranhões, não se preocupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200512,
					"content": "*Choro* Rawrr, rarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200513,
					"content": "Por que tão triste de repente, filhote? Você tava se divertindo muito agora há pouco! Você não cansou de tanto brincar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200514,
					"content": "#Ah, e muito obrigado pela sua ajuda, amig{M#o}{F#a}. Fique com isso como pagamento. Não tem nada especificamente valioso aí, então, por favor, só aceite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200515,
					"content": "Rawrr! Rawrrr! Rawrr—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200516,
					"content": "Não, Ha'ola, espera! Não volte para a água, eu acabei de te secar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				}
			]
		},
