					}
				]
			},
			"dialogs": [
				{
					"id": 250200101,
					"content": "Ha'ola! Seja um bom menino e fique parado! Só vou te dar uma limpada rápida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200102,
					"content": "*Choro* Rawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200103,
					"content": "Qual é, rapaz! Por que a gente não toma um banho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200104,
					"content": "Olha, tem uma fonte logo ali. Quando você estiver limpo, podemos voltar e continuar brincando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200105,
					"content": "Rawr, rawrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Ha'ola"
				},
				{
					"id": 250200106,
					"content": "Ei, espera! Não saia correndo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200107,
					"content": "P-Passou alguma coisa aqui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "Vocês vieram visitar nossa tribo? Peço desculpas por Ha'ola. Ele tá um pouco energético ultimamente, correndo pra todo lado. Ele não te assustou, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200110,
					"content": "Você tava tentando coagir ele a tomar um banho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "Coagir ele? *Suspiro* \"Implorando\", isso sim. Tem chovido muito nos últimos dias, então ele fica coberto de lama quando sai para brincar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200112,
					"content": "Tô tentando limpar ele, mas tudo que ele quer fazer é brincar o dia inteiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200113,
					"content": "Como sou uma pessoa qualquer, não consigo acompanhar ele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200114,
					"content": "Já tentou atrair ele com comida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Sim, já tentei isso. Mas assim que ele entende exatamente o que quero fazer. Ele finge desinteresse enquanto me vir por perto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200116,
					"content": "Se eu virar o olho ele vai até lá, come tudo de uma vez, então foge cavando um túnel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200117,
					"content": "É quase como se ele fosse um Tepetlissauro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Exatamente! Nem consigo imaginar que tipo de problema ele vai causar quando estiver totalmente crescido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200119,
					"content": "Só espero que ele não acabe destruindo a loja de Cheven... Sem chance eu conseguir reembolsar ela se ele acabar com aquelas gemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200120,
					"content": "*Suspiro* Acho que vou ter que tentar a ideia de Batz. Mas um Tepetlissauro ia ficar interessado mesmo nessa bola...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200121,
					"content": "Quem é Batz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Ah, ele é o encarregado de cuidar dos Tepetlissauros na tribo. Ele é um sujeito inteligente e um especialista quando o assunto é música também. Todos gostam dele, tanto humanos quanto Saurianos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200123,
					"content": "Há muito tempo... Eu conversei com o Batz sobre esse problema, e o cara imediatamente me deu um diagrama para fabricar uma \"Derivabola\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200124,
					"content": "Ele pegou isso de Mataoho e parece que os Saurianos adoram. Ele sugeriu que eu fizesse uma para Ha'ola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200125,
					"content": "Exatamente quando terminei de coletar os materiais e estava pronto para começar, Ha'ola começa a brincar de novo. Se ele estivesse usando calças, diria que elas estavam cheias de formigas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200126,
					"content": "Parece que essa ideia da Derivabola é tudo que me resta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200127,
					"content": "O que posso fazer para ajudar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "Você me ajudaria? Isso é incrível! Que bom que encontrei alguém tão legal quanto você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200130,
					"content": "Poderia ir até aquela caixa e pegar uns Caules Núcleo de Brasas para mim? Vou ficar aqui e começar na estrutura da Derivabola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kazga"
				},
				{
					"id": 250200128,
					"content": "Me avisa se precisar de uma mãozinha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Eita! Quase me derrubou!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
