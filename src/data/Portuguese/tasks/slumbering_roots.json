			"dialogs": [
				{
					"id": 730171001,
					"content": "Sonhos encharcados, sonhos secos... Ding, dong. Tique, taque. Vush, vush. É a música de Vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171002,
					"content": "#Nara {NICKNAME}? As folhas estão nos sonhos, e os galhos estão aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
