			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Oh! Finalmente te encontramos! Você deve ser Arakunti, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "Talvez não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "O quê? Como assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Porque posso ser uma árvore, posso ser a chuva, posso ser o sonho de Vana, ou posso ser as cordas de um instrumento musical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Paimon não entende nada do que ele quis dizer! {NICKNAME}, você sabe do que ele está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Também não entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Paimon entendeu cada palavra do que ele disse... Mas não entende elas juntas numa frase...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "#Nara dourad{F#a}{M#o}, e coisinha voadora, por que vocês estão procurando por Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Ei! Paimon não é \"coisinha voadora\"! Esperem... Paimon realmente está voando... Aah! Enfim, Paimon se chama Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#Nara dourad{F#a}{M#o} também tem nome, {F#ela}{M#ele} se chama {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "Foi Arapandu que nos disse que Arakunti estava na Floresta Onírica e nos pediu para virmos ver o que estava acontecendo aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "Paimon pode dizer a Arapandu que Arakunti está bem, que a Floresta Onírica está bem, e os sonhos encharcados também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#Está bem... {NICKNAME}, vamos voltar e procurar por Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "...Não! Estamos aqui para curar Máquina Varuna! Muito perigoso, Paimon quase foi enganada a ir embora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "Paimon pode dizer a Arapandu que Arakunti não quer enganar Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Arapandu provavelmente não quer saber isso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "Paimon também não! O que raios está acontecendo com esses Aranaras?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "Eu me lembro de Arapandu dizer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "Arapandu mencionou que Arakunti disse \"Ele e Nara se distanciaram mais...\" Será que quer dizer que não sabe mais se comunicar com as pessoas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "Na verdade, nós que não sabemos nos comunicar com os Aranaras.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Ah! É verdade... Somos nós que deveríamos aprender com os habitantes locais a se comunicar, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "Mas, agora que você falou, como é que os Aranaras se comunicam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "O que você acha, coisinha voadora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "#Se Nara dourad{F#a}{M#o} não sabe, como coisinha voadora saberia?! Que tal perguntarmos diretamente ao fantástico Arakunti?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Arakunti, você poderia nos dizer como nos comunicamos com os Aranaras? Gostaríamos de aprender de verdade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Por que querem aprender? Nara são Nara, Paimon é Paimon, e Aranaras são Aranaras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "... Ah, certo. Paimon quer virar uma semente e ser enterrada na terra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "Não! Nem um pouco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "#Então será que Nara dourad{F#a}{M#o} quer virar uma semente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "#Obrigad{F#a}{M#o}, mas não.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "As sementes são boas, que pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "Ei, quase esquecemos o que viemos fazer aqui. É pelo Festival Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "Para o Festival Utsava, precisamos curar Máquina Varuna. Assim o tempo retornará ao normal, e não haverão mais aqueles esporos desprezíveis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Paimon está certa. É pelo Festival Utsava, e pelo centro da terra azul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "A Floresta Onírica é boa, mas os esporos são ruins. Os Cogumelos que rondam por lá também são ruins, chove muito, por isso é difícil cozinhar os cogumelos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Oh! Então você sabe bem isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#Vamos curar a Máquina Varuna. Nara {NICKNAME}, Paimon, sigam Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "Se possível, sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Ei, não fale bobagem! Ele vai levar a sério!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Que tal tentarmos uma metáfora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "#Está bem, Paimon vai tentar! Nara dourad{F#a}{M#o} é como... É como... Hã... Como Ovo Frito de Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "... Vamos perguntar a Arakunti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "Eu acho que consigo adivinhar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Fantástico! Então o que é que ele quis dizer exatamente com isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "Ele disse que podia se transformar em muitas outras coisas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Sério? {NICKNAME}, não minta para Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301704",
							"2"
						],
						"stepId": 7301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Raízes de uma grande árvore, bom. Posso ouvir uma respiração molhada, uma canção sonolenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Hã... Paimon ainda não entende o que Arakunti está dizendo, mas deixa para lá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Falando nisso, há um enorme espaço dentro. É isso que chamam de raízes tortas? Paimon continua tendo a sensação que esse local é muito diferente dos demais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Será que vamos encontrar folhas que fornecem energia para a Máquina Varuna em um lugar como esse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "Está aqui, mas não está aqui. Posso ouvir a sua voz, sentir o seu cheiro, ver as suas veias, mas Paimon não consegue achar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Hã? O que foi isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Se Paimon não consegue encontrar, quanto mais eu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "#Nara dourad{F#a}{M#o} pode ver a melodia, como a brisa refrescante da noite, o orvalho repentino que quebra o sonho da superfície de um lago em milhares de pedaços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Soa impressionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#Nada mau, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Hehe... Espere, não! {NICKNAME} está roubando as palavras de Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} se transformou em Paimon... é mais assustador do que dançar com cogumelos em Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Não consigo imaginar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "É por isso que algo assim não acontecerá! É melhor que nunca aconteça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Arakunti, você não pode ser mais claro? Onde raios vamos encontrar folhas para a Máquina Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Nos sonhos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Oh... Espere, por que você não disse logo desde o começo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Porque Paimon perguntou porquê, não onde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Hã... Paimon acha que do nada entendeu como os Aranaras se comunicam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, pode nos dizer exatamente onde fica cada uma das três folhas que estamos procurando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Sem problemas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Uau, Arakunti realmente só responde perguntas feitas diretamente... Certo, onde são esses três locais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Aqui, ali, e daquele lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Uh-huh... Espere! Você não está explicando nada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Paimon, derrotada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#Paimon derrotada e {NICKNAME} derrotad{F#a}{M#o} é a mesma coisa! Não podemos contar com nada que Arakunti diz... Como deveremos encontrar esses três locais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "A Máquina Varuna foi feita pelos maiores Aranaras. A conexão entre galhos e folhas é invisível, mas pode ser vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} pode ver os Aranaras, se pode ver os traços dos Aranaras, pode encontrar as direções.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "Oh, Paimon finalmente entendeu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Basta seguir os rastros dos Aranaras para encontrá-los, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "*Choro* Pelo menos dê para Paimon a chance de responder dessa vez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
