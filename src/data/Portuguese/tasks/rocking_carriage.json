			"dialogs": [
				{
					"id": 733520101,
					"content": "#Ora, olá, {M#caro}{F#cara} viajante de longe e sua amiguinha. Vocês estão aproveitando o Festival Sabzeruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520102
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520102,
					"content": "Se vocês tiverem interesse, eu, Mestre Fantasma dos Brinquedos, terei o prazer de convidar vocês a jogarem um novo jogo — a \"Carruagem de Balanço\", uma flor que desabrocha apenas durante o Festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520103
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520103,
					"content": "E o que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520104,
					"content": "Só pelo nome, Paimon tá meio que imaginando Nahida balançando de um lado para o outro alegremente na carruagem dela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520105,
						733520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520105,
					"content": "Até eu estou ficando bem feliz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				},
				{
					"id": 733520107,
					"content": "Maravilha! Todos em Sumeru desejam que a \"Arconte Dendro seja feliz todos os dias\", afinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520108
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520108,
					"content": "Essa associação que você vez... Ah, que cena excelente! Uma que merece ser retratada em um pergaminho magnífico, se me permite dizer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520109
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520109,
					"content": "Mesmo assim, a atmosfera desse jogo é mais animada. Ao invés de uma celebração, é melhor pensar nisso como uma aventura—",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520110
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520110,
					"content": "\"Inteligente ou não, comportada ou levada, cada criança com um bom coração receberá sua própria Carruagem de Flores durante as comemorações do Festival Sabzeruz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520111
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520111,
					"content": "\"Viajando na própria carruagem, as crianças embarcarão em aventuras únicas, encontrando e superando perigos, e encontrando o maior tesouro, mil flores desabrochando...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520112,
						733520113
					],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520112,
					"content": "Paimon é esperta e comportada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520114,
					"content": "Hehe, isso mesmo! E quanto ao tesouro, é melhor dar logo ele pra gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733520115,
					"content": "Haha, ótimo, ótimo. Nesse caso, joguem até seus corações ficarem satisfeitos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mas'ud"
				},
				{
					"id": 733520113,
					"content": "Confie em mim, conquistar dificuldades é com a gente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520114
					]
				},
				{
					"id": 733520106,
					"content": "Você me faz querer assistir Nahida fazendo isso também...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733520107
					]
				}
			]
		}
	]
}