			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420401,
					"content": "Você retornou. É estranho. Todas aquelas crianças voltaram de repente, e pareciam muito assustadas, também.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420402,
					"content": "Eles encontraram alguns bilis churros lá fora, aqueles com os bastões?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420403,
					"content": "Mesmo assim, eles voltaram... Espere, qual é o seu problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420404,
					"content": "Uh, na verdade, eu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "... Você... Humano incompreensível! O que o possuiu para fazer isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420406,
					"content": "Você poderia simplesmente ter brincado com essas crianças da maneira normal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420407,
					"content": "Miau! Não me admira que estivessem tão assustados... Você deve ir e confortá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420408,
					"content": "Sério, agora. Esta supõe que foi um pouco demais achar que todos os humanos fossem como a Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		}
	]
