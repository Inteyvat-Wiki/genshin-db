				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420301,
					"content": "Você retornou. Você já alimentou aqueles malandros?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Bom, muito bom. Você tem os agradecimentos desta aqui. Sem sua ajuda, essas crianças teriam brincado e brincado... E então teriam passado fome lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420304,
					"content": "*Suspiro* Que bando de crianças desobedientes. Como eles estarão aptos a receber as pessoas que vêm ao santuário desta maneira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
