					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Eles guardaram as coisas às pressas e não tiveram tempo de levar todos os seus bens. Eles não iriam simplesmente deixá-los aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Quando eles pensarem que saímos do local, eles voltarão para pegar seus pertences. Só precisamos garantir que o rastreador vá longe o suficiente daqui para fazê-los supor que é seguro voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Ah, Paimon entendeu! Vamos atraí-los porque vão pensar que saímos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Certo, vamos começar a ir embora e deixar este lugar com você.",
