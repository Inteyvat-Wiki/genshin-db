			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Tanto calor... se ao menos houvesse um lugar para se refrescar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "Vamos descansar um pouco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Ainda há um longo caminho a percorrer, vamos. E aqui não é um bom lugar para descanso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "*Ofegante* Tudo bem...Você não sente calor, Cyno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "Claro que sim, mas já estou acostumado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "Existe algum segredo? Paimon não aguenta mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "Apenas mantenha o foco e use sua força de vontade. Você se sentirá mais cansada quando começar a ceder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "Apenas pense no próximo passo e não deixe seu cérebro pensar que seu corpo chegou ao limite. Precisamos chegar a um lugar seguro antes de podermos relaxar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "Tudo bem. Mas o que significa um lugar seguro? Paimon se sente segura aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "Veja, este é um deserto sem fim e não há monstros ao redor, ops! De onde vieram esses escorpiões venenosos!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "Cuidado, tem algo errado com eles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Uff... Paimon não achou que encontraríamos escorpiões aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "Esses não eram escorpiões comuns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "Veja, há números marcados em suas pinças. Eles foram criados por alguém.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "Você quer dizer que...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Alguém não quer que apareçamos no leilão. Esses escorpiões foram enviados para nos manter afastados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "O deserto nos cerca por todos os lados. Se fôssemos eliminados aqui, ninguém saberia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "Que lugar perigoso! Ainda bem que não baixamos a nossa guarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "Algo não está certo... Não há estradas no deserto, então como eles podem saber onde estamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#Não se mexa, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "Aqui está a resposta... Eles devem ter plantado isso em você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "Hã? O que é isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "Um dispositivo rastreador em miniatura feito pelos Kshasrewar. Eles usam isso para determinar sua localização aproximada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "Mas eu lembro que esse dispositivo não obteve permissão para ser produzido em larga escala. Onde eles conseguiram isso...? Será que alguém dos Kshahrewar está envolvido nisso? Hmm, isso não parece certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#Ahh, Paimon nem sabia que esse tipo de coisa existia. Mas por que está com {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "#Eles provavelmente a plantaram {M#no}{F#na} Viajante durante nossa luta com os mercenários mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "Eu sinto muito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "Foi uma luta frenética. É natural que você não tenha notado o dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "Bem, que bom que você conseguiu encontrá-lo, Cyno! Agora vamos nos livrar disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100420,
					"content": "Hmm, não... Fique com isso por enquanto. Ainda pode ser útil para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100421,
					"content": "Vamos continuar indo para o leilão. Seria perigoso ficar aqui por mais tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100417,
					"content": "Eu nem percebi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Estranho... É aqui que é o leilão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "Não tem ninguém aqui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Sim, nem uma única alma viva... Talvez eles estejam de folga agora ou algo assim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "Não perdemos tempo, chegamos aqui logo depois que derrotamos aqueles mercenários. Eles não deveriam ter dado nenhum aviso de nossa chegada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "Mas mesmo assim, eles ainda sabiam que estávamos vindo. Alguém aqui deve ter observado o rastreador e avisou a todos para saírem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Hmm... O que devemos fazer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Agora procuramos na área. Eles não poderiam ter movido todas as Cápsulas de Conhecimento tão rapidamente. Ainda pode haver algo para encontrarmos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "Vamos procurar então!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
