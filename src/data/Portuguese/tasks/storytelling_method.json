					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "*Suspiro* Está bem, eu não tenho mais forças para discutir com você... Viajante, obrigado pelo seu julgamento...",
