			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi, você acha que essa Melão de Lavanda Nanica está dormindo? Com o que está sonhando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Muu? Muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Ela parece exausta. É difícil ver ela desse jeito. Geralmente ela nunca cala a boca, mas... *Suspiro* Ah, que pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "E ainda tem aquele cara, ele parece exausto. De qualquer forma, estou preocupado com ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Muu, muu, muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "Eu também durmo assim na cela? Você está tirando sarro com minha cara! Eu durmo como um rei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293307,
					"content": "#{NICKNAME}?! Quando você chegou aqui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
