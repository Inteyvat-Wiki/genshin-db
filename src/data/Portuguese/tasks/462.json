				"points": []
			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}! Você voltou! Parece que você tem uma informação nova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620502,
					"content": "Mais ou menos. É mais complicado do que parece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620503,
					"content": "\"Três Gigantes de Seis braços residem dentro do lago da cidade. Dois ficam de guarda na estátua e um no tesouro.\" O que isso quer dizer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620504,
					"content": "Enigmas? Assim tão convencional? Deixe-me pensar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620505,
					"content": "\"Cidade no lago\" deve ser Mondstadt com certeza... Gigantes de Seis Braços? Seis? Hum?...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620506,
					"content": "Caranguejos?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "Caranguejos gigantes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620508,
					"content": "Além de perguntar exatamente onde encontraríamos caranguejos gigantes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620509,
					"content": "Os caranguejos possuem oito pernas, não seis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620516,
					"content": "...Moinhos de vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "Deve ser o... Moinho de vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "Ei! Isso é brilhante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620519,
					"content": "Um moinho de vento possui 6 pás... Perfeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620510,
					"content": "Uau! Isso faz sentido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620511,
					"content": "Então, dos três moinhos de vento, dois estão perto da estátua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620512,
					"content": "O outro está guardando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620513,
					"content": "Oh! Isso eu sei! O tesouro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620514,
					"content": "Hehehe, espero que seja simples assim mesmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620515,
					"content": "#Vamos lá, {NICKNAME}! Vamos dar uma olhada no Moinho de Vento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46207",
							"2"
						],
						"stepId": 46207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"46206",
							"3"
						],
						"stepId": 46206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "\"Ela não o ama. A paixão que brota nas águas termais é só de fachada. Quando ela está fria e sozinha, o seu verdadeiro coração é revelado.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "Alguma ideia do que significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "Esta é página retirada de um romance de amor que vocês acabaram de encontrar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "Ah, então não é uma pista? Por isso, alguém tão inteligente como Paimon não consegue entender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "Hahaha... Estou brincando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "Hunf... Leve isso mais a sério, Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "Haha, esse enigma é difícil de entender. Águas termais... Está se referindo ao Vale Termal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "Talvez quando as pessoas estiverem se banhando nas águas termais?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "Quando o nível da água muda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "\"Paixão correndo pelas águas claras...\" Então, quando a paixão corre através de água clara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "Que comportamento inadequado... Creio que não é muito comum em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "A menos que... Seja do interesse de vocês?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "Oh, minhas desculpas. Eu não deveria julgar o que você faz no seu tempo livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "#O que há de errado com você? Que tipo de pessoa você pensa que {NICKNAME} é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "Hum... Quando a altura das águas não for igual?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Haha. A questão é que, se a \"paixão que brota\" não vem das águas, vem das pessoas que se banham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "Boa ideia! Tipo quando... Tem uma cachoeira por exemplo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "Parece que a solução para esse enigma se esconde na cachoeira atrás da montanha do Vale Termal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "Somente as águas termais que abençoam Mondstadt podem revelar a paixão descrita aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "E quando ele diz que \"seu verdadeiro sentimento transborda\", ele deve se referir ao penhasco no lado esquerdo da cachoeira. Percebi quando olhei enquanto patrulhava a área.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "O final, \"frio e sozinho\", provavelmente tem algo a ver com Cryo, que pode ser controlado por uma Visão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "#Obrigad{F#a}{M#o}, Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "Você provavelmente deve <color=#00E1FFFF>levar alguém que possua poderes Cryo com você</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "Isso não é nada. Se um Cavaleiro de Favonius não conseguiu responder a um enigma, como podemos confiar em resolver mistérios criminais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "Vamos dar uma olhada no Vale Termal, assim você poderá continuar com os \"mistérios criminais\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "...Hã?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "Oh, você pode continuar resolvendo crimes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
