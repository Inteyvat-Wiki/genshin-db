			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "Não sei por onde começar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160102,
					"content": "O que você está fazendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Oh, é você! Eu estou pensando em escrever um romance novo, mas não estou conseguindo, sempre me faltava umas coisinhas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160104,
					"content": "Já fiquei pensando por muito tempo, mas ainda estou completamente perdido. Com este ritmo, ninguém sabe quando posso começar a escrever...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160105,
					"content": "#Você é {M#um}{F#uma} viajante, certo? Então deve saber como é o mundo. O que você acha que é a essência para o sucesso de um romance?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
