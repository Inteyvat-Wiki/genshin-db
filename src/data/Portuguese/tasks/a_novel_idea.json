			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Batalhas impecáveis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Batalhas... err... Batalhas. Sim, faz sentido! Isso chama mais atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160303,
					"content": "Não se vê uma batalha na Vila Qingce, muito menos uma batalha impecável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160304,
					"content": "Er! Talvez eu precise de ver mais longe... Ah, na natureza! Ouvi dizer que tem muitos aventureiros lá fora na natureza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160305,
					"content": "Eles vão para todos os lados para procurar tesouros, e sempre resolvem por lutar com monstros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160306,
					"content": "Por acaso, eu conheço um lugar cheio dos monstros. Talvez seja um lugar certo. Vamos esperar ali pelos aventureiros, e testemunhar uma batalha em primeira mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160307,
					"content": "E depois... hehe, terei tudo que quero. Bom, sem mais delongas, já vou! Aquele lugar parece um pouco distante, vocês também não perdem muito tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
