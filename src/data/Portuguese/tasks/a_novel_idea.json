				"objectNames": [
					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "Da última vez que entrei na cidade, vi um homem falando com uma jovem senhora que parecia ser uma cartomante. Ele estava tagarelando... Eu não me dei ao trabalho de ouvir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160702,
					"content": "E depois eu cheguei a saber que o homem se chama Zhihua, a mulher, Qiming. Talvez tenha mais histórias entre eles dois, você pode ir e perguntar mais sobre as histórias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Agora, eu me lembro... Você conhece uma menina chamada Sisi? Ela fica vagando por aí de vez em quando, e espera por um marinheiro chamado Chaoxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160802,
					"content": "Ela aparece lá com certa frequência... Será que também existem histórias românticas atrás?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160803,
					"content": "Faça um pouco de investigação, de qualquer forma. Se você encontrar alguma história boa, anote-as e traga-as de volta para cá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
		{
			"id": 2211609,
