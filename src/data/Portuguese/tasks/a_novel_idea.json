			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang, o Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "Ei! Desta vez... Posso dizer que já experimentei uma batalha impecável pessoalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160502,
					"content": "Achei que você só queria assistir a batalha à distância.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Eu também pensei assim, mas os aventureiros nunca apareceram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160504,
					"content": "Reparei que os monstros eram devagar em fazer um movimento. Se eles tivessem ido embora, tudo teria sido em vão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160505,
					"content": "E depois eu joguei uma pedra pequena neles para chamar a atenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160506,
					"content": "Mas... joguei mal. A pedra bateu na cabeça de um monstro. E depois... vocês já sabem o resto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160507,
					"content": "Ai! Bom, apesar de ter algumas lesões e contusões leves, consegui uma história boa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160508,
					"content": "Agora estou cheio das ideias criativas. Muito obrigado pela ajuda. Esse é o meu agradecimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Chang, o Nono"
				},
				{
					"id": 221160509,
					"content": "Sinto que já posso começar a escrever assim que eu voltar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang, o Nono"
				}
			]
		},
