					"speakerTitle": "Astuto"
				},
				{
					"id": 400040803,
					"content": "Que coincidência, eu já estava com esse pressentimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040804,
					"content": "#{NICKNAME} venha ler a carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040805,
					"content": "Entendi, então vamos deixar que estes dois irem à reunião.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040806
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040806,
					"content": "O remetente parece estar tramando algo verdadeiramente diabólico para o Ritual de Lanternas. Parece que eles querem queimar a cidade inteira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040807
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040807,
					"content": "Ótimo, todos estão felizes. Você está bem, nós estamos bem, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040808
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040808,
					"content": "O problema é que vocês e nós não nos parecemos em nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040809
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040809,
					"content": "Não se preocupe. Ninguém conseguirá reconhecer você depois de se disfarçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040810,
					"content": "Estou com um mau pressentimento... Contudo, se temos o respaldo de um Adeptus, não há com o que se preocupar, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040811
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040811,
					"content": "*Suspiro* Bem, a segurança de Liyue está em suas mãos. Boa sorte, nem mesmo os Ladrões de Tesouro querem ver a cidade enterrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040812
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040812,
					"content": "Sendo assim, então está decidido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040813
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040813,
					"content": "Espere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040814
					]
				},
				{
					"id": 400040814,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040815
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040815,
					"content": "Quando nos vermos de novo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040816
					]
				},
				{
					"id": 400040816,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040817
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040817,
					"content": "Espero que seja um lugar onde possamos ver as Lanternas Mingxiao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040818
					]
				},
				{
					"id": 400040818,
					"content": "... Não gosto de lugares muito movimentados, especialmente, nesta época do ano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040819
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040819,
					"content": "Realmente temos que ir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040820
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040820,
					"content": "Sim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040821
					]
				},
				{
					"id": 400040821,
					"content": "Entendi, vou esperar por notícias suas.",
					"roleType": "TALK_ROLE_NPC",
