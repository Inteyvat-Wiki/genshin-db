			"dialogs": [
				{
					"id": 400040201,
					"content": "#{NICKNAME}, há quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040202,
					"content": "Kaeya, nós fomos para Liyue e estava tendo um Festival de Ritual de Lanternas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040203,
					"content": "Ah, então, como foi? Divertido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040204,
					"content": "Delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040205,
					"content": "Bem, então esperem pelo Ludi Harpastum de Mondstadt! Tenho certeza de que vocês vão gostar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040206,
					"content": "Vá direto ao ponto, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "Sim... Sim... Kaeya, tem uma coisa que preciso contar para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040208,
					"content": "Hum... Suprimentos de lanterna... Pilhas de madeira, papel e óleo... Por fim, parece haver perigo de acidente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040209,
					"content": "Haha, interessante, por que vocês acham que eu sei de algo sobre este símbolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040210,
					"content": "Kaeya é incrível em tudo e nós confiamos nele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "Sim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040212,
					"content": "Haha, estou lisonjeado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040213,
					"content": "Você ouviu isso? A humildade de um cavaleiro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040214,
					"content": "Pelos deuses, a sua estadia em Liyue afiou realmente a sua língua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040220,
					"content": "Mas, voltando ao ponto. Esse é o símbolo dos Ladrões de Tesouro, uma organização criminal transnacional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040221,
					"content": "#Se você estiver curios{M#o}{F#a} para saber mais, posso colocá-l{M#o}{F#a} em contato com um informante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040222,
					"content": "Eu pensava que os Cavaleiros de Favonius não lidavam com inimigos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040223,
					"content": "É o meu informante, não dos Cavaleiros de Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040224,
					"content": "Vá até a Origem do Vento. Depois, eu irei enviar meu informante para lá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040225,
					"content": "Obrigada, Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040226,
					"content": "Oh, e lembre-se: \"A verdade está no vinho\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040227,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040215,
					"content": "Kaeya conhece o lado sombrio e o lado bom, por isso podemos confiar nele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "Isso mesmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040217,
					"content": "#Recomendo que você tenha mais cuidado com o que fala, Cavaleir{M#o}{F#a} Honorável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040218,
					"content": "O que você quer dizer com \"recorrer aos caminhos do bem e do mal?\" Nós, os Cavaleiros de Favonius, não lidamos com criminosos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040219,
					"content": "Isso está relacionado com uma virtude dos cavaleiros chamada de: integridade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
