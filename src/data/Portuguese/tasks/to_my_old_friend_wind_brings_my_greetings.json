					"speakerTitle": "Belle"
				},
				{
					"id": 400040902,
					"content": "Esse não é o caminho para o Porto de Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040903,
					"content": "Por acaso é por lá, pois por aqui não há nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040904
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040904,
					"content": "Se você está procurando um lugar para ficar, sugiro que você vá ao Albergue Wangshu. Preços justos, ótimo atendimento ao cliente e uma vista maravilhosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040905
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040905,
					"content": "Queremos ver a carta anônima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040906
					]
				},
				{
					"id": 400040906,
					"content": "... Como você sabe sobre a carta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040907
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040907,
					"content": "Um Adeptus de Liyue nos contou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040908,
					"content": "Você não consegue enganar ninguém com essa mentira!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040909
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040909,
					"content": "#Você não deveria duvidar. Fui eu que {M#os}{F#as} mandei investigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040910,
					"content": "Alguma dúvida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400040911,
					"content": "Vo... Você é o Guardião Yaksha?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040912
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040912,
					"content": "Cuidado com seu tom de voz! Ou você realmente se atreveria a lutar contra um Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040913,
					"content": "Não é que eu não acredite que você seja um Adeptus, só que... Todos precisam ver a imagem completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040914
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040914,
					"content": "Como você sabe, nós, Ladrões de Tesouro, não somos uma ameaça séria para ninguém. Somos pequenos criminosos, só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040915
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040915,
					"content": "Então, se você realmente for um Adeptus, por favor, tenha misericórdia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040916
					],
					"speakerTitle": "Astuto"
				},
				{
					"id": 400040916,
					"content": "Claro, se não for um Adeptus...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040917
					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040917,
					"content": "Então, por favor, não culpe nossas armas por tratar todos igualmente...",
