			"dialogs": [
				{
					"id": 400040301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040302,
					"content": "Ei, é você, certo? O informante de Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040303,
					"content": "Que informante? Do que você está falando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040304,
					"content": "Mas... Esse é o lugar que marcamos, e você é a única pessoa aqui, então...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040305,
					"content": "Local combinado? Não sei do que você está falando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040306
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040307,
					"content": "\"A verdade está no vinho\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040308
					]
				},
				{
					"id": 400040310,
					"content": "Alguma coisa sobre... O vinho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040311
					]
				},
				{
					"id": 400040306,
					"content": "Ugh, pare de ser tão irritante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040307,
						400040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040308,
					"content": "Ok, sim, sou eu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040309
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040309,
					"content": "Para que tanta formalidade?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040311,
					"content": "Hum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040312
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040312,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040313,
					"content": "Ok... Embora a senha esteja errada, se tudo está no vinho, então a verdade também está.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040314
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040314,
					"content": "Isso mesmo, somos do mesmo bando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040315
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040315,
					"content": "Para que tanta formalidade?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040316,
					"content": "O que você quer saber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040317,
					"content": "Esta é a situação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040318,
					"content": "Ok, entendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040319,
					"content": "Então? Você tem algum informante interno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040320,
					"content": "Não acho que esse seja trabalho dos Ladrões de Tesouro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040321,
					"content": "A razão pela qual os Ladrões de Tesouro são capazes de sustentar uma operação transfronteiriça gigante é porque eles cumprem um princípio fundamental.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040322,
					"content": "A ideia de correr riscos enormes para tentar fazer uma fortuna é loucura, o caminho certo a se seguir é lento, mas seguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040323,
					"content": "Liyue está sob a proteção de um Adeptus, não é? O Guardião Yaksha, especialmente durante o Ritual de Lanternas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040325
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040324,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040325,
					"content": "Nós, Ladrões de Tesouro, não atacaríamos... *Cof cof* Desculpe, quando você está infiltrado por tanto tempo... Eles, os Ladrões de Tesouro, não se atreveriam a atacar durante o Ritual de Lanternas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040326
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040326,
					"content": "Além disso... A organização de Ladrões de Tesouro em Liyue recebeu uma carta anônima recentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040327
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040327,
					"content": "Por que alguém enviaria uma carta anônima? Estão querendo emboscar os Ladrões de Tesouro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040328,
					"content": "Ninguém sabe. Mas o que posso dizer é qual grupo dos Ladrões de Tesouro tem a carta em seu poder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040329,
					"content": "... Pronto. Eu marquei a localização deles no mapa para você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040330
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040330,
					"content": "#Ótimo, obrigada pela ajuda! {NICKNAME} temos que seguir a nossa única pista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040331,
					"content": "Se não houver mais nada, eu vou continuar a saquear tesouros... Digo, tomar as medidas necessárias para cuidar dos tesouros.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
