					],
					"speakerTitle": "Belle"
				},
				{
					"id": 400040802,
					"content": "A carta está escrita em uma linguagem indecifrável, não é necessário recorrer a violência! Tome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040803
