					"nextDialogs": [
						750250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250103,
					"content": "Rawr! ...Rrrawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} parece tão animado! Não é sempre que você pode conhecer tantos companheiros de uma vez, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250105,
					"content": "Rawr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Oh, você quer dizer que quer ir lá brincar com eles? Pensando nisso, {REALNAME[ID(2)|SHOWHOST(true)]} dificilmente anda com outros Tepetlissauros..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250107,
					"content": "Tenha cuidado, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Uh, Paimon ainda tá um pouco preocupada... Enfim, vamos encontrar um lugar para relaxar e comer algo enquanto esperamos {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250111,
					"content": "#Você e Paimon encontram um lugar confortável para descansar enquanto {REALNAME[ID(2)|SHOWHOST(true)]} termina de brincar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Mas vocês acabam esperando mais do que esperado...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#Estranho... Como que {REALNAME[ID(2)|SHOWHOST(true)]} ainda não voltou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250114,
					"content": "Paimon espera mesmo que nada ruim tenha acontecido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250115,
					"content": "Talvez se deixaram levar na diversão?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "Se for o caso, temos que dar um belo sermão nele. O sol está quase se pondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250117,
					"content": "Urg... Vamos procurar por ele antes que fique tão escuro que não conseguimos ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250108,
					"content": "Não suma por muito tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
