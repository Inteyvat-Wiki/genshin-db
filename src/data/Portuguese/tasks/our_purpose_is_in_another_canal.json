			"dialogs": [
				{
					"id": 740910401,
					"content": "Vocês são... muito gentis... Obrigado...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910402,
					"content": "Você está bem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910403,
					"content": "Eu... estou... bem... eu acho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910404,
					"content": "Sua aparência diz o contrário.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "V-Vocês poderiam me levar até o cais ali...? Eu... eu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910406,
					"content": "Ok, pare de falar por enquanto. Te levaremos de volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
