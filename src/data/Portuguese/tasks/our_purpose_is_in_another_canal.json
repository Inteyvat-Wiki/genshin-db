			"dialogs": [
				{
					"id": 740911001,
					"content": "Voltamos! Realmente havia alguns probleminhas, mas não se preocupe! Já lidamos com tudinho seguindo as instruções que você nos deu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Muito obrigado. Se vocês não tivessem arrumado esses riscos em potencial de forma tão rápida, teria sido tarde demais para consertá-los se tivesse se tornado um desastre maior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "...E é por isso que não me dou bem com o Monsieur Aiguoy, embora eu saiba que ele está cuidando de mim do seu jeito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Enfim, obrigado novamente por salvar a minha vida e por me ajudar com a inspeção. Aqui, fique com isso como compensação.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Desculpe por te incomodar aqui e te segurar em sua jornada. Eu te desejo uma boa viagem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
