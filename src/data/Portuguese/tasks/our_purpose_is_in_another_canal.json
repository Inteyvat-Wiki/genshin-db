			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Aquela criança, ela não foi pega por Hilichurls e jogada em sua panela de sopa, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Que criança?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Tá vendo aquele acampamento Hilichurl perto da água ali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "É como se tivesse simplesmente aparecido do nada. Eles estão trabalhando dia e noite e não param para descansar quando deveriam. *Suspira* Assim como Balent, aquele jovem bobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Pelo que vejo, a sorte está do lado dele, então ele provavelmente não está sendo cozinhado em uma panela no momento. Talvez esteja tendo uma conversa animada com os Hilichurls enquanto conversamos. Quem sabe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Hã? Então o que você está dizendo é que alguém que você conhece foi levado pelos Hilichurls ali? Como você não está preocupado? Se você está falando sério, então precisamos nos apressar e ir salvá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Salvar ele? Por quê? Eu já disse a ele que não precisava sofrer tanto em um trabalho tão perigoso desses. Ele deveria apenas reportar para Estienne durante o horário programado e pedir a ele para encontrar alguém para lidar com isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Eu fui gentil o suficiente de ensinar isso a ele, mas é assim que ele me paga? Ele me acusou de não levar meu trabalho a sério e negligenciar meus deveres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Já que ele não leva a sabedoria e experiência dos mais velhos a sério, tudo que tenho a dizer é que tudo isso foi escolha dele. Os jovens precisam levar algumas rasteiras. Como que podem crescer se não aprenderem lições difíceis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "É difícil de julgar sem ouvir ambos os lados da história.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Isso mesmo, temos que salvar ele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "É perigoso por aí! E se vocês, jovens, se machucarem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Relaxa! {M#O}{F#A} {NICKNAME} é super forte! Só espere bem aqui, vovô! Voltaremos rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Ele pode estar em perigo, e você não pode amadurecer e crescer se estiver morto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Que sopa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Esse é realmente o ponto!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
