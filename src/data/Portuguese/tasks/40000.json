				},
				{
					"id": 400000202,
					"content": "Ele é...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Ugh. Parece que você ainda não conhece... É um jogo de mesa criado por mim mesma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Vê estes itens aqui na mesa? São usados no jogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Parece ser muito complicado...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "Na verdade nem tanto... É fácil de aprender, é apenas uma questão de se familiarizar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Que tal fazer uma tentativa?",
