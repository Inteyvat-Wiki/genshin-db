							469.192,
							4587.584
						],
						"pointId": 340300485
					}
				]
			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "Estamos nisso há um meio dia já, e os monstros não estão mostrando nenhum sinal de diminuir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870102,
					"content": "Talvez eu deveria chamar reforços?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870103,
					"content": "Não precisa entrar em pânico. Confie no canhão e em nosso colega de roupas simples!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870104,
					"content": "#Além disso, tem {M#um aventureiro}{F#uma aventureira} com nariz para perigo e um certo policial que certamente aparecerá se estivermos em uma crise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870105,
					"content": "Que papo é esse sobre crise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "Aqui estão... Proto-Chefe e sua pequena assistente realmente apareceram!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870108,
					"content": "Olá. Permitam-me explicar a situação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870109,
					"content": "Por que você não dá uma descansada? Eu posso explicar a situação para esses dois.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870110,
					"content": "Ei! Quer se divertir no canhão? Oportunidades como essa não aparecem sempre — pelo menos, não desde que a frota foi destruída. É como voltar centenas de anos no passado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870111,
					"content": "Explodir monstros com essas balas de canhão especiais é uma forma perfeita de relaxar — e os Gardes até te recompensarão por isso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870112,
					"content": "Explodir monstros com um canhão gigante... Isso é bem a nossa praia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870113,
					"content": "Certamente parece algo bem simples.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "Entendo sua animação, Proto-Chefe, mas a situação é meio crítica. Deixe-me te explicar o que está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870116,
					"content": "Recentemente, um grupo de trabalhadores inesperadamente desenterraram algumas ruínas próximas, perturbando os monstros que estavam adormecidos lá dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870117,
					"content": "Para impedir os monstros de escaparem e causarem problemas, os Gardes montaram uma zona de contenção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870118,
					"content": "Bem, eu digo \"zona de contenção\" mas... No momento, somos apenas nós dois e uma agente Melusine que por acaso estava aqui de férias... Oh, e nosso canhão personalizado, é claro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870119,
					"content": "Eita! Isso parece perigoso! Paimon espera que a agente Melusine não esteja em perigo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870120,
					"content": "Não se preocupe com ela. O canhão na entrada para as ruínas pode ser operado remotamente — ela pode acabar com os monstros sem chegar nem perto deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870121,
					"content": "Ela é bem confiável, mas essa operação já está demorando bastante, e ela deve estar exausta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870122,
					"content": "Você vai nos ajudar, Proto-Chefe? Se a situação não melhorar logo, terei que chamar por reforços.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870123,
					"content": "#Do que você está falando, Chenee? Você sabe o quão capaz Proto-Chefe é — com {M#ele}{F#ela} no controle, meu canhão vai acabar com aqueles monstros rapidinho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870124,
					"content": "Não diga mais nada. Eu adoraria experimentar esse canhão...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "Não é nosso estilo fugir do perigo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870127,
					"content": "Fantástico! Somos muito gratos pela sua ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870128,
					"content": "Após nosso último experimento, fiz alguns ajustes em minha invenção — espero que você ache mais fácil de operar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870129,
					"content": "*Suspira* Se pelo menos pudéssemos fazer com que mirasse e atirasse automaticamente... O que acha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870130,
					"content": "Espera aí! Da próxima vez, posso tentar colocar com o módulo de identificação de alvo dos Gardemeks! Dessa forma, deve ser capaz de operar sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870131,
					"content": "Que esperto — você é mesmo um gênio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870125,
					"content": "#Estou dispost{M#o}{F#a} a ajudar independente da situação.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Há um motivo em particular para explodir os monstros?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "Chegamos na hora certa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
		{
			"id": 7468703,
