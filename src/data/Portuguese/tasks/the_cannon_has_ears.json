				]
			},
			"dialogs": [
				{
					"id": 746870301,
					"content": "Oh! Lá vem o alívio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870302,
					"content": "Hã? O que vocês estão fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870303,
					"content": "A-Algo errado?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "Já nos conhecemos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870305,
					"content": "#Nada de errado! É bom ver que {M#heróis}{F#heroínas} tão famos{M#o}{F#a}s e fortes estão aqui para ajudar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870306,
					"content": "Lá na unidade — após eu ter retornado para a vila — todos disseram como vocês podiam lidar com qualquer coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870311,
					"content": "Por outro lado, aqueles ali podem ser confiáveis, mas há algo meio... estranho entre eles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870312,
					"content": "As emoções humanas são tão complicadas... acho que talvez eles precisem de um empurrãozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870313,
					"content": "Estranho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "Esqueça. Há coisas mais importantes para focar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870315,
					"content": "Enfim, tenho fé em você. O canhão é bem fácil de operar. Tenho certeza que você vai acabar com esses monstros rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870307,
					"content": "Sinto que a gente já se conheceu antes...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "Então você se lembra de mim! Apliquei para uma posição no Mundo Fantástico Chevalmarin Filmes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870309,
					"content": "Paimon acha que talvez se lembra disso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870310,
					"content": "Estou bem ciente dos seus feitos, e sei que posso confiar em você com qualquer coisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				}
			]
		}
	]
}