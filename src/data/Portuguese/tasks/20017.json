			"dialogs": [
				{
					"id": 200170101,
					"content": "Não, por favor! Não me machuque! Viajante, onde foram todos os Hilichurls?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Ótimo! Muito obrigado, eles realmente foram embora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Uff! Estou te devendo essa. Depois disso tudo, não vou mais conseguir chegar na caravana agora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "Além disso, meu carrinho está quebrado. Eu preciso consertar e seguir para a cidade antes que a fruta apodreça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Você não consegue nem imaginar o cheiro dessa fruta quando ela apodrece. Eu nunca conseguiria mais tirar esse cheiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Eu preciso examinar as frutas de novo, eu já consigo sentir que muitas já estragaram.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Você poderia me ajudar a procurar alguns materiais para consertar o meu carrinho? Uma <color=#00E1FFFF>Tábua Resistente</color> deve ser o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
