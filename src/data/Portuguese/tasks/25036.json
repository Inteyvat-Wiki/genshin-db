			"dialogs": [
				{
					"id": 250360101,
					"content": "...Essa pergunta foi fácil demais?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "Oh, minhas desculpas. Eu só estava pensando alto, não percebi você aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Permita-me apresentar. Sou Keita, dos Mestres do Vento Noturno. Atualmente sou um aprendiz, encarregado de gerenciar arquivos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "E no que você estava pensando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah... Apenas algumas questões simples sobre o passado, presente e futuro de Natlan. Totalmente desnecessário discutir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "#Ao julgar pela sua aparência, você parece ser {M#um}{F#uma} Viajante de longe. Eu consigo perceber que suas diversas amizades são profundas e sua sabedoria vasta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "#Se você estiver dispost{M#o}{F#a}, você poderia tentar algumas das questões que eu já registrei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "As respostas dessas questões estão em sua jornada — passado, presente e futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
