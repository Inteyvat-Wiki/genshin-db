			"dialogs": [
				{
					"id": 710190201,
					"content": "Tem uma grande pedra dentro daquela bacia. Paimon acha que isso é um \"jardim de rochas\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Mas eles não são normalmente colocados dentro de jardins ou quintais? Qual é o objetivo de colocar um aqui fora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Hã? Há uma coisa exótica no pico do jardim ornamental, parece estar marcando algo... É uma coisa bem notável...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Como estamos viajando... Vamos procurar por uma montanha que se pareça com esse Jardim de Rochas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Será legal se encontrarmos algo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
