			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Hã? Que estranho. Paimon tem certeza de que ouviu a voz da Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "...Hiah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220104,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Saudações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220106,
					"content": "Outro susto? Que chato! Se você estava aqui, era só ter dito alguma coisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "#Achei que, já que vocês estão tão acostumad{M#o}{F#a}s com este jogo, eu deveria aumentar a dificuldade desta rodada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220108,
					"content": "Hmph! Paimon vai te pegar na próxima, espera só!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Ótimo! Estou ansiosa por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220110,
					"content": "O que aconteceu com sua venda, Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Ah. Acho que os kuuhenki devem tê-la pegado enquanto estávamos brincando mais cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220112,
					"content": "Eu normalmente não preciso usar meus olhos, então a venda não faz muita diferença. Deixe que brinquem com ela, se quiserem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220113,
					"content": "Ah! Nesse caso, você não quer sair mais vezes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Você não precisa mais se esconder de ninguém, certo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Sim... Agora tenho tempo de sobra. Posso ir aonde quiser, quando quiser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220116,
					"content": "#No entanto, eu me preocupei de que vocês pudessem ficar aflit{M#o}{F#a}s se viessem me procurar e descobrissem que eu tinha saído sem me despedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220117,
					"content": "Em uma situação assim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "É! No fim das contas, só precisamos saber que você tá bem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Entendo. Vou considerar isso, então.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220121,
					"content": "Você só vai \"considerar\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Ou talvez este seja simplesmente o lugar onde você quer estar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Tudo o que aconteceu aqui... considero tudo isso memórias felizes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220124,
					"content": "Dito isso, tenho outro motivo para esperar por vocês aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220125,
					"content": "E qual seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Dar a vocês uma surpresa agradável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220118,
					"content": "Você pode simplesmente deixar um bilhete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
