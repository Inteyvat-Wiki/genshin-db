			"dialogs": [
				{
					"id": 761220201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220202,
					"content": "Luonnotar! É mesmo você! Voltou! Em carne e osso prateada! A Paimon achou que nunca mais veria você!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220203,
					"content": "A pintura que desenhamos...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "Usamos a luz da lua para traçar a forma desta criança, e eu infundi novos poderes e novas bênçãos nela, fazendo com que renascesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220205,
					"content": "Ela não precisa mais carregar o meu espírito. A vontade dela agora é somente dela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220206,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220207,
					"content": "Ah, ela está voando para cá!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220208,
					"content": "Sim. Eu despertei todas as memórias do tempo que vocês passaram juntas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220210,
					"content": "...! ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220211,
					"content": "*Choro* A Paimon está tão feliz em ter você de volta, Luonnotar. Paimon promete ser mais boazinha com você daqui para frente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220212,
					"content": "A Paimon não esperava que a surpresa fosse tão agradável... A Paimon adorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220213,
					"content": "#Obrigad{M#o}{F#a}, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "Não foi nada. Eu também estou feliz em vê-la novamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220216,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220217,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220218,
					"content": "(Ela ainda é muito apegada à Luonnotar, mas sua expressão é diferente de antes.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(Ela olha para Luonnotar não como uma simples criação familiar, mas como uma amiga familiar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "#Vá. Você com certeza deve sentir falta del{M#e}{F#a}s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 761220221,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220222,
					"content": "#Vocês são bem-vind{M#o}{F#a}s para voltar a qualquer momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				}
			]
		},
