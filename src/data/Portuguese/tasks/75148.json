				]
			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "Hã? Aquilo era... um Qucussauro? Então, Qucussauros realmente trazem estátuas roubadas para cá...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Espera. Ele acabou de pegar aquela estátua e saltar... direto pra cratera?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Aquela deve ser a boca do vulcão, né? Que vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Hmm... Quando pedimos informações mais cedo, não disseram pra gente que tinha um montão de Flogisto Gasoso na boca do vulcão?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Ah, espera, isso mesmo! Podemos <color=#00E1FFFF>encontrar um jeito de passar pelo Flogisto Gasoso</color>, assim como aquele Qucussauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Mas, hmm... *gulp* é meio alto, né?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Não se preocupa, Paimon, eu te carrego.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Hmm, você também tá com tudo pronto para saltar? Bem... hmmm, tá certo. S-Se esse é o caso, Paimon também não tá mais com medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "E não é só que a gente tá bem no alto — não esqueça do Flogisto Gasoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "E-Enfim, vamos partir quando estiver tudo pronto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "Contanto que você me segure antes da gente aterrissar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Dá não! Pode esquecer o problema da força — pense só como ia ser difícil acertar o tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "Rawr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "E você também! Para de ficar falando \"rawr\" pra essa loucura! *Suspiro*... Quer saber, agora vocês acabaram com a tensão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
		},
