				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Cultivaremos mais Rosas Douradas no futuro se este punhado crescer saudável.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Mas primeiro, tenho que me certificar de que estas Rosas Douradas floresçam corretamente para ter paz de espírito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Eu estava quase perdendo a esperança. Não esperava que essa flor realmente crescesse. Acho que enquanto estivermos vivos, coisas maravilhosas podem sempre acontecer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Oh, garotinha, você ainda está triste sobre o Tio Shafaqat? Não se preocupe. Aqueles que ficam vivos carregam os desejos daqueles que morreram. Não podemos desapontá-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Sr. Affan... eu não sou mais tão jovem. Os amigos que cresceram comigo... os filhos deles já cresceram ao ponto de comprarem especiarias na loja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090704,
					"content": "Mas eu concordo. Como estamos vivos, vamos viver alegremente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}