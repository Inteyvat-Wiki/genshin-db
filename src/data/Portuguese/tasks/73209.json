					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090301,
					"content": "\"Ó, rosa bela rosa, a meu desejo realizar.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "\"Ó, rosa dourada, nas rochas a desabrochar, que para mim cantará.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7320904,
			"completionStepIds": [
				7320903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
