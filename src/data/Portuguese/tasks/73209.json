			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Ah, são vocês. Nós e as rosas estávamos todos esperando vocês.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Sabbah também chegou muito cedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Tenho vindo muito aqui ultimamente, e li as notas que o Sr. Shafaqat deixou para trás.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090104,
					"content": "Anteriormente, eu achava que seria muito solitário ficar na Vila Aaru. Hoje, sinto que não.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090105,
					"content": "Na pior das hipóteses, posso dizer que não estou completamente sozinha. Tenho as rosas e as memórias que foram construídas com vocês, além daquelas com o senhor Affan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090106,
					"content": "Ainda há coisas boas na minha vida, e só de pensar nisso já me faz sentir menos sozinha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090107,
					"content": "Eu e o querido senhor Affan já combinamos. Eu o auxiliarei no cultivo das Rosas Douradas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090108,
					"content": "Cultivaremos mais rosas, até podermos encher todo o jardim. Embora, por enquanto, tenhamos que esperar que floresçam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090109,
					"content": "Você ainda se lembra de como fez as Rosas de Sumeru florescerem? Devemos usar o mesmo método.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090110,
					"content": "Deixe comigo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Agora é com você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
