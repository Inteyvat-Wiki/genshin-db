					}
				]
			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#Uau, {NICKNAME}, olha só! Parece que a gente acabou de pegar esse álbum ontem, e já enchemos ele tão rápido! E todas as fotos ficaram tão lindas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "O tempo voa quando estamos nos divertindo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Hehe, a Paimon nunca imaginou que a gente encontraria tantos lugares lindos e tiraria tantas fotos dos nossos amigos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Ooh, e olha essa aqui! A gente se esforçou pra achar o ângulo perfeito, e o resultado ficou super incrível!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "Tudo graças a você por nos guiar até lá, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Hehe, é claro! A Paimon é a melhor guia que existe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "E tudo o que ela precisa como pagamento são centenas de memórias felizes... Não, milhares!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, como você se sente tirando fotos com esse Aparelho Fotográfico? Acha que suas habilidades melhoraram bastante? Será que estamos mais perto de superar o lendário Pierre Leblanc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Minhas habilidades...? Bem, ainda tenho um longo caminho pela frente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "Hehe, você tem razão! Ser feliz é o mais importante de tudo! Além disso, a Paimon acha que as fotos que você tirou não ficam devendo nada para as de um fotógrafo mestre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "Porque cada uma delas guarda histórias que vivemos juntos. Para a Paimon, isso é algo insubstituível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "No futuro, quando a gente... Uhm, quando formos para outros lugares em novas aventuras e lembrarmos de todas essas memórias lindas... A Paimon acha que isso vai ser super legal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "Vamos tirar mais fotos juntos no futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "É! Combinado, então! Nosso próximo álbum vai ser maior, melhor e cheio de memórias ainda mais especiais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "O importante é curtir o processo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "Foi tudo graças ao seu fundo de emergência, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Cada foto guarda uma lembrança.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
