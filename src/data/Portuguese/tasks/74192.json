			"dialogs": [
				{
					"id": 741920101,
					"content": "Entendo: As chamas no trono foram apagadas e as cinzas queimadas se tornaram árvores mais uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Flores desabrocham com cada passo seu, trazendo mudança a uma decadência inevitável no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Hã? É {F#a Srta.}{M#o Sr.} {NICKNAME}! O que você tá fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Hmm, ah sim! A borboleta dourada retornou. Preciso ir ver ela! Tchau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
