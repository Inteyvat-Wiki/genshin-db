			},
			"dialogs": [
				{
					"id": 741920301,
					"content": "Já que memórias podem ser transformadas em livros, se revertermos a lógica, os conteúdos de livros também podem ser escritos diretamente em memórias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Ah, é você, {M#o estranho Sr.}{F#a estranha Srta.} {NICKNAME}. O que foi? Precisa de mim para algo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "Do que você tá falando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Hmm. Não importa como eu encare isso, converter memórias em livros é um feito incrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "O criador deste livro deve ter apenas conseguido fazer isso porque via as emoções nas próprias memórias {RUBY#[D]ilusões}como as coisas mais preciosas no mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Isso não muda como o conteúdo é difícil de entender...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "...E não tenho certeza do tipo de impacto que terá nos leitores. Isso é bem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
