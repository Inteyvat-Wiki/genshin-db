			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patchi, a Curiosa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Não existe um plano perfeito de aventura! Como você quer ter algum progresso procrastinando desse jeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410102,
					"content": "Mesmo que não tenha um plano perfeito, é necessário se preparar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "O que vocês estão discutindo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Eu sou uma pesquisadora das ruínas antigas e desejo embarcar em uma viagem ao Templo do Vento Milenar. Porém, eu não sei lidar muito bem com situações de combate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410105,
					"content": "O Sr. Doolan é um aventureiro, e se encarregou de fazer todas as preparações necessárias para a investigação no templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410106,
					"content": "Eu não tenho a intenção de criticar Doolan de nenhum modo, e eu sei que aqueles Guardas das Ruínas podem ser uma verdadeira dor de cabeça... mas ele insiste em fazer um plano perfeito, me chamando sempre para reuniões e mais reuniões...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410107,
					"content": "Temos feito investigações e emendas, seguidos de pesquisas complementares, investigações mais profundas e mais rodadas de emendas... Argh, eu não aguento mais!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410108,
					"content": "Agora ele disse que encontrou novas evidências de acampamento de monstros perto do nosso templo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410109,
					"content": "Eu imploro, você pode eliminá-los para mim por favor? Só para tranquilizá-lo um pouco, mesmo que isso não nos leve para dentro do templo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410110,
					"content": "Ok, eu já entendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Eu vim aqui me encontrar com o Doolan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Eu agradeço o gesto, mas acredite em mim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 200410113,
					"content": "... Você vai ver que é bem menos estressante lidar com os monstros do que ir a uma reunião dele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patchi, a Curiosa"
				}
			]
		},
