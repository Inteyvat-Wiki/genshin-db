				{
					"id": 752440402,
					"content": "Ainda se preocupando com aqueles bandidos? Relaxe. Se você encontrar eles, só diga meu nome e eles vão te deixar em paz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440403,
					"content": "Mas não me pergunte o motivo. Nós estávamos destinados a nos encontrar — você até me ajudou a recuperar meu chapéu. Considere isso um símbolo da minha gratidão.",
