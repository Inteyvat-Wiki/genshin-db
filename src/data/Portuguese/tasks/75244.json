			"dialogs": [
				{
					"id": 752440302,
					"content": "Isso! Oh, muito obrigado! Agora que consegui meu chapéu de volta, me sinto bem mais aliviado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440303,
					"content": "É um capacete que pedi para ser feito especialmente para mim e consegue até bloquear tiros de um mosquete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440307,
					"content": "Você está pensando demais nas coisas. É só pescaria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "Pode parecer loucura, mas um tempo atrás, teve um cara pescando por aqui que levou um tiro bem no olho. Acho que foi por um mosquete ou um arco. Viu, até mesmo pescar tem seus perigos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440305,
					"content": "Sem contar que dizem que a questão inteira foi uma guerra civil entre pessoas de Nod-Krai... Só o fato disso sequer ter acontecido significa que devemos ter cuidado!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Ruenti"
				}
			]
		},
