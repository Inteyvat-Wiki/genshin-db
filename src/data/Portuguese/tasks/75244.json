			"dialogs": [
				{
					"id": 752440101,
					"content": "Oh, ei, você também está aqui para pescar? Bem, você precisará usar um chapéu bem resistente se quiser saber mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440106,
					"content": "...Por que você precisa de um chapéu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "#Por quê? Pois um chapéu resistente vai te manter segur{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440107,
					"content": "Mas você também não usa um chapéu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "E também é por isso que comecei a falar com você... Sabe, o vento soprou meu chapéu para longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440104,
					"content": "Então... Espero que você não se importe de me ajudar a encontrá-lo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440108,
					"content": "Por que você mesmo não procura ele?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Se eu for procurar pelo meu chapéu, terei que soltar minha vara de pesca. Mas se eu segurar minha vara de pesca, eu não posso ir procurar pelo meu chapéu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Ruenti"
				},
				{
					"id": 752440109,
					"content": "Então... Por favor, estou te implorando por ajuda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruenti"
				}
			]
		},
