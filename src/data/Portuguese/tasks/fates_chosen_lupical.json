			},
			"dialogs": [
				{
					"id": 4540601,
					"content": "Por favor, calma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540602
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540602,
					"content": "Hunf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540603,
					"content": "É como ele acabou de dizer. Uma alcateia lá fora está vindo e violando as regras. Eles serão punidos por isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540604,
					"content": "Mas Razor - você não devia se envolver. É um assunto que lobos devem resolver entre si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540605,
					"content": "Você não luta com garras, mas com a espada. Você não ataca com dentes, mas com relâmpagos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540606,
					"content": "Você é um humano, Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540607,
					"content": "Não sou como eles! Eu não pertenço.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540608,
					"content": "Você não é um lobo, isso é um assunto para os lobos e somente os lobos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540609,
					"content": "E você, você é o Lupical de Razor entre os humanos. Sua nobreza se destaca contra outros de sua espécie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540610,
					"content": "Se você quiser, pode vir e treinar comigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540611,
					"content": "Não tenho mais nada a dizer. Que possamos nos encontrar novamente, Razor, e companhia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540612,
					"content": "Ei... Razor, que olhar é esse? Ei, por que você não vem para a cidade por alguns dias?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540613,
					"content": "Sim! Você tem uma amiga em Mondstadt, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540614,
					"content": "Sabe, aquela garota vermelha e flamejante e tal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540615,
					"content": "Você não está mais seguro dos viajantes na natureza. Mas eu sei que você não quer feri-los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540616,
					"content": "Estou bem. Não se preocupe. Mas não sou humano da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540617,
					"content": "Mas também não sou lobo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540618,
					"content": "Razor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#Obrigado {NICKNAME}, Paimon e... Outra garota vermelha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540622,
					"content": "Ei!? Já estamos juntos há tanto tempo, e você ainda não sabe meu nome!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540623,
					"content": "Até mais.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540619,
					"content": "Ânimo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
			]
		},
