			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "Estamos de volta! Temos o suficiente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Sim. Suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Razor estava me contando sobre o código de conduta dos lobos. Coisas surpreendentes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Obrigado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Nós procuramos por toda parte e não vimos nenhum outro lobo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4540307,
					"content": "Sim, lobos são assim. Aquele que conseguimos capturar deve ter sofrido danos cerebrais ou algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "O qu-O que você está fazendo aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4540309,
					"content": "Vingança.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "É ele! Aquele que foi criado pelos lobos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "Hã!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4540312,
					"content": "Então, foi você. Eu devia ter imaginado, lobos não são espertos o suficiente para estar por trás disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4540313,
					"content": "Eu não acredito que você ajudou os lobos a ficarem contra os humanos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4540314,
					"content": "Eles lhe jogam algumas migalhas e você os trata como parentes? Você já esqueceu o que você é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Hopkins, O Maravilhoso"
				},
				{
					"id": 4540315,
					"content": "Chega!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Sim! Você não pode falar com o Razor desse jeito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "Os Cavaleiros de Favonius vão deixar esse cara ir!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Nós. Não. Atacar. Vila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
