			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "Esse é ele. Encontramos o sangue dele. Homens maus fizeram isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541302,
					"content": "Que terrível...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541303,
					"content": "Concordo que isso é horrível, mas isso não muda o fato de que-",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541304,
					"content": "Nós não atacamos a vila! Não nós!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541305,
					"content": "Um lobo negro e sua alcateia, não eram daqui. Eles estavam tentando conquistar à terra. Eles violaram as regras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>Código de quem?</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541307,
					"content": "O guardião desta terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541308,
					"content": "Agora é a segunda vez que você diz isso. Nos conte quem é esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541309,
					"content": "Eu levo Lupical mais adiante. Me siga, talvez você veja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
