					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "Gotas de sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541102,
					"content": "Não é sangue humano, é sangue de lobo... Sangue de Lupical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541103,
					"content": "Lupi o quê? Você vai nos dizer o significado disso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541104,
					"content": "Lupical é a família que o destino me deu. Quando um lobo aceita um humano ou quando um humano aceita um lobo. Isso é Lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541105,
					"content": "Isso parece besteirol para mim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541106,
					"content": "Isso é estranho, de onde vem a palavra? Certamente não foi inventada pelos lobos. Os lobos se comunicam por palavras?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541107,
					"content": "É apenas o nome que ele deu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541108,
					"content": "Quem é \"ele\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541109,
					"content": "O guardião desta terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541110,
					"content": "Não seria o Barbatos? Ele é o governante de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541111,
					"content": "Chega sobre isso. Outra pista. Me siga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541112,
					"content": "Ei, espere! Estou lhe dando uma oportunidade de se explicar e provar sua inocência.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541113,
					"content": "O Razor já se foi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
