			},
			"dialogs": [
				{
					"id": 4541501,
					"content": "Onde estamos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME} me ajude. Colete estes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541503,
					"content": "Essas não são sementes dos Ganchos do Lobo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541504,
					"content": "Esmague-os. Coloque na ferida. Sangramento para.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541505,
					"content": "Certo! As sementes dos Ganchos do Lobo têm um tipo de líquido que não só funciona como um analgésico suave, mas também tem um efeito hemostático...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541506,
					"content": "... Eu li isso em um livro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541507,
					"content": "Por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541508,
					"content": "... Não faço ideia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541509,
					"content": "Ganchos ajudam as sementes a moverem. O líquido para a dor e sangramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541510,
					"content": "Os animais não sentem os ganchos e levam as sementes para longe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541511,
					"content": "... A Professora Violeta me disse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541512,
					"content": "Eu fico aqui, cuido dele. Eu respondo perguntas da garota vermelha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541513,
					"content": "Certo. E se aquele grupo de pessoas voltar, duvido que eles irão testar sua sorte contra uma membro dos Cavaleiros Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541514,
					"content": "#O seu amigo lobo não está livre de suspeitas ainda. Mas {NICKNAME}, nós ainda precisamos que você busque essas sementes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
