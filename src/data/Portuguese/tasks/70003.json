				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "*Suspiro* O que eu vou fazer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030102,
					"content": "Posso ajudar com alguma coisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "Assim que chega o Festival da Brisa Florescente, todo o mundo vem aqui para fazer sacrifícios à Estátua do Arconte com vários tipos de flores. Quando o vento sopra, as pétalas são lançadas pela cidade inteira...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030104,
					"content": "Colocamos muitos esforços em remover essas flores e folhas murchas, mas apenas conseguimos remover as do palácio. Quanto às pétalas e folhas nos muros e nos telhados, estão realmente além do meu alcance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030105,
					"content": "Em especial, com esses meus joelhos que estão ficando cada vez piores...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030106,
					"content": "Eu posso ajudar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "Você pode ajudar? Que bom! Tem uma pilha de pétalas murchas. Basta subir ao telhado, e você verá tudo com facilidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
			]
		},
