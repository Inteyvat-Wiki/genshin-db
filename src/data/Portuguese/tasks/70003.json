				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "É um gato mesmo! Por que será que veio até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030502,
					"content": "Miau... Miau...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "Gatinho Perdido"
				},
				{
					"id": 700030503,
					"content": "Miau, miau, miau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "Gatinho Perdido"
				},
				{
					"id": 700030506,
					"content": "Uh... Acho que ele não entende o que você fala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030507,
					"content": "Melhor levarmos ele conosco. Talvez Aramis saiba quem é o dono dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700030504,
					"content": "Você está perdido?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
