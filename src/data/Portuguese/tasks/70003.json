			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aramis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "Me desculpe, mas não vi. Se tivesse visto, acho que saberia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030602,
					"content": "Mesmo? Aquela criança gosta muito de pétalas. Creio que se elas saíssem voando, ele as seguiria até aqui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030603,
					"content": "Vocês estão procurando pelo gato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "Miau... Miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "Gatinho Perdido"
				},
				{
					"id": 700030605,
					"content": "Esse som... É a Borboletinha? É mesmo! Para onde você foi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030606,
					"content": "Ela foi para cima do telhado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "Foi exatamente igual como eu pensava, muito obrigada! A Borboletinha gosta de correr atrás das pétalas, mas em uma cidade repleta de pétalas durante o Festival da Brisa Florescente, é realmente uma dor de cabeça. Graças a Deus, vocês ajudaram muito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030608,
					"content": "Da próxima vez que vier à Cauda do Gato, vou te pagar um copo! E claro, é sem álcool!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030609,
					"content": "Ah, isso de novo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "Haha, muito obrigada! Tenho que ir indo agora. Feliz Festival da Brisa Florescente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 700030612,
					"content": "Não esperava que o gato fosse atraído pelas pétalas... Realmente, o Festival da Brisa Florescente é muito animado... Ainda bem que foi você que o encontrou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030613,
					"content": "Se eu subisse no muro para pegar meu gato, meus joelhos não aguentariam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030614,
					"content": "Muito obrigado pela sua ajuda. Aceite isto como recompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				},
				{
					"id": 700030610,
					"content": "Vamos deixar isso para outra hora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}