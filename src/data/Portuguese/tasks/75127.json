				"points": []
			},
			"dialogs": [
				{
					"id": 751270101,
					"content": "Oh, você veio para deixar uma memória também? Viajantes do exterior já vieram antes, desejando deixar suas memórias por aqui. Afinal de contas, aquela ilha flutuante é uma bela vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270102,
					"content": "Uma pena que eu não tinha um Aparelho Fotográfico antes — eu tive que pedir a um comerciante forasteiro para me trazer um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270103,
					"content": "#Que tal, Viajante? Quer tirar uma foto? Mas você terá que fazer isso você mesm{M#o}{F#a}, pois minhas mãos são bem trêmulas para fotografias...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270104,
					"content": "Estranho, a névoa sobre o mar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "A névoa sobre o mar? Do que você está falando, Viajante? Não é possível haver névoa com a brisa tão forte do mar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270106,
					"content": "Nunca vi uma névoa sobre o mar desde que nasci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270107,
					"content": "Talvez você tenha confundido esse lugar com as áreas cobertas de neblina que a Cordilheira Tezcatepetonco cobre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270108,
					"content": "Talvez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "#Heehee, se você quer saber, acho que você só está muito nervos{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakau"
				},
				{
					"id": 751270110,
					"content": "Você deveria relaxar — você está viajando por Natlan, afinal de contas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakau"
				}
			]
		}
