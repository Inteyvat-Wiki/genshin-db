				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Damselette"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "...Hmm, meio tom acima, talvez. Vamos tentar de novo, certo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490102,
					"content": "Oi, Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Espera, você está... ensinando o Kuuhenki a tocar a lira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Sim. Eles ficaram tão felizes por tê-la consertada que praticamente não saíram do meu lado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490105,
					"content": "Mas tocar lira nunca foi meu forte. Estou mais acostumada a ouvir os outros tocarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490106,
					"content": "Ahhh, verdade! Se você tivesse uma banda, com certeza ficaria encarregada dos vocais, né...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Mas quando se trata de instrumentos... {M#o}{F#a} Viajante é praticamente um prodígio! Da lira ao Tambor Djem Djem, ess{M#e}{F#a} aqui toca de tudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "#Eu não sou nada de especial, pra ser sincer{M#o}{F#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Ah, é mesmo? Nesse caso... talvez você pudesse ensiná-los no meu lugar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490111,
					"content": "Tudo bem então, por que não?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Eu estava fazendo eles praticarem a canção que costumo cantar. Talvez você se lembre de como ela é...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490114,
					"content": "Ou... Uma melodia diferente também serve. Raramente os Kuuhenki têm a chance de ouvir músicas de outros lugares. Eu também ficaria bastante interessada em ouvir algo assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490115,
					"content": "(Hmm, o que devo tocar...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Vamos tentar aquela que Columbina está sempre cantando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Mas que tom devo escolher...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Vamos tentar algo calmo e suave...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Isso foi adorável. Então você realmente memorizou a minha canção.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490605,
					"content": "Hehe, só porque você é uma ótima cantora! Sempre que ouvimos sua voz, às vezes até paramos só para escutar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hm, os Kuuhenki também pareceram bastante encantados com sua apresentação. Talvez eles tenham aprendido algumas coisas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490607,
					"content": "Talvez eu precise da sua ajuda educacional novamente no futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490608,
					"content": "Venha, me dê sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490609,
					"content": "Hã? Não, não, essa foi uma apresentação gratuita. Não é necessário pagar nenhuma mensalidade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hmm? Mensalidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490611,
					"content": "Eu só pensei... que o suave brilho do luar seria um acompanhamento perfeito para uma melodia tão bela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490701,
					"content": "Vamos dar uma animada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Ah, já acabou? Eu poderia ouvir isso para sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490703,
					"content": "Como já lhe disse uma vez, essa é a única canção de ninar que consigo lembrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490704,
					"content": "Embora eu ainda não tenha compreendido o significado por trás dela, depois de ouvir você tocar, sinto que, seja qual for a resposta que me aguarda lá em cima, na lua... ao menos, deve ser uma resposta bela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490705,
					"content": "Aqui, me dê sua mão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490706,
					"content": "Está tudo bem. Sério, você não precisa nos dar nada em troca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, essa não era minha intenção... Eu só queria enfeitar sua melodia com um raio de suave luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490801,
					"content": "Vamos tentar algo de outra nação...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Que curioso... Já ouvi melodias como essa antes, mas a sua maneira de tocar lhes dá uma dimensão totalmente nova...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490803,
					"content": "#Ah, talvez seja porque {M#o}{F#a} Viajante estava canalizando seu vínculo emocional com aquele lugar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "Curioso... É como se eu conseguisse imaginar a paisagem só de ouvir a melodia. Fico pensando em como será a comparação entre a realidade e a minha imaginação...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490805,
					"content": "Você devia ir ver com seus próprios olhos algum dia! Nós podemos ser seus guias!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Mm... Talvez. Se esse dia chegar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Damselette"
				},
				{
					"id": 760490112,
					"content": "Mas o que eu devo tocar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Embora já tenha arriscado um pouco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
