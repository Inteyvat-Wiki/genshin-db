					"Malta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#Moço}{F#Moça}, você viu aqueles Caranguejos de Pedra? Acho que eles tão fazendo algum tipo de ritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Acho que é só como eles são.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Sério? Ah... Acho que entendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "Tem muita gente na Cidade de Nasha como aqueles Caranguejos de Pedra. Alguns andam de braços dados, enquanto outros se cumprimentam com socos e chutes antes de se separarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "Acho que é só o jeito das pessoas na Cidade de Nasha também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "Exatamente. Você pega as coisas rápido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#{M#Moço}{F#Moça}, você consegue fazer todos esses Caranguejos de Pedra entrarem no lago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Hmm... tipo chamar todos os caçadores de tesouro pro Navio-Chefe? Seria tão divertido de assistir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "#Eu quero muito ver o que acontece quando todos os Caranguejos de Pedra se juntam... Hmm, {M#moço}{F#moça}, você tá livre agora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Parece que tem uma diferença pequena, mas tanto faz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
