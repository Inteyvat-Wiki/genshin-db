			"dialogs": [
				{
					"id": 742530201,
					"content": "A vida é melhor quando tudo está pacífico e calmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "#(Vamos ficar sentad{M#o}{F#a}s assim por mais um pouco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530204,
					"content": "Já é essa hora? Haha. Deveríamos nos reunir com mais frequência, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "Acho que está na hora de eu começar a arrumar as coisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
