			"dialogs": [
				{
					"id": 742530101,
					"content": "Para ser sincera, ainda estou em choque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530102,
					"content": "Sabe, naquela época, tanto eu quanto Alain achávamos que você já tinha partido deste mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530103,
					"content": "Hmm... Se tivéssemos acordado mais cedo, talvez pudéssemos ter visitado você e Alain. Mas, suponho que isso seja o destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Srta. Mary-Ann...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "O destino age de maneiras misteriosas. Quem diria que Ann e eu encontraríamos um pôster de filme com o seu retrato durante nossas viagens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "Então foi isso que te fez pensar em entrar em contato comigo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530107,
					"content": "Exatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah... O aroma do café — me traz tantas lembranças... Hehe, obrigada por nos convidar para o seu chá da tarde, Srta. Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "O seu jardim é muito bem cuidado e cheio de elegância. Combina perfeitamente com uma dama tão refinada como você.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "Esta é a casa que Alain e eu compartilhamos. Acho que é meu dever mantê-la bonita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530111,
					"content": "Viu? Você já é muito melhor nisso do que meu irmão.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain nunca decorou o próprio quarto — ele não sabia lidar com coisas bonitas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "Isso mesmo, e René não era diferente. Jakob e eu éramos os únicos que sabiam decorar uma sala direito — e preparar uma festa do chá.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Então ele era assim desde pequeno? Eu sempre pensei que fosse por causa da idade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530115,
					"content": "Ele sempre foi assim. Pode ter sido inteligente nos estudos, mas era meio desajeitado em outros aspectos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "Talvez seja por isso que ele foi o único entre nós que escolheu a dolorosa realidade em vez da ilusão de um sonho doce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Não acho que ele tenha se arrependido dessa escolha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530118,
					"content": "Não, porque esse era o desejo dele como herói.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "O arrependimento é nosso. O desejo dele nunca deveria ter ficado sozinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "E você, Srta. Sandrone? Você tem algum desejo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Alain me fez essa mesma pergunta uma vez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530122,
					"content": "Hmm? Então ele fez a mesma pergunta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "Parece que meu irmão realmente cresceu muito. Ele nunca diria algo assim antes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "\"Desejo\" é uma palavra tão vazia. Você pode realmente ter tudo o que quer? Hah, se fosse assim, não haveria nada de ruim no mundo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530125,
					"content": "Estou fazendo o que quero fazer, o que acredito ser certo. Não sei se isso conta como um desejo, mas me faz feliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530126,
					"content": "Hmm, que coisa maravilhosa. Eu te invejo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Então você... guarda rancor de Alain? Por ele ter criado você... à imagem de Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Nunca. Ele sempre deixou claro que sou minha própria pessoa — única, distinta — que eu deveria escolher minha própria vida. Então foi exatamente isso que fiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530129,
					"content": "Haha, seja histórias ou comida, contanto que você esteja feliz com suas escolhas, então elas são as escolhas certas para você, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Exatamente. Então agora, vamos apenas aproveitar tranquilamente a comida que você preparou com tanto carinho para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
