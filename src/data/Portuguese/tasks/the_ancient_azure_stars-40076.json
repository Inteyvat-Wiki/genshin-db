			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Uau! Esperem, como...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "Outra casa de Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "Como que chegamos na minha casa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "Sua casa? Esta é a sua casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "Oh, que inesperado... Ouvi dizer que a Senhorita Megistus levava uma vida modesta, mas essa casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Olhem para as etiquetas desses livros no chão... \"Exemplar único, 990.000 Mora...\" Ei! Que preço absurdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "Há muitos livros de capa dura caros aqui... Então é assim que o quarto de uma astróloga se parece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "Os quartos são bem planejados... Esse lugar deve ser bem caro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Então Mona é rica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Ei! Eu às vezes não tenho Mora! Eu nunca disse que era pobre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "Você não é?! E as vezes que eu paguei suas refeições?! Eu até levei você para minha casa para jantar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Princesa, o decoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "Ahem! Tiveste o privilégio de adentrar no palácio do Reino da Noite Eterna e conhecer o Rei e Rainha do Pecado, ou tu deliberadamente esqueceste desta magnífica ocasião?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "Oh sim, o ensopado e as carnes frias que sua mãe fez estavam deliciosos! Hmm, até que cairiam bem de novo agora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Senhorita Megistus, agora não é o momento disso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "Isso é culinária de Mondstadt? Eu quero provar! Ouvi dizer que Mondstadt possui muitos pratos únicos, especialmente de carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Hmm, então eu conceder-te-ei a honra de conhecer o Rei e Rainha do Pecado em uma ocasião posterior.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#Sério? Ei {NICKNAME}, vamos também!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Agora que vocês falaram, já faz um tempo que não visito a casa de algum amigo. Seria um prazer ir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Hmm, mas será que não deveríamos levar algum presente de lembrança?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Esses dois são gentis e compreensivos, por favor, não se preocupem. Sua presença é mais que suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "Vocês têm que provar o prato de carnes frias da mãe dela! É a sua especialidade ou algo assim. Enfim, é delicioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Não quero interromper, mas talvez devêssemos começar a trabalhar no quebra-cabeça? Desde que entramos, me sinto preocupado com aquele ornamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "Oh, tem razão!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "#Fui enganad{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Voltamos para cá. Então saímos da miragem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "Que estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "Minha miragem não tinha pistas sobre os Fatui, ou sobre a máquina... Isso quer dizer que eles não têm nada a ver com as miragens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "Ou será que essas miragens são uma consequência, e não parte de um processo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Hã, Paimon não entende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "Eu quero dizer que essas miragens não eram pistas para resolver um mistério, mas sim um efeito direto do que quer que seja que está acontecendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Alguém fez algo para criar essas miragens. Como elas foram consequências passivas, é natural que não podiam nos fornecer nenhuma informação útil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "Noutras palavras, estas miragens foram somente sobre nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "São materializações de nós mesmos... Hmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Talvez devêssemos voltar aonde isso tudo começou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#Em nosso primeiro dia na ilha, eu e {NICKNAME} investigamos o acampamento juntos. Encontramos uma máquina estranha lá, bem como alguns Fatui desorientados.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "Sim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "O pesquisador com quem conversamos afirmou que a máquina era apenas uma invenção industrial Fatui, ele até mesmo prometeu que não nos incomodaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "Sim, sim, e o cara do quepe parecia estar sonolento o tempo inteiro. Ele falava coisas sem sentido sem parar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "Me pergunto se seria possível que a \"loucura\" e as \"miragens\" são resultados diferentes da influência da máquina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "Se sim, tudo leva de volta até essa máquina danificada, exceto na distinção de como afeta as pessoas. Isso, creio eu, é causado pelas diferenças entre as pessoas afetadas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "Quando você fala desse jeito... De fato é bem difícil distinguir entre sonhos e alucinações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "O que você quer dizer é que a máquina nos afetou de forma diferente porque somos diferentes dos Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Sim, e de acordo com nossas observações nesses últimos dias, eu creio que a diferença é que possuímos uma determinação mais forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "... Bem, isso faz sentido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "Pessoas com determinação forte alucinarão ao invés de enlouquecerem, mas aqueles que quebram facilmente não conseguem manter uma miragem forte o suficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "Em outras palavras, devemos retornar imediatamente ao acampamento dos Fatui e destruir essa máquina o mais rápido possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "Não. Ela deve ser reparada, ao invés de destruída.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "O que minha Princesa quer dizer é que destruir uma máquina que não compreendemos pode causar consequências graves. Primeiro seria melhor repará-la.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Sim, é melhor ser cauteloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "Se meu palpite estiver correto, essa máquina é capaz de influenciar o cérebro humano. Por isso devemos ter muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "Então vamos logo! Não há tempo a perder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "Que vista espetacular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "Senhorita Megistus, creio esta ser a maior prova de sua genialidade. Você de fato é a maior arquifeiticeira na história do Reino da Noite Eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Obrigada, mas o Reino da Noite Eterna não tem tanta história...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "...As estrelas são como diamantes e a lua é como uma pérola. Este é o céu noturno mais brilhante que já vi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "Muito lindo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "Ter uma miragem como esta significa que Mona deve ter um vasto mar de estrelas em seu coração.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, o que foi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "... Estou pensando que essas devem ser as nossas aspirações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "Esse céu estrelado é lindo. Na verdade, eu diria que é ainda mais lindo que o que vejo em minhas adivinhações.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "Todas as estrelas estão no seu devido lugar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "... Essa é definitivamente a minha miragem. Somente aqui eu poderia ver uma paisagem extraordinária como essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "Extraordinária? Por que você diz isso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "Sabem, o céu estrelado de Teyvat é maravilhoso. Todas as respostas no mundo parecem estar escondidas nele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "\"Quando meu filho desaparecido retornará?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "\"Será que essa pessoa realmente me ama?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "\"Me recuperarei?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "À medida que suas estrelas se movem no céu, elas registram todos os acontecimentos de sua vida em seu trajeto. E entre todas as pessoas do mundo, um número considerável verá suas estrelas desviarem de seu caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "Quando as suas estrelas mantêm sua trajetória, isso significa que você terá uma vida saudável, feliz e tranquila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Por outro lado, se as suas estrelas saírem do trajeto, tudo piorará.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "O céu estrelado em minhas adivinhações nunca seria perfeito como esse. Algumas estrelas perderiam seu caminho, outras cairiam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "... Eu gostaria que todos fossem felizes, e que ficassem em seu caminho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "E para isso, eu ofereço conselhos e digo a verdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "Eu sei que é inútil. Todos os destinos já estão revelados no céu noturno estrelado, e o meu também é apenas mais um entre eles. Não posso mudar nada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Ainda assim... Fora da astrologia, fora do mundo da verdade, eu ainda me apego a um fio de uma fantasia irracional.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "Todos nós vivemos nos limites da realidade, mas... Vocês podem achar que é presunção minha, mas ainda acredito em milagres.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "Neste vasto mar de estrelas, há estrelas para você, para mim, e para todos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "Quais são as chances de uma estrela encontrar outra? Por acaso esses encontros não são milagres fantásticos em todo o destino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "Mas em Teyvat, as estrelas no céu sempre terão um lugar para nós. Ainda que a astrologia seja racional, que o destino seja arbitrário e cruel, é romântico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, parece que você já pensou muito sobre isso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "Você já encontrou a resposta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "...Penso que sei o que está escondido nessas estrelas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "\"Agora, pegarei as rédeas de meu próprio destino.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
