			"dialogs": [
				{
					"id": 221040101,
					"content": "Isso está ficando tão estressante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040102,
					"content": "Qual o problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "Oh, desculpa! Quando você chegou aqui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040104,
					"content": "A presença de monstros nesta área está crescendo constantemente, e embora meu marido insista que eles não ousariam pôr os pés no albergue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040105,
					"content": "Mas ele é o único que está preparado o suficiente para atacar de volta... Isso me inquieta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040106,
					"content": "Se você estiver disposta, pode por favor ir ver no albergue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "#Muito obrigada. Você é muito simpátic{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040113,
					"content": "Sou grato por sua ajuda. Você será adequadamente recompensado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040108,
					"content": "Este albergue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "Hã? Não há nada fora do comum na pousada. Está apenas com um pouco mais de tráfego do que o usual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040111,
					"content": "Mas vale a pena. Os viajantes que enfrentam o deserto precisam de um lugar para ter uma boa noite de sono e comer uma refeição adequada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221040112,
					"content": "É o que eu e o meu marido pensamos, é simplesmente assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
