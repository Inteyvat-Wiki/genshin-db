			"dialogs": [
				{
					"id": 750444701,
					"content": "(Escrita infantil e descuidada visível:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Anotações de uma Criança"
				},
				{
					"id": 750444702,
					"content": "Esse jogo é chamado de \"Bing Bong Ding Dong\" e aqui estão as regras:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Anotações de uma Criança"
				},
				{
					"id": 750444703,
					"content": "1. Quando o Monetoo Bing Bong não estiver fazendo ding dong, monte nas costas da estátua do Sauriano para movê-la para frente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Anotações de uma Criança"
				},
				{
					"id": 750444704,
					"content": "2. Saia da estátua do Sauriano quando o Monetoo Bing Bong contar até um \"ding!\" ou você vai perder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Anotações de uma Criança"
				},
				{
					"id": 750444705,
					"content": "3. O primeiro a correr até o Monetoo Bing Bong vence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Anotações de uma Criança"
				},
				{
					"id": 750444706,
					"content": "E não venha com isso de \"isso não é só Batatinha Frita 1, 2 ,3?\". Regras são importantes e é exatamente por você não respeitar as regras que você não pode vencer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anotações de uma Criança"
				}
			]
		}
	]
