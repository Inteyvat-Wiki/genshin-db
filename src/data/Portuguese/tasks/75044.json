			"dialogs": [
				{
					"id": 750443601,
					"content": "(Um romance escrito por Dorothy Leeckson. Em sua capa desbotada, uma mulher está deitada em uma cama rodeada por flores.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"Flor de Lavanda\""
				},
				{
					"id": 750443602,
					"content": "(Após dar uma olhada rápida no livro, você se sente aconchegado e contente, mas não obteve nenhuma revelação útil.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"Flor de Lavanda\""
				},
				{
					"id": 750443603,
					"content": "Então... Foi o jardineiro da família dela ou o cunhado do primo do melhor amigo dela?... Ugh, a cabeça de Paimon tá doendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
