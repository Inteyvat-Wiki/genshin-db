					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "\"...Compatriotas, família, irmãos e irmãs que se dedicaram ao triunfo inexorável da aliança...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "\"...O mais benevolente... alocou um lote de novos mecanismos de (...) para oferecer suporte a transporte, (...) e <color=#00E1FFFF>recuperação submarina</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "\"...Avante! Avante! Avance a qualquer custo... Pelo glorioso futuro da aliança, por nossa liberdade e glória, por uma terra livre da opressão do dragão maligno...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "\"...Sem permissão... é proibido operar a <color=#00E1FFFF>alavanca de controle</color>... Quedas acidentais... já causaram as mortes de três trabalhadores...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "\"...Há uma pequena trilha atrás de uma Parede de Pedra ao norte que leva ao topo da cachoeira. Ela pode ser usada como uma <color=#00E1FFFF>área de armazenamento</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "\"...Deixei poucas marcas, só em caso de esquecer o caminho mais tarde...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "\"...Os ferimentos de Sayani pioraram. É culpa da umidade... Eu disse para ela descansar, mas ela só riu... dizendo que acabaria atrasando o pelotão, resultando em todos perdendo provisões extra...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "\"...Assim que anoitecer, vou escondido até ela com uma tocha para cauterizar a ferida dela enquanto outros não estão olhando, ou os membros dela vão apodrecer também...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
