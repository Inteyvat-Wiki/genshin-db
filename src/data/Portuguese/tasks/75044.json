				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(A biografia de Frank Drebin, Inspetor aposentado da força especial de polícia de Fontaine, o Marechalato Fantasma. Sim, o Inspetor é um gato branco cheio de energia.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "\"Detetive Patinha de Neve\""
				},
				{
					"id": 750443702,
					"content": "(Uma grande pegada de gato está impressa na página de título deste livro, talvez uma lembrança especial que o Inspetor deixou para seus subordinados.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "\"Detetive Patinha de Neve\""
				},
				{
					"id": 750443703,
					"content": "Sério... É melhor escrever um livro sobre Paimon também chamado... A Detetive de Cabelo Branco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
