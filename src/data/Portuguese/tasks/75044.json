					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "\"...Que a glória seja eterna... Pacificador... Mais benevolente... Och-kan...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "...Artesãos Mahutzintl, Tlanalco e... aqueles responsáveis pela construção da bomba d'água... deliberadamente negligenciada, causando atrasos... O benevolente... não impôs punição... apenas suspendeu provisões por três semanas...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
