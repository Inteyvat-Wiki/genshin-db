				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Choiseul"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361301,
					"content": "Ufa... Está tudo bem. Está tudo bem. O pesadelo acabou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361302,
						741361305,
						741361309
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361302,
					"content": "Como você se sente com Edwin voltando a vida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361303
					]
				},
				{
					"id": 741361303,
					"content": "AAH! Você me assustou! O que eu sinto? Nada, pra falar a verdade. Só espero que aquele maldito irresponsável pague pelo que fez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361304
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361304,
					"content": "Pessoalmente, eu amarraria suas mãos e pernas, colocaria uma venda nele e impediria que ele pegasse o Arkhium!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361305,
					"content": "Você se mais aliviado agora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361306
					]
				},
				{
					"id": 741361306,
					"content": "Se comparado com antes, um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361307
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361307,
					"content": "Mas, pra falar a verdade, trancar Nacker e Edwin juntos? Pelos Arcontes! Não consigo imaginar o que eles vão tramar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361308
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361308,
					"content": "Eles já fizeram uma explosão, o que vem agora? Inundar Fontaine com Fonta? Nem consigo imaginar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361309,
					"content": "Espero que você tenha um bom dia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361310
					]
				},
				{
					"id": 741361310,
					"content": "#Você também, Pesquisador{F#a} Sênior Honorári{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				}
			]
		},
		{
			"id": 7413614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7413611",
							"3"
						],
						"stepId": 7413611,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fusilier",
					"Lemarcq",
					"Chaussivert",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361401,
					"content": "... Nenhum valor... minha pesquisa não tem nenhum valor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361402
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361402,
					"content": "Srta., por favor, não pense desse jeito. Sua invenção salvou minha vida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361403
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741361403,
					"content": "Mas... mas... Sr. Edwin... *Choro* Edwin disse que isso aqui é inútil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361404
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361404,
					"content": "Isso só significa que Edwin é cego! Essa coisa é um tesouro! Sem valor? Ha! Eu daria um braço para ter um para cada um de meus homens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361405
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361405,
					"content": "Edwin é uma pessoa ruim. Ele está mentindo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361406
					]
				},
				{
					"id": 741361406,
					"content": "O Sr. Edwin não é uma pessoa ruim! Ele... Ele... Enfim... Ele nem se lembra do meu nome! Eu até mostrei meus designs várias vezes...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361407
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361407,
					"content": "Srta. Fusilier, você é muito talentosa! Por que você deixa Edwin julgar seu valor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361408,
					"content": "Ele não vê o que eu vejo em você!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361409
					]
				},
				{
					"id": 741361409,
					"content": "S-Sério?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361410
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361410,
					"content": "É claro. Todos pensamos assim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361411
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361411,
					"content": "Mas... você não sabe nada sobre pesquisas... *Snif*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361412
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361412,
					"content": "Srta. Fusilier... Ela não está mais coerente. Acho que é melhor deixar ela em paz um pouco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361413,
					"content": "Ok... Lemarcq e eu estaremos bem aqui. Chame se precisar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				}
			]
		}
	]
}