			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raimondo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "#Alguma pergunta? Pesquisador{F#a} Sênior Honorári{M#o}{F#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361202,
					"content": "O que vai acontecer com Nacker e Edwin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "Eles ficarão temporariamente na Fortaleza Meropide, onde se arrependerão de sua má conduta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361204,
					"content": "Dito isso, o Edwin que conheço não \"se arrepende\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361205,
					"content": "De todo jeito, contanto que Edwin seja mantido longe de equipamentos de pesquisa e Arkhium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361206,
					"content": "Quanto a Nacker... Eu não acredito que ele causará mais problemas para nós.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361207,
					"content": "Eu... Eu só posso esperar não encontrar situações que necessitem da especialidade deles...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361208,
					"content": "Fusilier costumava idolatrar Edwin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "...Edwin Eastinghouse é um gênio. As pessoas no mesmo campo ou desistiram, ou se tornaram seguidores deles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361210,
					"content": "A Srta. Fusilier é uma pesquisadora muito criativa e entusiasmada, geralmente alcançando ótimos resultados com recursos mínimos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361211,
					"content": "Após se juntar à terceira equipe do Projeto de Pesquisa de Arkhium, ela foi encarregada do projeto estrutural do supressor e tinha contato frequente com Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361212,
					"content": "Talvez foi aí que ela começou a idolatrar Edwin. Assim como os outros seguidores, a aprovação de Edwin se tornou seu único objetivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361213,
					"content": "Após a explosão, ela se recusou a acreditar que Edwin a causou, então ela se inscreveu para se unir à investigação em uma tentativa de limpar o nome de Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361214,
					"content": "Agora que vocês lidaram com Edwin, o que acham dele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361215,
					"content": "Uma aberração da natureza que se importa apenas com sua pesquisa! Ele sempre tenta culpar os outros e nem consegue lembrar do nome da Srta. Fusilier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361216,
					"content": "Isso parece mesmo com ele. Fora sua pesquisa, raramente há outra coisa digna de um segundo da atenção dele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361217,
					"content": "E ele não se importa com mais nada contanto que sua pesquisa progrida sem problemas. Nem sequer quando seus subordinados roubam ativos do Instituto para vender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361218,
					"content": "Eu só aprovei a solicitação de Fusilier para se unir à investigação... para que ela percebesse que estava perseguindo uma imagem dele que ela fabricou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361219,
					"content": "Agora que aquela imagem foi finalmente despedaçada, eu só posso esperar que ela se recomponha logo... O Instituto de Pesquisas de Fontaine não pode mais perder pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361220,
					"content": "Tchau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "#Adeus, Pesquisador{F#a} Sênior Honorári{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				}
			]
		},
		{
			"id": 7413613,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7413611",
							"3"
						],
						"stepId": 7413611,
						"stateName": "QUEST_STATE_FINISHED"
