					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "Espero que todos estejam em segurança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200102,
					"content": "Você está preocupado com o quê?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "É o Viajante. Você deve ter reparado nos meteoritos que caíram do céu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200104,
					"content": "Felizmente os meteoritos não caíram para dentro de Mondstadt, mas fora da cidade está um caos. Ainda estou preocupada com aqueles que estão na fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200105,
					"content": "Viajante, você pode alertar as pessoas que ficaram do lado de fora da cidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200106,
					"content": "Se eles quiserem, então que venham até Mondstadt para se abrigarem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200107,
					"content": "Entendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "Muito obrigada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200112,
					"content": "Você pode ir procurar Lynn, perguntar se ela sabe se há pessoas que ficaram lá fora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200113,
					"content": "Depois, tente convencer ela a se abrigar em Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200114,
					"content": "Agora não é hora dela continuar seu desafio de sobreviver na natureza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200109,
					"content": "Por que não caíram meteoritos em Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "Talvez seja apenas sorte. Independente disso, Mondstadt é o lugar mais seguro no momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200111,
					"content": "Você quer dizer pelo menos mais seguro que aí por fora, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112002,
