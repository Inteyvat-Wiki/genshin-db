			"dialogs": [
				{
					"id": 411200801,
					"content": "Ah! Você... Não é um monstro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200802,
					"content": "Por favor, entre em Mondstadt para se refugiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "Eu... Eu sei! Eu também vim notificar outras pessoas para que elas procurem um abrigo, mas tomei mais um tempo no caminho, só isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200804,
					"content": "Você está escondendo alguma coisa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "Eu... Eu estava aqui descansando, não é permitido? Chega de conversa, volte logo para Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200806,
					"content": "Meteoritos e monstros, e ainda assim tem pessoas fora da cidade... Com certeza tem algo de errado na cabeça delas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200807,
					"content": "Ainda tem mais alguma pessoa que ficou do lado de fora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "Originalmente eu estava procurando a Freira Vind, para dizer a ela para entrar em Mondstadt... É a freira que está sempre perto do Canto do Precursor do Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200809,
					"content": "Mas eu procurei em todo o Canto do Precursor do Vento e não a achei, depois corri para outros lugares, na esperança de encontrá-la...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200810,
					"content": "Mas a minha sorte não foi boa, pelo contrário, me deparei com um grupo de monstros, e com grande dificuldade os matei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200811,
					"content": "Eu andei em círculos, voltei ao Canto do Precursor do Vento, mas ainda assim não a Freira Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200812,
					"content": "Espero que ela esteja aqui em Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "Schuster Assustado"
				},
				{
					"id": 411200813,
					"content": "Está bem, vou voltar para Mondstadt, você volte logo também, agora não é hora de ficar rondando por aí.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schuster Assustado"
				}
			]
		},
