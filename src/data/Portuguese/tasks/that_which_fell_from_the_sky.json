			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "Essas condições fazem sobreviver no ambiente selvagem bem desafiador...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Por favor venha se abrigar em Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "Me refugiar? Não precisa se preocupar comigo, eu estou prestando atenção aos arredores, não há perigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "Mas, como é que você ainda está andando por aí do lado de fora da cidade? Volte para Mondstadt o mais rápido possível, se for atingido por um meteorito será horrível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Quanto as pessoas que ficaram nos arredores da cidade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "As pessoas que ficaram nos arredores da cidade? Devem ser muitas, você quer fazer algo a respeito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "Permitir que elas busquem refúgio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Dito isso, a Guilda dos Aventureiros publicou as missões, eu fui aos arredores da cidade notificar muitas pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "As pessoas que estão próximas à Mondstadt já devem ter se refugiado na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "Não temos muita gente agora, e também não conseguimos convocar mais aventureiros. Muito aventureiros na natureza ainda não foram informados, portanto, é muito bom que você veio nos ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Deixe-me pensar sobre as pessoas que ficaram fora da cidade...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "Ah! Sim. A Patchi e o Doolan têm ficado ao lado do Templo do Vento Milenar... Eu já lhe disse, mesmo assim, eles insistiram ficar lá, fazendo as suas pesquisas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "Ainda tem a Freira Vind, ela estava nos arredores do Canto do Precursor do Vento, a Guilda dos Aventureiros deixou eu ir procurar ela várias vezes, mas não a encontrei em nenhuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "É tudo o que eu consigo recordar. Então, você primeiro vai para cidade de Mondstadt e lhes informar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "Eu vou preparar mais um pouco de comida e outras coisas, e logo depois já vou dar mais uma volta aqui perto para informar mais gente possível.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Espero que eles não tenham fugido para muito longe... Senão, vai ser muito difícil de encontrá-lo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "A Freira Grace está muito preocupada com eles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "Freira Grace? Ah sim, ela... Na verdade, a Guilda dos Aventureiros publicou as missões, eu fui aos arredores da cidade notificar várias pessoas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "As pessoas que estão próximas à Mondstadt já devem ter se refugiado na cidade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "Não temos muita gente agora, e também não conseguimos convocar mais aventureiros. Muito aventureiros na natureza ainda não foram informados, portanto, é muito bom que você veio nos ajudar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
		{
