			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "Agora não é a hora de ficar estudando, devemos procurar abrigo imediatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "Eu já disse várias vezes, não posso abrir mão desta chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 411200303,
					"content": "Por favor, entre em Mondstadt para se refugiar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "Agora não é a hora de se abrigar, esses meteoritos são nossa chance de entrar no Templo do Vento Milenar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 411200305,
					"content": "Entrar no Templo do Vento Milenar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Patchi disse que talvez um meteorito caia sobre o Templo do Vento Milenar, se embaixo dele há um pavilhão... Ou alguma outra coisa, nós podemos seguir pelo caminho que o meteorito abriu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "Você está louco? Se um meteorito cair depois que entrarmos lá, não conseguiremos sair.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "Vamos procurar um abrigo, se um meteorito realmente atingir o Templo do Vento Milenar, de todo jeito criará um caminho que nós poderemos explorar depois, não é a mesma coisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "E se outras pessoas fizerem isso antes, o que acontecerá? Se você quer voltar, volte, eu vou esperar aqui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "Patchi, a Curiosa"
				},
				{
					"id": 411200310,
					"content": "Está bem, Viajante, me desculpe, nós vamos ficar aqui mais um pouco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "Não se preocupe, se realmente for perigoso eu... Eu vou cuidar disso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Antes tinha uma pessoa chamada Schuster por aqui, ele era muito medroso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "Depois de me procurar para pedir um gole d'água, ele disse que iria para Mondstadt, e partiu correndo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "Mas ele não correu na direção de Mondstadt, mas para o Canto do Precursor do Vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Eu não acredito que ele tenha confundido os caminhos de tanto medo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "Viajante, vá para Canto do Precursor do Vento procurar ele, será horrível se ele se deparar com um monstro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "Eu vou ficar aqui com Patchi, se algo acontecer... Eu posso dar conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
		{
