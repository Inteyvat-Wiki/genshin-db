				},
				{
					"id": 411200402,
					"content": "Para onde você está indo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Me desculpe, eu estive andando por aqui observando o mar, mas está um pouco difícil de achar... Você me procurou por quê?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Por favor, vá se refugiar em Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "Refugiar? Oh, você fala dos meteoritos, eu sei, mas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200406,
					"content": "Cuidado! Monstros estão vindo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
