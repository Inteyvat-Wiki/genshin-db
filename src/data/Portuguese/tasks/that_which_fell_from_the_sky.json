			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "Você voltou, conseguiu o avisar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200702,
					"content": "Sim, mas ele disse que não quer retornar no momento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "Não quer? O que é tão importante que ele tem que ficar do lado de fora da cidade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200704,
					"content": "Realmente, é uma pessoa livre de Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "Hahaha, realmente, eles são pessoas livres de Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200706,
					"content": "Mas desta vez, eu espero que eles restrinjam essa liberdade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200707,
					"content": "*Suspiro* Os Cavaleiros provavelmente também estão de mãos cheias. Está tudo bem - vou pensar em outra maneira de convencer essas pessoas. Obrigada, Viajante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200708,
					"content": "Espero que todas as pessoas estejam em segurança...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
