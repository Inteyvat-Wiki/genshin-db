			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "Obrigada, agora há pouco realmente foi muito perigoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200602,
					"content": "Então, por favor, vá para Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "Me desculpe, mas não posso voltar agora. Esses meteoritos, isso é muito estranho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200604,
					"content": "Quando esses fenômenos acontecem, não é comum que surja uma tempestade no mar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200605,
					"content": "Eu preciso ficar aqui observando, se houver uma tempestade, a primeira coisa que farei é retornar para a cidade para notificar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200606,
					"content": "Obrigada por me dizer, vou tomar muito cuidado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
