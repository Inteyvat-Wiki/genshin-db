			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "Parece que... é para Acat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110202,
					"content": "A embalagem está quebrada. Se mandarmos de volta do jeito que está, o item inteiro pode ser arruinado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110203,
					"content": "Eu ainda tenho que organizar os pacotes na loja, então poderia me ajudar a enviar isso para ela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110204,
					"content": "Ela deve ser a dona da Paleta da Frida. Não se preocupe, você não perderia a placa da loja dela, mesmo que tentasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
							"2"
						],
						"stepId": 7511103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Isso parece com... a escrita de Chanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "Se eu tivesse que adivinhar, deve ser outra nota fiscal de pedido. A embalagem está quebrada aqui - não há como entregarmos assim. Esta carta terá que ser devolvida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "Eu ainda preciso organizar os pacotes na loja, então poderia me ajudar mandar isso de volta para Chanca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "Ela deve estar na Pousada Cansada perto do Estádio da Chama Sagrada, é muito fácil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
