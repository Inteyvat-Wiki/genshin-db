			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "Empório de Gemas Muhuru... Imix? Argh, esta é uma nota fiscal que ela enviou, não é?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110402,
					"content": "Se isso ficar preso no trânsito, aquela criança vai levar um sermão da Srta. Cheven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110403,
					"content": "Ainda preciso organizar as encomendas da loja, você poderia me ajudar a devolver esta encomenda para a Imix?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110404,
					"content": "O Empório de Gemas Muhuru fica na terra dos Filhos dos Ecos. É muito fácil de encontrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511105,
			"completionStepIds": [
				7511105
			],
