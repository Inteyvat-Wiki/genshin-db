				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110501,
					"content": "...Essa carta é da Tirda, se eu não estiver enganado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Será que ela estava tentando enviar isso para a tribo dela? Mas está uma bagunça agora... Nós vamos ter que devolver isso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "Eu ainda preciso organizar os pacotes na loja, então poderia me ajudar mandar isso de volta para Tirda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "Ela canta no Crepúsculo Dourado, você vai encontrar ela rapidinho.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
